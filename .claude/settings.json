{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "auto",
  "extraKnownMarketplaces": {
    "virtuoseweb": {
      "source": {
        "source": "github",
        "repo": "virtuoseweb/claude-config"
      }
    }
  },
  "enabledPlugins": {
    "vw-guardrails@virtuoseweb": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/board-sync.sh" }
        ]
      }
    ]
  }
}
