---
// AtelierShell · layout de l'atelier Design System (B4, app-shell unifie).
//
// PAS Base.astro : l'Atelier n'est pas une page du site public (pas de Header/Footer/cookies).
// Ce layout fournit son propre document (html/head/body) + une nav laterale fine gauche qui
// unifie les trois espaces outilles (Catalogue /library, Studio /library/studio, Builder
// /library/builder). Les pages qui l'utilisent rendent leur contenu ACTUEL tel quel dans le
// slot principal (les iles React, scripts et styles is:global sont preserves) : la reecriture
// des iles arrive aux vagues suivantes.
//
// On conserve de Base : ClientRouter (les apercus /preview lazy ecoutent `astro:page-load`),
// les polices self-hosted, global.css (tokens + layouts) et les scripts d'animation, pour la
// parite de comportement. On retire : Header/Footer/CookiesBanner/PagePill (chrome public).
//
// Desktop-first : sous 1024px on affiche un message centre (l'outil demande de la largeur).
// 0 nouveau token DS (rule 60) : tout en var(--token) existants. 0 valeur en dur (hors 1px
// hairline structurel). 0 tiret cadratin U+2014 (rule 58).

import '../../../../src/styles/global.css';
import '../../../../src/styles/grid.css';
import '../../../../src/styles/scroll-reveal.css';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../../../../src/site.config';

interface Props {
  title: string;
  description: string;
  /** Espace actif dans le rail. Deduit de l'URL si non fourni. */
  active?: 'catalogue' | 'studio' | 'builder' | 'config';
  /** Pages outil = non indexables par defaut. */
  noindex?: boolean;
}

const { title, description, active, noindex = true } = Astro.props;

const path = Astro.url.pathname;
const activeSpace: 'catalogue' | 'studio' | 'builder' | 'config' =
  active ??
  (path.startsWith('/library/config')
    ? 'config'
    : path.startsWith('/library/builder')
      ? 'builder'
      : path.startsWith('/library/studio')
        ? 'studio'
        : 'catalogue');

const NAV = [
  { id: 'catalogue', href: '/library', label: 'Catalogue' },
  { id: 'studio', href: '/library/studio', label: 'Studio' },
  { id: 'builder', href: '/library/builder', label: 'Builder' },
  { id: 'config', href: '/library/config', label: 'Config' },
] as const;
---

<!doctype html>
<html lang="fr" data-lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    {/* Favicons + PWA manifest (identiques au site) */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="manifest" href="/manifest.json" />

    {/* Polices self-hosted (memes que Base) */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/instrument-serif-regular.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-tight-regular.woff2" crossorigin fetchpriority="high" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/jetbrains-mono-regular.woff2" crossorigin />

    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="atelier-body">
    {/* Cadre app-shell (masque sous 1024px) */}
    <div class="atelier">
      <nav class="atelier-rail" aria-label="Espaces de l'atelier">
        <a class="atelier-wordmark" href="/library" aria-label="Atelier Waimia">
          <span aria-hidden="true">W</span>
        </a>

        <ul class="atelier-nav">
          {NAV.map((item) => (
            <li>
              <a
                class="atelier-nav-link"
                href={item.href}
                aria-current={activeSpace === item.id ? 'page' : undefined}
                data-active={activeSpace === item.id ? 'true' : undefined}
              >
                <span class="atelier-nav-icon" aria-hidden="true">
                  {item.id === 'catalogue' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3.5" y="3.5" width="7" height="7" rx="1" />
                      <rect x="13.5" y="3.5" width="7" height="7" rx="1" />
                      <rect x="3.5" y="13.5" width="7" height="7" rx="1" />
                      <rect x="13.5" y="13.5" width="7" height="7" rx="1" />
                    </svg>
                  )}
                  {item.id === 'studio' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="4" x2="5" y2="20" />
                      <line x1="12" y1="4" x2="12" y2="20" />
                      <line x1="19" y1="4" x2="19" y2="20" />
                      <circle cx="5" cy="9" r="2" fill="currentColor" stroke="none" />
                      <circle cx="12" cy="15" r="2" fill="currentColor" stroke="none" />
                      <circle cx="19" cy="8" r="2" fill="currentColor" stroke="none" />
                    </svg>
                  )}
                  {item.id === 'builder' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3.5" y="3.5" width="17" height="5" rx="1" />
                      <rect x="3.5" y="11" width="10" height="9.5" rx="1" />
                      <rect x="16" y="11" width="4.5" height="9.5" rx="1" />
                    </svg>
                  )}
                  {item.id === 'config' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="3.2" />
                      <path d="M12 2.6v3.1M12 18.3v3.1M2.6 12h3.1M18.3 12h3.1M5.4 5.4l2.2 2.2M16.4 16.4l2.2 2.2M18.6 5.4l-2.2 2.2M7.6 16.4l-2.2 2.2" />
                    </svg>
                  )}
                </span>
                <span class="atelier-nav-label">{item.label}</span>
              </a>
            </li>
          ))}
        </ul>

        <a class="atelier-exit" href="/" aria-label="Retour au site Waimia">
          <span class="atelier-exit-arrow" aria-hidden="true">&#8592;</span>
          <span class="atelier-nav-label">Site</span>
        </a>
      </nav>

      <main class="atelier-main" id="main" tabindex="-1">
        <slot />
      </main>
    </div>

    {/* Garde-fou desktop-first (visible seulement sous 1024px) */}
    <div class="atelier-toosmall" role="note">
      <div class="atelier-toosmall-card">
        <span class="atelier-toosmall-mark" aria-hidden="true">W</span>
        <p class="atelier-toosmall-title">Atelier reserve au desktop</p>
        <p class="atelier-toosmall-text">
          Ces outils de composition demandent au moins 1024px de large. Ouvre l'atelier sur un
          ecran plus grand pour piloter le catalogue, le studio et le builder.
        </p>
        <a class="atelier-toosmall-link" href="/">Retour au site &#8594;</a>
      </div>
    </div>

    {/* Scripts d'animation (parite Base) + hover magnetique */}
    <script>
      import { initScrollReveal } from '../../../../src/lib/animations/scroll-reveal';
      import { initSplitLetterReveal } from '../../../../src/lib/animations/split-letter';
      import { initMotionSignature } from '../../../../src/lib/animations/motion-signature';
      import { initContainerExpand } from '../../../../src/lib/animations/container-expand';
      import { initScrollMorph } from '../../../../src/lib/animations/scroll-morph';

      initScrollReveal();
      initSplitLetterReveal();
      initMotionSignature();
      initContainerExpand();
      initScrollMorph();
    </script>

    <script is:inline>
      (() => {
        if (typeof window === 'undefined') return;
        function initMagnetic() {
          if (!window.matchMedia('(pointer:fine)').matches) return;
          if (window.matchMedia('(prefers-reduced-motion:reduce)').matches) return;
          document.querySelectorAll('[data-mag]').forEach((el) => {
            if (el.dataset.magBound === '1') return;
            el.dataset.magBound = '1';
            const strength = parseFloat(el.getAttribute('data-mag') || '0.18');
            el.addEventListener('mousemove', (e) => {
              const r = el.getBoundingClientRect();
              const x = (e.clientX - r.left - r.width / 2) * strength;
              const y = (e.clientY - r.top - r.height / 2) * strength;
              el.style.transform = `translate(${x}px,${y}px)`;
            });
            el.addEventListener('mouseleave', () => { el.style.transform = ''; });
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initMagnetic);
        } else {
          initMagnetic();
        }
        document.addEventListener('astro:page-load', initMagnetic);
      })();
    </script>
  </body>
</html>

<style>
  /* ── Cadre app-shell ── */
  .atelier-body {
    min-height: 100dvh;
    background: var(--paper);
  }
  .atelier {
    display: flex;
    align-items: stretch;
    min-height: 100dvh;
  }

  /* ── Rail lateral fin ── */
  .atelier-rail {
    position: sticky;
    top: 0;
    flex: none;
    align-self: flex-start;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    width: 64px;
    height: 100dvh;
    padding: var(--space-4) 0;
    background: var(--paper-2);
    border-right: 1px solid var(--hairline);
    z-index: 10;
  }

  .atelier-wordmark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    line-height: 1;
  }

  .atelier-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    width: 100%;
  }
  .atelier-nav li { display: flex; }

  .atelier-nav-link,
  .atelier-exit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 100%;
    padding: var(--space-2) 2px;
    color: var(--muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }
  .atelier-nav-link:hover,
  .atelier-exit:hover { color: var(--ink); background: var(--paper); }
  .atelier-nav-link:focus-visible,
  .atelier-exit:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .atelier-nav-link[data-active='true'] {
    color: var(--accent-text);
    border-left-color: var(--accent-text);
    background: var(--paper);
  }

  .atelier-nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
  }
  .atelier-nav-icon svg { width: 100%; height: 100%; }

  .atelier-nav-label {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    line-height: 1.1;
    text-align: center;
  }

  .atelier-exit {
    margin-top: auto;
    color: var(--muted);
  }
  .atelier-exit-arrow {
    font-family: var(--font-mono);
    font-size: var(--text-body);
    line-height: 1;
  }

  /* ── Zone principale (contenu des pages, plein hauteur, scroll propre) ── */
  .atelier-main {
    flex: 1;
    min-width: 0;
  }
  .atelier-main:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }

  /* ── Garde-fou desktop-first ── */
  .atelier-toosmall { display: none; }

  @media (max-width: 1023.98px) {
    .atelier { display: none; }
    .atelier-toosmall {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100dvh;
      padding: var(--space-6);
    }
    .atelier-toosmall-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-4);
      max-width: 42ch;
      padding: var(--space-8);
      border: 1px solid var(--hairline);
      border-radius: var(--radius-md);
      background: var(--paper-2);
      text-align: center;
    }
    .atelier-toosmall-mark {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: var(--radius-sm);
      background: var(--ink);
      color: var(--paper);
      font-family: var(--font-sans);
      font-size: var(--text-h3);
      font-weight: var(--fw-semibold);
      line-height: 1;
    }
    .atelier-toosmall-title {
      font-family: var(--font-sans);
      font-size: var(--text-h3);
      font-weight: var(--fw-semibold);
      color: var(--ink);
    }
    .atelier-toosmall-text {
      font-family: var(--font-sans);
      font-size: var(--text-small);
      line-height: 1.55;
      color: var(--ink-2);
    }
    .atelier-toosmall-link {
      font-family: var(--font-mono);
      font-size: var(--text-small);
      color: var(--accent-text);
      text-decoration: none;
    }
    .atelier-toosmall-link:hover { text-decoration: underline; }
  }
</style>
