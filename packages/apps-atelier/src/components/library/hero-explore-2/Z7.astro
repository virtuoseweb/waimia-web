---
// Labo R2 · Z7 · « Masthead 64/36 · carte média ink réduite »
// Grille 1.8fr 1fr (~64/36). GAUCHE : §01 + h1 serif accent + lede + badges + CTA dual.
// DROITE (rail) : carte média line-art PLUS PETITE que X2 (aspect-ratio 4/5, fond ink dans
// les DEUX modes) bornée à la largeur du rail + 2 micro-KPI mono sous la carte.
// ADN home réutilisé : MastheadRow + signature-grid (lignes) + titre serif accent italique.
// Contenu de démo FR baké (page-labo, pas de data).
import MastheadRow from '../../../../../../src/components/ui/molecules/MastheadRow.astro';
import Kicker from '../../../../../../src/components/ui/atoms/Kicker.astro';
import Button from '../../../../../../src/components/ui/atoms/Button.astro';

interface Props {
  bg?: 'paper' | 'ink';
}
const { bg = 'paper' } = Astro.props;
const isInk = bg === 'ink';

const badges = ['Claude Code', 'MCP', 'RAG', 'Automations'];
const microKpis = [
  { num: '5 j', label: 'premier flux en prod' },
  { num: '100 %', label: 'données chez vous' },
];
---
<section class="z7" data-bg={isInk ? 'ink' : undefined}>
  <div class:list={['signature-grid', { 'on-dark': isInk }]}></div>

  <div class="wrap-wide z7__inner">
    <MastheadRow tone={isInk ? 'ink' : 'paper'} />

    <div class="z7__grid">
      <div class="z7__main">
        <Kicker tone="accent" class="z7__fig">§ 01 · Service</Kicker>
        <h1 class="z7__title" set:html={`L'IA <i class="acc">intégrée</i> à vos<br />opérations, <i>sans friction</i>.`} />
        <p class="z7__lede">
          On installe Claude Code dans vos outils, vos données et vos flux.
          Vos équipes gardent la main, <i>l'IA fait le reste</i>.
        </p>

        <ul class="z7__badges" aria-label="Capacités">
          {badges.map((b) => <li class="z7__badge">{b}</li>)}
        </ul>

        <div class="z7__ctas">
          <Button href="/contact" variant="primary" size="lg">Démarrer un diagnostic</Button>
          <Button href="#methode" variant="ghost" size="lg">Voir la méthode</Button>
        </div>
        <p class="z7__cta-sub">Réponse sous 48 h. <i>Sans engagement.</i></p>
      </div>

      <aside class="z7__rail">
        <Kicker tone="accent" class="z7__fig">§ 02 · Dispositif</Kicker>
        <figure class="z7__media">
          <img src="/images/line-art/dispositif-flow.svg" alt="Schéma du dispositif d'intégration" loading="eager" decoding="async" />
        </figure>
        <ul class="z7__kpis" aria-label="Résultats">
          {microKpis.map((k) => (
            <li class="z7__kpi">
              <span class="z7__kpi-num">{k.num}</span>
              <span class="z7__kpi-label">{k.label}</span>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .z7 {
    position: relative;
    background: var(--paper);
    color: var(--ink);
    border-bottom: 1px solid var(--hairline);
    overflow: hidden;
    min-height: 100vh;
    min-height: calc(var(--viewport-h) - var(--hero-chrome-above));
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    padding-top: calc(var(--header-height) + var(--space-7));
    padding-bottom: var(--space-7);
  }
  .z7[data-bg='ink'] { background: var(--ink); color: var(--paper); }
  .z7 > *:not(.signature-grid) { position: relative; z-index: 1; }
  .z7 .signature-grid { z-index: 0; }

  .z7__grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr;
    gap: var(--space-10);
    align-items: center;
    margin-top: var(--space-7);
  }
  .z7__main { display: flex; flex-direction: column; }

  :global(.z7__fig) { margin-bottom: var(--space-4); }

  .z7__title {
    font-family: var(--font-sans);
    font-weight: var(--fw-semibold);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    letter-spacing: -0.015em;
    max-width: 16ch;
    margin: 0 0 var(--space-5);
  }
  .z7__title :global(i) { font-style: italic; }
  .z7__title :global(i.acc) { color: var(--accent-text); }

  .z7__lede {
    font-family: var(--font-sans);
    font-size: var(--text-lede, clamp(20px, 1.7vw, 24px));
    line-height: var(--leading-lede);
    color: var(--ink-2);
    max-width: 52ch;
    margin: 0 0 var(--space-6);
    text-wrap: pretty;
  }
  .z7[data-bg='ink'] .z7__lede { color: var(--paper-2); }
  .z7__lede :global(i) { font-style: italic; color: var(--accent-text); }

  .z7__badges {
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .z7__badge {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono-tight);
    text-transform: uppercase;
    color: var(--ink-2);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    padding: var(--space-2) var(--space-4);
    transition: border-color var(--dur-hover) var(--ease), color var(--dur-hover) var(--ease);
  }
  .z7__badge:hover { border-color: var(--accent-text); color: var(--accent-text); }
  .z7[data-bg='ink'] .z7__badge { color: var(--paper-2); }

  .z7__ctas { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .z7__cta-sub {
    margin: var(--space-5) 0 0;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--ink-2);
  }
  .z7[data-bg='ink'] .z7__cta-sub { color: var(--paper-2); }
  .z7__cta-sub :global(i) { font-style: italic; color: var(--accent-text); }

  /* Rail droit léger : carte média ink réduite (aspect 4/5) + 2 micro-KPI */
  .z7__rail { display: flex; flex-direction: column; }
  .z7__media {
    margin: 0;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--ink-2);
    padding: clamp(var(--space-5), 2.5vw, var(--space-7));
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .z7__media::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 60% at 50% 45%, rgba(var(--accent-rgb), 0.08), transparent 70%);
    pointer-events: none;
  }
  .z7__media img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain;
    color: var(--paper);
  }

  .z7__kpis {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    border-top: 1px solid var(--hairline);
    padding-top: var(--space-4);
  }
  .z7__kpi { display: flex; flex-direction: column; gap: var(--space-1); }
  .z7__kpi-num {
    font-family: var(--font-display);
    font-size: var(--text-numeral-md);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--accent-text);
    font-weight: var(--fw-regular);
  }
  .z7__kpi-label {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono-tight);
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .z7[data-bg='ink'] .z7__kpi-label { color: var(--paper-2); }

  @media (max-width: 768px) {
    .z7 {
      padding-top: calc(var(--header-height) + var(--space-5));
      padding-bottom: var(--space-5);
    }
    .z7__grid { grid-template-columns: 1fr; gap: var(--space-5); margin-top: var(--space-5); }
    .z7__rail { order: 1; }
    .z7__media { aspect-ratio: 2 / 1; max-height: 26svh; }
    .z7__title { margin-bottom: var(--space-4); }
    .z7__lede { margin-bottom: var(--space-5); }
    .z7__badges { margin-bottom: var(--space-5); }
    .z7__ctas { gap: var(--space-2); }
    .z7__ctas :global(.btn) { flex: 1 1 auto; justify-content: center; }
  }
</style>
