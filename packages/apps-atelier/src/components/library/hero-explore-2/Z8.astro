---
// Labo R2 · Z8 · « Bandeau capacités asymétrique »
// Masthead + h1 + lede left-aligné (~70 % largeur, pas de 2e colonne en haut).
// EN BAS, pleine largeur : bande capacités asymétrique = 5 cellules
// grid-template-columns 1fr 1fr 1.4fr 1fr 1fr dont la 3e (large, accent) porte un KPI serif ;
// les 4 autres = capacités mono. Hairlines verticales. Casse de rythme = signature éditoriale.
// ADN home réutilisé : MastheadRow + signature-grid (lignes) + titre serif accent italique.
import MastheadRow from '../../../../../../src/components/ui/molecules/MastheadRow.astro';
import Kicker from '../../../../../../src/components/ui/atoms/Kicker.astro';
import Button from '../../../../../../src/components/ui/atoms/Button.astro';

interface Props {
  bg?: 'paper' | 'ink';
}
const { bg = 'paper' } = Astro.props;
const isInk = bg === 'ink';

// 5 cellules : la 3e (index 2) est la cellule large accent (KPI serif).
const cells = [
  { kind: 'cap', label: 'Acquisition', items: 'SEA · SEO · Ads' },
  { kind: 'cap', label: 'Contenu', items: 'Brief · Rédaction · SEO' },
  { kind: 'kpi', num: '+12 h', items: 'gagnées par semaine et par équipe' },
  { kind: 'cap', label: 'Web', items: 'Sites · Apps · CMS' },
  { kind: 'cap', label: 'Data', items: 'Tracking · Dashboards' },
];
---
<section class="z8" data-bg={isInk ? 'ink' : undefined}>
  <div class:list={['signature-grid', { 'on-dark': isInk }]}></div>

  <div class="wrap-wide z8__inner">
    <MastheadRow tone={isInk ? 'ink' : 'paper'} />

    <div class="z8__head">
      <Kicker tone="accent" class="z8__fig">§ 01 · Service</Kicker>
      <h1 class="z8__title" set:html={`L'IA <i class="acc">intégrée</i> à vos opérations,<br /><i>sans friction</i>.`} />
      <p class="z8__lede">
        On installe Claude Code dans vos outils, vos données et vos flux.
        Vos équipes gardent la main, <i>l'IA fait le reste</i>.
      </p>
      <div class="z8__ctas">
        <Button href="/contact" variant="primary" size="lg">Démarrer un diagnostic</Button>
        <Button href="#methode" variant="ghost" size="lg">Voir la méthode</Button>
      </div>
    </div>

    <Kicker tone="accent" class="z8__fig z8__fig--band">§ 02 · Périmètre</Kicker>
    <ul class="z8__band" aria-label="Capacités et résultat">
      {cells.map((c) => (
        <li class:list={['z8__cell', { 'z8__cell--kpi': c.kind === 'kpi' }]}>
          {c.kind === 'kpi' ? (
            <>
              <span class="z8__cell-num">{c.num}</span>
              <span class="z8__cell-cap">{c.items}</span>
            </>
          ) : (
            <>
              <span class="z8__cell-label">{c.label}</span>
              <span class="z8__cell-items">{c.items}</span>
            </>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .z8 {
    position: relative;
    background: var(--paper);
    color: var(--ink);
    border-bottom: 1px solid var(--hairline);
    overflow: hidden;
    min-height: 100vh;
    min-height: calc(var(--viewport-h) - var(--hero-chrome-above));
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    padding-top: calc(var(--header-height) + var(--space-7));
    padding-bottom: var(--space-7);
  }
  .z8[data-bg='ink'] { background: var(--ink); color: var(--paper); }
  .z8 > *:not(.signature-grid) { position: relative; z-index: 1; }
  .z8 .signature-grid { z-index: 0; }

  .z8__head { max-width: 70%; margin-top: var(--space-7); }
  :global(.z8__fig) { margin-bottom: var(--space-4); }
  :global(.z8__fig--band) { margin-top: var(--space-8); }

  .z8__title {
    font-family: var(--font-sans);
    font-weight: var(--fw-semibold);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    letter-spacing: -0.015em;
    max-width: 22ch;
    margin: 0 0 var(--space-5);
  }
  .z8__title :global(i) { font-style: italic; }
  .z8__title :global(i.acc) { color: var(--accent-text); }

  .z8__lede {
    font-family: var(--font-sans);
    font-size: var(--text-lede, clamp(20px, 1.7vw, 24px));
    line-height: var(--leading-lede);
    color: var(--ink-2);
    max-width: 56ch;
    margin: 0 0 var(--space-6);
    text-wrap: pretty;
  }
  .z8[data-bg='ink'] .z8__lede { color: var(--paper-2); }
  .z8__lede :global(i) { font-style: italic; color: var(--accent-text); }

  .z8__ctas { display: flex; gap: var(--space-3); flex-wrap: wrap; }

  /* Bande capacités asymétrique : 5 cellules, la 3e (large) en accent */
  .z8__band {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr 1.4fr 1fr 1fr;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .z8__cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-4);
    border-right: 1px solid var(--hairline);
  }
  .z8__cell:last-child { border-right: none; }
  .z8__cell--kpi {
    background: rgba(var(--accent-rgb), 0.06);
    justify-content: center;
  }

  .z8__cell-label {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .z8__cell-items {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-lede);
    color: var(--ink-2);
  }
  .z8[data-bg='ink'] .z8__cell-items { color: var(--paper-2); }

  .z8__cell-num {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--accent-text);
    font-weight: var(--fw-regular);
  }
  .z8__cell-cap {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-lede);
    color: var(--ink);
    text-wrap: balance;
  }
  .z8[data-bg='ink'] .z8__cell-cap { color: var(--paper); }

  @media (max-width: 768px) {
    .z8 {
      padding-top: calc(var(--header-height) + var(--space-5));
      padding-bottom: var(--space-5);
    }
    .z8__head { max-width: 100%; margin-top: var(--space-5); }
    .z8__title { margin-bottom: var(--space-4); }
    .z8__lede { margin-bottom: var(--space-5); }
    .z8__ctas { gap: var(--space-2); }
    .z8__ctas :global(.btn) { flex: 1 1 auto; justify-content: center; }
    /* La bande passe en grille 1-col : la cellule accent garde son fond mais s'empile */
    .z8__band { grid-template-columns: 1fr; }
    .z8__cell {
      border-right: none;
      border-bottom: 1px solid var(--hairline);
    }
    .z8__cell:last-child { border-bottom: none; }
  }
</style>
