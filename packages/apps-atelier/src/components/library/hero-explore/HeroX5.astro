---
/**
 * hero-explore · X5 : « Éditorial 2-col + médaillon média » (paper/ink)
 * GAUCHE : kicker mono + titre serif accent + lede court + 2 CTA.
 * DROITE : médaillon média (carte radius-lg, line-art currentColor) + 3 KPI verticaux hairline.
 * Standalone · 0 hardcode · paper+ink via tokens de rôle (remap global [data-bg='ink']).
 */
interface Props { bg?: 'paper' | 'ink'; }
const { bg = 'paper' } = Astro.props;

const kpis = [
  { num: '2–10 k€', cap: 'budget HT indicatif' },
  { num: '4–8 sem.', cap: 'site exploitable livré' },
  { num: '100/100', cap: 'PageSpeed SSG, base GEO' },
];
---
<section class="hx hx5" data-bg={bg === 'ink' ? 'ink' : undefined}>
  <div class="wrap-wide hx5-grid">
    <div class="hx5-lead">
      <p class="hx5-kicker">§ Site web intelligent</p>
      <h1 class="hx5-title">Un site web <i class="acc">intelligent</i>.</h1>
      <p class="hx5-lede">Pas une vitrine. Une web app pilotée par l'IA, branchée à vos données, qui transforme chaque visite en client.</p>
      <div class="hx5-ctas">
        <a href="#" class="btn btn-primary btn-lg">Réserver un diagnostic (45 min) →</a>
        <a href="#" class="btn btn-ghost btn-lg">Voir la méthode</a>
      </div>
    </div>

    <div class="hx5-aside">
      <figure class="hx5-medallion">
        <img src="/images/line-art/dispositif-flow.svg" alt="Schéma du dispositif : outils dispersés reliés par un noeud d'orchestration vers un livrable mesuré." loading="eager" decoding="async" />
      </figure>
      <ul class="hx5-kpis">
        {kpis.map((k) => (
          <li class="hx5-kpi">
            <span class="hx5-kpi-num">{k.num}</span>
            <span class="hx5-kpi-cap">{k.cap}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <style>
    .hx5 {
      background: var(--paper);
      color: var(--ink);
      padding-top: calc(var(--header-height) + var(--space-7));
      padding-bottom: var(--space-9);
      border-bottom: 1px solid var(--hairline);
    }
    .hx5[data-bg='ink'] { background: var(--ink); color: var(--paper); }

    .hx5-grid {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: var(--space-10);
      align-items: center;
    }

    /* ── Colonne gauche ── */
    .hx5-lead { display: flex; flex-direction: column; }
    .hx5-kicker {
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono);
      text-transform: uppercase;
      color: var(--muted);
      margin: 0 0 var(--space-5);
    }
    .hx5-title {
      font-family: var(--font-sans);
      font-weight: var(--fw-semibold);
      font-size: var(--text-h1);
      line-height: var(--leading-h1);
      letter-spacing: -0.015em;
      margin: 0 0 var(--space-5);
    }
    .hx5-title i { font-style: italic; }
    .hx5-title i.acc { color: var(--accent-text); }
    .hx5-lede {
      font-family: var(--font-sans);
      font-size: var(--text-body);
      line-height: var(--leading-body);
      color: var(--muted);
      max-width: 50ch;
      text-wrap: pretty;
      margin: 0 0 var(--space-7);
    }
    .hx5-ctas { display: flex; gap: var(--space-3); flex-wrap: wrap; }

    /* ── Colonne droite : médaillon + KPI ── */
    .hx5-aside { display: flex; flex-direction: column; gap: var(--space-6); }
    .hx5-medallion {
      margin: 0;
      border: 1px solid var(--hairline);
      border-radius: var(--radius-lg);
      background: var(--paper-2);
      padding: var(--space-8);
      color: var(--accent-text);
      box-shadow: var(--shadow-card-rest);
    }
    .hx5[data-bg='ink'] .hx5-medallion { background: var(--ink-2); }
    .hx5-medallion img {
      display: block;
      width: 100%;
      height: auto;
      max-height: var(--space-15);
      object-fit: contain;
    }

    .hx5-kpis { list-style: none; margin: 0; padding: 0; }
    .hx5-kpi {
      display: grid;
      grid-template-columns: minmax(90px, 0.4fr) 1fr;
      gap: var(--space-5);
      align-items: baseline;
      padding: var(--space-4) 0;
      border-top: 1px solid var(--hairline);
    }
    .hx5-kpi:last-child { border-bottom: 1px solid var(--hairline); }
    .hx5-kpi-num {
      font-family: var(--font-display);
      font-size: var(--text-numeral-md);
      line-height: 1;
      letter-spacing: var(--tracking-display);
      color: var(--accent-text);
      font-weight: var(--fw-regular);
    }
    .hx5-kpi-cap {
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono-tight);
      text-transform: uppercase;
      line-height: var(--leading-lede);
      color: var(--muted);
    }

    @media (max-width: 900px) {
      .hx5-grid { grid-template-columns: 1fr; gap: var(--space-8); }
    }
    @media (max-width: 768px) {
      .hx5-aside { gap: var(--space-5); }
      .hx5-kpi { grid-template-columns: minmax(80px, 0.45fr) 1fr; gap: var(--space-4); }
    }
  </style>
</section>
