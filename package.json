{
  "name": "waimia-web",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:tina": "tinacms dev -c \"astro dev\"",
    "build": "astro build",
    "build:tina": "tinacms build --local --skip-cloud-checks && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "echo \"waimia-web: lint TBD (ajouter eslint quand stabilisé)\"",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,js,jsx,md,json}\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:prod": "PLAYWRIGHT_BASE_URL=https://waimia.com playwright test",
    "clean": "rm -rf dist .astro .vercel .turbo",
    "visual": "node scripts/visual-check.mjs",
    "gen:catalog": "node scripts/gen-catalog.mjs",
    "gen:ds-registry": "node scripts/gen-ds-registry.mjs",
    "gen:token-lock": "node scripts/gen-token-lock.mjs",
    "gen:section-manifest": "node scripts/gen-section-manifest.mjs",
    "check:touchpoints": "node scripts/check-touchpoints.mjs",
    "check:presets": "node scripts/check-presets.mjs",
    "check:static-quality": "node scripts/check-static-quality.mjs",
    "check:token-purity": "node scripts/check-token-purity.mjs",
    "check:token-lock": "node scripts/check-token-lock.mjs",
    "check:section-rhythm": "node scripts/check-section-rhythm.mjs",
    "check:form-endpoints": "node scripts/check-form-endpoints.mjs",
    "check:usage-manifest": "node scripts/check-usage-manifest.mjs",
    "ds:apply": "node scripts/apply-ds-export.mjs"
  },
  "dependencies": {
    "@4hse/astro-llms-txt": "^1.0.5",
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/react": "^5.0.4",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/vercel": "^10.0.5",
    "@calcom/embed-react": "^1.5.3",
    "@resvg/resvg-js": "^2.6.2",
    "@tinacms/astro": "^0.5.0",
    "@tinacms/bridge": "^0.3.0",
    "@tinacms/datalayer": "^2.0.23",
    "@tinacms/mdx": "^2.1.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "astro": "^6.1.9",
    "astro-robots-txt": "^1.0.0",
    "astro-seo": "^1.1.0",
    "gsap": "^3.15.0",
    "tinacms": "^3.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@tinacms/cli": "^2.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@resvg/resvg-js"
    ]
  }
}
