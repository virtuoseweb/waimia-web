{
  "name": "waimia-web",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/gen-section-aggregate.mjs && node scripts/gen-section-usage.mjs && node scripts/gen-section-instances.mjs && node scripts/gen-site-pages.mjs && node scripts/check-content-refs.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "echo \"waimia-web: lint TBD (ajouter eslint quand stabilisé)\"",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,js,jsx,md,json}\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:prod": "PLAYWRIGHT_BASE_URL=https://waimia.com playwright test",
    "e2e:builder": "node scripts/e2e-builder.mjs",
    "prospect:score": "node scripts/prospecting/score-icp-bant.mjs",
    "prospect:render": "node scripts/prospecting/render-sequence.mjs",
    "prospect:crm": "node scripts/prospecting/crm-lite.mjs",
    "clean": "rm -rf dist .astro .vercel .turbo",
    "visual": "node scripts/visual-check.mjs",
    "gen:catalog": "node scripts/gen-catalog.mjs",
    "gen:ds-registry": "node scripts/gen-ds-registry.mjs",
    "gen:token-lock": "node scripts/gen-token-lock.mjs",
    "gen:section-manifest": "npx tsx scripts/gen-section-manifest.mjs",
    "gen:section-quickref": "node scripts/gen-section-quickref.mjs",
    "gen:section-aggregate": "node scripts/gen-section-aggregate.mjs",
    "gen:section-usage": "node scripts/gen-section-usage.mjs",
    "gen:section-instances": "node scripts/gen-section-instances.mjs",
    "gen:site-pages": "node scripts/gen-site-pages.mjs",
    "gen:page-schemas": "npx tsx scripts/gen-page-schemas.mjs",
    "check:page-schemas": "npx tsx scripts/check-page-schemas.mjs",
    "check:section-aggregate": "node scripts/check-section-aggregate.mjs",
    "check:content-refs": "node scripts/check-content-refs.mjs",
    "check:touchpoints": "node scripts/check-touchpoints.mjs",
    "check:internal-links": "node scripts/check-internal-links.mjs",
    "check:no-emdash": "node scripts/check-no-emdash.mjs",
    "check:title-typo": "node scripts/check-title-typo.mjs",
    "check:pricing": "node scripts/check-pricing.mjs",
    "check:media-query-var": "node scripts/check-media-query-var.mjs",
    "check:presets": "npx tsx scripts/check-presets.mjs",
    "check:static-quality": "node scripts/check-static-quality.mjs",
    "check:token-purity": "node scripts/check-token-purity.mjs",
    "check:token-lock": "node scripts/check-token-lock.mjs",
    "check:section-rhythm": "node scripts/check-section-rhythm.mjs",
    "check:completeness": "node scripts/check-section-completeness.mjs",
    "check:section-modules": "node scripts/check-section-modules.mjs",
    "check:form-endpoints": "node scripts/check-form-endpoints.mjs",
    "check:honeypot": "node scripts/check-honeypot.mjs",
    "test:lead-magnet": "node --test scripts/tests/lead-magnet-delivery.test.mjs",
    "test:lead-tools": "node --test scripts/tests/lead-tools.test.mjs",
    "gen:pdf-assets": "node scripts/gen-pdf-assets.mjs",
    "check:ds-presets": "node scripts/check-ds-presets.mjs",
    "check:usage-manifest": "node scripts/check-usage-manifest.mjs",
    "check:semantic": "node scripts/check-semantic-coherence.mjs",
    "check:board": "node scripts/check-board.mjs",
    "check:hover-reflow": "node scripts/check-hover-reflow.mjs",
    "check:gutter": "node scripts/check-gutter.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:jsonld": "node scripts/check-jsonld.mjs",
    "check:head": "node scripts/check-head.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:public-surface": "node scripts/check-public-surface.mjs",
    "check:internal-mesh": "node scripts/check-internal-mesh.mjs",
    "check:related-links-groups": "node scripts/check-related-links-groups.mjs",
    "check:menu-labels": "npx tsx scripts/check-menu-labels.mjs",
    "check:card-images": "node scripts/check-card-images.mjs",
    "check:silos": "node scripts/check-silos.mjs",
    "gen:lastmod": "node scripts/gen-lastmod.mjs",
    "seo:routine": "node scripts/seo-routine/run.mjs",
    "seo:feeds": "node scripts/seo-routine/feeds.mjs --check",
    "check:seo-routine": "node scripts/seo-routine/check-config.mjs",
    "check:seo-calendar": "node scripts/seo-routine/check-calendar.mjs",
    "seo:brave-queue": "node scripts/seo-routine/brave-queue.mjs --from-sitemap --days=8",
    "seo:freshness": "node scripts/seo-routine/freshness.mjs",
    "test:seo-routine": "node --test \"scripts/seo-routine/tests/*.test.mjs\"",
    "board:regen": "node scripts/sync-board.mjs --regen",
    "ds:apply": "node scripts/apply-ds-export.mjs",
    "check:jargon": "node scripts/check-jargon.mjs",
    "test:claude-hooks": "node --test \"scripts/claude/tests/*.test.mjs\""
  },
  "dependencies": {
    "@waimia/atelier-ui": "workspace:*",
    "@waimia/builder": "workspace:*",
    "@waimia/catalogue-ui": "workspace:*",
    "@waimia/ds-kernel": "workspace:*",
    "@4hse/astro-llms-txt": "^1.0.5",
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/react": "^5.0.4",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/vercel": "^10.0.5",
    "@calcom/embed-react": "^1.5.3",
    "@neondatabase/serverless": "^1.2.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "astro": "^6.1.9",
    "astro-robots-txt": "^1.0.0",
    "astro-seo": "^1.1.0",
    "gsap": "^3.15.0",
    "pdf-lib": "1.17.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/markdown-remark": "7.2.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@resvg/resvg-js"
    ]
  }
}
