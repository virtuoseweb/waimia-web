---
// Base layout · head SEO/GEO/AIO + Header + Footer + JSON-LD baseline
// Toute page Astro hérite de ce layout. Frontmatter passe via Astro.props.

import '../styles/global.css';
import '../styles/grid.css';
import '../styles/scroll-reveal.css';
import Header from '../components/header/Header.astro';
import Footer from '../components/footer/Footer.astro';
import PagePill from '../components/ui/molecules/PagePill.astro';
import CookiesBanner from '../components/ui/organisms/CookiesBanner.astro';
import CursorDot from '../components/ui/atoms/CursorDot.astro';
import ProgressBar from '../components/ui/atoms/ProgressBar.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { SEO } from 'astro-seo';
import { organization, website } from '../lib/seo';
import { SITE } from '../site.config';
import { langFromPath, alternateHref, hasBilingualMirror, HREFLANG } from '../lib/i18n';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  /** Bloc(s) JSON-LD spécifiques à la page (Service / Article / FAQ…). Organization+WebSite sont auto-injectés. */
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  /** Bloc(s) JSON-LD additionnels injectés par un template parent sans écraser jsonLd. */
  additionalJsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  /** OG image absolue */
  ogImage?: string;
  /** Pas d'index (pages WIP) */
  noindex?: boolean;
  /** Override canonical (sinon dérivé du chemin) */
  canonical?: string;
  /** Surcharge ou supprime le lien hreflang alternatif.
   * - `undefined` : calculé automatiquement (via hasBilingualMirror)
   * - `string` : URL miroir explicite
   * - `false` : page FR-only, aucune balise en-US émise
   */
  alternate?: string | false;
  /** Couleur thème navigateur */
  themeColor?: string;
  /** Type OG (og:type). Défaut 'website' ; utiliser 'article' pour les pages de contenu éditorial. */
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  jsonLd,
  additionalJsonLd,
  ogImage,
  noindex = false,
  canonical,
  alternate,
  themeColor = SITE.themeColor,
  ogType = 'website',
} = Astro.props;

const lang = langFromPath(Astro.url.pathname);
const siteUrl = SITE.url;
const canonicalUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;
// Staging non-indexable : forcé sur les projets Vercel de preview (env PUBLIC_STAGING_NOINDEX=1), inactif sur waimia.com.
const robotsNoindex = noindex || import.meta.env.PUBLIC_STAGING_NOINDEX === '1';

// altUrl : URL du miroir linguistique pour hreflang.
// - alternate===false → page FR-only, pas de hreflang alternatif
// - alternate (string) → URL explicite fournie par la page
// - sinon → hasBilingualMirror décide d'après la liste FR_ONLY
const altUrl: string | null = (() => {
  if (alternate === false) return null;
  if (typeof alternate === 'string') {
    return alternate.startsWith('http') ? alternate : `${siteUrl}${alternate}`;
  }
  if (!hasBilingualMirror(Astro.url.pathname)) return null;
  return `${siteUrl}${alternateHref(Astro.url.pathname, lang)}`;
})();

// T1.6b · OG image dynamique via /api/og.png si pas d'image fournie
// Utilise title + kicker dérivé de la description (first sentence) pour le rendu SVG
const ogTitle = encodeURIComponent(title.split('·')[0].trim().substring(0, 80));
const ogKicker = encodeURIComponent(lang === 'fr' ? 'Studio IA pour PME' : 'AI studio for SMBs');
const dynamicOgUrl = `${siteUrl}/api/og.png?title=${ogTitle}&kicker=${ogKicker}`;
const finalOgImage = ogImage ?? dynamicOgUrl;

const baseLd = [organization(), website(lang)];
const pageLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const additionalLd = additionalJsonLd
  ? (Array.isArray(additionalJsonLd) ? additionalJsonLd : [additionalJsonLd])
  : [];
---
<!doctype html>
<html lang={HREFLANG[lang]} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />

    <SEO
      title={title}
      description={description}
      noindex={robotsNoindex}
      canonical={canonicalUrl}
      openGraph={{
        basic: {
          title: title,
          type: ogType,
          image: finalOgImage,
          url: canonicalUrl,
        },
        optional: {
          description: description,
          siteName: SITE.name,
          locale: lang === 'fr' ? 'fr_FR' : 'en_US',
        },
        image: {
          url: finalOgImage,
          width: 1200,
          height: 630,
          type: 'image/png',
          alt: title,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        site: SITE.twitter.handle,
        title: title,
        description: description,
        image: finalOgImage,
        imageAlt: title,
      }}
    />

    {/* Hreflang · pivot SEO bilingue */}
    <link rel="alternate" hreflang={HREFLANG[lang]} href={canonicalUrl} />
    {altUrl && <link rel="alternate" hreflang={HREFLANG[lang === 'fr' ? 'en' : 'fr']} href={altUrl} />}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />


    {/* Favicons + PWA manifest · nouveau mark PNG (identité géométrique) */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="manifest" href="/manifest.json" />

    {/* Polices self-hosted · Mission 03 perf · @font-face dans src/styles/fonts.css
        woff2 latin + latin-ext, servi depuis /public/fonts/ → 0 requête CDN tiers */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/instrument-serif-regular.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-tight-regular.woff2" crossorigin fetchpriority="high" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/jetbrains-mono-regular.woff2" crossorigin />

    {/* JSON-LD baseline (Organization + WebSite) + custom blocks */}
    <JsonLd data={[...baseLd, ...pageLd, ...additionalLd]} />

    {/* Sitemap & RSS */}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    {/* Skip-to-content · WCAG 2.4.1 — apparaît au focus, masqué sinon */}
    <a href="#main" class="skip-link">
      {lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}
    </a>
    <ProgressBar />
    <CursorDot />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {import.meta.env.DEV && <PagePill />}
    <CookiesBanner lang={lang} />

    <script>
      import { initScrollReveal } from '../lib/animations/scroll-reveal';
      import { initSplitLetterReveal } from '../lib/animations/split-letter';
      import { initMotionSignature } from '../lib/animations/motion-signature';
      import { initContainerExpand } from '../lib/animations/container-expand';
      import { initScrollMorph } from '../lib/animations/scroll-morph';

      initScrollReveal();
      initSplitLetterReveal();
      initMotionSignature();
      initContainerExpand();
      initScrollMorph();
    </script>

    {/* Magnetic hover sur [data-mag] · réexécuté après View Transitions */}
    <script is:inline>
      (() => {
        if (typeof window === 'undefined') return;
        function initMagnetic() {
          if (!window.matchMedia('(pointer:fine)').matches) return;
          const reduced = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
          if (reduced) return;
          document.querySelectorAll('[data-mag]').forEach((el) => {
            if (el.dataset.magBound === '1') return;
            el.dataset.magBound = '1';
            const strength = parseFloat(el.getAttribute('data-mag') || '0.18');
            el.addEventListener('mousemove', (e) => {
              const r = el.getBoundingClientRect();
              const x = (e.clientX - r.left - r.width / 2) * strength;
              const y = (e.clientY - r.top - r.height / 2) * strength;
              el.style.transform = `translate(${x}px,${y}px)`;
            });
            el.addEventListener('mouseleave', () => { el.style.transform = ''; });
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initMagnetic);
        } else {
          initMagnetic();
        }
        document.addEventListener('astro:page-load', initMagnetic);
      })();
    </script>
  </body>
</html>

<style>
  main[id="main"]:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
</style>
