---
// Base layout · head SEO/GEO/AIO + Header + Footer + JSON-LD baseline
// Toute page Astro hérite de ce layout. Frontmatter passe via Astro.props.

import '../styles/global.css';
import '../styles/grid.css';
import '../styles/scroll-reveal.css';
import Header from '../components/header/Header.astro';
import Footer from '../components/footer/Footer.astro';
import PagePill from '../components/ui/molecules/PagePill.astro';
import CookiesBanner from '../components/ui/organisms/CookiesBanner.astro';
import CursorDot from '../components/ui/atoms/CursorDot.astro';
import ProgressBar from '../components/ui/atoms/ProgressBar.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { SEO } from 'astro-seo';
import PageUpdated from '../components/seo/PageUpdated.astro';
import RelatedLinks from '../components/sections/RelatedLinks.astro';
import { meshForPath } from '../lib/internal-mesh';
import { finalizePageSchema } from '../lib/seo/page-schema';
import { lastmodFor } from '../lib/seo/lastmod.mjs';
import { SITE } from '../site.config';
import { langFromPath, HREFLANG } from '../lib/i18n';
import { ClientRouter } from 'astro:transitions';
import { isInternalPath } from '../lib/seo/internal-tools.mjs';

interface Props {
  title: string;
  description: string;
  /** Bloc(s) JSON-LD spécifiques à la page (Service / Article / FAQ…). Organization+WebSite sont auto-injectés. */
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  /** Bloc(s) JSON-LD additionnels injectés par un template parent sans écraser jsonLd. */
  additionalJsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  /** OG image absolue */
  ogImage?: string;
  /** Pas d'index (pages WIP) */
  noindex?: boolean;
  /** Override canonical (sinon dérivé du chemin) */
  canonical?: string;
  /** Conservé pour compatibilité des appelants : le site est monolingue FR, aucun
   * alternate de langue n'est émis (le miroir /en n'existe pas). */
  alternate?: string | false;
  /** Ligne « Page mise à jour le … » en fin de contenu.
   * - `undefined` : affichée sur les pages de contenu indexables (cf UPDATED_PREFIXES)
   * - `false` : jamais (page qui affiche déjà sa propre date)
   * - `true` : forcée */
  showUpdated?: boolean;
  /** Bloc de maillage interne calculé (« Sur le même sujet ») en fin de contenu.
   * - `undefined` : affiché si la page est au registre de lib/internal-mesh.ts
   * - `false` : jamais (page qui pose elle-même sa section related-links) */
  showMesh?: boolean;
  /** Couleur thème navigateur */
  themeColor?: string;
  /** Type OG (og:type). Défaut 'website' ; utiliser 'article' pour les pages de contenu éditorial. */
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  jsonLd,
  additionalJsonLd,
  ogImage,
  noindex = false,
  canonical,
  showUpdated,
  showMesh,
  themeColor = SITE.themeColor,
  ogType = 'website',
} = Astro.props;

const lang = langFromPath(Astro.url.pathname);
const siteUrl = SITE.url;
// Une seule forme d'URL : sans slash final (sauf l'accueil), quel que soit le chemin
// réellement demandé (`/x/` en dev ou derrière un proxy).
const pagePath = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/+$/, '') : '/';
const canonicalUrl = canonical ?? `${siteUrl}${pagePath}`;
// Staging non-indexable : forcé sur les projets Vercel de preview (env PUBLIC_STAGING_NOINDEX=1), inactif sur waimia.com.
const robotsNoindex = noindex || import.meta.env.PUBLIC_STAGING_NOINDEX === '1';

// Règle unique du <title> : le suffixe « · Waimia » (écrit dans title_fr de nombreuses
// pages) saute quand le titre complet dépasse 60 caractères. Jamais de second suffixe,
// jamais de troncature. Même valeur pour og:title et twitter:title.
const TITLE_SUFFIX_RE = /[\s\u00A0\u202F]· Waimia$/;
const TITLE_MAX = 60;
const suffixMatch = TITLE_SUFFIX_RE.exec(title);
const pageTitle = suffixMatch && [...title].length > TITLE_MAX ? title.slice(0, suffixMatch.index) : title;

// Miroir markdown (.md) : mêmes pages que l'intégration llms-md-pages (indexables, hors surfaces
// internes, hors 404/admin/api/bienvenue/lp). Lien émis seulement si la page est indexable.
const MD_EXCLUDED_PREFIXES = ['/admin', '/api', '/bienvenue', '/lp'];
const hasMarkdownMirror =
  !robotsNoindex &&
  !isInternalPath(pagePath) &&
  pagePath !== '/404' &&
  !MD_EXCLUDED_PREFIXES.some((prefix) => pagePath === prefix || pagePath.startsWith(`${prefix}/`));
const markdownHref = pagePath === '/' ? '/index.md' : `${pagePath}.md`;

// T1.6b · OG image dynamique via /api/og.png si pas d'image fournie
// Utilise title + kicker dérivé de la description (first sentence) pour le rendu SVG
const ogTitle = encodeURIComponent(title.split('·')[0].trim().substring(0, 80));
const ogKicker = encodeURIComponent(lang === 'fr' ? 'Studio IA pour PME' : 'AI studio for SMBs');
const dynamicOgUrl = `${siteUrl}/api/og.png?title=${ogTitle}&kicker=${ogKicker}`;
const finalOgImage = ogImage ?? dynamicOgUrl;

const pageLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const additionalLd = additionalJsonLd
  ? (Array.isArray(additionalJsonLd) ? additionalJsonLd : [additionalJsonLd])
  : [];

// Date réelle de dernière modification du contenu (null si inconnue ; lecture disque au
// build uniquement, d'où le garde-fou pour un éventuel rendu serverless).
let lastmod: string | null = null;
try {
  lastmod = lastmodFor(pagePath);
} catch {
  lastmod = null;
}

// JSON-LD final : Organization + WebSite + blocs de la page, complétés et dédoublonnés.
const allLd = finalizePageSchema([...pageLd, ...additionalLd], {
  pathname: pagePath,
  canonicalUrl,
  lang,
  ogImage: finalOgImage,
  lastmod,
});

// Ligne « Page mise à jour le … par … » : pages de contenu que l'on veut voir citées.
// Les articles de blog et la page auteur affichent déjà leur date et leur signature.
const UPDATED_PREFIXES = [
  '/services/',
  '/formations/',
  '/cas-clients/',
  '/cas-usages/',
  '/ressources/guides/',
  '/ressources/comparatifs/',
  '/ressources/diagnostics/',
  '/ressources/outils/',
  '/implantations/',
  '/secteurs/',
  '/demonstrations/',
];
const UPDATED_EXACT = ['/audit-ia-pme', '/conformite-ia', '/agence/methode', '/technologies'];
const wantsUpdated =
  showUpdated ?? (UPDATED_EXACT.includes(pagePath) || UPDATED_PREFIXES.some((prefix) => pagePath.startsWith(prefix)));
const updatedDate = wantsUpdated && !robotsNoindex ? lastmod : null;

// Maillage interne automatique : liens vers les pages du même sujet (lib/internal-mesh.ts).
// Les gabarits cas client et cas d'usage posent déjà cette section eux-mêmes.
const OWN_MESH_PREFIXES = ['/cas-clients/', '/cas-usages/'];
let autoMesh: ReturnType<typeof meshForPath> = null;
if (showMesh !== false && !robotsNoindex && !OWN_MESH_PREFIXES.some((prefix) => pagePath.startsWith(prefix))) {
  try {
    autoMesh = meshForPath(pagePath, lang);
  } catch {
    autoMesh = null;
  }
}
// Report du maillage avant la bande CTA finale : relais posé par SectionsRenderer (même clé,
// mode d'emploi dans components/sections/SectionsRenderer.astro). Délégué seulement si un
// renderer dont la dernière section est un `footer-cta-band` s'est déclaré hôte et n'a pas
// encore été rendu ; sinon le maillage reste en fin de <main>, comme avant. Une seule
// décision, ici : le bloc sort une fois, jamais deux.
type MeshHandoff = { host?: symbol; rendered: symbol[]; mesh?: typeof autoMesh };
const meshHandoff = (Astro.locals as unknown as Record<string, unknown> | undefined)?.__waimiaMeshHandoff as
  | MeshHandoff
  | undefined;
const meshDelegated = Boolean(autoMesh && meshHandoff?.host && !meshHandoff.rendered.includes(meshHandoff.host));
if (meshDelegated && meshHandoff) meshHandoff.mesh = autoMesh;
---
<!doctype html>
<html lang={HREFLANG[lang]} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />

    <SEO
      title={pageTitle}
      description={description}
      noindex={robotsNoindex}
      canonical={canonicalUrl}
      openGraph={{
        basic: {
          title: pageTitle,
          type: ogType,
          image: finalOgImage,
          url: canonicalUrl,
        },
        optional: {
          description: description,
          siteName: SITE.name,
          locale: lang === 'fr' ? 'fr_FR' : 'en_US',
        },
        image: {
          url: finalOgImage,
          width: 1200,
          height: 630,
          type: 'image/png',
          alt: pageTitle,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title: pageTitle,
        description: description,
        image: finalOgImage,
        imageAlt: pageTitle,
      }}
    />

    {/* Hreflang · site monolingue FR : la page est sa propre version fr-FR et x-default.
        Aucun alternate en-US (le miroir /en n'existe pas). twitter:site n'est pas émis :
        le compte déclaré dans site.config n'existe pas sur X (404 vérifié le 4 octobre 2026). */}
    <link rel="alternate" hreflang={HREFLANG[lang]} href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Waimia · Blog" href="/rss.xml" />
    {hasMarkdownMirror && <link rel="alternate" type="text/markdown" href={markdownHref} />}


    {/* Favicons + PWA manifest · nouveau mark PNG (identité géométrique) */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="manifest" href="/manifest.json" />

    {/* Polices self-hosted · Mission 03 perf · @font-face dans src/styles/fonts.css
        woff2 latin + latin-ext, servi depuis /public/fonts/ → 0 requête CDN tiers */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/instrument-serif-regular.woff2" crossorigin />
    {/* Italique préchargée avec la régulière : les titres mêlent les deux (<i class="acc">) ; si
        l'italique arrive après, le titre change de nombre de lignes (CLS 0,15 mesuré). */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/instrument-serif-italic.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-tight-regular.woff2" crossorigin fetchpriority="high" />

    {/* JSON-LD : Organization + WebSite + blocs de la page (cf lib/seo/page-schema.ts) */}
    <JsonLd data={allLd} />

    {/* Sitemap & RSS */}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    {/* Skip-to-content · WCAG 2.4.1 — apparaît au focus, masqué sinon */}
    <a href="#main" class="skip-link">
      {lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}
    </a>
    <ProgressBar />
    <CursorDot />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
      {autoMesh && !meshDelegated && <RelatedLinks data={{ ...autoMesh, background: 'paper-2' } as any} lang={lang} />}
      {updatedDate && <PageUpdated date={updatedDate} />}
    </main>
    <Footer />
    {import.meta.env.DEV && <PagePill />}
    <CookiesBanner lang={lang} />

    <script>
      import { initScrollReveal } from '../lib/animations/scroll-reveal';
      import { initSplitLetterReveal } from '../lib/animations/split-letter';
      import { initMotionSignature } from '../lib/animations/motion-signature';
      import { initContainerExpand } from '../lib/animations/container-expand';
      import { initScrollMorph } from '../lib/animations/scroll-morph';

      initScrollReveal();
      initSplitLetterReveal();
      initMotionSignature();
      initContainerExpand();
      initScrollMorph();
    </script>

    {/* Provenance des demandes (src/lib/lead-source.ts) : page d'arrivée, source d'entrée et page
        précédente, tenues EN MÉMOIRE pendant la visite (ni cookie ni stockage). Les formulaires
        lisent window.wmLeadSource() au moment de l'envoi ; l'embed Cal la reçoit à son affichage
        (politique de confidentialité v1.1). */}
    <script is:inline>
      (() => {
        if (typeof window === 'undefined' || window.wmLeadSource) return;
        const state = { landing: location.pathname, entry: 'direct', prev: '', current: location.pathname };
        try {
          if (document.referrer) {
            const u = new URL(document.referrer);
            if (u.origin === location.origin) { state.entry = 'interne'; state.prev = u.pathname; }
            else state.entry = u.hostname.replace(/^www\./, '');
          }
        } catch (_) { /* référent illisible : on garde « direct » */ }
        document.addEventListener('astro:after-swap', () => {
          if (location.pathname === state.current) return;
          state.prev = state.current;
          state.current = location.pathname;
        });
        window.wmLeadSource = () => ({ landing: state.landing, entry: state.entry, prev: state.prev || undefined });
      })();
    </script>

    {/* Mesure d'audience maison (src/lib/analytics, politique de confidentialité v1.2) : une page vue
        par chargement et par navigation View Transitions, un clic vers le rendez-vous. Sans cookie ni
        stockage ; n'agit que sur waimia.com et les previews Vercel (zéro requête en local, E2E, balayage). */}
    <script is:inline>
      (() => {
        const h = location.hostname;
        if (typeof window === 'undefined' || window.wmStats) return;
        if (!(h === 'waimia.com' || h === 'www.waimia.com' || h.endsWith('.vercel.app'))) return;
        window.wmStats = true;
        const send = (data) => {
          try {
            data.webdriver = navigator.webdriver === true;
            navigator.sendBeacon('/api/collect', JSON.stringify(data));
          } catch (_) { /* la mesure ne gêne jamais la page */ }
        };
        let referrer = document.referrer;
        document.addEventListener('astro:page-load', () => {
          const q = new URLSearchParams(location.search);
          const w = window.innerWidth;
          send({
            type: 'pageview',
            path: location.pathname,
            referrer,
            utm_source: q.get('utm_source') || undefined,
            utm_medium: q.get('utm_medium') || undefined,
            utm_campaign: q.get('utm_campaign') || undefined,
            device: w < 768 ? 'mobile' : w < 1024 ? 'tablette' : 'ordinateur',
          });
          referrer = location.origin + location.pathname;
        });
        document.addEventListener('click', (e) => {
          const a = e.target instanceof Element ? e.target.closest('a[href]') : null;
          const href = a ? a.getAttribute('href') || '' : '';
          if (href.includes('intent=audit') || href.includes('/contact?offer=') || href.includes('cal.com')) {
            send({ type: 'rdv_click', path: location.pathname });
          }
        }, true);
      })();
    </script>

    {/* Magnetic hover sur [data-mag] · réexécuté après View Transitions */}
    <script is:inline>
      (() => {
        if (typeof window === 'undefined') return;
        function initMagnetic() {
          if (!window.matchMedia('(pointer:fine)').matches) return;
          const reduced = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
          if (reduced) return;
          document.querySelectorAll('[data-mag]').forEach((el) => {
            if (el.dataset.magBound === '1') return;
            el.dataset.magBound = '1';
            const strength = parseFloat(el.getAttribute('data-mag') || '0.18');
            el.addEventListener('mousemove', (e) => {
              const r = el.getBoundingClientRect();
              const x = (e.clientX - r.left - r.width / 2) * strength;
              const y = (e.clientY - r.top - r.height / 2) * strength;
              el.style.transform = `translate(${x}px,${y}px)`;
            });
            el.addEventListener('mouseleave', () => { el.style.transform = ''; });
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initMagnetic);
        } else {
          initMagnetic();
        }
        document.addEventListener('astro:page-load', initMagnetic);
      })();
    </script>
  </body>
</html>

<style>
  main[id="main"]:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
</style>
