---
// Page · /solutions · Hub des 5 cas d'usage business horizontaux.
export const prerender = true;

// M2 : recadrage FR autour des douleurs PME récurrentes, sans créer les pages secteurs.

import Base from '../../layouts/Base.astro';
import Kicker from '../../components/ui/atoms/Kicker.astro';
import HeroCentered from '../../components/sections/HeroCentered.astro';
import CaseCardGrid from '../../components/sections/CaseCardGrid.astro';
import { caseCardGridData } from '../../lib/case-card-grid-data';
import type { SectionByType } from '../../schemas/sections';
import CtaFinal from '../../components/sections/CtaFinal.astro';

const horizontalSolutions = [
  { num: '01', kicker: 'PROBLÈME · CONTENU',
    title_fr: 'Contenu SEO / GEO IA', sub_fr: 'Trouvé par Google et les IA',
    lead_fr: 'Articles SEO premium, fiches GEO-ready, indexation sur les assistants IA.',
    href: '/solutions/contenu-seo-geo-ia' },
  { num: '02', kicker: 'PROBLÈME · CONTENU MARKETING',
    title_fr: 'Content marketing IA', sub_fr: 'Une ligne éditoriale qui attire et convertit',
    lead_fr: 'Briefs, calendrier, articles, repurposing multi-canal pilotés par l\'IA.',
    href: '/solutions/content-marketing-ia' },
  { num: '03', kicker: 'PROBLÈME · PUBLICITÉ',
    title_fr: 'Publicité en ligne', sub_fr: 'Campagnes pilotées au ROI, sans gaspillage',
    lead_fr: 'Google et Meta Ads pilotés à la donnée, chaque euro tracé jusqu\'à la conversion.',
    href: '/solutions/publicite-en-ligne' },
  { num: '04', kicker: 'PROBLÈME · CONVERSION',
    title_fr: 'Tunnel de vente', sub_fr: 'Du premier clic à la signature, sans friction',
    lead_fr: 'Parcours de conversion câblé, étapes mesurées, relances automatisées.',
    href: '/solutions/tunnel-de-vente' },
  { num: '05', kicker: 'PROBLÈME · PROSPECTION',
    title_fr: 'Agent marketing & commercial', sub_fr: 'Un agent qui prospecte et relance en continu',
    lead_fr: "Prospection et nurturing automatisés, l'équipe humaine sur les vrais sujets.",
    href: '/solutions/agent-marketing-commercial' },
];

const sectorSatellites = [
  { kicker: 'SECTEUR · 01', title_fr: 'Services B2B', lead_fr: 'Cabinets, conseil, agences, prestataires →', href: '/secteurs' },
  { kicker: 'SECTEUR · 02', title_fr: 'Industrie & PME industrielles', lead_fr: 'ERP, maintenance, qualité →', href: '/secteurs' },
  { kicker: 'SECTEUR · 03', title_fr: 'Finance & cabinets comptables', lead_fr: 'Réconciliation, reporting, conformité →', href: '/secteurs' },
];

const transitionIdFromHref = (href: string) =>
  href
    .replace(/^\/(?:en\/)?/, '')
    .replace(/\/$/, '')
    .replace(/[^a-z0-9]+/gi, '-')
    .replace(/^-|-$/g, '') || 'home';

const heroData = {
  type: 'hero-problem-index' as const,
  kicker_fr: "§ Solutions · 5 cas d'usage horizontaux",
  kicker_en: '§ Solutions · 5 horizontal use cases',
  h1_fr: 'Cinq <i>problèmes</i> business. Une <i>méthode</i>.',
  h1_en: 'Five <i>business</i> problems. One <i>method</i>.',
  lede_fr: "Cinq douleurs récurrentes. Pas de slide sur l'IA : un système câblé à votre stack, mesuré dès la première semaine.",
  lede_en: 'Five recurring pain points. No AI slide: a system wired to your stack, measured from the first week.',
  canonical_fr: "Nous ne vendons pas de l'IA. Nous construisons des <strong>systèmes</strong> qui tournent dans vos outils, que vous pouvez reprendre en main.",
  canonical_en: "We don't sell AI. We build <strong>systems</strong> that run in your tools, that you can take back in hand.",
  transition_id: 'solutions',
} satisfies SectionByType<'hero-problem-index'>;

const ctaData = {
  type: 'cta-final' as const,
  h2_fr: 'Prêt à livrer un <em>agent</em>,<br />pas un slide deck ?',
  h2_en: 'Ready to ship an <em>agent</em>,<br />not a slide deck?',
  body_fr: 'Audit IA en 5 jours. Premier agent en production en 4 semaines. ROI mesuré sur votre périmètre, jamais inventé.',
  body_en: 'AI audit in 5 days. First agent in production in 4 weeks. ROI measured on your scope, never invented.',
  cta_primary: { label_fr: 'Réserver un audit →', label_en: 'Book an audit →', href: '/contact', variant: 'primary' as const },
  cta_secondary: { label_fr: 'Voir la pyramide →', label_en: 'See the pyramid →', href: '/offres', variant: 'ghost' as const },
  background: 'paper' as const,
} satisfies SectionByType<'cta-final'>;
---
<Base
  title="Solutions · 5 cas d'usage business · Waimia"
  description="Cinq systèmes IA pour les douleurs récurrentes des PME : acquisition, CRM, contenu, productivité, support."
>
  <HeroCentered data={heroData} lang="fr" wrapMaxWidth="none" />

  <section class="hub-solutions wrap-wide reveal-blur-clip" aria-label="Solutions horizontales">
    {horizontalSolutions.map((sol) => (
      <a href={sol.href} class="hub-sol-card" transition:name={`card-${transitionIdFromHref(sol.href)}`}>
        <div class="hub-sol-num">{sol.num}</div>
        <div class="hub-sol-kicker">{sol.kicker}</div>
        <h2 class="hub-sol-title">{sol.title_fr}</h2>
        <p class="hub-sol-sub">{sol.sub_fr}</p>
        <p class="hub-sol-lead">{sol.lead_fr}</p>
        <span class="hub-sol-cta">Voir la solution →</span>
      </a>
    ))}
  </section>

  <section class="hub-sectors reveal-blur-clip">
    <div class="wrap-wide">
      <Kicker>§ Adapté à votre secteur</Kicker>
      <h2 class="hub-h2">Une méthode, votre <i>vocabulaire</i>.</h2>
      <p class="hub-lede">
        Mêmes systèmes, adaptés au métier : services B2B, industrie, finance & compta. Le reste à venir.
      </p>
      <div class="hub-sector-grid">
        {sectorSatellites.map((s) => (
          <a href={s.href} class="hub-sector-card" transition:name={`card-${transitionIdFromHref(s.href)}`}>
            <div class="hub-sector-kicker">{s.kicker}</div>
            <h3>{s.title_fr}</h3>
            <p>{s.lead_fr}</p>
          </a>
        ))}
        <a href="/secteurs" class="hub-sector-card hub-sector-card--all">
          <div class="hub-sector-kicker">TOUS</div>
          <h3>Tous les secteurs</h3>
          <p>L'index complet, à venir →</p>
        </a>
      </div>
    </div>
  </section>

  <CaseCardGrid data={caseCardGridData('fr')} lang="fr" />
  <CtaFinal data={ctaData} lang="fr" />
</Base>

<style>
  .hub-lede {
    font-family: var(--font-sans);
    font-style: italic;
    font-size: var(--text-h3-row);
    color: var(--ink-2);
    margin: var(--space-6) 0 0;
    max-width: 760px;
    line-height: var(--leading-lede);
    text-wrap: pretty;
  }
  .hub-solutions {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    padding: 0 var(--space-6) var(--section-base);
  }
  .hub-sol-card {
    min-height: 440px;
    padding: var(--space-6);
    border: 1px solid var(--hairline);
    background: var(--paper);
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: background 220ms var(--ease), border-color 220ms var(--ease), transform 220ms var(--ease);
  }
  .hub-sol-card:hover {
    background: var(--paper-2);
    border-color: var(--ink);
    transform: translateY(-4px);
  }
  .hub-sol-num {
    font-family: var(--font-display);
    font-size: var(--text-h1-display);
    line-height: 0.9;
    color: var(--accent-text);
    font-style: italic;
    margin-bottom: auto;
  }
  .hub-sol-kicker,
  .hub-sector-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hub-sol-title {
    font-family: var(--font-display);
    font-size: var(--text-h2-tight);
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: var(--fw-regular);
    margin: 18px 0 10px;
    text-wrap: balance;
  }
  .hub-sol-sub {
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.25;
    color: var(--ink);
    margin: 0 0 18px;
    text-wrap: balance;
  }
  .hub-sol-lead {
    color: var(--muted);
    font-size: var(--text-body-sm);
    line-height: 1.55;
    margin: 0 0 28px;
  }
  .hub-sol-cta {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--accent-text);
    margin-top: auto;
  }

  .hub-sectors {
    padding: var(--section-base) var(--space-6);
    background: var(--paper-2);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .hub-h2 {
    font-family: var(--font-display);
    font-size: var(--text-stat);
    line-height: var(--leading-h1);
    letter-spacing: -0.024em;
    margin: 18px 0 0;
    text-wrap: balance;
    font-weight: var(--fw-regular);
  }
  .hub-h2 :global(i) { font-style: italic; color: var(--ink); }
  .hub-sector-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-top: var(--space-9);
    border: 1px solid var(--hairline);
    background: var(--hairline);
  }
  .hub-sector-card {
    min-height: 230px;
    background: var(--paper);
    color: inherit;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    transition: background 220ms var(--ease), color 220ms var(--ease);
  }
  .hub-sector-card:hover { background: var(--ink); color: var(--paper); }
  .hub-sector-card:hover .hub-sector-kicker,
  .hub-sector-card:hover p { color: rgba(var(--paper-rgb), 0.72); }
  .hub-sector-card h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3-row);
    line-height: 1.05;
    letter-spacing: -0.018em;
    font-weight: var(--fw-regular);
    margin: auto 0 var(--space-4);
    text-wrap: balance;
  }
  .hub-sector-card p {
    color: var(--muted);
    line-height: 1.45;
    margin: 0;
  }
  .hub-sector-card--all { background: var(--ink); color: var(--paper); }
  .hub-sector-card--all .hub-sector-kicker,
  .hub-sector-card--all p { color: rgba(var(--paper-rgb), 0.65); }

  @media (max-width: 1180px) {
    .hub-solutions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hub-sector-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .hub-solutions {
      grid-template-columns: 1fr;
      padding-inline: 20px;
    }
    .hub-sol-card { min-height: 330px; }
    .hub-sectors { padding-inline: 20px; }
    .hub-sector-grid { grid-template-columns: 1fr; }
  }
</style>
