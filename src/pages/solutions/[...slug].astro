---
export const prerender = true;

// Page SSG · /solutions/[slug] · rendu 100 % composable (registry).
// R6 (2026-06-10) · fallback SolutionsDetailTemplate supprimé ICI (voie morte,
// 8/8 solutions composables) ; le template reste LIVE via secteurs/[...slug].astro.
// MDX sans `sections:` = erreur de build volontaire (anti-orphelin).

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import Breadcrumb from '../../components/ui/molecules/Breadcrumb.astro';
import { buildService } from '../../lib/seo/schema-builder';

export async function getStaticPaths() {
  const entries = await getCollection('solutions');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const data = entry.data;

const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fr';
const title = lang === 'en' ? data.title_en: data.title_fr;
const description = lang === 'en' ? data.description_en: data.description_fr;

if (!Array.isArray(data.sections) || data.sections.length === 0) {
  throw new Error(`solutions/${entry.id} : frontmatter \`sections:\` requis (voie template legacy éteinte en R6)`);
}

const serviceLd = buildService({ name: title, description });
---

<Base title={title} description={description} jsonLd={[serviceLd]}>
  <Breadcrumb
    lang={lang}
    items={[
      { label: lang === 'fr' ? 'Accueil' : 'Home', href: lang === 'fr' ? '/' : '/en' },
      { label: 'Solutions', href: lang === 'fr' ? '/solutions' : '/en/solutions' },
      { label: data.dept_label ?? title },
    ]}
  />
  <SectionsRenderer sections={data.sections!} lang={lang} />
</Base>
