---
// Page · /plan-du-site · Plan du site (FR)
// Plan structuré dérivé de la source de vérité navigation (src/data/sitemap.ts).
// Aucun lien inventé : sections + liens reconstruits depuis les méga-menus et le
// footer déjà définis. Le miroir EN vit sous /en/plan-du-site.astro.
export const prerender = true;

import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import {
  MM_SOLUTIONS,
  MM_OFFRES,
  MM_CASES_NEW,
  MM_TECH,
  MM_RESOURCES,
  MM_AGENCY_NEW,
  FOOTER_COLS,
  type MegaMenu,
  type BiText,
} from '../data/sitemap';
import { isLegacyRoutedType } from '../lib/blog-routing';
import { langFromPath, t, localizeHref } from '../lib/i18n';

const lang = langFromPath(Astro.url.pathname);

type PlanLink = { href: string; label: BiText };
type PlanGroup = { heading: BiText; links: PlanLink[] };
type PlanSection = { title: BiText; href: string; lead?: BiText; groups: PlanGroup[] };

// Ne garde que les liens internes « propres » : chemin absolu, pas d'ancre,
// pas de query-string (les variantes filtrées type /cas-clients?secteur= renvoient à la
// même page que le lien parent), dédupliqués par href final.
function cleanLinks(items: PlanLink[]): PlanLink[] {
  const seen = new Set<string>();
  const out: PlanLink[] = [];
  for (const it of items) {
    const href = it.href;
    if (!href || !href.startsWith('/')) continue;
    if (href.includes('#') || href.includes('?')) continue;
    // Exclut les anciennes URL /ressources/cas/* (canonicalisées vers /cas-clients/* ou /,
    // cf astro.config redirects) : le plan ne liste que des destinations finales.
    if (href.startsWith('/ressources/cas/') || href === '/ressources/cas') continue;
    if (seen.has(href)) continue;
    seen.add(href);
    out.push(it);
  }
  return out;
}

function megaToSection(mm: MegaMenu): PlanSection {
  return {
    title: mm.label,
    href: mm.href,
    lead: mm.lead,
    groups: mm.cols.map((col) => ({
      heading: col.label,
      links: cleanLinks(col.items.map((i) => ({ href: i.href, label: i.label }))),
    })),
  };
}

const navSections: PlanSection[] = [
  MM_SOLUTIONS,
  MM_OFFRES,
  MM_CASES_NEW,
  MM_TECH,
  MM_RESOURCES,
  MM_AGENCY_NEW,
].map(megaToSection);

// Le footer ajoute les accès transverses (légal, contact, etc.) absents des méga-menus.
const footerGroups: PlanGroup[] = FOOTER_COLS.map((col) => ({
  heading: col.heading,
  links: cleanLinks(col.items.map((i) => ({ href: i.href, label: i.label }))),
}));

// ─── Index exhaustif : pages individuelles générées par les collections ───
// La navigation curée ne liste que les hubs (/cas-clients, /ressources/blog, …).
// Ces groupes ajoutent CHAQUE page réelle des collections, dérivées avec la MÊME
// route + le MÊME filtre que les getStaticPaths correspondants (single source of
// truth : src/pages/<collection>/[...slug].astro). Aucun href inventé.
const dedup = new Set<string>();
for (const s of navSections) for (const g of s.groups) for (const l of g.links) dedup.add(l.href);
for (const g of footerGroups) for (const l of g.links) dedup.add(l.href);
dedup.add('/plan-du-site');

// Retire de la liste les pages déjà présentes dans la nav/footer (anti-doublon global),
// en plus du nettoyage standard (cleanLinks) appliqué en amont.
function uniqueAgainstNav(links: PlanLink[]): PlanLink[] {
  const out: PlanLink[] = [];
  for (const l of cleanLinks(links)) {
    if (dedup.has(l.href)) continue;
    dedup.add(l.href);
    out.push(l);
  }
  return out;
}

const sortFr = (a: PlanLink, b: PlanLink) => t(a.label, 'fr').localeCompare(t(b.label, 'fr'), 'fr');

// cases → /cas-clients/<entry.id> · filtre !seo.noindex (cf cas-clients/[...slug].astro)
const allCases = (await getCollection('cases'))
  .filter((e) => !e.data.seo?.noindex)
  .map((e) => ({ href: `/cas-clients/${e.id}`, label: { fr: e.data.title_fr, en: e.data.title_en } }));

// secteurs → /secteurs/<slug ?? id> · filtre visible (cf secteurs/[...slug].astro)
const allSecteurs = (await getCollection('secteurs'))
  .filter((e) => e.data.visible)
  .map((e) => {
    const slug = e.data.slug ?? e.id;
    const name = slug.replace(/-/g, ' ').replace(/^\w/, (c) => c.toUpperCase());
    return { href: `/secteurs/${slug}`, label: { fr: name, en: name } };
  });

// blog → /ressources/blog/<entry.id> · filtre !seo.noindex && !legacyRoutedType (cf blog/[...slug].astro)
const allBlog = (await getCollection('blog'))
  .filter((e) => !e.data.seo?.noindex && !isLegacyRoutedType(e))
  .map((e) => ({ href: `/ressources/blog/${e.id}`, label: { fr: e.data.title_fr, en: e.data.title_en } }));

// outils → /ressources/outils/<entry.id> · filtre !seo.noindex (cf outils/[...slug].astro)
const allOutils = (await getCollection('outils'))
  .filter((e) => !e.data.seo?.noindex)
  .map((e) => ({ href: `/ressources/outils/${e.id}`, label: { fr: e.data.title_fr, en: e.data.title_en } }));

// services → /services/<entry.id> · pas de filtre (cf services/[...slug].astro mappe tout)
const allServices = (await getCollection('services'))
  .map((e) => ({ href: `/services/${e.id}`, label: { fr: e.data.title_fr, en: e.data.title_en } }));

// Collection `offres` retirée (refonte v7) : le seul contenu indexé survivant est
// l'audit de maturité, désormais page top-level /audit-maturite-ia.
const allOffres = [
  { href: '/audit-maturite-ia', label: { fr: 'Audit Maturité IA', en: 'AI Maturity Audit' } },
];

// authors → /equipe/<entry.id> · filtre !seo.noindex (cf equipe/[...slug].astro)
const allAuthors = (await getCollection('authors'))
  .filter((e) => !e.data.seo?.noindex)
  .map((e) => ({ href: `/equipe/${e.id}`, label: { fr: e.data.title_fr, en: e.data.title_en } }));

// Hubs/index publics indexables omis par les méga-menus, classés par univers.
const homePage: PlanLink = { href: '/', label: { fr: 'Accueil', en: 'Home' } };
const secteursIndex: PlanLink = { href: '/secteurs', label: { fr: 'Tous les secteurs', en: 'All sectors' } };
const teamPages: PlanLink[] = [
  { href: '/equipe', label: { fr: "L'équipe", en: 'The team' } },
  { href: '/sources-methodologie', label: { fr: 'Sources & méthodologie', en: 'Sources & methodology' } },
];

const indexSection: PlanSection = {
  title: { fr: 'Toutes les pages', en: 'All pages' },
  href: '/plan-du-site',
  lead: {
    fr: 'Chaque page publique du site, au-delà des entrées de navigation : cas clients, secteurs, articles et outils.',
    en: 'Every public page on the site, beyond the navigation entries: case studies, sectors, articles and tools.',
  },
  groups: [
    { heading: { fr: 'Cas clients', en: 'Case studies' }, links: uniqueAgainstNav(allCases).sort(sortFr) },
    { heading: { fr: 'Secteurs', en: 'Sectors' }, links: uniqueAgainstNav([secteursIndex, ...allSecteurs]).sort(sortFr) },
    { heading: { fr: 'Articles & ressources', en: 'Articles & resources' }, links: uniqueAgainstNav(allBlog).sort(sortFr) },
    { heading: { fr: 'Outils', en: 'Tools' }, links: uniqueAgainstNav(allOutils).sort(sortFr) },
    { heading: { fr: 'Services & offres', en: 'Services & offers' }, links: uniqueAgainstNav([...allServices, ...allOffres]).sort(sortFr) },
    { heading: { fr: 'Agence & équipe', en: 'Agency & team' }, links: uniqueAgainstNav([homePage, ...allAuthors, ...teamPages]).sort(sortFr) },
  ].filter((g) => g.links.length > 0),
};

const allSections: PlanSection[] = indexSection.groups.length > 0
  ? [...navSections, indexSection]
  : navSections;

const totalLinks =
  allSections.reduce((n, s) => n + s.groups.reduce((m, g) => m + g.links.length, 0), 0) +
  footerGroups.reduce((m, g) => m + g.links.length, 0);

const title = lang === 'fr'
  ? 'Plan du site · Waimia'
  : 'Site map · Waimia';
const description = lang === 'fr'
  ? 'Toutes les pages de Waimia en un coup d’œil : solutions IA, offres, cas clients, technologies, ressources et l’agence.'
  : 'Every Waimia page at a glance: AI solutions, services, case studies, technologies, resources and the agency.';

const lh = (href: string) => localizeHref(href, lang);

const footerHeading = lang === 'fr' ? 'Accès transverses' : 'Across the site';
const linkCountLabel = lang === 'fr'
  ? `${totalLinks} pages référencées`
  : `${totalLinks} pages listed`;
---
<Base title={title} description={description}>
  <section class="wrap" style="padding-top:var(--section-loose);padding-bottom:var(--space-10)">
    <p style="font-family:var(--font-mono);font-size:var(--text-small);letter-spacing:.16em;text-transform:uppercase;color:var(--accent-text);margin:0 0 16px">
      {lang === 'fr' ? '§ Navigation' : '§ Navigation'}
    </p>
    <h1 style="font-size:var(--text-h1);line-height:var(--leading-tight);color:var(--ink);margin:0;max-width:18ch">
      {lang === 'fr' ? 'Plan du site' : 'Site map'}
    </h1>
    <p style="font-size:var(--text-body);color:var(--ink-2);max-width:56ch;margin-top:var(--space-5);line-height:var(--leading-lede)">
      {lang === 'fr'
        ? 'Toutes les destinations du site, regroupées par univers. Une seule source de vérité, dérivée de la navigation.'
        : 'Every destination on the site, grouped by area. A single source of truth, derived from the navigation.'}
    </p>
    <p style="font-family:var(--font-mono);font-size:var(--text-small);letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-top:var(--space-4)">
      {linkCountLabel}
    </p>
  </section>

  <nav class="wrap planmap" aria-label={lang === 'fr' ? 'Plan du site' : 'Site map'} style="padding-bottom:var(--section-loose)">
    {allSections.map((section) => (
      <section class="planmap-section hline" style="padding-top:var(--space-8);padding-bottom:var(--space-4)">
        <div class="planmap-head">
          <h2 style="font-size:var(--text-h2);color:var(--ink);margin:0">
            <a href={lh(section.href)} class="planmap-title-link">{t(section.title, lang)}</a>
          </h2>
          {section.lead && (
            <p style="font-size:var(--text-small);color:var(--muted);max-width:48ch;margin:var(--space-2) 0 0;line-height:var(--leading-lede)">
              {t(section.lead, lang)}
            </p>
          )}
        </div>
        <div class="planmap-cols">
          {section.groups.map((group) => (
            <div class="planmap-group">
              <h3 style="font-family:var(--font-mono);font-size:var(--text-small);letter-spacing:.14em;text-transform:uppercase;color:var(--accent-text);margin:0 0 14px;font-weight:var(--fw-medium)">
                {t(group.heading, lang)}
              </h3>
              <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px">
                {group.links.map((link) => (
                  <li>
                    <a href={lh(link.href)} class="planmap-link">{t(link.label, lang)}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    ))}

    <section class="planmap-section hline" style="padding-top:var(--space-8)">
      <div class="planmap-head">
        <h2 style="font-size:var(--text-h2);color:var(--ink);margin:0">{footerHeading}</h2>
      </div>
      <div class="planmap-cols">
        {footerGroups.map((group) => (
          <div class="planmap-group">
            <h3 style="font-family:var(--font-mono);font-size:var(--text-small);letter-spacing:.14em;text-transform:uppercase;color:var(--accent-text);margin:0 0 14px;font-weight:var(--fw-medium)">
              {t(group.heading, lang)}
            </h3>
            <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px">
              {group.links.map((link) => (
                <li>
                  <a href={lh(link.href)} class="planmap-link">{t(link.label, lang)}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </nav>
</Base>

<style>
  .planmap-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
  }
  .planmap-head {
    max-width: 60ch;
  }
  .planmap-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-7);
  }
  .planmap-title-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-trim) var(--ease);
  }
  .planmap-title-link:hover {
    color: var(--accent-text);
  }
  .planmap-link {
    font-size: var(--text-small);
    color: var(--ink-2);
    text-decoration: none;
    line-height: var(--leading-lede);
    transition: color var(--dur-trim) var(--ease);
  }
  .planmap-link:hover,
  .planmap-link:focus-visible {
    color: var(--accent-text);
  }
  @media (min-width: 880px) {
    .planmap-section {
      grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
      align-items: start;
    }
  }
</style>
