---
// Page · /plan-du-site · Plan du site (FR)
// Plan structuré dérivé de la source de vérité navigation (src/data/sitemap.ts).
// Aucun lien inventé : sections + liens reconstruits depuis les méga-menus et le
// footer déjà définis. Le miroir EN vit sous /en/plan-du-site.astro.
export const prerender = true;

import Base from '../layouts/Base.astro';
import {
  MM_SOLUTIONS,
  MM_OFFRES,
  MM_CASES_NEW,
  MM_TECH,
  MM_RESOURCES,
  MM_AGENCY_NEW,
  FOOTER_COLS,
  type MegaMenu,
  type BiText,
} from '../data/sitemap';
import { langFromPath, t, localizeHref } from '../lib/i18n';

const lang = langFromPath(Astro.url.pathname);

type PlanLink = { href: string; label: BiText };
type PlanGroup = { heading: BiText; links: PlanLink[] };
type PlanSection = { title: BiText; href: string; lead?: BiText; groups: PlanGroup[] };

// Ne garde que les liens internes « propres » : chemin absolu, pas d'ancre,
// pas de query-string (les variantes filtrées type /cas?secteur= renvoient à la
// même page que le lien parent), dédupliqués par href final.
function cleanLinks(items: PlanLink[]): PlanLink[] {
  const seen = new Set<string>();
  const out: PlanLink[] = [];
  for (const it of items) {
    const href = it.href;
    if (!href || !href.startsWith('/')) continue;
    if (href.includes('#') || href.includes('?')) continue;
    // Exclut les anciennes URL /ressources/cas/* (canonicalisées vers /cas/* ou /,
    // cf astro.config redirects) : le plan ne liste que des destinations finales.
    if (href.startsWith('/ressources/cas/') || href === '/ressources/cas') continue;
    if (seen.has(href)) continue;
    seen.add(href);
    out.push(it);
  }
  return out;
}

function megaToSection(mm: MegaMenu): PlanSection {
  return {
    title: mm.label,
    href: mm.href,
    lead: mm.lead,
    groups: mm.cols.map((col) => ({
      heading: col.label,
      links: cleanLinks(col.items.map((i) => ({ href: i.href, label: i.label }))),
    })),
  };
}

const navSections: PlanSection[] = [
  MM_SOLUTIONS,
  MM_OFFRES,
  MM_CASES_NEW,
  MM_TECH,
  MM_RESOURCES,
  MM_AGENCY_NEW,
].map(megaToSection);

// Le footer ajoute les accès transverses (légal, contact, etc.) absents des méga-menus.
const footerGroups: PlanGroup[] = FOOTER_COLS.map((col) => ({
  heading: col.heading,
  links: cleanLinks(col.items.map((i) => ({ href: i.href, label: i.label }))),
}));

const totalLinks =
  navSections.reduce((n, s) => n + s.groups.reduce((m, g) => m + g.links.length, 0), 0) +
  footerGroups.reduce((m, g) => m + g.links.length, 0);

const title = lang === 'fr'
  ? 'Plan du site · Waimia'
  : 'Site map · Waimia';
const description = lang === 'fr'
  ? 'Toutes les pages de Waimia en un coup d’œil : solutions IA, offres, cas clients, technologies, ressources et l’agence.'
  : 'Every Waimia page at a glance: AI solutions, services, case studies, technologies, resources and the agency.';

const lh = (href: string) => localizeHref(href, lang);

const footerHeading = lang === 'fr' ? 'Accès transverses' : 'Across the site';
const linkCountLabel = lang === 'fr'
  ? `${totalLinks} pages référencées`
  : `${totalLinks} pages listed`;
---
<Base title={title} description={description}>
  <section class="wrap" style="padding-top:var(--section-loose);padding-bottom:var(--space-10)">
    <p style="font-family:var(--font-mono);font-size:var(--text-eyebrow);letter-spacing:.16em;text-transform:uppercase;color:var(--accent-text);margin:0 0 16px">
      {lang === 'fr' ? '§ Navigation' : '§ Navigation'}
    </p>
    <h1 style="font-size:var(--text-h1-hero);line-height:var(--leading-tight);color:var(--ink);margin:0;max-width:18ch">
      {lang === 'fr' ? 'Plan du site' : 'Site map'}
    </h1>
    <p style="font-size:var(--text-body-md);color:var(--ink-2);max-width:56ch;margin-top:var(--space-5);line-height:var(--leading-lede)">
      {lang === 'fr'
        ? 'Toutes les destinations du site, regroupées par univers. Une seule source de vérité, dérivée de la navigation.'
        : 'Every destination on the site, grouped by area. A single source of truth, derived from the navigation.'}
    </p>
    <p style="font-family:var(--font-mono);font-size:var(--text-eyebrow);letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-top:var(--space-4)">
      {linkCountLabel}
    </p>
  </section>

  <nav class="wrap planmap" aria-label={lang === 'fr' ? 'Plan du site' : 'Site map'} style="padding-bottom:var(--section-loose)">
    {navSections.map((section) => (
      <section class="planmap-section hline" style="padding-top:var(--space-8);padding-bottom:var(--space-4)">
        <div class="planmap-head">
          <h2 style="font-size:var(--text-h2-section);color:var(--ink);margin:0">
            <a href={lh(section.href)} class="planmap-title-link">{t(section.title, lang)}</a>
          </h2>
          {section.lead && (
            <p style="font-size:var(--text-ui);color:var(--muted);max-width:48ch;margin:var(--space-2) 0 0;line-height:var(--leading-lede)">
              {t(section.lead, lang)}
            </p>
          )}
        </div>
        <div class="planmap-cols">
          {section.groups.map((group) => (
            <div class="planmap-group">
              <h3 style="font-family:var(--font-mono);font-size:var(--text-eyebrow);letter-spacing:.14em;text-transform:uppercase;color:var(--accent-text);margin:0 0 14px;font-weight:var(--fw-medium)">
                {t(group.heading, lang)}
              </h3>
              <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px">
                {group.links.map((link) => (
                  <li>
                    <a href={lh(link.href)} class="planmap-link">{t(link.label, lang)}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    ))}

    <section class="planmap-section hline" style="padding-top:var(--space-8)">
      <div class="planmap-head">
        <h2 style="font-size:var(--text-h2-section);color:var(--ink);margin:0">{footerHeading}</h2>
      </div>
      <div class="planmap-cols">
        {footerGroups.map((group) => (
          <div class="planmap-group">
            <h3 style="font-family:var(--font-mono);font-size:var(--text-eyebrow);letter-spacing:.14em;text-transform:uppercase;color:var(--accent-text);margin:0 0 14px;font-weight:var(--fw-medium)">
              {t(group.heading, lang)}
            </h3>
            <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px">
              {group.links.map((link) => (
                <li>
                  <a href={lh(link.href)} class="planmap-link">{t(link.label, lang)}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </nav>
</Base>

<style>
  .planmap-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
  }
  .planmap-head {
    max-width: 60ch;
  }
  .planmap-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-7);
  }
  .planmap-title-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-trim) var(--ease);
  }
  .planmap-title-link:hover {
    color: var(--accent-text);
  }
  .planmap-link {
    font-size: var(--text-ui);
    color: var(--ink-2);
    text-decoration: none;
    line-height: var(--leading-lede);
    transition: color var(--dur-trim) var(--ease);
  }
  .planmap-link:hover,
  .planmap-link:focus-visible {
    color: var(--accent-text);
  }
  @media (min-width: 880px) {
    .planmap-section {
      grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
      align-items: start;
    }
  }
</style>
