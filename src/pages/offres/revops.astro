---
// Page · /offres/revops · Service RevOps Rebuild
// Migré vers architecture composable (SectionsRenderer + sections[]) — registry adoption Phase 1.
// Source legacy : ServiceDetailTemplate.astro + slots HTML (cf git history).
export const prerender = true;

import Base from '../../layouts/Base.astro';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import type { SectionData } from '../../schemas/sections';

const lang = 'fr';

const sections: SectionData[] = [
  // 1. MASTHEAD
  {
    type: 'hero-service-detail',
    service_num: '03.1',
    h1_fr: 'Un <i>funnel</i> réconcilié. Une vérité. Pas d\'atelier.',
    h1_en: 'A reconciled <i>funnel</i>. One truth. No workshop.',
    lede_fr: 'Un chantier de 8 à 12 semaines. CRM, entrepôt, finance alignés sur une seule source de vérité. Des agents Claude qui trient, qualifient et routent, de façon auditable, sans boîte noire, sans chatbot.',
    lede_en: 'An 8-to-12-week engagement. CRM, warehouse, finance aligned on a single source of truth. Claude agents that triage, qualify and route, auditably, no black box, no chatbot.',
  },

  // 2. PROBLEM STATEMENT
  {
    type: 'problem-statement',
    kicker_fr: '§ 01 · Le problème',
    kicker_en: '§ 01 · The problem',
    statement_fr: 'Le RevOps moyen <i>empile 43 outils</i> dont moins de 9 touchent le même enregistrement client. Les agents IA livrés dans ce chaos finissent en démos. Notre travail commence par <i>désempiler</i>.<br><br>Le symptôme classique : cycle deal à <i>94 jours</i>, taux SQL vers Deal bloqué à <i>18 %</i>, LTV fragile parce que le scoring initial ne reflète pas la réalité terrain. On commence par désempiler, pas par livrer un agent de plus.',
    statement_en: 'The average RevOps stack <i>piles up 43 tools</i>, fewer than 9 of which touch the same customer record. AI agents delivered into this chaos end up as demos. Our work starts by <i>unstacking</i>.<br><br>The classic symptom: deal cycle at <i>94 days</i>, SQL-to-Deal rate stuck at <i>18 %</i>, fragile LTV because the initial scoring does not reflect ground reality. We start by unstacking, not by shipping one more agent.',
    stats: [
      { value: '43',   label_fr: 'outils dans la stack RevOps moyenne', label_en: 'tools in the average RevOps stack' },
      { value: '< 9',  label_fr: 'touchent le même enregistrement client', label_en: 'touch the same customer record' },
      { value: '× 4',  label_fr: 'taux de réussite 6 sem vs 6 mois', label_en: 'success rate 6 wks vs 6 mos' },
      { value: '94 j', label_fr: 'cycle deal moyen avant RevOps', label_en: 'avg deal cycle before RevOps' },
    ],
  },

  // 3. APPROACH · method-timeline
  {
    type: 'method-timeline',
    kicker_fr: '§ 02 · L\'approche',
    kicker_en: '§ 02 · The approach',
    h2_fr: 'Quatre <i>phases</i>. Pas un atelier.',
    h2_en: 'Four <i>phases</i>. Not a workshop.',
    lede_fr: 'Notre méthode reste la même quel que soit le secteur : diagnostic, réconciliation, automatisation, mesure. Ce qui change, c\'est la grammaire métier.',
    lede_en: 'Our method stays the same regardless of the sector: diagnose, reconcile, automate, measure. What changes is the business grammar.',
    steps: [
      {
        num: '01',
        label_fr: 'Audit du funnel',
        label_en: 'Funnel audit',
        body_fr: 'On lit votre CRM, votre entrepôt, votre facturation. On note où ils mentent, et à quel coût. Livrable intermédiaire : journal des incohérences par source.',
        body_en: 'We read your CRM, warehouse, billing. We log where they lie, and at what cost. Intermediate deliverable: inconsistency log per source.',
        meta_fr: 'Diagnostiquer',
        meta_en: 'Diagnose',
      },
      {
        num: '02',
        label_fr: 'Source de vérité unique',
        label_en: 'Single source of truth',
        body_fr: 'On désigne quel système gagne sur chaque champ. On documente la règle dans Confluence. Chaque conflit a un arbitrage écrit, pas une convention orale.',
        body_en: 'We declare which system wins per field. Rule documented in Confluence. Every conflict has a written arbitration, not a verbal convention.',
        meta_fr: 'Reconcilier',
        meta_en: 'Reconcile',
      },
      {
        num: '03',
        label_fr: 'Agents de triage',
        label_en: 'Triage agents',
        body_fr: 'Claude triage les leads, qualifie, route. Pas de chatbot : du routage auditable. Chaque décision de scoring est rejouable. Zéro boîte noire.',
        body_en: 'Claude triages leads, qualifies, routes. Not a chatbot: auditable routing. Every scoring decision is replayable. Zero black box.',
        meta_fr: 'Automatiser',
        meta_en: 'Automate',
      },
      {
        num: '04',
        label_fr: 'Tableaux & alertes',
        label_en: 'Dashboards & alerts',
        body_fr: 'Pipeline live, conversion par segment, alertes de dérive. Si SQL vers Deal descend sous le seuil, un ticket est créé avant la réunion de pipeline. Visible par la finance et le CEO.',
        body_en: 'Live pipeline, conversion per segment, drift alerts. If SQL to Deal drops below threshold, a ticket is created before the pipeline review. Visible to finance and CEO.',
        meta_fr: 'Mesurer',
        meta_en: 'Measure',
      },
    ],
  },

  // 4. PROOF · stat-block (split-quote layout)
  {
    type: 'stat-block',
    quote_fr: 'On a arrêté de débattre des chiffres en comité. La même métrique vit dans Salesforce, dans dbt et dans le dossier de direction.',
    quote_en: 'We stopped debating numbers in committee. The same metric lives in Salesforce, in dbt, and in the board pack.',
    cite_fr: 'Direction des opérations · SaaS B2B',
    cite_en: 'Operations lead · B2B SaaS',
    layout: 'split-quote',
    metrics: [
      { value: 'Réactivé', label_fr: 'Pipeline historique',       label_en: 'Historical pipeline',      emphasis: true },
      { value: 'Mesuré',   label_fr: 'Conversion SQL vers Deal',  label_en: 'SQL to Deal conversion',   emphasis: true },
      { value: 'Suivi',    label_fr: 'Temps de triage',           label_en: 'Triage time',              emphasis: false },
      { value: '10 sem',  label_fr: 'Durée du chantier',         label_en: 'Project duration',         emphasis: false },
      { value: '94→61 j', label_fr: 'Cycle deal après rebuild',  label_en: 'Deal cycle after rebuild', emphasis: false },
    ],
  },

  // 5. STACK · tech-stack-band
  {
    type: 'tech-stack-band',
    kicker_fr: '§ 04 · La stack',
    kicker_en: '§ 04 · The stack',
    lead_fr: 'Une stack délibérément <i>petite</i>. Claude pour la cognition des leads, dbt pour la lecture multi-sources, votre CRM comme seul système d\'écriture. Aucune couche no-code intermédiaire qui crée de la dette invisible.',
    lead_en: 'A deliberately <i>small</i> stack. Claude for lead cognition, dbt for multi-source reading, your CRM as the only write system. No intermediate no-code layer creating invisible debt.',
    pills: [
      { label_fr: 'Claude Opus 4.8',    label_en: 'Claude Opus 4.8',    kind: 'primary' },
      { label_fr: 'Claude Sonnet 4.6',  label_en: 'Claude Sonnet 4.6',  kind: 'primary' },
      { label_fr: 'HubSpot',            label_en: 'HubSpot',            kind: 'neutral' },
      { label_fr: 'Salesforce',         label_en: 'Salesforce',         kind: 'neutral' },
      { label_fr: 'dbt',                label_en: 'dbt',                kind: 'open'    },
      { label_fr: 'PostgreSQL',         label_en: 'PostgreSQL',         kind: 'open'    },
      { label_fr: 'Snowflake',          label_en: 'Snowflake',          kind: 'neutral' },
    ],
  },

  // 6. RELATED · related-cards-band
  {
    type: 'related-cards-band',
    kicker_fr: '§ 05 · Connexes',
    kicker_en: '§ 05 · Related',
    cards: [
      {
        kicker_fr: 'CAS',
        kicker_en: 'CASE',
        title_fr: 'Études de cas',
        title_en: 'Case studies',
        lead_fr: 'Le type de refonte qui a inspiré ce service',
        lead_en: 'The kind of rebuild that inspired this service',
        href: '/cas',
      },
      {
        kicker_fr: 'SERVICE 02.3',
        kicker_en: 'SERVICE 02.3',
        title_fr: 'Gouvernance des données',
        title_en: 'Data governance',
        lead_fr: 'Pré-requis amont du RevOps Rebuild',
        lead_en: 'Prerequisite upstream of RevOps Rebuild',
        href: '/offres/conseil',
      },
      {
        kicker_fr: 'OFFRE 03.1',
        kicker_en: 'OFFRE 03.1',
        title_fr: 'Agents métiers',
        title_en: 'Business agents',
        lead_fr: 'Triage Claude au-delà du RevOps',
        lead_en: 'Claude triage beyond RevOps',
        href: '/offres/agents-metiers',
      },
    ],
  },

  // 7. CTA FINAL
  {
    type: 'cta-final',
    h2_fr: 'Prêt à rendre ce <i>chantier</i> opérable ?',
    h2_en: 'Ready to make this <i>engagement</i> operational?',
    body_fr: 'On part de RevOps Rebuild et on vous dit vite si le sujet mérite un sprint, un audit ou un non ferme.',
    body_en: 'We start from RevOps Rebuild and tell you quickly whether the topic deserves a sprint, an audit, or a firm no.',
    cta_primary: {
      label_fr: 'Réserver un audit',
      label_en: 'Book an audit',
      href: '/contact',
      variant: 'primary',
    },
    cta_secondary: {
      label_fr: 'Voir les offres',
      label_en: 'See services',
      href: '/offres',
      variant: 'ghost',
    },
    background: 'paper',
  },
];
---
<Base
  title="RevOps Rebuild · Waimia"
  description="Réconcilier CRM, entrepôt et facturation pour qu'une seule vérité circule. Des agents Claude qui font le tri sans théâtre."
>
  <SectionsRenderer sections={sections} lang={lang} />
</Base>
