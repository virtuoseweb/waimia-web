---
export const prerender = true;

// Page SSG · /offres/[slug] · Consumer MDX collection "offres"
// Rendu 100 % composable : frontmatter `sections:` → SectionsRenderer (registry).
// R6 (2026-06-10) · voie template legacy ÉTEINTE : le fallback OffresDetailTemplate
// (mort depuis que 9/9 offres sont composables) est supprimé ; un MDX sans
// `sections:` casse le build volontairement (anti-orphelin, pas de fallback
// silencieux vers un template).

import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import Breadcrumb from '../../components/ui/molecules/Breadcrumb.astro';
import { langFromPath } from '../../lib/i18n';
import { buildService, buildOffer } from '../../lib/seo/schema-builder';

export async function getStaticPaths() {
  const entries = await getCollection('offres');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<'offres'> };
const { entry } = Astro.props as Props;
const data = entry.data;
const lang = langFromPath(Astro.url.pathname);

if (!Array.isArray(data.sections) || data.sections.length === 0) {
  throw new Error(`offres/${entry.id} : frontmatter \`sections:\` requis (voie template legacy éteinte en R6)`);
}

const tina = import.meta.env.DEV
  ? await Promise.all([
      import('@tinacms/astro/TinaIsland.astro'),
      import('../../lib/tina-islands'),
    ])
  : undefined;
const TinaIsland = tina?.[0].default;
const tinaWrapper = tina?.[1].islands.offre.wrapper;

// JSON-LD métier · BreadcrumbList + Service (+ Offer si un prix réel existe dans
// le frontmatter). Base émet déjà Organization + WebSite ; ces blocs viennent en plus.
const siteUrl = 'https://waimia.com';
const offreUrl = `${siteUrl}/offres/${entry.id}`;
const offreName = lang === 'fr' ? data.title_fr : data.title_en;
const offreDesc = lang === 'fr' ? data.description_fr : data.description_en;

// Offer conditionnel : uniquement si un prix réel est renseigné (0 prix inventé).
const hasPrice = typeof data.price_from_eur === 'number';
const offerLd = hasPrice
  ? buildOffer({
      name: offreName,
      price: data.price_from_eur,
      priceCurrency: 'EUR',
      url: offreUrl,
    })
  : undefined;

const serviceLd = buildService({
  name: offreName,
  description: offreDesc,
  ...(data.category_fr ? { serviceType: data.category_fr } : {}),
  ...(offerLd ? { offers: offerLd } : {}),
});

const offreLd = serviceLd;
---
<Base
  title={lang === 'fr' ? data.title_fr : data.title_en}
  description={lang === 'fr' ? data.description_fr : data.description_en}
  noindex={data.seo?.noindex}
  jsonLd={offreLd}
>
  <Breadcrumb lang={lang} items={[
    { label: lang === 'fr' ? 'Accueil' : 'Home', href: lang === 'fr' ? '/' : '/en' },
    { label: lang === 'fr' ? 'Offres' : 'Services', href: lang === 'fr' ? '/offres' : '/en/offres' },
    { label: (lang === 'fr' ? data.title_fr : data.title_en).split(' · ')[0] },
  ]} />
  {TinaIsland && tinaWrapper ? (
    <TinaIsland name="offre" wrapper={tinaWrapper} params={{ slug: entry.id }} primary>
      <SectionsRenderer sections={data.sections!} lang={lang} />
    </TinaIsland>
  ) : (
    <SectionsRenderer sections={data.sections!} lang={lang} />
  )}
</Base>
