---
export const prerender = true;

// Landing « Site web IA-first » · V-F3 §4.1 (docs/40).
// Page de vente UNIQUE au-dessus du tunnel, exposée en campagne (ads, social).
// Rendu 100 % COMPOSABLE (anti-orphelin) : aucun markup inline. La séquence narrative
// de 8 slots est une liste `sections[]` validée par le schéma, rendue par SectionsRenderer
// (registry → composants catalogués). Copy = référentiels réels (proof-points / guarantees
// / cas Plateau du tunnel), 0 chiffre inventé. JSON-LD Service + index,follow conservés.
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/ui/molecules/Breadcrumb.astro';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import type { SectionData } from '../../schemas/sections';
import { buildService } from '../../lib/seo/schema-builder';

const service = buildService({
  name: 'Site Web IA-first',
  description:
    'Site web automatisé par IA pour générer des leads en continu via 3 agents (Content, CRM, Social). ROI mesuré en 90 jours.',
});

const TUNNEL_HREF = '/offres/site-web-ia/tunnel/1';
const AUDIT_HREF = '/contact?offer=site-web-ia&action=audit';

const sections: SectionData[] = [
  // ── 1 · HERO MAGNÉTIQUE (promesse + dispo + 2 CTA) ──────────────────────────
  {
    type: 'hero-landing',
    eyebrow_fr: '§ Site web IA-first',
    eyebrow_en: '§ AI-first website',
    h1_fr: 'Votre site génère des leads<br/><em>pendant que vous dormez.</em>',
    h1_en: 'Your website generates leads<br/><em>while you sleep.</em>',
    lede_fr:
      'Trois agents IA orchestrent votre site, votre contenu et votre CRM. Résultat : un flux constant de leads qualifiés, mesuré dès les premières semaines, jamais estimé.',
    lede_en:
      'Three AI agents orchestrate your website, content and CRM. The result: a steady flow of qualified leads, measured from week one, never estimated.',
    cta_primary: { label_fr: 'Réserver un audit →', label_en: 'Book an audit →', href: AUDIT_HREF, variant: 'primary' },
    cta_secondary: { label_fr: 'Voir la démonstration', label_en: 'See the walkthrough', href: TUNNEL_HREF, variant: 'ghost' },
    availability_fr: '◉ Booking T3 2026 · 4 places',
    availability_en: '◉ Booking Q3 2026 · 4 slots',
  },

  // ── 2 · PROBLÈME / DOULEUR (problem-statement, ancre les pains) ─────────────
  {
    type: 'problem-statement',
    background: 'paper-2',
    kicker_fr: '§ 01 · Le problème',
    kicker_en: '§ 01 · The problem',
    statement_fr:
      "Votre site n'est pas lent par hasard. Il accumule : un CMS engorgé, du contenu qui vieillit, des leads jamais relancés. Sans <i>couche de continuité</i> entre site, contenu et CRM, le pipeline dort.",
    statement_en:
      'Your site is not slow by accident. It piles up: a clogged CMS, content going stale, leads never followed up. Without a <i>continuity layer</i> between site, content and CRM, the pipeline sleeps.',
    dropcap: true,
    stats: [
      { value: '4,2 s', label_fr: 'First Contentful Paint sur un WordPress chargé', label_en: 'First Contentful Paint on a loaded WordPress' },
      { value: '6 sem.', label_fr: 'pour publier un seul article sans agent IA', label_en: 'to publish a single article without an AI agent' },
      { value: '7×', label_fr: 'plus de conversion si le lead est relancé dans l\'heure', label_en: 'more conversion if the lead is contacted within the hour' },
    ],
  },

  // ── 3 · DÉMONSTRATION CONCRÈTE (architecture-diagram : 3 agents → site → leads) ─
  {
    type: 'architecture-diagram',
    background: 'ink',
    fig_num: 'FIG · 2.0',
    fig_title_fr: "L'architecture du système",
    fig_title_en: 'System architecture',
    spec_fr: 'AGENTS · SITE · LEADS',
    spec_en: 'AGENTS · SITE · LEADS',
    h2_fr: 'Une seule <i>architecture</i>.<br/>Trois agents, un site, un flux de leads.',
    h2_en: 'One <i>architecture</i>.<br/>Three agents, one site, one lead flow.',
    inputs_fr: ['Agent Content', 'Agent CRM', 'Agent Social', 'Données site', 'Analytics'],
    inputs_en: ['Content agent', 'CRM agent', 'Social agent', 'Site data', 'Analytics'],
    input_examples_fr: ['SEO + GEO + citations IA', 'Scoring + relances < 1 h', 'LinkedIn + X + Instagram', 'HTML statique CDN edge', 'GA4 + Search Console'],
    input_examples_en: ['SEO + GEO + AI citations', 'Scoring + follow-up < 1 h', 'LinkedIn + X + Instagram', 'Static HTML edge CDN', 'GA4 + Search Console'],
    outputs_fr: ['Articles publiés', 'Leads relancés', 'Posts diffusés', 'Pipeline qualifié'],
    outputs_en: ['Articles published', 'Leads followed up', 'Posts distributed', 'Qualified pipeline'],
    system_label: 'Site Astro IA',
    system_kicker: 'AI SITE',
    system_subtitle: 'Lighthouse 100/100',
    show_loop: true,
    loop_label_fr: "BOUCLE D'AMÉLIORATION CONTINUE",
    loop_label_en: 'CONTINUOUS IMPROVEMENT LOOP',
    caption_fr:
      "Trois agents alimentent un site statique 100/100. Au milieu, un système qui publie, relance et diffuse en continu, puis réinjecte la mesure, sans relance manuelle.",
    caption_en:
      'Three agents feed one 100/100 static site. In between, a system that publishes, follows up and distributes continuously, then reinjects the measurement, with no manual chasing.',
  },

  // ── 4a · PREUVE INCARNÉE (metric-shift, cas Plateau réel · référentiel) ─────
  {
    type: 'metric-shift',
    background: 'paper',
    kicker_fr: '§ 02 · Résultats mesurés',
    kicker_en: '§ 02 · Measured results',
    h2_fr: 'Avant → <i>après</i>.',
    h2_en: 'Before → <i>after</i>.',
    lede_fr: 'Cas type, SaaS B2B dâune trentaine de personnes. Mesuré à 10 semaines, jamais estimé.',
    lede_en: 'Typical case, a ~30-person B2B SaaS. Measured at 10 weeks, never estimated.',
    shifts: [
      { label_fr: 'Score Lighthouse', label_en: 'Lighthouse score', before: '23', after: '100', delta_fr: '+77 pts', delta_en: '+77 pts', trend: 'up' },
      { label_fr: 'Leads qualifiés / mois', label_en: 'Qualified leads / month', before: 'baseline', after: '×2,4', delta_fr: '×2,4', delta_en: '×2,4', trend: 'up' },
      { label_fr: 'Gestion CMS', label_en: 'CMS management', before: '12 h/sem', after: '0 h/sem', delta_fr: '−12 h', delta_en: '−12 h', trend: 'down' },
      { label_fr: 'ROI à 12 mois', label_en: '12-month ROI', before: 'baseline', after: '4,1×', delta_fr: '4,1×', delta_en: '4,1×', trend: 'up' },
    ],
  },

  // ── 4b · PREUVE INCARNÉE (quote-spotlight, citation client Plateau) ─────────
  {
    type: 'quote-spotlight',
    background: 'paper-2',
    kicker_fr: 'Témoignage client',
    kicker_en: 'Client testimonial',
    quote_fr:
      "On a remplacé notre WordPress par un site Waimia en 6 semaines. L'agent éditeur a éliminé les 12 h hebdo passées dans le CMS. On est passé de <i>23 à 100</i> sur Lighthouse.",
    quote_en:
      'We replaced our WordPress with a Waimia site in 6 weeks. The editorial agent removed the 12 weekly hours spent in the CMS. We went from <i>23 to 100</i> on Lighthouse.',
    author: 'Direction marketing',
    role_fr: 'Direction marketing . SaaS B2B',
    role_en: 'Marketing lead . B2B SaaS',
