    kicker_fr: '§ 03 · Tarifs transparents',
    kicker_en: '§ 03 · Transparent pricing',
    h2_fr: 'Trois <i>formules</i>, un seul cap',
    h2_en: 'Three <i>plans</i>, one direction',
    lede_fr: 'Du socle IA-first au système complet site + CRM + réseaux. Facturation au forfait, sans engagement caché.',
    lede_en: 'From the AI-first foundation to the full site + CRM + social system. Flat-rate billing, no hidden commitment.',
    tiers: [
      {
        name_fr: 'Découverte', name_en: 'Discovery', price: '7 900 €', period_fr: 'HT · forfait', period_en: 'excl. VAT · flat',
        features_fr: ['Site Astro MVP natif IA (jusqu\'à 8 pages)', 'Agent éditeur de contenu inclus', 'Socle GEO : sitemap + JSON-LD + llms.txt', '1 mois de routine GEO offert', 'Hébergement Vercel optimisé'],
        features_en: ['AI-native Astro MVP site (up to 8 pages)', 'Content editor agent included', 'GEO foundation: sitemap + JSON-LD + llms.txt', '1 free month of GEO routine', 'Optimised Vercel hosting'],
        cta: { label_fr: 'Démarrer Découverte', label_en: 'Start Discovery', href: '/contact?offer=site-web-ia&tier=decouverte', variant: 'ghost' },
        featured: false,
      },
      {
        name_fr: 'Standard', name_en: 'Standard', price: '14 900 €', period_fr: 'HT · forfait', period_en: 'excl. VAT · flat',
        features_fr: ['Tout Découverte inclus', 'Jusqu\'à 25 pages (hubs + sous-pages)', '3 agents : Content + CRM + Social', 'Agent éditeur multilingue (FR + EN)', 'Routine GEO mensuelle 6 mois', 'Cal.com intégré + tests A/B IA'],
        features_en: ['Everything in Discovery', 'Up to 25 pages (hubs + sub-pages)', '3 agents: Content + CRM + Social', 'Multilingual editor agent (FR + EN)', 'Monthly GEO routine for 6 months', 'Cal.com embedded + AI A/B tests'],
        cta: { label_fr: 'Choisir Standard →', label_en: 'Choose Standard →', href: '/contact?offer=site-web-ia&tier=standard', variant: 'primary' },
        featured: true,
      },
      {
        name_fr: 'Sur-mesure', name_en: 'Custom', price: 'dès 35 000 €', period_fr: 'HT · selon périmètre', period_en: 'excl. VAT · scope-based',
        features_fr: ['Tout Standard inclus', 'Pages illimitées + multi-tenant', 'Agents internes VirtuoseOS', 'Intégrations CRM / entrepôt natives', 'Auto-hébergement possible (vLLM / Ollama)', 'SLA 24/7 + astreinte humaine nommée'],
        features_en: ['Everything in Standard', 'Unlimited pages + multi-tenant', 'Internal VirtuoseOS agents', 'Native CRM / warehouse integrations', 'Self-hosting possible (vLLM / Ollama)', '24/7 SLA + named human on-call'],
        cta: { label_fr: 'Nous parler', label_en: 'Talk to us', href: '/contact?offer=site-web-ia&tier=sur-mesure', variant: 'ghost' },
        featured: false,
      },
    ],
    footnote_fr: 'Tarifs HT. Migration des données et hébergement première année inclus. Devis exact après audit gratuit.',
    footnote_en: 'Prices excl. VAT. Data migration and first-year hosting included. Exact quote after the free audit.',
  },

  // ── 6 · GARANTIES (guarantee-block, référentiel guarantees.ts) ──────────────
  {
    type: 'guarantee-block',
    background: 'ink',
    guarantees: [
      { title_fr: 'Audit de cadrage sous 5 jours', title_en: 'Scoping audit within 5 days', body_fr: 'Un audit de cadrage de 45 minutes planifié sous 5 jours ouvrés après une prise de contact qualifiée.', body_en: 'A 45-minute scoping audit scheduled within 5 business days of a qualified first contact.' },
      { title_fr: 'Données hébergées en UE, DPA signé', title_en: 'EU-hosted data, signed DPA', body_fr: 'Les données opérées par Waimia restent dans l\'Union européenne et un DPA est signé au démarrage de la mission.', body_en: 'Data operated by Waimia stays within the European Union and a DPA is signed at engagement kickoff.' },
      { title_fr: 'Livrable revu sous 72 h', title_en: 'Deliverable revised within 72 h', body_fr: 'Tout livrable est revu et corrigé sous 72 h ouvrées après réception d\'un retour client consolidé.', body_en: 'Every deliverable is reviewed and corrected within 72 business hours of consolidated client feedback.' },
      { title_fr: 'Vous possédez le site', title_en: 'You own the site', body_fr: 'Code, contenu, hébergement et documentation transférés clé en main. Pas de captivité agence, pas de plugin propriétaire imposé.', body_en: 'Code, content, hosting and documentation handed over turnkey. No agency lock-in, no mandatory proprietary plugin.' },
    ],
  },

  // ── 7 · OBJECTIONS (faq-accordion condensée, premier ouvert = ancrage) ──────
  {
    type: 'faq-accordion',
    background: 'paper-2',
    kicker_fr: '§ 04 · Objections fréquentes',
    kicker_en: '§ 04 · Frequent objections',
    h2_fr: 'Questions <i>avant</i> de réserver',
    h2_en: 'Questions <i>before</i> booking',
    open_first: true,
    items: [
