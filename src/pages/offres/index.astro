---
// Page · /offres · Pyramide narrative M3
export const prerender = true;

import Base from '../../layouts/Base.astro';
import type { SectionByType } from '@waimia/ds-kernel';
import CtaFinal from '../../components/sections/CtaFinal.astro';
import HeroCentered from '../../components/sections/HeroCentered.astro';
import OfferTierGrid from '../../components/sections/OfferTierGrid.astro';
import RelatedCardsBand from '../../components/sections/RelatedCardsBand.astro';
import TierPyramidSvg from '../../components/sections/TierPyramidSvg.astro';
import MastheadBar from '../../components/sections/MastheadBar.astro';

const offresJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Offres Waimia : Systèmes IA pour PME et ETI',
  description: "Trois tiers d'engagement IA : Découverte, Transformation, Partenariat.",
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Audit Maturité IA', url: 'https://waimia.com/offres/audit-maturite-ia' },
    { '@type': 'ListItem', position: 2, name: 'Site Web IA', url: 'https://waimia.com/services/site-web-intelligent' },
    { '@type': 'ListItem', position: 3, name: 'Growth System IA', url: 'https://waimia.com/offres/growth-system-ia' },
  ],
};

const mastheadData = {
  type: 'hero-hub-masthead' as const,
  variant: 'hub' as const,
  kicker_fr: '§ Offres · Waimia',
  kicker_en: '§ Offers · Waimia',
  h1_fr: 'Trois <i>niveaux</i>.<br/>Une <i>méthode</i>.',
  h1_en: 'Three <i>levels</i>.<br/>One <i>method</i>.',
  lede_fr: 'Découverte, transformation, partenariat. Chaque offre est une marche. Choisissez la bonne.',
  lede_en: 'Discovery, transformation, partnership. Each offer is a step. Choose the right one.',
  decoration: false as const, align: 'left' as const,
} satisfies SectionByType<'hero-hub-masthead'>;

const ctaData = {
  type: 'cta-final' as const,
  h2_fr: 'Prêt à livrer un <em>agent</em>,<br />pas un slide deck ?',
  h2_en: 'Ready to ship an <em>agent</em>,<br />not a slide deck?',
  body_fr: 'Audit IA en 5 jours. Premier agent en production en 4 semaines. ROI mesuré sur votre périmètre, jamais inventé.',
  body_en: 'AI audit in 5 days. First agent in production in 4 weeks. ROI measured on your scope, never invented.',
  cta_primary: { label_fr: 'Réserver un audit →', label_en: 'Book an audit →', href: '/contact', variant: 'primary' as const },
  cta_secondary: { label_fr: 'Voir la pyramide →', label_en: 'See the pyramid →', href: '/offres', variant: 'ghost' as const },
  background: 'ink' as const,
} satisfies SectionByType<'cta-final'>;

const relatedCasesData = {
  type: 'related-cards-band' as const,
  background: 'paper-2' as const,
  kicker_fr: "§ Domaines d'intervention",
  kicker_en: '§ Where we intervene',
  cards: [
    {
      kicker_fr: 'DOMAINE · ACQUISITION',
      kicker_en: 'DOMAIN · ACQUISITION',
      title_fr: 'Acquisition B2B · pipeline à reconnecter',
      title_en: 'B2B acquisition · pipeline to reconnect',
      lead_fr: 'Growth System IA : séquences de réactivation, landing pages, suivi câblé en quelques semaines.',
      lead_en: 'Growth System AI: reactivation sequences, landing pages, tracking wired in a few weeks.',
      href: '/cas-clients',
    },
    {
      kicker_fr: 'DOMAINE · PRODUCTIVITÉ',
      kicker_en: 'DOMAIN · PRODUCTIVITY',
      title_fr: 'Conseil · heures consultant à libérer',
      title_en: 'Consulting · consultant hours to free',
      lead_fr: 'Workflows internes automatisés, équipe formée, gain mesuré avant/après sur votre périmètre.',
      lead_en: 'Automated internal workflows, team trained, gain measured before/after on your scope.',
      href: '/cas-clients',
    },
    {
      kicker_fr: 'DOMAINE · PILOTAGE',
      kicker_en: 'DOMAIN · REPORTING',
      title_fr: 'Gestion & finance · clôture à alléger',
      title_en: 'Finance & management · close to streamline',
      lead_fr: 'Clôture mensuelle raccourcie, données réconciliées, tableaux fiables avant la réunion.',
      lead_en: 'Monthly close shortened, data reconciled, reliable dashboards before the meeting.',
      href: '/cas-clients',
    },
  ],
} satisfies SectionByType<'related-cards-band'>;

const pyramidData = {
  type: 'tier-pyramid-svg' as const,
  aria_label_fr: 'Pyramide des offres Waimia : trois tiers',
  aria_label_en: 'Waimia offer pyramid: three tiers',
  tiers: [
    { roman: 'I', label_fr: 'Découverte', label_en: 'Discovery' },
    { roman: 'II', label_fr: 'Transformation', label_en: 'Transformation' },
    { roman: 'III', label_fr: 'Partenariat', label_en: 'Partnership' },
  ],
} satisfies SectionByType<'tier-pyramid-svg'>;

const tierDiscoveryData = {
  type: 'offer-tier-grid' as const,
  variant: 'standard' as const,
  wrap: true,
  eyebrow_fr: 'I · DÉCOUVERTE',
  eyebrow_en: 'I · DISCOVERY',
  h2_fr: 'Comprendre avant de décider.',
  h2_en: 'Understand before deciding.',
  lede_fr: "Avant d'investir dans un système, posez le diagnostic.",
  lede_en: 'Before investing in a system, run the diagnosis.',
  offers: [
    {
      price_fr: 'À PARTIR DE 5 K€',
      price_en: 'FROM €5K',
      title_fr: 'Audit Maturité IA',
      title_en: 'AI Maturity Audit',
      lead_fr: 'Cartographie de vos process, identification des leviers IA prioritaires, feuille de route chiffrée.',
      lead_en: 'Process mapping, identification of priority AI levers, costed roadmap.',
      cta_fr: "Voir l'offre →",
      cta_en: 'See offer →',
      href: '/offres/audit-maturite-ia',
    },
  ],
} satisfies SectionByType<'offer-tier-grid'>;

const tierTransformationData = {
  type: 'offer-tier-grid' as const,
  variant: 'featured' as const,
  background: 'ink' as const,
  wrap: false,
  eyebrow_fr: 'II · TRANSFORMATION',
  eyebrow_en: 'II · TRANSFORMATION',
  h2_fr: 'Construire les systèmes qui durent.',
  h2_en: 'Build systems that last.',
  lede_fr: 'Site, CRM, analytics, productivité, connectés et mesurés.',
  lede_en: 'Website, CRM, analytics, productivity, connected and measured.',
  featured_card: {
    eyebrow_fr: 'OFFRE PHARE · 5 À 20 K€',
    eyebrow_en: 'FLAGSHIP OFFER · €5K TO €20K',
    title_fr: 'Growth System IA',
    title_en: 'Growth System AI',
    sub_fr: 'Pas un site. Pas un CRM. Un système.',
    sub_en: 'Not a website. Not a CRM. A system.',
    lead_fr: 'Site, CRM, relances, pilotage, connectés et mesurés. Le mardi on câble. Le vendredi on mesure.',
    lead_en: 'Website, CRM, follow-ups, reporting, connected and measured. Tuesday we wire. Friday we measure.',
    cta_fr: 'Activer →',
    cta_en: 'Activate →',
    href: '/offres/growth-system-ia',
  },
  offers: [
    {
      price_fr: 'SITE WEB',
      price_en: 'WEBSITE',
      title_fr: 'Site Web IA',
      title_en: 'AI Website',
      lead_fr: 'Un site conçu pour convertir, mesuré, relié à votre CRM. Pas une vitrine statique.',
      lead_en: 'A site built to convert, measured, connected to your CRM. Not a static brochure.',
      cta_fr: "Voir l'offre →",
      cta_en: 'See offer →',
      href: '/services/site-web-intelligent',
    },
  ],
} satisfies SectionByType<'offer-tier-grid'>;

---
<Base
  title="Offres · Pyramide narrative · Waimia"
  description="Trois tiers d'engagement IA : Découverte, Transformation, Partenariat. Audit, Activation, Growth System, Claude Cowork et plus."
  jsonLd={offresJsonLd}
>

  <div class="wrap-wide" style="padding-top: 24px;">
    <MastheadBar items={[{label:'Accueil', href:'/'}, {label:'Offres'}]} />
  </div>

  <!-- 1. HERO éditorial -->
  <HeroCentered data={mastheadData} lang="fr" />

  <!-- 2. SVG PYRAMIDE SIGNATURE -->
  <TierPyramidSvg data={pyramidData} lang="fr" />

  <!-- 3. TIER I · DÉCOUVERTE -->
  <div class="tier-i-after-pyramid">
    <OfferTierGrid data={tierDiscoveryData} lang="fr" />
  </div>

  <!-- 4. TIER II · TRANSFORMATION -->
  <div class="tier-rhythm-base">
    <OfferTierGrid data={tierTransformationData} lang="fr" />
  </div>

  <!-- 5b. PREUVES · ÉTUDES DE CAS -->
  <div class="related-rhythm-base">
    <RelatedCardsBand data={relatedCasesData} lang="fr" />
  </div>

  <!-- 6. MANIFESTO COURT -->
  <section class="manifesto">
    <blockquote class="mf-quote reveal-fade">
      <i>Chaque engagement commence par la bonne marche.</i>
    </blockquote>
    <p class="mf-body">
      Ce n'est pas une question de budget. C'est une question de maturité.
      Audit, Activation, Systèmes, Partenariat : la progression est conçue.
    </p>
  </section>

  <!-- 7. CTA BAND -->
  <CtaFinal data={ctaData} lang="fr" />
</Base>

<style>
  /* ── Resserrer le palier I après la pyramide (suppression bande morte) ──
     Le cran d'ouverture --section-loose (160px) après une section graphique
     déjà aérée crée un vide ; on retombe sur --section-base (famille rythme). */
  .tier-i-after-pyramid :global(.tier-section) {
    padding-top: var(--section-base);
    padding-bottom: var(--section-base);
  }

  /* ── Resserrer le rythme des paliers suivants (suppression bandes mortes) ──
     Chaque .tier-section embarque --section-loose (160px) en haut ET en bas :
     entre deux paliers consécutifs cela empile ~320px de vide non intentionnel
     (mesuré : gaps de 358px). On retombe sur --section-base (96px) — même
     famille de rythme, 0 nouveau token — pour que chaque acte reste dense. */
  .tier-rhythm-base :global(.tier-section) {
    padding-top: var(--section-base);
    padding-bottom: var(--section-base);
  }
  /* La bande Preuves consomme un knob dédié du composant (fallback loose). */
  .related-rhythm-base {
    --related-cards-band-pad: var(--section-base);
  }

  /* ── MANIFESTO ─────────────────────────────────────────────── */
  .manifesto {
    padding: var(--section-base) var(--space-10);
    background: var(--paper-2);
    text-align: center;
  }
  .mf-quote {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-style: italic;
    font-weight: var(--fw-regular);
    margin: 0 auto var(--space-7);
    max-width: 860px;
    line-height: var(--leading-h3);
  }
  .mf-body {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-prose);
    color: var(--muted);
    max-width: 600px;
    margin: 0 auto;
  }

  /* ── RESPONSIVE ────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .manifesto {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>
