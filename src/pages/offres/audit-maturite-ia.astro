---
// Page · /offres/audit-maturite-ia · Sous-page mega-menu (offres/detail template)
export const prerender = true;

// Source : adaptation hub-consulting service 02.1 + offres/detail.html structure
//
// Composé de · DetailMenuTemplate (8 sections) avec slot deliverables custom.

import DetailMenuTemplate from '../../components/templates/DetailMenuTemplate.astro';
import AuditMaturityTimeline from '../../components/svg/geometric/AuditMaturityTimeline.astro';
import { buildService } from '../../lib/seo/schema-builder';

const title = 'Diagnostic IA PME · gratuit · Waimia';
const description = "Un diagnostic IA gratuit pour PME. On évalue vos données, vos outils, votre équipe et on repère 3 automatisations rentables. Une grille de score lisible par la direction.";
const serviceLd = buildService({ name: title, description, serviceType: 'Diagnostic de maturité IA pour PME' });

const annotation = [
  { k: 'Gratuit', label_fr: 'diagnostic d’entrée',      label_en: 'entry diagnostic' },
  { k: '47',      label_fr: 'critères évalués',          label_en: 'criteria evaluated' },
  { k: '1',       label_fr: 'grille de score livrée',    label_en: 'scorecard delivered' },
];

const steps = [
  { sn: '01', kicker_fr: 'J1-J2', kicker_en: 'D1-D2',
    title_fr: 'Cadrage initial', title_en: 'Initial scoping',
    body_fr: "Demi-journée comité élargi. On lit votre stack, votre feuille de route, vos incidents récents non résolus. On établit la liste des 8-12 interlocuteurs à auditer. Livrable J2 : rapport de cadrage validé.",
    body_en: 'Half-day with extended committee. We read your stack, roadmap, recent unresolved incidents. We set the list of 8-12 interviewees. Deliverable D2: validated scoping report.' },
  { sn: '02', kicker_fr: 'J3-J6', kicker_en: 'D3-D6',
    title_fr: 'Audit terrain', title_en: 'Field audit',
    body_fr: "Entretiens 1-1 avec 8-12 personnes : data engineer, DPO, responsable GRC, CFO, lead tech, ops métier. Questionnaire asynchrone 47 points sur Notion. Aucun atelier collectif : la vérité se dit en individuel.",
    body_en: '1-on-1 interviews with 8-12 people: data engineer, DPO, GRC lead, CFO, tech lead, ops. 47-point async survey on Notion. No group workshop: truth is told individually.' },
  { sn: '03', kicker_fr: 'J7-J8', kicker_en: 'D7-D8',
    title_fr: 'Analyse', title_en: 'Analysis',
    body_fr: "Grille de 47 critères notée 0-3 par dimension (données, outillage, équipe, gouvernance). Cartographie des chantiers actionnables. Estimation effort : Quick wins (< 3 mois) vs Chantiers structurants (6-18 mois).",
    body_en: '47-criteria scorecard scored 0-3 per dimension (data, tooling, team, governance). Actionable workstream map. Effort estimation: Quick wins (< 3 months) vs Structural workstreams (6-18 months).' },
  { sn: '04', kicker_fr: 'J9-J10', kicker_en: 'D9-D10',
    title_fr: 'Restitution', title_en: 'Debrief',
    body_fr: "2 sessions structurées. Direction (1h) : grille résumée, 3 décisions à prendre, arbitrages chiffrés. Équipe technique (2h) : détails chantiers, risques, questions. Document final 30 pages signé remis en fin de J10.",
    body_en: '2 structured sessions. Board (1h): summarized scorecard, 3 decisions to make, costed arbitrations. Tech team (2h): workstream details, risks, Q&A. Final 30-page document signed and delivered end of D10.' },
];

const techPills = [
  { label: 'Claude Opus (analyse)', kind: 'primary' as const },
  { label: 'Notion / Confluence',   kind: 'neutral' as const },
  { label: 'Whimsical',              kind: 'neutral' as const },
];

const proofMetrics = [
  { k: '47',   label_fr: 'critères notés sur vos données',    label_en: 'criteria scored on your data' },
  { k: '4',    label_fr: 'dimensions évaluées',               label_en: 'dimensions evaluated' },
  { k: '3',    label_fr: 'automatisations rentables repérées', label_en: 'high-ROI automations spotted' },
  { k: '0 €',  label_fr: 'le diagnostic d’entrée',            label_en: 'for the entry diagnostic' },
];

const relatedCards = [
  { kicker: 'OFFRE 02.2', title_fr: 'Feuille de route IA stratégique', title_en: 'Strategic AI Roadmap',
    lead_fr: 'La suite naturelle après audit →', lead_en: 'The natural follow-up to an audit →',
    href: '/offres' },
  { kicker: 'OFFRE 02.3', title_fr: 'Audit gouvernance données', title_en: 'Data governance audit',
    lead_fr: 'Service complémentaire fréquent →', lead_en: 'Frequent companion service →',
    href: '/offres' },
  { kicker: 'CAS', title_fr: 'Études de cas', title_en: 'Case studies',
    lead_fr: 'Audit suivi de RevOps Rebuild →', lead_en: 'Audit followed by RevOps Rebuild →',
    href: '/cas-clients' },
];
---
<DetailMenuTemplate
  title={title}
  description={description}
  jsonLd={serviceLd}
  detailNum="02.1"
  parentKickerFr="Hub Conseil · Audit & Stratégie"
  parentKickerEn="Consulting Hub · Audit & Strategy"
  h1Fr="Un diagnostic IA <i>gratuit</i> pour savoir où vous en êtes. Lu par la direction."
  h1En="A <i>free</i> AI diagnostic to know where you stand. Read by leadership."
  ledeFr="Pas un atelier. Pas un modèle PowerPoint. On évalue 47 critères sur vos données, vos outils, votre équipe, votre gouvernance, et on repère les 3 automatisations les plus rentables, avant d'engager le moindre euro."
  ledeEn="Not a workshop. Not a PowerPoint template. We evaluate 47 criteria across your data, your tools, your team, your governance, and we spot the 3 highest-ROI automations, before you commit a single euro."
  annotation={annotation}
  steps={steps}
  proofQuoteFr="On lit vos vrais workflows au lieu de dérouler un modèle. À la fin, vous savez quels chantiers lancer, lesquels couper, et dans quel ordre."
  proofQuoteEn="We read your real workflows instead of running a template. At the end, you know which workstreams to launch, which to cut, and in what order."
  proofAttrFr="Méthode Waimia · diagnostic d’entrée"
  proofAttrEn="Waimia method · entry diagnostic"
  proofMetrics={proofMetrics}
  techPills={techPills}
  relatedCards={relatedCards}
>
  <Fragment slot="problem">
    La majorité des audits IA livrent <i>72 slides</i> qui finissent dans le SharePoint. La direction ne les lit pas. Les ingénieurs ne savent pas quoi en faire. Notre audit produit l'inverse : 30 pages denses, une grille signée, des actions priorisées par coût de correction.
    <br/><br/>Nous ne partons pas d'un modèle. Nous partons de vos données réelles : logs, workflows documentés, incidents GRC ouverts. La grille de 47 critères est renseignée par nos consultants, pas par vos déclaratifs.
  </Fragment>
  <Fragment slot="approach-headline">
    Dix <i>jours</i> calibrés. Pas un de plus, pas un de moins.
  </Fragment>
  <Fragment slot="approach-aside">
    Le périmètre est volontairement borné. On audite ce qui est lisible en 10 jours : au-delà, c'est l'objet d'un autre service (feuille de route IA stratégique).
    Chaque journée a un livrable intermédiaire : rapport de cadrage validé (J2), audit terrain clos (J6), grille pré-scorée (J8), document final signé (J10).
  </Fragment>
  <Fragment slot="deliverables-headline">
    Une <i>grille de score</i>, un <i>document</i>, deux <i>restitutions</i>.
  </Fragment>
  <Fragment slot="deliverables-aside">
    Tout est signé par notre équipe et par votre référent technique. Aucun livrable « anonyme ».
  </Fragment>
  <Fragment slot="deliverables">
    <div class="del-grid">
      <div class="del-card">
        <div class="del-tag">GRILLE</div>
        <h3>47 critères notés 0-3</h3>
        <p>Notation pondérée par chantier · justifications dans le document · benchmark anonymisé secteur.</p>
      </div>
      <div class="del-card">
        <div class="del-tag">DOCUMENT</div>
        <h3>30 pages denses, signées</h3>
        <p>Constats, hypothèses, recommandations priorisées par coût de correction · pas de remplissage.</p>
      </div>
      <div class="del-card">
        <div class="del-tag">RESTITUTION</div>
        <h3>2 sessions en direct</h3>
        <p>Direction (1h Q&amp;A lisible) + équipe technique (2h Q&amp;A approfondie).</p>
      </div>
    </div>

    <!-- Timeline SVG -->
    <div class="reveal-fade" style="margin-top:var(--space-9); max-width:600px; margin-inline:auto;">
      <AuditMaturityTimeline />
    </div>

    <!-- Section prix -->
    <div class="reveal-stagger" style="margin-top:var(--space-9); border-top:1px solid var(--hairline-strong); padding-top:var(--space-8);">
      <div style="font-family:var(--font-mono); font-size:var(--text-small); letter-spacing:.14em; text-transform:uppercase; color:var(--muted); margin-bottom:var(--space-4);">Investissement</div>
      <h3 style="font-family:var(--font-display); font-size:var(--text-h2); line-height:1.05; font-weight:var(--fw-regular); margin:0 0 20px;"><i style="color:var(--accent-text); font-style:italic;">Gratuit</i>, sans engagement</h3>
      <p style="font-family:var(--font-sans); font-size:16px; line-height:1.6; color:var(--ink); max-width:560px; margin:0 0 var(--space-3);">Le diagnostic d'entrée est offert : un document, une grille de score, des actions priorisées. Vous repartez avec un plan, même si on ne travaille pas ensemble ensuite.</p>
      <p style="font-family:var(--font-sans); font-size:var(--text-small); line-height:1.55; color:var(--muted); max-width:560px; margin:0;">Ensuite, la mise en production démarre à 2 000 € HT (grille 2 000 / 4 000 / 7 000 / 10 000 € + sur-mesure), chiffrée au diagnostic selon votre périmètre.</p>
    </div>

    <!-- Section : à quoi sert le diagnostic (exemple illustratif, pas un cas client) -->
    <div class="reveal-stagger" style="margin-top:var(--space-9); border-top:1px solid var(--hairline); padding-top:var(--space-8);">
      <div style="font-family:var(--font-mono); font-size:var(--text-small); letter-spacing:.14em; text-transform:uppercase; color:var(--muted); margin-bottom:var(--space-4);">À quoi ça sert · exemple type</div>
      <div class="audit-case-grid">
        <div>
          <h3 style="font-family:var(--font-display); font-size:var(--text-h2); line-height:var(--leading-h3); font-weight:var(--fw-regular); margin:0 0 18px;"><i style="font-style:italic;">Une PME</i> qui veut bien démarrer</h3>
          <p style="font-family:var(--font-sans); font-size:var(--text-body); line-height:var(--leading-prose); color:var(--ink); margin:0 0 14px;">Vous voulez déployer l'IA sur l'acquisition, les relances ou le reporting, mais vous ne savez pas par où commencer ni ce qui est réellement rentable. Le diagnostic lit vos workflows, vos données et votre stack pour trancher.</p>
          <p style="font-family:var(--font-sans); font-size:var(--text-body); line-height:var(--leading-prose); color:var(--muted); margin:0;">À la fin : les chantiers à lancer, ceux à éviter (par exemple une donnée non conforme RGPD), et l'ordre de priorité, chiffré sur la grille 2 000 à 10 000 €. Vous évitez d'engager du budget sur un mauvais pari.</p>
        </div>
        <div class="audit-case-metrics">
          <div class="audit-case-kpi">
            <div style="font-family:var(--font-mono); font-size:9px; letter-spacing:.12em; text-transform:uppercase; color:var(--accent-text); margin-bottom:var(--space-1);">Ce que vous repartez avec</div>
            <div style="font-family:var(--font-display); font-size:var(--text-h3); line-height:var(--leading-h3); font-weight:var(--fw-regular);">Une grille de score signée</div>
          </div>
          <div class="audit-case-kpi">
            <div style="font-family:var(--font-mono); font-size:9px; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); margin-bottom:var(--space-1);">Décision facilitée</div>
            <div style="font-family:var(--font-display); font-size:var(--text-h3); line-height:var(--leading-h3); font-weight:var(--fw-regular);">3 automatisations rentables priorisées</div>
          </div>
          <div class="audit-case-kpi">
            <div style="font-family:var(--font-mono); font-size:9px; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); margin-bottom:var(--space-1);">Coût d'entrée</div>
            <div style="font-family:var(--font-display); font-size:var(--text-h3); line-height:var(--leading-h3); font-weight:var(--fw-regular);">Gratuit, sans engagement</div>
          </div>
        </div>
      </div>
    </div>
  </Fragment>
  <Fragment slot="stack-lead">
    Stack volontairement <i>légère</i>. Claude Opus pour l'analyse · Notion pour la collaboration · Whimsical pour les schémas. Aucun outil de cadrage propriétaire.
  </Fragment>
</DetailMenuTemplate>

<style is:global>
  /* Pattern deliverables 3 cards · spécifique à DetailMenuTemplate (1 instance ici).
     Pas extrait en molécule car contenu trop variable d'un detail à l'autre. */
  .del-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--hairline-strong);
  }
  .del-card {
    padding: var(--space-7) var(--space-6);
    border-right: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: background var(--dur-trim) var(--ease);
  }
  .del-card:last-child { border-right: none; }
  .del-card:hover { background: var(--paper-2); }
  .del-tag {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .del-card h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    letter-spacing: -0.013em;
    font-weight: var(--fw-regular);
    text-wrap: balance;
    margin: 0;
  }
  .del-card p {
    font-size: var(--text-small);
    color: var(--muted);
    line-height: 1.55;
    text-wrap: pretty;
    margin: 0;
  }
  @media (max-width: 800px) {
    .del-grid { grid-template-columns: 1fr; }
    .del-card { border-right: none; border-bottom: 1px solid var(--hairline); }
    .del-card:last-child { border-bottom: none; }
  }

  /* Cas typique grid */
  .audit-case-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-9);
    align-items: start;
  }
  .audit-case-metrics {
    border-left: 1px solid var(--hairline);
    padding-left: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .audit-case-kpi {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--hairline);
  }
  .audit-case-kpi:last-child { border-bottom: none; }
  @media (max-width: 800px) {
    .audit-case-grid { grid-template-columns: 1fr; }
    .audit-case-metrics { border-left: none; padding-left: 0; margin-top: var(--space-7); }
  }
</style>
