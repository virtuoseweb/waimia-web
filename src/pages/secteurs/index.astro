---
// Page · /secteurs · index des hubs sectoriels Waimia (100 % composable · registry).
// Liste les secteurs visibles (card + douleur 1 phrase) + « Vous ne voyez pas votre secteur ? »
// La grille de secteurs est desormais la section cataloguee `sector-card-grid` (LOT 1b,
// decision 0012) : plus d'orphelin inline. Toutes les sections passent par <SectionsRenderer>.
export const prerender = true;

import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { langFromPath, localizeHref } from '../../lib/i18n';
import type { SectionByType } from '@waimia/ds-kernel';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import { buildCollectionPage, buildBreadcrumbList } from '../../lib/seo/schema-builder';

const lang = langFromPath(Astro.url.pathname);
const isFr = lang === 'fr';

// Label de card court dérivé du title_fr/title_en long (qui reste la source SEO du
// <title>/H1 de la page secteur). On retire le préfixe « Site web et IA pour » et la
// clause descriptive après « : » → libellé de carte lisible, sans nouveau champ schéma.
const shortSectorLabel = (full: string): string => {
  let s = full.split(/\s*:\s*/)[0].trim();
  s = s.replace(/^Site web et IA pour\s+(?:les?\s+|la\s+|l['’]|des\s+)?/i, '');
  s = s.replace(/^Website and AI for\s+/i, '');
  return s.charAt(0).toUpperCase() + s.slice(1);
};

const visibleSectors = (await getCollection('secteurs'))
  .filter((e) => e.data.visible)
  .sort((a, b) => (a.data.slug ?? a.id).localeCompare(b.data.slug ?? b.id));

// Cartes bilingues pour la section cataloguée `sector-card-grid` (contentMode instance).
// La langue est résolue à l'affichage par le composant (kicker/title/pain _fr|_en).
const sectorCards = visibleSectors.map((e) => {
  const d = e.data;
  const painFr = d.pains_fr[0];
  const painEn = d.pains_en[0];
  return {
    kicker_fr: d.icp_fr,
    kicker_en: d.icp_en,
    title_fr: shortSectorLabel(d.title_fr),
    title_en: shortSectorLabel(d.title_en),
    pain_fr: painFr ? painFr.title : '',
    pain_en: painEn ? painEn.title : '',
    href: localizeHref(`/secteurs/${d.slug ?? e.id}`, lang),
  };
});

// JSON-LD · CollectionPage + ItemList des secteurs visibles (même pattern que le hub
// cas-clients : buildCollectionPage → jsonLd={} sur <Base>). URLs canoniques FR.
const sectorItems = visibleSectors.map((e) => `https://waimia.com/secteurs/${e.data.slug ?? e.id}`);
const secteursLd = [
  buildBreadcrumbList([
    { name: 'Accueil', url: 'https://waimia.com/' },
    { name: 'Secteurs', url: 'https://waimia.com/secteurs' },
  ]),
  buildCollectionPage(
    isFr ? 'Secteurs' : 'Industries',
    isFr
      ? 'Des systèmes IA rangés par métier, avec données de marché sourcées et terrain réel.'
      : 'AI systems organized by trade, with sourced market data and real field.',
    sectorItems,
  ),
];

const sectorGridData = {
  type: 'sector-card-grid' as const,
  cta_label_fr: 'Voir le secteur →',
  cta_label_en: 'See the industry →',
  sectors: sectorCards,
} satisfies SectionByType<'sector-card-grid'>;

const ctaData = {
  type: 'cta-final' as const,
  chapter_num: '§',
  chapter_title_fr: 'Pas votre métier ?',
  chapter_title_en: 'Not your trade?',
  h2_fr: 'Vous ne voyez pas votre secteur ? On opère sur tous les métiers.',
  h2_en: "Don't see your industry? We operate across all trades.",
  cta_primary: {
    label_fr: 'Parler de votre projet →',
    label_en: 'Discuss your project →',
    href: localizeHref('/contact', lang),
    variant: 'primary' as const,
  },
  background: 'ink' as const,
} satisfies SectionByType<'cta-final'>;

// Bande éditoriale ink (case-spotlight) : respiration visuelle entre la grille de
// secteurs et le CTA, comme le pilote cas-clients. Image éditoriale réelle du repo
// (public/images/editorial/menonhand.webp, vérifiée existante). Aucune métrique
// inventée (pas de chiffre secteur réel) : message de positionnement factuel.
const spotlightData = {
  type: 'case-spotlight' as const,
  background: 'ink' as const,
  variant: 'media-right' as const,
  kicker_fr: '§ La méthode, pas le secteur',
  kicker_en: '§ The method, not the sector',
  title_fr: 'On part de votre terrain, jamais d’un template',
  title_en: 'We start from your field, never from a template',
  media_src: '/images/editorial/menonhand.webp',
  media_alt: isFr
    ? 'Illustration éditoriale : des équipes métier qui se relaient autour d’un même outil.'
    : 'Editorial illustration: operational teams working hand in hand around one tool.',
  quote_fr: 'Chaque métier a ses goulots et ses leviers. On les lit sur vos données réelles avant d’écrire la moindre ligne.',
  quote_en: 'Every trade has its bottlenecks and its levers. We read them on your real data before writing a single line.',
  attribution_fr: 'Méthode Waimia · diagnostic terrain avant exécution',
  attribution_en: 'Waimia method · field diagnosis before execution',
  cta_href: localizeHref('/cas-clients', lang),
  cta_label_fr: 'Voir les cas clients →',
  cta_label_en: 'See our case studies →',
} satisfies SectionByType<'case-spotlight'>;

// Angle B2B reporté depuis /secteurs/services-b2b dépublié (audit #60 A4) : l'acheteur
// s'auto-évalue avant de parler. Vrai dans tous les métiers de services → il vit dans le
// hub (ombrelle B2B), pas dans une 12ᵉ page sans requête propre. Bloc catalogué
// `editorial-callout` (anti-orphelin), paper, entre la grille et la bande éditoriale.
const b2bAngleData = {
  type: 'editorial-callout' as const,
  background: 'paper' as const,
  variant: 'manifesto' as const,
  size: 'lg' as const,
  align: 'left' as const,
  body_fr: "En B2B, l'acheteur décide souvent <i>avant même de vous parler</i> : l'essentiel du parcours se fait en autonomie. Si votre site ne prouve rien pendant cette phase, vous n'êtes pas sur la liste finale. C'est vrai dans tous les métiers de services : le hub ci-dessus range la preuve par secteur.",
  body_en: 'In B2B, the buyer often decides <i>before ever talking to you</i>: most of the journey happens autonomously. If your site proves nothing during that phase, you are not on the shortlist. It holds across every service trade: the hub above organizes the proof by sector.',
} satisfies SectionByType<'editorial-callout'>;

const mastheadData = {
  type: 'hero-hub-masthead' as const,
  variant: 'hub' as const,
  decoration: false,
  align: 'left' as const,
  kicker_fr: '§ Secteurs · la preuve par votre métier',
  kicker_en: '§ Industries · proof from your trade',
  h1_fr: '<span>Votre <i>secteur</i>,</span><br/><span>votre terrain.</span>',
  h1_en: '<span>Your <i>industry</i>,</span><br/><span>your field.</span>',
  lede_fr: "Chaque métier a ses goulots et ses leviers. On part de votre terrain réel, données de marché à l'appui, jamais d'un template générique.",
  lede_en: 'Every trade has its bottlenecks and its levers. We start from your real field, backed by market data, never from a generic template.',
} satisfies SectionByType<'hero-hub-masthead'>;

// Séquence composable · masthead → grille secteurs → angle B2B → bande éditoriale → CTA.
const sections = [mastheadData, sectorGridData, b2bAngleData, spotlightData, ctaData];
---
<Base
  title={isFr ? 'Secteurs · IA opérationnelle par métier · Waimia' : 'Industries · operational AI by trade · Waimia'}
  description={isFr
    ? 'Des systèmes IA rangés par métier : e-commerce, bâtiment, startup, services B2B, libéral, thérapeutes. Données de marché sourcées, terrain réel.'
    : 'AI systems organized by trade: e-commerce, construction, startup, B2B services, independents, therapists. Sourced market data, real field.'}
  jsonLd={secteursLd}
>
  <SectionsRenderer sections={sections} lang={lang} />
</Base>
