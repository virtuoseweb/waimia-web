---
// Page · /secteurs · Hub des secteurs satellites
export const prerender = true;

//
// Ces pages sont des landings SEO/GEO satellites. Elles adaptent la
// communication aux verticales sans fragmenter la delivery.
// Niveau 1 (cœur) = 5 cas d'usage business horizontaux dans /solutions.
// Niveau 2 (satellite) = ce hub + pages /secteurs/<slug>.

import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Kicker from '../../components/ui/atoms/Kicker.astro';
import type { SectionByType } from '../../schemas/sections';
import CtaFinal from '../../components/sections/CtaFinal.astro';
import ComingSoonPills from '../../components/sections/ComingSoonPills.astro';

// Résultat phare par secteur = metricsHero de la fiche secteur (sourcé, honnête).
// Dédup inter-cartes : on prend la 1ʳᵉ métrique dont la valeur n'est pas déjà
// affichée sur une autre carte (évite deux « 1 200h » côte à côte).
const sectorEntries = (await getCollection('secteurs')).filter((e) => e.data.visible);
const usedResultValues = new Set<string>();
const flagshipResult = (slug: string) => {
  const metrics = sectorEntries.find((e) => e.id === slug)?.data.metricsHero ?? [];
  const m = metrics.find((x) => !usedResultValues.has(x.value)) ?? metrics[0];
  if (!m) return null;
  usedResultValues.add(m.value);
  return { value: m.value, label: m.label_fr };
};

// Cartes secteur pilotées par la collection : ne rend que les fiches réellement
// publiées (visible). Tant qu'aucune fiche secteur sourcée n'existe, la grille
// disparaît proprement — pas de lien vers une page vide (honnêteté).
const SECTOR_CARD_META: Record<string, { kicker: string; label_fr: string; label_en: string; sub_fr: string; pains_fr: string }> = {
  'services-b2b': { kicker: 'SECTEUR · 01', label_fr: 'Services B2B', label_en: 'B2B Services', sub_fr: 'Cabinets, conseil, agences, prestataires', pains_fr: 'Pipeline qui tient sur 2 commerciaux. Contenu invisible. Reporting bricolé.' },
  'industrie': { kicker: 'SECTEUR · 02', label_fr: 'Industrie & PME industrielles', label_en: 'Industrial SMEs', sub_fr: 'ERP connecté, maintenance, qualité', pains_fr: 'Données dispersées dans 3 ERPs. Maintenance réactive. Qualité tardive.' },
  'finance-compta': { kicker: 'SECTEUR · 03', label_fr: 'Finance & cabinets comptables', label_en: 'Finance & Accounting', sub_fr: 'Réconciliation, reporting, conformité', pains_fr: 'Excel partout. Clôture en 9 jours. Audit qui dure 3 semaines.' },
};

const sectorsLive = sectorEntries
  .map((e, i) => {
    const meta = SECTOR_CARD_META[e.id];
    if (!meta) return null;
    return {
      num: String(i + 1).padStart(2, '0'),
      kicker: meta.kicker,
      label_fr: meta.label_fr,
      label_en: meta.label_en,
      sub_fr: meta.sub_fr,
      pains_fr: meta.pains_fr,
      href: `/secteurs/${e.id}`,
      result: flagshipResult(e.id),
    };
  })
  .filter((s): s is NonNullable<typeof s> => s !== null);

const comingData = {
  type: 'coming-soon-pills' as const,
  kicker_fr: '§ À venir',
  kicker_en: '§ Coming soon',
  h2_fr: 'Quand on aura câblé assez de cas pour parler juste.',
  h2_en: 'When we\'ve wired enough cases to speak plainly.',
  aria_label_fr: 'Secteurs à venir',
  aria_label_en: 'Upcoming sectors',
  pills_fr: [
    'Santé-tech',
    'Retail & e-commerce',
    'Immobilier',
    'BTP',
    'Cabinets juridiques',
  ],
  pills_en: [
    'Health-tech',
    'Retail & e-commerce',
    'Real estate',
    'Construction',
    'Law firms',
  ],
} satisfies SectionByType<'coming-soon-pills'>;

const ctaData = {
  type: 'cta-final' as const,
  h2_fr: 'Prêt à livrer un <em>agent</em>,<br />pas un slide deck ?',
  h2_en: 'Ready to ship an <em>agent</em>,<br />not a slide deck?',
  body_fr: 'Audit IA en 5 jours. Premier agent en production en 4 semaines. ROI mesuré, jamais estimé.',
  body_en: 'AI audit in 5 days. First agent in production in 4 weeks. Measured ROI, never estimated.',
  cta_primary: { label_fr: 'Réserver un audit →', label_en: 'Book an audit →', href: '/contact', variant: 'primary' as const },
  cta_secondary: { label_fr: 'Voir la pyramide →', label_en: 'See the pyramid →', href: '/offres', variant: 'ghost' as const },
  background: 'paper' as const,
} satisfies SectionByType<'cta-final'>;
---
<Base
  title="Secteurs · adaptés à votre métier · Waimia"
  description="Mêmes systèmes IA. Vocabulaire, KPIs et workflows adaptés à votre secteur. Les fiches secteur arrivent, à mesure qu'on accumule des cas pour parler juste."
>
  <section class="hub-mast">
    <div class="wrap-wide">
      <Kicker class="hub-kicker">§ Hub · Secteurs</Kicker>
      <h1 class="hub-h1 reveal">Mêmes <i>systèmes</i>. Votre <i>vocabulaire</i>.</h1>
      <p class="hub-lede">
        Pas une offre par secteur. Une méthode. Adaptée au vocabulaire, aux KPIs et aux workflows de votre métier.
      </p>
      <p class="hub-canonical">
        {sectorsLive.length > 0
          ? "Des secteurs aujourd'hui. D'autres à venir, quand on aura assez de cas pour parler juste."
          : "Les fiches secteur arrivent. On les publie quand on a assez de cas pour parler juste, pas avant."}
      </p>
      <svg class="sector-svg-sig" viewBox="0 0 260 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Finance : balance -->
        <line x1="35" y1="15" x2="35" y2="75" stroke="currentColor" stroke-width="1.5"/>
        <line x1="15" y1="30" x2="35" y2="22" stroke="currentColor" stroke-width="1.5"/>
        <line x1="35" y1="22" x2="55" y2="32" stroke="currentColor" stroke-width="1.5"/>
        <!-- Séparateur -->
        <line x1="80" y1="10" x2="80" y2="90" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 3"/>
        <!-- Industrie : modules -->
        <rect x="90" y="30" width="20" height="20" stroke="currentColor" stroke-width="1.5"/>
        <line x1="110" y1="40" x2="120" y2="40" stroke="currentColor" stroke-width="1.5"/>
        <rect x="120" y="25" width="24" height="30" stroke="currentColor" stroke-width="1.5"/>
        <line x1="144" y1="40" x2="154" y2="40" stroke="currentColor" stroke-width="1.5"/>
        <rect x="154" y="30" width="20" height="20" stroke="currentColor" stroke-width="1.5"/>
        <!-- Séparateur -->
        <line x1="188" y1="10" x2="188" y2="90" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 3"/>
        <!-- B2B : nœuds -->
        <circle cx="204" cy="45" r="10" stroke="currentColor" stroke-width="1.5"/>
        <circle cx="248" cy="45" r="10" stroke="currentColor" stroke-width="1.5"/>
        <line x1="214" y1="45" x2="238" y2="45" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </div>
  </section>

  {sectorsLive.length > 0 && (
  <section class="hub-sectors-live wrap-wide" aria-label="Secteurs disponibles">
    {sectorsLive.map((s) => (
      <a href={s.href} class="sector-card">
        <div class="sector-num">{s.num}</div>
        <div class="sector-kicker">{s.kicker}</div>
        <span class="sector-en-label">{s.label_en}</span>
        <h2 class="sector-title">{s.label_fr}</h2>
        <p class="sector-sub">{s.sub_fr}</p>
        <p class="sector-pains">{s.pains_fr}</p>
        {s.result && (
          <div class="sector-result">
            <span class="sector-result-v">{s.result.value}</span>
            <span class="sector-result-l">{s.result.label}</span>
          </div>
        )}
        <span class="sector-cta">Voir le secteur →</span>
      </a>
    ))}
  </section>
  )}

  <ComingSoonPills data={comingData} lang="fr" />

  <section class="hub-cta-band">
    <div class="wrap-wide">
      <p class="cta-question">Votre secteur n'est pas listé ?</p>
      <p class="cta-sub">
        Pas grave. Les <a href="/solutions" class="cta-link">5 cas d'usage</a> couvrent 80 % des PME. Le reste, on s'adapte.
      </p>
      <a href="/contact" class="cta-btn" data-mag="0.15">Démarrer un échange →</a>
    </div>
  </section>

  <CtaFinal data={ctaData} lang="fr" />
</Base>

<style>
  .hub-mast {
    padding: 140px var(--space-6) clamp(44px, 6vw, 84px);
    border-bottom: 1px solid var(--hairline);
  }
  :global(.hub-kicker) { display: block; margin-bottom: var(--space-5); }

  .hub-h1 {
    font-family: var(--font-display);
    font-size: clamp(56px, 11vw, 180px);
    line-height: 0.92;
    letter-spacing: -0.03em;
    font-weight: var(--fw-regular);
    text-wrap: balance;
    margin: 0;
  }
  .hub-h1 :global(i) { font-style: italic; color: var(--accent); }

  .hub-lede {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: clamp(18px, 2vw, 24px);
    color: var(--ink-2);
    margin: var(--space-6) 0 0;
    max-width: 760px;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .hub-canonical {
    max-width: var(--wrap-prose);
    margin: 22px 0 0;
    color: var(--muted);
    font-size: var(--text-body-lead);
    line-height: 1.6;
  }

  .sector-svg-sig {
    width: 180px;
    height: auto;
    margin-top: var(--space-8);
    color: var(--hairline-strong);
    opacity: 0.7;
    display: block;
  }

  /* ── Grille secteurs live ── */
  .hub-sectors-live {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    padding: 0 var(--space-6) clamp(80px, 10vw, 128px);
    margin-top: clamp(48px, 6vw, 80px);
  }

  .sector-card {
    min-height: 480px;
    padding: clamp(24px, 2.5vw, 36px);
    background: var(--paper);
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: background var(--dur-trim) var(--ease), transform var(--dur-trim) var(--ease);
    text-decoration: none;
  }
  .sector-card:hover {
    background: var(--paper-2);
    transform: translateY(-4px);
  }

  .sector-num {
    font-family: var(--font-display);
    font-size: clamp(42px, 4.5vw, 72px);
    line-height: 0.9;
    color: var(--ink-2);
    font-style: italic;
    margin-bottom: auto;
  }
  .sector-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: var(--space-5);
  }
  .sector-en-label {
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-2);
    display: block;
  }
  .sector-title {
    font-family: var(--font-display);
    font-size: clamp(27px, 3vw, 42px);
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: var(--fw-regular);
    margin: var(--space-4) 0 10px;
    text-wrap: balance;
  }
  .sector-sub {
    font-family: var(--font-sans);
    font-size: var(--text-body-base);
    line-height: var(--leading-body);
    color: var(--ink-2);
    margin: 0 0 18px;
  }
  .sector-pains {
    color: var(--muted);
    font-size: var(--text-body-sm);
    line-height: 1.6;
    margin: 0 0 var(--space-5);
    flex-grow: 1;
  }
  .sector-result {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--hairline);
    margin-bottom: var(--space-4);
  }
  .sector-result-v {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.4vw, 34px);
    line-height: 1;
    color: var(--accent);
    font-weight: var(--fw-regular);
    letter-spacing: -0.01em;
  }
  .sector-result-l {
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
    line-height: var(--leading-lede);
  }
  .sector-cta {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--accent);
    margin-top: auto;
  }

  /* ── CTA bande ── */
  .hub-cta-band {
    padding: clamp(80px, 10vw, 120px) var(--space-6);
    text-align: center;
  }
  .cta-question {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.5vw, 52px);
    font-weight: var(--fw-regular);
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-4);
  }
  .cta-sub {
    color: var(--muted);
    font-size: var(--text-body-base);
    line-height: 1.6;
    margin: 0 0 var(--space-7);
  }
  .cta-link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cta-btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-ui);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ink);
    padding: var(--space-4) 36px;
    border: 1px solid var(--ink);
    transition: background var(--dur-trim) var(--ease), color var(--dur-trim) var(--ease);
    text-decoration: none;
  }
  .cta-btn:hover { background: var(--accent); border-color: var(--accent); }

  @media (max-width: 1180px) {
    .hub-sectors-live { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .hub-mast { padding-top: var(--space-11); }
    .hub-sectors-live {
      grid-template-columns: 1fr;
      padding-inline: 20px;
    }
    .sector-card { min-height: 360px; }
    .hub-coming { padding-inline: 20px; }
    .hub-cta-band { padding-inline: 20px; }
  }
</style>
