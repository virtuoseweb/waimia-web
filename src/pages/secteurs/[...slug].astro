  value: m.value,
  label_fr: m.label_fr,
  label_en: m.label_en,
}));
const impactBand = impactMetrics.length >= 1 ? {
  type: 'metric-callout-band' as const,
  background: 'ink' as const,
  kicker_fr: "L'impact chiffré",
  kicker_en: 'The measured impact',
  context_fr: `Pas une promesse. Une moyenne mesurée sur les déploiements ${shortTitle.toLowerCase()} que nous avons livrés.`,
  context_en: `Not a promise. An average measured on the ${shortTitle.toLowerCase()} deployments we have delivered.`,
  metrics: impactMetrics,
} : undefined;

// Cas concret INK — carte case-spotlight depuis le cas lié + image cover + citation réelle.
const caseSpotlight = (caseData && recipe) ? {
  type: 'case-spotlight' as const,
  background: 'ink' as const,
  variant: 'media-left' as const,
  kicker_fr: `Un cas concret · ${caseData.sector_fr}`,
  kicker_en: `A concrete case · ${caseData.sector_en}`,
  title_fr: caseData.title_fr,
  title_en: caseData.title_en,
  media_src: caseData.heroImage,
  media_alt: recipe.themeAlt_fr,
  media_caption: caseData.sector_fr,
  quote_fr: recipe.caseQuote_fr,
  quote_en: recipe.caseQuote_en,
  attribution_fr: recipe.caseAttribution_fr,
  attribution_en: recipe.caseAttribution_en,
  metrics: (caseData.metrics ?? []).slice(0, 3).map((m) => ({ k: m.value, label_fr: m.label_fr, label_en: m.label_en })),
  tags: recipe.caseTags,
  cta_href: '/cas',
  cta_label_fr: 'Voir le cas complet →',
  cta_label_en: 'See full case →',
} : undefined;

// Section explicative habillée — feature-split-media, image thème du secteur DANS un bloc composé.
const featureSplit = recipe ? {
  type: 'feature-split-media' as const,
  background: 'paper' as const,
  reversed: recipe.featureReversed,
  kicker_fr: recipe.feature_kicker_fr,
  kicker_en: recipe.feature_kicker_en,
  h2_fr: recipe.feature_h2_fr,
  h2_en: recipe.feature_h2_en,
  body_fr: recipe.feature_body_fr,
  body_en: recipe.feature_body_en,
  points: recipe.feature_points_fr.map((p, i) => ({ label_fr: p, label_en: recipe.feature_points_en[i] ?? p })),
  media_src: recipe.themeImage,
  media_alt_fr: recipe.themeAlt_fr,
  media_alt_en: recipe.themeAlt_en,
  media_caption_fr: shortTitle,
  media_caption_en: shortTitle,
} : undefined;

// Où en êtes-vous — diagnostic-stages, 4 stades adaptés au secteur.
const diagnostic = recipe ? {
  type: 'diagnostic-stages' as const,
  background: 'paper-2' as const,
  kicker_fr: 'Où en êtes-vous ?',
  kicker_en: 'Where are you?',
  h2_fr: `Votre ${shortTitle.toLowerCase()}, <i>aujourd'hui</i>.`,
  h2_en: `Your ${shortTitle.toLowerCase()}, <i>today</i>.`,
  lede_fr: recipe.diag_lede_fr,
  lede_en: recipe.diag_lede_en,
  stages: recipe.diagStages,
} : undefined;

// Frise d'audit terrain — method-timeline (bloc d'ossature propre à industrie : du
// diagnostic terrain à la mise en production, 5 étapes du cas Caserne).
const methodTimeline = (recipe && recipe.methodSteps && recipe.method_h2_fr && recipe.method_h2_en) ? {
  type: 'method-timeline' as const,
  background: 'paper-2' as const,
  kicker_fr: recipe.method_kicker_fr,
  kicker_en: recipe.method_kicker_en,
  h2_fr: recipe.method_h2_fr,
  h2_en: recipe.method_h2_en,
  lede_fr: recipe.method_lede_fr,
  lede_en: recipe.method_lede_en,
  steps: recipe.methodSteps,
} : undefined;

// Avant → après — metric-shift INK (bloc d'ossature propre à industrie : flux physiques
// mesurés avant/après, données du cas Caserne).
const metricShift = (recipe && recipe.shifts) ? {
  type: 'metric-shift' as const,
  background: 'ink' as const,
  kicker_fr: recipe.shift_kicker_fr,
  kicker_en: recipe.shift_kicker_en,
  h2_fr: recipe.shift_h2_fr,
  h2_en: recipe.shift_h2_en,
  lede_fr: recipe.shift_lede_fr,
  lede_en: recipe.shift_lede_en,
  shifts: recipe.shifts,
} : undefined;

// Réassurance — trust-badges-band strip INK, badge final varié par secteur.
const trustBadges = recipe ? {
  type: 'trust-badges-band' as const,
  background: 'ink' as const,
  variant: 'strip' as const,
  kicker_fr: 'Réassurance',
  kicker_en: 'Reassurance',
  badges: [
    { label_fr: 'Partenaire Anthropic', label_en: 'Anthropic Partner' },
    { label_fr: 'Claude Certified Architect', label_en: 'Claude Certified Architect' },
    { label_fr: 'Conforme AI Act', label_en: 'AI Act compliant' },
    { label_fr: 'RGPD', label_en: 'GDPR' },
    { label_fr: recipe.trustExtra_fr, label_en: recipe.trustExtra_en },
  ],
} : undefined;

// FAQ condensée — 4 questions max (mandat : la FAQ 7 items plombe le rythme).
const faqCondensed = (d.faq_fr ?? []).slice(0, 4);
---
<SolutionsDetailTemplate
  title={`${d.title_fr} · Waimia`}
  description={d.description_fr}
  dept={`SECTEUR · ${shortTitle.toUpperCase()}`}
  deptLabel={shortTitle}
  meta={d.icp_fr}
  ctaHref="/contact"
  ctaLabel={d.ctaPrimary_fr}
  case_kicker={caseData ? `Cas client · ${caseData.sector_fr}` : undefined}
  case_body_fr={caseData?.description_fr}
  case_results={caseData?.metrics ?? []}
  impactBand={impactBand}
  caseSpotlight={caseSpotlight}
  featureSplit={featureSplit}
  diagnostic={diagnostic}
  methodTimeline={methodTimeline}
  metricShift={metricShift}
  trustBadges={trustBadges}
  recompoOrder={recipe?.recompoOrder}
  recompoAfterStack={recipe?.recompoAfterStack}
  pains={d.pains_fr.map((p, i) => ({
    title_fr: p.title,
    body_fr: p.body,
    title_en: d.pains_en[i]?.title ?? p.title,
    body_en: d.pains_en[i]?.body ?? p.body,
  }))}
>
  <Fragment slot="title">{shortTitle}</Fragment>
  <Fragment slot="lead"><p>{d.description_fr}</p></Fragment>
  <Fragment slot="tags">
    {d.kpis_fr.map((k) => <span class="sol-tag">{k}</span>)}
  </Fragment>
  <Fragment slot="workflows"><Content /></Fragment>
  <Fragment slot="roi">
    {d.metricsHero.map((m) => (
      <div class="roi-cell">
        <div class="roi-v">{m.value}</div>
        <div class="roi-l">{m.label_fr}</div>
      </div>
    ))}
  </Fragment>
  {caseData && (
    <Fragment slot="case-title">
      {caseTitleParts[0]}{caseTitleParts[1] && <Fragment><br/><i>{caseTitleParts[1]}</i></Fragment>}
    </Fragment>
  )}
  {faqCondensed.length > 0 && (
    <Fragment slot="faq">
      <div class="ws-faq">
        {faqCondensed.map((f, i) => (
          <div class="ws-faq-item">
            <div class="ws-faq-q">
              <span class="ws-faq-mark">Q · {String(i + 1).padStart(2, '0')}</span>
              {f.q}
            </div>
            <p class="ws-faq-a">{f.a}</p>
          </div>
        ))}
      </div>
    </Fragment>
  )}
  <Fragment slot="cta-title">Votre secteur {shortTitle},<br/>câblé.</Fragment>
  <Fragment slot="extra-cases">
    <CaseCardGrid data={caseGridData} lang="fr" />
  </Fragment>
</SolutionsDetailTemplate>
