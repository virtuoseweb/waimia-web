---
// Route · /secteurs/<slug> · hub sectoriel Waimia · rendu 100 % composable (registry).
// « Template-as-data » (décision nuit 0018) : la séquence RICHE (hero-sector · pain-severity ·
// feature-zigzag · metric-callout · grille de cas · diagnostic · tech-stack · editorial-prose ·
// faq · maillage · footer-cta · trust-badges) vit dans la DÉFINITION `sectorTemplate`
// (src/lib/templates/sector.ts), résolue avec le contenu de la page puis rendue par le registry.
// La prose GEO est portée par le champ `body_sections` (html_fr, rendu par editorial-prose).
// Le frontmatter `sections:` du JSON, s'il existe, prend le pas (override total).
export const prerender = true;

import { type CollectionEntry } from 'astro:content';
import { getLiveCollection } from '../../lib/live-collection';
import { resolveTemplate } from '@waimia/ds-kernel/templates';
import { sectorTemplate } from '../../lib/templates/sector';
import Base from '../../layouts/Base.astro';
import MastheadBar from '../../components/sections/MastheadBar.astro';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import { localizeHref } from '../../lib/i18n';
import { sectorCaseGridData } from '../../lib/sector-cases';
import { buildArticle } from '../../lib/seo/schema-builder';
import type { SectionData } from '@waimia/ds-kernel';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  const entries = await getLiveCollection('secteurs');
  return entries
    .filter((entry) => entry.data.visible)
    .map((entry) => ({
      params: { slug: entry.data.slug ?? entry.id },
      props: { entry },
    }));
}

type Props = { entry: CollectionEntry<'secteurs'> };
const { entry } = Astro.props as Props;
const d = entry.data;
const lang = 'fr' as const; // site FR-monolingue
const slug = d.slug ?? entry.id;

// ── JSON-LD · Article (GEO/AIO) · PRÉSERVÉ À L'IDENTIQUE. Le FAQPage JSON-LD est émis
//    UNE seule fois par la section catalogue `faq-accordion` (source canonique). ──
const siteUrl = SITE.url;
const sectorUrl = `${siteUrl}/secteurs/${slug}`;
const sectorLd = buildArticle({
  headline: d.title_fr,
  description: d.description_fr,
  datePublished: new Date(d.publishedAt).toISOString().slice(0, 10),
  dateModified: d.updatedAt ? new Date(d.updatedAt).toISOString().slice(0, 10) : undefined,
  publisher: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: SITE.name,
    logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon-256.png` },
  },
  mainEntityOfPage: sectorUrl,
});
const sectorJsonLd = [sectorLd] as Array<Record<string, unknown>>;

// ── Override total : un JSON qui renseigne `sections:` pilote lui-même tout le rendu. ──
const override = Array.isArray(d.sections) && d.sections.length > 0 ? d.sections : null;

// ── Grille de cas INJECTÉE (sector-cases.ts, async cross-collection) → contexte template. ──
const caseGrid = await sectorCaseGridData(slug, lang);

// ── « Template-as-data » : la séquence composable se résout depuis `sectorTemplate`
//    (aucun slot hors-catalogue pour ce template → items = sections cataloguées). ──
const templateSections: SectionData[] = override
  ? []
  : resolveTemplate(sectorTemplate, { data: d, lang, slug, caseGrid }).flatMap((item) =>
      item.kind === 'section' ? [item.section] : [],
    );

const renderSections = override ?? templateSections;
---
<Base
  title={`${d.title_fr.split(/\s*:\s*/)[0].trim()} · Waimia`}
  description={d.description_fr}
  jsonLd={sectorJsonLd}
  noindex={d.seo?.noindex}
>
  <MastheadBar
    lang={lang}
    items={[
      { label: 'Accueil', href: '/' },
      { label: 'Secteurs', href: localizeHref('/secteurs', lang) },
      { label: d.title_fr },
    ]}
  />

  <SectionsRenderer sections={renderSections} lang={lang} />
</Base>
