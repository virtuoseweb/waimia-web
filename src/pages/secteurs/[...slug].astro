---
export const prerender = true;

import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import SolutionsDetailTemplate from '../../components/templates/SolutionsDetailTemplate.astro';
import CaseCardGrid from '../../components/sections/CaseCardGrid.astro';
import { sectorCaseGridData } from '../../lib/sector-cases';

export async function getStaticPaths() {
  const entries = await getCollection('secteurs');
  return entries
    .filter((entry) => entry.data.visible && !entry.data.seo?.noindex)
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

type Props = { entry: CollectionEntry<'secteurs'> };

const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const d = entry.data;

// Hero : h1 = nom court du secteur (la promesse longue reste dans <title> SEO + lead).
const shortTitle = d.title_fr.split('·')[0].trim();

// Cas client lié (caseRef → collection cases) : alimente le split Case Study du template.
const caseEntry = d.caseRef ? await getEntry('cases', d.caseRef) : null;
const caseData = caseEntry?.data;
const caseTitleParts = caseData ? caseData.title_fr.split('·').map((part: string) => part.trim()) : [];

// Listing « Cas clients » (mandat) : 3 cas, priorité au secteur courant (facets.sector === id),
// complétés par les cas les plus proches. Section cataloguée case-card-grid, secteur visible.
const caseGridData = await sectorCaseGridData(entry.id, 'fr');

/* ─────────────────────────────────────────────────────────────────────────
   RECOMPOSITION tpl-recomp · sections cataloguées INK/habillées, fed ici.
   Toutes les données viennent du MDX secteur + du cas lié (0 invention).
   La config par secteur ne fait que VARIER l'illustration + le fond + l'ordre
   (singularité demandée) à partir de contenu réel.
   ───────────────────────────────────────────────────────────────────────── */
type SectorRecipe = {
  themeImage: string;
  themeAlt_fr: string;
  themeAlt_en: string;
  featureReversed: boolean;
  feature_kicker_fr: string; feature_kicker_en: string;
  feature_h2_fr: string; feature_h2_en: string;
  feature_body_fr: string; feature_body_en: string;
  feature_points_fr: string[]; feature_points_en: string[];
  caseQuote_fr: string; caseQuote_en: string;
  caseAttribution_fr: string; caseAttribution_en: string;
  caseTags: Array<{ fr: string; en: string }>;
  diag_lede_fr: string; diag_lede_en: string;
  diagStages: Array<{
    glyph: string; title_fr: string; title_en: string;
    body_fr: string; body_en: string; phase_fr: string; phase_en: string; current?: boolean;
  }>;
  trustExtra_fr: string; trustExtra_en: string;
  // Composition propre au secteur (mandat R2) — ordre + position des blocs recompo.
  // Chaque secteur a une SÉQUENCE distincte : un bloc différent ouvre, un bloc ink différent
  // clôt (rendu après le Stack). Pilotage par la donnée, pas par clonage de template.
  recompoOrder: Array<'impact' | 'case' | 'feature' | 'diagnostic' | 'method' | 'shift'>;
  recompoAfterStack: Array<'impact' | 'case' | 'feature' | 'diagnostic' | 'method' | 'shift'>;
  // Blocs d'OSSATURE propres à UN secteur (mandat R2 résiduel : varier la présence/absence
  // de blocs, pas seulement l'ordre). Optionnels : seuls les secteurs qui les fournissent
  // les rendent — les autres gardent leur silhouette historique au pixel.
  method_kicker_fr?: string; method_kicker_en?: string;
  method_h2_fr?: string; method_h2_en?: string;
  method_lede_fr?: string; method_lede_en?: string;
  methodSteps?: Array<{
    num: string; label_fr: string; label_en: string;
    body_fr: string; body_en: string; meta_fr?: string; meta_en?: string;
  }>;
  shift_kicker_fr?: string; shift_kicker_en?: string;
  shift_h2_fr?: string; shift_h2_en?: string;
  shift_lede_fr?: string; shift_lede_en?: string;
  shifts?: Array<{
    label_fr: string; label_en: string; before: string; after: string;
    delta_fr?: string; delta_en?: string; trend?: 'up' | 'down' | 'flat';
  }>;
};

