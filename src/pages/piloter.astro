// page (hero), aucune donnée inventée (pas de prix, pas de date). provider = #organization.
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: lang === 'fr' ? 'Piloter · Business Intelligence' : 'Steer · Business Intelligence',
  description: lang === 'fr'
    ? "Vos chiffres vivent dans douze fichiers, trois outils et une boîte mail. On les réunit, on les rend lisibles en temps réel, et l'IA en tire la lecture qui sert la décision. Le pilotage cesse d'être un travail de fin de mois."
    : 'Your figures live in twelve files, three tools and an inbox. We bring them together, make them legible in real time, and AI draws the reading that serves the decision. Steering stops being end-of-month work.',
