---
export const prerender = true;

// Page SSG · /integrations · Index des intégrations Waimia (T5.2)

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { langFromPath } from '../../lib/i18n';
import type { SectionByType } from '../../schemas/sections';
import HeroCentered from '../../components/sections/HeroCentered.astro';

const allIntegrations = await getCollection('integrations');
const lang = langFromPath(Astro.url.pathname);
const sortedIntegrations = [...allIntegrations].sort((a, b) =>
  a.data.tool_name.localeCompare(b.data.tool_name, lang),
);

const headerData = {
  type: 'hero-hub-masthead' as const,
  variant: 'listing' as const,
  decoration: true,
  align: 'left' as const,
  kicker_fr: '§ Intégrations',
  kicker_en: '§ Integrations',
  h1_fr: `${allIntegrations.length} <i>intégrations</i> disponibles`,
  h1_en: `${allIntegrations.length} <i>integrations</i> available`,
  lede_fr: 'Connectez vos outils existants aux workflows IA Waimia. Synchronisation native, API ou via Make/Zapier.',
  lede_en: 'Connect your existing tools to Waimia AI workflows. Native sync, API, or via Make/Zapier.',
} satisfies SectionByType<'hero-hub-masthead'>;

const categoryLabels: Record<string, { fr: string; en: string }> = {
  crm: { fr: 'CRM', en: 'CRM' },
  data: { fr: 'Data', en: 'Data' },
  automation: { fr: 'Automatisation', en: 'Automation' },
  analytics: { fr: 'Analytics', en: 'Analytics' },
  communication: { fr: 'Communication', en: 'Communication' },
  productivity: { fr: 'Productivité', en: 'Productivity' },
  'ai-platform': { fr: 'Plateforme IA', en: 'AI Platform' },
  commerce: { fr: 'Commerce', en: 'Commerce' },
  hosting: { fr: 'Hébergement', en: 'Hosting' },
  autre: { fr: 'Autre', en: 'Other' },
};
---
<Base
  title={lang === 'fr' ? 'Intégrations · Outils connectés · Waimia' : 'Integrations · Connected tools · Waimia'}
  description={lang === 'fr'
    ? 'Connectez vos outils métier à Waimia : HubSpot, Salesforce, Notion, Slack, Make, Zapier et bien plus encore.'
    : 'Connect your business tools to Waimia: HubSpot, Salesforce, Notion, Slack, Make, Zapier, and more.'}
>
  <section class="integrations-index">
    <HeroCentered data={headerData} lang={lang} />
    <div class="wrap-wide">

      <nav class="integrations-index__filters" aria-label={lang === 'fr' ? 'Filtrer par catégorie' : 'Filter by category'}>
        <button class="filter-btn active" data-filter="all" aria-pressed="true">
          {lang === 'fr' ? 'Tous' : 'All'}
        </button>
        {Object.entries(categoryLabels).map(([cat, labels]) => (
          <button class="filter-btn" data-filter={cat} aria-pressed="false">
            {lang === 'fr' ? labels.fr : labels.en}
          </button>
        ))}
      </nav>

      <div class="integrations-index__grid">
        {sortedIntegrations.map((entry) => (
          <article class="integrations-index__card" data-category={entry.data.category}>
            <a href={`/integrations/${entry.id}`} class="integrations-index__card-link">
              <div class="integrations-index__logo">
                {entry.data.logo_url
                  ? (
                    <img src={entry.data.logo_url} alt={entry.data.tool_name} width="48" height="48" loading="lazy" />
                  ) : (
                    <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                      <rect width="48" height="48" rx="10" fill="var(--paper-3)" />
                      <text x="24" y="30" text-anchor="middle" font-size="20" font-family="system-ui, sans-serif" fill="var(--muted)">
                        {entry.data.tool_name.charAt(0).toUpperCase()}
                      </text>
                    </svg>
                  )}
              </div>
              <div class="integrations-index__info">
                <span class="integrations-index__name">{entry.data.tool_name}</span>
                <span class="integrations-index__vendor">{entry.data.vendor}</span>
                <span class="integrations-index__usecase">
                  {lang === 'fr' ? entry.data.use_cases_fr[0] : entry.data.use_cases_en[0]}
                </span>
              </div>
              <span class="integrations-index__cat-badge">
                {lang === 'fr'
                  ? (categoryLabels[entry.data.category]?.fr ?? entry.data.category)
                  : (categoryLabels[entry.data.category]?.en ?? entry.data.category)}
              </span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.integrations-index__card');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter ?? 'all';
      buttons.forEach((button) => {
        button.classList.remove('active');
        button.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      cards.forEach((card) => {
        card.style.display = filter === 'all' || card.dataset.category === filter ? '' : 'none';
      });
    });
  });
</script>

<style>
  .integrations-index {
    padding-top: calc(var(--spacing-section, 4rem) + var(--header-height, 64px));
    padding-bottom: var(--spacing-section, 4rem);
  }
  .integrations-index__filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; }
  .filter-btn {
    padding: 0.375rem 1rem; border: 1px solid var(--hairline);
    border-radius: var(--radius-pill); background: transparent; cursor: pointer;
    font-size: 0.875rem; transition: background 0.15s, color 0.15s;
  }
  .filter-btn.active, .filter-btn:hover {
    background: var(--ink, #111); color: var(--paper); border-color: transparent;
  }
  .integrations-index__grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.25rem;
  }
  .integrations-index__card {
    border: 1px solid var(--hairline); border-radius: var(--radius-lg);
    overflow: hidden; transition: box-shadow 0.15s;
  }
  .integrations-index__card:hover { box-shadow: 0 4px 16px rgba(var(--ink-rgb), .08); }
  .integrations-index__card-link {
    display: flex; flex-direction: column; gap: 0.5rem;
    padding: 1.25rem; text-decoration: none; color: inherit; height: 100%;
  }
  .integrations-index__logo { margin-bottom: 0.25rem; }
  .integrations-index__name { font-weight: var(--fw-semibold); font-size: 1rem; }
  .integrations-index__vendor { font-size: 0.8rem; color: var(--muted, #6B7280); }
  .integrations-index__usecase { font-size: 0.875rem; line-height: var(--leading-lede); color: var(--muted, #6B7280); flex: 1; }
  .integrations-index__cat-badge {
    margin-top: auto; align-self: flex-start; font-size: 0.75rem;
    background: var(--paper-2); border: 1px solid var(--hairline);
    border-radius: var(--radius-sm); padding: 0.125rem 0.5rem; text-transform: uppercase; letter-spacing: 0.04em;
  }
</style>
