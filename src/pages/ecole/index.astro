---
export const prerender = true;

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import HeroCentered from '../../components/sections/HeroCentered.astro';
import OfferTierGrid from '../../components/sections/OfferTierGrid.astro';
import LearningPathList from '../../components/sections/LearningPathList.astro';
import type { SectionByType } from '../../schemas/sections';

const allCourses = await getCollection('courses');
const formations = allCourses.filter((c) => c.data.course_type === 'formation');
const parcours = allCourses.filter((c) => c.data.course_type === 'parcours');
const ateliers = allCourses.filter((c) => c.data.course_type === 'atelier');
const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fr';

// Cours phare = le plus complet (modules + durée), traité en featured ; le reste en cards.
const courseScore = (c: any) =>
  (c.data.modules?.length ?? 0) * 10 + (c.data.duration_hours ?? 0);
const sortedFormations = [...formations].sort((a, b) => courseScore(b) - courseScore(a));
const flagship = sortedFormations[0];
const fd = flagship?.data as any;
const restFormations = sortedFormations.slice(1);

const priceLabel = (c: any, isFr: boolean) => {
  const eur = c?.data?.pricing?.one_time_eur;
  if (eur === 0) return isFr ? 'GRATUIT' : 'FREE';
  if (eur != null) return `${eur} €`;
  return isFr ? 'FORMATION' : 'COURSE';
};
const levelLabels: Record<string, Record<string, string>> = {
  fr: { debutant: 'Débutant', intermediaire: 'Intermédiaire', avance: 'Avancé', expert: 'Expert' },
  en: { debutant: 'Beginner', intermediaire: 'Intermediate', avance: 'Advanced', expert: 'Expert' },
};

const title = lang === 'fr'
  ? 'École Waimia · Catalogue formations IA'
  : 'Waimia School · AI Training Catalog';
const description = lang === 'fr'
  ? 'Formations, parcours et ateliers IA pour dirigeants et équipes PME B2B. Accès immédiat, vrai contenu, zéro bullshit.'
  : 'AI training, programs and workshops for SMB leaders and teams. Immediate access, real content, no fluff.';

// ── Hero (hero-academy-hub) — recopie EXACTE d'EcoleHubTemplate l.15-34 ──
const heroTitleFr = "Apprendre à câbler l'<i>IA</i>";
const heroTitleEn = "Learn to wire <i>AI</i>";
const heroLedeFr = "Formations courtes, cas réels, zéro bullshit. Pour dirigeants et équipes PME B2B qui veulent des résultats mesurables dans les 30 jours.";
const heroLedeEn = "Short courses, real cases, no fluff. For SMB leaders and teams who want measurable results within 30 days.";
const kickerTextFr = `École Waimia · Catalogue · Inscriptions ouvertes`;
const kickerTextEn = `Waimia School · Catalog · Enrollments open`;
const statsLabelFr = `${formations.length} formation${formations.length > 1 ? 's' : ''} · ${parcours.length} parcours · ${ateliers.length} atelier${ateliers.length > 1 ? 's' : ''}`;
const statsLabelEn = `${formations.length} course${formations.length > 1 ? 's': ''} · ${parcours.length} program${parcours.length > 1 ? 's': ''} · ${ateliers.length} workshop${ateliers.length > 1 ? 's': ''}`;

const heroData = {
  type: 'hero-academy-hub',
  kicker_fr: kickerTextFr,
  kicker_en: kickerTextEn,
  h1_fr: heroTitleFr,
  h1_en: heroTitleEn,
  lede_fr: heroLedeFr,
  lede_en: heroLedeEn,
  stats_label_fr: statsLabelFr,
  stats_label_en: statsLabelEn,
} satisfies SectionByType<'hero-academy-hub'>;

// ── Catalogue formations → offer-tier-grid (featured = cours phare, cards = reste) ──
const courseLead = (c: any, isFr: boolean) => {
  const lvl = levelLabels[isFr ? 'fr' : 'en'][c.data.level] ?? c.data.level;
  const desc = isFr ? c.data.description_fr : c.data.description_en;
  const dur = `${c.data.duration_hours}h`;
  return isFr ? `${desc} · ${lvl} · ${dur}` : `${desc} · ${lvl} · ${dur}`;
};

const formationsGrid: SectionByType<'offer-tier-grid'> | null = flagship
  ? {
      type: 'offer-tier-grid',
      variant: 'featured',
      wrap: false,
      background: 'paper-2',
      eyebrow_fr: 'CATALOGUE · FORMATIONS',
      eyebrow_en: 'CATALOG · COURSES',
      h2_fr: 'Des formations qui livrent.',
      h2_en: 'Courses that deliver.',
      lede_fr: 'Cas réels, accès immédiat, résultats mesurables. Commencez par le cours phare.',
      lede_en: 'Real cases, immediate access, measurable results. Start with the flagship course.',
      featured_card: {
        eyebrow_fr: `COURS PHARE · ${priceLabel(flagship, true)}`,
        eyebrow_en: `FLAGSHIP COURSE · ${priceLabel(flagship, false)}`,
        title_fr: fd.title_fr,
        title_en: fd.title_en,
        sub_fr: `${levelLabels.fr[fd.level] ?? fd.level} · ${fd.duration_hours}h · ${fd.modules?.length ?? 0} modules`,
        sub_en: `${levelLabels.en[fd.level] ?? fd.level} · ${fd.duration_hours}h · ${fd.modules?.length ?? 0} modules`,
        lead_fr: fd.description_fr,
        lead_en: fd.description_en,
        cta_fr: 'Voir la formation →',
        cta_en: 'See the course →',
        href: `/ecole/cours/${flagship.id}`,
      },
      offers: restFormations.map((c) => ({
        price_fr: priceLabel(c, true),
        price_en: priceLabel(c, false),
        title_fr: c.data.title_fr,
        title_en: c.data.title_en,
        lead_fr: courseLead(c, true),
        lead_en: courseLead(c, false),
        cta_fr: 'Voir la formation →',
        cta_en: 'See the course →',
        href: `/ecole/cours/${c.id}`,
      })),
    }
  : null;

// ── Parcours → learning-path-list ──
type PathItem = SectionByType<'learning-path-list'>['items'][number];
const pathItems: PathItem[] = parcours.map((p) => ({
  title_fr: p.data.title_fr,
  title_en: p.data.title_en,
  desc_fr: p.data.description_fr,
  desc_en: p.data.description_en,
}));
const parcoursTitleFr = 'Parcours';
const parcoursTitleEn = 'Learning paths';

// ── CTA finale page-level ──
const ctaText = lang === 'fr' ? 'Demander un parcours sur mesure' : 'Request a custom learning path';
---
<Base {title} {description}>
  <section class="ecole-hub">
    <!-- HERO -->
    <HeroCentered data={heroData} lang={lang} wrap={false} topPad="48px" />

    <!-- CATALOGUE FORMATIONS · grille featured (cours phare) + cards -->
    {formationsGrid && formationsGrid.offers.length > 0 && (
      <div class="ecole-formations" data-card-count={formationsGrid.offers.length}>
        <OfferTierGrid data={formationsGrid} lang={lang} />
      </div>
    )}

    <!-- SECTION PARCOURS -->
    {pathItems.length > 0 && (
      <LearningPathList
        data={{ type: 'learning-path-list', title_fr: parcoursTitleFr, title_en: parcoursTitleEn, items: pathItems }}
        lang={lang}
      />
    )}

    <!-- CTA FINALE -->
    <div class="cta-finale">
      <a href="/contact" class="cta-link">{ctaText} →</a>
    </div>
  </section>
</Base>

<style>
  /* ───── COPIE VERBATIM EcoleHubTemplate l.116-121 (.ecole-hub) ───── */
  .ecole-hub {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--space-page-x, 24px);
    background: var(--paper);
  }

  /* ───── COPIE VERBATIM EcoleHubTemplate l.252-271 (CTA FINALE) ───── */
  .cta-finale {
    padding: 56px 0 72px;
    border-top: 1px solid var(--hairline);
    margin-top: var(--space-5);
  }

  .cta-link {
    font-family: var(--font-sans);
    font-size: var(--text-body-lead);
    font-weight: var(--fw-medium);
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s;
  }

  .cta-link:hover {
    color: var(--accent);
  }

  /* ───── Micro-rythme it.10 · équilibrage de la rangée de cards sous le featured ─────
     OfferTierGrid (partagé, intact) rend `.tier-ii-grid` en 3 colonnes fixes. Avec 2
     formations restantes (hors cours phare), le 3ᵉ tiers reste vide. On adapte le nombre
     de colonnes au nombre de cards DEPUIS la page (override local `:global`, comme le
     pattern count-driven de FeatureGrid), sans toucher au composant. Le repli mobile
     (1 colonne, < 900px) du composant reste prioritaire (override borné à ≥ 901px). */
  @media (min-width: 901px) {
    .ecole-formations[data-card-count='2'] :global(.tier-ii-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ecole-formations[data-card-count='1'] :global(.tier-ii-grid) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
