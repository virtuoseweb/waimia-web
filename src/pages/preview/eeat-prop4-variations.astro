---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import Prop04 from '../../components/proposals/eeat/Prop04.astro';
import Prop04a from '../../components/proposals/eeat/Prop04a.astro';
import Prop04b from '../../components/proposals/eeat/Prop04b.astro';
import Prop04c from '../../components/proposals/eeat/Prop04c.astro';
import Prop04d from '../../components/proposals/eeat/Prop04d.astro';
import Prop01a from '../../components/proposals/eeat/Prop01a.astro';
import Prop01b from '../../components/proposals/eeat/Prop01b.astro';

const PROPS = [
  { n: '04',  name: 'Tableau de bord E-E-A-T (base)', desc: 'Référence. Bento control-panel sur fond sombre, cellules de preuves.' },
  { n: '04a', name: 'Dashboard média', desc: 'Bento enrichi d\'images, cases accent CTA &amp; chiffre-repère. Fond sombre.' },
  { n: '04b', name: 'Colonnes accent', desc: 'Quatre colonnes rythmées, bande image en tête, colonne pleine en accent. Fond sombre.' },
  { n: '04c', name: 'Form light', desc: 'Déclinaison claire du dashboard, images &amp; CTA pleine accent. Fond clair.' },
  { n: '04d', name: 'Image-hero dashboard', desc: 'Média vedette pleine largeur en tête du bento. Fond sombre.' },
  { n: '01a', name: 'Dossier d\'auteur visuel', desc: 'Dossier d\'auteur dense : colonne portrait, tableau de bord d\'images, case accent. Fond clair.' },
  { n: '01b', name: 'Dossier d\'auteur · light', desc: 'Forme claire &amp; aérée : bandeau image-hero, colonnes auteur, vignettes. Fond clair.' },
];
const COMPS = [Prop04, Prop04a, Prop04b, Prop04c, Prop04d, Prop01a, Prop01b];
---

<Base title="Variations · proposition 4 E-E-A-T" description="Déclinaisons visuelles de la section tableau de bord E-E-A-T : images, colonnes accent et formes claires. Page de revue interne." noindex={true}>
  <section class="eepi" data-bg="paper">
    <div class="wrap-wide">
      <p class="eepi__k">Revue interne · variations</p>
      <h1 class="eepi__h">Variations de la proposition 4</h1>
      <p class="eepi__l">La proposition 4 (tableau de bord E-E-A-T) sert de base. Voici ses déclinaisons plus visuelles : images, colonnes &amp; cases accent, plus une forme claire (light). En bas, deux variantes du dossier d'auteur (proposition 1) dans le même esprit. À choisir : la ou les déclinaisons à cataloguer.</p>
    </div>
  </section>
  {COMPS.map((Comp, i) => (
    <>
      <div class="eeplabel" data-bg="paper-3">
        <div class="wrap-wide eeplabel__in">
          <span class="eeplabel__n">Proposition {PROPS[i].n}</span>
          <span class="eeplabel__name">{PROPS[i].name}</span>
          <span class="eeplabel__desc">{PROPS[i].desc}</span>
        </div>
      </div>
      <Comp />
    </>
  ))}
</Base>

<style>
  /* ====== Intro ====== */
  .eepi {
    padding-block: var(--section-base);
    background: var(--paper);
    border-bottom: 1px solid var(--hairline);
  }

  .eepi__k {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0 0 var(--space-5);
  }

  .eepi__h {
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    letter-spacing: -0.015em;
    font-weight: var(--fw-semibold);
    color: var(--ink);
    margin: 0 0 var(--space-6);
    text-wrap: balance;
    max-width: 22ch;
  }

  .eepi__l {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--muted);
    max-width: 62ch;
    margin: 0;
    text-wrap: pretty;
  }

  /* ====== Bandeau étiquette ====== */
  .eeplabel {
    background: var(--paper-3);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .eeplabel__in {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    padding-block: var(--space-5);
  }

  .eeplabel__n {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    font-weight: var(--fw-bold);
    color: var(--accent-text);
    flex-shrink: 0;
  }

  .eeplabel__name {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--fw-medium);
    color: var(--ink);
    flex-shrink: 0;
  }

  .eeplabel__desc {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    color: var(--muted);
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .eeplabel__in {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>
