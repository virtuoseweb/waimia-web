---
// Waimia · Route preview chrome-less ANIMÉE d'une section (U4, §11.3 / §12.2.A docs/design-system/03).
//
// Variante de /preview/[type].astro qui REJOUE les reveals réels au lieu de les neutraliser.
// /preview/[type].astro force opacity:1/transition:none (iframe statique non scrollée) ; ici on
// monte l'IntersectionObserver scroll-reveal (src/lib/animations/scroll-reveal.ts) pour que les
// classes .reveal[*] démarrent opacity:0 puis se révèlent au scroll, comme sur le site.
//
// Consommée en iframe par /library/[type] via le toggle « voir l'animation » (VariantToggle).
// Même chrome-less : pas de header/footer/nav, noindex, hors sitemap.
//
// N'utilise PAS Base.astro. Reprend les imports CSS réels de Base : global.css, grid.css,
// scroll-reveal.css, mais SANS le bloc de neutralisation des reveals.

import '../../../styles/global.css';
import '../../../styles/grid.css';
import '../../../styles/scroll-reveal.css';
import { listSections } from '../../../lib/section-registry';
import { SECTION_REGISTRY } from '../../../lib/section-components';
import { SECTION_DEMOS } from '../../../lib/section-demos';
import { getUsage, getConsumers } from '../../../lib/library-manifest';
import { internalToolsEnabled } from '../../../lib/seo/internal-tools.mjs';

export function getStaticPaths() {
  // Surface interne : non générée dans le build de production (cf lib/seo/internal-tools.mjs).
  if (!internalToolsEnabled()) return [];
  return listSections().map((section) => ({ params: { type: section.type } }));
}

const { type } = Astro.params as { type: string };
const C = SECTION_REGISTRY[type as keyof typeof SECTION_REGISTRY] as any;
const demo = SECTION_DEMOS[type as keyof typeof SECTION_DEMOS];

// Étiquetage catalogue (docs/40 §3) : badge usage en overlay (lisible light + ink).
const usage = getUsage(type);
const consumerCount = getConsumers(type).length;
---
<!doctype html>
<html lang="fr" data-lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{`Aperçu animé · ${type}`}</title>
    {/* Variante ANIMÉE : on NE neutralise PAS les reveals. Le seul style inline est le
        reset margin + le badge usage (identiques à /preview/[type].astro). */}
    <style is:inline>
      html, body { margin: 0; padding: 0; background: var(--paper, #fff); }
      /* Badge usage (docs/40 §3) · overlay fixe, fond opaque + bordure pour
         rester lisible sur toute section, light comme [data-bg='ink']. */
      .ds-preview-usage {
        position: fixed;
        top: 12px;
        right: 12px;
        z-index: 9999;
        display: inline-flex;
        align-items: center;
        padding: 6px 9px;
        background: var(--paper);
        border: 1px solid var(--hairline);
        color: var(--ink-2);
        font-family: var(--font-mono);
        font-size: var(--text-small);
        line-height: 1;
        letter-spacing: 0.04em;
        white-space: nowrap;
        pointer-events: none;
      }
      .ds-preview-usage--site { border-color: var(--accent-text); color: var(--accent-sur-clair); }

      /* ======================================================================
         TOOLBAR de preview (T5) · cachée par défaut (0 flash en iframe).
         Révélée UNIQUEMENT en consultation standalone via :root[data-standalone]
         (posé par le script inline self===top ci-dessous). Cette route est la
         vue ANIMÉE : le toggle de rendu pointe vers la version statique.
         Style calqué sur .ds-preview-usage : 100 % tokens DS. */
      .preview-toolbar { display: none; }
      :root[data-standalone] .preview-toolbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 10000;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-4);
        padding: var(--space-2) var(--space-3);
        background: var(--paper);
        border-bottom: 1px solid var(--hairline);
        font-family: var(--font-mono);
        font-size: var(--text-small);
        letter-spacing: var(--tracking-mono-tight);
        color: var(--ink-2);
      }
      :root[data-standalone] body { padding-top: var(--space-9); }
      .preview-toolbar__group { display: inline-flex; align-items: center; gap: var(--space-2); }
      .preview-toolbar__label { color: var(--muted); text-transform: uppercase; }
      .preview-toolbar__btn {
        appearance: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        padding: var(--space-1) var(--space-2);
        background: transparent;
        border: 1px solid var(--hairline-strong);
        border-radius: var(--radius-sm);
        color: var(--ink-2);
        font: inherit;
        letter-spacing: inherit;
      }
      .preview-toolbar__btn:hover { border-color: var(--accent-text); color: var(--accent-text); }
      .preview-toolbar__btn[aria-pressed='true'] {
        background: var(--accent);
        border-color: var(--accent);
        color: var(--accent-ink);
      }
      .preview-toolbar__link {
        color: var(--accent-text);
        text-decoration: none;
        border-bottom: 1px solid var(--hairline-strong);
      }
      .preview-toolbar__link:hover { border-color: var(--accent-text); }
      .preview-stage { width: 100%; margin: 0 auto; }
      .preview-stage[data-viewport='tablet'] { max-width: 768px; } /* largeur structurelle outil · tablette */
      .preview-stage[data-viewport='mobile'] { max-width: 390px; } /* largeur structurelle outil · mobile */
    </style>
  </head>
  <body>
    {usage === 'site' ? (
      <span class="ds-preview-usage ds-preview-usage--site">Sur waimia · {consumerCount}</span>
    ) : (
      <span class="ds-preview-usage ds-preview-usage--library">Bibliothèque</span>
    )}

    {/* Toolbar de preview · révélée seulement en standalone (cf CSS + script self===top). */}
    <nav class="preview-toolbar" aria-label="Outils de prévisualisation">
      <div class="preview-toolbar__group" role="group" aria-label="Largeur du viewport">
        <span class="preview-toolbar__label">Viewport</span>
        <button type="button" class="preview-toolbar__btn" data-viewport-btn="desktop" aria-pressed="true">Desktop</button>
        <button type="button" class="preview-toolbar__btn" data-viewport-btn="tablet" aria-pressed="false">Tablette</button>
        <button type="button" class="preview-toolbar__btn" data-viewport-btn="mobile" aria-pressed="false">Mobile</button>
      </div>
      <div class="preview-toolbar__group">
        <span class="preview-toolbar__label">Rendu</span>
        {/* Vue animée : le toggle renvoie à la version statique. */}
        <a class="preview-toolbar__link" href={`/preview/${type}`}>Voir le statique</a>
      </div>
      <div class="preview-toolbar__group">
        <a class="preview-toolbar__link" href={`/library/${type}`}>Fiche</a>
      </div>
      <div class="preview-toolbar__group">
        <button type="button" class="preview-toolbar__btn" data-copy-json>Copier le JSON</button>
      </div>
    </nav>

    <div class="preview-stage" data-viewport="desktop">
      {C && demo ? <C data={demo} lang="fr" /> : <p style="font-family:monospace;padding:24px">Section inconnue : {type}</p>}
    </div>

    {/* Données démo sérialisées pour le bouton « Copier le JSON » (lu par le script inline). */}
    <script type="application/json" data-demo-json set:html={JSON.stringify(demo ?? null)}></script>

    {/* Révèle la toolbar UNIQUEMENT hors iframe + câble ses contrôles (vanilla, 0 React). */}
    <script is:inline>
      (function () {
        var isStandalone = window.self === window.top;
        if (!isStandalone) return; // en iframe : toolbar reste cachée, section pleine largeur
        document.documentElement.setAttribute('data-standalone', '');

        var stage = document.querySelector('.preview-stage');
        var vpButtons = document.querySelectorAll('[data-viewport-btn]');
        vpButtons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            var vp = btn.getAttribute('data-viewport-btn');
            if (stage) stage.setAttribute('data-viewport', vp);
            vpButtons.forEach(function (b) {
              b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
            });
          });
        });

        var copyBtn = document.querySelector('[data-copy-json]');
        var jsonEl = document.querySelector('[data-demo-json]');
        if (copyBtn && jsonEl) {
          copyBtn.addEventListener('click', function () {
            var pretty = jsonEl.textContent;
            try { pretty = JSON.stringify(JSON.parse(jsonEl.textContent), null, 2); } catch (e) {}
            navigator.clipboard.writeText(pretty).then(function () {
              var prev = copyBtn.textContent;
              copyBtn.textContent = 'Copié';
              setTimeout(function () { copyBtn.textContent = prev; }, 1500);
            });
          });
        }
      })();
    </script>

    {/* Monte l'observer scroll-reveal réel : les .reveal[*] démarrent opacity:0 puis
        passent .is-visible/.in au scroll (même module que Base.astro). */}
    <script>
      import '../../../lib/animations/scroll-reveal';
      import '../../../lib/animations/container-expand';
      import '../../../lib/animations/scroll-morph';
    </script>
  </body>
</html>
