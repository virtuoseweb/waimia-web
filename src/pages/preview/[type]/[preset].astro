---
// Waimia · Route preview chrome-less d'un PRESET d'une section (Phase B, docs/46).
// Rend le composant du type avec la demo par défaut SURCHARGÉE par les props du preset
// (background / layout / density). Même chrome-less que /preview/[type].astro : pas de
// header/footer, état révélé forcé, noindex. getStaticPaths imbriqué sur SECTION_PRESETS.

import '../../../styles/global.css';
import '../../../styles/grid.css';
import '../../../styles/scroll-reveal.css';
import { SECTION_REGISTRY } from '../../../lib/section-registry';
import { SECTION_DEMOS } from '../../../lib/section-demos';
import { SECTION_PRESETS } from '@waimia/ds-kernel/lib/section-presets';
import { variantsFor, colorVariantsFor, coverageVariantsFor } from '@waimia/ds-kernel/lib/section-variants';
import { SECTIONS } from '../../../lib/section-registry';
import type { SectionType } from '@waimia/ds-kernel';

export function getStaticPaths() {
  // Témoin de complétude couleur : un seul type rend ses 16 schémas (axe orthogonal,
  // pas multiplié sur tout le catalogue).
  const COLOR_WITNESS: SectionType = 'feature-grid';

  const allTypes = Object.keys(SECTIONS) as SectionType[];

  return allTypes.flatMap((type) => {
    const manual = SECTION_PRESETS[type] ?? [];
    const generated = variantsFor(type);
    const witnessColors = type === COLOR_WITNESS ? colorVariantsFor(type) : [];
    // Couverture DIVERSE de l'espace d'axes complet : témoin = feature-grid (SYS v2-E).
    // Chaque valeur de chaque axe apparaît ≥ 1 ; le catalogue est riche sans pré-rendre
    // les milliards de combinaisons (cf combinationCount).
    const coverage = type === COLOR_WITNESS ? coverageVariantsFor(type) : [];

    // Dedup par id : un preset manuel l'emporte sur une variante générée de même id.
    const seen = new Set<string>();
    const merged: Array<{ id: string; label: string; props: Record<string, unknown> }> = [];
    for (const entry of [...manual, ...generated, ...witnessColors, ...coverage]) {
      if (seen.has(entry.id)) continue;
      seen.add(entry.id);
      merged.push({ id: entry.id, label: entry.label, props: entry.props });
    }

    return merged.map((entry) => ({
      params: { type, preset: entry.id },
      props: { presetProps: entry.props, label: entry.label },
    }));
  });
}

const { type, preset } = Astro.params as { type: string; preset: string };
const { presetProps, label } = Astro.props as {
  presetProps: Record<string, unknown>;
  label: string;
};

const C = SECTION_REGISTRY[type as keyof typeof SECTION_REGISTRY] as any;
const demo = SECTION_DEMOS[type as SectionType];
// Le preset surcharge la demo par défaut (style global, contenu hérité de la demo).
const data = demo ? { ...demo, ...presetProps } : undefined;
---
<!doctype html>
<html lang="fr" data-lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{`Aperçu · ${type} · ${preset}`}</title>
    <style is:inline>
      html, body { margin: 0; padding: 0; background: var(--paper, #fff); }
      .ds-preview-usage {
        position: fixed;
        top: 12px;
        right: 12px;
        z-index: 9999;
        display: inline-flex;
        align-items: center;
        padding: 6px 9px;
        background: var(--paper);
        border: 1px solid var(--hairline);
        color: var(--ink-2);
        font-family: var(--font-mono);
        font-size: var(--text-small);
        line-height: 1;
        letter-spacing: 0.04em;
        white-space: nowrap;
        pointer-events: none;
      }

      /* ======================================================================
         TOOLBAR de preview (T5) · cachée par défaut (0 flash en iframe).
         Révélée UNIQUEMENT en consultation standalone via :root[data-standalone]
         (posé par le script inline self===top ci-dessous). Vue PRESET statique :
         pas de variante preset-animée → toggle de rendu non affiché.
         Style calqué sur .ds-preview-usage : 100 % tokens DS. */
      .preview-toolbar { display: none; }
      :root[data-standalone] .preview-toolbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 10000;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-4);
        padding: var(--space-2) var(--space-3);
        background: var(--paper);
        border-bottom: 1px solid var(--hairline);
        font-family: var(--font-mono);
        font-size: var(--text-small);
        letter-spacing: var(--tracking-mono-tight);
        color: var(--ink-2);
      }
      :root[data-standalone] body { padding-top: var(--space-9); }
      .preview-toolbar__group { display: inline-flex; align-items: center; gap: var(--space-2); }
      .preview-toolbar__label { color: var(--muted); text-transform: uppercase; }
      .preview-toolbar__btn {
        appearance: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        padding: var(--space-1) var(--space-2);
        background: transparent;
        border: 1px solid var(--hairline-strong);
        border-radius: var(--radius-sm);
        color: var(--ink-2);
        font: inherit;
        letter-spacing: inherit;
      }
      .preview-toolbar__btn:hover { border-color: var(--accent-text); color: var(--accent-text); }
      .preview-toolbar__btn[aria-pressed='true'] {
        background: var(--accent);
        border-color: var(--accent);
        color: var(--accent-ink);
      }
      .preview-toolbar__link {
        color: var(--accent-text);
        text-decoration: none;
        border-bottom: 1px solid var(--hairline-strong);
      }
      .preview-toolbar__link:hover { border-color: var(--accent-text); }
      .preview-stage { width: 100%; margin: 0 auto; }
      .preview-stage[data-viewport='tablet'] { max-width: 768px; } /* largeur structurelle outil · tablette */
      .preview-stage[data-viewport='mobile'] { max-width: 390px; } /* largeur structurelle outil · mobile */

      .reveal, .reveal-up, .reveal-fade, .reveal-slide, .reveal-snap,
      .scale-in, .blur-in, .clip-up, .hair-draw, .row-lines,
      .reveal-mask-up, .reveal-zoom-in, .reveal-blur-clip,
      .reveal-curtain, .reveal-split-letter,
      .reveal-stagger > * {
        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
        clip-path: none !important;
        transition: none !important;
        animation: none !important;
      }
    </style>
  </head>
  <body>
    <span class="ds-preview-usage">Preset · {label}</span>

    {/* Toolbar de preview · révélée seulement en standalone (cf CSS + script self===top).
        Pas de toggle de rendu : aucune variante preset-animée n'existe. */}
    <nav class="preview-toolbar" aria-label="Outils de prévisualisation">
      <div class="preview-toolbar__group" role="group" aria-label="Largeur du viewport">
        <span class="preview-toolbar__label">Viewport</span>
        <button type="button" class="preview-toolbar__btn" data-viewport-btn="desktop" aria-pressed="true">Desktop</button>
        <button type="button" class="preview-toolbar__btn" data-viewport-btn="tablet" aria-pressed="false">Tablette</button>
        <button type="button" class="preview-toolbar__btn" data-viewport-btn="mobile" aria-pressed="false">Mobile</button>
      </div>
      <div class="preview-toolbar__group">
        <a class="preview-toolbar__link" href={`/library/${type}`}>Fiche</a>
      </div>
      <div class="preview-toolbar__group">
        <button type="button" class="preview-toolbar__btn" data-copy-json>Copier le JSON</button>
      </div>
    </nav>

    <div class="preview-stage" data-viewport="desktop">
      {C && data ? <C data={data} lang="fr" /> : <p style="font-family:monospace;padding:24px">Preset inconnu : {type} / {preset}</p>}
    </div>

    {/* Données du preset sérialisées pour le bouton « Copier le JSON » (lu par le script inline). */}
    <script type="application/json" data-demo-json set:html={JSON.stringify(data ?? null)}></script>

    {/* Révèle la toolbar UNIQUEMENT hors iframe + câble ses contrôles (vanilla, 0 React). */}
    <script is:inline>
      (function () {
        var isStandalone = window.self === window.top;
        if (!isStandalone) return; // en iframe : toolbar reste cachée, section pleine largeur
        document.documentElement.setAttribute('data-standalone', '');

        var stage = document.querySelector('.preview-stage');
        var vpButtons = document.querySelectorAll('[data-viewport-btn]');
        vpButtons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            var vp = btn.getAttribute('data-viewport-btn');
            if (stage) stage.setAttribute('data-viewport', vp);
            vpButtons.forEach(function (b) {
              b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
            });
          });
        });

        var copyBtn = document.querySelector('[data-copy-json]');
        var jsonEl = document.querySelector('[data-demo-json]');
        if (copyBtn && jsonEl) {
          copyBtn.addEventListener('click', function () {
            var pretty = jsonEl.textContent;
            try { pretty = JSON.stringify(JSON.parse(jsonEl.textContent), null, 2); } catch (e) {}
            navigator.clipboard.writeText(pretty).then(function () {
              var prev = copyBtn.textContent;
              copyBtn.textContent = 'Copié';
              setTimeout(function () { copyBtn.textContent = prev; }, 1500);
            });
          });
        }
      })();
    </script>
  </body>
</html>
