---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import Prop01 from '../../components/proposals/eeat/Prop01.astro';
import Prop02 from '../../components/proposals/eeat/Prop02.astro';
import Prop03 from '../../components/proposals/eeat/Prop03.astro';
import Prop04 from '../../components/proposals/eeat/Prop04.astro';
import Prop05 from '../../components/proposals/eeat/Prop05.astro';
import Prop06 from '../../components/proposals/eeat/Prop06.astro';
import Prop07 from '../../components/proposals/eeat/Prop07.astro';
import Prop08 from '../../components/proposals/eeat/Prop08.astro';
import Prop09 from '../../components/proposals/eeat/Prop09.astro';
import Prop10 from '../../components/proposals/eeat/Prop10.astro';

const PROPS = [
  { n: '01', name: 'Dossier d\'auteur', desc: 'Grand nom & rôle à gauche, repères à droite, grille de liens dessous.' },
  { n: '02', name: 'Index éditorial', desc: 'Sommaire de revue numéroté 01 à 04, filets horizontaux.' },
  { n: '03', name: 'Carte praticien & grille', desc: 'Carte de visite à gauche, grille de liens catégorisés à droite.' },
  { n: '04', name: 'Tableau de bord E-E-A-T', desc: 'Bento control-panel sur fond sombre, cellules de preuves.' },
  { n: '05', name: 'Colophon & boucle', desc: 'Ours de magazine, signature & rangées de liens en pied.' },
  { n: '06', name: 'Fiche praticien', desc: 'Fiche structurée (expertise, parcours) & sidebar de liens.' },
  { n: '07', name: 'Mur de liens éditorial', desc: 'Bento asymétrique, cellule auteur en vedette.' },
  { n: '08', name: 'Triptyque autorité', desc: 'Trois colonnes Qui / Où / Quoi lire, filets verticaux.' },
  { n: '09', name: 'Portrait & index', desc: 'Panneau portrait sombre & index de liens clair.' },
  { n: '10', name: 'Constellation hub', desc: 'Auteur central & satellites reliés par filets.' },
];
const COMPS = [Prop01, Prop02, Prop03, Prop04, Prop05, Prop06, Prop07, Prop08, Prop09, Prop10];
---

<Base title="Propositions · sections E-E-A-T" description="Dix propositions de section bento éditoriale pour consolider auteur, repères, secteurs, articles et services. Page de revue interne." noindex={true}>
  <section class="eepi" data-bg="paper">
    <div class="wrap-wide">
      <p class="eepi__k">Revue interne</p>
      <h1 class="eepi__h">Dix sections E-E-A-T à départager</h1>
      <p class="eepi__l">Chaque proposition consolide auteur, repères, secteurs, articles, services & outil dans un bento éditorial à filets. À choisir : celle qui remplacera et fusionnera « Qui conçoit », « Repères » & « Pour aller plus loin ».</p>
    </div>
  </section>
  {COMPS.map((Comp, i) => (
    <>
      <div class="eeplabel" data-bg="paper-3">
        <div class="wrap-wide eeplabel__in">
          <span class="eeplabel__n">Proposition {PROPS[i].n}</span>
          <span class="eeplabel__name">{PROPS[i].name}</span>
          <span class="eeplabel__desc">{PROPS[i].desc}</span>
        </div>
      </div>
      <Comp />
    </>
  ))}
</Base>

<style>
  /* ====== Intro ====== */
  .eepi {
    padding-block: var(--section-base);
    background: var(--paper);
    border-bottom: 1px solid var(--hairline);
  }

  .eepi__k {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0 0 var(--space-5);
  }

  .eepi__h {
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    letter-spacing: -0.015em;
    font-weight: var(--fw-semibold);
    color: var(--ink);
    margin: 0 0 var(--space-6);
    text-wrap: balance;
    max-width: 22ch;
  }

  .eepi__l {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--muted);
    max-width: 62ch;
    margin: 0;
    text-wrap: pretty;
  }

  /* ====== Bandeau étiquette ====== */
  .eeplabel {
    background: var(--paper-3);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .eeplabel__in {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    padding-block: var(--space-5);
  }

  .eeplabel__n {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    font-weight: var(--fw-bold);
    color: var(--accent-text);
    flex-shrink: 0;
  }

  .eeplabel__name {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--fw-medium);
    color: var(--ink);
    flex-shrink: 0;
  }

  .eeplabel__desc {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    color: var(--muted);
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .eeplabel__in {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>
