---
export const prerender = true;

// Page SSG · /audit-ia-pme · la page qui PRÉSENTE l'audit (refonte 4 octobre 2026).
// Son CTA mène à /contact#offer=audit-ia-pme&intent=audit (prise de rendez-vous).
//
// Composition : organisms dédiés (src/components/ui/organisms/audit/*, contenu dans
// src/data/audit-ia-pme.ts) + sections catalogue pour la FAQ et la bande finale
// (entrée `audits/audit-ia-pme`, rendues par SectionsRenderer : la FAQ émet le FAQPage
// JSON-LD, source canonique). Aucun markup inline dans cette page.

import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionsRenderer from '../components/sections/SectionsRenderer.astro';
import MastheadBar from '../components/sections/MastheadBar.astro';
import AuditHero from '../components/ui/organisms/audit/AuditHero.astro';
import AuditBody from '../components/ui/organisms/audit/AuditBody.astro';
import ResourceLinks from '../components/ui/organisms/conversion/ResourceLinks.astro';
import { buildService, buildOffer } from '../lib/seo/schema-builder';
import { engagementOffer } from '../data/pricing';
import { SITE } from '../site.config';
import { AUDIT_BOOKING_HREF } from '../data/conversion';

const entry = await getEntry('audits', 'audit-ia-pme');
if (!entry) {
  throw new Error("audit-ia-pme : entrée `audits/audit-ia-pme` introuvable.");
}
const data = entry.data;

const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fr';
const title = lang === 'en' ? data.title_en : data.title_fr;
const description = lang === 'en' ? data.description_en : data.description_fr;

if (!Array.isArray(data.sections) || data.sections.length === 0) {
  throw new Error("audit-ia-pme : `sections` requis (FAQ + bande finale).");
}

// JSON-LD métier · Service avec son offre (prestation gratuite). FAQPage émis par `faq-accordion`.
const auditOffer = engagementOffer('audit');
const serviceLd = buildService({
  name: title,
  description,
  url: `${SITE.url}/audit-ia-pme`,
  serviceType: data.seo?.serviceType ?? 'Audit IA / Diagnostic IA',
  // Prix ferme (0 €) lu dans la source de prix ; l'offre pointe la page de prise de rendez-vous.
  offers: buildOffer({
    name: auditOffer.name,
    price: auditOffer.pricing.price,
    priceCurrency: 'EUR',
    url: `${SITE.url}${AUDIT_BOOKING_HREF}`,
    nested: true,
  }),
});
const pageLd = [serviceLd];
---

<Base title={title} description={description} jsonLd={pageLd} noindex={data.seo?.noindex}>
  <MastheadBar
    lang={lang}
    items={[
      { label: lang === 'fr' ? 'Accueil' : 'Home', href: lang === 'fr' ? '/' : '/en' },
      { label: lang === 'fr' ? 'Audit IA pour PME' : 'AI audit for SMBs' },
    ]}
  />
  <AuditHero />
  <AuditBody />
  <ResourceLinks exclude={['audit']} title="Pour préparer l'audit, seul et sans inscription" />
  <SectionsRenderer sections={data.sections!} lang={lang} />
</Base>
