---
export const prerender = true;

// Page SSG · /audit-ia-pme · la page qui PRÉSENTE l'audit (refonte 4 octobre 2026).
// Son CTA mène à /contact?offer=audit-ia-pme&intent=audit (prise de rendez-vous).
//
// Composition : organisms dédiés (src/components/ui/organisms/audit/*, contenu dans
// src/data/audit-ia-pme.ts) + sections catalogue pour la FAQ et la bande finale
// (entrée `audits/audit-ia-pme`, rendues par SectionsRenderer : la FAQ émet le FAQPage
// JSON-LD, source canonique). Aucun markup inline dans cette page.
// La partie « site web et logiciel » (`auditWebSection`, ancre AUDIT_WEB_ANCHOR) est une
// section catalogue construite dans src/data/audit-ia-pme.ts, insérée avant la preuve.
// Fonds alternés : hero paper, déroulé paper-2, livrable paper, pour qui paper-2, après paper,
// ressources paper-2, « ce qu'on examine » paper, site web et logiciel paper-2, réalisations
// paper, auteur (eeat-panel media) ink, FAQ paper, bande ink.

import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionsRenderer from '../components/sections/SectionsRenderer.astro';
import MastheadBar from '../components/sections/MastheadBar.astro';
import AuditHero from '../components/ui/organisms/audit/AuditHero.astro';
import AuditBody from '../components/ui/organisms/audit/AuditBody.astro';
import ResourceLinks from '../components/ui/organisms/conversion/ResourceLinks.astro';
import { buildService, buildOffer } from '../lib/seo/schema-builder';
import { engagementOffer } from '../data/pricing';
import { SITE } from '../site.config';
import { AUDIT_BOOKING_HREF, AUDIT_PROMISE } from '../data/conversion';
import { auditWebSection } from '../data/audit-ia-pme';

const entry = await getEntry('audits', 'audit-ia-pme');
if (!entry) {
  throw new Error("audit-ia-pme : entrée `audits/audit-ia-pme` introuvable.");
}
const data = entry.data;

const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fr';
const title = lang === 'en' ? data.title_en : data.title_fr;
// Titre SEO distinct du H1 quand `seoTitle_*` est renseigné (sinon titre de la page).
const seoTitle = (lang === 'en' ? data.seoTitle_en : data.seoTitle_fr) ?? title;
// Méta description : source unique AUDIT_PROMISE.meta (le JSON en garde une copie identique).
const description = AUDIT_PROMISE.meta[lang];

if (!Array.isArray(data.sections) || data.sections.length === 0) {
  throw new Error("audit-ia-pme : `sections` requis (FAQ + bande finale).");
}
// La partie site web et logiciel se place juste avant la FAQ (après « ce qu'on examine »).
const sections = [...(data.sections ?? [])];
// Avant la preuve (réalisations, auteur) si elle existe, sinon avant la FAQ : la partie
// « site web et logiciel » complète la description de l'audit, la preuve vient après.
const proofTypes = ['case-card-grid', 'eeat-panel', 'faq-accordion'];
const faqIndex = sections.findIndex((s) => proofTypes.includes(s.type));
sections.splice(faqIndex < 0 ? sections.length : faqIndex, 0, auditWebSection);

// JSON-LD métier · Service avec son offre (prestation gratuite). FAQPage émis par `faq-accordion`.
const auditOffer = engagementOffer('audit');
const serviceLd = buildService({
  name: title,
  description,
  url: `${SITE.url}/audit-ia-pme`,
  serviceType: data.seo?.serviceType ?? 'Audit IA',
  // Prix ferme (0 €) lu dans la source de prix ; l'offre pointe la page de prise de rendez-vous.
  offers: buildOffer({
    name: auditOffer.name,
    price: auditOffer.pricing.price,
    priceCurrency: 'EUR',
    url: `${SITE.url}${AUDIT_BOOKING_HREF}`,
    nested: true,
  }),
});
const pageLd = [serviceLd];
---

<Base title={seoTitle} description={description} jsonLd={pageLd} noindex={data.seo?.noindex}>
  <MastheadBar
    lang={lang}
    items={[
      { label: lang === 'fr' ? 'Accueil' : 'Home', href: lang === 'fr' ? '/' : '/en' },
      { label: lang === 'fr' ? 'Audit IA pour PME' : 'AI audit for SMBs' },
    ]}
  />
  <AuditHero />
  <AuditBody />
  <ResourceLinks exclude={['audit']} title="Pour préparer l'audit, seul et sans inscription" background="paper-2" />
  <SectionsRenderer sections={sections} lang={lang} />
</Base>
