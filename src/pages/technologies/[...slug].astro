---
export const prerender = true;

// Page SSG · /technologies/[slug] · rendu 100 % composable (registry).
// R6 (2026-06-10) · fallback TechnologiesDetailTemplate supprimé (voie morte,
// 2/2 technologies composables) ; MDX sans `sections:` = erreur de build volontaire.

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import Breadcrumb from '../../components/ui/molecules/Breadcrumb.astro';
import { buildService } from '../../lib/seo/schema-builder';

export async function getStaticPaths() {
  const entries = await getCollection('technologies');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const data = entry.data;
const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fr';

const layerLabel = lang === 'fr' ? data.title_fr : data.title_en;
const title = lang === 'fr' ? data.title_fr : data.title_en;
const description = lang === 'fr' ? data.description_fr : data.description_en;

if (!Array.isArray(data.sections) || data.sections.length === 0) {
  throw new Error(`technologies/${entry.id} : frontmatter \`sections:\` requis (voie template legacy éteinte en R6)`);
}

const serviceLd = buildService({ name: title, description });
---
<Base {title} {description} jsonLd={[serviceLd]}>
  <Breadcrumb
    lang={lang}
    items={[
      { label: lang === 'fr' ? 'Accueil' : 'Home', href: lang === 'fr' ? '/' : '/en' },
      { label: 'Technologies', href: lang === 'fr' ? '/technologies' : '/en/technologies' },
      { label: layerLabel },
    ]}
  />
  <SectionsRenderer sections={data.sections!} lang={lang} />
</Base>
