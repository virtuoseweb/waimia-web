---
// Page · /manifesto · 100 % composable (lot 6, directive Simon « pas de bespoke »).
// Rendu entierement via sections cataloguees, importees directement (pattern home index.astro).
// Données de sections extraites en module `src/data/manifesto-sections.ts` (vague V2, fiche 0027 D6) :
// la page reste le SHELL (mapping data→composants) + la dérivation de la collection `cases`.
// Anti-orphelin : 0 markup inline, chaque bloc = un composant catalogue (5 touchpoints).
export const prerender = true;

import Base from '../layouts/Base.astro';
import MastheadBar from '../components/sections/MastheadBar.astro';
import HeroManifesto from '../sections/hero-manifesto/Component.astro';
import MarqueeBand from '../sections/marquee-band/Component.astro';
import ManifestoAct from '../sections/manifesto-act/Component.astro';
import AsymmetricServices from '../sections/asymmetric-services/Component.astro';
import ManifestoStatement from '../sections/manifesto-statement/Component.astro';
import FooterCtaBand from '../sections/footer-cta-band/Component.astro';
import EditorialCaseGrid from '../sections/editorial-case-grid/Component.astro';
import EditorialWriteFeed from '../sections/editorial-write-feed/Component.astro';
import CtaFinal from '../components/sections/CtaFinal.astro';
import { getCollection } from 'astro:content';
import { langFromPath, localizeHref as flh } from '../lib/i18n';
import { buildArticle } from '../lib/seo/schema-builder';
import type { EditorialCaseGridData } from '@waimia/ds-kernel/sections/editorial-case-grid/schema';
import { manifestoSections } from '../data/manifesto-sections';
import { SITE } from '../site.config';

const lang = langFromPath(Astro.url.pathname);

// Cas clients · source UNIQUE = collection `cases`, featured d'abord.
const manifestoCases = (await getCollection('cases', ({ data }) => !data.ndaProtected && data.kind === 'client'))
  .sort((a, b) => Number(b.data.featured ?? false) - Number(a.data.featured ?? false))
  .slice(0, 4);

const articleLd = buildArticle({
  headline: lang === 'fr' ? 'Manifeste Waimia' : 'Waimia Manifesto',
  description: "L'IA en production, pas en démonstration : des automatisations et des agents IA mis en production, mesurés, puis remis au client avec le code.",
  datePublished: '2026-01-01',
  author: { '@type': 'Organization', name: SITE.name },
});

// Données de sections (vague V2) → `src/data/manifesto-sections.ts`. Shell inchangé.
const { heroData, marqueeData, acteIData, acteIIData, accentData, acteIIIData, acteIVBase, writingData, acteVCta } = manifestoSections(lang);

// ── ACTE IV · items DÉRIVÉS de la collection `cases` (source unique runtime) ; base = module.
const acteIVData = {
  ...acteIVBase,
  items: manifestoCases.map((c) => ({
    client: c.data.client,
    sector_fr: c.data.sector_fr,
    sector_en: c.data.sector_en,
    stack: c.data.stack.join(' · '),
    impact_fr: c.data.impact_fr,
    impact_en: c.data.impact_en,
    duration: c.data.duration,
    href: flh(`/cas-clients/${c.data.slug ?? c.id}`, lang),
  })),
} satisfies EditorialCaseGridData;
---
<Base
  title={lang === 'fr' ? "Manifeste Waimia · L'IA en production, pas en démonstration" : 'Waimia · Manifesto · Build revenue, not demos'}
  description={lang === 'fr'
    ? "Le manifeste du studio Waimia : automatisations et agents IA mis en production, mesurés, puis remis au client avec le code. Ce qu'on fait, ce qu'on refuse."
    : 'Waimia Manifesto: Build revenue, not demos. AI systems shipped, measured, documented.'}
  jsonLd={articleLd}
>
  <MastheadBar items={[{label: lang === 'fr' ? 'Accueil' : 'Home', href: lang === 'fr' ? '/' : '/en'}, {label: lang === 'fr' ? 'Manifeste' : 'Manifesto'}]} lang={lang} />

  <HeroManifesto data={heroData} lang={lang} />
  <MarqueeBand data={marqueeData} lang={lang} />
  <ManifestoAct data={acteIData} lang={lang} />
  <AsymmetricServices data={acteIIData} lang={lang} />
  <ManifestoStatement data={accentData} lang={lang} />
  <FooterCtaBand data={acteIIIData} lang={lang} />
  <EditorialCaseGrid data={acteIVData} lang={lang} />
  <EditorialWriteFeed data={writingData} lang={lang} />
  <CtaFinal data={acteVCta} lang={lang} />
</Base>
