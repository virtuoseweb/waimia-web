---
// Page · /sources-methodologie · Sources et méthodologie (transparence E-E-A-T / GEO)
export const prerender = true;

// Composé de · TrustLegalTemplate (masthead + TOC sticky + sections empilées + CTA band)
// Pattern identique à /mentions-legales (page de confiance statique, FR monolingue
// en prod via le court-circuit hasBilingualMirror ; contenu bilingue inline via <Bi>).
//
// Raison d'être : cette page est liée depuis 2 templates live (chips de provenance) :
//  - CaseStudyTemplate.astro : chip « Cas client · Waimia » / « Analyse · sources tierces »
//  - SecteurHubTemplate.astro : chip « données marché » (famille B)
// Elle définit les 2 familles de preuve et recense les données tierces réellement
// citées sur le site. Source de vérité du contenu : docs/strategy/03 §5 et §6.
//
// Template-as-data (V5, 2026-07-19) : contenu en JSON (src/content/legal/sources-methodologie.json).
// Sections pré-rendues (headlineHtml/ledeHtml/sectionsHtml) capturées depuis le rendu réel,
// même idiome que `body_sections[].html_fr` (cases/secteurs), injectées via `set:html`.

import { getEntry } from 'astro:content';
import TrustLegalTemplate from '../components/templates/TrustLegalTemplate.astro';
import Callout from '../components/editorial/Callout.astro';

const entry = await getEntry('legal', 'sources-methodologie');
if (!entry) throw new Error('Collection "legal" · entrée "sources-methodologie" introuvable.');
const d = entry.data;
---
<TrustLegalTemplate
  title={d.title!}
  description={d.description!}
  kickerFr={d.kickerFr!}
  kickerEn={d.kickerEn!}
  ctaSubjectFr={d.ctaSubjectFr!}
  ctaSubjectEn={d.ctaSubjectEn!}
  revisedAt={d.revisedAt!}
  version={d.version}
  sections={d.toc!}
  legalFooterFr={d.legalFooterFr}
  legalFooterEn={d.legalFooterEn}
>
  <Fragment slot="headline" set:html={d.headlineHtml} />
  <Fragment slot="lede" set:html={d.ledeHtml} />
  <Fragment slot="sections" set:html={d.sectionsHtml} />
</TrustLegalTemplate>

{/* Instance masquée : force le bundling du CSS scopé de Callout (cf commentaire cgv.astro),
    y compris le footer `cite` (cette page en compte le plus, variant="note" cite="..."). */}
<div style="display:none" aria-hidden="true">
  <Callout variant="note" cite="_"><p>_</p></Callout>
</div>

<style>
  /* Ancres stables « chiffre cité → sa source » : deep-link depuis les surfaces qui
     affichent une stat (home ProofBar, pages secteurs, cas). Offset anti-masthead sticky.
     :global() (V5, 2026-07-19) : le contenu `.source-anchor` vit désormais en JSON, injecté
     via `set:html` (sectionsHtml), donc hors de la portée du scoping CSS `data-astro-cid`
     de CE fichier ; le sélecteur doit rester global pour continuer à matcher. */
  :global(.source-anchor) { scroll-margin-top: 100px; }
</style>
