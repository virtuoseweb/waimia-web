---
// Page · /technologies · Stack & technologies Waimia
export const prerender = true;

import UtilityTemplate from '../components/templates/UtilityTemplate.astro';
import Kicker from '../components/ui/atoms/Kicker.astro';
import SpecBar from '../components/sections/SpecBar.astro';
import MetricCalloutBand from '../components/sections/MetricCalloutBand.astro';

// ── Couches de la stack · idiome « livrables numérotés » (cf /agence/about) ──
const layers = [
  {
    n: '01',
    label: 'IA & agents',
    intro: 'Claude, par Anthropic, comme moteur de raisonnement. Un modèle par tâche, pas un seul fourre-tout.',
    items: [
      "Claude Opus pour la conception et l'arbitrage.",
      'Claude Sonnet pour le travail cadré et borné.',
      'Claude Haiku pour le mécanique rapide et les vérifications.',
      'Orchestration multi-agents : on décompose, on délègue, on recompose.',
    ],
  },
  {
    n: '02',
    label: 'Sites & front',
    intro: 'Un front découplé, statique et rapide. Pas de serveur applicatif à chaque visite.',
    items: [
      'Astro en génération statique (SSG), PageSpeed visé 100/100.',
      "React en îlots, seulement là où l'interactivité le justifie.",
      'Tailwind pour un design system cohérent, sans CSS dupliqué.',
      'Déploiement Vercel : previews par branche, mise en ligne continue.',
    ],
  },
  {
    n: '03',
    label: 'CMS & contenu',
    intro: 'Le bon CMS dépend de votre cas, pas d\'une mode. On tranche au cadrage.',
    items: [
      'Git-based par défaut pour une PME : TinaCMS, Keystatic, Decap. Édition versionnée, zéro base de données, réversible.',
      'Headless classique pour les gros volumes : Contentful, Sanity, Strapi, Prismic.',
      'Standards ouverts : code, contenu et docs transférés à la livraison.',
    ],
  },
  {
    n: '04',
    label: 'Data, CRM & outils métier',
    intro: "On câble les agents dans vos outils existants. Pas de migration : on connecte ce qui marche déjà.",
    items: [
      'Productivité : Excel, Outlook, et votre ERP, sans tout remplacer.',
      'CRM : HubSpot et vos bases existantes, instrumentés proprement.',
      'Prospection sortante : Lemlist, Instantly, Apollo, Pharow.',
      'Email : MailerLite pour l\'audience, Resend pour le transactionnel.',
    ],
  },
  {
    n: '05',
    label: 'Analytics & SEO',
    intro: "On mesure avant et après. Si ça ne mesure rien, ça n'existe pas.",
    items: [
      'Google Analytics 4 pour le comportement et les parcours.',
      'Search Console pour l\'indexation et la performance organique.',
      'Suivi de conversion : chaque action clé est tracée et attribuée.',
    ],
  },
];

// ── Stack en bref · SpecBar (respiration, fond paper-2) ──
const specData = {
  type: 'spec-bar' as const,
  background: 'paper-2' as const,
  kicker_fr: '§ Stack en bref',
  kicker_en: '§ Stack at a glance',
  specs: [
    { label_fr: 'Moteur IA', label_en: 'AI engine', value: 'Claude' },
    { label_fr: 'Front', label_en: 'Front', value: 'Astro SSG' },
    { label_fr: 'PageSpeed visé', label_en: 'Target PageSpeed', value: '100/100' },
    { label_fr: 'Captivité', label_en: 'Lock-in', value: '0' },
  ],
} satisfies import('@waimia/ds-kernel').SectionByType<'spec-bar'>;

// ── Principes de choix · bande INK (contraste, climax avant CTA) ──
const principlesData = {
  type: 'metric-callout-band' as const,
  background: 'ink' as const,
  kicker_fr: '§ Comment on choisit',
  kicker_en: '§ How we choose',
  context_fr: "Aucun outil n'est imposé par dogme. On part de votre métier, de vos outils, de votre budget. Le sur-mesure se justifie quand le clé-en-main atteint ses limites, jamais par défaut.",
  context_en: 'No tool is imposed by dogma. We start from your business, your tools, your budget. Bespoke is justified when turnkey hits its limits, never by default.',
  metrics: [
    { value: '1', label_fr: 'modèle choisi par tâche, pas un fourre-tout', label_en: 'model chosen per task, not a catch-all' },
    { value: '0', label_fr: 'captivité : standards ouverts, stack transférée', label_en: 'lock-in: open standards, stack handed over' },
    { value: '100%', label_fr: 'câblé dans vos outils, sans migration forcée', label_en: 'wired into your tools, no forced migration' },
  ],
} satisfies import('@waimia/ds-kernel').SectionByType<'metric-callout-band'>;

const techLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  name: 'Stack & technologies · Waimia',
  description: "La stack Waimia par couches : Claude pour l'IA, Astro pour le front, CMS headless pour le contenu, intégrations métier dans vos outils existants, analytics et SEO.",
  url: `https://waimia.com${Astro.url.pathname}`,
  author: { '@type': 'Organization', '@id': 'https://waimia.com/#organization' },
};
---
<UtilityTemplate
  title="Stack & technologies · Waimia"
  description="La stack Waimia, couche par couche. Claude pour l'IA, Astro pour le front, CMS headless pour le contenu, intégrations dans vos outils. Zéro captivité."
  jsonLd={techLd}
  kicker="§ Stack & technologies"
  align="left"
  showCta={true}
  headlineFr="La <i>stack</i>, couche par couche."
  headlineEn="The <i>stack</i>, layer by layer."
  ledeFr="Pas de catalogue de logos. Des choix tenus : un modèle par tâche, un front qui tient la charge, vos outils gardés. Et zéro captivité au bout."
  ledeEn="No logo wall. Choices we stand by: one model per task, a front that holds up, your tools kept. And zero lock-in at the end."
>
  <Fragment slot="body">

    {/* ── STACK EN BREF · respiration paper-2 ── */}
    <div class="tech-spec reveal">
      <SpecBar data={specData} lang="fr" />
    </div>

    {/* ── COUCHES · idiome livrables numérotés ── */}
    <h2 class="sr-only">Les cinq couches de la stack</h2>
    <div class="tech-layers reveal-stagger">
      {layers.map((layer) => (
        <article class="tech-layer">
          <span class="tech-layer-n">{layer.n}</span>
          <div class="tech-layer-main">
            <h3 class="tech-layer-title">{layer.label}</h3>
            <p class="tech-layer-intro">{layer.intro}</p>
            <ul class="tech-layer-list">
              {layer.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>

    {/* ── PRINCIPES DE CHOIX · bande INK ── */}
    <div class="tech-principles reveal">
      <MetricCalloutBand data={principlesData} lang="fr" />
    </div>

    {/* ── ANCRAGE ANTHROPIC ── */}
    <div class="tech-anchor reveal">
      <Kicker class="tech-anchor-kicker">§ Anthropic-first</Kicker>
      <h2 class="tech-anchor-h2">Un parti pris assumé sur le moteur.</h2>
      <p class="tech-anchor-body">
        On a construit la méthode autour de Claude parce que c'est, pour notre usage, le meilleur compromis raisonnement, fiabilité et sécurité. Le reste de la stack reste ouvert : front, CMS et intégrations se choisissent au cas par cas, selon votre métier.
      </p>
      <p class="tech-anchor-body">
        Le principe ne change pas : on ne vous enferme nulle part. Vous gardez le code, le contenu et la documentation. Vous pouvez reprendre la stack en interne, ou la confier à un autre prestataire.
      </p>
    </div>

    {/* CTA final canonique = `CtaFinal` rendu par UtilityTemplate (showCta). */}

  </Fragment>
</UtilityTemplate>

<style>
  /* ── Stack en bref · spec-bar (breakout pleine largeur du padding body) ── */
  .tech-spec,
  .tech-principles {
    margin-inline: calc(-1 * var(--space-6));
  }
  .tech-spec { margin-block: var(--space-8) var(--space-10); }
  .tech-principles { margin-block: var(--space-11) var(--space-10); }

  /* ── Couches · rangs numérotés serif accent (idiome about livrables) ── */
  .tech-layers {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 920px;
  }
  .tech-layer {
    display: grid;
    grid-template-columns: minmax(56px, auto) 1fr;
    column-gap: var(--space-7);
    align-items: start;
    padding: var(--space-8) 0;
    border-top: 1px solid var(--hairline);
  }
  .tech-layer:last-child { border-bottom: 1px solid var(--hairline); }
  .tech-layer-n {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-h2);
    line-height: 0.9;
    letter-spacing: var(--tracking-display);
    color: var(--accent-text);
  }
  .tech-layer-title {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: var(--fw-medium);
    line-height: 1.2;
    color: var(--ink);
    margin: 0 0 var(--space-3);
  }
  .tech-layer-intro {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    line-height: var(--leading-prose);
    color: var(--ink-2);
    margin: 0 0 var(--space-5);
    max-width: 60ch;
  }
  .tech-layer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .tech-layer-list li {
    position: relative;
    padding-left: var(--space-6);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--muted);
    max-width: 64ch;
  }
  .tech-layer-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    color: var(--accent-text);
    font-size: var(--text-small);
  }
  @media (max-width: 700px) {
    .tech-layer {
      grid-template-columns: 1fr;
      row-gap: var(--space-4);
      padding: var(--space-7) 0;
    }
    .tech-layer-n { font-size: var(--text-h3); }
  }

  /* ── Ancrage Anthropic · encart accent (idiome methode .meth-os) ── */
  .tech-anchor {
    background: var(--paper-2);
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--accent);
    padding: var(--space-8);
    margin-bottom: var(--space-12);
    max-width: 800px;
  }
  :global(.tech-anchor-kicker) { display: block; margin-bottom: 20px; }
  .tech-anchor-h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.022em;
    line-height: 1.05;
    margin: 0 0 var(--space-5);
    text-wrap: balance;
  }
  .tech-anchor-h2 :global(i) { font-style: italic; color: var(--accent-text); }
  .tech-anchor-body {
    font-family: var(--font-sans);
    color: var(--muted);
    font-size: var(--text-body);
    line-height: var(--leading-prose);
    margin: 0 0 var(--space-3);
    max-width: 640px;
  }
  .tech-anchor-body:last-child { margin-bottom: 0; }

  @media (max-width: 700px) {
    .tech-anchor { padding-inline: var(--space-5); }
  }
</style>
