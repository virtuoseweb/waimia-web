---
// Page · /technologies · Stack & technologies Waimia
// 100 % composable, sections cataloguees full-bleed (pattern manifesto.astro) : Base + Header/Footer +
// sections importees directement. Données de sections extraites en module
// `src/data/technologies-sections.ts` (vague V3, fiche 0027 D6) ; la page reste le SHELL.
// Anti-orphelin : 0 markup de section inline (les 2 ex-blocs bespoke sont des composants catalogues).
export const prerender = true;

import Base from '../layouts/Base.astro';
import MastheadBar from '../components/sections/MastheadBar.astro';
import HeroCentered from '../components/sections/HeroCentered.astro';
import SpecBar from '../components/sections/SpecBar.astro';
import NumberedLayerList from '../sections/numbered-layer-list/Component.astro';
import MetricCalloutBand from '../components/sections/MetricCalloutBand.astro';
import BrandedCallout from '../sections/branded-callout/Component.astro';
import CtaFinal from '../components/sections/CtaFinal.astro';
import { langFromPath } from '../lib/i18n';
import { SITE } from '../site.config';
import { technologiesSections } from '../data/technologies-sections';

const lang = langFromPath(Astro.url.pathname);

// Données de sections (vague V3) → `src/data/technologies-sections.ts`. Shell inchangé.
const { heroData, crumbs, layersData, specData, principlesData, anchorData, ctaData } = technologiesSections(lang);

const techLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  name: 'Stack & technologies · Waimia',
  description: "La stack Waimia par couches : Claude pour l'IA, Astro pour le front, CMS headless pour le contenu, intégrations métier dans vos outils existants, analytics et SEO.",
  url: `${SITE.url}${Astro.url.pathname}`,
  author: { '@type': 'Organization', '@id': `${SITE.url}/#organization` },
};
---
<Base
  title="Stack & technologies · Waimia"
  description="La stack Waimia, couche par couche. Claude pour l'IA, Astro pour le front, CMS headless pour le contenu, intégrations dans vos outils. Zéro captivité."
  jsonLd={techLd}
>
  <MastheadBar lang={lang} items={crumbs} />

  <HeroCentered data={heroData} lang={lang} wrapMaxWidth="var(--wrap-wide)" reveal={true} />

  <SpecBar data={specData} lang={lang} />

  <NumberedLayerList data={layersData} lang={lang} />

  <MetricCalloutBand data={principlesData} lang={lang} />

  <BrandedCallout data={anchorData} lang={lang} />

  <CtaFinal data={ctaData} lang={lang} />
</Base>
