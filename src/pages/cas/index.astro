---
// Page · /cas · Hub cas clients Waimia
export const prerender = true;

// Route principale de la nav — liste des 4 cas business.

import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { langFromPath } from '../../lib/i18n';
import type { SectionByType } from '../../schemas/sections';
import HeroCentered from '../../components/sections/HeroCentered.astro';
import imageManifest from '../../data/image-manifest.json';

const lang = langFromPath(Astro.url.pathname);
const transitionIdFromHref = (href: string) =>
  href
    .replace(/^\/(?:en\/)?/, '')
    .replace(/\/$/, '')
    .replace(/[^a-z0-9]+/gi, '-')
    .replace(/^-|-$/g, '') || 'home';

const caseEntries = (await getCollection('cases'))
  .filter((e) => e.data.card)
  .sort((a, b) => (a.data.card!.order) - (b.data.card!.order));

// Alt de la cover = source unique image-manifest.json (slug image = `cas-<slug cas>`)
const coverAlt = (slug: string) => {
  const entry = imageManifest.images.find((i) => i.slug === `cas-${slug}`);
  return entry ? (lang === 'fr' ? entry.alt.fr : entry.alt.en) : '';
};

const featuredCases = caseEntries.map((e) => ({
  slug: e.data.slug ?? e.id,
  caseNum: String(e.data.card!.order).padStart(2, '0'),
  sector: lang === 'fr' ? e.data.card!.sector_fr : e.data.card!.sector_en,
  title: lang === 'fr' ? e.data.card!.title_fr : e.data.card!.title_en,
  headline: lang === 'fr' ? e.data.card!.headline_fr : e.data.card!.headline_en,
  duration: lang === 'fr' ? e.data.card!.duration_fr : e.data.card!.duration_en,
  cover: e.data.heroImage,
  coverAlt: coverAlt(e.data.slug ?? e.id),
}));

const [featured, ...rest] = featuredCases;

const mastheadData = {
  type: 'hero-hub-masthead' as const,
  variant: 'hub' as const,
  decoration: false,
  align: 'left' as const,
  kicker_fr: '§ Cas clients · ROI mesurés, pas promis',
  kicker_en: '§ Case studies · Measured ROI, not promised',
  h1_fr: '<span>Pas de <i>marketing</i>.</span><br/><span>Des chiffres.</span>',
  h1_en: '<span>No <i>marketing</i>.</span><br/><span>Numbers.</span>',
  lede_fr: "Nos premières études de cas sont en cours de rédaction. Nous ne publions un cas qu'une fois le résultat mesuré et l'accord du client obtenu. Pas de témoignage mis en scène.",
  lede_en: 'Our first case studies are being written. We only publish a case once the result is measured and the client has agreed. No staged testimonials.',
  transition_id: transitionIdFromHref(Astro.url.pathname),
} satisfies SectionByType<'hero-hub-masthead'>;
---
<Base
  title={lang === 'fr' ? "Cas clients · pipelines reconnectés, opérations fluidifiées · Waimia" : "Case studies · pipelines reconnected, operations streamlined · Waimia"}
  description={lang === 'fr' ? "Pas de marketing. Des chiffres, des problèmes, ce qu'on a câblé. Ce qui a tenu." : "No marketing. Numbers, problems, what we shipped. What held."}
>
  <HeroCentered data={mastheadData} lang={lang} />

  {featured ? (
    <section class="cas-grid-outer wrap-wide">
      <div class="cas-grid reveal-stagger">
        <a href={`/cas/${featured.slug}`} class="cas-card cas-card--featured" transition:name={`card-${transitionIdFromHref(`/cas/${featured.slug}`)}`}>
          <div class="cas-card-kicker">§ Case {featured.caseNum} · {featured.sector} · {featured.duration}</div>
          <h2 class="cas-card-title">{featured.title}</h2>
          <p class="cas-card-headline">{featured.headline}</p>
          {featured.cover && (
            <img
              class="cas-card-img"
              src={featured.cover}
              alt={featured.coverAlt}
              width="1536"
              height="1024"
              loading="lazy"
              decoding="async"
            />
          )}
          <span class="cas-card-cta">{lang === 'fr' ? 'Lire le cas →' : 'Read case →'}</span>
        </a>
        <div class="cas-secondary">
          {rest.map((c) => (
            <a href={`/cas/${c.slug}`} class="cas-card cas-card--row" transition:name={`card-${transitionIdFromHref(`/cas/${c.slug}`)}`}>
              <span class="cas-card-index" aria-hidden="true">{c.caseNum}</span>
              <div class="cas-card-body">
                <div class="cas-card-kicker">§ {c.sector} · {c.duration}</div>
                <h2 class="cas-card-title">{c.title}</h2>
                <p class="cas-card-headline">{c.headline}</p>
                <span class="cas-card-cta">{lang === 'fr' ? 'Lire le cas →' : 'Read case →'}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="cas-grid-outer wrap-wide">
      <div class="cas-empty reveal">
        <div class="cas-empty-kicker">§ {lang === 'fr' ? 'Études de cas à venir' : 'Case studies coming soon'}</div>
        <p class="cas-empty-body">
          {lang === 'fr'
            ? "Nous publions un cas uniquement après mesure du résultat et accord du client. Les premiers dossiers arrivent. En attendant, parlons de votre projet : nous montrons concrètement comment nous travaillons."
            : 'We only publish a case after the result is measured and the client has agreed. The first files are coming. In the meantime, let us talk about your project: we show exactly how we work.'}
        </p>
      </div>
    </section>
  )}

  <section class="cas-cta reveal">
    <div class="wrap-wide cas-cta-inner">
      <span class="eyebrow">§ {lang === 'fr' ? 'Câbler le vôtre' : 'Wire yours'}</span>
      <h2 class="cas-cta-h">
        {lang === 'fr'
          ? <><em>{`Le mardi on câble.`}</em>{` Le vendredi on mesure.`}</>
          : <><em>{`Tuesday we wire.`}</em>{` Friday we measure.`}</>
        }
      </h2>
      <a href="/contact" class="cas-cta-btn">
        {lang === 'fr' ? 'Récupérer mon pipeline →' : 'Recover my pipeline →'}
      </a>
    </div>
  </section>
</Base>

<style>
  .cas-grid-outer { margin: 0 auto; padding: 0 var(--space-6); }
  .cas-empty {
    margin: var(--space-7) 0 var(--space-10);
    padding: clamp(40px, 6vw, 80px) clamp(24px, 4vw, 56px);
    border: 1px solid var(--hairline);
    background: var(--paper-2);
    max-width: 820px;
  }
  .cas-empty-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    color: var(--accent);
    margin-bottom: var(--space-3);
  }
  .cas-empty-body {
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
    text-wrap: pretty;
  }
  .cas-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    margin: var(--space-7) 0 var(--space-10);
  }
  .cas-secondary {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--hairline);
  }
  .cas-card {
    display: flex;
    flex-direction: column;
    padding: 36px var(--space-6) var(--space-6);
    background: var(--paper);
    border-top: 1px solid transparent;
    text-decoration: none;
    color: inherit;
    transition:
      background 180ms var(--ease),
      border-top-color var(--dur-trim) var(--ease),
      box-shadow var(--dur-trim) var(--ease),
      transform var(--dur-trim) var(--ease);
    gap: 10px;
    height: 100%;
    box-sizing: border-box;
  }
  .cas-card:hover {
    background: var(--paper-2);
    border-top-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 12px 36px rgba(var(--ink-rgb), 0.06);
  }
  .cas-card--featured {
    padding: 56px var(--space-8) var(--space-8);
  }
  .cas-card--featured .cas-card-title {
    font-size: clamp(28px, 4vw, 52px);
    margin-top: var(--space-3);
  }
  .cas-card--featured .cas-card-headline {
    font-size: clamp(14px, 1.6vw, 18px);
    max-width: 480px;
    margin-top: var(--space-2);
  }
  .cas-card--row {
    flex-direction: row;
    align-items: flex-start;
    gap: var(--space-5);
  }
  .cas-card-index {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: clamp(40px, 5vw, 64px);
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--muted);
    flex: none;
    font-feature-settings: 'lnum' 1, 'tnum' 1;
    transition: color var(--dur-trim) var(--ease);
  }
  .cas-card:hover .cas-card-index { color: var(--accent); }
  .cas-card-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
    min-width: 0;
    border-left: 1px solid var(--hairline);
    padding-left: var(--space-5);
  }
  .cas-card-body .cas-card-headline { flex: 0 1 auto; }
  .cas-card-kicker {
    font-family: var(--font-mono, monospace);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cas-card-title {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.4vw, 32px);
    font-weight: var(--fw-regular);
    letter-spacing: -0.015em;
    line-height: 1.05;
    margin: var(--space-1) 0 0;
    text-wrap: balance;
    transition: transform var(--dur-trim) var(--ease);
  }
  .cas-card-headline {
    font-size: clamp(13px, 1.2vw, 15px);
    color: var(--muted);
    margin: 0;
    line-height: var(--leading-body);
    flex: 1;
    transition: transform var(--dur-trim) var(--ease);
  }
  .cas-card-img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--hairline);
    margin-top: var(--space-4);
  }
  .cas-card-cta {
    font-size: var(--text-ui);
    color: var(--accent);
    font-family: var(--font-mono, monospace);
    letter-spacing: 0.04em;
    margin-top: var(--space-4);
    transition: transform var(--dur-trim) var(--ease);
  }
  .cas-card:hover .cas-card-title,
  .cas-card:hover .cas-card-headline,
  .cas-card:hover .cas-card-cta {
    transform: translateX(1px);
  }

  .cas-cta {
    padding: clamp(56px, 7vw, 80px) var(--space-6);
    background: var(--ink);
    border-top: 1px solid var(--hairline);
  }
  .cas-cta-inner { max-width: 760px; }
  .eyebrow {
    display: block;
    font-family: var(--font-mono, monospace);
    font-size: var(--text-eyebrow);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--accent);
    margin-bottom: var(--space-5);
  }
  .cas-cta-h {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 72px);
    line-height: 1.0;
    letter-spacing: var(--tracking-display);
    font-weight: var(--fw-regular);
    color: var(--paper);
    text-wrap: balance;
    margin: 0 0 var(--space-7);
  }
  .cas-cta-h em { font-style: italic; color: var(--accent); }
  .cas-cta-btn {
    display: inline-block;
    font-family: var(--font-mono, monospace);
    font-size: var(--text-ui);
    letter-spacing: 0.06em;
    padding: 14px 28px;
    background: var(--accent);
    color: var(--paper);
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .cas-cta-btn:hover { opacity: 0.85; }

  @media (max-width: 800px) {
    .cas-grid { grid-template-columns: 1fr; }
    .cas-card--featured { padding: 36px 28px 28px; }
    .cas-card--row { gap: var(--space-4); }
    .cas-card-body { padding-left: var(--space-4); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cas-card,
    .cas-card-title,
    .cas-card-headline,
    .cas-card-cta,
    .cas-card-index {
      transition: none !important;
      transform: none !important;
      box-shadow: none !important;
    }
  }
</style>
