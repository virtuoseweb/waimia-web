---
// Page · /contact · prise de rendez-vous (audit IA, 45 min) + formulaire de demande.
//
// Décision Simon (4 octobre 2026) : le rendez-vous se prend ICI. Tous les boutons
// « Réserver un audit » du site pointent vers /contact#offer=audit-ia-pme&intent=audit.
// La lecture des paramètres d'URL et l'ordre des blocs vivent dans l'organism
// ContactConversion (source unique du markup, règle anti-orphelin).
export const prerender = true;

import Base from '../layouts/Base.astro';
import MastheadBar from '../components/sections/MastheadBar.astro';
import ContactConversion from '../components/ui/organisms/conversion/ContactConversion.astro';
import { SITE } from '../site.config';
import { buildContactPage } from '../lib/seo/schema-builder';

// L'entité contactée est l'Organization du site (nœud unique, avec son `contactPoint`).
const contactLd = buildContactPage({ name: 'Contact Waimia', url: `${SITE.url}/contact` });
---
<Base
  title="Contact · Réserver un audit IA gratuit de 45 min · Waimia"
  description="Choisissez un créneau de 45 minutes en visio pour l'audit IA gratuit, ou envoyez votre demande par formulaire. Réponse de Simon Beros sous 24 h ouvrées."
  jsonLd={contactLd}
>
  <MastheadBar
    lang="fr"
    items={[
      { label: 'Accueil', href: '/' },
      { label: 'Contact' },
    ]}
  />
  <ContactConversion />
</Base>
