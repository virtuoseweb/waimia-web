---
export const prerender = true;

// Page SSG · /implantations/[slug] · rendu 100 % composable (registry) ·
// mirror de ressources/diagnostics/[...slug].astro. MDX sans `sections:` = erreur de build (anti-orphelin).
// Profondeur 2 niveaux (implantations/) → imports en `../../`.

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import MastheadBar from '../../components/sections/MastheadBar.astro';
import { buildArticle, buildLocalBusiness } from '../../lib/seo/schema-builder';

export async function getStaticPaths() {
  const entries = await getCollection('implantations');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const data = entry.data;

const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fr';
const title = lang === 'en' ? data.title_en : data.title_fr;
const description = lang === 'en' ? data.description_en : data.description_fr;

if (!Array.isArray(data.sections) || data.sections.length === 0) {
  throw new Error(`implantations/${entry.id} : frontmatter \`sections:\` requis (page composable, anti-orphelin)`);
}

// JSON-LD métier · Article (GEO/AIO) + FAQPage depuis faq_fr/faq_en. BreadcrumbList émis par <MastheadBar>.
const canonicalUrl = `https://waimia.com/implantations/${entry.id}`;
const articleLd = buildArticle({
  headline: title,
  description,
  datePublished: new Date(data.publishedAt).toISOString().slice(0, 10),
  dateModified: data.updatedAt ? new Date(data.updatedAt).toISOString().slice(0, 10) : undefined,
  mainEntityOfPage: canonicalUrl,
});
// FAQPage JSON-LD émis une seule fois par la section catalogue `faq-accordion`
// (source canonique, cf docs/audits #56). La page ne le duplique plus ici.
// NAP local (ProfessionalService) : uniquement montpellier (fiche GBP Virtuoseweb réelle).
const localBusinessLd = entry.id === 'montpellier' ? buildLocalBusiness() : null;
const pageLd = [articleLd, ...(localBusinessLd ? [localBusinessLd] : [])];
---

<Base title={title} description={description} jsonLd={pageLd} noindex={data.seo?.noindex}>
  <MastheadBar
    lang={lang}
    items={[
      { label: lang === 'fr' ? 'Accueil' : 'Home', href: lang === 'fr' ? '/' : '/en' },
      { label: lang === 'fr' ? 'Implantations' : 'Locations', href: lang === 'fr' ? '/implantations' : '/en/implantations' },
      { label: title.split(' · ')[0] },
    ]}
  />
  <SectionsRenderer sections={data.sections!} lang={lang} />
</Base>
