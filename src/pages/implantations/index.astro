---
export const prerender = true;

// Page SSG · /implantations · HUB implantations · rendu 100 % composable.
// Indexable depuis l'intégration d'octobre 2026 : trois pages locales réelles (Bordeaux,
// Montpellier, Lyon), hub lié depuis le plan du site et les pages locales.
// Hero court + cartes via section catalogue `related-cards-band` (.min(2)/.max(3)).
// Collection vide → 0 carte → 0 band (pas de crash).
// Profondeur 2 niveaux (implantations/) → imports en `../../`.

import { AUDIT_BOOKING_HREF, AUDIT_BOOKING_LABEL, AUDIT_PAGE_HREF, AUDIT_PAGE_LABEL } from '../../data/conversion';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import MastheadBar from '../../components/sections/MastheadBar.astro';
import type { SectionData, SectionByType } from '@waimia/ds-kernel';

const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fr';
const isFr = lang === 'fr';

type Card = SectionByType<'related-cards-band'>['cards'][number];

const cards: Card[] = (await getCollection('implantations'))
  .sort((a, b) => (a.data.slug ?? a.id).localeCompare(b.data.slug ?? b.id))
  .map((e) => {
    const d = e.data;
    const shortTitle = (full: string) => full.split(' · ')[0].trim();
    return {
      kicker_fr: 'Implantation',
      kicker_en: 'Location',
      title_fr: shortTitle(d.title_fr),
      title_en: shortTitle(d.title_en),
      lead_fr: d.description_fr,
      lead_en: d.description_en,
      href: `/implantations/${d.slug ?? e.id}`,
    };
  });

// Chunker équilibré 2-3 (jamais de singleton) : respecte .min(2)/.max(3) du schéma.
function chunkCards(items: Card[]): Card[][] {
  if (items.length < 2) return [];
  const chunks: Card[][] = [];
  let rest = [...items];
  while (rest.length > 0) {
    if (rest.length === 4) {
      chunks.push(rest.slice(0, 2));
      chunks.push(rest.slice(2, 4));
      rest = [];
    } else if (rest.length <= 3) {
      chunks.push(rest);
      rest = [];
    } else {
      chunks.push(rest.slice(0, 3));
      rest = rest.slice(3);
    }
  }
  return chunks;
}

const hero: SectionByType<'hero-hub-masthead'> = {
  type: 'hero-hub-masthead',
  background: 'paper',
  variant: 'listing',
  decoration: false,
  align: 'left',
  kicker_fr: '§ Implantations · Bordeaux, Montpellier, Lyon, Toulouse, Paris',
  kicker_en: '§ Locations · AI near you',
  h1_fr: '<span>Où le studio</span><br/><span><i>intervient</i>.</span>',
  h1_en: '<span>Our</span><br/><span><i>locations</i>.</span>',
  lede_fr: "Waimia est basé à Bordeaux et travaille à distance pour des PME et ETI partout en France. Sur site à Bordeaux, Montpellier, Lyon, Toulouse et Paris quand la mission le demande.",
  lede_en: 'Where we operate and support SMBs in their AI transformation. Local roots, territorial references.',
};

const ctaFinal: SectionByType<'cta-final'> = {
  type: 'cta-final',
  background: 'ink',
  h2_fr: 'Un projet près de chez vous, ou à distance ?',
  h2_en: 'Want to talk about it?',
  body_fr: 'Un audit de 45 minutes, gratuit et sans engagement : on part de vos processus réels et on repère trois automatisations rentables.',
  body_en: 'A free 45-minute audit, with no commitment: we start from your real processes and spot three profitable automations.',
  cta_primary: {
    label_fr: AUDIT_BOOKING_LABEL.fr,
    label_en: AUDIT_BOOKING_LABEL.en,
    href: AUDIT_BOOKING_HREF,
    variant: 'primary',
  },
  cta_secondary: {
    label_fr: AUDIT_PAGE_LABEL.fr,
    label_en: AUDIT_PAGE_LABEL.en,
    href: AUDIT_PAGE_HREF,
    variant: 'ghost',
  },
};

const cardBands: SectionData[] = chunkCards(cards).map((chunk, i) => ({
  type: 'related-cards-band',
  background: i % 2 === 0 ? 'paper' : 'paper-2',
  ...(i === 0
    ? { kicker_fr: '§ Les implantations', kicker_en: '§ Our locations' }
    : {}),
  cards: chunk,
}) satisfies SectionByType<'related-cards-band'>);

const sections: SectionData[] = [hero, ...cardBands, ctaFinal];
---

<Base
  title={isFr ? 'Agence IA à Bordeaux, Montpellier, Lyon, Toulouse et Paris · Waimia' : 'Locations · Waimia'}
  description={isFr
    ? "Studio IA à Bordeaux : automatisation, agents IA, applications métier pour PME et ETI. À distance ou sur site à Bordeaux, Montpellier, Lyon, Toulouse, Paris."
    : 'AI studio based in Bordeaux: automation, AI agents and business applications for SMEs. Remote or on-site engagements in Bordeaux, Montpellier, Lyon, Toulouse and Paris.'}
>
  <MastheadBar
    lang={lang}
    items={[
      { label: isFr ? 'Accueil' : 'Home', href: isFr ? '/' : '/en' },
      { label: isFr ? 'Implantations' : 'Locations' },
    ]}
  />
  <SectionsRenderer sections={sections} lang={lang} />
</Base>
