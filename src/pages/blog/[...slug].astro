---
// Route · /blog/<slug> · article éditorial · « template-as-data » (décision nuit 0018).
// Le CONTENU vit dans les données (JSON `body_sections[0].html_fr` pré-rendu + `headings`),
// la DÉFINITION du template dans `src/lib/templates/essay.ts` (séquence + mappings). La route
// se limite à : charger le JSON, dériver le contexte cross-entry, appeler `buildEssayProps`,
// rendre `EssayTemplate` (bespoke, PARTAGÉ avec /ressources/outils, inchangé). Le corps FR
// pré-rendu est injecté au slot `body` via set:html (parité stricte avec l'ancien <Content/>).
export const prerender = true;

import { getCollection, type CollectionEntry } from 'astro:content';
import { getLiveCollection } from '../../lib/live-collection';
import EssayTemplate from '../../components/templates/EssayTemplate.astro';
import { computeReadingTime } from '../../lib/seo/reading-time';
import { isLegacyRoutedType } from '../../lib/blog-routing';
import { blogHeroIllustration } from '../../lib/hero-illustrations';
import { buildEssayProps, type EssayContext } from '../../lib/templates/essay';
import { siloLabel } from '../../data/taxonomies';

export async function getStaticPaths() {
  const entries = await getLiveCollection('blog');
  // Les types field-note / veille-ia sont servis par leurs routes héritées
  // (/ressources/field-notes, /ressources/veille-ia) · cf src/lib/blog-routing.ts.
  return entries
    // Pivot IA 2026-10 · `seo.noindex` ne dépublie plus l'article : la page reste générée
    // (liens entrants préservés) et porte un meta robots noindex (prop `noindex` → Base).
    .filter((entry) => !isLegacyRoutedType(entry))
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

type Props = { entry: CollectionEntry<'blog'> };

const slugifyAuthorName = (name: string) =>
  name.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const getAuthorSlug = (author: unknown): string | undefined => {
  if (!author) return undefined;
  if (typeof author === 'string') return author;
  if (typeof author !== 'object') return undefined;

  const ref = author as { id?: unknown; slug?: unknown; url?: unknown; name?: unknown };
  if (typeof ref.id === 'string') return ref.id;
  if (typeof ref.slug === 'string') return ref.slug;
  if (typeof ref.url === 'string') return ref.url.split('/').filter(Boolean).at(-1);
  if (typeof ref.name === 'string') return slugifyAuthorName(ref.name);
  return undefined;
};

const getAuthorLabel = (author: unknown): string | undefined => {
  if (!author) return undefined;
  if (typeof author === 'string') return author.split('-').map((part) => part.charAt(0).toUpperCase() + part.slice(1)).join(' ');
  if (typeof author !== 'object') return undefined;

  const ref = author as { name?: unknown; id?: unknown; slug?: unknown };
  if (typeof ref.name === 'string') return ref.name;
  if (typeof ref.id === 'string') return getAuthorLabel(ref.id);
  if (typeof ref.slug === 'string') return getAuthorLabel(ref.slug);
  return undefined;
};

const { entry } = Astro.props as Props;
const d = entry.data;
const lang = 'fr' as const;

// Corps FR pré-rendu (template-as-data) : le markdown MDX legacy est devenu une donnée.
const bodyHtml = d.body_sections?.[0]?.html_fr ?? '';
const headings = d.headings ?? [];

const dateStr = d.publishedAt.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const authorSlug = getAuthorSlug(d.author);
const authorLabel = getAuthorLabel(d.author) ?? 'Waimia';
// readingTime = frontmatter (tous les articles le portent) ; repli = calcul sur le corps rendu.
const readingTimeMin = d.readingTime ?? computeReadingTime(bodyHtml.replace(/<[^>]+>/g, ' '));

const allBlog = await getLiveCollection('blog');
const allCases = await getCollection('cases');

const relatedCasesData = (d.relatedCases ?? [])
  .map((id) => allCases.find((c) => c.id === id))
  .filter(Boolean)
  .map((c) => ({ id: c!.id, title: c!.data.title_fr, href: `/cas-clients/${c!.id}` }));

// Collection `offres` retirée (refonte v7) : la bande related-offres est vide.
const relatedOffresData: { id: string; title: string; href: string }[] = [];

// Habillage editorial : illustration hero (override frontmatter sinon mapping par catégorie).
const heroIllustration = d.heroIllustration ?? blogHeroIllustration((d as { category?: string }).category);

const relatedCards = d.relatedPosts.length > 0
  ? d.relatedPosts
      .map((id) => allBlog.find((b) => b.id === id))
      .filter(Boolean)
      .map((c) => ({
        kicker: `§ Blog · ${siloLabel(c!.data.category)}`,
        title_fr: c!.data.title_fr,
        title_en: c!.data.title_en,
        lead_fr: c!.data.description_fr,
        lead_en: c!.data.description_en,
        href: `/blog/${c!.id}`,
      }))
  : [];

// « Template-as-data » : les props d'EssayTemplate se dérivent de la DÉFINITION `essay`.
const ctx: EssayContext = {
  data: d,
  lang,
  articleId: entry.id,
  authorSlug,
  authorLabel,
  dateStr,
  readingTimeMin,
  bodyHtml,
  headings,
  heroIllustration,
  relatedCards,
  relatedCasesData,
  relatedOffresData,
};
const essayProps = buildEssayProps(ctx);
---
<EssayTemplate {...essayProps} midCta seoTitle={d.seoTitle_fr} noindex={d.seo?.noindex}>
  <Fragment slot="headline">{d.h1_fr ?? d.title_fr}</Fragment>
  <Fragment slot="lede">{d.description_fr}</Fragment>
  <Fragment slot="body" set:html={bodyHtml} />
</EssayTemplate>
