---
// Route · /blog · vue « articles » du hub Ressources (ResourcesHub), 2026-10-26.
//
// Même composant que /ressources (recherche, filtres par type et par thème, cartes) : la page
// ne porte plus que ce qui lui est propre, à savoir son title, sa description, son JSON-LD
// CollectionPage et le maillage interne du blog (money pages et preuve). Les articles gardent
// leur URL /blog/<slug>. Les actualités ont leur propre vue : /actualites.
export const prerender = true;

import Base from '../../layouts/Base.astro';
import ResourcesHub from '../../components/ui/organisms/ResourcesHub.astro';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import type { SectionData } from '@waimia/ds-kernel';
import { SITE } from '../../site.config';
import { langFromPath } from '../../lib/i18n';
import { getResourceItems } from '../../lib/resources-hub';
import { buildCollectionPage } from '../../lib/seo/schema-builder';
import { hubNoindex } from '../../lib/seo/hub-index';
import { meshForBlogHub } from '../../lib/internal-mesh';
import { RESOURCE_VIEWS } from '../../data/ressources-hub-sections';

const lang = langFromPath(Astro.url.pathname);
const isFr = lang === 'fr';
const v = RESOURCE_VIEWS.articles;
const items = await getResourceItems();
const shown = items.filter((i) => i.kind === 'articles');

const collectionLd = buildCollectionPage(
  isFr ? v.collection_name_fr : v.collection_name_en,
  isFr ? v.collection_desc_fr : v.collection_desc_en,
  shown.map((i) => `${SITE.url}${i.href}`),
);

// Maillage interne dérivé (source unique internal-mesh, routes réelles, 0 self-link) :
// hub blog → money pages (services ciblés par les billets) + preuve (hub cas clients).
const meshSection = { ...meshForBlogHub(lang), background: 'paper-3' as const } as unknown as SectionData;
---
<Base
  title={isFr ? v.title_fr : v.title_en}
  description={isFr ? v.description_fr : v.description_en}
  jsonLd={collectionLd}
  noindex={hubNoindex(shown.length)}
>
  <ResourcesHub items={items} activeKind="articles">
    <Fragment slot="after-list">
      <SectionsRenderer sections={[meshSection]} lang={lang} />
    </Fragment>
  </ResourcesHub>
</Base>
