---
// Page · /blog · Index notes & essais
export const prerender = true;

import { getCollection } from 'astro:content';
import UtilityTemplate from '../../components/templates/UtilityTemplate.astro';
import ArticleGrid from '../../components/sections/ArticleGrid.astro';
import type { SectionByType } from '@waimia/ds-kernel';
import { langFromPath } from '../../lib/i18n';
import { blogEntryHref, fieldNoteTagLabel } from '../../lib/blog-routing';
import { resolveBlogVisual } from '../../lib/blog-taxo-visuals';
import { buildCollectionPage } from '../../lib/seo/schema-builder';

const lang = langFromPath(Astro.url.pathname);

const allBlog = await getCollection('blog');
const sortedBlog = [...allBlog].sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const blogItems = sortedBlog.map((entry) => `https://waimia.com${blogEntryHref(entry)}`);
const collectionLd = buildCollectionPage(
  'Notes & essais · Waimia',
  'Pas de pensum SEO. Notes courtes, cas concrets, recettes pratiques. Un essai mensuel, jamais de promotion.',
  blogItems,
);

const formatDate = (d: Date) => {
  const dd = String(d.getDate()).padStart(2, '0');
  const mm = String(d.getMonth() + 1).padStart(2, '0');
  return `${dd}.${mm}`;
};

// Label de type court (ESSAI, NOTE, CAS, RECETTE…) dérivé de editorialType, sinon `type`.
const tagLabel = (data: (typeof sortedBlog)[number]['data']): string =>
  data.editorialType
    ? fieldNoteTagLabel(data.editorialType, lang).toUpperCase()
    : (data.type ?? 'NOTE').toUpperCase();

// Label auteur court pour la carte (référence `authors` ou chaîne kebab-case).
const authorLabel = (author: unknown): string | undefined => {
  if (!author) return undefined;
  const slug = typeof author === 'string'
    ? author
    : (author as { id?: string }).id;
  if (!slug) return undefined;
  return slug.split('-').map((p) => p.charAt(0).toUpperCase() + p.slice(1)).join(' ');
};

// Mapping entrée blog → item article-grid (illustration teintée par taxonomie).
const articles = sortedBlog.map((entry) => {
  const d = entry.data;
  const visual = resolveBlogVisual({ category: d.category, heroImage: d.heroImage });
  const tag = tagLabel(d);
  const readTime = d.readingTime ? `${d.readingTime} min` : undefined;
  return {
    image: visual.image,
    tint: visual.hue,
    tag_fr: tag,
    tag_en: tag,
    title_fr: d.title_fr,
    title_en: d.title_en,
    excerpt_fr: d.excerpt_fr ?? d.description_fr,
    excerpt_en: d.excerpt_en ?? d.description_en,
    date: formatDate(d.publishedAt),
    read_time_fr: readTime,
    read_time_en: readTime,
    author: authorLabel(d.author),
    href: blogEntryHref(entry),
  };
});

const gridData = {
  type: 'article-grid',
  background: 'paper',
  columns: '3',
  articles,
} satisfies SectionByType<'article-grid'>;
---
<UtilityTemplate
  variant="list"
  title="Notes & essais · Waimia"
  description="Pas de pensum SEO. Notes courtes, cas concrets, recettes pratiques. Un essai mensuel, jamais de promotion."
  kicker="§ Notes & essais · monthly"
  jsonLd={collectionLd}
>
  <Fragment slot="headline">
    Notes <i>lentes</i> du terrain.
  </Fragment>
  <Fragment slot="lede">
    Une newsletter mensuelle, jamais de promotion. Tout ce qu'on aurait voulu lire avant de commencer un chantier.
  </Fragment>

  <Fragment slot="list">
    <div class="blog-grid">
      <ArticleGrid data={gridData} lang={lang} />
    </div>
  </Fragment>
</UtilityTemplate>

<style>
  /* Resserrage micro-rythme du blanc hero→grille (cf masthead `hero-hub-listing`
     bottom clamp + `.list-body` top clamp du template partagé) : on remonte la grille
     d'un cran depuis la page (override local, template intact). La section ArticleGrid
     porte son propre padding-block (--section-base) : on le neutralise en tête pour
     éviter une double bande. */
  .blog-grid :global(.article-grid) {
    padding-block-start: 0;
  }
  .blog-grid {
    margin-top: calc(-1 * var(--space-7));
  }
  @media (max-width: 768px) {
    .blog-grid { margin-top: calc(-1 * var(--space-5)); }
  }
</style>
