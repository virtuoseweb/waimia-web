---
export const prerender = true;

// Page static · /library/family/[family] · une FAMILLE transverse du catalogue (taxonomie docs/45 §9.6).
// Toutes les variantes (section.type) d'une même famille rendues côte à côte en vignettes d'aperçu,
// avec leurs déclinaisons (presets) prévisualisables quand elles existent. Complément de
// /library/[category] : ici on entre par la FORME (hero, card-grid, table…), pas par l'intention.
//
// getStaticPaths sur les familles distinctes de listSections() (section.family, 165/165 peuplé).
// Réutilise le mécanisme d'aperçu [data-preview-frame] + /preview/[type] et /preview/[type]/[preset].
// 0 nouveau token, 0 valeur en dur, 0 U+2014.

import Base from '../../../layouts/Base.astro';
import DsLocalNav from '../../../components/library/DsLocalNav.astro';
import SectionCard from '../../../components/library/SectionCard.astro';
import { listSections, type SectionListItem } from '../../../lib/section-registry';
import { listPresets, type Preset } from '../../../lib/section-presets';

export function getStaticPaths() {
  const families = new Map<string, SectionListItem[]>();
  for (const section of listSections()) {
    const family = section.family ?? 'autres';
    const list = families.get(family) ?? [];
    list.push(section);
    families.set(family, list);
  }
  return [...families.entries()].map(([family, sections]) => ({
    params: { family },
    props: { family, sections },
  }));
}

interface Props {
  family: string;
  sections: SectionListItem[];
}

const { family, sections } = Astro.props;

// Ordonne : stables d'abord, puis alpha. Attache les presets (déclinaisons) de chaque variante.
interface VariantEntry {
  section: SectionListItem;
  presets: Preset[];
}
const variants: VariantEntry[] = sections
  .map((section) => ({ section, presets: listPresets(section.type) }))
  .sort((a, b) => {
    const statusRank = (s: string) => (s === 'stable' ? 0 : s === 'wip' ? 1 : 2);
    const d = statusRank(a.section.status) - statusRank(b.section.status);
    if (d !== 0) return d;
    return a.section.type.localeCompare(b.section.type);
  });

const variantCount = variants.length;
const presetCount = variants.reduce((acc, v) => acc + v.presets.length, 0);
const stableCount = variants.filter((v) => v.section.status === 'stable').length;
---

<Base
  title={`Famille ${family} · Catalogue Waimia · Atelier Design System`}
  description={`Toutes les variantes de la famille ${family} du Design System Waimia, rendues côte à côte avec leurs déclinaisons.`}
  alternate={false}
  noindex
>
  <section class="famx-mast">
    <div class="wrap-wide">
      <DsLocalNav active="catalogue" scope="library" note="Ici : une famille transverse. Compare ses variantes et leurs déclinaisons." />
      <a class="famx-back" href="/library/family">← Familles</a>
      <p class="famx-kicker">§ Famille · {variantCount} variantes{presetCount > 0 ? ` · ${presetCount} déclinaisons` : ''}</p>
      <h1 class="famx-h1">{family}</h1>
      <p class="famx-lede">
        {variantCount} variante{variantCount > 1 ? 's' : ''} ({stableCount} stable{stableCount > 1 ? 's' : ''}) partagent la
        forme « {family} ». Chaque card ouvre la fiche technique ; les déclinaisons (presets) se prévisualisent en ligne.
      </p>
    </div>
  </section>

  <section class="famx-grid-outer wrap-wide" aria-label={`Variantes de la famille ${family}`}>
    <div class="famx-grid">
      {variants.map(({ section, presets }) => (
        <div class="famx-cell">
          {/* Carte partagée (vignette + titre + meta facettes + statut + presetCount). */}
          <SectionCard
            type={section.type}
            family={section.family}
            categoryLabel={section.subcategory}
            status={section.status}
            effects={section.effects}
            interactions={section.interactions}
            elements={section.elements}
            layoutFacets={section.layoutFacets}
            presetCount={presets.length}
            href={`/library/${section.type}`}
            maxHeight={280}
            description={section.description_fr}
          />

          {presets.length > 0 && (
            <div class="famx-presets" aria-label={`Déclinaisons de ${section.type}`}>
              <p class="famx-presets-label">{presets.length} déclinaison{presets.length > 1 ? 's' : ''}</p>
              <ul class="famx-presets-list">
                {presets.map((preset) => (
                  <li class="famx-preset">
                    <div class="famx-preset-preview" data-preview-frame data-lazy-preview data-max-height="200" aria-hidden="true">
                      <iframe class="famx-preset-frame" data-src={`/preview/${section.type}/${preset.id}`} title={`Aperçu ${preset.label}`} loading="lazy" tabindex="-1" scrolling="no"></iframe>
                    </div>
                    <p class="famx-preset-label">{preset.label}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <script>import '../../../components/library/lazy-preview.ts';</script>
  <script>import '../../../scripts/preview-frame.ts';</script>
</Base>

<style>
  .famx-mast {
    padding: calc(var(--header-height) + var(--space-8)) 0 var(--space-8);
    border-bottom: 1px solid var(--hairline);
  }
  .famx-back {
    display: inline-flex;
    width: fit-content;
    margin-bottom: var(--space-5);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-decoration: none;
  }
  .famx-back:hover { color: var(--accent-text); }
  .famx-kicker {
    margin: 0 0 var(--space-4);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .famx-h1 {
    margin: 0 0 var(--space-5);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: var(--fw-regular);
    letter-spacing: -0.02em;
    line-height: 0.95;
    text-transform: capitalize;
  }
  .famx-lede {
    max-width: 64ch;
    margin: 0;
    color: var(--ink-2);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: 1.55;
  }
  .famx-grid-outer {
    margin: 0 auto;
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
  }
  .famx-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
  }
  /* Cellule = carte partagée (SectionCard) + bloc déclinaisons sous elle, même fond. */
  .famx-cell {
    display: flex;
    flex-direction: column;
    background: var(--paper);
  }

  /* ── Déclinaisons (presets) ── */
  .famx-presets {
    margin: 0 var(--space-4) var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--hairline);
    position: relative;
    z-index: 3;
  }
  .famx-presets-label {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .famx-presets-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .famx-preset {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .famx-preset-preview {
    display: block;
    position: relative;
    min-height: 100px;
    overflow: hidden;
    border: 1px solid var(--hairline);
    background: var(--paper);
  }
  .famx-preset-frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 1280px;
    border: 0;
    transform-origin: top left;
    pointer-events: none;
  }
  .famx-preset-label {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-micro);
    line-height: var(--leading-lede);
    color: var(--ink-2);
  }
  @media (max-width: 720px) {
    .famx-mast .wrap-wide,
    .famx-grid-outer {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>
