---
export const prerender = true;

// Page static · /library/family · INDEX des familles (axe transverse de la taxonomie docs/45 §9.6 :
// Catégorie -> Famille -> Variante(type) -> Déclinaison(preset)). La famille regroupe les sections
// par PARENTÉ STRUCTURELLE (hero, card-grid, table, timeline…) indépendamment de la catégorie
// d'intention. Vue complémentaire de /library (catégories) : ici on entre par la forme.
//
// Registry-driven : on lit section.family sur listSections() (peuplé 165/165 par le keystone).
// 0 nouveau token, 0 valeur en dur, 0 U+2014.

import Base from '../../../layouts/Base.astro';
import DsLocalNav from '../../../components/library/DsLocalNav.astro';
import Kicker from '../../../components/ui/atoms/Kicker.astro';
import { listSections } from '../../../lib/section-registry';

const sections = listSections();

// Regroupement par famille (axe transverse). Un représentant par famille = le 1er stable rencontré
// (sinon le 1er tout court), pour la vignette d'aperçu de la card famille.
interface FamilyGroup {
  family: string;
  count: number;
  representative: string;
  stableCount: number;
}
const map = new Map<string, FamilyGroup>();
for (const section of sections) {
  const family = section.family ?? 'autres';
  const g = map.get(family) ?? { family, count: 0, representative: section.type, stableCount: 0 };
  g.count += 1;
  if (section.status === 'stable') {
    g.stableCount += 1;
    // Préfère un représentant stable et stable-er rendu (1er stable rencontré).
    if (g.representative === section.type || g.stableCount === 1) g.representative = section.type;
  }
  map.set(family, g);
}
const families = [...map.values()].sort((a, b) => b.count - a.count || a.family.localeCompare(b.family));
const familyCount = families.length;
const sectionCount = sections.length;
---

<Base
  title="Familles de sections · Catalogue Waimia · Atelier Design System"
  description="Index des familles de sections du Design System Waimia : regroupement transverse par parenté structurelle (hero, card-grid, table, timeline…), piloté par le registry."
  noindex
>
  <section class="fam-mast">
    <div class="wrap-wide">
      <DsLocalNav active="catalogue" scope="library" note="Ici : les familles transverses. Entre par la forme, pas par l'intention." />
      <a class="fam-back" href="/library#catalogue">← Retour atelier</a>
      <Kicker class="fam-kicker">§ Familles · {familyCount} familles · {sectionCount} sections</Kicker>
      <h1 class="fam-h1">Par <i>famille</i>.</h1>
      <p class="fam-lede">
        La famille regroupe les sections qui partagent une même forme (hero, grille de cartes, table,
        timeline…), quelle que soit leur catégorie d'intention. Ouvre une famille pour comparer ses
        variantes côte à côte.
      </p>
    </div>
  </section>

  <section class="fam-grid-outer wrap-wide" aria-label="Familles de sections">
    <ul class="fam-grid">
      {families.map((group) => (
        <li>
          <a class="fam-card" href={`/library/family/${group.family}`}>
            <span class="fam-card-preview" data-preview-frame data-lazy-preview data-max-height="220" aria-hidden="true">
              <iframe
                class="fam-card-frame"
                data-src={`/preview/${group.representative}`}
                title={`Aperçu famille ${group.family}`}
                loading="lazy"
                tabindex="-1"
                scrolling="no"
              ></iframe>
            </span>
            <span class="fam-card-body">
              <span class="fam-card-top">
                <strong class="fam-card-name">{group.family}</strong>
                <span class="fam-card-count">{group.count}</span>
              </span>
              <span class="fam-card-meta">{group.stableCount} stable{group.stableCount > 1 ? 's' : ''}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <script>import '../../../components/library/lazy-preview.ts';</script>
  <script>import '../../../scripts/preview-frame.ts';</script>
</Base>

<style>
  .fam-mast {
    padding: calc(var(--header-height) + var(--space-8)) 0 var(--space-8);
    border-bottom: 1px solid var(--hairline);
  }
  .fam-back {
    display: inline-flex;
    width: fit-content;
    margin-bottom: var(--space-5);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-decoration: none;
  }
  .fam-back:hover { color: var(--accent-text); }
  .fam-kicker { margin: 0 0 var(--space-4); }
  .fam-h1 {
    margin: 0 0 var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    letter-spacing: var(--tracking-display);
    font-weight: var(--fw-semibold);
    color: var(--ink);
  }
  .fam-h1 i {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: var(--fw-regular);
    color: var(--accent-text);
  }
  .fam-lede {
    max-width: 62ch;
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .fam-grid-outer {
    margin: 0 auto;
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
  }
  .fam-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--hairline);
    border: 1px solid var(--hairline);
  }
  .fam-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--paper);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease);
  }
  .fam-card:hover { background: var(--paper-2); }
  .fam-card:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .fam-card-preview {
    display: block;
    position: relative;
    min-height: 140px;
    overflow: hidden;
    border-bottom: 1px solid var(--hairline);
    background: var(--paper);
  }
  /* transform + height pilotés par src/scripts/preview-frame.ts */
  .fam-card-frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 1280px;
    border: 0;
    transform-origin: top left;
    pointer-events: none;
  }
  .fam-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
  }
  .fam-card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .fam-card-name {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--fw-semibold);
    color: var(--ink);
    text-transform: capitalize;
  }
  .fam-card-count {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--accent-text);
  }
  .fam-card-meta {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .fam-mast .wrap-wide,
    .fam-grid-outer {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>
