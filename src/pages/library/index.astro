---
export const prerender = true;

// Page static · /library · HUB de l'atelier Design System (U0, §11.2/§12.2.G docs/design-system/03).
//
// Forme : mini-hub qui présente l'atelier `/library/*` et renvoie vers ses surfaces :
//   - /library/[category]  (catalogue par intention, liste des familles + compteur de sections)
//   - /library/[type]      (fiche technique d'une section, atteinte depuis une catégorie)
//   - /library/studio      (éditeur de tokens live)
//   - /library/hero-lab    (variantes de hero comparées côté à côté)
//   - /library/family      (index des familles transverses)
//   - /library/manifest.json (graine MCP lisible par les agents)
//
// Réutilise les mécanismes existants (registry-driven) : listCategories() pour la grille de familles.
// Ce hub ne recopie PAS le mono-page design-system.astro (1810 l) : le détail tokens/atomes/sections
// vit dans les sous-routes. Esprit du header catalogue (design-system.astro:161-199), composé avec
// les tokens/atomes existants. 0 nouveau token (rule 60), 0 valeur en dur, 0 U+2014 (rule 58).

import Base from '../../layouts/Base.astro';
import DsLocalNav from '@waimia/catalogue-ui/DsLocalNav.astro';
import Kicker from '../../components/ui/atoms/Kicker.astro';
import CatalogueExplorer, { type CatalogueItem } from '@waimia/catalogue-ui/CatalogueExplorer.tsx';
import { listCategories, listSections, listFacetCounts } from '../../lib/section-registry';
import { listPresets } from '@waimia/ds-kernel/lib/section-presets';
import { getUsage } from '../../lib/library-manifest';
import {
  FACET_LABELS_FR,
  INTENT_LABELS_FR,
  PAGE_ROLE_LABELS_FR,
  CONTENT_MODE_LABELS_FR,
  type FacetKind,
} from '@waimia/ds-kernel/lib/section-facets';

const categories = listCategories();
const sections = listSections();
const sectionCount = sections.length;
const categoryCount = categories.length;

// Libellé de catégorie par slug (le registry groupe par categorySlug, on récupère le label).
const categoryLabelBySlug = new Map(categories.map((c) => [c.slug, c.label]));

// Export JSON léger du registry pour l'island (type/famille/catégorie/statut/tags/desc + presets).
// 0 markup inline : la grille de vignettes + filtres/tri vit dans CatalogueExplorer.
const items: CatalogueItem[] = sections.map((section) => ({
  type: section.type,
  family: section.family ?? 'autres',
  categorySlug: section.categorySlug,
  categoryLabel: categoryLabelBySlug.get(section.categorySlug) ?? section.subcategory,
  status: section.status,
  tags: section.tags,
  description_fr: section.description_fr,
  presetCount: listPresets(section.type).length,
  effects: section.effects,
  interactions: section.interactions,
  elements: section.elements,
  layoutFacets: section.layoutFacets,
  intent: section.intent,
  pageRole: section.pageRole,
  // Modèle de contenu (registry) + usage live (manifest : 'site' = >= 1 consommateur).
  contentMode: section.contentMode,
  onSite: getUsage(section.type) === 'site',
}));

// Facettes orthogonales (effets/interactions/éléments/layout) : effectifs + libellés FR pour les
// filtres multi-select de l'island. On ne descend que les tags présents (count > 0, déjà filtré
// par listFacetCounts) et leur libellé lisible. Logique de filtrage documentée dans l'island.
const facetKinds: FacetKind[] = ['effects', 'interactions', 'elements', 'layoutFacets'];
const facetCountsRaw = listFacetCounts();
// Type aligné sur le contrat FacetGroup de l'island (6 genres : 4 orthogonaux + 2 sémantiques).
type ExplorerFacetGroup = {
  kind: FacetKind | 'intent' | 'pageRole' | 'contentMode';
  label: string;
  options: { value: string; label: string; count: number }[];
};
const facetGroups: ExplorerFacetGroup[] = facetKinds.map((kind) => ({
  kind,
  label:
    kind === 'effects'
      ? 'Effets'
      : kind === 'interactions'
        ? 'Interactions'
        : kind === 'elements'
          ? 'Éléments'
          : 'Layout',
  options: facetCountsRaw[kind].map(({ tag, count }) => ({
    value: tag,
    label: (FACET_LABELS_FR[kind] as Record<string, string>)[tag] ?? tag,
    count,
  })),
}));

// Facettes sémantiques IA (Vague C2-A) : intent + pageRole. Multi-valuées (une section porte
// >= 1 tag) -> on agrège sur items, on ne garde que les tags présents (count > 0), libellés FR.
// Réutilise EXACTEMENT le contrat FacetGroup de l'island (kind/label/options[value,label,count]).
const countArray = (pick: (i: CatalogueItem) => string[]) => {
  const map = new Map<string, number>();
  for (const it of items) for (const tag of pick(it)) map.set(tag, (map.get(tag) ?? 0) + 1);
  return map;
};
const toFacetOptions = (m: Map<string, number>, labels: Record<string, string>) =>
  [...m.entries()]
    .map(([value, count]) => ({ value, label: labels[value] ?? value, count }))
    .sort((a, b) => b.count - a.count || a.value.localeCompare(b.value));

facetGroups.push(
  {
    kind: 'intent' as const,
    label: 'Intention',
    options: toFacetOptions(countArray((i) => i.intent), INTENT_LABELS_FR),
  },
  {
    kind: 'pageRole' as const,
    label: 'Rôle de page',
    options: toFacetOptions(countArray((i) => i.pageRole), PAGE_ROLE_LABELS_FR),
  },
  {
    // 7e genre : modèle de contenu (instance / global-ref / hybrid). Valeur unique
    // par section -> on l'enveloppe en tableau pour réutiliser countArray.
    kind: 'contentMode' as const,
    label: 'Modèle de contenu',
    options: toFacetOptions(countArray((i) => [i.contentMode]), CONTENT_MODE_LABELS_FR),
  },
);

// Facettes pré-calculées (value/label/count) pour les selects.
const countBy = (key: (i: CatalogueItem) => string) => {
  const map = new Map<string, number>();
  for (const it of items) map.set(key(it), (map.get(key(it)) ?? 0) + 1);
  return map;
};
const familyCounts = countBy((i) => i.family);
const familyOptions = [...familyCounts.entries()]
  .map(([value, count]) => ({ value, label: value, count }))
  .sort((a, b) => a.label.localeCompare(b.label));
const categoryCountsMap = countBy((i) => i.categorySlug);
const categoryOptions = [...categoryCountsMap.entries()]
  .map(([value, count]) => ({ value, label: categoryLabelBySlug.get(value) ?? value, count }))
  .sort((a, b) => a.label.localeCompare(b.label));

const familyCount = familyOptions.length;

// Représentant par groupe (vignette d'aperçu de la card-groupe sur la landing) :
// 1ʳᵉ section STABLE rencontrée par groupe, sinon la 1ʳᵉ. Évite de monter 165 iframes
// (saturation navigateur ERR_INSUFFICIENT_RESOURCES) : la landing montre 1 vignette/groupe.
const pickRepresentatives = (key: (i: CatalogueItem) => string) => {
  const reps = new Map<string, { type: string; stable: boolean }>();
  for (const it of items) {
    const k = key(it);
    const current = reps.get(k);
    const stable = it.status === 'stable';
    // 1er rencontré, OU on remplace un non-stable par le 1er stable trouvé.
    if (!current || (stable && !current.stable)) reps.set(k, { type: it.type, stable });
  }
  return new Map([...reps.entries()].map(([k, v]) => [k, v.type]));
};
const familyReps = pickRepresentatives((i) => i.family);
const categoryReps = pickRepresentatives((i) => i.categorySlug);
const familyRepEntries = [...familyReps.entries()].map(([value, type]) => ({ value, type }));
const categoryRepEntries = [...categoryReps.entries()].map(([value, type]) => ({ value, type }));
---

<Base
  title="Atelier Design System · Library Waimia · Catalogue · Studio · Hero Lab"
  description="Atelier du Design System Waimia : catalogue des sections par intention, éditeur de tokens live et comparateur de heros. Piloté par le registry."
  noindex
>
  {/* ───────────── MASTHEAD ───────────── */}
  <section class="lib-hd">
    <div class="wrap-wide">
      <DsLocalNav
        active="catalogue"
        scope="library"
        note="Ici : l'atelier du Design System. Catalogue, Studio et Hero Lab, une seule source de vérité : le registry."
      />
      <Kicker class="lib-kicker">§ Atelier Design System · Library Waimia</Kicker>
      <h1 class="lib-h1">L'atelier, <i>pas</i> le placard.</h1>
      <p class="lib-lede">
        {familyCount} familles transverses, {categoryCount} catégories d'intention, {sectionCount} sections
        composables, un éditeur de tokens en direct et un comparateur de heros. On pioche au lieu d'inventer :
        chaque surface lit le même registry que le site, et chaque section se prévisualise avant d'être ouverte.
      </p>
      <ul class="lib-stats" aria-label="Statistiques de l'atelier">
        <li><strong>{familyCount}</strong><span>familles</span></li>
        <li><strong>{categoryCount}</strong><span>catégories</span></li>
        <li><strong>{sectionCount}</strong><span>sections</span></li>
        <li><strong>4</strong><span>surfaces outillées</span></li>
      </ul>
    </div>
  </section>

  {/* ───────────── SURFACES OUTILLÉES ───────────── */}
  <section class="lib-surfaces wrap-wide" aria-label="Surfaces de l'atelier">
    <nav class="lib-hub" aria-label="Surfaces outillées">
      <a class="lib-hub-card lib-hub-card--featured" href="/library/studio">
        <span class="lib-hub-card-label">DS Studio · éditeur live</span>
        <span class="lib-hub-card-desc">
          Modifie les variables et vois le rendu changer en direct. Galerie visuelle complète des atomes,
          molécules et sections.
        </span>
      </a>
      <a class="lib-hub-card" href="/library/hero-lab">
        <span class="lib-hub-card-label">Hero Lab</span>
        <span class="lib-hub-card-desc">Toutes les variantes de hero du catalogue, rendues côté à côté.</span>
      </a>
      <a class="lib-hub-card" href="/library/family">
        <span class="lib-hub-card-label">Familles</span>
        <span class="lib-hub-card-desc">
          L'index des familles transverses : explore le catalogue par regroupement plutôt que par catégorie d'intention.
        </span>
      </a>
      <a class="lib-hub-card" href="/library/manifest.json">
        <span class="lib-hub-card-label">MCP / agents</span>
        <span class="lib-hub-card-desc">
          Le manifeste lisible par les agents : la graine qui permet à une IA de choisir et composer les sections.
        </span>
      </a>
    </nav>
  </section>

  {/* ───────────── CATALOGUE EXPLORABLE (vignettes + filtres/tri + regroupement) ───────────── */}
  <section class="lib-cats wrap-wide" id="catalogue" aria-label="Catalogue des sections">
    <header class="lib-cats-head">
      <Kicker class="lib-cats-kicker">§ Catalogue · {sectionCount} sections · {familyCount} familles</Kicker>
      <h2 class="lib-cats-title">Vois avant d'ouvrir.</h2>
      <p class="lib-cats-lede">
        Chaque section se prévisualise en vignette. Regroupe par famille (transverse) ou par catégorie
        (intention), filtre par statut ou tag, et ouvre une section pour sa fiche technique et ses déclinaisons.
      </p>
      <p class="lib-cats-bridge">
        Besoin de la vue famille en plein écran ? <a href="/library/family">Index des familles →</a>
      </p>
    </header>
    <CatalogueExplorer
      client:load
      items={items}
      families={familyOptions}
      categories={categoryOptions}
      familyReps={familyRepEntries}
      categoryReps={categoryRepEntries}
      facetGroups={facetGroups}
    />
  </section>

  <script>import '../../scripts/preview-frame.ts';</script>
</Base>

<style>
  /* ── Masthead ── */
  .lib-hd {
    padding: calc(var(--header-height) + var(--space-8)) 0 var(--space-8);
    border-bottom: 1px solid var(--hairline);
  }
  .lib-kicker {
    margin: 0 0 var(--space-4);
  }
  .lib-h1 {
    margin: 0 0 var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    letter-spacing: var(--tracking-display);
    font-weight: var(--fw-semibold);
    color: var(--ink);
    text-wrap: balance;
  }
  .lib-h1 i {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: var(--fw-regular);
    color: var(--accent-text);
  }
  .lib-lede {
    max-width: 62ch;
    margin: 0 0 var(--space-6);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .lib-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-7);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lib-stats li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .lib-stats strong {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    font-weight: var(--fw-semibold);
    color: var(--ink);
    line-height: 1;
  }
  .lib-stats span {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ── Surfaces outillées (hub) ── */
  .lib-surfaces {
    margin: 0 auto;
    padding-top: var(--space-8);
    padding-bottom: var(--space-4);
  }
  .lib-hub {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }
  .lib-hub-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    background: var(--paper-2);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .lib-hub-card:hover { border-color: var(--accent-text); }
  .lib-hub-card--featured {
    background: var(--ink);
    border-color: var(--ink-3);
  }
  .lib-hub-card-label {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: var(--fw-semibold);
    color: var(--ink);
    line-height: 1.2;
  }
  .lib-hub-card--featured .lib-hub-card-label { color: var(--paper); }
  .lib-hub-card-desc {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .lib-hub-card--featured .lib-hub-card-desc {
    color: color-mix(in srgb, var(--paper) 72%, var(--ink));
  }

  /* ── Catalogue par intention ── */
  .lib-cats {
    margin: 0 auto;
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
  }
  .lib-cats-head {
    margin-bottom: var(--space-7);
  }
  .lib-cats-kicker {
    margin: 0 0 var(--space-4);
  }
  .lib-cats-title {
    margin: 0 0 var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-display);
    color: var(--ink);
  }
  .lib-cats-lede {
    max-width: 60ch;
    margin: 0 0 var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .lib-cats-bridge {
    margin: 0 0 var(--space-7);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--muted);
  }
  .lib-cats-bridge a {
    color: var(--accent-text);
    text-decoration: none;
  }
  .lib-cats-bridge a:hover { text-decoration: underline; }

  @media (max-width: 720px) {
    .lib-hd .wrap-wide,
    .lib-surfaces,
    .lib-cats {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>

{/* CSS de l'island CatalogueExplorer : sorti du composant React (un style hydraté
    provoque un mismatch SSR/client). is:global car les classes cx-* sont sur du markup
    rendu par React, hors scoping Astro. 0 nouveau token (rule 60). */}
<style is:global>

        .cx { display: flex; flex-direction: column; gap: var(--space-6); }

        /* ── Contrôles ── */
        .cx-controls {
          display: flex;
          flex-direction: column;
          gap: var(--space-4);
          padding: var(--space-5);
          border: 1px solid var(--hairline);
          border-radius: var(--radius-md);
          background: var(--paper-2);
          position: sticky;
          top: var(--header-height);
          z-index: 5;
          /* Filet de sécurité : le panneau épinglé ne dépasse jamais le viewport, même chips
             ouverts, pour que les résultats restent toujours atteignables (scroll interne). */
          max-height: calc(100dvh - var(--header-height) - var(--space-4));
          overflow-y: auto;
          overscroll-behavior: contain;
        }
        .cx-search { display: flex; }
        .cx-input {
          width: 100%;
          padding: var(--space-3) var(--space-4);
          border: 1px solid var(--hairline-strong);
          border-radius: var(--radius-sm);
          background: var(--paper);
          color: var(--ink);
          font-family: var(--font-sans);
          font-size: var(--text-body);
        }
        .cx-input::placeholder { color: var(--muted); }
        .cx-input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

        .cx-facets {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
          gap: var(--space-3);
        }
        .cx-field { display: flex; flex-direction: column; gap: var(--space-1); }
        .cx-field-label {
          font-family: var(--font-mono);
          font-size: var(--text-micro);
          letter-spacing: var(--tracking-mono);
          text-transform: uppercase;
          color: var(--muted);
        }
        .cx-select {
          padding: var(--space-2) var(--space-3);
          border: 1px solid var(--hairline-strong);
          border-radius: var(--radius-sm);
          background: var(--paper);
          color: var(--ink);
          font-family: var(--font-mono);
          font-size: var(--text-small);
          cursor: pointer;
        }
        .cx-select:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

        /* ── Raccourcis + regroupement (rangée) ── */
        .cx-toggles {
          display: flex;
          align-items: center;
          justify-content: space-between;
          flex-wrap: wrap;
          gap: var(--space-4);
        }
        .cx-quick { display: flex; flex-wrap: wrap; gap: var(--space-2); }

        .cx-groupby { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
        .cx-segmented {
          display: inline-flex;
          border: 1px solid var(--hairline-strong);
          border-radius: var(--radius-sm);
          overflow: hidden;
        }
        .cx-seg-btn {
          padding: var(--space-2) var(--space-4);
          border: 0;
          background: var(--paper);
          color: var(--ink-2);
          font-family: var(--font-mono);
          font-size: var(--text-small);
          letter-spacing: 0.04em;
          text-transform: uppercase;
          cursor: pointer;
          transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
        }
        .cx-seg-btn + .cx-seg-btn { border-left: 1px solid var(--hairline-strong); }
        .cx-seg-btn:hover { color: var(--accent-text); }
        .cx-seg-btn[aria-pressed='true'] { background: var(--ink); color: var(--paper); }

        /* ── Méta / reset ── */
        .cx-meta { display: flex; align-items: baseline; gap: var(--space-4); }
        .cx-count {
          font-family: var(--font-mono);
          font-size: var(--text-small);
          color: var(--ink-2);
        }
        .cx-reset {
          border: 0;
          background: none;
          padding: 0;
          color: var(--accent-text);
          font-family: var(--font-mono);
          font-size: var(--text-small);
          text-decoration: underline;
          cursor: pointer;
        }
        .cx-empty {
          padding: var(--space-8);
          text-align: center;
          color: var(--muted);
          font-family: var(--font-sans);
          font-size: var(--text-body);
        }

        /* ── Grille de cartes-groupes ── */
        .cx-grid {
          display: grid;
          grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
          gap: 1px;
          margin: 0;
          padding: 0;
          list-style: none;
          background: var(--hairline);
          border: 1px solid var(--hairline);
        }
        .cx-card {
          display: flex;
          flex-direction: column;
          height: 100%;
          background: var(--paper);
          text-decoration: none;
          transition: background var(--dur-fast) var(--ease);
        }
        .cx-card:hover { background: var(--paper-2); }
        .cx-card:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }

        .cx-card-preview {
          display: block;
          position: relative;
          min-height: 150px;
          overflow: hidden;
          border-bottom: 1px solid var(--hairline);
          background: var(--paper);
        }
        /* transform + height pilotés par src/scripts/preview-frame.ts (scale responsive) */
        .cx-card-frame {
          position: absolute;
          top: 0;
          left: 0;
          width: 1280px;
          border: 0;
          transform-origin: top left;
          pointer-events: none;
        }
        .cx-card-body {
          display: flex;
          flex-direction: column;
          gap: var(--space-3);
          flex: 1;
          padding: var(--space-4);
        }
        .cx-card-top {
          display: flex;
          align-items: baseline;
          justify-content: space-between;
          gap: var(--space-3);
        }
        .cx-card-name {
          font-family: var(--font-sans);
          font-size: var(--text-body);
          font-weight: var(--fw-semibold);
          color: var(--ink);
          line-height: 1.25;
          text-transform: capitalize;
        }
        .cx-card-count {
          flex: none;
          font-family: var(--font-mono);
          font-size: var(--text-small);
          color: var(--accent-text);
        }
        /* Identité technique de la carte-type (vue à plat) : mono, comme la fiche détail
           et SectionCard (.sc-link code). Réutilise les tokens existants, 0 nouveau token. */
        .cx-type-code {
          font-family: var(--font-mono);
          font-size: var(--text-small);
          font-weight: var(--fw-semibold);
          color: var(--ink);
          line-height: 1.25;
          word-break: break-word;
        }
        .cx-card-foot {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: var(--space-3);
          margin-top: auto;
        }
        .cx-card-kind {
          font-family: var(--font-mono);
          font-size: var(--text-micro);
          letter-spacing: var(--tracking-mono);
          text-transform: uppercase;
          color: var(--muted);
        }
