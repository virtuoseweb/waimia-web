---
// Page-labo · /library/hero-explore · galerie d'exploration des 10 héros de service (phase de test).
// Outil interne NOINDEX : rend chaque héro HeroX1..HeroX10 DEUX fois (paper + ink), avec un en-tête
// de séparation mono avant chaque variante + une mini-nav sticky d'ancres. Les 10 héros sont créés
// par 3 workers en parallèle (X1-X4, X5-X7, X8-X10) avec ces noms EXACTS : ils existent au build.
// Source : /tmp/hero-explore/SPEC.md. Pattern inspiré de hero-lab.astro (Base + noindex + en-têtes).
export const prerender = true;

import Base from '../../layouts/Base.astro';

import HeroX1 from '../../components/library/hero-explore/HeroX1.astro';
import HeroX2 from '../../components/library/hero-explore/HeroX2.astro';
import HeroX3 from '../../components/library/hero-explore/HeroX3.astro';
import HeroX4 from '../../components/library/hero-explore/HeroX4.astro';
import HeroX5 from '../../components/library/hero-explore/HeroX5.astro';
import HeroX6 from '../../components/library/hero-explore/HeroX6.astro';
import HeroX7 from '../../components/library/hero-explore/HeroX7.astro';
import HeroX8 from '../../components/library/hero-explore/HeroX8.astro';
import HeroX9 from '../../components/library/hero-explore/HeroX9.astro';
import HeroX10 from '../../components/library/hero-explore/HeroX10.astro';

// Registre des 10 héros : composant + nom de layout + caption courte.
const heroes = [
  { n: 1, C: HeroX1, name: 'Masthead pleine page', caption: 'Bande masthead éditoriale + grand titre serif accentué.' },
  { n: 2, C: HeroX2, name: 'Split média ink', caption: 'Deux colonnes : discours à gauche, carte média à droite.' },
  { n: 3, C: HeroX3, name: 'Grille multi-lignes', caption: 'Empilement de rangées hairline, registre journal.' },
  { n: 4, C: HeroX4, name: 'Centré + bande ink', caption: 'Titre centré au-dessus d’une bande sombre de preuves.' },
  { n: 5, C: HeroX5, name: 'Médaillon média', caption: 'Visuel en médaillon encadré, discours latéral.' },
  { n: 6, C: HeroX6, name: 'Mega baseline KPI', caption: 'Titre monumental ancré sur une baseline de KPI.' },
  { n: 7, C: HeroX7, name: 'Grille 12-col', caption: 'Composition éditoriale sur grille 12 colonnes.' },
  { n: 8, C: HeroX8, name: 'Carte média ink', caption: 'Discours + pills à gauche, carte ink (SVG + 2 KPI) à droite.' },
  { n: 9, C: HeroX9, name: 'Stack rythmé', caption: 'Une colonne, rythme vertical généreux, bande de 4 KPI.' },
  { n: 10, C: HeroX10, name: 'Couverture magazine', caption: 'Cover minimal : masthead, titre géant centré, règle accent, 1 CTA.' },
];

const pad = (v: number) => String(v).padStart(2, '0');
---

<Base
  title="Hero Explore · Labo · Waimia"
  description="Labo interne d’exploration : 10 layouts de héros de service rendus en paper et ink, côte à côte."
  noindex
>
  <section class="hxl-mast">
    <div class="wrap-wide">
      <p class="hxl-kicker">§ Hero Explore · phase de test</p>
      <h1 class="hxl-h1">Dix héros, <i>paper</i> et <i class="acc">ink</i>.</h1>
      <p class="hxl-lede">
        Dix layouts de héros pour les pages services, rendus deux fois chacun (clair puis sombre).
        Outil interne pour comparer les compositions d’un coup d’œil et en retenir une ou deux.
      </p>
      <nav class="hxl-nav" aria-label="Index des héros">
        {heroes.map((h) => (
          <a class="hxl-nav-chip" href={`#x${h.n}`}>
            <span class="hxl-nav-num">X{h.n}</span>
            <span class="hxl-nav-name">{h.name}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <div class="hxl-gallery">
    {heroes.map((h) => {
      const C = h.C as any;
      return (
        <section class="hxl-item" id={`x${h.n}`} aria-labelledby={`x${h.n}-h`}>
          <header class="hxl-item-head wrap-wide">
            <span class="hxl-item-tag" id={`x${h.n}-h`}>X{h.n} · {h.name}</span>
            <p class="hxl-item-caption">{h.caption}</p>
          </header>

          <header class="hxl-variant-head wrap-wide">
            <span class="hxl-variant-tag">X{h.n} · {h.name} · PAPER</span>
          </header>
          <div class="hxl-stage"><C bg="paper" /></div>

          <header class="hxl-variant-head wrap-wide">
            <span class="hxl-variant-tag">X{h.n} · {h.name} · INK</span>
          </header>
          <div class="hxl-stage"><C bg="ink" /></div>
        </section>
      );
    })}
  </div>
</Base>

<style>
  /* La page reste sobre : les héros portent leurs styles. Tout en tokens DS. */
  .hxl-mast {
    padding: calc(var(--header-height) + var(--space-8)) 0 var(--space-8);
    border-bottom: 1px solid var(--hairline);
  }
  .hxl-kicker {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }
  .hxl-h1 {
    margin: 0 0 var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    letter-spacing: var(--tracking-display);
    font-weight: var(--fw-semibold);
    color: var(--ink);
    text-wrap: balance;
  }
  .hxl-h1 i { font-family: var(--font-display); font-style: italic; font-weight: var(--fw-regular); }
  .hxl-h1 i.acc { color: var(--accent-text); }
  .hxl-lede {
    max-width: 62ch;
    margin: 0 0 var(--space-7);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--muted);
  }

  /* Mini-nav sticky d'ancres. */
  .hxl-nav {
    position: sticky;
    top: var(--header-height);
    z-index: var(--z-sticky);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-3) 0;
    background: var(--paper);
  }
  .hxl-nav-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xs);
    background: var(--paper-2);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .hxl-nav-chip:hover { border-color: var(--accent-text); }
  .hxl-nav-num {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono-tight);
    color: var(--accent-text);
  }
  .hxl-nav-name {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--ink-2);
  }

  /* Galerie : chaque héro isolé, en-têtes mono + hairlines + espacement généreux. */
  .hxl-item { border-top: 1px solid var(--hairline); }
  .hxl-item-head {
    margin-inline: auto;
    padding-top: var(--space-7);
    padding-bottom: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .hxl-item-tag {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .hxl-item-caption {
    margin: 0;
    max-width: 70ch;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--muted);
  }
  .hxl-variant-head {
    margin-inline: auto;
    padding-top: var(--space-6);
    padding-bottom: var(--space-3);
  }
  .hxl-variant-tag {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }
  /* La scène isole le héro réel. La hauteur s'adapte au contenu rendu. */
  .hxl-stage {
    position: relative;
    border-top: 1px solid var(--hairline);
    overflow: hidden;
  }
</style>
