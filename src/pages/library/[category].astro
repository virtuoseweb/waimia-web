---
export const prerender = true;

// Page static · /library/[category] · une CATÉGORIE d'intention, nichée (Vague C / P2).
//
// Nichage Catégorie -> Famille -> Variante : au lieu de lister directement les variantes, on
// affiche d'ABORD les FAMILLES de la catégorie (listFamiliesByCategory), chaque famille = une
// carte (vignette représentative + count) cliquable vers /library/family/[family]. En dessous,
// un accès « toutes les variantes » de la catégorie (cartes partagées SectionCard).
//
// Carte = composant PARTAGÉ SectionCard.astro (tue le CSS de carte dupliqué). Aperçu lazy +
// file de concurrence MAX_CONCURRENT=3 (lazy-preview.ts) NON régressés.
// 0 nouveau token, 0 valeur en dur, 0 U+2014.

import Base from '../../layouts/Base.astro';
import DsLocalNav from '@waimia/catalogue-ui/DsLocalNav.astro';
import SectionCard from '@waimia/catalogue-ui/SectionCard.astro';
import {
  listCategories,
  listSections,
  listFamiliesByCategory,
  type CategoryGroup,
} from '../../lib/section-registry';
import type { CategorySlug } from '@waimia/ds-kernel/lib/section-facets';
import { listPresets } from '@waimia/ds-kernel/lib/section-presets';

export function getStaticPaths() {
  return listCategories().map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

interface Props {
  category: CategoryGroup;
}

const { category } = Astro.props;
const sections = listSections().filter((section) => section.categorySlug === category.slug);
const categoryLabel = category.label;

// Niveau FAMILLE : familles présentes dans cette catégorie (count + types). Le représentant de
// vignette = 1ère variante stable de la famille rencontrée dans la catégorie, sinon la 1ère.
const families = listFamiliesByCategory(category.slug as CategorySlug);
const sectionByType = new Map(sections.map((s) => [s.type, s]));
const familyCards = families.map((group) => {
  const stableType = group.types.find((t) => sectionByType.get(t)?.status === 'stable');
  return {
    family: group.family,
    count: group.count,
    representative: stableType ?? group.types[0],
  };
});
const familyCount = familyCards.length;
---

<Base
  title={`${categoryLabel} · Catalogue sections Waimia`}
  description={`Blocks de la catégorie ${categoryLabel}, pilotés par le registry Waimia.`}
  alternate={false}
  noindex
>
  <section class="category-mast">
    <div class="wrap-wide">
      <DsLocalNav active="catalogue" scope="library" note="Ici : une catégorie d'intention. Choisis une famille, ou parcours toutes les variantes." />
      <a class="category-back" href="/library#catalogue">← Retour atelier</a>
      <p class="category-kicker">§ Catégorie marketplace · {familyCount} famille{familyCount > 1 ? 's' : ''} · {category.count} sections</p>
      <h1>{categoryLabel}</h1>
      <p class="category-lede">Blocks de la catégorie {categoryLabel}, pilotés par le registry Waimia. Entre par une famille, ou ouvre toutes les variantes plus bas.</p>
    </div>
  </section>

  {/* ── Niveau FAMILLE ── */}
  <section class="category-fams-outer wrap-wide" aria-label={`Familles de ${categoryLabel}`}>
    <header class="category-sub-head">
      <h2 class="category-sub-title">Familles</h2>
      <p class="category-sub-lede">Regroupements par forme dans cette catégorie. Ouvre-en une pour comparer ses variantes et leurs déclinaisons.</p>
    </header>
    <ul class="category-fams">
      {familyCards.map((fc) => (
        <li>
          <a class="category-fam-card" href={`/library/family/${fc.family}`}>
            <span class="category-fam-preview" data-preview-frame data-lazy-preview data-max-height="220" aria-hidden="true">
              <iframe class="category-fam-frame" data-src={`/preview/${fc.representative}`} title={`Aperçu famille ${fc.family}`} loading="lazy" tabindex="-1" scrolling="no"></iframe>
            </span>
            <span class="category-fam-body">
              <span class="category-fam-top">
                <strong class="category-fam-name">{fc.family}</strong>
                <span class="category-fam-count">{fc.count}</span>
              </span>
              <span class="category-fam-meta">{fc.count > 1 ? 'variantes' : 'variante'}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* ── Toutes les variantes de la catégorie (cartes partagées) ── */}
  <section class="category-grid-outer wrap-wide" aria-label={`Toutes les variantes ${categoryLabel}`}>
    <header class="category-sub-head">
      <h2 class="category-sub-title">Toutes les variantes</h2>
      <p class="category-sub-lede">{category.count} section{category.count > 1 ? 's' : ''} de la catégorie. Clique une carte pour sa fiche technique.</p>
    </header>
    <div class="category-grid">
      {sections.map((section) => (
        <SectionCard
          type={section.type}
          family={section.family}
          categoryLabel={section.subcategory}
          status={section.status}
          effects={section.effects}
          interactions={section.interactions}
          elements={section.elements}
          layoutFacets={section.layoutFacets}
          presetCount={listPresets(section.type).length}
          href={`/library/${section.type}`}
          maxHeight={300}
          description={section.description_fr}
        />
      ))}
    </div>
  </section>

  <script>import '@waimia/catalogue-ui/lazy-preview.ts';</script>
  <script>import '../../scripts/preview-frame.ts';</script>
</Base>

<style>
  .category-mast {
    padding: var(--space-12) var(--space-6) var(--space-8);
  }
  .category-back {
    display: inline-flex;
    width: fit-content;
    margin-bottom: var(--space-6);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-decoration: none;
  }
  .category-back:hover { color: var(--accent-text); }
  .category-kicker {
    margin: 0 0 var(--space-4);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .category-mast h1 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--text-display);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.02em;
    line-height: 0.95;
    text-wrap: balance;
  }
  .category-lede {
    max-width: 620px;
    margin: var(--space-6) 0 0;
    color: var(--muted);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  /* ── Sous-titres de section ── */
  .category-sub-head { margin-bottom: var(--space-5); }
  .category-sub-title {
    margin: 0 0 var(--space-2);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-display);
  }
  .category-sub-lede {
    max-width: 60ch;
    margin: 0;
    color: var(--ink-2);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  /* ── Niveau famille ── */
  .category-fams-outer {
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-8);
  }
  .category-fams {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--hairline);
    border: 1px solid var(--hairline);
  }
  .category-fam-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--paper);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease);
  }
  .category-fam-card:hover { background: var(--paper-2); }
  .category-fam-card:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .category-fam-preview {
    display: block;
    position: relative;
    min-height: 130px;
    overflow: hidden;
    border-bottom: 1px solid var(--hairline);
    background: var(--paper);
  }
  /* transform + height pilotés par src/scripts/preview-frame.ts */
  .category-fam-frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 1280px;
    border: 0;
    transform-origin: top left;
    pointer-events: none;
  }
  .category-fam-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
  }
  .category-fam-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .category-fam-name {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--fw-semibold);
    color: var(--ink);
    text-transform: capitalize;
  }
  .category-fam-count {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--accent-text);
  }
  .category-fam-meta {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ── Toutes les variantes (grille de cartes partagées) ── */
  .category-grid-outer {
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-12);
  }
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
  }

  @media (max-width: 720px) {
    .category-mast,
    .category-fams-outer,
    .category-grid-outer {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>
