---
export const prerender = true;

// Page static · /library/config/onboarding · « Nouveau site » (C2 P4.4-g).
//
// Page GUIDÉE, peu de JS : la checklist est dérivée des étapes RÉELLES de FORK.md (cloner/build,
// site.config.ts, .env, apps.config.ts, contenu, déploiement). Le formulaire local
// (nom/domaine/langues/modules) PRÉVISUALISE, côté client, deux blocs à copier :
//   - un extrait site.config.ts prérempli (identité de marque, source unique FORK.md étape 2),
//   - un extrait apps-state.json (overrides d'activation des apps, FORK.md étape 4).
// Génération 100 % client (petit script is:inline), bouton « Copier », AUCUNE écriture serveur.
//
// noindex + hors sitemap : hérité du pattern /library/* (AtelierShell noindex, robots disallow,
// sitemap exclut library/**). 0 nouveau token DS (rule 60). 0 valeur en dur. 0 U+2014 (rule 58).

import AtelierShell from '../../../layouts/AtelierShell.astro';
import Kicker from '../../../components/ui/atoms/Kicker.astro';

// Étapes réelles de FORK.md (source de vérité = FORK.md à la racine). Titre + résumé court.
const STEPS = [
  {
    n: 1,
    title: 'Fork, clone, build de contrôle',
    body: 'Fork GitHub, clone, puis npx pnpm@9.15.0 install && build. Le build doit finir sur « Complete! » (baseline astro check : 8 erreurs pré-existantes, 0 ajoutée).',
  },
  {
    n: 2,
    title: 'Identité de marque · src/site.config.ts',
    body: "Toute la marque (url, name, coordonnées, réseaux, Cal.com) vit dans l'objet SITE. Édite ces valeurs, rebuild pour vérifier. Le formulaire ci-dessous t'en prépare un extrait.",
  },
  {
    n: 3,
    title: 'Secrets & runtime · .env',
    body: 'cp .env.example .env, puis renseigne RESEND_API_KEY, EMAIL_FROM, MAILERLITE_API_KEY, PUBLIC_SITE_URL… (secrets, jamais versionnés). Astro inline import.meta.env AU build.',
  },
  {
    n: 4,
    title: 'Apps internes · src/apps.config.ts',
    body: "Active/désactive les outils internes (dashboard SEO, DS Studio, builder) via leur champ enabled. Les modules décochés ci-dessous produisent l'extrait apps-state.json correspondant.",
  },
  {
    n: 5,
    title: 'Contenu · src/content/**',
    body: 'Le contenu vit en collections JSON (0 .mdx). Édite/duplique un JSON existant ou compose une page via le builder. La rédaction est le vrai travail (pas « quelques minutes »).',
  },
  {
    n: 6,
    title: 'Déploiement · Vercel',
    body: 'Importe le repo, renseigne les env vars AVANT le premier build, connecte ton domaine. La build command par défaut (astro build) fonctionne telle quelle.',
  },
] as const;

// Modules = apps internes du registre (miroir des ids apps.config.ts). Cochés par défaut = actifs.
const MODULES = [
  { id: 'seoDashboard', label: 'Dashboard SEO', hint: 'route /dashboard-seo' },
  { id: 'dsStudio', label: 'DS Studio', hint: 'route /library/studio' },
  { id: 'builder', label: 'Builder de pages', hint: 'route /library/builder' },
] as const;
---

<AtelierShell
  title="Nouveau site · onboarding fork · Library Waimia"
  description="Assistant de fork Waimia : checklist des étapes réelles (clone, identité de marque, apps, contenu, déploiement) et générateur local des extraits de configuration à copier."
  active="config"
>
  <section class="onb-hd">
    <div class="onb-wrap">
      <Kicker class="onb-kicker">§ Configuration · démarrer un nouveau site</Kicker>
      <h1 class="onb-h1">Forke, <i>rebranding</i> en quelques minutes.</h1>
      <p class="onb-lede">
        Le repo est conçu pour être forké : la marque et les apps sont centralisées dans quelques
        fichiers. Suis la checklist, puis prépare tes extraits de config avec le formulaire. Tout est
        local, rien n'est écrit sur le serveur.
      </p>
      <a class="onb-back" href="/library/config">
        <span aria-hidden="true">&#8592;</span> Retour à la config
      </a>
    </div>
  </section>

  <section class="onb-body onb-wrap">
    <div class="onb-cols">
      {/* ── Checklist (dérivée de FORK.md) ── */}
      <div class="onb-steps-col">
        <h2 class="onb-h2">Checklist du fork</h2>
        <ol class="onb-steps">
          {STEPS.map((step) => (
            <li class="onb-step">
              <span class="onb-step-n" aria-hidden="true">{step.n}</span>
              <div class="onb-step-txt">
                <h3 class="onb-step-title">{step.title}</h3>
                <p class="onb-step-body">{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      {/* ── Formulaire local + prévisualisation ── */}
      <div class="onb-form-col">
        <h2 class="onb-h2">Prépare ta config</h2>
        <form id="onb-form" class="onb-form" autocomplete="off">
          <label class="onb-field">
            <span class="onb-field-label">Nom de marque</span>
            <input id="onb-name" class="onb-input" type="text" value="Solstice" placeholder="Ton nom de marque" />
          </label>
          <label class="onb-field">
            <span class="onb-field-label">Domaine</span>
            <input id="onb-domain" class="onb-input" type="text" value="solstice.fr" placeholder="exemple.com" />
          </label>

          <fieldset class="onb-fieldset">
            <legend class="onb-field-label">Langues</legend>
            <label class="onb-check">
              <input type="checkbox" class="onb-lang" value="fr" checked /> Français
            </label>
            <label class="onb-check">
              <input type="checkbox" class="onb-lang" value="en" /> English
            </label>
          </fieldset>

          <fieldset class="onb-fieldset">
            <legend class="onb-field-label">Modules internes (décoche pour désactiver)</legend>
            {MODULES.map((m) => (
              <label class="onb-check">
                <input type="checkbox" class="onb-module" value={m.id} checked />
                <span class="onb-check-main">{m.label}</span>
                <span class="onb-check-hint">{m.hint}</span>
              </label>
            ))}
          </fieldset>
        </form>

        <div class="onb-preview">
          <div class="onb-preview-head">
            <h3 class="onb-preview-title">src/site.config.ts <span class="onb-preview-sub">(extrait)</span></h3>
            <button type="button" class="onb-copy" data-copy-target="onb-out-site">Copier</button>
          </div>
          <pre class="onb-code"><code id="onb-out-site"></code></pre>
        </div>

        <div class="onb-preview">
          <div class="onb-preview-head">
            <h3 class="onb-preview-title">src/data/apps-state.json</h3>
            <button type="button" class="onb-copy" data-copy-target="onb-out-apps">Copier</button>
          </div>
          <pre class="onb-code"><code id="onb-out-apps"></code></pre>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const form = document.getElementById('onb-form');
      if (!form) return;
      const outSite = document.getElementById('onb-out-site');
      const outApps = document.getElementById('onb-out-apps');
      const nameEl = document.getElementById('onb-name');
      const domainEl = document.getElementById('onb-domain');

      // Échappe une valeur pour l'insérer dans un littéral TS entre apostrophes.
      const esc = (v) => String(v).replace(/\\/g, '\\\\').replace(/'/g, "\\'");

      function render() {
        const name = (nameEl && nameEl.value.trim()) || 'Ma marque';
        const domain = (domainEl && domainEl.value.trim().replace(/^https?:\/\//, '').replace(/\/$/, '')) || 'exemple.com';
        const langs = Array.from(document.querySelectorAll('.onb-lang'))
          .filter((c) => c.checked)
          .map((c) => c.value);
        const disabled = Array.from(document.querySelectorAll('.onb-module'))
          .filter((c) => !c.checked)
          .map((c) => c.value);

        // Extrait site.config.ts (identité de marque, FORK.md étape 2).
        const langLine = langs.length
          ? `// Langues visées : ${langs.join(', ')} (le repo est FR monolingue aujourd'hui, informatif).\n`
          : '';
        const siteBlock =
          langLine +
          'export const SITE = {\n' +
          `  url: 'https://${esc(domain)}',\n` +
          `  name: '${esc(name)}',\n` +
          `  legalName: '${esc(name)}',\n` +
          `  email: 'bonjour@${esc(domain)}',\n` +
          `  emailFrom: '${esc(name)} <hello@${esc(domain)}>',\n` +
          '  // …reprends les autres champs depuis src/site.config.ts (tel, adresse, réseaux, cal).\n' +
          '} as const;';

        // Extrait apps-state.json (overrides d'activation, FORK.md étape 4).
        let appsObj = '{}';
        if (disabled.length) {
          const lines = disabled.map((id) => `    "${id}": false`).join(',\n');
          appsObj = `{\n${lines}\n  }`;
        }
        const appsBlock = `{\n  "apps": ${appsObj}\n}`;

        if (outSite) outSite.textContent = siteBlock;
        if (outApps) outApps.textContent = appsBlock;
      }

      form.addEventListener('input', render);
      form.addEventListener('change', render);
      render();

      // Copier : navigator.clipboard avec repli execCommand (aucune écriture réseau).
      document.querySelectorAll('.onb-copy').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const targetId = btn.getAttribute('data-copy-target');
          const el = targetId && document.getElementById(targetId);
          if (!el) return;
          const text = el.textContent || '';
          const done = () => {
            const prev = btn.textContent;
            btn.textContent = 'Copié';
            setTimeout(() => { btn.textContent = prev; }, 1400);
          };
          try {
            await navigator.clipboard.writeText(text);
            done();
          } catch {
            const range = document.createRange();
            range.selectNodeContents(el);
            const sel = window.getSelection();
            if (sel) { sel.removeAllRanges(); sel.addRange(range); }
            try { document.execCommand('copy'); done(); } catch { /* no-op */ }
            if (sel) sel.removeAllRanges();
          }
        });
      });
    })();
  </script>
</AtelierShell>

<style>
  .onb-wrap {
    width: min(100%, var(--wrap-tight));
    margin-inline: auto;
    padding-inline: var(--space-6);
  }
  .onb-hd { padding-block: var(--space-8) var(--space-5); }
  .onb-kicker { display: block; margin-bottom: var(--space-3); }
  .onb-h1 {
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    letter-spacing: var(--tracking-display);
    font-weight: var(--fw-semibold);
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .onb-h1 i {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: var(--fw-regular);
    color: var(--accent-text);
  }
  .onb-lede {
    margin-top: var(--space-3);
    max-width: 64ch;
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--ink-2);
  }
  .onb-back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--accent-text);
    text-decoration: none;
  }
  .onb-back:hover { text-decoration: underline; }

  .onb-body { padding-block: var(--space-4) var(--space-10); }
  .onb-cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }
  @media (max-width: 1023.98px) {
    .onb-cols { grid-template-columns: minmax(0, 1fr); }
  }

  .onb-h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: var(--fw-semibold);
    color: var(--ink);
    margin: 0 0 var(--space-4);
  }

  .onb-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-4); }
  .onb-step { display: flex; gap: var(--space-3); }
  .onb-step-n {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--space-7);
    height: var(--space-7);
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    line-height: 1;
  }
  .onb-step-title {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--fw-semibold);
    color: var(--ink);
    margin: 0 0 var(--space-1);
  }
  .onb-step-body {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--ink-2);
    margin: 0;
  }

  .onb-form { display: flex; flex-direction: column; gap: var(--space-4); margin-bottom: var(--space-5); }
  .onb-field { display: flex; flex-direction: column; gap: var(--space-1); }
  .onb-field-label {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    color: var(--muted);
  }
  .onb-input {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
  }
  .onb-input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

  .onb-fieldset {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
  }
  .onb-fieldset legend { padding: 0 var(--space-1); }
  .onb-check {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--ink);
  }
  .onb-check-hint { font-family: var(--font-mono); font-size: var(--text-micro); color: var(--muted); }

  .onb-preview { margin-bottom: var(--space-4); }
  .onb-preview-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); margin-bottom: var(--space-2); }
  .onb-preview-title {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--ink);
    margin: 0;
  }
  .onb-preview-sub { color: var(--muted); }
  .onb-copy {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .onb-copy:hover { background: var(--ink); color: var(--paper); }
  .onb-copy:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .onb-code {
    margin: 0;
    padding: var(--space-3);
    background: var(--paper-2);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    overflow-x: auto;
  }
  .onb-code code {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--ink);
    white-space: pre;
  }
</style>
