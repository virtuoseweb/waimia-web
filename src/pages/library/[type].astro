---
export const prerender = true;

// Page static · /library/[type] · CLONE adapté de components/[type].astro (U0, §11.2 docs/design-system/03).
//
// Fiche technique d'une section : grand aperçu live (iframe /preview/[type], cible INCHANGÉE) +
// bloc « copier le code » + métadonnées. Une page par section.type du registry.
// Pour U0 = clone fonctionnel : l'enrichissement variantes + toggle animation est une autre unité.
// Seuls changements vs components/[type] :
//   - DsLocalNav scope="library"
//   - lien retour vers /library/[category] au lieu de /categories/[slug].
// 0 nouveau token, 0 valeur en dur, 0 U+2014.
//
// NB collision de routes : /library/[category] et /library/[type] coexistent au même niveau ;
// leurs getStaticPaths émettent des paths DISJOINTS (slugs de catégories en '*-sections'/'timelines'
// vs types de section), donc aucun path n'est généré deux fois (cf astro prerender-route-conflict).

import Base from '../../layouts/Base.astro';
import DsLocalNav from '../../components/library/DsLocalNav.astro';
import CopyCode from '../../components/library/CopyCode.tsx';
import VariantToggle from '../../components/library/VariantToggle.tsx';
import {
  listSections,
  listCategories,
  type SectionListItem,
} from '../../lib/section-registry';
import { SECTION_DEMOS } from '../../lib/section-demos';
import { getUsage, getConsumers } from '../../lib/library-manifest';
import { listPresets } from '../../lib/section-presets';

export function getStaticPaths() {
  return listSections().map((section) => ({
    params: { type: section.type },
    props: { section },
  }));
}

interface Props {
  section: SectionListItem;
}

const { section } = Astro.props;

const categoryLabel =
  listCategories().find((c) => c.slug === section.categorySlug)?.label ?? section.subcategory;

// Étiquetage catalogue (docs/40 §3) : usage 'site' | 'library'.
const usage = getUsage(section.type);
const consumerCount = getConsumers(section.type).length;

// Code copiable : l'entrée telle qu'on la placerait dans le sections[] d'une page W6.
const demo = SECTION_DEMOS[section.type];
const sectionEntry = JSON.stringify(demo, null, 2);

// Déclinaisons (presets) de cette variante : combinaisons nommées « layout × palette × densité »
// (taxonomie docs/45 niveau 4). Prévisualisées via /preview/[type]/[preset].
const presets = listPresets(section.type);
---

<Base
  title={`${section.type} · Composant Waimia`}
  description={section.description_fr}
  alternate={false}
  noindex
>
  <article class="component-detail">
    <div class="wrap-wide">
      <DsLocalNav active="catalogue" scope="library" note="Ici : la fiche technique d'une section. Aperçu en rendu isolé + données à copier dans sections[]." />
      <a class="component-back" href={`/library/${section.categorySlug}`}>
        ← {categoryLabel}
      </a>

      <header class="component-head">
        <div class="component-head-top">
          <h1>{section.type}</h1>
          <span class={`component-status component-status--${section.status}`}>{section.status}</span>
          {usage === 'site' ? (
            <span class="component-usage component-usage--site">Sur waimia · {consumerCount}</span>
          ) : (
            <span class="component-usage component-usage--library">Bibliothèque</span>
          )}
        </div>
        <p class="component-subcat">{section.subcategory}</p>
        <p class="component-lede">{section.description_fr}</p>
        {section.family && (
          <p class="component-family">
            Famille : <a href={`/library/family/${section.family}`}>{section.family}</a>
          </p>
        )}
        <div class="component-tags" aria-label={`Tags ${section.type}`}>
          {section.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </header>

      <section class="component-block" aria-label="Aperçu live">
        <h2 class="component-block-title">Aperçu</h2>
        <VariantToggle
          client:visible
          type={section.type}
          title={`Aperçu ${section.type}`}
        />
      </section>

      {presets.length > 0 && (
        <section class="component-block" aria-label="Déclinaisons de la section">
          <h2 class="component-block-title">Déclinaisons · {presets.length}</h2>
          <p class="component-presets-lede">
            Combinaisons nommées « variante × palette × densité » appliquées à ce composant, prévisualisées en rendu isolé.
          </p>
          <ul class="component-presets">
            {presets.map((preset) => (
              <li class="component-preset">
                <div class="component-preset-preview" data-preview-frame data-max-height="260" aria-hidden="true">
                  <iframe class="component-preset-frame" src={`/preview/${section.type}/${preset.id}`} title={`Aperçu ${preset.label}`} loading="lazy" tabindex="-1" scrolling="no"></iframe>
                </div>
                <p class="component-preset-label">{preset.label}</p>
                <code class="component-preset-id">{preset.id}</code>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="component-block" aria-label="Code de la section">
        <h2 class="component-block-title">Code</h2>
        <CopyCode
          client:visible
          code={sectionEntry}
          label="Données de la section (à placer dans sections[])"
        />
      </section>
    </div>
  </article>

  <script>import '../../scripts/preview-frame.ts';</script>
</Base>

<style>
  .component-detail {
    padding: var(--section-base) 0 var(--section-base);
  }
  .component-detail .wrap-wide {
    padding-left: var(--space-6);
    padding-right: var(--space-6);
  }
  .component-back {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 28px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-decoration: none;
  }
  .component-back:hover { color: var(--accent-text); }
  .component-head {
    margin-bottom: var(--space-9);
  }
  .component-head-top {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .component-head h1 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-h2);
    font-weight: var(--fw-regular);
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .component-status {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--hairline);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    line-height: 1;
    padding: 6px var(--space-2);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .component-status--stable {
    border-color: var(--accent-text);
    color: var(--accent-text);
  }
  .component-status--wip {
    border-color: var(--muted-2);
    color: var(--muted);
  }
  .component-status--deprecated {
    border-color: var(--hairline-strong);
    color: var(--muted-2);
  }
  .component-usage {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--hairline);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    line-height: 1;
    padding: 6px var(--space-2);
    white-space: nowrap;
    letter-spacing: 0.04em;
  }
  .component-usage--site {
    border-color: var(--accent-text);
    color: var(--accent-text);
  }
  .component-usage--library {
    border-color: var(--hairline-strong);
    color: var(--muted);
  }
  .component-subcat {
    margin: 18px 0 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .component-lede {
    max-width: 680px;
    margin: var(--space-4) 0 0;
    color: var(--ink-2);
    font-size: var(--text-h3);
    line-height: 1.55;
  }
  .component-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 22px;
  }
  .component-tags span {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    background: var(--paper-2);
    border: 1px solid var(--hairline);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    line-height: 1;
    padding: 6px 7px;
  }
  .component-block {
    margin-top: var(--space-9);
  }
  .component-block-title {
    margin: 0 0 18px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: var(--fw-regular);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .component-family {
    margin: var(--space-4) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--muted);
  }
  .component-family a {
    color: var(--accent-text);
    text-decoration: none;
    text-transform: capitalize;
  }
  .component-family a:hover { text-decoration: underline; }

  /* L'aperçu (iframe + toggles animation/dark) est rendu par l'island
     VariantToggle.tsx ; il porte son propre conteneur .vt-preview[data-preview-frame]
     mis à l'échelle par src/scripts/preview-frame.ts. */

  /* ── Déclinaisons (presets) ── */
  .component-presets-lede {
    margin: 0 0 var(--space-5);
    max-width: 60ch;
    color: var(--ink-2);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: 1.55;
  }
  .component-presets {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .component-preset {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .component-preset-preview {
    display: block;
    position: relative;
    min-height: 140px;
    overflow: hidden;
    border: 1px solid var(--hairline);
    background: var(--paper);
  }
  .component-preset-frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 1280px;
    border: 0;
    transform-origin: top left;
    pointer-events: none;
  }
  .component-preset-label {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-lede);
  }
  .component-preset-id {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
  }

  @media (max-width: 720px) {
    .component-detail .wrap-wide {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>
