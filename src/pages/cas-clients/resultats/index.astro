---
// Page · /cas-clients/resultats · Hub « Résultats obtenus »
// Liste les 5 types de résultat, chacun liant vers sa page d'agrégation de cas réels.
// Reprend verbatim l'idiome res-grid / res-card / res-method des 5 pages enfants
// (cohérence visuelle stricte). 0 chiffre inventé : aucun chiffre ici, le hub n'agrège
// que des intitulés de résultat, les métriques vivent dans les pages enfants.
export const prerender = true;

import UtilityTemplate from '../../../components/templates/UtilityTemplate.astro';
import Kicker from '../../../components/ui/atoms/Kicker.astro';

const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Résultats obtenus · cas clients · Waimia',
  description:
    "Nos cas réels, triés par le résultat que vous cherchez : plus de leads, temps marketing réduit, données centralisées, processus automatisés, qualification commerciale.",
  url: `https://waimia.com${Astro.url.pathname}`,
};

// Les 5 résultats agrégés, chacun pointant vers sa page d'agrégation de cas réels.
const results = [
  {
    kicker: '§ Résultat · acquisition',
    title: 'Plus de leads',
    excerpt:
      "Capter et qualifier ce qui arrive déjà au lieu de subir le trafic : parcours clair, formulaires courts, capture branchée au CRM.",
    href: '/cas-clients/resultats/plus-de-leads',
    cta: 'Voir les cas',
  },
  {
    kicker: '§ Résultat · productivité',
    title: 'Réduction du temps marketing',
    excerpt:
      "Moins d'heures perdues en tâches répétitives : production, publication et reporting allégés pour rendre du temps aux équipes.",
    href: '/cas-clients/resultats/reduction-temps-marketing',
    cta: 'Voir les cas',
  },
  {
    kicker: '§ Résultat · données',
    title: 'Centralisation des données',
    excerpt:
      "Des outils qui se parlent enfin : le CRM et les outils métier reliés en une source unique, sans ressaisie ni chiffres qui divergent.",
    href: '/cas-clients/resultats/centralisation-donnees',
    cta: 'Voir les cas',
  },
  {
    kicker: '§ Résultat · opérations',
    title: 'Automatisation des processus',
    excerpt:
      "Les enchaînements manuels confiés à des agents auditables : la tâche s'exécute seule, traçable, sans boîte noire.",
    href: '/cas-clients/resultats/automatisation-processus',
    cta: 'Voir les cas',
  },
  {
    kicker: '§ Résultat · commercial',
    title: 'Meilleure qualification commerciale',
    excerpt:
      "Trier le bon signal du bruit : scoring comportemental et routage pour que les commerciaux parlent aux bons contacts au bon moment.",
    href: '/cas-clients/resultats/qualification-commerciale',
    cta: 'Voir les cas',
  },
];

const method = {
  kicker: '§ Discuter de votre cas',
  title: 'Quel résultat cherchez-vous ?',
  excerpt:
    "Si aucun de ces résultats ne correspond exactement à votre situation, parlons-en. Nous ne promettons pas un chiffre avant de l'avoir mesuré sur vos données.",
  href: '/contact',
  cta: 'Démarrer un diagnostic',
};
---
<UtilityTemplate
  title="Résultats obtenus · cas clients · Waimia"
  description="Nos cas réels, triés par le résultat que vous cherchez : plus de leads, temps marketing réduit, données centralisées, processus automatisés, qualification commerciale."
  jsonLd={pageLd}
  kicker="§ Résultats obtenus"
  align="left"
  headlineFr="Triés par le <i>résultat</i> que vous cherchez."
  headlineEn="Sorted by the <i>result</i> you are looking for."
  ledeFr="Plutôt que de parcourir tous nos cas, choisissez d'abord le résultat qui compte pour vous. Chaque page rassemble les projets réels où nous l'avons obtenu, avec leurs chiffres mesurés."
  ledeEn="Rather than browsing every case, start with the result that matters to you. Each page gathers the real projects where we achieved it, with their measured figures."
>
  <Fragment slot="body">
    <div class="res-intro reveal">
      <p>
        Nos cas réels, triés par le résultat que vous cherchez. ROI mesuré sur
        les données du client, jamais inventé. Quand un cas est en cours, nous le
        disons. Choisissez un résultat ci-dessous pour voir les projets qui
        l'illustrent.
      </p>
    </div>

    <div class="res-grid reveal-stagger">
      {results.map((r) => (
        <a href={r.href} class="res-card">
          <Kicker tone="" class="res-card-kicker">{r.kicker}</Kicker>
          <h2 class="res-card-title">{r.title}</h2>
          <p class="res-card-excerpt">{r.excerpt}</p>
          <span class="res-card-cta">{r.cta} →</span>
        </a>
      ))}
    </div>

    <div class="res-method reveal">
      <Kicker tone="" class="res-method-kicker">{method.kicker}</Kicker>
      <h2 class="res-method-title">{method.title}</h2>
      <p class="res-method-excerpt">{method.excerpt}</p>
      <a href={method.href} class="res-method-link">{method.cta} →</a>
    </div>
  </Fragment>
</UtilityTemplate>

<style>
  .res-intro { max-width: 720px; margin-bottom: var(--space-9); }
  .res-intro p {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: var(--leading-prose);
    color: var(--muted);
    margin: 0;
    text-wrap: pretty;
  }

  .res-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    margin-bottom: var(--space-10);
  }
  .res-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-7) var(--space-6);
    background: var(--paper);
    text-decoration: none;
    color: inherit;
    border-top: 1px solid transparent;
    transition:
      background var(--dur-trim) var(--ease),
      border-top-color var(--dur-trim) var(--ease),
      transform var(--dur-trim) var(--ease);
  }
  .res-card:hover {
    background: var(--paper-2);
    border-top-color: var(--accent-text);
    transform: translateY(-2px);
  }
  :global(.res-card-kicker) { display: block; }
  .res-card-title {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: var(--fw-medium);
    letter-spacing: -0.015em;
    line-height: 1.05;
    margin: 0;
    text-wrap: balance;
  }
  .res-card-excerpt {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--muted);
    margin: 0;
    flex: 1;
  }
  .res-card-cta {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--accent-text);
    margin-top: var(--space-2);
  }

  .res-method {
    border: 1px solid var(--hairline);
    background: var(--paper-2);
    padding: var(--space-8) var(--space-7);
    max-width: 820px;
  }
  :global(.res-method-kicker) { display: block; margin-bottom: var(--space-3); }
  .res-method-title {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.02em;
    line-height: var(--leading-h3);
    margin: 0 0 var(--space-3);
    text-wrap: balance;
  }
  .res-method-excerpt {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--ink-2);
    margin: 0 0 var(--space-5);
    max-width: 60ch;
  }
  .res-method-link {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--accent-text);
    text-decoration: none;
  }

  @media (max-width: 800px) {
    .res-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .res-card { transition: none !important; transform: none !important; }
  }
</style>
