---
// Page · /cas-clients/resultats/plus-de-leads
// Agrégation des cas réels qui illustrent le résultat « plus de leads ».
// 0 chiffre inventé : chaque métrique citée provient d'un fichier de cas réel.
export const prerender = true;

import UtilityTemplate from '../../../components/templates/UtilityTemplate.astro';
import Kicker from '../../../components/ui/atoms/Kicker.astro';

const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Plus de leads · résultats obtenus · Waimia',
  description:
    "Comment nos cas réels transforment un site qui subit le trafic en site qui capte et qualifie. Des projets mesurés, pas des promesses.",
  url: `https://waimia.com${Astro.url.pathname}`,
};

// Cas réels rattachés à ce résultat (collections cases + cas-usages).
const cases = [
  {
    kicker: '§ Cas client · Patrimoine et média local',
    title: 'Les Carnets de Montpellier',
    excerpt:
      "De zéro présence en ligne à une communauté payante : 40+ articles, 150+ membres et 35+ abonnés payants en trois mois, avec un Top 10 sur « histoire montpellier ».",
    href: '/cas-clients/les-carnets-de-montpellier',
    cta: 'Lire le cas',
  },
  {
    kicker: '§ Cas client · Artisanat et bâtiment',
    title: 'Desangles Peinture',
    excerpt:
      "De la page 6 à la page 1 de Google en référencement local. Une visibilité retrouvée qui ramène des demandes de devis là où le site n'en générait quasiment aucune.",
    href: '/cas-clients/desangles-peinture',
    cta: 'Lire le cas',
  },
  {
    kicker: '§ Cas client · E-commerce écoresponsable',
    title: 'Balzeo',
    excerpt:
      "Un site deux fois plus rapide sur mobile, une rétention des visiteurs en hausse de 35 % et des interactions catalogue triplées : un trafic enfin retenu au lieu d'être perdu.",
    href: '/cas-clients/balzeo',
    cta: 'Lire le cas',
  },
  {
    kicker: '§ Cas client · Santé et bien-être',
    title: 'Isabelle Diaz, naturopathe',
    excerpt:
      "Une présence en ligne crédible pensée pour la prise de rendez-vous. Mission en cours : les premiers livrables sont posés, les résultats se mesureront dans la durée.",
    href: '/cas-clients/isabelle-diaz-naturopathe',
    cta: 'Lire le cas',
  },
];

// Le dispositif générique (méthode) rattaché à ce résultat.
const method = {
  kicker: '§ Le dispositif · résoudre un problème',
  title: 'Générer plus de leads',
  excerpt:
    "Le vrai sujet n'est pas d'attirer plus, c'est de capter et qualifier ce qui arrive déjà : formulaires courts, parcours clair, scoring comportemental et capture branchés au CRM.",
  href: '/cas-usages/generer-plus-de-leads',
  cta: 'Voir la méthode',
};
---
<UtilityTemplate
  title="Plus de leads · résultats obtenus · Waimia"
  description="Comment nos cas réels transforment un site qui subit le trafic en site qui capte et qualifie. Des projets mesurés, pas des promesses."
  jsonLd={pageLd}
  kicker="§ Résultats obtenus"
  align="left"
  headlineFr="Plus de <i>leads</i>, mesurés sur le terrain."
  headlineEn="More <i>leads</i>, measured in the field."
  ledeFr="Un site qui reçoit des visites mais ne convertit pas perd ce qu'il paie déjà. Voici les projets réels où nous avons transformé le trafic en demandes : visibilité retrouvée, parcours qui qualifie, communauté qui s'abonne."
  ledeEn="A site that gets visits but doesn't convert wastes what it already pays for. Here are the real projects where we turned traffic into requests: visibility regained, a qualifying path, a community that subscribes."
>
  <Fragment slot="body">
    <div class="res-intro reveal">
      <p>
        Ce résultat ne se promet pas, il se constate. Chaque cas ci-dessous a été
        publié une fois le résultat mesuré et l'accord du client obtenu. Quand un
        chiffre est affiché, il vient des données du projet, pas d'une moyenne de
        marché. Quand un cas est en cours, nous le disons.
      </p>
    </div>

    <div class="res-grid reveal-stagger">
      {cases.map((c) => (
        <a href={c.href} class="res-card">
          <Kicker tone="" class="res-card-kicker">{c.kicker}</Kicker>
          <h2 class="res-card-title">{c.title}</h2>
          <p class="res-card-excerpt">{c.excerpt}</p>
          <span class="res-card-cta">{c.cta} →</span>
        </a>
      ))}
    </div>

    <div class="res-method reveal">
      <Kicker tone="" class="res-method-kicker">{method.kicker}</Kicker>
      <h2 class="res-method-title">{method.title}</h2>
      <p class="res-method-excerpt">{method.excerpt}</p>
      <a href={method.href} class="res-method-link">{method.cta} →</a>
    </div>
  </Fragment>
</UtilityTemplate>

<style>
  .res-intro { max-width: 720px; margin-bottom: var(--space-9); }
  .res-intro p {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: var(--leading-prose);
    color: var(--muted);
    margin: 0;
    text-wrap: pretty;
  }

  .res-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    margin-bottom: var(--space-10);
  }
  .res-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-7) var(--space-6);
    background: var(--paper);
    text-decoration: none;
    color: inherit;
    border-top: 1px solid transparent;
    transition:
      background var(--dur-trim) var(--ease),
      border-top-color var(--dur-trim) var(--ease),
      transform var(--dur-trim) var(--ease);
  }
  .res-card:hover {
    background: var(--paper-2);
    border-top-color: var(--accent-text);
    transform: translateY(-2px);
  }
  :global(.res-card-kicker) { display: block; }
  .res-card-title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: var(--fw-regular);
    letter-spacing: -0.015em;
    line-height: 1.05;
    margin: 0;
    text-wrap: balance;
  }
  .res-card-excerpt {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--muted);
    margin: 0;
    flex: 1;
  }
  .res-card-cta {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--accent-text);
    margin-top: var(--space-2);
  }

  .res-method {
    border: 1px solid var(--hairline);
    background: var(--paper-2);
    padding: var(--space-8) var(--space-7);
    max-width: 820px;
  }
  :global(.res-method-kicker) { display: block; margin-bottom: var(--space-3); }
  .res-method-title {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: var(--fw-regular);
    letter-spacing: -0.02em;
    line-height: var(--leading-h3);
    margin: 0 0 var(--space-3);
    text-wrap: balance;
  }
  .res-method-excerpt {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--ink-2);
    margin: 0 0 var(--space-5);
    max-width: 60ch;
  }
  .res-method-link {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--accent-text);
    text-decoration: none;
  }

  @media (max-width: 800px) {
    .res-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .res-card { transition: none !important; transform: none !important; }
  }
</style>
