---
// Page · /cas-clients/resultats/automatisation-processus
// Agrégation des cas réels qui illustrent le résultat « automatisation des processus ».
// 0 chiffre inventé : chaque métrique citée provient d'un fichier de cas réel.
export const prerender = true;

import UtilityTemplate from '../../../components/templates/UtilityTemplate.astro';
import Kicker from '../../../components/ui/atoms/Kicker.astro';

const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Automatisation des processus · résultats obtenus · Waimia',
  description:
    "Des gestes répétés chaque jour, un savoir-faire qui dépend d'une personne : nos cas réels automatisent le répétitif sous contrôle humain, pour une qualité constante.",
  url: `https://waimia.com${Astro.url.pathname}`,
};

const cases = [
  {
    kicker: '§ Cas client · RH et santé au travail',
    title: 'Amploi',
    excerpt:
      "Les demandes entrantes captées proprement et routées automatiquement dans HubSpot via la Forms API, sans saisie manuelle ni perte d'information : un geste répétitif retiré du quotidien des équipes.",
    href: '/cas-clients/amploi',
    cta: 'Lire le cas',
  },
];

const method = {
  kicker: '§ Le dispositif · résoudre un problème',
  title: 'Standardiser ses processus',
  excerpt:
    "Comprendre, simplifier, formaliser, puis seulement outiller : on formalise l'essentiel et on automatise le répétitif, en gardant la main humaine sur les décisions sensibles. Rien ne tourne en boîte noire.",
  href: '/cas-usages/standardiser-processus',
  cta: 'Voir la méthode',
};
---
<UtilityTemplate
  title="Automatisation des processus · résultats obtenus · Waimia"
  description="Des gestes répétés chaque jour, un savoir-faire qui dépend d'une personne : nos cas réels automatisent le répétitif sous contrôle humain, pour une qualité constante."
  jsonLd={pageLd}
  kicker="§ Résultats obtenus"
  align="left"
  headlineFr="Le répétitif <i>automatisé</i>, le jugement préservé."
  headlineEn="The repetitive <i>automated</i>, judgement preserved."
  ledeFr="Quand les mêmes gestes se répètent chaque jour et que le savoir-faire vit dans une ou deux têtes, le temps part dans la mécanique et la qualité vacille. Voici le projet réel où nous avons retiré un geste manuel récurrent."
  ledeEn="When the same actions repeat every day and know-how lives in one or two heads, time goes into the mechanics and quality wavers. Here is the real project where we removed a recurring manual step."
>
  <Fragment slot="body">
    <div class="res-intro reveal">
      <p>
        Automatiser n'est pas figer chaque geste ni retirer le jugement. On
        cible le répétitif, on le câble, et on définit explicitement où un humain
        valide. Le cas ci-dessous montre ce résultat sur un projet réel ; la
        méthode générique, applicable à un onboarding, un tri de demandes ou une
        préparation de dossier, est détaillée juste après.
      </p>
    </div>

    <div class="res-grid res-grid--single reveal-stagger">
      {cases.map((c) => (
        <a href={c.href} class="res-card">
          <Kicker tone="" class="res-card-kicker">{c.kicker}</Kicker>
          <h2 class="res-card-title">{c.title}</h2>
          <p class="res-card-excerpt">{c.excerpt}</p>
          <span class="res-card-cta">{c.cta} →</span>
        </a>
      ))}
    </div>

    <div class="res-method reveal">
      <Kicker tone="" class="res-method-kicker">{method.kicker}</Kicker>
      <h2 class="res-method-title">{method.title}</h2>
      <p class="res-method-excerpt">{method.excerpt}</p>
      <a href={method.href} class="res-method-link">{method.cta} →</a>
    </div>
  </Fragment>
</UtilityTemplate>

<style>
  .res-intro { max-width: 720px; margin-bottom: var(--space-9); }
  .res-intro p {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: var(--leading-prose);
    color: var(--muted);
    margin: 0;
    text-wrap: pretty;
  }

  .res-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    margin-bottom: var(--space-10);
  }
  .res-grid--single { grid-template-columns: 1fr; max-width: 820px; }
  .res-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-7) var(--space-6);
    background: var(--paper);
    text-decoration: none;
    color: inherit;
    border-top: 1px solid transparent;
    transition:
      background var(--dur-trim) var(--ease),
      border-top-color var(--dur-trim) var(--ease),
      transform var(--dur-trim) var(--ease);
  }
  .res-card:hover {
    background: var(--paper-2);
    border-top-color: var(--accent-text);
    transform: translateY(-2px);
  }
  :global(.res-card-kicker) { display: block; }
  .res-card-title {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: var(--fw-medium);
    letter-spacing: -0.015em;
    line-height: 1.05;
    margin: 0;
    text-wrap: balance;
  }
  .res-card-excerpt {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--muted);
    margin: 0;
    flex: 1;
  }
  .res-card-cta {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--accent-text);
    margin-top: var(--space-2);
  }

  .res-method {
    border: 1px solid var(--hairline);
    background: var(--paper-2);
    padding: var(--space-8) var(--space-7);
    max-width: 820px;
  }
  :global(.res-method-kicker) { display: block; margin-bottom: var(--space-3); }
  .res-method-title {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.02em;
    line-height: var(--leading-h3);
    margin: 0 0 var(--space-3);
    text-wrap: balance;
  }
  .res-method-excerpt {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--ink-2);
    margin: 0 0 var(--space-5);
    max-width: 60ch;
  }
  .res-method-link {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--accent-text);
    text-decoration: none;
  }

  @media (max-width: 800px) {
    .res-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .res-card { transition: none !important; transform: none !important; }
  }
</style>
