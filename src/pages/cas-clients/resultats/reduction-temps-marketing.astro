---
// Page · /cas-clients/resultats/reduction-temps-marketing
// Agrégation des cas réels qui illustrent le résultat « réduction du temps marketing ».
// 0 chiffre inventé : chaque métrique citée provient d'un fichier de cas réel.
export const prerender = true;

import UtilityTemplate from '../../../components/templates/UtilityTemplate.astro';
import Kicker from '../../../components/ui/atoms/Kicker.astro';

const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Réduction du temps marketing · résultats obtenus · Waimia',
  description:
    "Reporting compilé à la main, CMS qui exige un développeur : nos cas réels rendent le temps marketing aux équipes. Des projets mesurés, pas des promesses.",
  url: `https://waimia.com${Astro.url.pathname}`,
};

const cases = [
  {
    kicker: '§ Cas client · E-commerce écoresponsable',
    title: 'Balzeo',
    excerpt:
      "Migration vers WordPress et WooCommerce : un back-office repris en main par l'équipe et un coût de maintenance mensuel réduit de 84 %. Moins de technique, plus d'autonomie.",
    href: '/cas-clients/balzeo',
    cta: 'Lire le cas',
  },
  {
    kicker: '§ Cas client · RH et santé au travail',
    title: 'Amploi',
    excerpt:
      "Un site marketing Astro éditable via TinaCMS : les équipes mettent à jour le contenu sans dépendre de la technique, avec la capture des leads routée automatiquement dans HubSpot.",
    href: '/cas-clients/amploi',
    cta: 'Lire le cas',
  },
];

const methods = [
  {
    kicker: '§ Le dispositif · résoudre un problème',
    title: 'Réduire le temps de reporting',
    excerpt:
      "Deux à trois jours par mois partent à extraire, recopier et mettre en forme un rapport. On automatise la compilation : sources consolidées, tableau à jour, vous gardez l'analyse.",
    href: '/cas-usages/reduire-reporting',
    cta: 'Voir la méthode',
  },
  {
    kicker: '§ Le dispositif · résoudre un problème',
    title: 'Réduire le temps passé sur le CMS',
    excerpt:
      "Un CMS git-based comme TinaCMS : édition en minutes, versionnée et réversible, sans la maintenance qui épuise. Vous éditez textes, prix et articles sans appeler un développeur.",
    href: '/cas-usages/reduire-temps-cms',
    cta: 'Voir la méthode',
  },
];
---
<UtilityTemplate
  title="Réduction du temps marketing · résultats obtenus · Waimia"
  description="Reporting compilé à la main, CMS qui exige un développeur : nos cas réels rendent le temps marketing aux équipes. Des projets mesurés, pas des promesses."
  jsonLd={pageLd}
  kicker="§ Résultats obtenus"
  align="left"
  headlineFr="Du temps marketing <i>rendu</i> aux équipes."
  headlineEn="Marketing time <i>given back</i> to teams."
  ledeFr="Le temps qui part en reporting compilé à la main, en maintenance invisible et en allers-retours avec un prestataire ne va pas à l'analyse ni au contenu. Voici les projets réels où nous l'avons libéré."
  ledeEn="The time lost to reporting compiled by hand, invisible maintenance and round trips with a provider never reaches analysis or content. Here are the real projects where we freed it."
>
  <Fragment slot="body">
    <div class="res-intro reveal">
      <p>
        Réduire le temps marketing, c'est retirer la couche pénible, pas le
        jugement. On automatise la compilation, la maintenance et l'édition
        technique ; l'interprétation et la décision restent chez vous. Les cas
        ci-dessous montrent ce gain sur des projets réels, avec les chiffres
        issus du projet quand ils existent.
      </p>
    </div>

    <div class="res-grid reveal-stagger">
      {cases.map((c) => (
        <a href={c.href} class="res-card">
          <Kicker tone="" class="res-card-kicker">{c.kicker}</Kicker>
          <h2 class="res-card-title">{c.title}</h2>
          <p class="res-card-excerpt">{c.excerpt}</p>
          <span class="res-card-cta">{c.cta} →</span>
        </a>
      ))}
    </div>

    <div class="res-methods reveal-stagger">
      {methods.map((m) => (
        <div class="res-method">
          <Kicker tone="" class="res-method-kicker">{m.kicker}</Kicker>
          <h2 class="res-method-title">{m.title}</h2>
          <p class="res-method-excerpt">{m.excerpt}</p>
          <a href={m.href} class="res-method-link">{m.cta} →</a>
        </div>
      ))}
    </div>
  </Fragment>
</UtilityTemplate>

<style>
  .res-intro { max-width: 720px; margin-bottom: var(--space-9); }
  .res-intro p {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: var(--leading-prose);
    color: var(--muted);
    margin: 0;
    text-wrap: pretty;
  }

  .res-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    margin-bottom: var(--space-10);
  }
  .res-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-7) var(--space-6);
    background: var(--paper);
    text-decoration: none;
    color: inherit;
    border-top: 1px solid transparent;
    transition:
      background var(--dur-trim) var(--ease),
      border-top-color var(--dur-trim) var(--ease),
      transform var(--dur-trim) var(--ease);
  }
  .res-card:hover {
    background: var(--paper-2);
    border-top-color: var(--accent-text);
    transform: translateY(-2px);
  }
  :global(.res-card-kicker) { display: block; }
  .res-card-title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: var(--fw-regular);
    letter-spacing: -0.015em;
    line-height: 1.05;
    margin: 0;
    text-wrap: balance;
  }
  .res-card-excerpt {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--muted);
    margin: 0;
    flex: 1;
  }
  .res-card-cta {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--accent-text);
    margin-top: var(--space-2);
  }

  .res-methods {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }
  .res-method {
    border: 1px solid var(--hairline);
    background: var(--paper-2);
    padding: var(--space-7) var(--space-6);
  }
  :global(.res-method-kicker) { display: block; margin-bottom: var(--space-3); }
  .res-method-title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: var(--fw-regular);
    letter-spacing: -0.02em;
    line-height: var(--leading-h3);
    margin: 0 0 var(--space-3);
    text-wrap: balance;
  }
  .res-method-excerpt {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--ink-2);
    margin: 0 0 var(--space-5);
    max-width: 60ch;
  }
  .res-method-link {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--accent-text);
    text-decoration: none;
  }

  @media (max-width: 800px) {
    .res-grid,
    .res-methods { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .res-card { transition: none !important; transform: none !important; }
  }
</style>
