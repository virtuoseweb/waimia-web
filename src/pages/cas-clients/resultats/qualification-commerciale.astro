---
// Page · /cas-clients/resultats/qualification-commerciale
// Agrégation des cas réels qui illustrent le résultat « meilleure qualification commerciale ».
// 0 chiffre inventé : chaque métrique citée provient d'un fichier de cas réel.
export const prerender = true;

import UtilityTemplate from '../../../components/templates/UtilityTemplate.astro';
import Kicker from '../../../components/ui/atoms/Kicker.astro';

const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Meilleure qualification commerciale · résultats obtenus · Waimia',
  description:
    "Tous les contacts dans le même sac, le commercial qui trie à la main : nos cas réels font remonter les leads chauds avec scoring et capture branchée au CRM.",
  url: `https://waimia.com${Astro.url.pathname}`,
};

const cases = [
  {
    kicker: '§ Cas client · RH et santé au travail',
    title: 'Amploi',
    excerpt:
      "Les demandes entrantes captées proprement et routées automatiquement dans le CRM HubSpot, sans ressaisie : le commercial reçoit une fiche contextualisée plutôt qu'un nom seul dans une boîte mail.",
    href: '/cas-clients/amploi',
    cta: 'Lire le cas',
  },
];

const method = {
  kicker: '§ Le dispositif · résoudre un problème',
  title: 'Qualifier les leads par le scoring',
  excerpt:
    "Chaque visite reçoit un score sur quatre signaux réels : pages vues, temps passé, source d'arrivée, récurrence. Seuls les leads au-dessus du seuil remontent au commercial, déjà contextualisés. Votre temps va sur les contacts prêts à parler.",
  href: '/cas-usages/generer-plus-de-leads',
  cta: 'Voir la méthode',
};
---
<UtilityTemplate
  title="Meilleure qualification commerciale · résultats obtenus · Waimia"
  description="Tous les contacts dans le même sac, le commercial qui trie à la main : nos cas réels font remonter les leads chauds avec scoring et capture branchée au CRM."
  jsonLd={pageLd}
  kicker="§ Résultats obtenus"
  align="left"
  headlineFr="Le bon lead, au <i>bon moment</i>."
  headlineEn="The right lead, at the <i>right time</i>."
  ledeFr="Quand un curieux et un acheteur prêt à signer arrivent au même endroit sans distinction, le commercial trie à la main et perd du temps sur des contacts pas mûrs. Voici le projet réel où la qualification se joue avant le commercial."
  ledeEn="When a browser and a buyer ready to sign land in the same place with no distinction, sales sort by hand and lose time on contacts that aren't ripe. Here is the real project where qualification happens before sales."
>
  <Fragment slot="body">
    <div class="res-intro reveal">
      <p>
        Mieux qualifier, c'est faire remonter les leads chauds en haut de la
        pile et donner au commercial un contact déjà contextualisé. Le cas
        ci-dessous montre la capture branchée au CRM sur un projet réel ; la
        méthode de scoring comportemental, qui décide quel lead remonte, est
        détaillée juste après.
      </p>
    </div>

    <div class="res-grid res-grid--single reveal-stagger">
      {cases.map((c) => (
        <a href={c.href} class="res-card">
          <Kicker tone="" class="res-card-kicker">{c.kicker}</Kicker>
          <h2 class="res-card-title">{c.title}</h2>
          <p class="res-card-excerpt">{c.excerpt}</p>
          <span class="res-card-cta">{c.cta} →</span>
        </a>
      ))}
    </div>

    <div class="res-method reveal">
      <Kicker tone="" class="res-method-kicker">{method.kicker}</Kicker>
      <h2 class="res-method-title">{method.title}</h2>
      <p class="res-method-excerpt">{method.excerpt}</p>
      <a href={method.href} class="res-method-link">{method.cta} →</a>
    </div>
  </Fragment>
</UtilityTemplate>

<style>
  .res-intro { max-width: 720px; margin-bottom: var(--space-9); }
  .res-intro p {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: var(--leading-prose);
    color: var(--muted);
    margin: 0;
    text-wrap: pretty;
  }

  .res-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    margin-bottom: var(--space-10);
  }
  .res-grid--single { grid-template-columns: 1fr; max-width: 820px; }
  .res-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-7) var(--space-6);
    background: var(--paper);
    text-decoration: none;
    color: inherit;
    border-top: 1px solid transparent;
    transition:
      background var(--dur-trim) var(--ease),
      border-top-color var(--dur-trim) var(--ease),
      transform var(--dur-trim) var(--ease);
  }
  .res-card:hover {
    background: var(--paper-2);
    border-top-color: var(--accent-text);
    transform: translateY(-2px);
  }
  :global(.res-card-kicker) { display: block; }
  .res-card-title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: var(--fw-regular);
    letter-spacing: -0.015em;
    line-height: 1.05;
    margin: 0;
    text-wrap: balance;
  }
  .res-card-excerpt {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--muted);
    margin: 0;
    flex: 1;
  }
  .res-card-cta {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--accent-text);
    margin-top: var(--space-2);
  }

  .res-method {
    border: 1px solid var(--hairline);
    background: var(--paper-2);
    padding: var(--space-8) var(--space-7);
    max-width: 820px;
  }
  :global(.res-method-kicker) { display: block; margin-bottom: var(--space-3); }
  .res-method-title {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: var(--fw-regular);
    letter-spacing: -0.02em;
    line-height: var(--leading-h3);
    margin: 0 0 var(--space-3);
    text-wrap: balance;
  }
  .res-method-excerpt {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--ink-2);
    margin: 0 0 var(--space-5);
    max-width: 60ch;
  }
  .res-method-link {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--accent-text);
    text-decoration: none;
  }

  @media (max-width: 800px) {
    .res-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .res-card { transition: none !important; transform: none !important; }
  }
</style>
