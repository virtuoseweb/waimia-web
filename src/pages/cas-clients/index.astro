---
// Page · /cas-clients · Hub cas clients Waimia
export const prerender = true;

// Route principale de la nav : liste des cas business.

import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { langFromPath, localizeHref } from '../../lib/i18n';
import type { SectionByType, SectionData } from '@waimia/ds-kernel';
import HeroCentered from '../../components/sections/HeroCentered.astro';
import CaseFeaturedGrid from '../../components/sections/CaseFeaturedGrid.astro';
import CaseSpotlight from '../../components/sections/CaseSpotlight.astro';
import CtaFinal from '../../components/sections/CtaFinal.astro';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import { buildCollectionPage, buildBreadcrumbList } from '../../lib/seo/schema-builder';
import { meshForCasClientsHub } from '../../lib/internal-mesh';

const lang = langFromPath(Astro.url.pathname);
const transitionIdFromHref = (href: string) =>
  href
    .replace(/^\/(?:en\/)?/, '')
    .replace(/\/$/, '')
    .replace(/[^a-z0-9]+/gi, '-')
    .replace(/^-|-$/g, '') || 'home';

const caseEntries = (await getCollection('cases'))
  .filter((e) => e.data.card)
  .sort((a, b) => (a.data.card!.order) - (b.data.card!.order));

// Habillage visuel : chaque cas reçoit une cover réelle issue du catalogue éditorial
// (public/images/editorial/*, fichiers vérifiés existants). Mappée par slug au registre
// surréaliste duotone selon le secteur du cas. Alt bilingue de contenu (WCAG 1.1.1).
const caseCovers: Record<string, { src: string; alt_fr: string; alt_en: string }> = {
  'les-carnets-de-montpellier': {
    src: '/images/editorial/bandshowingtv.webp',
    alt_fr: 'Illustration éditoriale : un média local qui prend la parole.',
    alt_en: 'Editorial illustration: a local media outlet finding its voice.',
  },
  balzeo: {
    src: '/images/editorial/carontheroad.webp',
    alt_fr: 'Illustration éditoriale : la vitesse retrouvée, un site deux fois plus rapide.',
    alt_en: 'Editorial illustration: speed regained, a site twice as fast.',
  },
  amploi: {
    src: '/images/editorial/womancomputer17.webp',
    alt_fr: "Illustration éditoriale : un site marketing augmenté par l'IA.",
    alt_en: 'Editorial illustration: an AI-augmented marketing site.',
  },
  'desangles-peinture': {
    src: '/images/editorial/gentlemanhandcraftergoworknow.webp',
    alt_fr: "Illustration éditoriale : l'artisan visible en référencement local.",
    alt_en: 'Editorial illustration: the craftsman made visible in local search.',
  },
  'isabelle-diaz-naturopathe': {
    src: '/images/editorial/image-computer-health.webp',
    alt_fr: 'Illustration éditoriale : une présence en ligne crédible pour la santé.',
    alt_en: 'Editorial illustration: a credible online presence for health.',
  },
};

const featuredCases = caseEntries.map((e) => {
  const slug = e.data.slug ?? e.id;
  const cover = caseCovers[slug];
  return {
    slug,
    href: `/cas-clients/${slug}`,
    case_num: String(e.data.card!.order).padStart(2, '0'),
    sector_fr: e.data.card!.sector_fr,
    sector_en: e.data.card!.sector_en,
    title_fr: e.data.card!.title_fr,
    title_en: e.data.card!.title_en,
    headline_fr: e.data.card!.headline_fr,
    headline_en: e.data.card!.headline_en,
    duration_fr: e.data.card!.duration_fr,
    duration_en: e.data.card!.duration_en,
    cover: cover?.src,
    cover_alt_fr: cover?.alt_fr,
    cover_alt_en: cover?.alt_en,
    provenance: (e.data.provenance === 'second-party' ? 'second-party' : 'first-party') as
      | 'first-party'
      | 'second-party',
  };
});

const caseItems = caseEntries.map((e) => `https://waimia.com/cas-clients/${e.data.slug ?? e.id}`);
const collectionLd = buildCollectionPage(
  'Cas clients',
  "Pas de marketing. Des chiffres, des problèmes, ce qu'on a câblé. Ce qui a tenu.",
  caseItems,
);
const breadcrumbLd = buildBreadcrumbList([
  { name: 'Accueil', url: 'https://waimia.com/' },
  { name: 'Réalisations', url: 'https://waimia.com/cas-clients' },
]);
const casClientsLd = [breadcrumbLd, collectionLd];

const ctaData = {
  type: 'cta-final' as const,
  chapter_num: '§',
  chapter_title_fr: 'Câbler le vôtre',
  chapter_title_en: 'Wire yours',
  h2_fr: 'Le mardi on câble. Le vendredi on mesure.',
  h2_en: 'Tuesday we wire. Friday we measure.',
  cta_primary: {
    label_fr: 'Parler de votre projet →',
    label_en: 'Talk about your project →',
    href: localizeHref('/contact', lang),
    variant: 'primary' as const,
  },
  background: 'ink' as const,
} satisfies SectionByType<'cta-final'>;

// Section cataloguée case-featured-grid : remplace le markup orphelin .cas-card
// précédemment inliné ici (le composant en a été extrait VERBATIM, source de vérité).
const featuredGridData = {
  type: 'case-featured-grid' as const,
  cases: featuredCases,
} satisfies SectionByType<'case-featured-grid'>;

// Bande éditoriale « un cas concret » (case-spotlight, fond ink) : climax visuel + preuve
// chiffrée réelle (Les Carnets de Montpellier, contextStats de la fiche). Image éditoriale réelle.
const spotlightData = {
  type: 'case-spotlight' as const,
  background: 'ink' as const,
  variant: 'media-right' as const,
  kicker_fr: '§ Un cas concret',
  kicker_en: '§ A concrete case',
  title_fr: 'De zéro présence en ligne à une communauté payante',
  title_en: 'From no online presence to a paying community',
  media_src: '/images/editorial/bandshowingtv.webp',
  media_alt: lang === 'fr'
    ? 'Les Carnets de Montpellier : un média local qui prend la parole.'
    : 'Les Carnets de Montpellier: a local media outlet finding its voice.',
  quote_fr: 'Six semaines pour passer de l’idée à un site monétisé, avec une vraie communauté.',
  quote_en: 'Six weeks to go from idea to a monetized site, with a real community.',
  attribution_fr: 'Les Carnets de Montpellier · patrimoine et média local',
  attribution_en: 'Les Carnets de Montpellier · heritage and local media',
  metrics: [
    { k: '40+', label_fr: 'Articles publiés', label_en: 'Articles published' },
    { k: '150+', label_fr: 'Membres de la communauté', label_en: 'Community members' },
    { k: '35+', label_fr: 'Abonnés payants en 3 mois', label_en: 'Paying subscribers in 3 months' },
  ],
  cta_href: '/cas-clients/les-carnets-de-montpellier',
  cta_label_fr: 'Lire le cas →',
  cta_label_en: 'Read case →',
} satisfies SectionByType<'case-spotlight'>;

// Maillage interne dérivé (source unique internal-mesh, routes réelles, 0 self-link) :
// hub cas → systèmes business + secteurs porteurs d'un cas dédié. Prépare le climax CTA.
const meshSection = { ...meshForCasClientsHub(lang), background: 'paper-3' as const } as unknown as SectionData;

const mastheadData = {
  type: 'hero-hub-masthead' as const,
  variant: 'hub' as const,
  decoration: false,
  align: 'left' as const,
  kicker_fr: '§ Cas clients · cinq cas réels, résultats mesurés quand ils le sont',
  kicker_en: '§ Case studies · five real cases, results measured when they are',
  h1_fr: '<span>Cas <i>clients</i> :</span><br/><span>des résultats, pas du marketing.</span>',
  h1_en: '<span>Case <i>studies</i>:</span><br/><span>results, not marketing.</span>',
  lede_fr: "Cinq cas réels. Quand un résultat est chiffré, il l'est sur les données du client. Certains cas sont récents ou encore en cours : on les publie pour le travail livré, sans inventer de chiffre. Toujours avec l'accord du client, jamais de témoignage mis en scène.",
  lede_en: 'Five real cases. When a result is quantified, it is measured on the client’s own data. Some are recent or still in progress: we publish them for the work delivered, without inventing a number. Always with the client’s agreement, never a staged testimonial.',
  transition_id: transitionIdFromHref(Astro.url.pathname),
} satisfies SectionByType<'hero-hub-masthead'>;
---
<Base
  title={lang === 'fr' ? "Cas clients · pipelines reconnectés, opérations fluidifiées · Waimia" : "Case studies · pipelines reconnected, operations streamlined · Waimia"}
  description={lang === 'fr' ? "Pas de marketing. Des chiffres, des problèmes, ce qu'on a câblé. Ce qui a tenu." : "No marketing. Numbers, problems, what we shipped. What held."}
  jsonLd={casClientsLd}
>
  <HeroCentered data={mastheadData} lang={lang} />

  {featuredCases.length > 0 ? (
    <>
      <CaseFeaturedGrid data={featuredGridData} lang={lang} />
      <CaseSpotlight data={spotlightData} lang={lang} />
    </>
  ) : (
    <section class="cas-grid-outer wrap-wide">
      <div class="cas-empty reveal">
        <div class="cas-empty-kicker">§ {lang === 'fr' ? 'Études de cas à venir' : 'Case studies coming soon'}</div>
        <p class="cas-empty-body">
          {lang === 'fr'
            ? "Nous publions un cas uniquement après mesure du résultat et accord du client. Les premiers dossiers arrivent. En attendant, parlons de votre projet : nous montrons concrètement comment nous travaillons."
            : 'We only publish a case after the result is measured and the client has agreed. The first files are coming. In the meantime, let us talk about your project: we show exactly how we work.'}
        </p>
      </div>
    </section>
  )}

  <SectionsRenderer sections={[meshSection]} lang={lang} />

  <CtaFinal data={ctaData} lang={lang} />
</Base>

<style>
  /* La grille de cas + ses cartes vivent désormais dans la section cataloguée
     CaseFeaturedGrid (markup + CSS extraits là, source de vérité). Ici ne restent
     que les styles de l'état vide (cas-empty), spécifique à cette page. */
  .cas-grid-outer { margin: 0 auto; padding: 0 var(--space-6); }
  .cas-empty {
    margin: var(--space-7) 0 var(--space-10);
    padding: var(--space-10) var(--space-8);
    border: 1px solid var(--hairline);
    background: var(--paper-2);
    max-width: 820px;
  }
  .cas-empty-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.14em;
    color: var(--accent-text);
    margin-bottom: var(--space-3);
  }
  .cas-empty-body {
    font-size: var(--text-h3);
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
    text-wrap: pretty;
  }
</style>
