---
export const prerender = true;

import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import { resolveTemplate } from '@waimia/ds-kernel/templates';
import { caseStudyTemplate, type RelatedCardInput } from '../../lib/templates/case-study';
import { SECTION_REGISTRY } from '../../lib/section-registry';
import HeroCentered from '../../components/sections/HeroCentered.astro';
import TechStackBand from '../../components/sections/TechStackBand.astro';
import AuthorByline from '../../components/ui/molecules/AuthorByline.astro';
import AuthorCard from '../../components/ui/molecules/AuthorCard.astro';
import { buildArticle } from '../../lib/seo/schema-builder';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  const entries = await getCollection('cases');
  return entries
    .filter((entry) => !entry.data.seo?.noindex)
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

type Props = { entry: CollectionEntry<'cases'> };

const slugifyAuthorName = (name: string) =>
  name.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const getAuthorSlug = (author: unknown): string | undefined => {
  if (!author) return undefined;
  if (typeof author === 'string') return author;
  if (typeof author !== 'object') return undefined;

  const ref = author as { id?: unknown; slug?: unknown; url?: unknown; name?: unknown };
  if (typeof ref.id === 'string') return ref.id;
  if (typeof ref.slug === 'string') return ref.slug;
  if (typeof ref.url === 'string') return ref.url.split('/').filter(Boolean).at(-1);
  if (typeof ref.name === 'string') return slugifyAuthorName(ref.name);
  return undefined;
};

const { entry } = Astro.props as Props;
const d = entry.data;
const lang = 'fr' as const;
const authorSlug = getAuthorSlug(d.author);

// Nom d'affichage de l'auteur résolu depuis la collection authors (pour le JSON-LD).
let authorName: string | undefined;
if (authorSlug) {
  try {
    const authorEntry = await getEntry('authors', authorSlug);
    authorName = authorEntry?.data.title_fr;
  } catch {
    authorName = undefined;
  }
}

// Trié par card.order (numérotation curée de l'index) — cohérence « § Cas 0N » avec /cas-clients.
const allCases = (await getCollection('cases')).sort(
  (a, b) => (a.data.card?.order ?? 99) - (b.data.card?.order ?? 99),
);
const idx = allCases.findIndex((c) => c.id === entry.id);
const caseNum = String(idx + 1).padStart(2, '0');

const relatedCards: RelatedCardInput[] = allCases
  .filter((c) => c.id !== entry.id)
  .slice(0, 3)
  .map((c) => ({
    kicker: `§ Cas · ${c.data.sector_fr}`,
    title_fr: c.data.title_fr,
    title_en: c.data.title_en,
    lead_fr: c.data.impact_fr,
    lead_en: c.data.impact_en,
    href: `/cas-clients/${c.id}`,
  }));

// Id de continuité View Transition (dérivé du pathname) — parité template.
const pageTransitionId = Astro.url.pathname
  .replace(/^\/(?:en\/)?/, '')
  .replace(/\/$/, '')
  .replace(/[^a-z0-9]+/gi, '-')
  .replace(/^-|-$/g, '') || 'home';

// JSON-LD Article · GEO/AIO (inchangé) : rend les cas indexables par les crawlers LLM.
const siteUrl = SITE.url;
const caseUrl = `${siteUrl}/cas-clients/${entry.id}`;
const caseLd = buildArticle({
  headline: d.title_fr,
  description: d.description_fr,
  datePublished: new Date(d.publishedAt).toISOString().slice(0, 10),
  dateModified: d.updatedAt ? new Date(d.updatedAt).toISOString().slice(0, 10) : undefined,
  author: {
    '@type': 'Person',
    ...(authorSlug ? { '@id': `${siteUrl}/equipe/${authorSlug}#person`, url: `${siteUrl}/equipe/${authorSlug}` } : {}),
    ...(authorName ? { name: authorName } : {}),
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: SITE.name,
    logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon-256.png` },
  },
  mainEntityOfPage: caseUrl,
  articleSection: d.sector_fr,
  ...(d.heroImage ? { image: d.heroImage.startsWith('http') ? d.heroImage : `${siteUrl}${d.heroImage}` } : {}),
  ...(d.tags && d.tags.length > 0 ? { keywords: d.tags } : {}),
});

// « Template-as-data » : la page cas client se rend depuis la DÉFINITION `caseStudyTemplate`
// (liste ordonnée de sections cataloguées + mappings) résolue avec le contenu de la page.
const resolved = resolveTemplate(caseStudyTemplate, {
  data: d,
  lang,
  caseNum,
  transitionId: pageTransitionId,
  slug: entry.id,
  authorSlug,
  relatedCards,
});
---
<Base title={`${d.title_fr} · Waimia`} description={d.description_fr} jsonLd={caseLd} ogType="article">
  <div class="case-flow">
  {resolved.map((item) => {
    if (item.kind === 'slot') {
      const sp = item.props as { authorSlug?: string; date?: Date | string } | undefined;
      if (item.name === 'author-byline') {
        return (
          <section class="case-author-band reveal">
            <div class="wrap-wide"><AuthorByline authorSlug={sp?.authorSlug} date={sp?.date} /></div>
          </section>
        );
      }
      if (item.name === 'author-card') {
        return (
          <section class="case-author-card-band reveal">
            <div class="wrap-wide"><AuthorCard authorSlug={sp?.authorSlug} variant="full" /></div>
          </section>
        );
      }
      return null;
    }
    const s = item.section;
    // Deux sections ont besoin de props d'instance que les wrappers de module (data+lang
    // pass-through) n'acheminent pas → rendu direct du composant partagé avec ces props.
    if (s.type === 'hero-case-study') {
      const hp = item.props as {
        topPad?: string; h1Gap?: string; transitionId?: string; cardTransitionId?: string;
      };
      return (
        <HeroCentered
          data={s}
          lang={lang}
          topPad={hp?.topPad}
          h1Gap={hp?.h1Gap}
          transitionId={hp?.transitionId}
          cardTransitionId={hp?.cardTransitionId}
        />
      );
    }
    if (s.type === 'tech-stack-band') {
      const tp = item.props as { reveal?: boolean; style?: string };
      return <TechStackBand data={s} lang={lang} reveal={tp?.reveal} style={tp?.style} />;
    }
    const Component = SECTION_REGISTRY[s.type] as any;
    if (!Component) {
      console.error(`[cas-clients] type de section inconnu: ${s.type}`);
      return null;
    }
    return <Component data={s} lang={lang} />;
  })}
  </div>
</Base>

<style>
  /* Chrome des bandes auteur (byline/card) : padding hérité de l'ancien CaseStudyTemplate. */
  .case-author-band { padding: var(--space-9) var(--space-6) 0; }
  .case-author-card-band {
    padding: var(--space-9) var(--space-6);
    border-top: 1px solid var(--hairline);
  }

  /* Densité du flux cas (directive §E/§H.8) : resserre le rythme vertical des sections
     de contenu du parcours cas (respirations trop larges relevées en re-critique it.13),
     SANS toucher les défauts catalogue globaux ni amputer le contenu. Confiné à
     .case-flow, tokens DS uniquement, réversible. Cible : les bandes en cran --section-base
     (site-showcase, method-timeline) passent au cran intermédiaire --space-10 (96→80px). */
  .case-flow :global(.sec-base) { padding-block: var(--space-10); }
</style>
