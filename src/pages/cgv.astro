---
// Page · /cgv · Conditions générales de vente
export const prerender = true;

// Composé de · TrustLegalTemplate (TOC sticky + sections empilées)
// Template-as-data (V5, 2026-07-19) : contenu en JSON (src/content/legal/cgv.json),
// migré depuis le props/slot inline. Sections pré-rendues (headlineHtml/ledeHtml/
// sectionsHtml) capturées depuis le rendu réel, même idiome que `body_sections[].html_fr`
// (cases/secteurs), injectées via `set:html` (parité caractère près, page 100 % juridique).

import { getEntry } from 'astro:content';
import TrustLegalTemplate from '../components/templates/TrustLegalTemplate.astro';
import Callout from '../components/editorial/Callout.astro';
import EditorialTable from '../components/editorial/EditorialTable.astro';

const entry = await getEntry('legal', 'cgv');
if (!entry) throw new Error('Collection "legal" · entrée "cgv" introuvable.');
const d = entry.data;
---
<TrustLegalTemplate
  title={d.title!}
  description={d.description!}
  kickerFr={d.kickerFr!}
  kickerEn={d.kickerEn!}
  ctaSubjectFr={d.ctaSubjectFr!}
  ctaSubjectEn={d.ctaSubjectEn!}
  revisedAt={d.revisedAt!}
  version={d.version}
  sections={d.toc!}
>
  <Fragment slot="headline" set:html={d.headlineHtml} />
  <Fragment slot="lede" set:html={d.ledeHtml} />
  <Fragment slot="sections" set:html={d.sectionsHtml} />
</TrustLegalTemplate>

{/* Instance masquée : `sectionsHtml` ci-dessus est du HTML pré-rendu (capturé), donc
    Callout/EditorialTable ne sont plus réellement rendus par CETTE page → leur CSS
    scopé (Astro n'embarque le <style> d'un composant que s'il est effectivement rendu)
    ne serait pas bundlé, cassant l'uppercase du caption de table et du footer cite.
    Ce rendu invisible force l'inclusion de leur feuille de style, 0 impact DOM visible
    (display:none, exclu de innerText/accessibility tree). */}
<div style="display:none" aria-hidden="true">
  <Callout variant="info" cite="_"><p>_</p></Callout>
  <EditorialTable columns={['_']} rows={[['_']]} />
</div>
