---
// Page · /en/offres · Offer pyramid — EN mirror
export const prerender = true;

import Base from '../../../layouts/Base.astro';
import Kicker from '../../../components/ui/atoms/Kicker.astro';
import type { SectionByType } from '../../../schemas/sections';
import CtaFinal from '../../../components/sections/CtaFinal.astro';
import OfferTierGrid from '../../../components/sections/OfferTierGrid.astro';
import TierPyramidSvg from '../../../components/sections/TierPyramidSvg.astro';
import Breadcrumb from '../../../components/ui/molecules/Breadcrumb.astro';

const offresJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': 'https://waimia.com/en/offres',
  name: 'Waimia Offers — AI Systems for SMEs and Mid-Caps',
  description: 'Three AI engagement tiers: Discovery, Transformation, Partnership.',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'AI Maturity Audit', url: 'https://waimia.com/offres/audit-maturite-ia' },
    { '@type': 'ListItem', position: 2, name: 'AI Activation', url: 'https://waimia.com/offres/activation-ia' },
    { '@type': 'ListItem', position: 3, name: 'Growth System AI', url: 'https://waimia.com/offres/growth-system-ia' },
    { '@type': 'ListItem', position: 4, name: 'Growth Intelligence', url: 'https://waimia.com/offres/growth-intelligence' },
    { '@type': 'ListItem', position: 5, name: 'Operational Productivity AI', url: 'https://waimia.com/offres/productivite-operationnelle-ia' },
    { '@type': 'ListItem', position: 6, name: 'AI Website', url: 'https://waimia.com/offres/site-web-ia' },
    { '@type': 'ListItem', position: 7, name: 'AI App for SMEs', url: 'https://waimia.com/offres/application-ia-pme' },
    { '@type': 'ListItem', position: 8, name: 'RevOps', url: 'https://waimia.com/offres/revops' },
    { '@type': 'ListItem', position: 9, name: 'Claude Cowork', url: 'https://waimia.com/offres/claude-cowork' },
    { '@type': 'ListItem', position: 10, name: 'Advisory', url: 'https://waimia.com/offres/conseil' },
    { '@type': 'ListItem', position: 11, name: 'AI Infrastructure', url: 'https://waimia.com/offres/infrastructure-ia' },
  ],
};

const ctaData = {
  type: 'cta-final' as const,
  h2_fr: 'Prêt à livrer un <em>agent</em>,<br />pas un slide deck ?',
  h2_en: 'Ready to ship an <em>agent</em>,<br />not a slide deck?',
  body_fr: 'Audit IA en 5 jours. Premier agent en production en 4 semaines. ROI mesuré, jamais estimé.',
  body_en: 'AI audit in 5 days. First agent in production in 4 weeks. Measured ROI, never estimated.',
  cta_primary: { label_fr: 'Réserver un audit →', label_en: 'Book an audit →', href: '/en/contact', variant: 'primary' as const },
  cta_secondary: { label_fr: 'Voir la pyramide →', label_en: 'See the pyramid →', href: '/en/offres', variant: 'ghost' as const },
  background: 'paper' as const,
} satisfies SectionByType<'cta-final'>;

const pyramidData = {
  type: 'tier-pyramid-svg' as const,
  aria_label_fr: 'Pyramide des offres Waimia — trois tiers',
  aria_label_en: 'Waimia offer pyramid — three tiers',
  tiers: [
    { roman: 'I', label_fr: 'Découverte', label_en: 'Discovery' },
    { roman: 'II', label_fr: 'Transformation', label_en: 'Transformation' },
    { roman: 'III', label_fr: 'Partenariat', label_en: 'Partnership' },
  ],
} satisfies SectionByType<'tier-pyramid-svg'>;

const tierDiscoveryData = {
  type: 'offer-tier-grid' as const,
  variant: 'standard' as const,
  wrap: true,
  eyebrow_fr: 'I · DÉCOUVERTE',
  eyebrow_en: 'I · DISCOVERY',
  h2_fr: 'Comprendre avant de décider.',
  h2_en: 'Understand before deciding.',
  lede_fr: "Avant d'investir dans un système, posez le diagnostic.",
  lede_en: 'Before investing in a system, run the diagnosis.',
  offers: [
    {
      price_fr: 'À PARTIR DE 5 K€',
      price_en: 'FROM €5K',
      title_fr: 'Audit Maturité IA',
      title_en: 'AI Maturity Audit',
      lead_fr: 'Cartographie de vos process, identification des leviers IA prioritaires, feuille de route chiffrée.',
      lead_en: 'Process mapping, identification of priority AI levers, costed roadmap.',
      cta_fr: "Voir l'offre →",
      cta_en: 'See offer →',
      href: '/offres/audit-maturite-ia',
    },
    {
      price_fr: '1 À 5 K€',
      price_en: '€1K TO €5K',
      title_fr: 'Activation IA',
      title_en: 'AI Activation',
      lead_fr: 'Cinq jours. Un workflow en production. Pas un POC, pas une démo. Un résultat mesurable dès le vendredi.',
      lead_en: 'Five days. One workflow in production. Not a POC, not a demo. A measurable result by Friday.',
      cta_fr: "Voir l'offre →",
      cta_en: 'See offer →',
      href: '/offres/activation-ia',
    },
  ],
} satisfies SectionByType<'offer-tier-grid'>;

const tierTransformationData = {
  type: 'offer-tier-grid' as const,
  variant: 'featured' as const,
  wrap: false,
  eyebrow_fr: 'II · TRANSFORMATION',
  eyebrow_en: 'II · TRANSFORMATION',
  h2_fr: 'Construire les systèmes qui durent.',
  h2_en: 'Build systems that last.',
  lede_fr: 'Site, CRM, analytics, productivité — connectés et mesurés.',
  lede_en: 'Website, CRM, analytics, productivity — connected and measured.',
  featured_card: {
    eyebrow_fr: 'OFFRE PHARE · 5 À 20 K€',
    eyebrow_en: 'FLAGSHIP OFFER · €5K TO €20K',
    title_fr: 'Growth System IA',
    title_en: 'Growth System AI',
    sub_fr: 'Pas un site. Pas un CRM. Un système.',
    sub_en: 'Not a website. Not a CRM. A system.',
    lead_fr: 'Site, CRM, relances, pilotage — connectés et mesurés. Le mardi on câble. Le vendredi on mesure.',
    lead_en: 'Website, CRM, follow-ups, reporting — connected and measured. Tuesday we wire. Friday we measure.',
    cta_fr: 'Activer →',
    cta_en: 'Activate →',
    href: '/offres/growth-system-ia',
  },
  offers: [
    {
      price_fr: '8 À 35 K€',
      price_en: '€8K TO €35K',
      title_fr: 'Growth Intelligence',
      title_en: 'Growth Intelligence',
      lead_fr: 'KPI commerciaux et opérationnels en temps réel. Des chiffres lisibles avant la réunion.',
      lead_en: 'Commercial and operational KPIs in real time. Readable numbers before the meeting.',
      cta_fr: "Voir l'offre →",
      cta_en: 'See offer →',
      href: '/offres/growth-intelligence',
    },
    {
      price_fr: '6 À 25 K€',
      price_en: '€6K TO €25K',
      title_fr: 'Productivité Opérationnelle IA',
      title_en: 'Operational Productivity AI',
      lead_fr: 'Excel augmenté, Office connecté, workflows internes qui tournent sans relance humaine.',
      lead_en: 'Augmented Excel, connected Office, internal workflows that run without human follow-up.',
      cta_fr: "Voir l'offre →",
      cta_en: 'See offer →',
      href: '/offres/productivite-operationnelle-ia',
    },
    {
      price_fr: 'SITE WEB',
      price_en: 'WEBSITE',
      title_fr: 'Site Web IA',
      title_en: 'AI Website',
      lead_fr: 'Un site conçu pour convertir, mesuré, relié à votre CRM. Pas une vitrine statique.',
      lead_en: 'A site built to convert, measured, connected to your CRM. Not a static brochure.',
      cta_fr: "Voir l'offre →",
      cta_en: 'See offer →',
      href: '/offres/site-web-ia',
    },
    {
      price_fr: 'APPLICATION',
      price_en: 'APPLICATION',
      title_fr: 'Application IA PME',
      title_en: 'AI App for SMEs',
      lead_fr: 'Un outil métier sur-mesure, entraîné sur vos données, intégré dans vos workflows existants.',
      lead_en: 'A bespoke business tool, trained on your data, integrated into your existing workflows.',
      cta_fr: "Voir l'offre →",
      cta_en: 'See offer →',
      href: '/offres/application-ia-pme',
    },
    {
      price_fr: 'REVOPS',
      price_en: 'REVOPS',
      title_fr: 'RevOps',
      title_en: 'RevOps',
      lead_fr: 'Alignement commercial, marketing, support sur un pipeline unique. Chaque friction identifiée et éliminée.',
      lead_en: 'Sales, marketing, and support aligned on a single pipeline. Every friction identified and eliminated.',
      cta_fr: "Voir l'offre →",
      cta_en: 'See offer →',
      href: '/offres/revops',
    },
  ],
} satisfies SectionByType<'offer-tier-grid'>;

const tierPartnershipData = {
  type: 'offer-tier-grid' as const,
  variant: 'transparent' as const,
  wrap: true,
  eyebrow_fr: 'III · PARTENARIAT',
  eyebrow_en: 'III · PARTNERSHIP',
  h2_fr: 'Pour ceux qui veulent aller plus loin.',
  h2_en: 'For those who want to go further.',
  lede_fr: 'Un engagement dans la durée. Une équipe dédiée. Une ambition partagée.',
  lede_en: 'A long-term commitment. A dedicated team. A shared ambition.',
  lede_max_width: '560px',
  offers: [
    {
      price_fr: 'À PARTIR DE 3 500 €',
      price_en: 'FROM €3,500',
      title_fr: 'Claude Cowork',
      title_en: 'Claude Cowork',
      lead_fr: 'Travaillez directement avec Claude et Simon. Sessions profondes, stratégie IA, implémentation en direct.',
      lead_en: 'Work directly with Claude and Simon. Deep sessions, AI strategy, live implementation.',
      cta_fr: "Voir l'offre →",
      cta_en: 'See offer →',
      href: '/offres/claude-cowork',
    },
    {
      price_fr: 'CONSEIL',
      price_en: 'ADVISORY',
      title_fr: 'Conseil',
      title_en: 'Advisory',
      lead_fr: "Accompagnement stratégique sur le temps long. Décisions d'architecture IA, gouvernance, formation équipes.",
      lead_en: 'Long-term strategic support. AI architecture decisions, governance, team training.',
      cta_fr: "Voir l'offre →",
      cta_en: 'See offer →',
      href: '/offres/conseil',
    },
    {
      price_fr: '25 À 150 K€+',
      price_en: '€25K TO €150K+',
      title_fr: 'Infrastructure IA',
      title_en: 'AI Infrastructure',
      lead_fr: "Quand les pilotes IA s'éparpillent. Une infra commune, une gouvernance, une équipe interne formée.",
      lead_en: 'When AI pilots scatter. A shared infrastructure, governance, and a trained internal team.',
      cta_fr: "Voir l'offre →",
      cta_en: 'See offer →',
      href: '/offres/infrastructure-ia',
    },
  ],
} satisfies SectionByType<'offer-tier-grid'>;
---
<Base
  title="Offers · Engagement pyramid · Waimia"
  description="Three AI engagement tiers — Discovery, Transformation, Partnership. Audit, Activation, Growth System, Claude Cowork and more."
  jsonLd={offresJsonLd}
>

  <div class="wrap-wide" style="padding-top: 24px;">
    <Breadcrumb items={[{label:'Home', href:'/en'}, {label:'Offers'}]} />
  </div>

  <!-- 1. EDITORIAL HERO -->
  <section class="hub-mast">
    <div class="wrap-wide">
      <Kicker class="hub-kicker">§ Offers · Waimia</Kicker>
      <h1 class="hub-h1 reveal-mask-up">
        Three <i>levels</i>.<br/>One <i>method</i>.
      </h1>
      <p class="hub-lede reveal" style="transition-delay:200ms">
        Discovery, transformation, partnership.
        Each offer is a step. Choose the right one.
      </p>
    </div>
  </section>

  <!-- 2. SIGNATURE PYRAMID SVG -->
  <TierPyramidSvg data={pyramidData} lang="en" />

  <!-- 3. TIER I · DISCOVERY -->
  <OfferTierGrid data={tierDiscoveryData} lang="en" />

  <!-- 4. TIER II · TRANSFORMATION -->
  <OfferTierGrid data={tierTransformationData} lang="en" />

  <!-- 5. TIER III · PARTNERSHIP -->
  <OfferTierGrid data={tierPartnershipData} lang="en" />

  <!-- 6. SHORT MANIFESTO -->
  <section class="manifesto">
    <blockquote class="mf-quote reveal-fade">
      <i>Every engagement starts with the right step.</i>
    </blockquote>
    <p class="mf-body">
      It's not a question of budget. It's a question of maturity.
      Audit, Activation, Systems, Partnership — the progression is designed.
    </p>
  </section>

  <!-- 7. CTA BAND -->
  <CtaFinal data={ctaData} lang="en" />
</Base>

<style>
  /* ── MAST ──────────────────────────────────────────────────── */
  .hub-mast {
    padding: 140px 32px clamp(48px, 6vw, 88px);
  }
  :global(.hub-kicker) {
    display: block;
    margin-bottom: 24px;
  }
  .hub-h1 {
    font-family: var(--font-display);
    font-size: clamp(60px, 11vw, 180px);
    font-style: italic;
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .hub-h1 i {
    color: var(--accent);
    font-style: italic;
  }
  .hub-lede {
    font-family: var(--font-sans);
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.65;
    color: var(--muted);
    margin: 32px 0 0;
    max-width: 580px;
  }

  /* ── MANIFESTO ─────────────────────────────────────────────── */
  .manifesto {
    padding: clamp(80px, 10vw, 140px) clamp(20px, 5vw, 80px);
    background: var(--paper-2);
    text-align: center;
  }
  .mf-quote {
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 56px);
    font-style: italic;
    font-weight: 400;
    margin: 0 auto clamp(24px, 3vw, 40px);
    max-width: 860px;
    line-height: 1.1;
  }
  .mf-body {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted);
    max-width: 600px;
    margin: 0 auto;
  }

  /* ── RESPONSIVE ────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .hub-mast {
      padding-left: 20px;
      padding-right: 20px;
    }
    .manifesto {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>
