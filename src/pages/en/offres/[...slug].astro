---
export const prerender = true;

// Page SSG · /en/offres/[slug] · rendu 100 % composable (registry).
// R6 (2026-06-10) · fallback OffresDetailTemplate supprimé (voie morte, 9/9
// offres composables) ; MDX sans `sections:` = erreur de build volontaire.

import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SectionsRenderer from '../../../components/sections/SectionsRenderer.astro';
import Breadcrumb from '../../../components/ui/molecules/Breadcrumb.astro';

export async function getStaticPaths() {
  const entries = await getCollection('offres');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<'offres'> };
const { entry } = Astro.props as Props;
const data = entry.data;
const lang = 'en' as const;

if (!Array.isArray(data.sections) || data.sections.length === 0) {
  throw new Error(`en/offres/${entry.id} : frontmatter \`sections:\` requis (voie template legacy éteinte en R6)`);
}
---
<Base
  title={data.title_en}
  description={data.description_en}
>
  <Breadcrumb lang="en" items={[
    { label: 'Home', href: '/en' },
    { label: 'Services', href: '/en/offres' },
    { label: data.title_en.split(' · ')[0] },
  ]} />
  <SectionsRenderer sections={data.sections!} lang={lang} />
</Base>
