---
export const prerender = true;

/**
 * Homepage · V-F2 recomposition (docs/visual-audit/home/README.md + docs/40 §6) · EN parity
 *
 * Mirrors pages/index.astro (FR). Principle: 1 piece of information = 1 representation.
 * 10-slot sequence: Act I promise & proof → Act II system & offer → Act III engagement
 * → Act IV client proof → Act V action. FeatureGrid + UseCaseIndex removed from home
 * (kept in the catalogue), 3 of 8 interludes kept, BookSession on ink.
 */
import Base from '../../layouts/Base.astro';
import BootSplash from '../../components/motion/BootSplash.astro';
import ScrollProgress from '../../components/ui/atoms/ScrollProgress.astro';

import Hero                from '../../components/ui/organisms/Hero.astro';
import StatBlock           from '../../components/sections/StatBlock.astro';
import SocialProof         from '../../components/sections/SocialProof.astro';
import ArchitectureDiagram from '../../components/sections/ArchitectureDiagram.astro';
import ServicesGrid        from '../../components/sections/ServicesGrid.astro';
import MaturityPyramid     from '../../components/sections/MaturityPyramid.astro';
import CtaBandSection      from '../../components/sections/CtaBandSection.astro';
import CaseCardGrid        from '../../components/sections/CaseCardGrid.astro';
import { caseCardGridData } from '../../lib/case-card-grid-data';
import FaqAccordion        from '../../components/sections/FaqAccordion.astro';
import EditorialPreview    from '../../components/sections/EditorialPreview.astro';
import { editorialPreviewData } from '../../lib/editorial-preview-data';
import BookSession         from '../../components/ui/organisms/BookSession.astro';
import FooterMarquee       from '../../components/ui/organisms/FooterMarquee.astro';
import SectionTransition   from '../../components/ui/atoms/SectionTransition.astro';

import { CLIENT_LOGOS, HERO_METRICS, SIX_SERVICES, PYRAMID_TIERS, DEPARTMENTS_GRID } from '../../data/sitemap';
import { PROOF_POINTS } from '../../data/proof-points';
import { localizeHref } from '../../lib/i18n';
import { buildOrganization } from '../../lib/seo/schema-builder';
import type { SectionByType } from '../../schemas/sections';

// ── Act I · Unified proof band (audit home §02+03) ─────────────────────────────
const proofBarData = {
  type: 'proof-bar' as const,
  layout: 'horizontal' as const,
  background: 'paper-2' as const,
  kicker_fr: 'ACTE I · PREUVES',
  kicker_en: 'ACT I · PROOFS',
  metrics: HERO_METRICS.filter((m) => m.k !== '01').map((m) => ({
    value: m.n,
    label_fr: m.label.fr,
    label_en: m.label.en,
    emphasis: false,
  })),
  link_label_fr: 'Voir les 4 dossiers →',
  link_label_en: 'See the 4 case files →',
  link_href: localizeHref('/cas', 'en'),
} satisfies SectionByType<'proof-bar'>;

const socialProofData = {
  type: 'social-proof' as const,
  background: 'paper-2' as const,
  logos: CLIENT_LOGOS.map((name) => ({ name })),
  marquee: true,
} satisfies SectionByType<'social-proof'>;

// ── Act II · FIG 2.0 The system (absorbs the FeatureGrid role) ─────────────────
const architectureDiagramData = {
  type: 'architecture-diagram' as const,
  fig_num: 'FIG II · 2.0',
  fig_title_fr: 'Acte II : Le système', fig_title_en: 'Act II: The system',
  spec_fr: 'CANAUX · SYSTÈME · ACTIONS', spec_en: 'CHANNELS · SYSTEM · ACTIONS',
  h2_fr: 'Une seule <i>architecture</i>.<br/>Six entrées, quatre sorties, mille décisions.',
  h2_en: 'One <i>architecture</i>.<br/>Six inputs, four outputs, a thousand decisions.',
  inputs_fr: ['Ads', 'Contenu', 'Site', 'CRM', 'Analytics', 'Marque'],
  inputs_en: ['Ads', 'Content', 'Site', 'CRM', 'Analytics', 'Brand'],
  input_examples_fr: [
    'Google Ads, Meta, LinkedIn reliés au pipeline',
    'Articles SEO/GEO produits et indexés',
    'Landing, tunnel, CMS branchés au CRM',
    'Relances, qualification, alertes automatiques',
    'GA4 et Search Console lus en tableaux de bord',
    'Design system, decks, PDF alignés',
  ],
  input_examples_en: [
    'Google Ads, Meta, LinkedIn wired to the pipeline',
    'SEO/GEO articles produced and indexed',
    'Landing, funnel, CMS plugged into the CRM',
    'Follow-ups, qualification, automatic alerts',
    'GA4 and Search Console read as dashboards',
    'Design system, decks, PDF aligned',
  ],
  outputs_fr: ['Actions', 'Supports', 'Reporting', 'Pipeline'],
  outputs_en: ['Actions', 'Assets', 'Reports', 'Pipeline'],
  system_label: 'Waimia', system_kicker: 'AI SYSTEM', system_subtitle: 'multi-agent',
  show_loop: true,
  loop_label_fr: 'BOUCLE D’AMÉLIORATION CONTINUE', loop_label_en: 'CONTINUOUS IMPROVEMENT LOOP',
  caption_fr: "Six canaux entrent. Quatre familles d'<i>actions</i> sortent. Au milieu, un système multi-agents qui mesure, apprend et réinjecte, sans relance manuelle.",
  caption_en: 'Six channels in. Four families of <i>actions</i> out. In between, a multi-agent system that measures, learns and reinjects, without manual chasing.',
} satisfies SectionByType<'architecture-diagram'>;

// ── Act II · FIG 2.5 The offer (ServicesGrid merged with UseCaseIndex) ─────────
const ppValue = (id: string) => PROOF_POINTS.find((p) => p.id === id)?.value ?? '';
const SERVICE_METRIC_OVERRIDES: Record<string, { fr: string; en: string }> = {
  '02': { fr: `${ppValue('roi-leads-x2-4')} leads`, en: `${ppValue('roi-leads-x2-4').replace(',', '.')} leads` },
  '05': { fr: `${ppValue('time-30pct-taches-reduites')} tâches`, en: `${ppValue('time-30pct-taches-reduites')} tasks` },
};
const SERVICE_USECASES: Record<string, string> = {
  '02': 'acquisition-ia',
  '03': 'crm-relances-ia',
  '05': 'productivite-ia',
};
const usecaseBySlug = (slug: string) => DEPARTMENTS_GRID.find((d) => d.slug === slug);
const servicesGridData = {
  type: 'services-grid' as const,
  fig_num: 'FIG II · 2.5',
  fig_title_fr: "Acte II : L'offre",
  fig_title_en: 'Act II: The offer',
  spec_fr: '6 SERVICES · UNE COUCHE CONTINUE',
  spec_en: '6 SERVICES · ONE CONTINUOUS LAYER',
  h2_fr: 'Six services, appris en <i>livrant</i>, pas en PowerPoint.',
  h2_en: 'Six services, taught by <i>doing</i>, not by slides.',
  connectors_label_fr: 'Connecteurs',
  connectors_label_en: 'Connectors',
  services: SIX_SERVICES.map((s) => {
    const ucSlug = SERVICE_USECASES[s.k];
    const uc = ucSlug ? usecaseBySlug(ucSlug) : undefined;
    return {
      fig: `2.5${Number(s.k)}`,
      metric_fr: SERVICE_METRIC_OVERRIDES[s.k]?.fr ?? s.metric.fr,
      metric_en: SERVICE_METRIC_OVERRIDES[s.k]?.en ?? s.metric.en,
      label_fr: s.label.fr,
      label_en: s.label.en,
      body_fr: s.body.fr,
      body_en: s.body.en,
      connectors_fr: s.connectors.fr,
      connectors_en: s.connectors.en,
      ...(uc
        ? {
            usecase_label_fr: `Cas d'usage · ${uc.label.fr} →`,
            usecase_label_en: `Use case · ${uc.label.en} →`,
            usecase_href: localizeHref(`/solutions/${ucSlug}`, 'en'),
          }
        : {}),
    };
  }),
  foot_links: [
    { label_fr: "Six cas d'usage métier →", label_en: 'Six business use cases →', href: localizeHref('/solutions', 'en') },
    // /secteurs est FR-only (i18n.ts FR_ONLY_STATIC) : pas de préfixe /en, comme l'ex-UseCaseIndex
    { label_fr: 'Adapté à votre secteur →', label_en: 'Adapted to your sector →', href: '/secteurs' },
  ],
} satisfies SectionByType<'services-grid'>;

// ── Act III · Cards-only pyramid (stage + entry price + I→IV gauge) ────────────
// Prices sourced from FAQ Q.01 + offres/*.mdx metas (nothing invented).
const ACTION_LABELS = [
  { fr: 'Cartographier', en: 'Map' },
  { fr: 'Câbler', en: 'Wire' },
  { fr: 'Orchestrer', en: 'Orchestrate' },
  { fr: 'Industrialiser', en: 'Industrialize' },
];
const TIER_DETAILS = [
  { stage: { fr: 'Audit', en: 'Audit' },                   price: { fr: 'Dès 1 500 € HT · 1 semaine', en: 'From €1,500 · 1 week' } },
  { stage: { fr: 'Workflow', en: 'Workflow' },             price: { fr: '6 à 25 k€ · 4 à 10 sem', en: '€6K to €25K · 4 to 10 weeks' } },
  { stage: { fr: 'Système', en: 'System' },                 price: { fr: 'Dès 5 000 € HT · 6 à 10 sem', en: 'From €5,000 · 6 to 10 weeks' } },
  { stage: { fr: 'Infrastructure', en: 'Infrastructure' }, price: { fr: 'Sur devis · 12 sem +', en: 'On quote · 12+ weeks' } },
];
const maturityPyramidData = {
  type: 'maturity-pyramid' as const,
  variant: 'cards-only' as const,
  roman: 'III',
  label_fr: "Acte III : La pyramide d'engagements",
  label_en: 'Act III: The engagement pyramid',
  heading_fr: '<i>Cartographier.</i> Câbler.<br/>Orchestrer. <i>Industrialiser.</i>',
  heading_en: '<i>Map.</i> Wire.<br/>Orchestrate. <i>Industrialize.</i>',
  aside_fr: "Du diagnostic process à l'infrastructure souveraine : chaque palier prépare le suivant. Vous montez quand vous êtes prêt.",
  aside_en: "From process diagnostic to sovereign infrastructure: each tier sets up the next. You climb when you're ready.",
  timeline_label_fr: 'Progression de maturité IA',
  timeline_label_en: 'AI maturity path',
  tier_cta_fr: 'Voir le palier →',
  tier_cta_en: 'Open tier →',
  tiers: PYRAMID_TIERS.map((tier, idx) => ({
    n: tier.n,
    tag_fr: tier.tag.fr, tag_en: tier.tag.en,
    label_fr: tier.label.fr, label_en: tier.label.en,
    lead_fr: tier.lead.fr, lead_en: tier.lead.en,
    items_fr: tier.items, items_en: tier.items,
    action_fr: ACTION_LABELS[idx].fr, action_en: ACTION_LABELS[idx].en,
    href: tier.href,
    stage_fr: TIER_DETAILS[idx].stage.fr, stage_en: TIER_DETAILS[idx].stage.en,
    price_fr: TIER_DETAILS[idx].price.fr, price_en: TIER_DETAILS[idx].price.en,
  })),
} satisfies SectionByType<'maturity-pyramid'>;

// Mid-page CTA (docs/39 P1-8: never > 3,500 px without an exit door)
const ctaInlineData = {
  type: 'cta-band' as const,
  text_fr: "Un doute sur le palier d'entrée ? 30 minutes au téléphone suffisent pour le situer.",
  text_en: 'Not sure which tier to start at? A 30-minute call is enough to place it.',
  cta: { label_fr: 'Réserver un audit →', label_en: 'Book an audit →', href: localizeHref('/contact', 'en'), variant: 'primary' as const },
  background: 'paper-2' as const,
} satisfies SectionByType<'cta-band'>;

// FAQ SMB-first · 8 questions (V5: + CMS, + brand consistency)
const faqItems = [
  {
    q: "How much does a first engagement with Waimia cost?",
    a: "AI Activation · 1 week starts at €1,500: audit, training, first workflow shipped. AI Growth System starts at €5,000. Most SMBs start small, measure in 5 days, then wire the full system.",
  },
  {
    q: "Who is this for, and who is it not for?",
    a: "French and Swiss SMBs and mid-market companies, 20 to 500 people. Not large groups already loaded with vendors. Not very young startups changing direction every week. Best fits: B2B services, industry, finance and accounting firms.",
  },
  {
    q: "How fast do we see ROI?",
    a: "AI Activation · 1 week: a workflow in production in 5 days, before/after measure included. Growth System: full system in 6 to 10 weeks. Tuesday we wire, Friday we measure. We measure each engagement's ROI before/after, on your scope: no invented average figure.",
  },
  {
    q: "Do you work with our current stack (HubSpot, Salesforce, Excel, etc.)?",
    a: "Yes: we plug into your current stack: HubSpot, Salesforce, Pipedrive, Notion, Excel, Office, ERP, GA4, Search Console. No forced migration. If you have no CRM, we propose one matched to your volume: often HubSpot for B2B SMBs.",
  },
  {
    q: "And our current website and CMS? Do we have to rebuild everything?",
    a: "No. We plug into your existing CMS (WordPress, Webflow, Sanity, headless) or move to a Git-based CMS if team maturity allows. AI-first sites, landing pages, tunnels and evolving pages can live in parallel or progressively replace what you have: at your own rhythm.",
  },
  {
    q: "How do you guarantee brand consistency across every channel?",
    a: "We start from your design system (or build one), encode your guidelines and tone into templates, then deploy aligned production agents. Result: site, posts, decks, PDF, ads and sales material stay visually and verbally consistent even when AI produces in volume.",
  },
  {
    q: "What if we want to bring the system in-house?",
    a: "Everything is documented, open, transferable. No black box, no lock-in. We train your team during the engagement (2 to 3 days) and ship the full operating manual. You keep the platform when we leave.",
  },
  {
    q: "How do you guarantee GDPR and AI Act compliance?",
    a: "Every system includes by default: action logs, CSV/JSON export, rollback capability, AI Act risk classification. For mid-market engagements, we run a PIA before the sprint. Our Trust Center documents the full governance.",
  },
];
---
<Base
  title="Waimia · AI Systems for SMBs · Acquisition · CRM · Content · Web · Brand"
  description="We wire AI into SMB tools: acquisition, CRM, content, website, analytics, brand. AI Activation · 1 week, AI Growth System, Operational Productivity. Solo studio in Montpellier."
  jsonLd={[buildOrganization()]}
>
  <BootSplash lang="en" />

  {/* 01 — Hero · promise + scope mini-map + CTAs · UNTOUCHED (quality reference) */}
  <Hero />

  <div class="home-typo">

    {/* 02 — Unified proof band · 3 non-hero metrics + logos + case files link (Act I) */}
    <StatBlock data={proofBarData} lang="en" />
    <SocialProof data={socialProofData} lang="en" />

    <SectionTransition phrase="The numbers don't come from a single tool. They come from a connected system." />

    {/* 03 — ArchitectureDiagram · FIG 2.0 · the mental model, flows drawn on scroll */}
    <ArchitectureDiagram data={architectureDiagramData} lang="en" />

    {/* 04 — ServicesGrid · FIG 2.5 · the single offer taxonomy (UseCaseIndex merged) */}
    <ServicesGrid data={servicesGridData} lang="en" />

    {/* 05 — Cards-only pyramid · stage + entry price + I→IV gauge (Act III) */}
    <MaturityPyramid data={maturityPyramidData} lang="en" />

    {/* 05b — Inline CTA · exit door at the pricing moment (P1-8) */}
    <CtaBandSection data={ctaInlineData} lang="en" />

    <SectionTransition phrase="Verifiable promise, not pitch." />

    {/* 07 — Cases · 4 anonymized dossiers (CASE_FEED) */}
    <CaseCardGrid data={caseCardGridData('en')} lang="en" />

    {/* 08 — FaqAccordion · 8 SMB-first questions · Q.01 (pricing) open by default */}
    <FaqAccordion
      items={faqItems}
      heading="Frequently asked questions"
      intro="Eight straight answers, no slides, no jargon. The kind we send by email before the first call."
      background="paper-2"
      openFirst
    />

    {/* 09 — Field notes ×3 · doctrine + internal linking (1 CASE max) */}
    <EditorialPreview data={editorialPreviewData('en', [0, 2, 3])} lang="en" />

    <SectionTransition phrase="Reading helps you understand. An audit puts numbers on it." />

    {/* 10 — BookSession · ink climax · primary CTA toward /contact (Act V) */}
    <BookSession />

  </div>

  {/* FooterMarquee · editorial animated band pre-scrollprogress */}
  <FooterMarquee />

  <ScrollProgress />
  <script>
    import { initHomepageNarrative } from '../../lib/animations/signature/homepage-narrative';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    function bootstrap() {
      ScrollTrigger.getAll().forEach((t) => t.kill());
      initHomepageNarrative();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootstrap);
    } else {
      bootstrap();
    }
    document.addEventListener('astro:page-load', bootstrap);
  </script>
</Base>
