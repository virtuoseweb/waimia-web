---
// Page · /en/contact · Book a working session
export const prerender = true;

import UtilityTemplate from '../../components/templates/UtilityTemplate.astro';
import Button from '../../components/ui/atoms/Button.astro';
import CalEmbed from '../../components/ui/molecules/CalEmbed.astro';
import Kicker from '../../components/ui/atoms/Kicker.astro';

const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': 'https://waimia.com/en/contact',
  name: 'Contact Waimia',
  url: 'https://waimia.com/en/contact',
  mainEntity: {
    '@type': 'Organization',
    name: 'Waimia',
    email: 'hello@waimia.com',
    contactPoint: [{
      '@type': 'ContactPoint',
      contactType: 'sales',
      email: 'hello@waimia.com',
      areaServed: ['FR', 'CH', 'BE', 'LU', 'GB', 'US'],
      availableLanguage: ['French', 'English'],
    }],
  },
};
---
<UtilityTemplate
  title="Contact · Book a working session · Waimia"
  description="A 45-minute session for a diagnosed problem, or no follow-up. Paris, Geneva, Meet, Zoom. Reply within 24 business hours."
  kicker="§ Contact"
  align="centered"
  jsonLd={contactLd}
  headlineFr="Une <i>séance</i>.<br />Pas un pitch."
  headlineEn="A <i>session</i>.<br />Not a pitch."
  ledeFr="45 minutes. On revient avec un problème diagnostiqué, ou on ne relance pas."
  ledeEn="45 minutes. We come back with a diagnosed problem, or we don't follow up."
>
  <Fragment slot="body">
    <div class="contact-grid">
      {/* Form */}
      <form class="contact-form" method="POST" action="/api/contact" name="contact" data-contact-form novalidate>
        <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;overflow:hidden">
          <label for="contact-hp">Ne pas remplir</label>
          <input type="text" id="contact-hp" name="_hp" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="lang" value="en" />
        <div class="form-row">
          <label for="company"><span>Company</span><span aria-hidden>*</span></label>
          <input id="company" name="company" type="text" required autocomplete="organization" />
        </div>
        <div class="form-row">
          <label for="name"><span>Your name</span><span aria-hidden>*</span></label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="form-row">
          <label for="email"><span>Work email</span><span aria-hidden>*</span></label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="form-row">
          <label for="role">Role</label>
          <input id="role" name="role" type="text" autocomplete="organization-title" />
        </div>
        <div class="form-row form-row-full">
          <label for="brief"><span>The problem in 3 sentences</span><span aria-hidden>*</span></label>
          <textarea id="brief" name="brief" rows="4" required></textarea>
        </div>
        <p class="form-error-global" role="alert" aria-live="assertive" hidden data-contact-error></p>
        <Button as="button" type="submit" variant="primary" size="lg">Book 45 min →</Button>
      </form>

      {/* Aside · direct contact */}
      <aside class="contact-aside">
        <h2 class="contact-aside-h2">Or directly</h2>
        <ul class="contact-list">
          <li>
            <span class="contact-k">Email</span>
            <a href="mailto:hello@waimia.com">hello@waimia.com</a>
          </li>
          <li>
            <span class="contact-k">Booking</span>
            <a href="https://cal.com/simonberos/audit" rel="noopener" target="_blank">cal.com/simonberos/audit ↗</a>
          </li>
          <li>
            <span class="contact-k">LinkedIn</span>
            <a href="https://linkedin.com/company/waimia" rel="noopener" target="_blank">/company/waimia ↗</a>
          </li>
          <li>
            <span class="contact-k">Paris</span>
            <span>15 rue de la Paix · 75002</span>
          </li>
          <li>
            <span class="contact-k">Geneva</span>
            <span>8 rue du Rhône · 1204</span>
          </li>
        </ul>
        <p class="contact-foot">Reply within 24 business hours. Everything is NDA-protected. No automated pitch.</p>
      </aside>
    </div>

    {/* Cal.com embed inline · direct option without form */}
    <div class="contact-cal">
      <Kicker tone="accent" class="contact-cal-k">§ Or directly · book now</Kicker>
      <h2 class="contact-cal-h2">No form. <i>Pick</i> a slot.</h2>
      <p class="contact-cal-lead">
        If you already know what you need, skip the form and book 45 minutes directly
        below. Calendar synced Paris–Geneva.
      </p>
      <CalEmbed layout="inline" />
    </div>
  </Fragment>
</UtilityTemplate>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(40px, 6vw, 80px);
    max-width: 1100px;
    margin: 0 auto;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .form-row { display: flex; flex-direction: column; gap: 6px; }
  .form-row-full { grid-column: 1 / -1; }
  .form-row label {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    display: flex;
    gap: var(--space-1);
  }
  .form-row label span:last-child { color: var(--accent); }
  .form-row input,
  .form-row textarea {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    padding: var(--space-3) 14px;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-xs);
    background: var(--paper);
    color: var(--ink);
    transition: border-color var(--dur-fast) var(--ease);
  }
  .form-row input:focus,
  .form-row textarea:focus {
    border-color: var(--accent);
  }
  .form-errors { color: var(--accent); font-size: var(--text-body-sm); margin-top: var(--space-2); min-height: 1em; }
  .contact-form :global(.btn) { border-radius: var(--radius-xs); }

  .contact-aside {
    border-left: 1px solid var(--hairline);
    padding-left: clamp(20px, 3vw, 40px);
  }
  .contact-aside-h2 {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 32px);
    line-height: var(--leading-h3);
    letter-spacing: -0.018em;
    font-weight: var(--fw-regular);
    margin: 0 0 var(--space-5);
  }
  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .contact-list li { display: flex; flex-direction: column; gap: var(--space-1); }
  .contact-k {
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .contact-list a {
    color: var(--accent);
    transition: color var(--dur-fast) var(--ease);
  }
  .contact-list a:hover { color: var(--accent-2, var(--accent)); }
  .contact-foot {
    font-size: var(--text-ui);
    color: var(--muted);
    line-height: var(--leading-body);
    margin: 0;
  }

  .contact-cal {
    max-width: 1100px;
    margin: clamp(60px, 8vw, 100px) auto 0;
    padding-top: clamp(40px, 5vw, 60px);
    border-top: 1px solid var(--hairline);
  }
  :global(.contact-cal-k) { display: block; margin-bottom: 18px; }
  .contact-cal-h2 {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 64px);
    line-height: var(--leading-h1);
    letter-spacing: -0.024em;
    margin: 0 0 18px;
    text-wrap: balance;
    font-weight: var(--fw-regular);
  }
  .contact-cal-h2 :global(i) { font-style: italic; color: var(--accent); }
  .contact-cal-lead {
    font-size: var(--text-body-base);
    line-height: 1.55;
    color: var(--muted);
    margin: 0 0 var(--space-6);
    max-width: 680px;
  }

  .form-error-global {
    color: var(--accent);
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    margin: 0;
  }

  @media (max-width: 800px) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-aside { border-left: none; padding-left: 0; border-top: 1px solid var(--hairline); padding-top: var(--space-6); }
  }
</style>

<script is:inline>
(function () {
  function bindForm(form) {
    if (form.dataset.contactBound) return;
    form.dataset.contactBound = '1';

    var langInput = form.querySelector('input[name="lang"]');
    var lang = langInput ? langInput.value : 'en';
    var errorEl = form.querySelector('[data-contact-error]');
    var btn = form.querySelector('button[type="submit"]');

    function showError(msg) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.removeAttribute('hidden');
    }
    function clearError() {
      if (!errorEl) return;
      errorEl.setAttribute('hidden', '');
      errorEl.textContent = '';
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      clearError();
      if (btn) btn.disabled = true;

      var payload = Object.fromEntries(new FormData(form).entries());

      try {
        var res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        var data = await res.json();
        if (data.ok && data.redirect) {
          window.location.href = data.redirect;
        } else {
          showError(data.error || (lang === 'fr' ? 'Erreur, veuillez réessayer.' : 'Error, please try again.'));
          if (btn) btn.disabled = false;
        }
      } catch (_) {
        showError(lang === 'fr' ? 'Erreur réseau, veuillez réessayer.' : 'Network error, please try again.');
        if (btn) btn.disabled = false;
      }
    });
  }

  document.querySelectorAll('form[data-contact-form]').forEach(bindForm);
  document.addEventListener('astro:page-load', function () {
    document.querySelectorAll('form[data-contact-form]').forEach(function (form) {
      delete form.dataset.contactBound;
      bindForm(form);
    });
  });
})();
</script>
