---
export const prerender = true;

import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import CaseStudyTemplate from '../../../components/templates/CaseStudyTemplate.astro';
import AuthorByline from '../../../components/ui/molecules/AuthorByline.astro';
import AuthorCard from '../../../components/ui/molecules/AuthorCard.astro';
import { buildArticle } from '../../../lib/seo/schema-builder';
import Base from '../../../layouts/Base.astro';
import SectionsRenderer from '../../../components/sections/SectionsRenderer.astro';
import Breadcrumb from '../../../components/ui/molecules/Breadcrumb.astro';

export async function getStaticPaths() {
  const entries = await getCollection('cases');
  return entries
    .filter((entry) => !entry.data.seo?.noindex)
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

type Props = { entry: CollectionEntry<'cases'> };

const slugifyAuthorName = (name: string) =>
  name.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const getAuthorSlug = (author: unknown): string | undefined => {
  if (!author) return undefined;
  if (typeof author === 'string') return author;
  if (typeof author !== 'object') return undefined;

  const ref = author as { id?: unknown; slug?: unknown; url?: unknown; name?: unknown };
  if (typeof ref.id === 'string') return ref.id;
  if (typeof ref.slug === 'string') return ref.slug;
  if (typeof ref.url === 'string') return ref.url.split('/').filter(Boolean).at(-1);
  if (typeof ref.name === 'string') return slugifyAuthorName(ref.name);
  return undefined;
};

const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const d = entry.data;
const authorSlug = getAuthorSlug(d.author);

// Nom d'affichage de l'auteur résolu depuis la collection authors (champ title_en,
// = celui rendu par AuthorByline/AuthorCard). Robuste : undefined si introuvable.
let authorName: string | undefined;
if (authorSlug) {
  try {
    const authorEntry = await getEntry('authors', authorSlug);
    authorName = authorEntry?.data.title_en;
  } catch {
    authorName = undefined;
  }
}

const allCases = await getCollection('cases');
const idx = allCases.findIndex((c) => c.id === entry.id);

const specs = [
  { label_fr: 'Client', label_en: 'Client', value: d.ndaProtected ? 'Confidential': d.client },
  { label_fr: 'Secteur', label_en: 'Sector', value: d.sector_en ?? d.sector_fr },
  { label_fr: 'Durée', label_en: 'Duration', value: d.duration },
  { label_fr: 'Stack', label_en: 'Stack', value: d.stack.slice(0, 3).join(' · ') },
];

const proofMetrics = (d.metrics ?? []).map((m) => ({ k: m.value, label_fr: m.label_fr, label_en: m.label_en }));

const relatedCards = allCases
  .filter((c) => c.id !== entry.id)
  .slice(0, 3)
  .map((c) => ({
    kicker: `§ Case · ${c.data.sector_en ?? c.data.sector_fr}`,
    title_fr: c.data.title_fr,
    title_en: c.data.title_en,
    lead_fr: c.data.impact_fr,
    lead_en: c.data.impact_en,
    href: `/en/cas/${c.id}`,
  }));

// JSON-LD Article · GEO/AIO : rend les cas indexables par les crawlers LLM
// (mirroir du pattern blog/EssayTemplate — réutilise buildArticle de schema-builder)
const siteUrl = 'https://waimia.com';
const caseUrl = `${siteUrl}/en/cas/${entry.id}`;
const caseLd = buildArticle({
  headline: d.title_en,
  description: d.description_en ?? d.description_fr,
  datePublished: new Date(d.publishedAt).toISOString().slice(0, 10),
  dateModified: d.updatedAt ? new Date(d.updatedAt).toISOString().slice(0, 10): undefined,
  author: {
    '@type': 'Person',
    ...(authorSlug ? { '@id': `${siteUrl}/equipe/${authorSlug}#person`, url: `${siteUrl}/equipe/${authorSlug}` }: {}),
    ...(authorName ? { name: authorName }: {}),
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: 'Waimia',
    logo: { '@type': 'ImageObject', url: `${siteUrl}/og/logo.svg` },
  },
  mainEntityOfPage: caseUrl,
  articleSection: d.sector_en ?? d.sector_fr,
  ...(d.heroImage ? { image: d.heroImage.startsWith('http') ? d.heroImage: `${siteUrl}${d.heroImage}` }: {}),
  ...(d.tags && d.tags.length > 0 ? { keywords: d.tags }: {}),
});
---
{/* D.7 · Adoption composable — si frontmatter contient `sections`, utiliser SectionsRenderer */}
{(() => { const useComposable = Array.isArray(d.sections) && d.sections.length > 0; return useComposable ? (
  <Base title={`${d.title_en} · Waimia`} description={d.description_en ?? d.description_fr} jsonLd={caseLd}>
    <Breadcrumb lang="en" items={[
      { label: 'Home', href: '/en' },
      { label: 'Case studies', href: '/en/cas' },
      { label: d.title_en },
    ]} />
    <SectionsRenderer sections={d.sections!} lang="en" />
    <section class="case-author-card-band">
      <div class="wrap-wide"><AuthorCard authorSlug={authorSlug} variant="full" /></div>
    </section>
    {/* TODO related page-level (omis ce lot) */}
  </Base>
) : (
  <CaseStudyTemplate
    title={`${d.title_en} · Waimia`}
    description={d.description_en ?? d.description_fr}
    jsonLd={caseLd}
    caseNum={String(idx + 1).padStart(2, '0')}
    h1_fr={d.title_fr}
    h1_en={d.title_en}
    specs={specs}
    steps={[] as any[]}
    proofQuoteFr={d.impact_fr}
    proofQuoteEn={d.impact_en}
    proofAttrFr={d.ndaProtected ? 'Confidentiel': d.client}
    proofAttrEn={d.ndaProtected ? 'Confidential': d.client}
    proofMetrics={proofMetrics}
    techPills={d.stack.map((s) => ({ label: s, kind: 'primary' as const }))}
    relatedCards={relatedCards}
    contextStatementFr={d.contextStatement_fr}
    contextStatementEn={d.contextStatement_en}
    contextStats={d.contextStats}
    bottlenecks={d.bottlenecks}
    phases={d.phases}
    deliverableCards={d.deliverableCards}
    shifts={d.shifts}
    pullQuoteFr={d.pullQuote_fr}
    pullQuoteEn={d.pullQuote_en}
    pullQuoteCiteFr={d.pullQuoteCite_fr}
    pullQuoteCiteEn={d.pullQuoteCite_en}
  >
    <Fragment slot="author-byline">
      <AuthorByline authorSlug={authorSlug} date={d.publishedAt} />
    </Fragment>
    <Fragment slot="context">
      <Content />
    </Fragment>
    <Fragment slot="author-card">
      <AuthorCard authorSlug={authorSlug} variant="full" />
    </Fragment>
    <Fragment slot="approach-headline">What we built.</Fragment>
    <Fragment slot="stack-lead">{d.impact_en}</Fragment>
  </CaseStudyTemplate>
); })()}
