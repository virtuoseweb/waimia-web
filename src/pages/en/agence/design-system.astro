---
// Page · /en/agence/design-system · Waimia design system showcase — EN mirror
export const prerender = true;

import Base from '../../../layouts/Base.astro';
import Kicker from '../../../components/ui/atoms/Kicker.astro';
import ChapterLabel from '../../../components/ui/atoms/ChapterLabel.astro';
import Button from '../../../components/ui/atoms/Button.astro';
import PillCTA from '../../../components/ui/atoms/PillCTA.astro';
import TerminalCTA from '../../../components/ui/atoms/TerminalCTA.astro';
import SectionHeader from '../../../components/ui/molecules/SectionHeader.astro';
import NewsletterSignup from '../../../components/ui/molecules/NewsletterSignup.astro';
import PainPointInline from '../../../components/ui/molecules/PainPointInline.astro';
import ShareButtons from '../../../components/ui/molecules/ShareButtons.astro';
import StatRow from '../../../components/ui/molecules/StatRow.astro';
import TechPillRow from '../../../components/ui/molecules/TechPillRow.astro';
import RelatedCards from '../../../components/ui/molecules/RelatedCards.astro';
import HeroSplit from '../../../components/sections/HeroSplit.astro';
import HeroCentered from '../../../components/sections/HeroCentered.astro';
import FeatureGrid from '../../../components/sections/FeatureGrid.astro';
import CtaFinal from '../../../components/sections/CtaFinal.astro';
import { LIBRARY_ORGANISMS } from '../../../lib/library-manifest';

const atomKnobs = {
  Kicker: [
    { name: 'tone · 3 variants', values: ['muted', 'accent', 'dim'] },
    { name: 'size', values: ['number px'] }, { name: 'as', values: ['div', 'span', 'p'] },
    { name: 'textTransform', values: ['uppercase', 'none'] }, { name: 'letterSpacing', values: ['string em'] },
    { name: 'consumed tokens', values: ['--font-mono', '--muted', '--accent'] },
  ],
  ChapterLabel: [
    { name: 'tone · 2 variants', values: ['muted', 'dim'] }, { name: 'num / title', values: ['string'] },
    { name: 'noDot', values: ['boolean'] },
    { name: 'consumed tokens', values: ['--font-mono', '--text-eyebrow', '--muted', '--accent', '--radius-full'] },
  ],
  Button: [
    { name: 'variant · 4 variants', values: ['primary', 'ghost', 'accent', 'link'] },
    { name: 'size · 2 variants', values: ['md', 'lg'] }, { name: 'mag', values: ['number', 'magnetic effect'] },
    { name: 'href / as', values: ['href string', 'a', 'button'] }, { name: 'states', values: ['disabled', 'loading'] },
    { name: 'tokens consumed via .btn-*', values: ['--ink', '--paper', '--accent', '--accent-2', '--radius-xs', '--ease'] },
  ],
  PillCTA: [
    { name: 'variant · 3 variants', values: ['accent', 'ghost-dark', 'accent-mono'] }, { name: 'mag', values: ['number'] },
    { name: 'consumed tokens', values: ['--accent', '--paper', '--font-mono', '--text-ui', '--ease'] },
  ],
  TerminalCTA: [
    { name: 'variant · 4 variants', values: ['ink', 'ink-ghost', 'accent', 'ghost-dark'] },
    { name: 'size · 2 variants', values: ['md', 'sm'] }, { name: 'mag', values: ['number'] },
    { name: 'consumed tokens', values: ['--ink', '--paper', '--accent', '--font-mono', '--text-ui', '--text-caption', '--ease'] },
  ],
} as const;

const moleculeKnobs = {
  SectionHeader: [
    { name: 'tone · 2 variants', values: ['accent', 'dim'] }, { name: 'roman / label / id', values: ['string'] },
    { name: 'slots', values: ['heading', 'aside', 'chapter'] },
    { name: 'tokens consumed via .sec-hd', values: ['--font-display', '--font-mono', '--text-h2-section', '--accent', '--muted'] },
  ],
  StatRow: [
    { name: 'tone · 2 variants', values: ['paper', 'ink'] }, { name: 'stats[]', values: ['k', 'label_fr', 'label_en'] },
    { name: 'consumed tokens', values: ['--font-display', '--ink', '--paper', '--hairline', '--hairline-strong'] },
  ],
  TechPillRow: [
    { name: 'pills[].kind · 3 variants', values: ['primary', 'open', 'neutral'] }, { name: 'pills[]', values: ['label', 'kind?'] },
    { name: 'consumed tokens', values: ['--accent', '--muted', '--hairline-strong', '--radius-pill', '--text-caption'] },
  ],
  RelatedCards: [
    { name: 'cards[]', values: ['kicker', 'title_fr / title_en', 'lead_fr / lead_en', 'href'] },
    { name: 'visual variant', values: ['single · 3-card grid'] },
    { name: 'consumed tokens', values: ['--font-display', '--font-mono', '--accent', '--paper-2', '--hairline'] },
  ],
  NewsletterSignup: [
    { name: 'variant · 2 variants', values: ['card', 'inline'] }, { name: 'lang', values: ['fr', 'en'] },
    { name: 'consumed tokens', values: ['--font-display', '--font-sans', '--font-mono', '--ink', '--paper', '--hairline'] },
  ],
  PainPointInline: [
    { name: 'severity · 4 variants', values: ['critical', 'high', 'medium', 'low'] },
    { name: 'content / link', values: ['pain', 'solution', 'slug?'] },
    { name: 'consumed tokens', values: ['--font-sans', '--font-mono', '--ink', '--ink-2', '--muted', '--accent', '--hairline'] },
  ],
  ShareButtons: [
    { name: 'variables', values: ['url', 'title', 'lang: fr / en'] }, { name: 'visual variant', values: ['single'] },
    { name: 'consumed tokens', values: ['--font-mono', '--accent', '--muted', '--hairline', '--text-eyebrow'] },
  ],
} as const;

const sectionSchemaKnobs = {
  'hero-offer-detail': ['type: literal', 'breadcrumb_label_fr/en?: string', 'breadcrumb_href?: string', 'tier_fr/en: string', 'h1_fr/en: string', 'lead_fr/en: string', 'cta: ctaSchema', 'meta_fr/en?: string'],
  'hero-sector': ['type: literal', 'dept_fr/en: string', 'h1_fr/en: string', 'lead_fr/en: string', 'cta: ctaSchema', 'meta_fr/en?: string', 'tags?: array { label_fr/en } · max 8'],
  'case-card-grid': ['type: literal', 'fig_num: string', 'fig_title_fr/en: string', 'spec_fr/en: string', 'h2_fr/en: string', 'case/sector/impact_label_fr/en: string', 'cases: array · min 2 / max 6', 'all_label_fr/en?: string', 'all_href?: string'],
  'editorial-preview': ['type: literal', 'kicker_fr/en?: string', 'roman?: string', 'act_label_fr/en?: string', 'aside_fr/en?: string', 'h2_fr/en: string', 'items: array · min 2 / max 8', 'all_label_fr/en?: string', 'all_href?: string'],
  'use-case-index': ['type: literal', 'roman: string', 'label_fr/en: string', 'heading_fr/en: string', 'aside_fr/en?: string', 'num_prefix_fr/en: string', 'items: array · min 2 / max 8', 'footer_label_fr/en?: string', 'footer_href?: string'],
} as const;
---

<Base
  title="Design System · Waimia Catalogue · Tokens · Components · Sections"
  description="English mirror of the Waimia closed design system: tokens, atoms, molecules, composable W6 sections and motion primitives."
  noindex
>
  <section class="ds-hd">
    <div class="wrap-wide">
      <Kicker class="ds-kicker">§ Design System · Waimia Catalogue · v2026.05</Kicker>
      <h1 class="ds-h1">Pick, don’t <i>invent</i>.</h1>
      <p class="ds-lede">
        English mirror of the Waimia closed design system. Use existing tokens and components first,
        then assemble W6 sections instead of creating a new pattern from scratch.
      </p>
      <p class="ds-meta">
        Source pages: <code>/agence/design-system</code> and <code>src/components/sections/</code>
      </p>

      {/* DS Hub: other surfaces */}
      <nav class="ds-hub" aria-label="Design System surfaces">
        <a class="ds-hub-card ds-hub-card--featured" href="/agence/ds-studio">
          <span class="ds-hub-card-label">DS Studio · live editor</span>
          <span class="ds-hub-card-desc">Edit variables and see the rendering change live. Full visual gallery of all atoms, molecules and sections.</span>
        </a>
        <a class="ds-hub-card" href="/agence/hero-lab">
          <span class="ds-hub-card-label">Hero Lab</span>
          <span class="ds-hub-card-desc">Hero variants compared side by side.</span>
        </a>
        <a class="ds-hub-card" href="/preview/feature-grid">
          <span class="ds-hub-card-label">Section preview</span>
          <span class="ds-hub-card-desc">Every section has a live preview at <code>/preview/&lt;type&gt;</code> and its file at <code>/components/&lt;type&gt;</code>.</span>
        </a>
      </nav>
    </div>
  </section>

  <div class="ds-layout">
    <aside class="ds-toc">
      <div class="ds-toc-inner">
        <Kicker class="ds-toc-label">§ Table of contents</Kicker>
        <ol class="ds-toc-list">
          <li><a href="#tokens">1. Tokens</a></li>
          <li><a href="#classes">2. Utility classes</a></li>
          <li><a href="#atoms">3. Atoms</a></li>
          <li><a href="#molecules">4. Molecules</a></li>
          <li><a href="#organisms">5. Organisms</a></li>
          <li><a href="#sections">6. W6 sections</a></li>
          <li><a href="#animations">7. Animations</a></li>
          <li><a href="#editorial">8. Editorial</a></li>
          <li><a href="#motion">9. Motion</a></li>
          <li><a href="#templates">10. Templates</a></li>
        </ol>
      </div>
    </aside>

    <div class="ds-content">
      <section id="tokens" class="ds-section">
        <h2 style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap">1. Tokens</h2>
        <ChapterLabel num="01" title="Tokens" />
        <p class="ds-section-lede">
          Canonical foundations exposed through CSS variables. The English mirror keeps the surface short:
          color, typography and spacing are enough to understand the system’s hierarchy.
        </p>

        <div class="ds-subsection">
          <h3 class="ds-h3">Color palette</h3>
          <div class="ds-swatch-grid">
            <div class="ds-swatch-card">
              <span class="ds-swatch" style="background:var(--paper)"></span>
              <div class="ds-swatch-info">
                <code>--paper</code>
                <span class="ds-swatch-role">default page background</span>
              </div>
            </div>
            <div class="ds-swatch-card">
              <span class="ds-swatch" style="background:var(--paper-2)"></span>
              <div class="ds-swatch-info">
                <code>--paper-2</code>
                <span class="ds-swatch-role">raised surfaces</span>
              </div>
            </div>
            <div class="ds-swatch-card">
              <span class="ds-swatch" style="background:var(--ink)"></span>
              <div class="ds-swatch-info">
                <code>--ink</code>
                <span class="ds-swatch-role">primary text and strong CTA</span>
              </div>
            </div>
            <div class="ds-swatch-card">
              <span class="ds-swatch" style="background:var(--accent)"></span>
              <div class="ds-swatch-info">
                <code>--accent</code>
                <span class="ds-swatch-role">editorial emphasis</span>
              </div>
            </div>
          </div>
        </div>

        <div class="ds-subsection">
          <h3 class="ds-h3">Type stack</h3>
          <div class="ds-type-stacks">
            <div class="ds-type-row">
              <strong style="font-family:var(--font-display);font-size:34px;font-weight:var(--fw-regular)">Instrument Serif</strong>
              <p class="ds-help">Display headlines, contrast, editorial pacing.</p>
            </div>
            <div class="ds-type-row">
              <strong style="font-family:var(--font-sans);font-size:18px;font-weight:var(--fw-semibold)">Inter Tight</strong>
              <p class="ds-help">UI text, body copy, functional density.</p>
            </div>
            <div class="ds-type-row">
              <strong style="font-family:var(--font-mono);font-size:var(--text-ui);font-weight:var(--fw-medium)">JetBrains Mono</strong>
              <p class="ds-help">Labels, system notes, metadata and code snippets.</p>
            </div>
          </div>
          <h4 class="ds-h4">Editorial title · simple vs two-tone</h4>
          <div class="ds-editorial-title-demo">
            <div>
              <span class="ds-label">Simple</span>
              <p>AI acquisition. More qualified leads.</p>
            </div>
            <div>
              <span class="ds-label">Two-tone</span>
              <p>AI <i class="acc">acquisition</i>. More <i class="acc">qualified leads</i>.</p>
            </div>
          </div>
          <p class="ds-help">Driven by the <code>hero_title_html</code> content field (offers/solutions); without an accent, the title stays simple.</p>
        </div>

        {/* 1.3 Spacing scale */}
        <div class="ds-subsection">
          <h3 class="ds-h3">1.3 · Spacing scale (4/8pt · 15 --space tokens + 4 section rhythms)</h3>
          <div class="ds-spacing-grid">
            <div class="ds-spacing-row"><code>--space-1</code> <span class="ds-spacing-bar" style="width:4px"></span> <span class="ds-spacing-val">4px</span></div>
            <div class="ds-spacing-row"><code>--space-2</code> <span class="ds-spacing-bar" style="width:8px"></span> <span class="ds-spacing-val">8px</span></div>
            <div class="ds-spacing-row"><code>--space-3</code> <span class="ds-spacing-bar" style="width:12px"></span> <span class="ds-spacing-val">12px</span></div>
            <div class="ds-spacing-row"><code>--space-4</code> <span class="ds-spacing-bar" style="width:16px"></span> <span class="ds-spacing-val">16px</span></div>
            <div class="ds-spacing-row"><code>--space-5</code> <span class="ds-spacing-bar" style="width:24px"></span> <span class="ds-spacing-val">24px</span></div>
            <div class="ds-spacing-row"><code>--space-6</code> <span class="ds-spacing-bar" style="width:32px"></span> <span class="ds-spacing-val">32px</span></div>
            <div class="ds-spacing-row"><code>--space-7</code> <span class="ds-spacing-bar" style="width:40px"></span> <span class="ds-spacing-val">40px</span></div>
            <div class="ds-spacing-row"><code>--space-8</code> <span class="ds-spacing-bar" style="width:48px"></span> <span class="ds-spacing-val">48px</span></div>
            <div class="ds-spacing-row"><code>--space-9</code> <span class="ds-spacing-bar" style="width:64px"></span> <span class="ds-spacing-val">64px</span></div>
            <div class="ds-spacing-row"><code>--space-10</code> <span class="ds-spacing-bar" style="width:80px"></span> <span class="ds-spacing-val">80px</span></div>
            <div class="ds-spacing-row"><code>--space-11</code> <span class="ds-spacing-bar" style="width:96px"></span> <span class="ds-spacing-val">96px</span></div>
            <div class="ds-spacing-row"><code>--space-12</code> <span class="ds-spacing-bar" style="width:120px"></span> <span class="ds-spacing-val">120px</span></div>
            <div class="ds-spacing-row"><code>--space-13</code> <span class="ds-spacing-bar" style="width:160px"></span> <span class="ds-spacing-val">160px</span></div>
            <div class="ds-spacing-row"><code>--space-14</code> <span class="ds-spacing-bar" style="width:200px"></span> <span class="ds-spacing-val">200px</span></div>
            <div class="ds-spacing-row"><code>--space-15</code> <span class="ds-spacing-bar" style="width:256px"></span> <span class="ds-spacing-val">256px</span></div>
          </div>
          <p class="ds-help">+ section rhythm : <code>--section-tight</code> 48px · <code>--section-base</code> 96px · <code>--section-loose</code> 160px · <code>--section-grand</code> 256px</p>
        </div>
      </section>

      <section id="classes" class="ds-section">
        <h2 style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap">2. Utility classes</h2>
        <ChapterLabel num="02" title="Utility Classes" />
        <p class="ds-section-lede">
          Existing utility layer already covers reveal patterns, hairlines and button classes. Reuse first,
          extend only when a new primitive is justified.
        </p>
        <ul class="ds-z-list">
          <li><code>.reveal-fade</code>, <code>.reveal-up</code>, <code>.clip-up</code>, <code>.blur-in</code> for scroll entry.</li>
          <li><code>.btn</code> plus variant classes for direct HTML usage when no Astro component is needed.</li>
          <li><code>.hline</code> and <code>.hline-strong</code> for quiet editorial separation.</li>
        </ul>
      </section>

      <section id="atoms" class="ds-section">
        <h2 style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap">3. Atoms</h2>
        <ChapterLabel num="03" title="Atoms" />
        <p class="ds-section-lede">
          Smallest reusable pieces. The EN page keeps the core demos: kicker rhythm, chapter labels, buttons
          and raw form fields aligned on the same tokens.
        </p>

        <div class="ds-subsection">
          <h3 class="ds-h3">Kicker + ChapterLabel</h3>
          <div class="ds-row" style="gap:16px;align-items:center;flex-wrap:wrap">
            <Kicker>§ MUTED LABEL</Kicker>
            <Kicker tone="accent">§ ACCENT LABEL</Kicker>
          </div>
          <div style="margin-top:20px">
            <ChapterLabel num="III · 2.1" title="Act III: The delivery layer" />
          </div>
          <div class="ds-knobs">{atomKnobs.Kicker.map((knob) => <article class="ds-knob"><span class="ds-knob-name">{knob.name}</span><div class="ds-knob-values">{knob.values.map((value) => <span class="ds-knob-val">{value}</span>)}</div></article>)}</div>
          <div class="ds-knobs">{atomKnobs.ChapterLabel.map((knob) => <article class="ds-knob"><span class="ds-knob-name">{knob.name}</span><div class="ds-knob-values">{knob.values.map((value) => <span class="ds-knob-val">{value}</span>)}</div></article>)}</div>
        </div>

        <div class="ds-subsection">
          <h3 class="ds-h3">Button variants</h3>
          <div class="ds-row" style="gap:12px">
            <Button href="/en/contact" variant="primary">Primary</Button>
            <Button href="/en/contact" variant="ghost">Ghost</Button>
            <Button href="/en/contact" variant="accent">Accent</Button>
            <Button href="#atoms" variant="link">Link →</Button>
          </div>
          <div class="ds-knobs">{atomKnobs.Button.map((knob) => <article class="ds-knob"><span class="ds-knob-name">{knob.name}</span><div class="ds-knob-values">{knob.values.map((value) => <span class="ds-knob-val">{value}</span>)}</div></article>)}</div>
        </div>

        <div class="ds-subsection">
          <h3 class="ds-h3">PillCTA · 3 variants</h3>
          <div class="ds-row" style="gap:12px">
            <PillCTA href="#" variant="accent">Pill accent</PillCTA>
            <PillCTA href="#" variant="ghost-dark">Pill ghost-dark</PillCTA>
            <PillCTA href="#" variant="accent-mono">▸ Pill accent-mono</PillCTA>
          </div>
          <div class="ds-knobs">{atomKnobs.PillCTA.map((knob) => <article class="ds-knob"><span class="ds-knob-name">{knob.name}</span><div class="ds-knob-values">{knob.values.map((value) => <span class="ds-knob-val">{value}</span>)}</div></article>)}</div>
        </div>

        <div class="ds-subsection">
          <h3 class="ds-h3">TerminalCTA · 4 variants</h3>
          <div class="ds-row" style="gap:12px">
            <TerminalCTA href="#" variant="ink">▸ open console</TerminalCTA>
            <TerminalCTA href="#" variant="ink-ghost">Book a session →</TerminalCTA>
            <TerminalCTA href="#" variant="accent">▸ schedule</TerminalCTA>
          </div>
          <div class="ds-knobs">{atomKnobs.TerminalCTA.map((knob) => <article class="ds-knob"><span class="ds-knob-name">{knob.name}</span><div class="ds-knob-values">{knob.values.map((value) => <span class="ds-knob-val">{value}</span>)}</div></article>)}</div>
        </div>

        <div class="ds-subsection">
          <h3 class="ds-h3">Form elements (raw HTML · DS tokens)</h3>
          <div class="ds-form-group">
            <label class="ds-label" for="en-ds-input-text">Text input</label>
            <input id="en-ds-input-text" class="ds-input" type="text" placeholder="Agent cockpit name" />
          </div>
          <div class="ds-form-group">
            <label class="ds-label" for="en-ds-textarea">Textarea</label>
            <textarea id="en-ds-textarea" class="ds-textarea" rows="4" placeholder="Describe the operational constraint to fix."></textarea>
          </div>
          <div class="ds-form-group">
            <label class="ds-label" for="en-ds-select">Select</label>
            <select id="en-ds-select" class="ds-select">
              <option>Select a severity level</option>
              <option>Critical</option>
              <option>High</option>
              <option>Medium</option>
            </select>
          </div>
          <div class="ds-form-group">
            <span class="ds-label">Checkbox</span>
            <label class="ds-check-group">
              <input class="ds-check" type="checkbox" checked />
              <span>Enable run monitoring</span>
            </label>
          </div>
          <div class="ds-form-group">
            <span class="ds-label">Radio</span>
            <label class="ds-check-group">
              <input class="ds-check" type="radio" name="en-ds-audit-mode" checked />
              <span>Light audit</span>
            </label>
            <label class="ds-check-group">
              <input class="ds-check" type="radio" name="en-ds-audit-mode" />
              <span>Full audit</span>
            </label>
          </div>
        </div>
      </section>

      <section id="molecules" class="ds-section">
        <h2 style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap">4. Molecules</h2>
        <ChapterLabel num="04" title="Molecules" />
        <p class="ds-section-lede">
          Functional compositions used repeatedly across sales, editorial and diagnostic pages.
        </p>

        <div class="ds-subsection">
          <h3 class="ds-h3">SectionHeader</h3>
          <SectionHeader roman="IV" label="Act IV: The operating layer" id="en-ds-demo-header">
            <Fragment slot="heading">Four <i>operational</i> surfaces, one system.</Fragment>
            <Fragment slot="aside">Enough structure to ship, enough room to adapt.</Fragment>
          </SectionHeader>
          <div class="ds-knobs">{moleculeKnobs.SectionHeader.map((knob) => <article class="ds-knob"><span class="ds-knob-name">{knob.name}</span><div class="ds-knob-values">{knob.values.map((value) => <span class="ds-knob-val">{value}</span>)}</div></article>)}</div>
        </div>

        <div class="ds-subsection">
          <h3 class="ds-h3">StatRow</h3>
          <StatRow stats={[
            { k: '5 j', label_fr: 'pour cibler le levier', label_en: 'to pinpoint the lever' },
            { k: '4 sem.', label_fr: 'au premier workflow', label_en: 'to first workflow' },
            { k: '1', label_fr: 'interlocuteur unique', label_en: 'single point of contact' },
            { k: '12', label_fr: 'juridictions UE', label_en: 'EU jurisdictions' },
          ]} />
          <div class="ds-knobs">{moleculeKnobs.StatRow.map((knob) => <article class="ds-knob"><span class="ds-knob-name">{knob.name}</span><div class="ds-knob-values">{knob.values.map((value) => <span class="ds-knob-val">{value}</span>)}</div></article>)}</div>
        </div>

        <div class="ds-subsection">
          <h3 class="ds-h3">TechPillRow</h3>
          <TechPillRow pills={[
            { label: 'Claude Opus', kind: 'primary' },
            { label: 'PostgreSQL', kind: 'open' },
            { label: 'HubSpot', kind: 'neutral' },
          ]} />
          <div class="ds-knobs">{moleculeKnobs.TechPillRow.map((knob) => <article class="ds-knob"><span class="ds-knob-name">{knob.name}</span><div class="ds-knob-values">{knob.values.map((value) => <span class="ds-knob-val">{value}</span>)}</div></article>)}</div>
        </div>

        <div class="ds-subsection">
