---
// Page · /en/agence/about · About Waimia — EN mirror
export const prerender = true;

import UtilityTemplate from '../../../components/templates/UtilityTemplate.astro';
import Kicker from '../../../components/ui/atoms/Kicker.astro';
---
<UtilityTemplate
  title="The Studio · Why Waimia · Agentic Systems Architect"
  description="A solo AI studio, bilingual, based in Montpellier. We ship agents that execute, not presentations that spin in committee."
  kicker="§ The Studio"
  align="left"
  headlineFr="Un studio IA solo. <i>Francophone</i>, par choix."
  headlineEn="A solo AI studio. <i>Bilingual</i>, by choice."
  ledeFr="Pas de chaîne offshore. Un praticien qui livre du code le mardi et lit le pipeline le vendredi."
  ledeEn="No offshore chain. No PowerPoint model. A practitioner who ships code on Tuesdays and reads the pipeline on Fridays."
>
  <Fragment slot="body">
    <div class="about-grid reveal-stagger">
      {/* Story · 60 % */}
      <article class="about-prose">
        <Kicker tone="" class="about-kicker">§ 01 · Origin</Kicker>
        <h2>A studio born from a <i>construction site frustration</i>.</h2>
        <p>Waimia starts from a repeated observation: most AI projects deliver demos, not products. A POC passes through committee. An agent shines in the showroom then stalls in June. A consultant leaves with their SharePoint and leaves the internal team to fend for themselves.</p>
        <p>The studio's angle is the opposite. We <i>deliver</i>. We sign. We remain reachable if the agent goes down. We learn by doing, not by gathering committees to talk about AI.</p>

        <Kicker tone="" class="about-kicker">§ 02 · Stance</Kicker>
        <h2>What we <i>refuse</i>.</h2>
        <ul>
          <li>AI theater: purple-glass, circuit-brain, floating hexagons.</li>
          <li>Six-month scoping workshops with no signed deliverable.</li>
          <li>Pitch decks that promise the impossible and hide model limitations.</li>
          <li>Non-auditable agents that turn SaaS into a black box.</li>
          <li>Proprietary no-code wrappers that make clients dependent for life.</li>
        </ul>

        <Kicker tone="" class="about-kicker">§ 03 · Method</Kicker>
        <h2>Four <i>deliverables</i>, never more.</h2>
        <p>Every Waimia engagement produces four canonical deliverables: a map of the existing system, an execution operating procedure, a replayable audit trail, a named on-call human. Not 72 slides, not an 18-month PowerPoint roadmap.</p>
      </article>

      {/* Aside · facts */}
      <aside class="about-aside">
        <Kicker class="about-aside-k">Key facts</Kicker>
        <dl class="about-facts">
          <div><dt>Form</dt><dd>Solo studio · Waimia / VirtuoseWeb</dd></div>
          <div><dt>Founder</dt><dd>Simon Beros</dd></div>
          <div><dt>Based in</dt><dd>Montpellier (FR) · remote everywhere</dd></div>
          <div><dt>Contact</dt><dd>Direct · whoever wires it ships it</dd></div>
          <div><dt>Scope</dt><dd>SMBs &amp; mid-market · acquisition, CRM, productivity</dd></div>
          <div><dt>Partnerships</dt><dd>Anthropic · France Num Activator</dd></div>
          <div><dt>Languages</dt><dd>French + English (strict parity)</dd></div>
        </dl>
      </aside>
    </div>

    {/* ── FINAL CTA ── */}
    <div class="about-cta reveal">
      <span class="about-cta-eyebrow">§ Work with us</span>
      <h2 class="about-cta-h2">Forty-five minutes<br/>to see if it's <i>the right fit</i>.</h2>
      <a href="/en/contact" class="about-cta-btn">Start a diagnostic →</a>
    </div>
  </Fragment>
</UtilityTemplate>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(40px, 6vw, 80px);
    max-width: 1200px;
  }
  .about-prose {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    line-height: var(--leading-prose);
    color: var(--ink-2);
    max-width: var(--wrap-prose);
  }
  :global(.about-kicker) { display: block; margin: clamp(40px, 5vw, 64px) 0 var(--space-3); }
  :global(.about-prose > *:first-child) { margin-top: 0; }
  .about-prose h2 {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.5vw, 44px);
    line-height: var(--leading-h3);
    letter-spacing: -0.02em;
    font-weight: var(--fw-regular);
    margin: 0 0 18px;
    text-wrap: balance;
  }
  .about-prose h2 i { font-style: italic; color: var(--accent); }
  .about-prose p { margin: 0 0 1.2em; }
  .about-prose ul { margin: 0 0 1.4em 1.4em; }
  .about-prose ul li { margin-bottom: 0.5em; }
  .about-prose i { font-style: italic; }

  .about-aside {
    border-left: 1px solid var(--hairline);
    padding-left: clamp(20px, 3vw, 40px);
    align-self: start;
    position: sticky;
    top: 100px;
  }
  :global(.about-aside-k) { display: block; margin-bottom: 18px; }
  .about-facts {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .about-facts > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--hairline);
  }
  .about-facts > div:last-child { border-bottom: none; }
  .about-facts dt {
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .about-facts dd {
    font-family: var(--font-sans);
    font-size: var(--text-body-base);
    margin: 0;
    line-height: var(--leading-lede);
  }

  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-aside { border-left: none; padding-left: 0; border-top: 1px solid var(--hairline); padding-top: var(--space-6); position: static; }
  }

  .about-cta {
    border-top: 1px solid var(--hairline);
    padding-top: clamp(48px, 6vw, 80px);
    margin-top: clamp(64px, 8vw, 100px);
  }
  .about-cta-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--accent);
    margin-bottom: var(--space-5);
  }
  .about-cta-h2 {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.5vw, 64px);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
    font-weight: var(--fw-regular);
    text-wrap: balance;
    margin: 0 0 36px;
  }
  .about-cta-h2 i { font-style: italic; color: inherit; }
  .about-cta-btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-ui);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ink);
    padding: var(--space-4) 36px;
    border: 1px solid var(--ink);
    transition: background var(--dur-trim) var(--ease), border-color var(--dur-trim) var(--ease);
    text-decoration: none;
  }
  .about-cta-btn:hover { background: var(--accent); border-color: var(--accent); }
</style>
