---
export const prerender = true;

// Page SSG · /en/solutions/[slug] · rendu 100 % composable (registry).
// R6 (2026-06-10) · fallback SolutionsDetailTemplate supprimé ICI (voie morte,
// 8/8 solutions composables) ; le template reste LIVE via secteurs/[...slug].astro.

import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SectionsRenderer from '../../../components/sections/SectionsRenderer.astro';
import Breadcrumb from '../../../components/ui/molecules/Breadcrumb.astro';
import { buildService } from '../../../lib/seo/schema-builder';

export async function getStaticPaths() {
  const entries = await getCollection('solutions');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const data = entry.data;

const lang = 'en' as const;
const title = data.title_en;
const description = data.description_en;

if (!Array.isArray(data.sections) || data.sections.length === 0) {
  throw new Error(`en/solutions/${entry.id} : frontmatter \`sections:\` requis (voie template legacy éteinte en R6)`);
}

const serviceLd = buildService({ name: title, description });
---

<Base title={title} description={description} jsonLd={[serviceLd]}>
  <Breadcrumb
    lang={lang}
    items={[
      { label: 'Home', href: '/en' },
      { label: 'Solutions', href: '/en/solutions' },
      { label: data.dept_label_en ?? data.dept_label ?? title },
    ]}
  />
  <SectionsRenderer sections={data.sections!} lang={lang} />
</Base>
