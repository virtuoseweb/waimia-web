---
// Page · /en/ressources · Resources Hub landing — EN mirror
export const prerender = true;

import Base from '../../../layouts/Base.astro';
import Kicker from '../../../components/ui/atoms/Kicker.astro';
import type { SectionByType } from '../../../schemas/sections';
import CtaFinal from '../../../components/sections/CtaFinal.astro';
import HeroCentered from '../../../components/sections/HeroCentered.astro';
import RelatedCards from '../../../components/ui/molecules/RelatedCards.astro';
import Button from '../../../components/ui/atoms/Button.astro';
import EditorialSplitGrid from '../../../components/sections/EditorialSplitGrid.astro';
import { buildCollectionPage } from '../../../lib/seo/schema-builder';

const collectionLd = buildCollectionPage(
  'Waimia Resources',
  'Editorial hub: blog, cookbooks, white papers, AI watch, tools, case studies.',
  ['Blog', 'Cookbooks', 'White Papers', 'AI Watch', 'Tools', 'Case Studies'],
);

const tools = [
  { kicker: 'WHITE PAPER · 01', title_en: 'AI Act Readiness',
    lead_en: 'Compliance dossier · downloadable →',
    href: '/ressources/livres-blancs/ai-act-readiness' },
  { kicker: 'ESSAY · 02', title_en: 'Brain Circuit',
    lead_en: 'How operational AI rewires the company →',
    href: '/ressources/blog/brain-circuit' },
  { kicker: 'WATCH · 03', title_en: 'AI Watch · weekly',
    lead_en: 'Signed Waimia briefs, no noise →',
    href: '/ressources/veille-ia' },
];

const cookbookCards = [
  { kicker: 'COOKBOOK · 01', title_en: 'Claude Skills tutorial',
    lead_en: 'Build a skill from scratch · 30 min →',
    href: '/ressources/cookbooks/claude-skills-tutorial' },
  { kicker: 'COOKBOOK · 02', title_en: 'MCP server deploy',
    lead_en: 'Custom MCP server · prod-ready →',
    href: '/ressources/cookbooks/mcp-server-deploy' },
  { kicker: 'COOKBOOK · 03', title_en: 'Claude Cowork rollout',
    lead_en: '14-day light rollout →',
    href: '/ressources/cookbooks/claude-cowork-rollout' },
];

const caseCards = [
  { num: '01', kicker: 'CASE · B2B SAAS', title: 'Plateau',
    sub: '+€2.4M pipeline recovered',
    lead: 'RevOps rebuild · 10 weeks · Claude + HubSpot + dbt.',
    href: '/cas/plateau' },
  { num: '02', kicker: 'CASE · HEALTH TECH', title: 'Halcyon Health',
    sub: '−38% triage time',
    lead: 'Assisted triage · 6 weeks · Claude + Snowflake.',
    href: '/cas/halcyon' },
  { num: '03', kicker: 'CASE · EU FINTECH', title: 'Northbound',
    sub: '×3.1 SQL conversion',
    lead: 'Lead qualification · 14 weeks · Claude + Segment + dbt.',
    href: '/cas/northbound' },
  { num: '04', kicker: 'CASE · FR INDUSTRY', title: 'Caserne',
    sub: '1,200 h/year recovered',
    lead: 'Documentary RAG · 8 weeks · Claude + RAG + SAP.',
    href: '/cas/caserne' },
  { num: '05', kicker: 'CASE · INTERNAL', title: 'VirtuoseOS',
    sub: 'The OS under every delivery',
    lead: 'Waimia internal blueprint · ongoing · Claude + open-source + multi-agent.',
    href: '/ressources/cas/virtuoseos' },
];

const blogCards = [
  { kicker: 'BLOG · 01', title_en: 'Brain Circuit',
    lead_en: 'Long read · cognitive architecture →',
    href: '/ressources/blog/brain-circuit' },
];

const whitePaperCards = [
  { kicker: 'WHITE PAPER · 01', title_en: 'AI Act Readiness',
    lead_en: 'EU compliance · 47 criteria checklist →',
    href: '/ressources/livres-blancs/ai-act-readiness' },
];

const splitData = {
  type: 'editorial-split-grid' as const,
  left: {
    slot: 'left' as const,
    kicker_fr: '§ Blog · notes longues',
    kicker_en: '§ Blog · long reads',
    h2_fr: 'Une <i>note</i> à la fois.',
    h2_en: 'One <i>note</i> at a time.',
    lede_fr: 'Pas de calendrier éditorial. On publie quand on a vraiment quelque chose à dire.',
    lede_en: 'No editorial calendar. We publish when we genuinely have something to say.',
    cards: blogCards.map((c) => ({ ...c, title_fr: c.title_en, lead_fr: c.lead_en })),
    cta: { label_fr: 'Tous les articles →', label_en: 'All articles →', href: '/ressources/blog', variant: 'ghost' as const },
  },
  right: {
    slot: 'right' as const,
    kicker_fr: '§ Livres blancs · documents PDF',
    kicker_en: '§ White papers · PDF documents',
    h2_fr: 'Un <i>document</i> par sujet.',
    h2_en: 'One <i>document</i> per topic.',
    lede_fr: 'Téléchargeable sans formulaire. Cité par nos clients en comité de direction.',
    lede_en: 'Downloadable without a form. Cited by our clients in board meetings.',
    cards: whitePaperCards.map((c) => ({ ...c, title_fr: c.title_en, lead_fr: c.lead_en })),
    cta: { label_fr: 'Tous les livres blancs →', label_en: 'All white papers →', href: '/ressources/livres-blancs', variant: 'ghost' as const },
  },
} satisfies SectionByType<'editorial-split-grid'>;

const mastheadData = {
  type: 'hero-hub-masthead' as const,
  variant: 'hub' as const,
  decoration: false,
  align: 'left' as const,
  kicker_fr: '§ Hub · Ressources',
  kicker_en: '§ Hub · Resources',
  h1_fr: 'Tout ce qu\'on <i>publie</i>.',
  h1_en: 'Everything we <i>publish</i>.',
  lede_fr: 'Cas mesurables, notes de terrain, cookbooks de méthodes, calculateurs gratuits. Pas de pensum SEO. Tout est relu, signé, et NDA-protected quand pertinent.',
  lede_en: 'Measurable cases, field notes, method cookbooks, free calculators. No SEO padding. Everything is reviewed, signed, and NDA-protected when relevant.',
} satisfies SectionByType<'hero-hub-masthead'>;

const ctaData = {
  type: 'cta-final' as const,
  h2_fr: 'Prêt à livrer un <em>agent</em>,<br />pas un slide deck ?',
  h2_en: 'Ready to ship an <em>agent</em>,<br />not a slide deck?',
  body_fr: 'Audit IA en 5 jours. Premier agent en production en 4 semaines. ROI mesuré, jamais estimé.',
  body_en: 'AI audit in 5 days. First agent in production in 4 weeks. Measured ROI, never estimated.',
  cta_primary: { label_fr: 'Réserver un audit →', label_en: 'Book an audit →', href: '/en/contact', variant: 'primary' as const },
  cta_secondary: { label_fr: 'Voir la pyramide →', label_en: 'See the pyramid →', href: '/en/offres', variant: 'ghost' as const },
  background: 'paper' as const,
} satisfies SectionByType<'cta-final'>;
---
<Base
  title="Resources · Cases, blog, cookbooks, tools · Waimia"
  description="All Waimia resources: NDA-protected client cases, field notes, method cookbooks, TCO/ROI/AI Act calculators."
  jsonLd={collectionLd}
>
  {/* MASTHEAD */}
  <HeroCentered data={mastheadData} lang="en" />

  {/* FEATURED TOOLS */}
  <section class="hub-tools">
    <div class="wrap-wide">
      <Kicker tone="accent" class="hub-tools-k">§ Reads · three free entries, no sign-up</Kicker>
      <h2 class="hub-tools-h2">Three <i>reads</i>. No commercial funnel.</h2>
      <RelatedCards cards={tools.map(t => ({ ...t, title_fr: t.title_en, lead_fr: t.lead_en }))} />
    </div>
  </section>

  {/* CASE STUDIES · 5 cards to real sub-pages */}
  <section class="hub-cases-detail">
    <div class="wrap-wide">
      <Kicker tone="accent" class="hub-cd-k">§ Case studies · 5 signed dossiers</Kicker>
      <h2 class="hub-cd-h2">Five <i>engagements</i>. All measured.</h2>
      <p class="hub-cd-lead">
        No advertising testimonials: every case is read, validated and signed by the client. Four external clients plus our internal blueprint.
      </p>
      <ol class="hub-cd-list reveal-stagger">
        {caseCards.map((c) => (
          <li class="hub-cd-row">
            <a class="hub-cd-link" href={c.href}>
              <span class="hub-cd-num">{c.num}</span>
              <span class="hub-cd-body">
                <span class="hub-cd-kicker">{c.kicker}</span>
                <span class="hub-cd-title">{c.title} <i>· {c.sub}</i></span>
                <span class="hub-cd-text">{c.lead}</span>
              </span>
              <span class="hub-cd-arr" aria-hidden>→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* COOKBOOKS · 3 cards to real sub-pages */}
  <section class="hub-cookbooks">
    <div class="wrap-wide">
      <Kicker tone="accent" class="hub-cookbooks-k">§ Cookbooks · 3 signed recipes</Kicker>
      <h2 class="hub-cookbooks-h2">The <i>recipes</i> we apply in every engagement.</h2>
      <RelatedCards cards={cookbookCards.map(c => ({ ...c, title_fr: c.title_en, lead_fr: c.lead_en }))} />
      <div class="hub-cookbooks-cta">
        <Button href="/ressources/cookbooks" variant="ghost" size="lg">All cookbooks →</Button>
      </div>
    </div>
  </section>

  {/* BLOG + WHITE PAPERS · detailed pages */}
  <EditorialSplitGrid data={splitData} lang="en" />

  {/* NEWSLETTER BAND */}
  <section class="hub-nl">
    <div class="wrap-wide hub-nl-wrap">
      <div>
        <Kicker tone="accent" class="hub-nl-k">§ Newsletter · once a month</Kicker>
        <h2 class="hub-nl-h2">One <i>essay</i> a month. Never a promotion.</h2>
        <p class="hub-nl-lead">
          Long reads, concrete cases, practical recipes. Unsubscribe in 1 click, GDPR-compliant.
        </p>
      </div>
      <form class="hub-nl-form" method="POST" action="/api/newsletter" data-newsletter-form novalidate>
        <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;overflow:hidden">
          <label for="nl-hp">Do not fill</label>
          <input type="text" id="nl-hp" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="lang" value="en" />
        <label for="nl-email" class="sr-only">Professional email</label>
        <input id="nl-email" name="email" type="email" required placeholder="firstname@company.com" autocomplete="email" aria-describedby="nl-hint" />
        <Button as="button" type="submit" variant="primary" size="md">Subscribe →</Button>
        <p class="form-error-global" role="alert" aria-live="assertive" hidden data-newsletter-error></p>
      </form>
      <p class="nl-hint" id="nl-hint">
        No spam · Unsubscribe anytime
        {' · '}
        <a href="/en/legal/privacy">Privacy policy</a>
      </p>
    </div>
  </section>

  <CtaFinal data={ctaData} lang="en" />
</Base>

<style>
  .hub-tools,
  .hub-cookbooks { padding: clamp(80px, 10vw, 120px) var(--space-6); }
  :global(.hub-tools-k),
  :global(.hub-cookbooks-k) { display: block; margin-bottom: 18px; }
  .hub-tools-h2,
  .hub-cookbooks-h2 {
    font-family: var(--font-display);
    font-size: clamp(40px, 6vw, 88px);
    line-height: var(--leading-h1);
    letter-spacing: -0.024em;
    margin: 0 0 clamp(40px, 5vw, 72px);
    text-wrap: balance;
    font-weight: var(--fw-regular);
  }
  .hub-tools-h2 :global(i),
  .hub-cookbooks-h2 :global(i) { font-style: italic; color: var(--accent); }

  .hub-cookbooks { background: var(--paper-2); border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
  .hub-cookbooks-cta { margin-top: clamp(28px, 3vw, 44px); }

  .hub-cases-detail { padding: clamp(80px, 10vw, 120px) var(--space-6); }
  :global(.hub-cd-k) { display: block; margin-bottom: 18px; }
  .hub-cd-h2 {
    font-family: var(--font-display);
    font-size: clamp(40px, 6vw, 88px);
    line-height: var(--leading-h1);
    letter-spacing: -0.024em;
    margin: 0 0 var(--space-5);
    text-wrap: balance;
    font-weight: var(--fw-regular);
  }
  .hub-cd-h2 :global(i) { font-style: italic; color: var(--accent); }
  .hub-cd-lead {
    font-family: var(--font-sans);
    font-size: clamp(17px, 1.8vw, 22px);
    color: var(--muted);
    max-width: 760px;
    margin: 0 0 clamp(40px, 5vw, 64px);
    line-height: 1.45;
  }
  .hub-cd-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--ink);
  }
  .hub-cd-row { border-bottom: 1px solid var(--hairline); }
  .hub-cd-link {
    display: grid;
    grid-template-columns: 80px 1fr 60px;
    gap: clamp(20px, 3vw, 40px);
    padding: clamp(24px, 2.5vw, 36px) 0;
    align-items: start;
    color: inherit;
    transition: background 240ms var(--ease);
  }
  .hub-cd-link:hover { background: rgba(var(--ink-rgb), 0.02); }
  .hub-cd-num {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.5vw, 64px);
    line-height: 0.9;
    color: var(--accent);
    font-style: italic;
  }
  .hub-cd-body { display: flex; flex-direction: column; gap: 6px; }
  .hub-cd-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    color: var(--accent);
    letter-spacing: 0.14em;
  }
  .hub-cd-title {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.6vw, 36px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: var(--fw-regular);
    text-wrap: balance;
  }
  .hub-cd-title :global(i) { font-style: italic; color: var(--muted); font-size: 0.7em; }
  .hub-cd-text {
    font-size: clamp(13px, 1.3vw, 15px);
    line-height: 1.55;
    color: var(--muted);
    max-width: var(--wrap-prose);
    text-wrap: pretty;
  }
  .hub-cd-arr {
    font-family: var(--font-mono);
    font-size: 24px;
    color: var(--accent);
    align-self: center;
    text-align: right;
  }
  @media (max-width: 700px) {
    .hub-cd-link { grid-template-columns: 48px 1fr; }
    .hub-cd-arr { display: none; }
  }

  .hub-nl { padding: clamp(80px, 10vw, 120px) var(--space-6); background: var(--ink); color: var(--paper); }
  .hub-nl-wrap { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(40px, 6vw, 80px); align-items: center; }
  :global(.hub-nl-k) { display: block; margin-bottom: 18px; }
  .hub-nl-h2 {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 72px);
    line-height: 1;
    letter-spacing: -0.024em;
    color: var(--paper);
    margin: 0 0 18px;
    text-wrap: balance;
    font-weight: var(--fw-regular);
  }
  .hub-nl-h2 :global(i) { font-style: italic; color: var(--accent); }
  .hub-nl-lead {
    font-size: var(--text-body-lead);
    line-height: 1.55;
    color: rgba(var(--paper-rgb), 0.7);
    max-width: 520px;
    margin: 0;
  }
  .hub-nl-form {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .hub-nl-form input {
    flex: 1;
    min-width: 240px;
    padding: 14px 18px;
    background: rgba(var(--paper-rgb), 0.08);
    border: 1px solid rgba(var(--paper-rgb), 0.2);
    border-radius: var(--radius-sm);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: 16px;
  }
  .hub-nl-form input:focus { outline: none; border-color: var(--accent); }
  .nl-hint {
    font-size: var(--text-ui);
    color: rgba(var(--paper-rgb), 0.5);
    margin: 10px 0 0;
    line-height: var(--leading-body);
  }
  .nl-hint a { color: rgba(var(--paper-rgb), 0.7); text-decoration: underline; }
  .nl-hint a:hover { color: var(--paper); }
  .hub-nl-form .form-error-global {
    flex-basis: 100%;
    color: var(--accent);
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    margin: 0;
  }

  @media (max-width: 800px) {
    .hub-nl-wrap { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
(function () {
  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function bindForm(form) {
    if (form.dataset.nlBound) return;
    form.dataset.nlBound = '1';

    var langInput = form.querySelector('input[name="lang"]');
    var lang = langInput ? langInput.value : 'en';
    var emailInput = form.querySelector('input[name="email"]');
    var errorEl = form.querySelector('[data-newsletter-error]');
    var btn = form.querySelector('button[type="submit"]');

    function showError(msg) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.removeAttribute('hidden');
    }
    function clearError() {
      if (!errorEl) return;
      errorEl.setAttribute('hidden', '');
      errorEl.textContent = '';
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      clearError();

      var email = emailInput ? emailInput.value.trim() : '';
      if (!email || !EMAIL_RE.test(email)) {
        showError(lang === 'fr' ? 'Adresse email invalide.' : 'Invalid email address.');
        if (emailInput) emailInput.focus();
        return;
      }

      if (btn) btn.disabled = true;

      var payload = Object.fromEntries(new FormData(form).entries());

      try {
        var res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        var data = await res.json();
        if (data.ok) {
          document.cookie = 'waimia_newsletter_signed=true; path=/; max-age=31536000; SameSite=Lax';
          if (data.redirect) {
            window.location.href = data.redirect;
          }
        } else {
          showError(data.error || (lang === 'fr' ? 'Erreur, veuillez réessayer.' : 'Error, please try again.'));
          if (btn) btn.disabled = false;
        }
      } catch (_) {
        showError(lang === 'fr' ? 'Erreur réseau, veuillez réessayer.' : 'Network error, please try again.');
        if (btn) btn.disabled = false;
      }
    });
  }

  document.querySelectorAll('form[data-newsletter-form]').forEach(bindForm);
  document.addEventListener('astro:page-load', function () {
    document.querySelectorAll('form[data-newsletter-form]').forEach(function (form) {
      delete form.dataset.nlBound;
      bindForm(form);
    });
  });
})();
</script>
