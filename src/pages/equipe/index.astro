---
export const prerender = true;

/**
 * Hub /equipe — liste des auteurs Waimia (status: active + featured first).
 *
 * Auto-jointure : pour chaque auteur, compte les articles publiés (blog, qui
 * porte aussi veille IA + field notes, + cookbooks + livresBlancs) pour la card.
 */
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { langFromPath } from '../../lib/i18n';
import type { SectionByType } from '../../schemas/sections';
import CtaFinal from '../../components/sections/CtaFinal.astro';
import TeamCardGrid from '../../components/sections/TeamCardGrid.astro';
import HeroCentered from '../../components/sections/HeroCentered.astro';

type AuthorLinkedEntry =
  | CollectionEntry<'blog'>
  | CollectionEntry<'cookbooks'>
  | CollectionEntry<'livresBlancs'>;

type AuthorRef = string | { id?: string; slug?: string; name?: string };

const lang = langFromPath(Astro.url.pathname);
const transitionIdFromHref = (href: string) =>
  href
    .replace(/^\/(?:en\/)?/, '')
    .replace(/\/$/, '')
    .replace(/[^a-z0-9]+/gi, '-')
    .replace(/^-|-$/g, '') || 'home';

const allAuthors = await getCollection('authors');

// Filtre status=active, featured=true en premier, puis ordre alphabétique
const activeAuthors = allAuthors
  .filter((author) => author.data.status === 'active')
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return a.data.title_fr.localeCompare(b.data.title_fr);
  });

// Compte articles par auteur (auto-jointure)
// SEO état final : cookbooks + livres-blancs supprimés ; auteurs reliés au blog in-silo.
const [allBlog] = await Promise.all([
  getCollection('blog'),
]);

const allItems: AuthorLinkedEntry[] = [
  ...allBlog,
];

const getAuthor = (contentEntry: AuthorLinkedEntry): AuthorRef | undefined => {
  if (!('author' in contentEntry.data)) return undefined;
  return contentEntry.data.author as AuthorRef | undefined;
};

const countByAuthor = (slug: string, name: string) =>
  allItems.filter((contentEntry) => {
    const author = getAuthor(contentEntry);
    if (!author) return false;
    if (typeof author === 'object' && author.id === slug) return true;
    if (typeof author === 'object' && author.slug === slug) return true;
    if (typeof author === 'object' && author.name === name) return true;
    if (typeof author === 'string' && author === slug) return true;
    return false;
  }).length;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://waimia.com/' },
    { '@type': 'ListItem', position: 2, name: "L'équipe" },
  ],
};

const collectionPageLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: "L'équipe Waimia",
  description: 'Les auteurs Waimia : fondateurs, contributeurs, invités. Bios, CV, publications.',
};

const gridData = {
  type: 'team-card-grid' as const,
  cta_label_fr: 'Voir le profil →',
  cta_label_en: 'View profile →',
  count_singular_fr: 'publication',
  count_singular_en: 'publication',
  count_plural_fr: 'publications',
  count_plural_en: 'publications',
  members: activeAuthors.map((author) => {
    const href = lang === 'fr' ? `/equipe/${author.id}` : `/en/equipe/${author.id}`;
    return {
      name: author.data.title_fr,
      role_fr: author.data.role_fr,
      role_en: author.data.role_en ?? author.data.role_fr,
      description_fr: author.data.description_fr,
      description_en: author.data.description_en ?? author.data.description_fr,
      href,
      photo: author.data.photo,
      photo_alt_fr: author.data.photoAlt_fr ?? author.data.title_fr,
      photo_alt_en: author.data.photoAlt_en ?? author.data.photoAlt_fr ?? author.data.title_fr,
      count: countByAuthor(author.id, author.data.title_fr),
      transition_id: transitionIdFromHref(href),
    };
  }),
} satisfies SectionByType<'team-card-grid'>;

const mastheadData = {
  type: 'hero-hub-masthead' as const,
  variant: 'hub' as const,
  decoration: false,
  align: 'left' as const,
  kicker_fr: `§ Hub · Équipe · ${activeAuthors.length} ${activeAuthors.length > 1 ? 'auteurs' : 'auteur'}`,
  kicker_en: `§ Hub · Team · ${activeAuthors.length} ${activeAuthors.length > 1 ? 'authors': 'author'}`,
  h1_fr: 'Qui <i>écrit</i>. Qui <i>câble</i>.',
  h1_en: 'Who <i>writes</i>. Who <i>ships</i>.',
  lede_fr: "Pas de ghostwriting. Pas d'agence anonyme. Chaque article, chaque cas, chaque livre blanc est signé. Voici qui écrit pour Waimia.",
  lede_en: "No ghostwriting. No anonymous agency. Every article, case, white paper is signed. Here's who writes for Waimia.",
  transition_id: transitionIdFromHref(Astro.url.pathname),
} satisfies SectionByType<'hero-hub-masthead'>;

const ctaData = {
  type: 'cta-final' as const,
  h2_fr: 'Prêt à livrer un <em>agent</em>,<br />pas un slide deck ?',
  h2_en: 'Ready to ship an <em>agent</em>,<br />not a slide deck?',
  body_fr: 'Audit IA en 5 jours. Premier agent en production en 4 semaines. ROI mesuré, jamais estimé.',
  body_en: 'AI audit in 5 days. First agent in production in 4 weeks. Measured ROI, never estimated.',
  cta_primary: { label_fr: 'Réserver un audit →', label_en: 'Book an audit →', href: '/contact', variant: 'primary' as const },
  cta_secondary: { label_fr: 'Voir la pyramide →', label_en: 'See the pyramid →', href: '/offres', variant: 'ghost' as const },
  background: 'paper' as const,
} satisfies SectionByType<'cta-final'>;
---

<Base
  title="L'équipe Waimia · auteurs et contributeurs"
  description="Les auteurs et contributeurs Waimia. Bios, CV, expertise, publications. Studio solo à Montpellier."
  jsonLd={[breadcrumbLd, collectionPageLd]}
>
  {/* MASTHEAD */}
  <HeroCentered data={mastheadData} lang="fr" />

  {/* GRID auteurs */}
  <TeamCardGrid data={gridData} lang="fr" />
  <CtaFinal data={ctaData} lang="fr" />
</Base>

<style>
  .wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 var(--space-8);
  }
</style>
