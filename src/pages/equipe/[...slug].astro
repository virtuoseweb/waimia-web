---
/**
 * Template loader · /equipe/[...slug] · CMS git-based phase auteurs
 *
 * SSG mode : getStaticPaths() injecte l'entry auteur en props.
 * Auto-jointure : récupère tous les contenus de cet auteur depuis blog,
 * cookbooks, livresBlancs (veille IA + field notes = blog.type). Filtre + tri par publishedAt desc.
 */
export const prerender = true;

import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import AuthorPageTemplate from '../../components/templates/AuthorPageTemplate.astro';

export async function getStaticPaths() {
  const entries = await getCollection('authors');
  return entries
    .filter((entry) => !entry.data.seo?.noindex)
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

type AuthorLinkedEntry =
  | CollectionEntry<'blog'>
  | CollectionEntry<'cookbooks'>
  | CollectionEntry<'livresBlancs'>;

type AuthorRef = string | { id?: string; slug?: string; name?: string };
type Props = { entry: CollectionEntry<'authors'> };

const { entry } = Astro.props as Props;
const slug = entry.id;

const { Content } = await render(entry);

// Auto-jointure : tous les contenus de cet auteur, triés par date desc.
// SEO état final : cookbooks + livres-blancs supprimés ; il reste le blog in-silo.
const [allBlog] = await Promise.all([
  getCollection('blog'),
]);

// Filtre par auteur — la ref `author: reference('authors')` n'est pas encore appliquée
// dans toutes les collections (B4 le fera). Pour l'instant, on tente plusieurs patterns
// pour rester robuste : entry.data.author?.id (ref) ou entry.data.author?.slug ou
// entry.data.author?.name === entry.data.title_fr (legacy string author).
const getAuthor = (contentEntry: AuthorLinkedEntry): AuthorRef | undefined => {
  if (!('author' in contentEntry.data)) return undefined;
  return contentEntry.data.author as AuthorRef | undefined;
};

const matchAuthor = (contentEntry: AuthorLinkedEntry) => {
  const author = getAuthor(contentEntry);
  if (!author) return false;
  // Pattern reference (post-B4)
  if (typeof author === 'object' && author.id === slug) return true;
  if (typeof author === 'object' && author.slug === slug) return true;
  // Pattern legacy { name, url }
  if (typeof author === 'object' && author.name === entry.data.title_fr) return true;
  // Pattern string slug direct
  if (typeof author === 'string' && author === slug) return true;
  return false;
};

const sortByDate = <T extends { data: { publishedAt: Date } }>(items: T[]) =>
  [...items].sort(
    (a, b) =>
      new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime(),
  );

const blogByAuthor = sortByDate(allBlog.filter(matchAuthor));
// Les types legacy-routés (field-note / veille-ia) ont leurs propres groupes
// (hrefBase dédié dans AuthorPageTemplate) — exclus des groupes blog classiques.
const isLegacy = (contentEntry: CollectionEntry<'blog'>) =>
  contentEntry.data.type === 'field-note' || contentEntry.data.type === 'veille-ia';
const essays = blogByAuthor.filter(
  (contentEntry) => contentEntry.data.editorialType === 'Essay' && !isLegacy(contentEntry),
);
const shortPosts = blogByAuthor.filter(
  (contentEntry) => contentEntry.data.editorialType === 'Field Note' && !isLegacy(contentEntry),
);
const fieldNotes = blogByAuthor.filter((contentEntry) => contentEntry.data.type === 'field-note');
const veilleIA = blogByAuthor.filter((contentEntry) => contentEntry.data.type === 'veille-ia');
const cookbooks: AuthorLinkedEntry[] = [];
const livresBlancs: AuthorLinkedEntry[] = [];
---

<AuthorPageTemplate
  author={entry.data}
  essays={essays}
  shortPosts={shortPosts}
  cookbooks={cookbooks}
  livresBlancs={livresBlancs}
  veilleIA={veilleIA}
  fieldNotes={fieldNotes}
>
  <Content />
</AuthorPageTemplate>
