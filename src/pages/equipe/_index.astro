---
export const prerender = true;

/**
 * Hub /equipe — liste des auteurs Waimia (status: active + featured first).
 *
 * Auto-jointure : pour chaque auteur, compte les articles publiés (blog, qui
 * porte aussi veille IA + field notes, + cookbooks + livresBlancs) pour la card.
 */
import { getCollection } from 'astro:content';
import { getLiveCollection } from '../../lib/live-collection';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { langFromPath } from '../../lib/i18n';
import type { SectionByType, SectionData } from '@waimia/ds-kernel';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import { SITE } from '../../site.config';

// SEO état final : collections cookbooks + livresBlancs supprimées ; auteurs reliés au blog in-silo.
type AuthorLinkedEntry = CollectionEntry<'blog'>;

type AuthorRef = string | { id?: string; slug?: string; name?: string };

const lang = langFromPath(Astro.url.pathname);
const transitionIdFromHref = (href: string) =>
  href
    .replace(/^\/(?:en\/)?/, '')
    .replace(/\/$/, '')
    .replace(/[^a-z0-9]+/gi, '-')
    .replace(/^-|-$/g, '') || 'home';

const allAuthors = await getCollection('authors');

// Filtre status=active, featured=true en premier, puis ordre alphabétique
const activeAuthors = allAuthors
  .filter((author) => author.data.status === 'active')
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return a.data.title_fr.localeCompare(b.data.title_fr);
  });

// Compte articles par auteur (auto-jointure)
// SEO état final : cookbooks + livres-blancs supprimés ; auteurs reliés au blog in-silo.
const [allBlog] = await Promise.all([
  getLiveCollection('blog'),
]);

const allItems: AuthorLinkedEntry[] = [
  ...allBlog,
];

const getAuthor = (contentEntry: AuthorLinkedEntry): AuthorRef | undefined => {
  if (!('author' in contentEntry.data)) return undefined;
  return contentEntry.data.author as AuthorRef | undefined;
};

const countByAuthor = (slug: string, name: string) =>
  allItems.filter((contentEntry) => {
    const author = getAuthor(contentEntry);
    if (!author) return false;
    if (typeof author === 'object' && author.id === slug) return true;
    if (typeof author === 'object' && author.slug === slug) return true;
    if (typeof author === 'object' && author.name === name) return true;
    if (typeof author === 'string' && author === slug) return true;
    return false;
  }).length;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Le studio', item: `${SITE.url}/agence` },
    { '@type': 'ListItem', position: 3, name: "L'équipe" },
  ],
};

const collectionPageLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: "L'équipe Waimia",
  description: "Waimia est un studio solo : Simon Beros audite, construit et signe chaque mission et chaque publication. Parcours et publications.",
  about: {
    '@type': 'Person',
    name: 'Simon Beros',
    url: `${SITE.url}/equipe/simon-beros`,
  },
};

const gridData = {
  type: 'team-card-grid' as const,
  cta_label_fr: 'Voir le profil →',
  cta_label_en: 'View profile →',
  count_singular_fr: 'publication',
  count_singular_en: 'publication',
  count_plural_fr: 'publications',
  count_plural_en: 'publications',
  members: activeAuthors.map((author) => {
    const href = lang === 'fr' ? `/equipe/${author.id}` : `/en/equipe/${author.id}`;
    return {
      name: author.data.title_fr,
      role_fr: author.data.role_fr,
      role_en: author.data.role_en ?? author.data.role_fr,
      description_fr: author.data.description_fr,
      description_en: author.data.description_en ?? author.data.description_fr,
      href,
      photo: author.data.photo,
      photo_alt_fr: author.data.photoAlt_fr ?? author.data.title_fr,
      photo_alt_en: author.data.photoAlt_en ?? author.data.photoAlt_fr ?? author.data.title_fr,
      count: countByAuthor(author.id, author.data.title_fr),
      transition_id: transitionIdFromHref(href),
    };
  }),
} satisfies SectionByType<'team-card-grid'>;

const mastheadData = {
  type: 'hero-hub-masthead' as const,
  variant: 'hub' as const,
  decoration: false,
  align: 'left' as const,
  kicker_fr: '§ Le studio · Équipe',
  kicker_en: '§ The studio · Team',
  h1_fr: 'Un studio, un ingénieur.',
  h1_en: 'One studio, one engineer.',
  lede_fr: "Waimia est un studio de développement IA tenu par une seule personne. Celui qui audite vos processus est celui qui construit, mesure et vous remet le code. Il signe aussi ce qui est publié ici.",
  lede_en: 'Waimia is an AI development studio run by one person. The one who audits your processes is the one who builds, measures and hands you the code. He also signs what is published here.',
  transition_id: transitionIdFromHref(Astro.url.pathname),
} satisfies SectionByType<'hero-hub-masthead'>;

const ctaData = {
  type: 'cta-final' as const,
  h2_fr: 'Quarante-cinq minutes<br />avec celui qui fait le <em>travail</em>.',
  h2_en: 'Forty-five minutes<br />with the one who does the <em>work</em>.',
  body_fr: 'Un audit gratuit, en visio. On passe vos processus en revue et on repère trois automatisations rentables. Sans engagement.',
  body_en: 'A free audit, on a call. We review your processes and spot three profitable automations. No commitment.',
  cta_primary: { label_fr: 'Réserver un audit →', label_en: 'Book an audit →', href: '/contact#offer=audit-ia-pme&intent=audit', variant: 'primary' as const },
  cta_secondary: { label_fr: 'Voir la méthode →', label_en: 'See the method →', href: '/agence/methode', variant: 'ghost' as const },
  background: 'paper' as const,
} satisfies SectionByType<'cta-final'>;

const teamBodyData = {
  type: 'rich-text' as const,
  kicker_fr: '§ Studio',
  kicker_en: '§ Studio',
  title_fr: 'Un studio solo, assumé',
  title_en: 'A solo studio, by choice',
  body_md_fr: `Waimia est le studio de **Simon Beros**, basé à Bordeaux : un studio de
développement IA et un cabinet d'automatisation des processus pour PME et ETI.
Pas de chargé de compte, pas d'agence relais, pas de sous-traitance.

Simon mène lui-même chaque mission, dans le même ordre : audit des processus,
pilote en production branché sur les outils déjà en place, mesure avant et
après, transfert du code et des workflows. L'objectif n'est pas la
démonstration, c'est un système qui tourne une fois l'intervention finie.

### Le parcours

Avant Waimia, Simon a fondé **VirtuoseWeb**, où il concevait des sites et des
systèmes web pour des PME. Waimia (2024) concentre ce savoir-faire de
développeur sur un autre métier : l'automatisation des processus, les agents IA
et les applications métier. Le site web y est devenu un outil parmi d'autres.

### Ce qu'il maîtrise

- automatisation des processus avec n8n et Make ;
- agents IA sur Claude et OpenAI, branchés par API et MCP ;
- développement d'applications métier ;
- audit, feuille de route et formation des équipes ;
- cadrage RGPD et AI Act dès la conception.

Il écrit en français, lit la documentation, livre du code et mesure le résultat.
Le détail de son profil, ses publications et son CV complet vivent sur sa
[fiche auteur](/equipe/simon-beros).`,
  body_md_en: `Waimia is the solo studio of **Simon Beros**, based in Bordeaux. One signature
behind every article, case and guide published: no ghostwriting, no rotating
account manager, no relay agency.

Simon wires every engagement himself, from the first audit to a documented
handover: process audit, agents plugged into the tools already in place,
before/after measurement, skills transfer. The goal is not the demo, it is a
business system that keeps running once the engagement ends.

### The background

Before Waimia, Simon founded **VirtuoseWeb**, where he designed and wired web and
AI systems for B2B SMBs. Waimia (2024) extends that work to applied generative
AI: turning a model into an acquisition, CRM and operational-productivity
machine, for SMBs and lower-mid-market.

### What he masters

- AI systems for B2B SMBs;
- RevOps and automated acquisition;
- real-time data steering;
- Anthropic / Claude stack;
- process intelligence.

He writes in French, reads the docs, ships code and measures the pipeline. His
full profile, publications and CV live on his
[author page](/equipe/simon-beros).`,
} satisfies SectionByType<'rich-text'>;

const sections: SectionData[] = [mastheadData, gridData, teamBodyData, ctaData];
---

<Base
  title="L'équipe Waimia · un studio, un ingénieur"
  description="Waimia est un studio solo basé à Bordeaux : Simon Beros audite, construit et transfère chaque mission lui-même. Parcours et publications."
  jsonLd={[breadcrumbLd, collectionPageLd]}
>
  <SectionsRenderer sections={sections} lang="fr" />
</Base>

<style>
  .wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 var(--space-8);
  }
</style>
