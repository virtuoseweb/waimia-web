---
export const prerender = true;

/**
 * Homepage LIVE · refonte positionnement 2026-10.
 *
 * La home dit en moins de 5 secondes que Waimia est un studio de développement IA et un
 * cabinet d'automatisation des processus pour PME et ETI (plus une agence web ni marketing).
 * L'offre est présentée dans son ordre : (1) automatisation et agents IA, (2) applications
 * métier, (3) conseil et formation, puis en retrait (4) outils commerciaux, (5) visibilité web.
 *
 * Séquence (8 slots) · alternance paper/ink :
 *   01 Hero (organism home, paper) · H1 métier + l'offre en trois lignes
 *   02 L'offre (#offres) · offer-rail CATALOGUE (paper) · un onglet par domaine, dans l'ordre
 *   03 Méthode · sticky-scroll-storytelling CATALOGUE (ink) · audit, pilote, mesure, transfert
 *   04 Réalisations · case-card-grid CATALOGUE (paper) · cas réels, chiffres des études de cas
 *   05 Où en êtes-vous · diagnostic-stages CATALOGUE + bande quiz (paper-2)
 *   06 Qui · eeat-panel variant media (ink) · le fondateur, seul, assumé
 *   07 FAQ · 6 questions (paper)
 *   08 Action · BookSession (ink) + FooterMarquee
 * (BootSplash en tête + ScrollProgress en pied = expérience de marque, hors séquence.)
 *
 * Retirées (aucune information utile à la décision) : mur de logos, « la boucle »
 * (statement-orbit), « la tension » (3 cartes de douleurs), bento de chiffres pré-FAQ.
 * Toutes les sections passent par SectionsRenderer ou un organism : 0 markup inline.
 */
import Base from '../layouts/Base.astro';
import BootSplash from '../components/motion/BootSplash.astro';
import ScrollProgress from '../components/ui/atoms/ScrollProgress.astro';
import Hero from '../components/ui/organisms/Hero.astro';
import SectionsRenderer from '../components/sections/SectionsRenderer.astro';
import FaqAccordion from '../components/sections/FaqAccordion.astro';
import BookSession from '../components/ui/organisms/BookSession.astro';
import FooterMarquee from '../components/ui/organisms/FooterMarquee.astro';
import homeVariantC from '../data/page-variants/home/c.json';
import type { SectionData } from '@waimia/ds-kernel';
import { offerRail, maturityStages, mediaDashboard, methodOverrides, faqConfig } from '../data/home-sections';

const sectionsC = homeVariantC.sections as any[];
const cByType = (t: string) => sectionsC.find((s) => s.type === t);

// 03 · Méthode · base c.json (4 étapes : audit, pilote, mesure, transfert) + surcharges de
// mise en page. Les illustrations basculent sur leur variante `-ink.webp` (fond sombre).
const methodBase = cByType('sticky-scroll-storytelling');
const methodStory = {
  ...methodBase,
  steps: (methodBase.steps as any[]).map((st) => ({
    ...st,
    media_src: typeof st.media_src === 'string' ? st.media_src.replace('-paper.webp', '-ink.webp') : st.media_src,
  })),
  ...methodOverrides,
} as SectionData;

// 04 · Réalisations · base c.json case-card-grid (cas réels, source unique), fond paper.
const casesHome = { ...cByType('case-card-grid'), background: 'paper' } as SectionData;

// 07 · FAQ · questions ET réponses de c.json (source unique), sélection par `faqConfig.idx`.
const faqAll = cByType('faq-accordion').items as any[];
const faqItems = faqConfig.idx.map((i) => ({ q: faqAll[i].q_fr, a: faqAll[i].a_fr }));
---
<Base
  title="Studio IA et cabinet d'automatisation PME · Waimia"
  description="Studio de développement IA et cabinet d'automatisation des processus pour PME et ETI : automatisations, agents IA, applications métier. Audit gratuit de 45 min."
>
  {/* Splash · respiration 1.1s · CSS-only (zéro JS bundle) */}
  <BootSplash lang="fr" />

  {/* 01 · Hero · le métier en une phrase + l'offre en trois lignes */}
  <Hero />

  {/* 02 · L'offre · offer-rail CATALOGUE · `anchor: 'offres'` (dans la donnée) = cible #offres */}
  <SectionsRenderer sections={[offerRail]} lang="fr" />

  {/* 03 · Méthode · audit, pilote, mesure, transfert (ink) */}
  <SectionsRenderer sections={[methodStory]} lang="fr" />

  {/* 04 · Réalisations · cas réels (paper) */}
  <SectionsRenderer sections={[casesHome]} lang="fr" />

  {/* 05 · Où en êtes-vous · 5 stades + bande diagnostic (paper-2) */}
  <SectionsRenderer sections={[maturityStages]} lang="fr" />

  {/* 06 · Qui · le fondateur (ink) */}
  <SectionsRenderer sections={[mediaDashboard]} lang="fr" />

  {/* 07 · FAQ · Q.01 prix ouverte */}
  <FaqAccordion
    items={faqItems}
    heading={faqConfig.heading}
    intro={faqConfig.intro}
    background="paper"
    openFirst
  />

  {/* 08 · Action · BookSession (ink) + FooterMarquee */}
  <BookSession />
  <FooterMarquee />

  <ScrollProgress />
</Base>
