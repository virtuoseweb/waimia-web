---
export const prerender = true;

/**
 * Homepage LIVE · variante E promue (gate C 2026-07-13).
 *
 * Genealogie : issue de la maquette design-lab home-e (gate B, iterations 1 -> 6).
 * Le contenu de l'ex-src/pages/lab/home-e.astro (validee gate B iter 6) devient la
 * home live et remplace l'ancienne recomposition V-F3. La maquette lab/home-e.astro
 * a ete supprimee 2026-07-19 (dette morte, orpheline, fiche 0027 D6) une fois sa
 * genealogie absorbee ici ; cette page-ci est INDEXEE (indexation par defaut, prop
 * robots supprimee) et porte le title/description live du positionnement V8.
 *
 * Objectif E = la home LIVE raccourcie, hierarchisee, dedoublonnee, clarifiee, en
 * gardant la richesse visuelle du live (SVG line-art dessine au scroll, animations,
 * tabs familles). Corrige la variante D : ici 0 valeur en dur.
 *
 * Sequence (13 slots) · alternance paper/ink stricte, jamais 2 ink pleins adjacents.
 * Fil narratif des kickers « § » : constat -> offres -> boucle -> ou en etes-vous -> tension ->
 * preuves -> methode -> confiance -> resultats -> questions -> action :
 *   01 Hero (live, paper, composant INTOUCHE)
 *   02 Ecosysteme opere · logo-marquee (SectionsRenderer, ink + grayscale) · bande courte
 *   03 Les deux offres (#offres) · MONEY SLOT · tabs familles + diptyque + rangee 6 services + dorsale SVG (paper)
 *   04 La boucle · statement-orbit CATALOGUE (SectionsRenderer, carte ink dans paper) · PIVOT conceptuel
 *   05 Ou en etes-vous · diagnostic-stages CATALOGUE + bande CTA quiz (SectionsRenderer, paper ; carte quiz ink)
 *   06 La tension · 3 douleurs sobres (direct, INK · cartes surface-ink)
 *   07 Cas clients · 3 cartes compactes + 1 lien « tous les cas » (direct, paper)
 *   08 Methode · sticky-scroll-storytelling CATALOGUE (SectionsRenderer, INK) · media sticky crossfade
 *   09 Temoignages · testimonial-wall CATALOGUE (SectionsRenderer, paper) · 6 avis de SWI
 *   10 Tableau de bord media · eeat-panel variant media (SectionsRenderer, ink)
 *   11 Climax chiffre · 2e stats-bento de C (SectionsRenderer, paper-2) · pre-FAQ
 *   12 FAQ · 6 questions reformulees en requetes conversationnelles AIO, prix garde (FaqAccordion, paper)
 *   13 Action · BookSession (ink) + FooterMarquee
 * (BootSplash en tete + ScrollProgress en pied = experience de marque live, hors sequence.)
 *
 * Token-first : hairlines = box-shadow --shadow-card-rest + global .hline + barre de tabs
 * en 1px var(--hairline)/2px var(--accent-text), idiome DS canonique et exception hairline
 * rule 60 ; pas d'AUTRE literal px hors @media / viewBox SVG. Exception locale 2026-07-16 :
 * --home-complement (#2090A8) sert uniquement a distinguer la branche Automation & IA du
 * money slot, sans creer de token DS global.
 */
import Base from '../layouts/Base.astro';
import BootSplash from '../components/motion/BootSplash.astro';
import ScrollProgress from '../components/ui/atoms/ScrollProgress.astro';
import Hero from '../components/ui/organisms/Hero.astro';
import SectionsRenderer from '../components/sections/SectionsRenderer.astro';
import FaqAccordion from '../components/sections/FaqAccordion.astro';
import BookSession from '../components/ui/organisms/BookSession.astro';
import FooterMarquee from '../components/ui/organisms/FooterMarquee.astro';
import homeVariantC from '../data/page-variants/home/c.json';
import swiContent from '../content/services/site-web-ia.json';
import { SIX_SERVICES } from '../data/sitemap';
import type { SectionData } from '@waimia/ds-kernel';
// Séquence médiane en donnée (JSONification V1) : littéraux de section extraits du
// frontmatter → src/data/home-sections.ts. La page garde le merge avec les bases
// cataloguées (c.json / swi) ; le shell animé + 3 blocs bespoke restent en page.
import {
  statementOrbit,
  maturityStages,
  mediaDashboard,
  logoMarqueeOverrides,
  methodOverrides,
  testimonialsOverrides,
  statsBentoOverrides,
  severityLabels,
  faqConfig,
} from '../data/home-sections';

const sectionsC = homeVariantC.sections as any[];
const cByType = (t: string) => sectionsC.find((s) => s.type === t);
const swiTestimonials = (swiContent.sections as any[]).find((s) => s.type === 'testimonial-wall');

// 02 · ecosysteme opere · logo-marquee sur fond ink + grayscale (base c.json + surcharges data).
const logoMarquee = { ...cByType('logo-marquee'), ...logoMarqueeOverrides } as SectionData;

// 11 · climax chiffre = 2e stats-bento de C (base c.json[1]) + surcharges data (paper-2, density
// base, kicker). La 4e cellule autonomie est DEJA dans la base c.json → le spread la rend telle quelle.
const statsBentoDashboard = { ...sectionsC.filter((s) => s.type === 'stats-bento')[1], ...statsBentoOverrides } as SectionData;

// 05 · La tension · 3 douleurs les plus critiques (pain-severity-list de C, contenu reel).
const painItems = (cByType('pain-severity-list').items as any[]).map((it) => ({
  severity: it.severity as string,
  title: it.title_fr as string,
  desc: it.desc_fr as string,
  fix: it.fix_fr as string,
}));

// 06 · Cas clients · 3 cartes compactes (case-card-grid de C, contenu reel).
const caseItems = (cByType('case-card-grid').cases as any[]).map((c) => ({
  client: c.client as string,
  meta: `${c.sector_fr} · ${c.duration}`,
  impact: c.impact_fr as string,
  href: c.href as string,
}));

// 07 · Methode · sticky-scroll-storytelling CATALOGUE · contenu c.json TEL QUEL (4 steps home,
// media_src illustrations, media sticky crossfade au scroll). Layout DIFFERENCIE de SWI via les
// SEULS axes existants du schema. Layout V1 CHOISI (verdict Simon 2026-07-12, gate B iter 3 :
// « je garde la mise en page actuelle pour méthode ») ; V2/V3/V4 restent au catalogue (lab/home-e-method).
const methodBase = cByType('sticky-scroll-storytelling');
const methodStory = {
  ...methodBase,
  // Les 4 illustrations basculent sur leur variante `-ink.webp` (theme sombre catalogue DS) ;
  // l'idiome data-bg='ink' remappe deja h2/titres/corps en paper. Surcharges data = methodOverrides.
  steps: (methodBase.steps as any[]).map((st) => ({
    ...st,
    media_src: typeof st.media_src === 'string' ? st.media_src.replace('-paper.webp', '-ink.webp') : st.media_src,
  })),
  ...methodOverrides,
} as SectionData;

// 05 · Ou en etes-vous · diagnostic-stages CATALOGUE + bande CTA quiz → donnee `maturityStages`
// (src/data/home-sections.ts). Objet litteral pur, importe tel quel.

// 09 · Temoignages · testimonial-wall CATALOGUE · base = les 6 avis de SWI (source unique) +
// surcharges en-tete data (`testimonialsOverrides`).
const testimonialsHome = { ...swiTestimonials, ...testimonialsOverrides } as SectionData;

// 12 · FAQ · 6 questions reformulees AIO (data `faqConfig.questions`) ; les REPONSES restent celles
// de c.json (0 desync), mappees par `faqConfig.idx`.
const faqAll = (cByType('faq-accordion').items as any[]);
const faqItems = faqConfig.idx.map((i, k) => ({ q: faqConfig.questions[k], a: faqAll[i].a_fr }));

// 03 · 6 services (label + mini-lead + lien) · ABSORPTION de ServicesGrid · source SIX_SERVICES.
const services = SIX_SERVICES.map((s) => ({
  metric: s.metric.fr,
  label: s.label.fr,
  sub: s.connectors.fr,
  href: s.href,
}));

// 04 · statement-orbit CATALOGUE · PIVOT apres le money slot → donnee `statementOrbit`
// (src/data/home-sections.ts). Objet litteral pur, importe tel quel.
// 10 · eeat-panel variant media (INK), « TABLEAU DE BORD MÉDIA » → donnee `mediaDashboard`
// (contenu + liens internes GLOBAUX portes par le composant, source unique).
---
<Base
  title="Studio IA & intégration IA pour PME à Montpellier · Waimia"
  description="Studio IA pour PME : conseil, intégration et mise en production de l'IA (site web intelligent, acquisition, CRM, pilotage). Diagnostic gratuit dès 2 000 € HT."
>
  {/* Splash · respiration cinematique 1.1s · CSS-only (zero JS bundle) */}
  <BootSplash lang="fr" />

  {/* 01 · Hero live · promesse + mini-map 6 territoires + CTAs · INTOUCHE (reference qualite) */}
  <Hero />

  {/* 02 · Ecosysteme opere · logo-marquee ink + grayscale · bande courte */}
  <SectionsRenderer sections={[logoMarquee]} lang="fr" />

  {/* 03 · Les deux offres · MONEY SLOT · diptyque + dorsale SVG + rangee 6 services */}
  <section class="he-sec he-offres" id="offres" aria-labelledby="he-offres-h2">
    <div class="wrap-wide">
      <header class="he-head reveal">
        <p class="he-kicker">§ Agence d’ingénierie IA &amp; applications pour PME</p>
        <h2 id="he-offres-h2" class="he-h2 he-h2--xl u-serif-accent">On <i>conçoit le système</i>, pas juste l’outil.</h2>
        <p class="he-lede">Un système métier IA n’est pas une automatisation isolée, c’est un ensemble cohérent d’applications, de données, de workflows et d’agents conçu autour de vos opérations.</p>
      </header>

      {/* Niveau FAMILLES · tabs (etage V8) · 2 familles LIVE : « Systeme marketing » (actif par defaut) + « Systeme commercial » */}
      <div class="he-tabs" data-he-tabs>
        <div class="he-tabs__list" role="tablist" aria-label="Familles de systèmes">
          <button
            class="he-tab is-active"
            role="tab"
            id="he-tab-marketing"
            aria-controls="he-panel-marketing"
            aria-selected="true"
            tabindex="0"
            type="button"
          >
            <span class="he-tab__label">Système d’acquisition</span>
          </button>
          <button
            class="he-tab"
            role="tab"
            id="he-tab-commercial"
            aria-controls="he-panel-commercial"
            aria-selected="false"
            tabindex="-1"
            type="button"
          >
            <span class="he-tab__label">Système commercial</span>
          </button>
        </div>

        <div
          class="he-tab-panel is-active"
          role="tabpanel"
          id="he-panel-marketing"
          aria-labelledby="he-tab-marketing"
          tabindex="0"
        >
          <div class="he-tabintro reveal">
            <p class="he-tabintro__eyebrow">§ Système d’acquisition · équipes marketing de PME</p>
            <p class="he-tabintro__lede">Un inbound et un outbound qui rapportent : le site qualifie chaque visite, les agents relancent et mesurent. Deux briques d’un même système marketing, à un pricing de lancement.</p>
          </div>

          <div class="he-diptych reveal-stagger">
            <article class="he-offer">
              <p class="he-offer__tag">Offre 01</p>
              <h3 class="he-offer__title">Site web intelligent</h3>
              <p class="he-offer__body">Un site web IA sur Astro, rapide, indexé par Google et par les moteurs IA, branché à votre CRM. Il qualifie chaque visite et alimente le pipeline en continu : une vitrine qui génère des leads, pas une plaquette figée.</p>
              <div class="hline"></div>
              <ul class="he-offer__points">
                <li>Astro + IA, trouvé par Google et par les IA</li>
                <li>Landing et tunnels reliés au CRM</li>
                <li>Pages éditables, mesurées à la conversion</li>
              </ul>
              <a class="he-offer__link" href="/services/site-web-ia">Voir l’offre →</a>
            </article>

            <article class="he-offer he-offer--complement">
              <p class="he-offer__tag">Offre 02</p>
              <h3 class="he-offer__title">Automation &amp; IA</h3>
              <p class="he-offer__body">Intégration IA de bout en bout : on déploie Claude, ChatGPT ou Mistral et leurs agents dans votre entreprise, branchés à vos outils via MCP (CRM, e-mail, base de données, dépôt Git). De quoi faire travailler l’IA sur vos données réelles et la faire passer de la conversation à l’action.</p>
              <div class="hline"></div>
              <ul class="he-offer__points">
                <li>Claude, ChatGPT ou Mistral en production</li>
                <li>Serveurs MCP propres vers vos outils</li>
                <li>Gouvernance, mesure et passation incluses</li>
              </ul>
              <a class="he-offer__link" href="/services/integration-claude">Voir l’offre →</a>
            </article>
          </div>

          {/* Dorsale line-art · relie visuellement les 2 cartes puis les 6 services · dessinee au scroll */}
          <div class="he-rail hd-draw" aria-hidden="true">
        <svg class="he-rail__svg" viewBox="0 0 1200 150" xmlns="http://www.w3.org/2000/svg" fill="none" role="presentation" focusable="false">
          <path class="hd-line hd-line--2" pathLength="1" d="M300 4 C 300 46, 600 22, 600 62" stroke="var(--accent)" stroke-width="1.2" stroke-opacity="0.7"/>
          <path class="hd-line hd-line--2 he-rail__branch--complement" pathLength="1" d="M900 4 C 900 46, 600 22, 600 62" stroke="var(--accent)" stroke-width="1.2" stroke-opacity="0.7"/>
          <path class="hd-line hd-line--3" pathLength="1" d="M600 62 L600 108" stroke="var(--accent)" stroke-width="1.2" stroke-opacity="0.6"/>
          <path class="hd-line" pathLength="1" d="M100 108 L1100 108" stroke="var(--hairline-strong)" stroke-width="1"/>
          <path class="hd-line hd-line--3" pathLength="1" d="M100 108 L100 146" stroke="var(--hairline-strong)" stroke-width="1"/>
          <path class="hd-line hd-line--3" pathLength="1" d="M300 108 L300 146" stroke="var(--hairline-strong)" stroke-width="1"/>
          <path class="hd-line hd-line--3" pathLength="1" d="M500 108 L500 146" stroke="var(--hairline-strong)" stroke-width="1"/>
          <path class="hd-line hd-line--3" pathLength="1" d="M700 108 L700 146" stroke="var(--hairline-strong)" stroke-width="1"/>
          <path class="hd-line hd-line--3" pathLength="1" d="M900 108 L900 146" stroke="var(--hairline-strong)" stroke-width="1"/>
          <path class="hd-line hd-line--3" pathLength="1" d="M1100 108 L1100 146" stroke="var(--hairline-strong)" stroke-width="1"/>
          <circle class="hd-node" cx="600" cy="62" r="4" fill="var(--accent)"/>
          <circle class="hd-node" cx="100" cy="146" r="3" fill="var(--accent)"/>
          <circle class="hd-node" cx="300" cy="146" r="3" fill="var(--accent)"/>
          <circle class="hd-node" cx="500" cy="146" r="3" fill="var(--accent)"/>
          <circle class="hd-node" cx="700" cy="146" r="3" fill="var(--accent)"/>
          <circle class="hd-node" cx="900" cy="146" r="3" fill="var(--accent)"/>
          <circle class="hd-node" cx="1100" cy="146" r="3" fill="var(--accent)"/>
        </svg>
          </div>

          <p class="he-services__intro reveal">§ Six services, une seule équipe. On active celui qui sert d’abord.</p>
          <div class="he-services reveal-stagger">
            {services.map((s) => (
              <a class="he-svc" href={s.href}>
                <span class="he-svc__k">{s.metric}</span>
                <span class="he-svc__label">{s.label}</span>
                <span class="he-svc__sub">{s.sub}</span>
              </a>
            ))}
          </div>
        </div>

        {/* Panel FAMILLE 2 · Systeme commercial (LIVE) · meme markup que le panel marketing.
            Pas de classes reveal : panel masque au chargement -> l'IO scroll-reveal laisserait
            le contenu en opacity:0 (footgun view-transitions-io). Le contenu s'affiche au clic. */}
        <div
          class="he-tab-panel"
          role="tabpanel"
          id="he-panel-commercial"
          aria-labelledby="he-tab-commercial"
          tabindex="0"
          hidden
        >
          <div class="he-tabintro">
            <p class="he-tabintro__eyebrow">§ Système commercial · équipes commerciales de PME</p>
            <p class="he-tabintro__lede">Vos leads arrivent, puis se perdent. Un système commercial fait l’inverse : la prospection alimente, le CRM qualifie et route, les séquences relancent. Trois leviers sur une seule base pour transformer vos prospects en <i>clients</i>.</p>
          </div>

          <div class="he-diptych he-diptych--trio">
            <article class="he-offer">
              <p class="he-offer__tag">Levier 01</p>
              <h3 class="he-offer__title">Prospection automatisée</h3>
              <p class="he-offer__body">L’outbound qui vise les comptes cibles : ICP serré, listes enrichies et séquences multicanal. La prospection va chercher les comptes que l’inbound n’a pas captés, sans brûler votre domaine.</p>
              <a class="he-offer__link" href="/services/prospection-automatisee">Voir le levier →</a>
            </article>

            <article class="he-offer">
              <p class="he-offer__tag">Levier 02</p>
              <h3 class="he-offer__title">CRM, scoring et routing</h3>
              <p class="he-offer__body">Chaque lead noté selon son comportement, dédoublonné et affecté au bon commercial. Le chaud ne refroidit plus dans une file : l’alerte part à temps.</p>
              <a class="he-offer__link" href="/services/crm-scoring-routing">Voir le levier →</a>
            </article>

            <article class="he-offer">
              <p class="he-offer__tag">Levier 03</p>
              <h3 class="he-offer__title">Séquences de suivi</h3>
              <p class="he-offer__body">Des relances multicanal déclenchées par le comportement, personnalisées par l’IA. Plus aucun compte tiède ne s’éteint par oubli.</p>
              <a class="he-offer__link" href="/services/sequences-de-suivi">Voir le levier →</a>
            </article>
          </div>

          <p class="he-services__intro">§ Trois leviers, un seul système. On active celui qui bouche la fuite qui coûte d’abord.</p>
          <a class="he-offer__link he-panel-cta" href="/services/systeme-commercial">Voir le système commercial →</a>
        </div>
      </div>
    </div>
  </section>

  {/* 04 · La boucle · statement-orbit CATALOGUE (carte ink dans paper) · PIVOT conceptuel */}
  <SectionsRenderer sections={[statementOrbit]} lang="fr" />

  {/* 05 · Ou en etes-vous · diagnostic-stages CATALOGUE + bande CTA quiz (paper ; carte quiz ink) ·
      amendement Simon 2026-07-13 : remonte au-dessus de la tension (auto-positionnement AVANT la douleur) */}
  <SectionsRenderer sections={[maturityStages]} lang="fr" />

  {/* 06 · La tension · 3 douleurs sobres · INK (rythme iter 6, section dramatique) */}
  <section class="he-sec he-tension" data-bg="ink" aria-labelledby="he-tension-h2">
    <div class="wrap-wide">
      <header class="he-head reveal">
        <p class="he-kicker">§ La tension</p>
        <h2 id="he-tension-h2" class="he-h2 u-serif-accent">Là où l’argent <i>fuit</i> en interne.</h2>
      </header>
      <ul class="he-pains reveal-stagger">
        {painItems.map((p) => (
          <li class="he-pain">
            <span class="he-pain__sev" data-sev={p.severity}>{severityLabels[p.severity] ?? p.severity}</span>
            <h3 class="he-pain__title">{p.title}</h3>
            <p class="he-pain__desc">{p.desc}</p>
            <div class="hline"></div>
            <p class="he-pain__fix">{p.fix}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* 07 · Cas clients · 3 cartes compactes + 1 lien « tous les cas » + micro-preuve (paper) · CTA audit retire */}
  <section class="he-sec he-cases" aria-labelledby="he-cases-h2">
    <div class="wrap-wide">
      <header class="he-head reveal">
        <p class="he-kicker">§ Cas clients</p>
        <h2 id="he-cases-h2" class="he-h2 u-serif-accent"><i>Promesse</i> vérifiable, pas discours.</h2>
      </header>
      <div class="he-cases__grid reveal-stagger">
        {caseItems.map((c) => (
          <a class="he-case" href={c.href}>
            <p class="he-case__client">{c.client}</p>
            <p class="he-case__meta">{c.meta}</p>
            <p class="he-case__impact">{c.impact}</p>
            <span class="he-case__link">Lire le cas →</span>
          </a>
        ))}
      </div>
      <div class="he-cases__foot reveal">
        <a class="he-cases__all" href="/cas-clients">Voir tous les cas →</a>
        <p class="he-cases__cta">Des chiffres relevés sur les données du client, jamais une moyenne inventée.</p>
      </div>
    </div>
  </section>

  {/* 08 · Methode · sticky-scroll-storytelling CATALOGUE (ink) · media sticky crossfade au scroll */}
  <SectionsRenderer sections={[methodStory]} lang="fr" />

  {/* 09 · Temoignages · testimonial-wall CATALOGUE (paper) · 6 avis de SWI, en-tete home */}
  <SectionsRenderer sections={[testimonialsHome]} lang="fr" />

  {/* 10 · Tableau de bord media · eeat-panel variant media (ink) · profil, reperes, secteurs, liens globaux */}
  <SectionsRenderer sections={[mediaDashboard]} lang="fr" />

  {/* 11 · Climax chiffre (2e stats-bento de C, paper-2) · pre-FAQ · cellule autonomie deja dans la base */}
  <SectionsRenderer sections={[statsBentoDashboard]} lang="fr" />

  {/* 12 · FAQ · 6 questions reformulees AIO · Q.01 prix ouverte (SEULE mention de prix de la page) */}
  <FaqAccordion
    items={faqItems}
    heading={faqConfig.heading}
    intro={faqConfig.intro}
    background="paper"
    openFirst
  />

  {/* 13 · Action · BookSession (ink) + FooterMarquee */}
  <BookSession />
  <FooterMarquee />

  <ScrollProgress />
</Base>

<style>
  /* ── Rythme de section · hierarchie par l'echelle (compaction iter 6 : gagner sur les vides) ── */
  .he-sec { padding-block: var(--section-base); }
  /* MONEY SLOT : iter 6 passe --section-loose -> --section-base (poids porte par he-h2--xl + la
     densite du contenu, pas par 160px de vide). Reste le slot le plus riche de la page. */
  .he-offres {
    --home-complement: #2090A8;
    --home-complement-rgb: 32, 144, 168;
    padding-block: var(--section-base);
  }

  /* 05 · La tension INK (rythme iter 6) · idiome DS carte-sur-ink (repris de TestimonialWall) :
     fond ink, header en paper, cartes en surface ink elevee (rgba paper) + hairline clair.
     Le contexte [data-bg='ink'] remappe deja --muted/--hairline/--accent-text (global.css) →
     desc/severite/hairlines passent clairs automatiquement. 0 nouveau token. */
  .he-tension[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .he-tension[data-bg='ink'] .he-h2 { color: var(--paper); }
  .he-tension[data-bg='ink'] .he-pain {
    background: rgba(var(--paper-rgb), 0.04);
    border: 1px solid rgba(var(--paper-rgb), 0.12);
    box-shadow: none;
  }
  .he-tension[data-bg='ink'] .he-pain__title,
  .he-tension[data-bg='ink'] .he-pain__fix { color: var(--paper); }

  /* ── En-tete de chapitre (kicker mono § + h2 + lede) ── */
  .he-head {
    max-width: var(--wrap-read);
    margin-bottom: var(--space-7); /* iter 6 : space-9 -> space-7 (respiration gardee, vide reduit) */
  }
  .he-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-kicker);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0 0 var(--space-4);
  }
  .he-h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    font-weight: var(--fw-medium);
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-display);
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  /* Money/proof : cran display superieur (varie l'echelle typographique) */
