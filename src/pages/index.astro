---
export const prerender = true;

/**
 * Homepage · recomposition V-F3 (directive Simon 2026-06-29) · FR
 *
 * Mix : composants LIVE bespoke (Hero, ArchitectureDiagram, ServicesGrid, CtaBand,
 * FaqAccordion, BookSession) + sections CATALOGUÉES de la variante C rendues via
 * <SectionsRenderer> en groupes contigus. Rythme paper/ink rééquilibré :
 * ink uniquement sur 4 nœuds (ArchitectureDiagram · pain-severity · case-card-grid · BookSession),
 * jamais 2 ink adjacents, l'accent (CtaBand) casse le run clair au moment-prix.
 *
 * Séquence (15 slots) :
 *   01 Hero (live, paper, mobile amélioré)
 *   02 logo-marquee (C, paper-2) · 03 feature-zigzag « offres » (C, paper)
 *   04 ArchitectureDiagram (live, ink) · 05 ServicesGrid 6 services (live, paper)
 *   06 sticky-scroll (C, paper-2) · 07 pain-severity (C, ink)
 *   09 case-card-grid (C, ink) · 10 stats-bento climax (C, paper-2 recoloré)
 *   11 CtaBand (live, accent) · 12 points d'entrée (related-cards-band inline : 2 grilles + audit, paper)
 *   13 FaqAccordion (live, contenu C, paper-2) · 14 BookSession (live, ink, épuré) · 15 FooterMarquee
 *
 * Retirés (vs V-F2 / variante C) : Acte I StatBlock+SocialProof (doublon de chiffres),
 * hero-masthead-card C (Hero live gardé), bento-grid C (doublon ArchitectureDiagram),
 * eeat-panel, faq-two-column C (→ FaqAccordion live), EditorialPreview, MaturityPyramid,
 * stats-bento Acte I C.
 *
 * Typo (directive 2026-06-11) : la masse passe en sans via la couche `.home-typo`
 * (global.css), le serif italique ne fait que relever les fragments <i>. Hero hors scope.
 */
import Base from '../layouts/Base.astro';
import BootSplash from '../components/motion/BootSplash.astro';
import ScrollProgress from '../components/ui/atoms/ScrollProgress.astro';

import Hero                from '../components/ui/organisms/Hero.astro';
import SectionsRenderer    from '../components/sections/SectionsRenderer.astro';
import ArchitectureDiagram from '../components/sections/ArchitectureDiagram.astro';
import ServicesGrid        from '../components/sections/ServicesGrid.astro';
import CtaBandSection      from '../components/sections/CtaBandSection.astro';
import FaqAccordion        from '../components/sections/FaqAccordion.astro';
import BookSession         from '../components/ui/organisms/BookSession.astro';
import FooterMarquee       from '../components/ui/organisms/FooterMarquee.astro';
import SectionTransition   from '../components/ui/atoms/SectionTransition.astro';

import homeVariantC from '../data/page-variants/home/c.json';

import { SIX_SERVICES } from '../data/sitemap';
import { localizeHref } from '../lib/i18n';
import type { SectionByType, SectionData } from '@waimia/ds-kernel';

// ── Sections cataloguées · copiées de la variante C (c.json) ───────────────────
// On pioche les objets validés par type et on ajuste `background` selon le rythme cible.
const cByType = <T extends string>(t: T) =>
  (homeVariantC.sections as any[]).find((s) => s.type === t);

// 02 · marquee « écosystème » sur fond ink + grayscale (logos blancs, hover couleur) = config page SWI (directive Simon 2026-06-29)
const logoMarqueeC = { ...cByType('logo-marquee'), background: 'ink', grayscale: true } as SectionData;
const featureZigzagC = { ...cByType('feature-zigzag'), background: 'paper' } as SectionData;      // 03 · garde anchor "offres"
const stickyScrollC = { ...cByType('sticky-scroll-storytelling'), background: 'paper-2', proportion: 'media-led' } as SectionData; // 06 · media-led (asymétrique 38/62, comme integrateur-claude) au lieu de balanced 50/50
const painSeverityC = { ...cByType('pain-severity-list'), background: 'ink' } as SectionData;     // 07
const caseGridC = { ...cByType('case-card-grid'), background: 'ink' } as SectionData;             // 09
// 10 · stats-bento « climax » (le 2ᵉ stats-bento de C) recoloré ink → paper-2 (anti 2-ink + moins de noir)
const statsBentoClimaxC = {
  ...(homeVariantC.sections as any[]).filter((s) => s.type === 'stats-bento')[1],
  background: 'paper-2',
} as SectionData;
// 12 · points d'entrée (V8 vague 2) · la home ne montre plus de grille détaillée :
// 2 grilles (site-web-ia · systeme-complet) + audit gratuit. La grille par paliers vit sur les pages service.
const entryPointsData = {
  type: 'related-cards-band' as const,
  background: 'paper' as const,
  kicker_fr: "§ Points d'entrée",
  kicker_en: '§ Entry points',
  cards: [
    {
      kicker_fr: 'À PARTIR DE 2 000 € HT',
      kicker_en: 'FROM 2,000 € EX VAT',
      title_fr: 'Le système marketing',
      title_en: 'The marketing system',
      lead_fr: 'Site web intelligent, contenu et tunnel : la grille détaillée, formule par formule.',
      lead_en: 'Intelligent website, content and funnel: the detailed grid, plan by plan.',
      href: localizeHref('/services/site-web-ia', 'fr'),
    },
    {
      kicker_fr: 'SUR DEVIS · TARIF DÉGRESSIF',
      kicker_en: 'ON QUOTE · DEGRESSIVE RATE',
      title_fr: 'Le système complet',
      title_en: 'The complete system',
      lead_fr: "Inbound et outbound assemblés autour d'une seule base pilotée. La grille du bundle.",
      lead_en: 'Inbound and outbound assembled around one piloted base. The bundle grid.',
      href: localizeHref('/services/systeme-complet', 'fr'),
    },
    {
      kicker_fr: 'GRATUIT · 45 MIN',
      kicker_en: 'FREE · 45 MIN',
      title_fr: 'Un audit pour se situer',
      title_en: 'An audit to place yourself',
      lead_fr: 'Pas sûr du point de départ ? On chiffre le périmètre au diagnostic, sans engagement.',
      lead_en: 'Not sure where to start? We cost the scope at the diagnosis, no commitment.',
      href: localizeHref('/contact', 'fr'),
    },
  ],
} satisfies SectionByType<'related-cards-band'>;

// ── Acte II · FIG 2.0 Le système (absorbe le rôle de FeatureGrid) ──────────────
// Exemples par canal dérivés du copy existant (hero mini-map + SIX_SERVICES) : 0 invention.
const architectureDiagramData = {
  type: 'architecture-diagram' as const,
  background: 'ink' as const,
  fig_num: 'FIG II · 2.0',
  fig_title_fr: 'Acte II : Le système', fig_title_en: 'Act II: The system',
  spec_fr: 'CANAUX · SYSTÈME · ACTIONS', spec_en: 'CHANNELS · SYSTEM · ACTIONS',
  h2_fr: 'Une seule <i>architecture</i>.<br/>Six entrées, quatre sorties, mille décisions.',
  h2_en: 'One <i>architecture</i>.<br/>Six inputs, four outputs, a thousand decisions.',
  inputs_fr: ['Ads', 'Contenu', 'Site', 'CRM', 'Analytics', 'Marque'],
  inputs_en: ['Ads', 'Content', 'Site', 'CRM', 'Analytics', 'Brand'],
  input_examples_fr: [
    'Google Ads, Meta, LinkedIn reliés au pipeline',
    'Articles SEO/GEO produits et indexés',
    'Landing, tunnel, CMS branchés au CRM',
    'Relances, qualification, alertes automatiques',
    'GA4 et Search Console lus en tableaux de bord',
    'Design system, decks, PDF alignés',
  ],
  input_examples_en: [
    'Google Ads, Meta, LinkedIn wired to the pipeline',
    'SEO/GEO articles produced and indexed',
    'Landing, funnel, CMS plugged into the CRM',
    'Follow-ups, qualification, automatic alerts',
    'GA4 and Search Console read as dashboards',
    'Design system, decks, PDF aligned',
  ],
  outputs_fr: ['Actions', 'Supports', 'Reporting', 'Pipeline'],
  outputs_en: ['Actions', 'Assets', 'Reports', 'Pipeline'],
  system_label: 'Waimia', system_kicker: 'AI SYSTEM', system_subtitle: 'multi-agent',
  show_loop: true,
  loop_label_fr: 'BOUCLE D’AMÉLIORATION CONTINUE', loop_label_en: 'CONTINUOUS IMPROVEMENT LOOP',
  caption_fr: "Six canaux entrent. Quatre familles d'<i>actions</i> sortent. Au milieu, un système multi-agents qui mesure, apprend et réinjecte, sans relance manuelle.",
  caption_en: 'Six channels in. Four families of <i>actions</i> out. In between, a multi-agent system that measures, learns and reinjects, without manual chasing.',
} satisfies SectionByType<'architecture-diagram'>;

// ── Acte II · FIG 2.5 L'offre (ServicesGrid · 6 services réels v7) ──────────────
// Source UNIQUE = SIX_SERVICES (sitemap.ts). Chaque carte pointe vers sa vraie page
// /services/<slug> via le slot per-service `usecase_*`. Honnêteté : capacités/engagements,
// 0 résultat client chiffré (studio solo). Pied de grille = liens directs vers les 6 pages.
const servicesGridData = {
  type: 'services-grid' as const,
  fig_num: 'FIG II · 2.5',
  fig_title_fr: "Acte II : L'offre",
  fig_title_en: 'Act II: The offer',
  spec_fr: '6 SERVICES · UNE COUCHE CONTINUE',
  spec_en: '6 SERVICES · ONE CONTINUOUS LAYER',
  h2_fr: 'Six services, appris en <i>livrant</i>, pas en PowerPoint.',
  h2_en: 'Six services, taught by <i>doing</i>, not by slides.',
  connectors_label_fr: 'Connecteurs',
  connectors_label_en: 'Connectors',
  services: SIX_SERVICES.map((s) => ({
    fig: `2.5${Number(s.k)}`,
    metric_fr: s.metric.fr,
    metric_en: s.metric.en,
    label_fr: s.label.fr,
    label_en: s.label.en,
    body_fr: s.body.fr,
    body_en: s.body.en,
    connectors_fr: s.connectors.fr,
    connectors_en: s.connectors.en,
    usecase_label_fr: 'Voir le service →',
    usecase_label_en: 'See the service →',
    usecase_href: localizeHref(s.href, 'fr'),
  })),
  foot_links: [
    { label_fr: 'Toutes les solutions →', label_en: 'All solutions →', href: localizeHref('/services', 'fr') },
    { label_fr: 'Nos cas clients →', label_en: 'Our case studies →', href: localizeHref('/cas-clients', 'fr') },
  ],
  illustration: {
    src: 'services-layer.svg',
    alt_fr: 'Six services reliés par une même couche continue : une dorsale traverse et connecte chaque service.',
    alt_en: 'Six services linked by one continuous layer: a backbone runs through and connects each service.',
    caption_fr: 'Une seule couche continue relie les six services',
    caption_en: 'One continuous layer links the six services',
  },
} satisfies SectionByType<'services-grid'>;

// CTA intermédiaire (docs/39 P1-8 : jamais > 3 500 px sans porte de sortie) ·
// posé au moment-prix pour casser le run clair avec une frame accent.
const ctaInlineData = {
  type: 'cta-band' as const,
  text_fr: "Pas sûr du point de départ ? 30 minutes au téléphone suffisent pour le situer.",
  text_en: 'Not sure where to start? A 30-minute call is enough to place it.',
  cta: { label_fr: 'Réserver un audit →', label_en: 'Book an audit →', href: localizeHref('/contact', 'fr'), variant: 'primary' as const },
  background: 'accent' as const,
} satisfies SectionByType<'cta-band'>;

// FAQ PME-first · 8 questions scannables (contenu transcrit du faq-two-column de la variante C).
const faqItems = (cByType('faq-accordion').items as any[]).map((it) => ({
  q: it.q_fr,
  a: it.a_fr,
}));
---
<Base
  title="Waimia · Studio IA & intégration IA pour PME · Site web intelligent · Montpellier"
  description="Studio IA pour PME : conseil, intégration et mise en production de l'IA (site web intelligent, acquisition, CRM, pilotage). Diagnostic gratuit dès 2 000 € HT."
>
  {/* Splash · respiration cinématique 1.1s · CSS-only depuis V2 2026-05-15 (zéro JS bundle) */}
  <BootSplash lang="fr" />

  {/* 01 · Hero · promesse + mini-map 6 territoires + CTAs · INTOUCHÉ (référence qualité) */}
  <Hero />

  <div class="home-typo">

    {/* 02 logo-marquee (paper-2) · 03 feature-zigzag « offres » (paper) · sections cataloguées C */}
    <SectionsRenderer sections={[logoMarqueeC, featureZigzagC]} lang="fr" />

    <SectionTransition phrase="Deux offres, une même couche connectée. Le système qui les relie." />

    {/* 04 · ArchitectureDiagram · FIG 2.0 · le modèle mental, flux dessinés au scroll (ink) */}
    <ArchitectureDiagram data={architectureDiagramData} lang="fr" />

    {/* 05 · ServicesGrid · FIG 2.5 · les 6 services réels v7 (paper) */}
    <ServicesGrid data={servicesGridData} lang="fr" />

    {/* 06 sticky-scroll méthode (paper-2) · 07 pain-severity tension (ink) · 08 stats-bento climax (paper-2, séparateur anti 2-ink) */}
    <SectionsRenderer sections={[stickyScrollC, painSeverityC, statsBentoClimaxC]} lang="fr" />

    <SectionTransition phrase="Promesse vérifiable, pas discours." />

    {/* 09 case-card-grid cas clients (ink) */}
    <SectionsRenderer sections={[caseGridC]} lang="fr" />

    {/* 11 · CtaBand · porte de sortie au moment-prix · frame accent qui casse le run clair */}
    <CtaBandSection data={ctaInlineData} lang="fr" />

    {/* 12 · points d'entrée · 2 grilles (service + bundle) + audit gratuit, plus de grille détaillée (paper) */}
    <SectionsRenderer sections={[entryPointsData]} lang="fr" />

    {/* 13 · FaqAccordion · 8 questions PME-first · Q.01 ouverte (contenu transcrit de C) */}
    <FaqAccordion
      items={faqItems}
      heading="Questions fréquentes"
      intro="Huit réponses nettes, pas des slides, pas du jargon. Ce qu'on écrit par mail avant de se parler."
      background="paper-2"
      openFirst
    />

    <SectionTransition phrase="Lire aide à comprendre. Auditer permet de chiffrer." />

    {/* 14 · BookSession · climax ink · CTA principal vers /contact (Acte V) */}
    <BookSession />

  </div>

  {/* FooterMarquee · ruban éditorial animé pré-scrollprogress */}
  <FooterMarquee />

  <ScrollProgress />
  <script>
    import { initHomepageNarrative } from '../lib/animations/signature/homepage-narrative';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    function bootstrap() {
      // Kill anciens ScrollTriggers (evite leak + double-init apres ClientRouter)
      ScrollTrigger.getAll().forEach((t) => t.kill());
      initHomepageNarrative();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootstrap);
    } else {
      bootstrap();
    }
    document.addEventListener('astro:page-load', bootstrap);
  </script>
</Base>
