---
export const prerender = true;

/**
 * Homepage · recomposition V-F2 (docs/visual-audit/home/README.md + docs/40 §6) · FR
 *
 * Principe : 1 information = 1 représentation. Séquence 10 slots (vs 12 + 8 interludes) :
 *   Acte I  promesse & preuve  → Hero (intouché) + bande de preuve unifiée (StatBlock + SocialProof)
 *   Acte II système & offre    → ArchitectureDiagram (FIG 2.0) + ServicesGrid fusionnée UseCaseIndex (FIG 2.5)
 *   Acte III engagement        → MaturityPyramid cards-only (stage + prix d'entrée) + CtaInline
 *   Acte IV domaines           → CaseCardGrid (domaines d'intervention) + FAQ (Q.01 ouverte) + Notes de terrain ×3
 *   Acte V  action             → BookSession (ink)
 *
 * Retirés de la home (restent au catalogue / autres pages) :
 *   - FeatureGrid « 8 piliers » → rôle absorbé par ArchitectureDiagram (exemples par nœud)
 *   - UseCaseIndex → fusionné dans ServicesGrid (liens cas d'usage par service + pied de grille)
 *   - 5 des 8 interludes SectionTransition (3 pivots conservés)
 *
 * Typo (directive 2026-06-11) : la masse passe en sans via la couche `.home-typo`
 * (global.css), le serif italique ne fait que relever les fragments <i>. Hero hors scope.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BootSplash from '../components/motion/BootSplash.astro';
import ScrollProgress from '../components/ui/atoms/ScrollProgress.astro';

import Hero                from '../components/ui/organisms/Hero.astro';
import StatBlock           from '../components/sections/StatBlock.astro';
import SocialProof         from '../components/sections/SocialProof.astro';
import ArchitectureDiagram from '../components/sections/ArchitectureDiagram.astro';
import ServicesGrid        from '../components/sections/ServicesGrid.astro';
import MaturityPyramid     from '../components/sections/MaturityPyramid.astro';
import CtaBandSection      from '../components/sections/CtaBandSection.astro';
import CaseCardGrid        from '../components/sections/CaseCardGrid.astro';
import { caseCardGridData } from '../lib/case-card-grid-data';
import FaqAccordion        from '../components/sections/FaqAccordion.astro';
import EditorialPreview    from '../components/sections/EditorialPreview.astro';
import { editorialPreviewData } from '../lib/editorial-preview-data';
import BookSession         from '../components/ui/organisms/BookSession.astro';
import FooterMarquee       from '../components/ui/organisms/FooterMarquee.astro';
import SectionTransition   from '../components/ui/atoms/SectionTransition.astro';

import { CLIENT_LOGOS, HERO_METRICS, SIX_SERVICES, PYRAMID_TIERS, DEPARTMENTS_GRID } from '../data/sitemap';
import { PRICING_GRID, tierPriceLabel, PRICE_FROM_LABEL } from '../data/pricing';
import { localizeHref } from '../lib/i18n';
import type { SectionByType } from '../schemas/sections';

// ── Acte I · Bande d'engagements unifiée (audit home §02+03) ───────────────────
// 3 repères NON présents dans le hero (le « 12h/sem » vit déjà dans la preuve n°1
// du hero, 250 px plus haut) + lien vers les domaines d'intervention. Honnêteté : ce
// sont des engagements/capacités (audit 5j, pilote, ROI mesuré sur vos données), 0 résultat client.
const proofBarData = {
  type: 'proof-bar' as const,
  layout: 'horizontal' as const,
  background: 'paper-2' as const,
  kicker_fr: 'ACTE I · PREUVES',
  kicker_en: 'ACT I · PROOFS',
  metrics: HERO_METRICS.filter((m) => m.k !== '01').map((m) => ({
    value: m.n,
    label_fr: m.label.fr,
    label_en: m.label.en,
    emphasis: false,
  })),
  link_label_fr: "Voir les domaines d'intervention →",
  link_label_en: 'See where we intervene →',
  link_href: localizeHref('/cas-clients', 'fr'),
} satisfies SectionByType<'proof-bar'>;

const socialProofData = {
  type: 'social-proof' as const,
  background: 'paper-2' as const,
  logos: CLIENT_LOGOS.map((name) => ({ name })),
  marquee: true,
} satisfies SectionByType<'social-proof'>;

// ── Acte II · FIG 2.0 Le système (absorbe le rôle de FeatureGrid) ──────────────
// Exemples par canal dérivés du copy existant (hero mini-map + SIX_SERVICES) : 0 invention.
const architectureDiagramData = {
  type: 'architecture-diagram' as const,
  background: 'ink' as const,
  fig_num: 'FIG II · 2.0',
  fig_title_fr: 'Acte II : Le système', fig_title_en: 'Act II: The system',
  spec_fr: 'CANAUX · SYSTÈME · ACTIONS', spec_en: 'CHANNELS · SYSTEM · ACTIONS',
  h2_fr: 'Une seule <i>architecture</i>.<br/>Six entrées, quatre sorties, mille décisions.',
  h2_en: 'One <i>architecture</i>.<br/>Six inputs, four outputs, a thousand decisions.',
  inputs_fr: ['Ads', 'Contenu', 'Site', 'CRM', 'Analytics', 'Marque'],
  inputs_en: ['Ads', 'Content', 'Site', 'CRM', 'Analytics', 'Brand'],
  input_examples_fr: [
    'Google Ads, Meta, LinkedIn reliés au pipeline',
    'Articles SEO/GEO produits et indexés',
    'Landing, tunnel, CMS branchés au CRM',
    'Relances, qualification, alertes automatiques',
    'GA4 et Search Console lus en tableaux de bord',
    'Design system, decks, PDF alignés',
  ],
  input_examples_en: [
    'Google Ads, Meta, LinkedIn wired to the pipeline',
    'SEO/GEO articles produced and indexed',
    'Landing, funnel, CMS plugged into the CRM',
    'Follow-ups, qualification, automatic alerts',
    'GA4 and Search Console read as dashboards',
    'Design system, decks, PDF aligned',
  ],
  outputs_fr: ['Actions', 'Supports', 'Reporting', 'Pipeline'],
  outputs_en: ['Actions', 'Assets', 'Reports', 'Pipeline'],
  system_label: 'Waimia', system_kicker: 'AI SYSTEM', system_subtitle: 'multi-agent',
  show_loop: true,
  loop_label_fr: 'BOUCLE D’AMÉLIORATION CONTINUE', loop_label_en: 'CONTINUOUS IMPROVEMENT LOOP',
  caption_fr: "Six canaux entrent. Quatre familles d'<i>actions</i> sortent. Au milieu, un système multi-agents qui mesure, apprend et réinjecte, sans relance manuelle.",
  caption_en: 'Six channels in. Four families of <i>actions</i> out. In between, a multi-agent system that measures, learns and reinjects, without manual chasing.',
} satisfies SectionByType<'architecture-diagram'>;

// ── Acte II · FIG 2.5 L'offre (ServicesGrid fusionnée avec UseCaseIndex) ───────
// Métriques = capacités/engagements VÉRIFIABLES (source UNIQUE = SIX_SERVICES dans
// sitemap.ts), registre du hero : audit 5j, pipeline connecté, CRM relié, temps réel,
// workflows, souverain. Honnêteté (studio solo, 0 cas mesuré) : aucun chiffre de ROI inventé.
// SEO état final : pages /solutions/* supprimées (anti-dilution). Les cas d'usage
// Acquérir vivent désormais en ancres du hub /acquerir (publicité/agent « à venir »).
const SERVICE_USECASES: Record<string, string> = {
  '02': 'publicite-en-ligne',
  '03': 'agent-marketing-commercial',
};
const USECASE_ANCHOR: Record<string, string> = {
  'publicite-en-ligne': '/acquerir#publicite',
  'agent-marketing-commercial': '/acquerir#agent-marketing',
};
const usecaseBySlug = (slug: string) => DEPARTMENTS_GRID.find((d) => d.slug === slug);
const servicesGridData = {
  type: 'services-grid' as const,
  fig_num: 'FIG II · 2.5',
  fig_title_fr: "Acte II : L'offre",
  fig_title_en: 'Act II: The offer',
  spec_fr: '6 SERVICES · UNE COUCHE CONTINUE',
  spec_en: '6 SERVICES · ONE CONTINUOUS LAYER',
  h2_fr: 'Six services, appris en <i>livrant</i>, pas en PowerPoint.',
  h2_en: 'Six services, taught by <i>doing</i>, not by slides.',
  connectors_label_fr: 'Connecteurs',
  connectors_label_en: 'Connectors',
  services: SIX_SERVICES.map((s) => {
    const ucSlug = SERVICE_USECASES[s.k];
    const uc = ucSlug ? usecaseBySlug(ucSlug) : undefined;
    return {
      fig: `2.5${Number(s.k)}`,
      metric_fr: s.metric.fr,
      metric_en: s.metric.en,
      label_fr: s.label.fr,
      label_en: s.label.en,
      body_fr: s.body.fr,
      body_en: s.body.en,
      connectors_fr: s.connectors.fr,
      connectors_en: s.connectors.en,
      ...(uc
        ? {
            usecase_label_fr: `Cas d'usage · ${uc.label.fr} →`,
            usecase_label_en: `Use case · ${uc.label.en} →`,
            usecase_href: localizeHref(USECASE_ANCHOR[ucSlug] ?? '/acquerir', 'fr'),
          }
        : {}),
    };
  }),
  // 3 piliers à parité (Acquérir / Piloter / Opérer) + cas clients : la home ne sur-met plus Acquérir.
  foot_links: [
    { label_fr: 'Acquérir →', label_en: 'Acquire →', href: localizeHref('/acquerir', 'fr') },
    { label_fr: 'Piloter →', label_en: 'Steer →', href: localizeHref('/piloter', 'fr') },
    { label_fr: 'Opérer →', label_en: 'Operate →', href: localizeHref('/operer', 'fr') },
    { label_fr: 'Nos cas clients →', label_en: 'Our case studies →', href: localizeHref('/cas-clients', 'fr') },
  ],
} satisfies SectionByType<'services-grid'>;

// ── Acte III · Pyramide cards-only (cas d'école « 1 info = 4 représentations ») ─
// Timeline + SVG paliers supprimés : le stage (ex-timeline) entre en sur-titre de card,
// la progression I→IV passe par la jauge, le verbe ne vit plus que dans le H2.
// Prix d'entrée par palier · source UNIQUE = src/data/pricing.ts (grille 2/4/7/10k + sur-mesure).
// Audit/diagnostic d'entrée gratuit (décision 4). Délais indicatifs, cadrés au diagnostic.
const ACTION_LABELS = [
  { fr: 'Cartographier', en: 'Map' },
  { fr: 'Orchestrer', en: 'Orchestrate' },
  { fr: 'Mettre en production', en: 'Ship to production' },
  { fr: 'Industrialiser', en: 'Industrialize' },
];
// 4 paliers visibles dans la pyramide = essentiel / standard / avancé / système (grille canonique).
// Le palier sur-mesure vit au pied de l'offre (FAQ + pages service).
const TIER_DELAYS = [
  { fr: '1 à 2 sem', en: '1 to 2 weeks' },
  { fr: '3 à 5 sem', en: '3 to 5 weeks' },
  { fr: '5 à 8 sem', en: '5 to 8 weeks' },
  { fr: '8 à 12 sem', en: '8 to 12 weeks' },
];
const TIER_DETAILS = ['essentiel', 'standard', 'avance', 'systeme'].map((id, idx) => ({
  stage: { fr: PRICING_GRID[idx].label!.fr, en: PRICING_GRID[idx].label!.en },
  price: {
    fr: `${tierPriceLabel(id as any, 'fr')} HT · ${TIER_DELAYS[idx].fr}`,
    en: `${tierPriceLabel(id as any, 'en')} excl. VAT · ${TIER_DELAYS[idx].en}`,
  },
}));
const maturityPyramidData = {
  type: 'maturity-pyramid' as const,
  variant: 'cards-only' as const,
  roman: 'III',
  label_fr: "Acte III : La pyramide d'engagements",
  label_en: 'Act III: The engagement pyramid',
  heading_fr: '<i>Cartographier.</i> Orchestrer.<br/>Mettre en production. <i>Industrialiser.</i>',
  heading_en: '<i>Map.</i> Orchestrate.<br/>Ship to production. <i>Industrialize.</i>',
  aside_fr: "Du diagnostic process à l'infrastructure souveraine : chaque palier prépare le suivant. Vous montez quand vous êtes prêt.",
  aside_en: "From process diagnostic to sovereign infrastructure: each tier sets up the next. You climb when you're ready.",
  timeline_label_fr: 'Progression de maturité IA',
  timeline_label_en: 'AI maturity path',
  tier_cta_fr: 'Voir le palier →',
  tier_cta_en: 'Open tier →',
  tiers: PYRAMID_TIERS.map((tier, idx) => ({
    n: tier.n,
    tag_fr: tier.tag.fr, tag_en: tier.tag.en,
    label_fr: tier.label.fr, label_en: tier.label.en,
    lead_fr: tier.lead.fr, lead_en: tier.lead.en,
    items_fr: tier.items, items_en: tier.items,
    action_fr: ACTION_LABELS[idx].fr, action_en: ACTION_LABELS[idx].en,
    href: tier.href,
    stage_fr: TIER_DETAILS[idx].stage.fr, stage_en: TIER_DETAILS[idx].stage.en,
    price_fr: TIER_DETAILS[idx].price.fr, price_en: TIER_DETAILS[idx].price.en,
  })),
} satisfies SectionByType<'maturity-pyramid'>;

// CTA intermédiaire (docs/39 P1-8 : jamais > 3 500 px sans porte de sortie) ·
// posé au 2ᵉ pic d'intention, juste après le moment prix.
const ctaInlineData = {
  type: 'cta-band' as const,
  text_fr: "Un doute sur le palier d'entrée ? 30 minutes au téléphone suffisent pour le situer.",
  text_en: 'Not sure which tier to start at? A 30-minute call is enough to place it.',
  cta: { label_fr: 'Réserver un audit →', label_en: 'Book an audit →', href: localizeHref('/contact', 'fr'), variant: 'primary' as const },
  // Touche accent au moment-prix (rythme paper → ink → paper → accent). Token DS existant.
  background: 'accent' as const,
} satisfies SectionByType<'cta-band'>;

// FAQ PME-first · 8 questions scannables (V5 : + CMS · + brand consistency)
const faqItems = [
  {
    q: "Combien coûte un premier engagement avec Waimia ?",
    a: `Le diagnostic IA est gratuit. Ensuite, la grille démarre ${PRICE_FROM_LABEL.fr} (palier Essentiel : un premier système intelligent en ligne) et monte à 4 000, 7 000 puis 10 000 € HT selon votre maturité, avec un palier sur-mesure au-delà. La plupart des PME commencent petit, mesurent vite, puis montent en charge quand c'est rentable.`,
  },
  {
    q: "Pour qui c'est fait, et pour qui ce n'est pas fait.",
    a: "PME françaises, 10 à 250 collaborateurs. Pas les grands groupes déjà bardés de prestataires. Pas les startups trop jeunes, qui changent de cap toutes les semaines. Nos meilleurs profils : services B2B, industrie, cabinets finance et compta, commerces qui veulent un site qui travaille.",
  },
  {
    q: "En combien de temps voit-on un retour sur investissement ?",
    a: "Le palier Essentiel met un premier système en production en 1 à 2 semaines, mesure avant/après incluse. Un système complet se déploie en 5 à 12 semaines selon le périmètre. On orchestre, puis on mesure : le ROI de chaque chantier est relevé avant/après, sur vos données, pas un chiffre moyen inventé.",
  },
  {
    q: "Et si on veut reprendre la main en interne ?",
    a: "Tout est documenté, ouvert, transmissible. Pas de boîte noire, pas de captivité. On forme votre équipe pendant la mission (2 à 3 jours) et on livre le mode opératoire complet. Vous gardez la plateforme quand on part.",
  },
  {
    q: "Comment garantissez-vous la conformité RGPD et AI Act ?",
    a: "Chaque système inclut par défaut : journal des actions, export CSV/JSON, retour arrière possible, classification du risque AI Act. Sur les périmètres sensibles, on mène une analyse d'impact (PIA) avant le sprint.",
  },
  {
    q: "Travaillez-vous avec notre stack actuelle (HubSpot, Salesforce, Excel, etc.) ?",
    a: "Oui : on se branche sur votre stack actuelle : HubSpot, Salesforce, Pipedrive, Notion, Excel, Office, ERP. Pas de migration imposée. Si vous n'avez pas de CRM, on en propose un adapté à votre volume, souvent HubSpot pour les PME B2B.",
  },
  {
    q: "Et notre site web et CMS actuels ? Faut-il tout refaire ?",
    a: "Non. On se branche sur votre CMS existant (WordPress, Webflow, Sanity, headless) ou on bascule vers un CMS Git-based si la maturité de l'équipe le permet. Sites IA-first, landing, tunnels et pages évolutives peuvent vivre en parallèle ou remplacer progressivement l'existant, à votre rythme.",
  },
  {
    q: "Comment garantissez-vous la cohérence de marque sur tous les supports ?",
    a: "On part de votre design system (ou on le construit), on encode votre charte et votre ton dans des templates, et on déploie des agents de production alignés. Résultat : site, posts, decks PowerPoint, PDF, ads et supports sales restent visuellement et verbalement cohérents même quand l'IA produit en volume.",
  },
];

// Acte IV · Cas clients · source UNIQUE = collection `cases` (P0-5). Plus de CASE_FEED générique.
const allCases = await getCollection('cases', ({ data }) => !data.ndaProtected);
const homeCases = caseCardGridData('fr', allCases);
---
<Base
  title="Waimia · Studio IA & intégration IA pour PME · Site web intelligent · Montpellier"
  description="Studio IA pour PME : on conseille, on intègre et on met l'IA en production dans vos outils (site web intelligent, acquisition, CRM, pilotage). Diagnostic gratuit, dès 2 000 € HT. Montpellier."
>
  {/* Splash · respiration cinématique 1.1s · CSS-only depuis V2 2026-05-15 (zéro JS bundle) */}
  <BootSplash lang="fr" />

  {/* 01 — Hero · promesse + mini-map 6 territoires + CTAs · INTOUCHÉ (référence qualité) */}
  <Hero />

  <div class="home-typo">

    {/* 02 — Bande de preuve unifiée · 3 métriques hors-hero + logos + lien dossiers (Acte I) */}
    <StatBlock data={proofBarData} lang="fr" />
    <SocialProof data={socialProofData} lang="fr" />

    <SectionTransition phrase="Les chiffres ne viennent pas d'un outil isolé. Ils viennent d'un système connecté." />

    {/* 03 — ArchitectureDiagram · FIG 2.0 · le modèle mental, flux dessinés au scroll */}
    <ArchitectureDiagram data={architectureDiagramData} lang="fr" />

    {/* 04 — ServicesGrid · FIG 2.5 · l'unique taxonomie de l'offre (fusion UseCaseIndex) */}
    <ServicesGrid data={servicesGridData} lang="fr" />

    {/* 05 — Pyramide cards-only · stage + prix d'entrée + jauge I→IV (Acte III) */}
    <MaturityPyramid data={maturityPyramidData} lang="fr" />

    {/* 05b — CTA inline · porte de sortie au moment prix (P1-8) */}
    <CtaBandSection data={ctaInlineData} lang="fr" />

    <SectionTransition phrase="Promesse vérifiable, pas discours." />

    {/* 07 — CaseCardGrid · cas clients réels (collection `cases`) · secteur · durée · stack · livré */}
    <CaseCardGrid data={homeCases} lang="fr" />

    {/* 08 — FaqAccordion · 8 questions PME-first · Q.01 (prix) ouverte par défaut */}
    <FaqAccordion
      items={faqItems}
      heading="Questions fréquentes"
      intro="Huit réponses nettes, pas des slides, pas du jargon. Ce qu'on écrit par mail avant de se parler."
      background="paper-2"
      openFirst
    />

    {/* 09 — Notes de terrain ×3 · doctrine + maillage (1 CAS max : les dossiers vivent au-dessus) */}
    <EditorialPreview data={editorialPreviewData('fr', [0, 2, 3])} lang="fr" />

    <SectionTransition phrase="Lire aide à comprendre. Auditer permet de chiffrer." />

    {/* 10 — BookSession · climax ink · CTA principal vers /contact (Acte V) */}
    <BookSession />

  </div>

  {/* FooterMarquee · ruban éditorial animé pré-scrollprogress */}
  <FooterMarquee />

  <ScrollProgress />
  <script>
    import { initHomepageNarrative } from '../lib/animations/signature/homepage-narrative';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    function bootstrap() {
      // Kill anciens ScrollTriggers (evite leak + double-init apres ClientRouter)
      ScrollTrigger.getAll().forEach((t) => t.kill());
      initHomepageNarrative();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootstrap);
    } else {
      bootstrap();
    }
    document.addEventListener('astro:page-load', bootstrap);
  </script>
</Base>
