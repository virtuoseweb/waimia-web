---
// Page · /ressources · Hub landing Ressources
export const prerender = true;

// Source : waimia-handoff2 / ressources.html (450 LoC)
//
// Composition directe d'organismes existants : masthead + Featured tool +
// Cases + WritingNotes (blog) + Cookbooks + Newsletter band + CtaBand.

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Kicker from '../../components/ui/atoms/Kicker.astro';
import type { SectionByType } from '../../schemas/sections';
import CtaFinal from '../../components/sections/CtaFinal.astro';
import HeroCentered from '../../components/sections/HeroCentered.astro';
import Button from '../../components/ui/atoms/Button.astro';
import Bi from '../../components/ui/atoms/Bi.astro';
import EditorialSplitGrid from '../../components/sections/EditorialSplitGrid.astro';
import FeatureSplitMedia from '../../components/sections/FeatureSplitMedia.astro';
import ResourceCardGrid from '../../components/sections/ResourceCardGrid.astro';
import ArticleGrid from '../../components/sections/ArticleGrid.astro';
import MetricCalloutBand from '../../components/sections/MetricCalloutBand.astro';
import { langFromPath } from '../../lib/i18n';
import { isLegacyRoutedType } from '../../lib/blog-routing';
import { buildCollectionPage } from '../../lib/seo/schema-builder';
import { blogEntryHref } from '../../lib/blog-routing';

const lang = langFromPath(Astro.url.pathname);

const collectionLd = buildCollectionPage(
  'Ressources Waimia',
  'Hub éditorial : blog, cookbooks, livres blancs, veille IA, outils, cas clients.',
  ['Blog', 'Cookbooks', 'Livres blancs', 'Veille IA', 'Outils', 'Cas clients'],
);

const [allBlog, allCases, allCookbooks, allLivresBlancs] = await Promise.all([
  getCollection('blog'),
  getCollection('cases'),
  getCollection('cookbooks'),
  getCollection('livresBlancs'),
]);

const byDate = (
  a: { data: { publishedAt: Date } },
  b: { data: { publishedAt: Date } },
) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime();

const sortedBlog = [...allBlog].sort(byDate);
const sortedCases = [...allCases].sort(byDate);
const sortedCookbooks = [...allCookbooks].sort(byDate);
const sortedLivresBlancs = [...allLivresBlancs].sort(byDate);

// Ressource vedette : livre blanc le plus récent (asset le plus fort)
const _lb0 = sortedLivresBlancs[0];

// hrefs corrigés : /cas/{slug} (pas /ressources/cas/)
const caseCards = sortedCases.map((c, i) => ({
  num: String(i + 1).padStart(2, '0'),
  kicker: `CAS · ${c.data.sector_fr.toUpperCase()}`,
  title_fr: c.data.client,
  sub_fr: c.data.impact_fr,
  lead_fr: c.data.description_fr,
  href: `/cas/${c.id}`,
}));

const blogCards = sortedBlog.slice(0, 3).map((b, i) => ({
  kicker: `BLOG · ${String(i + 1).padStart(2, '0')}`,
  title_fr: b.data.title_fr,
  title_en: b.data.title_en,
  lead_fr: `${b.data.description_fr} →`,
  lead_en: `${b.data.description_en} →`,
  href: blogEntryHref(b),
}));

const livresBlancsCards = sortedLivresBlancs.map((lb, i) => ({
  kicker: `LIVRE BLANC · ${String(i + 1).padStart(2, '0')}`,
  title_fr: lb.data.title_fr,
  title_en: lb.data.title_en,
  lead_fr: `${lb.data.description_fr} →`,
  lead_en: `${lb.data.description_en} →`,
  href: `/ressources/livres-blancs/${lb.id}`,
}));

// ── Compteurs RÉELS par catégorie (0 invention) ──
const blogLongReads = sortedBlog.filter((b) => !isLegacyRoutedType(b));
const fieldNotes = sortedBlog.filter((b) => b.data.type === 'field-note');
const veilleIa = sortedBlog.filter((b) => b.data.type === 'veille-ia');
const nBlog = blogLongReads.length;
const nFieldNotes = fieldNotes.length;
const nVeille = veilleIa.length;
const nCookbooks = sortedCookbooks.length;
const nLivresBlancs = sortedLivresBlancs.length;
const allOutils = await getCollection('outils');
const nOutils = allOutils.length;

// ── FEATURED : la ressource la plus forte = livre blanc le plus récent (32 pages) ──
const featuredData = _lb0
  ? ({
      type: 'feature-split-media' as const,
      background: 'paper-2' as const,
      reversed: false,
      kicker_fr: '§ À la une · Livre blanc',
      kicker_en: '§ Featured · White paper',
      h2_fr: _lb0.data.title_fr,
      h2_en: _lb0.data.title_en,
      body_fr: _lb0.data.description_fr,
      body_en: _lb0.data.description_en,
      points: (_lb0.data.chapters_fr ?? []).slice(0, 4).map((c: string, i: number) => ({
        label_fr: c,
        label_en: (_lb0.data.chapters_en ?? [])[i] ?? c,
      })),
      media_caption_fr: `${_lb0.data.pages} pages · ${_lb0.data.format_fr ?? 'PDF'}`,
      media_caption_en: `${_lb0.data.pages} pages · ${_lb0.data.format_en ?? 'PDF'}`,
      cta_label_fr: 'Lire le livre blanc →',
      cta_label_en: 'Read the white paper →',
      cta_href: `/ressources/livres-blancs/${_lb0.id}`,
    } satisfies SectionByType<'feature-split-media'>)
  : null;

// ── GRILLE par TYPE · une card par catégorie NON VIDE, compteur réel ──
const categories = [
  nBlog > 0 && {
    kind_fr: 'Articles', kind_en: 'Articles',
    title_fr: 'Le blog', title_en: 'The blog',
    desc_fr: 'Essais, notes et avis. Publiés quand on a vraiment quelque chose à dire.',
    desc_en: 'Essays, notes and reviews. Published when we genuinely have something to say.',
    format: `${nBlog} ${nBlog > 1 ? 'articles' : 'article'}`,
    href: '/ressources/blog',
    cta_label_fr: 'Lire les articles', cta_label_en: 'Read the articles',
  },
  nLivresBlancs > 0 && {
    kind_fr: 'Livres blancs', kind_en: 'White papers',
    title_fr: 'Documents PDF', title_en: 'PDF documents',
    desc_fr: 'Téléchargeables, cités par nos clients en comité de direction.',
    desc_en: 'Downloadable, cited by our clients in board meetings.',
    format: `${nLivresBlancs} ${nLivresBlancs > 1 ? 'documents' : 'document'}`,
    href: '/ressources/livres-blancs',
    cta_label_fr: 'Télécharger', cta_label_en: 'Download', gated: true,
  },
  nCookbooks > 0 && {
    kind_fr: 'Cookbooks', kind_en: 'Cookbooks',
    title_fr: 'Recettes de méthode', title_en: 'Method recipes',
    desc_fr: 'Les protocoles qu\'on applique en mission, pas à pas.',
    desc_en: 'The protocols we apply on missions, step by step.',
    format: `${nCookbooks} ${nCookbooks > 1 ? 'recettes' : 'recette'}`,
    href: '/ressources/cookbooks',
    cta_label_fr: 'Suivre la recette', cta_label_en: 'Follow the recipe',
  },
  nOutils > 0 && {
    kind_fr: 'Outils', kind_en: 'Tools',
    title_fr: 'Calculateurs gratuits', title_en: 'Free calculators',
    desc_fr: 'ROI, TCO, conformité AI Act. Sans formulaire, sans funnel.',
    desc_en: 'ROI, TCO, AI Act compliance. No form, no funnel.',
    format: `${nOutils} ${nOutils > 1 ? 'outils' : 'outil'}`,
    href: '/ressources/outils',
    cta_label_fr: 'Utiliser l\'outil', cta_label_en: 'Use the tool',
  },
  nFieldNotes > 0 && {
    kind_fr: 'Notes de terrain', kind_en: 'Field notes',
    title_fr: 'Notes de terrain', title_en: 'Field notes',
    desc_fr: 'Observations courtes prises pendant les missions, sans filtre.',
    desc_en: 'Short observations taken during missions, unfiltered.',
    format: `${nFieldNotes} ${nFieldNotes > 1 ? 'notes' : 'note'}`,
    href: '/ressources/field-notes',
    cta_label_fr: 'Lire les notes', cta_label_en: 'Read the notes',
  },
  nVeille > 0 && {
    kind_fr: 'Veille IA', kind_en: 'AI watch',
    title_fr: 'Veille IA hebdo', title_en: 'Weekly AI watch',
    desc_fr: 'Synthèses signées Waimia. Ce qui compte, sans le bruit.',
    desc_en: 'Signed Waimia briefs. What matters, without the noise.',
    format: `${nVeille} ${nVeille > 1 ? 'éditions' : 'édition'}`,
    href: '/ressources/veille-ia',
    cta_label_fr: 'Lire la veille', cta_label_en: 'Read the watch',
  },
].filter(Boolean) as Array<{
  kind_fr: string; kind_en: string; title_fr: string; title_en: string;
  desc_fr: string; desc_en: string; format: string; href: string;
  cta_label_fr: string; cta_label_en: string; gated?: boolean;
}>;

const resourceGridData = {
  type: 'resource-card-grid' as const,
  background: 'paper' as const,
  columns: '3' as const,
  kicker_fr: '§ Par format · tout ce qu\'on publie',
  kicker_en: '§ By format · everything we publish',
  h2_fr: 'Choisissez votre <i>entrée</i>.',
  h2_en: 'Pick your <i>way in</i>.',
  intro_fr: 'Six formats, des compteurs réels. Rien d\'inventé : ce que vous voyez est ce qui existe.',
  intro_en: 'Six formats, real counters. Nothing invented: what you see is what exists.',
  resources: categories.map((c) => ({
    kind_fr: c.kind_fr, kind_en: c.kind_en,
    title_fr: c.title_fr, title_en: c.title_en,
    desc_fr: c.desc_fr, desc_en: c.desc_en,
    format: c.format, href: c.href,
    cta_label_fr: c.cta_label_fr, cta_label_en: c.cta_label_en,
    gated: c.gated ?? false,
  })),
} satisfies SectionByType<'resource-card-grid'>;

// ── ARTICLE VEDETTE · la note longue la plus récente, mise en avant distincte ──
const _featArticle = [...blogLongReads].sort(byDate)[0];
const featuredArticleData = _featArticle
  ? ({
      type: 'feature-split-media' as const,
      background: 'paper' as const,
      reversed: true,
      kicker_fr: `§ À la une · ${(_featArticle.data.editorialType ?? 'Essai')}`,
      kicker_en: `§ Featured · ${(_featArticle.data.editorialType ?? 'Essay')}`,
      h2_fr: _featArticle.data.title_fr,
      h2_en: _featArticle.data.title_en,
      body_fr: _featArticle.data.description_fr,
      body_en: _featArticle.data.description_en,
      points: [],
      media_caption_fr: `${_featArticle.data.readingTime ? `${_featArticle.data.readingTime} min de lecture · ` : ''}${_featArticle.data.publishedAt.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}`,
      media_caption_en: `${_featArticle.data.readingTime ? `${_featArticle.data.readingTime} min read · ` : ''}${_featArticle.data.publishedAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}`,
      cta_label_fr: 'Lire l\'article →',
      cta_label_en: 'Read the article →',
      cta_href: `/ressources/blog/${_featArticle.id}`,
    } satisfies SectionByType<'feature-split-media'>)
  : null;

// ── DERNIERS ARTICLES · vraie grille éditoriale (le reste des notes longues récentes) ──
const articleGridData = {
  type: 'article-grid' as const,
  background: 'paper-2' as const,
  columns: '3' as const,
  kicker_fr: '§ Blog · les plus récents',
  kicker_en: '§ Blog · most recent',
  h2_fr: 'Les <i>dernières</i> notes longues.',
  h2_en: 'The <i>latest</i> long reads.',
  articles: [...blogLongReads].sort(byDate).filter((b) => b.id !== _featArticle?.id).slice(0, 6).map((b) => ({
    tag_fr: (b.data.editorialType ?? 'Essai').toUpperCase(),
    tag_en: (b.data.editorialType ?? 'Essay').toUpperCase(),
    title_fr: b.data.title_fr,
    title_en: b.data.title_en,
    excerpt_fr: b.data.description_fr,
    excerpt_en: b.data.description_en,
    date: b.data.publishedAt.toISOString().slice(0, 10),
    read_time_fr: b.data.readingTime ? `${b.data.readingTime} min` : undefined,
    read_time_en: b.data.readingTime ? `${b.data.readingTime} min` : undefined,
    href: `/ressources/blog/${b.id}`,
  })),
} satisfies SectionByType<'article-grid'>;

// ── BANDE INK · preuve éditoriale chiffrée (compteurs réels du hub) ──
const proofBandData = {
  type: 'metric-callout-band' as const,
  background: 'ink' as const,
  kicker_fr: '§ Le fond éditorial',
  kicker_en: '§ The editorial substance',
  context_fr: 'Pas un blog d\'agence. Un fonds de travail signé, relu, daté. Chaque chiffre ci-dessous est le compte réel de ce qui est en ligne aujourd\'hui.',
  context_en: 'Not an agency blog. A signed, reviewed, dated body of work. Every figure below is the real count of what is online today.',
  metrics: [
    { value: String(nBlog + nFieldNotes + nVeille), label_fr: 'notes publiées', label_en: 'published notes' },
    { value: String(nLivresBlancs + nCookbooks), label_fr: 'documents de méthode', label_en: 'method documents' },
    { value: String(sortedCases.length), label_fr: 'cas clients signés', label_en: 'signed client cases' },
  ],
} satisfies SectionByType<'metric-callout-band'>;

const splitData = {
  type: 'editorial-split-grid' as const,
  left: {
    slot: 'left' as const,
    kicker_fr: '§ Blog · notes longues',
    kicker_en: '§ Blog · long reads',
    h2_fr: 'Une <i>note</i> à la fois.',
    h2_en: 'One <i>note</i> at a time.',
    lede_fr: 'Pas de calendrier éditorial. On publie quand on a vraiment quelque chose à dire.',
    lede_en: 'No editorial calendar. We publish when we genuinely have something to say.',
    cards: blogCards,
    cta: { label_fr: 'Tous les articles →', label_en: 'All articles →', href: '/ressources/blog', variant: 'ghost' as const },
  },
  right: {
    slot: 'right' as const,
    kicker_fr: '§ Livres blancs · documents PDF',
    kicker_en: '§ White papers · PDF documents',
    h2_fr: 'Un <i>document</i> par sujet.',
    h2_en: 'One <i>document</i> per topic.',
    lede_fr: 'Téléchargeable sans formulaire. Cité par nos clients en comité de direction.',
    lede_en: 'Downloadable without a form. Cited by our clients in board meetings.',
    cards: livresBlancsCards.slice(0, 3),
    cta: { label_fr: 'Tous les livres blancs →', label_en: 'All white papers →', href: '/ressources/livres-blancs', variant: 'ghost' as const },
  },
} satisfies SectionByType<'editorial-split-grid'>;

const mastheadData = {
  type: 'hero-hub-masthead' as const,
  variant: 'hub' as const,
  decoration: false,
  align: 'left' as const,
  kicker_fr: '§ Hub · Ressources',
  kicker_en: '§ Hub · Resources',
  h1_fr: 'Tout ce qu\'on <i>publie</i>.',
  h1_en: 'Everything we <i>publish</i>.',
  lede_fr: 'Cas mesurables, notes de terrain, cookbooks de méthodes, calculateurs gratuits. Pas de pensum SEO. Tout est relu, signé, et NDA-protected quand pertinent.',
  lede_en: 'Measurable cases, field notes, method cookbooks, free calculators. No SEO padding. Everything is reviewed, signed, and NDA-protected when relevant.',
} satisfies SectionByType<'hero-hub-masthead'>;

const ctaData = {
  type: 'cta-final' as const,
  h2_fr: 'Prêt à livrer un <em>agent</em>,<br />pas un slide deck ?',
  h2_en: 'Ready to ship an <em>agent</em>,<br />not a slide deck?',
  body_fr: 'Audit IA en 5 jours. Premier agent en production en 4 semaines. ROI mesuré, jamais estimé.',
  body_en: 'AI audit in 5 days. First agent in production in 4 weeks. Measured ROI, never estimated.',
  cta_primary: { label_fr: 'Réserver un audit →', label_en: 'Book an audit →', href: '/contact', variant: 'primary' as const },
  cta_secondary: { label_fr: 'Voir la pyramide →', label_en: 'See the pyramid →', href: '/offres', variant: 'ghost' as const },
  background: 'paper' as const,
} satisfies SectionByType<'cta-final'>;
---
<Base
  title="Ressources · Cas, blog, cookbooks, outils · Waimia"
  description="Toutes les ressources Waimia : cas clients NDA-protected, notes de terrain, cookbooks de méthodes, calculateurs TCO/ROI/AI Act."
  jsonLd={collectionLd}
>
  {/* MASTHEAD · paper */}
  <HeroCentered data={mastheadData} lang="fr" />

  {/* FEATURED · livre blanc le plus fort · paper-2 */}
  {featuredData && <FeatureSplitMedia data={featuredData} lang="fr" />}

  {/* GRILLE PAR FORMAT · compteurs réels · paper */}
  <ResourceCardGrid data={resourceGridData} lang="fr" />

  {/* ARTICLE VEDETTE · note longue la plus récente · paper */}
  {featuredArticleData && <FeatureSplitMedia data={featuredArticleData} lang="fr" />}

  {/* DERNIERS ARTICLES · vraie grille éditoriale · paper-2 */}
  <ArticleGrid data={articleGridData} lang="fr" />

  {/* BANDE INK · preuve éditoriale chiffrée */}
  <MetricCalloutBand data={proofBandData} lang="fr" />

  {/* CAS CLIENTS · 4 dossiers signés · paper */}
  <section class="hub-cases-detail">
    <div class="wrap-wide">
      <Kicker tone="accent" class="hub-cd-k">§ Cas clients · {sortedCases.length} dossiers signés</Kicker>
      <h2 class="hub-cd-h2">{caseCards.length === 4 ? 'Quatre' : String(caseCards.length)} <i>missions</i>. Toutes mesurées.</h2>
      <p class="hub-cd-lead">
        Pas de témoignages publicitaires : chaque cas est lu, validé et signé par le client. Des clients externes, des dossiers chiffrés.
      </p>
      <ol class="hub-cd-list reveal-stagger">
        {caseCards.map((c) => (
          <li class="hub-cd-row">
            <a class="hub-cd-link" href={c.href}>
              <span class="hub-cd-num">{c.num}</span>
              <span class="hub-cd-body">
                <span class="hub-cd-kicker">{c.kicker}</span>
                <span class="hub-cd-title">{c.title_fr} <i>· {c.sub_fr}</i></span>
                <span class="hub-cd-text">{c.lead_fr}</span>
              </span>
              <span class="hub-cd-arr" aria-hidden>→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* BLOG + LIVRES BLANCS · split éditorial vers pages détaillées · paper */}
  <EditorialSplitGrid data={splitData} lang="fr" />

  {/* NEWSLETTER BAND · ink */}
  <section id="newsletter" class="hub-nl">
    <div class="wrap-wide hub-nl-wrap">
      <div>
        <Kicker tone="accent" class="hub-nl-k">§ Newsletter · une fois par mois</Kicker>
        <h2 class="hub-nl-h2">Un <i>essai</i> par mois. Jamais de promotion.</h2>
        <p class="hub-nl-lead">
          Notes longues, cas concrets, recettes pratiques. Désabonnement en 1 clic, RGPD-compliant.
        </p>
      </div>
      <form class="hub-nl-form" method="POST" action="/api/newsletter" data-newsletter-form novalidate>
        <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;overflow:hidden">
          <label for="nl-hp">Ne pas remplir</label>
          <input type="text" id="nl-hp" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="lang" value={lang} />
        <label for="nl-email" class="sr-only">Email professionnel</label>
        <input id="nl-email" name="email" type="email" required placeholder="prénom@entreprise.com" autocomplete="email" aria-describedby="nl-hint" />
        <Button as="button" type="submit" variant="primary" size="md">S'abonner →</Button>
        <p class="form-error-global" role="alert" aria-live="assertive" hidden data-newsletter-error></p>
      </form>
      <p class="nl-hint" id="nl-hint">
        <Bi fr="Sans spam · Désinscription en 1 clic" en="No spam · Unsubscribe anytime" />
        {' · '}
        <a href="/agence/trust-center">
          <Bi fr="Politique de confidentialité" en="Privacy policy" />
        </a>
      </p>
    </div>
  </section>

  <CtaFinal data={ctaData} lang="fr" />
</Base>

<style>
  .hub-cases-detail { padding: clamp(80px, 10vw, 120px) var(--space-6); background: var(--paper); }
  :global(.hub-cd-k) { display: block; margin-bottom: 18px; }
  .hub-cd-h2 {
    font-family: var(--font-display);
    font-size: clamp(40px, 6vw, 88px);
    line-height: var(--leading-h1);
    letter-spacing: -0.024em;
    margin: 0 0 var(--space-5);
    text-wrap: balance;
    font-weight: var(--fw-regular);
  }
  .hub-cd-h2 :global(i) { font-style: italic; color: var(--accent); }
  .hub-cd-lead {
    font-family: var(--font-sans);
    font-size: clamp(17px, 1.8vw, 22px);
    color: var(--muted);
    max-width: 760px;
    margin: 0 0 clamp(40px, 5vw, 64px);
    line-height: 1.45;
  }
  .hub-cd-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--ink);
  }
  .hub-cd-row { border-bottom: 1px solid var(--hairline); }
  .hub-cd-link {
    display: grid;
    grid-template-columns: 80px 1fr 60px;
    gap: clamp(20px, 3vw, 40px);
    padding: clamp(24px, 2.5vw, 36px) 0;
    align-items: start;
    color: inherit;
    transition: background 240ms var(--ease);
  }
  .hub-cd-link:hover { background: rgba(var(--ink-rgb), 0.02); }
  .hub-cd-num {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.5vw, 64px);
    line-height: 0.9;
    color: var(--accent);
    font-style: italic;
  }
  .hub-cd-body { display: flex; flex-direction: column; gap: 6px; }
  .hub-cd-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    color: var(--accent);
    letter-spacing: 0.14em;
  }
  .hub-cd-title {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.6vw, 36px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: var(--fw-regular);
    text-wrap: balance;
  }
  .hub-cd-title :global(i) { font-style: italic; color: var(--muted); font-size: 0.7em; }
  .hub-cd-text {
    font-size: clamp(13px, 1.3vw, 15px);
    line-height: 1.55;
    color: var(--muted);
    max-width: var(--wrap-prose);
    text-wrap: pretty;
  }
  .hub-cd-arr {
    font-family: var(--font-mono);
    font-size: 24px;
    color: var(--accent);
    align-self: center;
    text-align: right;
  }
  @media (max-width: 700px) {
    .hub-cd-link { grid-template-columns: 48px 1fr; }
    .hub-cd-arr { display: none; }
  }

  .hub-nl { padding: clamp(80px, 10vw, 120px) var(--space-6); background: var(--ink); color: var(--paper); }
  .hub-nl-wrap { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(40px, 6vw, 80px); align-items: center; }
  :global(.hub-nl-k) { display: block; margin-bottom: 18px; }
  .hub-nl-h2 {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 72px);
    line-height: 1;
    letter-spacing: -0.024em;
    color: var(--paper);
    margin: 0 0 18px;
    text-wrap: balance;
    font-weight: var(--fw-regular);
  }
  .hub-nl-h2 :global(i) { font-style: italic; color: var(--accent); }
  .hub-nl-lead {
    font-size: var(--text-body-lead);
    line-height: 1.55;
    color: rgba(var(--paper-rgb), 0.7);
    max-width: 520px;
    margin: 0;
  }
  .hub-nl-form {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .hub-nl-form input {
    flex: 1;
    min-width: 240px;
    padding: 14px 18px;
    background: rgba(var(--paper-rgb), 0.08);
    border: 1px solid rgba(var(--paper-rgb), 0.2);
    border-radius: var(--radius-xs);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: var(--text-body-base);
  }
  .hub-nl-form input:focus { outline: none; border-color: var(--accent); }
  .nl-hint {
    font-size: var(--text-ui);
    color: rgba(var(--paper-rgb), 0.5);
    margin: 10px 0 0;
    line-height: var(--leading-body);
  }
  .nl-hint a { color: rgba(var(--paper-rgb), 0.7); text-decoration: underline; }
  .nl-hint a:hover { color: var(--paper); }
  .hub-nl-form .form-error-global {
    flex-basis: 100%;
    color: var(--accent);
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    margin: 0;
  }

  @media (max-width: 800px) {
    .hub-nl-wrap { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
(function () {
  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function bindForm(form) {
    if (form.dataset.nlBound) return;
    form.dataset.nlBound = '1';

    var langInput = form.querySelector('input[name="lang"]');
    var lang = langInput ? langInput.value : 'fr';
    var emailInput = form.querySelector('input[name="email"]');
    var errorEl = form.querySelector('[data-newsletter-error]');
    var btn = form.querySelector('button[type="submit"]');

    function showError(msg) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.removeAttribute('hidden');
    }
    function clearError() {
      if (!errorEl) return;
      errorEl.setAttribute('hidden', '');
      errorEl.textContent = '';
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      clearError();

      var email = emailInput ? emailInput.value.trim() : '';
      if (!email || !EMAIL_RE.test(email)) {
        showError(lang === 'fr' ? 'Adresse email invalide.' : 'Invalid email address.');
        if (emailInput) emailInput.focus();
        return;
      }

      if (btn) btn.disabled = true;

      var payload = Object.fromEntries(new FormData(form).entries());

      try {
        var res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        var data = await res.json();
        if (data.ok) {
          document.cookie = 'waimia_newsletter_signed=true; path=/; max-age=31536000; SameSite=Lax';
          if (data.redirect) {
            window.location.href = data.redirect;
          }
        } else {
          showError(data.error || (lang === 'fr' ? 'Erreur, veuillez réessayer.' : 'Error, please try again.'));
          if (btn) btn.disabled = false;
        }
      } catch (_) {
        showError(lang === 'fr' ? 'Erreur réseau, veuillez réessayer.' : 'Network error, please try again.');
        if (btn) btn.disabled = false;
      }
    });
  }

  document.querySelectorAll('form[data-newsletter-form]').forEach(bindForm);
  document.addEventListener('astro:page-load', function () {
    document.querySelectorAll('form[data-newsletter-form]').forEach(function (form) {
      delete form.dataset.nlBound;
      bindForm(form);
    });
  });
})();
</script>
