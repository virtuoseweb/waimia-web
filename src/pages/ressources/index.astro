---
import FormGuard from '../../components/ui/atoms/FormGuard.astro';
// Page · /ressources · INDEX UNIFIÉ des ressources (refonte 2026-10-06).
export const prerender = true;

// Demande Simon : une page qui, comme /blog, affiche TOUS les guides, comparatifs, outils et
// articles, avec un filtre par type, et vers laquelle le menu renvoie (« Tout voir »).
//
// Composition : en-tête `list-index-section` (filtres en slot, compteurs réels) + liste
// chronologique en `article-grid` (sections cataloguées, aucune nouvelle section). Le schéma
// d'`article-grid` borne une grille à 12 cartes : la liste est découpée en grilles
// successives de 12, dans l'ordre des dates, puis fondue en une seule grille par le CSS.
//
// Filtre par type SANS JavaScript : chaque bouton pointe une ancre (#type-guides…) ; la règle
// CSS `:has(:target)` masque les cartes dont l'href n'est pas sous le préfixe du type
// (RESOURCE_KINDS). Toutes les cartes restent dans le HTML (indexables, aucun doublon).
// Les hubs /ressources/guides, /comparatifs et /outils restent les pages de chaque type.

import { getCollection, getEntry } from 'astro:content';
import { getLiveCollection } from '../../lib/live-collection';
import Base from '../../layouts/Base.astro';
import Kicker from '../../components/ui/atoms/Kicker.astro';
import type { SectionByType } from '@waimia/ds-kernel';
import CtaFinal from '../../components/sections/CtaFinal.astro';
import Button from '../../components/ui/atoms/Button.astro';
import Bi from '../../components/ui/atoms/Bi.astro';
import ListIndexSection from '../../components/sections/ListIndexSection.astro';
import ArticleGrid from '../../components/sections/ArticleGrid.astro';
import { langFromPath } from '../../lib/i18n';
import { buildCollectionPage } from '../../lib/seo/schema-builder';
import { blogEntryHref } from '../../lib/blog-routing';
import { isIndexableEntry } from '../../lib/seo/hub-index';
import { SITE } from '../../site.config';
import { indexHeadData, ctaData, RESOURCE_KINDS, type ResourceKind } from '../../data/ressources-hub-sections';

const lang = langFromPath(Astro.url.pathname);
const isFr = lang === 'fr';

type Item = {
  kind: ResourceKind;
  title_fr: string;
  title_en: string;
  excerpt_fr: string;
  excerpt_en: string;
  date: Date;
  read_time?: string;
  href: string;
};

// Titre court : la partie avant « · » (même règle que les hubs guides et comparatifs).
const shortTitle = (full: string) => full.split(' · ')[0].trim();

const [guides, comparatifs, outils, blog, maturite] = await Promise.all([
  getCollection('guides'),
  getLiveCollection('comparatifs'),
  getCollection('outils'),
  getLiveCollection('blog'),
  getEntry('diagnostics', 'maturite-ia'),
]);

const items: Item[] = [
  ...guides.filter(isIndexableEntry).map((e) => ({
    kind: 'guides' as const,
    title_fr: shortTitle(e.data.title_fr),
    title_en: shortTitle(e.data.title_en),
    excerpt_fr: e.data.description_fr,
    excerpt_en: e.data.description_en,
    date: e.data.publishedAt,
    href: `/ressources/guides/${e.data.slug ?? e.id}`,
  })),
  ...comparatifs.filter(isIndexableEntry).map((e) => ({
    kind: 'comparatifs' as const,
    title_fr: shortTitle(e.data.title_fr),
    title_en: shortTitle(e.data.title_en),
    excerpt_fr: e.data.description_fr,
    excerpt_en: e.data.description_en,
    date: e.data.publishedAt,
    href: `/ressources/comparatifs/${e.data.slug ?? e.id}`,
  })),
  ...outils.filter((e) => !e.data.seo?.noindex).map((e) => ({
    kind: 'outils' as const,
    title_fr: shortTitle(e.data.title_fr),
    title_en: shortTitle(e.data.title_en),
    excerpt_fr: e.data.description_fr,
    excerpt_en: e.data.description_en,
    date: e.data.publishedAt,
    href: `/ressources/outils/${e.id}`,
  })),
  ...(maturite
    ? [{
        kind: 'outils' as const,
        title_fr: shortTitle(maturite.data.title_fr),
        title_en: shortTitle(maturite.data.title_en),
        excerpt_fr: maturite.data.description_fr,
        excerpt_en: maturite.data.description_en,
        date: new Date(maturite.data.publishedAt),
        href: '/ressources/diagnostics/maturite-ia',
      }]
    : []),
  // Articles : même périmètre que /blog (les articles en noindex ne sont pas listés).
  ...blog.filter((e) => !e.data.seo?.noindex).map((e) => ({
    kind: 'articles' as const,
    title_fr: e.data.title_fr,
    title_en: e.data.title_en,
    excerpt_fr: e.data.excerpt_fr ?? e.data.description_fr,
    excerpt_en: e.data.excerpt_en ?? e.data.description_en,
    date: e.data.publishedAt,
    read_time: e.data.readingTime ? `${e.data.readingTime} min` : undefined,
    href: blogEntryHref(e),
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime() || a.title_fr.localeCompare(b.title_fr, 'fr'));

const count = (k: ResourceKind) => items.filter((i) => i.kind === k).length;
const kindOf = (k: ResourceKind) => RESOURCE_KINDS.find((r) => r.key === k)!;
const fmtDate = (d: Date) =>
  `${String(d.getDate()).padStart(2, '0')}.${String(d.getMonth() + 1).padStart(2, '0')}.${d.getFullYear()}`;

// Grilles successives de 12 cartes (borne du schéma article-grid), ordre chronologique conservé.
const GRID_MAX = 12;
const grids: SectionByType<'article-grid'>[] = [];
for (let i = 0; i < items.length; i += GRID_MAX) {
  grids.push({
    type: 'article-grid',
    background: 'paper',
    columns: '3',
    articles: items.slice(i, i + GRID_MAX).map((it) => ({
      tag_fr: kindOf(it.kind).tag_fr,
      tag_en: kindOf(it.kind).tag_en,
      title_fr: it.title_fr,
      title_en: it.title_en,
      excerpt_fr: it.excerpt_fr,
      excerpt_en: it.excerpt_en,
      date: fmtDate(it.date),
      read_time_fr: it.read_time,
      read_time_en: it.read_time,
      href: it.href,
    })),
  });
}

const filters = [
  { id: 'type-tout', label: isFr ? 'Tous' : 'All', n: items.length },
  ...RESOURCE_KINDS.map((k) => ({ id: `type-${k.key}`, label: isFr ? k.label_fr : k.label_en, n: count(k.key) })),
].filter((f) => f.n > 0);

const collectionLd = buildCollectionPage(
  'Ressources IA pour PME · Waimia',
  'Index de toutes les ressources Waimia : guides, comparatifs, outils gratuits et articles, triés par date.',
  items.map((i) => `${SITE.url}${i.href}`),
);
---
<Base
  title="Ressources IA pour PME : guides, outils, comparatifs · Waimia"
  description="Toutes les ressources IA pour PME en une page : guides pratiques, comparatifs, outils gratuits et articles, triés par date et filtrables par type."
  jsonLd={collectionLd}
>
  <div class="res-index">
    <ListIndexSection data={indexHeadData} lang={lang}>
      <Fragment slot="filters">
        <nav class="res-filters" aria-label={isFr ? 'Filtrer par type' : 'Filter by type'}>
          {filters.map((f) => (
            <a class="res-chip" href={`#${f.id}`}>
              {f.label} <span class="res-chip-n">{f.n}</span>
            </a>
          ))}
        </nav>
      </Fragment>
      <Fragment slot="list">
        {/* Ancres de filtre : cibles :target, placées en tête de liste (le saut d'ancre
            amène le lecteur sur la liste filtrée). */}
        {filters.map((f) => <span class="res-anchor" id={f.id} aria-hidden="true"></span>)}
        <h2 class="sr-only">{isFr ? 'Toutes les ressources, de la plus récente à la plus ancienne' : 'All resources, newest first'}</h2>
        <div class="res-list">
          {grids.map((g) => <ArticleGrid data={g} lang={lang} />)}
        </div>
      </Fragment>
    </ListIndexSection>
  </div>

  {/* NEWSLETTER BAND · ink (ancre #newsletter liée depuis /blog) */}
  <section id="newsletter" class="hub-nl">
    <div class="wrap-wide hub-nl-wrap">
      <div>
        <Kicker tone="accent" class="hub-nl-k">§ Newsletter · une fois par mois</Kicker>
        <h2 class="hub-nl-h2">Un essai par mois. Jamais de promotion.</h2>
        <p class="hub-nl-lead">
          Notes longues, cas concrets, recettes pratiques. Désabonnement en 1 clic, RGPD-compliant.
        </p>
      </div>
      <form class="hub-nl-form" method="POST" action="/api/newsletter" data-newsletter-form novalidate>
        <FormGuard />
        <input type="hidden" name="lang" value={lang} />
        <label for="nl-email" class="sr-only">Email professionnel</label>
        <input id="nl-email" name="email" type="email" required placeholder="prénom@entreprise.com" autocomplete="email" aria-describedby="nl-hint" />
        <Button as="button" type="submit" variant="primary" size="md">S'abonner →</Button>
        <p class="form-error-global" role="alert" aria-live="assertive" hidden data-newsletter-error></p>
      </form>
      <p class="nl-hint" id="nl-hint">
        <Bi fr="Sans spam · Désinscription en 1 clic" en="No spam · Unsubscribe anytime" />
        {' · '}
        <a href="/politique-confidentialite">
          <Bi fr="Politique de confidentialité" en="Privacy policy" />
        </a>
      </p>
    </div>
  </section>

  <CtaFinal data={ctaData} lang={lang} />
</Base>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  /* ── Filtres · pastilles (tokens DS existants, aucun token neuf) ── */
  .res-filters { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .res-chip {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--ink);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .res-chip:hover { border-color: var(--ink); }
  .res-chip:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 2px; }
  .res-chip-n { font-family: var(--font-mono); color: var(--muted); }

  /* Pastille active : « Tous » par défaut, sinon celle dont l'ancre est ciblée. */
  .res-index:not(:has(.res-anchor:target)) .res-chip[href='#type-tout'],
  .res-index:has(#type-tout:target) .res-chip[href='#type-tout'],
  .res-index:has(#type-guides:target) .res-chip[href='#type-guides'],
  .res-index:has(#type-comparatifs:target) .res-chip[href='#type-comparatifs'],
  .res-index:has(#type-outils:target) .res-chip[href='#type-outils'],
  .res-index:has(#type-articles:target) .res-chip[href='#type-articles'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .res-index:not(:has(.res-anchor:target)) .res-chip[href='#type-tout'] .res-chip-n,
  .res-index:has(#type-tout:target) .res-chip[href='#type-tout'] .res-chip-n,
  .res-index:has(#type-guides:target) .res-chip[href='#type-guides'] .res-chip-n,
  .res-index:has(#type-comparatifs:target) .res-chip[href='#type-comparatifs'] .res-chip-n,
  .res-index:has(#type-outils:target) .res-chip[href='#type-outils'] .res-chip-n,
  .res-index:has(#type-articles:target) .res-chip[href='#type-articles'] .res-chip-n { color: inherit; }

  /* Ancres : la cible de saut tient compte de l'en-tête fixe. */
  .res-anchor { display: block; scroll-margin-top: 96px; }

  /* Grilles successives fondues en UNE grille : les sections article-grid (12 cartes au plus
     chacune) et leurs conteneurs passent en `display: contents`, les cartes deviennent les
     enfants directs de .res-list. Un filtre ne laisse donc pas de trous entre les grilles.
     Mêmes colonnes et points de rupture que le composant (3 / 2 / 1). */
  .res-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-top: calc(-1 * var(--space-7));
  }
  .res-list :global(.article-grid),
  .res-list :global(.article-grid > .wrap-wide),
  .res-list :global(.article-grid__list) { display: contents; }
  @media (max-width: 980px) { .res-list { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 768px) { .res-list { margin-top: calc(-1 * var(--space-5)); } }
  @media (max-width: 640px) { .res-list { grid-template-columns: 1fr; } }

  /* ── Filtre par type (CSS seul) : masque les cartes hors du préfixe ciblé ── */
  .res-index:has(#type-guides:target) .res-list :global(.article-card:not([href^='/ressources/guides/'])),
  .res-index:has(#type-comparatifs:target) .res-list :global(.article-card:not([href^='/ressources/comparatifs/'])),
  .res-index:has(#type-outils:target) .res-list :global(.article-card:not([href^='/ressources/outils/']):not([href^='/ressources/diagnostics/'])),
  .res-index:has(#type-articles:target) .res-list :global(.article-card:is([href^='/ressources/guides/'], [href^='/ressources/comparatifs/'], [href^='/ressources/outils/'], [href^='/ressources/diagnostics/'])) {
    display: none;
  }

  .hub-nl { padding: var(--space-12) var(--space-6); background: var(--ink); color: var(--paper); }
  .hub-nl-wrap { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-10); align-items: center; }
  :global(.hub-nl-k) { display: block; margin-bottom: 18px; }
  .hub-nl-h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    line-height: 1;
    letter-spacing: -0.024em;
    color: var(--paper);
    margin: 0 0 18px;
    text-wrap: balance;
    font-weight: var(--fw-semibold);
  }
  .hub-nl-h2 :global(i) { font-style: italic; color: var(--accent-text); }
  .hub-nl-lead {
    font-size: var(--text-body);
    line-height: 1.55;
    color: rgba(var(--paper-rgb), 0.7);
    max-width: 520px;
    margin: 0;
  }
  .hub-nl-form {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .hub-nl-form input {
    flex: 1;
    min-width: 240px;
    padding: 14px 18px;
    background: rgba(var(--paper-rgb), 0.08);
    border: 1px solid rgba(var(--paper-rgb), 0.2);
    border-radius: var(--radius-xs);
    color: var(--paper);
    font-family: var(--font-sans);
    font-size: var(--text-body);
  }
  .hub-nl-form input:focus { outline: none; border-color: var(--accent-text); }
  .hub-nl-form input:focus-visible { outline: 2px solid var(--paper); outline-offset: 2px; border-color: var(--accent-text); }
  .nl-hint {
    font-size: var(--text-small);
    color: rgba(var(--paper-rgb), 0.5);
    margin: 10px 0 0;
    line-height: var(--leading-body);
  }
  .nl-hint a { color: rgba(var(--paper-rgb), 0.7); text-decoration: underline; }
  .nl-hint a:hover { color: var(--paper); }
  .hub-nl-form .form-error-global {
    flex-basis: 100%;
    color: var(--accent-text);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    margin: 0;
  }

  @media (max-width: 800px) {
    .hub-nl-wrap { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
(function () {
  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function bindForm(form) {
    if (form.dataset.nlBound) return;
    form.dataset.nlBound = '1';

    var langInput = form.querySelector('input[name="lang"]');
    var lang = langInput ? langInput.value : 'fr';
    var emailInput = form.querySelector('input[name="email"]');
    var errorEl = form.querySelector('[data-newsletter-error]');
    var btn = form.querySelector('button[type="submit"]');

    function showError(msg) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.removeAttribute('hidden');
    }
    function clearError() {
      if (!errorEl) return;
      errorEl.setAttribute('hidden', '');
      errorEl.textContent = '';
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      clearError();

      var email = emailInput ? emailInput.value.trim() : '';
      if (!email || !EMAIL_RE.test(email)) {
        showError(lang === 'fr' ? 'Adresse email invalide.' : 'Invalid email address.');
        if (emailInput) emailInput.focus();
        return;
      }

      if (btn) btn.disabled = true;

      var payload = Object.fromEntries(new FormData(form).entries());

      try {
        var res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        var data = await res.json();
        if (data.ok) {
          document.cookie = 'waimia_newsletter_signed=true; path=/; max-age=31536000; SameSite=Lax';
          if (data.redirect) {
            window.location.href = data.redirect;
          }
        } else {
          showError(data.error || (lang === 'fr' ? 'Erreur, veuillez réessayer.' : 'Error, please try again.'));
          if (btn) btn.disabled = false;
        }
      } catch (_) {
        showError(lang === 'fr' ? 'Erreur réseau, veuillez réessayer.' : 'Network error, please try again.');
        if (btn) btn.disabled = false;
      }
    });
  }

  document.querySelectorAll('form[data-newsletter-form]').forEach(bindForm);
  document.addEventListener('astro:page-load', function () {
    document.querySelectorAll('form[data-newsletter-form]').forEach(function (form) {
      delete form.dataset.nlBound;
      bindForm(form);
    });
  });
})();
</script>
