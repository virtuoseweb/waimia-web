---
// Page · /ressources · INDEX UNIFIÉ des ressources (refonte 2026-10-06, vues filtrées 2026-10-11).
export const prerender = true;

// Une page qui, comme /blog, affiche TOUS les guides, comparatifs, outils et articles.
// Le corps (en-tête, pastilles, liste, newsletter, CTA) est le composant partagé
// ResourcesHub, aussi rendu par /ressources/outils, /ressources/comparatifs et
// /ressources/guides (vues filtrées côté serveur, une URL indexable chacune). Items :
// src/lib/resources-hub.ts.
import Base from '../../layouts/Base.astro';
import ResourcesHub from '../../components/ui/organisms/ResourcesHub.astro';
import { SITE } from '../../site.config';
import { buildCollectionPage } from '../../lib/seo/schema-builder';
import { getResourceItems } from '../../lib/resources-hub';
import { RESOURCE_VIEWS } from '../../data/ressources-hub-sections';
import { langFromPath } from '../../lib/i18n';

const lang = langFromPath(Astro.url.pathname);
const isFr = lang === 'fr';
const v = RESOURCE_VIEWS.all;
const items = await getResourceItems();

const collectionLd = buildCollectionPage(
  isFr ? v.collection_name_fr : v.collection_name_en,
  isFr ? v.collection_desc_fr : v.collection_desc_en,
  items.map((i) => `${SITE.url}${i.href}`),
);
---
<Base
  title={isFr ? v.title_fr : v.title_en}
  description={isFr ? v.description_fr : v.description_en}
  jsonLd={collectionLd}
>
  <ResourcesHub items={items} />
</Base>
