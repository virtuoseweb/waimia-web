---
// Hub /ressources/veille-ia · synthèses hebdomadaires · listing réel des briefs veille
export const prerender = true;

import { getCollection } from 'astro:content';
import UtilityTemplate from '../../../components/templates/UtilityTemplate.astro';
import EditorialWriteRow from '../../../components/ui/molecules/EditorialWriteRow.astro';
import Button from '../../../components/ui/atoms/Button.astro';

// La veille est alimentée par la collection blog filtrée type === 'veille-ia'
// (post-fusion R1, cf src/lib/blog-routing.ts). URLs : /ressources/veille-ia/<slug>.
const allBlog = await getCollection('blog');
const veille = allBlog
  .filter((entry) => entry.data.type === 'veille-ia' && !entry.data.seo?.noindex)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const formatDate = (d: Date) => {
  const dd = String(d.getDate()).padStart(2, '0');
  const mm = String(d.getMonth() + 1).padStart(2, '0');
  return `${dd}.${mm}`;
};
---
<UtilityTemplate
  variant="list"
  title="Veille IA · synthèses hebdomadaires · Waimia"
  description="Veille IA signée Waimia : ce qui compte pour les PME chaque semaine. Sans bruit, sans hype, sans rappel commercial."
  kicker={`§ Veille IA · ${veille.length} ${veille.length > 1 ? 'synthèses' : 'synthèse'}`}
>
  <Fragment slot="headline">
    Ce qui <i>compte</i>. Pas ce qui <i>buzz</i>.
  </Fragment>
  <Fragment slot="lede">
    Une lecture par semaine. Cinq minutes. Trois faits, une analyse, une action concrète à tester chez vous.
  </Fragment>

  <Fragment slot="list">
    <div class="vi-list">
      {veille.map((entry) => (
        <EditorialWriteRow
          date={formatDate(entry.data.publishedAt)}
          tag="VEILLE"
          href={`/ressources/veille-ia/${entry.id}`}
          tone="paper"
        >
          {entry.data.title_fr}
        </EditorialWriteRow>
      ))}
    </div>

    {veille.length < 3 && (
      <div class="vi-soon">
        <p class="vi-soon-kicker">§ Premières synthèses publiées</p>
        <p class="vi-soon-text">
          La veille hebdomadaire Waimia démarre. La prochaine synthèse arrive bientôt :
          une vraie analyse écrite, sans SaaS Notion partagé ni Twitter recyclé, pour les PME
          qui n'ont pas le temps de tout suivre. En attendant la cadence pleine, creusez un sujet
          en profondeur avec nos essais et cookbooks.
        </p>
        <p class="vi-soon-cadence">Cadence cible · une synthèse par semaine, le mardi.</p>
        <div class="vi-cta-row">
          <Button href="/ressources/blog" variant="primary" size="md">Lire le blog →</Button>
          <Button href="/ressources/cookbooks" variant="ghost" size="md">Voir les cookbooks →</Button>
        </div>
      </div>
    )}
  </Fragment>
</UtilityTemplate>

<style>
  .vi-list { max-width: 1100px; }
  .vi-soon {
    max-width: var(--wrap-prose);
    margin-top: var(--space-7);
    margin-inline: auto;
    padding-top: var(--space-6);
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .vi-soon-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0 0 var(--space-3);
  }
  .vi-soon-text {
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0;
    text-wrap: pretty;
  }
  .vi-soon-cadence {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
    margin: var(--space-4) 0 0;
  }
  .vi-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    justify-content: center;
    margin-top: var(--space-6);
  }
  @media (max-width: 560px) {
    .vi-cta-row {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
  }
</style>
