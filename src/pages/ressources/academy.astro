---
// Page · /ressources/academy · Diagnostic IA gratuit (form interactif)
export const prerender = true;

import UtilityTemplate from '../../components/templates/UtilityTemplate.astro';
import Button from '../../components/ui/atoms/Button.astro';
import Kicker from '../../components/ui/atoms/Kicker.astro';

// JSON-LD WebApplication · décrit le diagnostic interactif (formulaire noté 6 questions →
// scorecard email) comme une web-app gratuite, pour la lisibilité moteur/GEO.
const academyLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Diagnostic IA gratuit · Waimia Academy',
  url: 'https://waimia.com/ressources/academy',
  description: 'Diagnostic IA en 6 questions pour PME : un scorecard personnalisé envoyé par email, relu par un humain, avec trois actions priorisées.',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  inLanguage: 'fr',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  provider: { '@type': 'Organization', name: 'Waimia', url: 'https://waimia.com' },
};
---
<UtilityTemplate
  title="Diagnostic IA gratuit entreprise · scorecard personnalisé · Waimia Academy"
  description="Diagnostic IA gratuit en 6 questions. Vous recevez par email un scorecard personnalisé, 3 actions priorisées et une relecture humaine. Pas de rappel commercial."
  kicker="§ Academy · Diagnostic accompagné · Scorecard par email"
  jsonLd={academyLd}
  align="centered"
  headlineFr="Diagnostic IA gratuit, scorecard personnalisé."
  headlineEn="Free AI diagnostic, personalized scorecard."
  ledeFr="6 questions sur vos données, vos agents et votre conformité. On vous renvoie un scorecard personnalisé : vos points forts, vos lacunes, 3 actions priorisées. Relu par un humain, pas par un algorithme. Pas de rappel commercial."
  ledeEn="6 questions on your data, your agents and your compliance. We send back a personalized scorecard: your strengths, your gaps, 3 prioritized actions. Reviewed by a human, not an algorithm. No sales follow-up."
>
  <Fragment slot="body">
    <p class="acad-intro">Le diagnostic IA gratuit de la Waimia Academy mesure trois choses qui décident de la réussite d'un projet IA : l'état de vos <strong>données</strong>, la fiabilité de vos <strong>agents en production</strong> et votre <strong>conformité</strong>. Il s'adresse aux dirigeants et responsables de PME B2B qui veulent une lecture honnête avant d'investir, pas un argumentaire.</p>
    <p class="acad-intro">Concrètement : 6 questions notées, un scorecard personnalisé envoyé par email et relu par un humain, avec 3 actions priorisées. C'est un auto-diagnostic pour vous repérer. Si vous voulez une mission menée par nos soins sur votre contexte réel, c'est l'<a href="/audit-ia-pme">audit IA pour PME</a>, pas cette page. Et pour un chiffre tout de suite sans email, le <a href="/ressources/outils/score-maturite-ia">score de maturité IA</a> vous situe en 3 questions.</p>
    <form class="acad-form" method="POST" action="/api/academy" name="academy" data-academy-form novalidate>
        <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;overflow:hidden">
          <label for="academy-hp">Ne pas remplir</label>
          <input type="text" id="academy-hp" name="_hp" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="lang" value="fr" />
      <Kicker tone="accent" class="acad-section-k">§ 01 · Données</Kicker>
      <fieldset>
        <legend>Q1 · Vos données métier sont-elles centralisées ?</legend>
        <label><input type="radio" name="q1" value="0" /> Non, dispersées dans 10+ outils</label>
        <label><input type="radio" name="q1" value="1" /> Centralisées partiellement (CRM ou warehouse)</label>
        <label><input type="radio" name="q1" value="2" /> Centralisées dans un entrepôt unifié (dbt, Snowflake, etc.)</label>
        <label><input type="radio" name="q1" value="3" /> Entrepôt + politique d'écriture par champ documentée</label>
      </fieldset>
      <fieldset>
        <legend>Q2 · Avez-vous une source de vérité unique pour le pipeline revenue ?</legend>
        <label><input type="radio" name="q2" value="0" /> Non, débats fréquents en comité</label>
        <label><input type="radio" name="q2" value="1" /> CRM seul fait foi</label>
        <label><input type="radio" name="q2" value="2" /> CRM + warehouse réconciliés</label>
        <label><input type="radio" name="q2" value="3" /> Source unique signée par finance + revenue</label>
      </fieldset>

      <Kicker tone="accent" class="acad-section-k">§ 02 · Outillage IA</Kicker>
      <fieldset>
        <legend>Q3 · Avez-vous déjà déployé un agent IA en production ?</legend>
        <label><input type="radio" name="q3" value="0" /> Non, jamais essayé</label>
        <label><input type="radio" name="q3" value="1" /> POC seulement, jamais en prod</label>
        <label><input type="radio" name="q3" value="2" /> 1-2 agents en prod, peu mesurés</label>
        <label><input type="radio" name="q3" value="3" /> 3+ agents en prod avec audit trail mesurable</label>
      </fieldset>
      <fieldset>
        <legend>Q4 · Connaissez-vous le coût LLM mensuel par agent ?</legend>
        <label><input type="radio" name="q4" value="0" /> Aucune visibilité</label>
        <label><input type="radio" name="q4" value="1" /> Total mensuel global seulement</label>
        <label><input type="radio" name="q4" value="2" /> Par agent, sans drill-down</label>
        <label><input type="radio" name="q4" value="3" /> Par agent + drill-down (modèle, batch, cache)</label>
      </fieldset>

      <Kicker tone="accent" class="acad-section-k">§ 03 · Conformité</Kicker>
      <fieldset>
        <legend>Q5 · Vos agents IA sont-ils auditables ?</legend>
        <label><input type="radio" name="q5" value="0" /> Aucun audit trail</label>
        <label><input type="radio" name="q5" value="1" /> Logs basiques applicatifs</label>
        <label><input type="radio" name="q5" value="2" /> Trail structuré exportable</label>
        <label><input type="radio" name="q5" value="3" /> Trail re-rejouable + signé (AI Act ready)</label>
      </fieldset>
      <fieldset>
        <legend>Q6 · Avez-vous un humain d'astreinte nommé sur vos agents prod ?</legend>
        <label><input type="radio" name="q6" value="0" /> Non, personne désigné</label>
        <label><input type="radio" name="q6" value="1" /> Oui, mais seulement les heures ouvrées</label>
        <label><input type="radio" name="q6" value="2" /> Astreinte 24/7 mais réactivité variable</label>
        <label><input type="radio" name="q6" value="3" /> Astreinte 24/7 avec SLA réveil &lt; 15 min</label>
      </fieldset>

      <div class="form-row acad-email">
        <label for="email"><span>Email pro</span><span aria-hidden>*</span></label>
        <input id="email" name="email" type="email" required autocomplete="email" placeholder="prénom@entreprise.com" />
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden" />
      </div>
      <p class="form-error-global" role="alert" aria-live="assertive" hidden data-academy-error></p>
      <div class="acad-cta">
        <Button as="button" type="submit" variant="primary" size="lg" mag={0.18}>
          Recevoir mon scorecard →
        </Button>
        <p class="acad-foot">Aucun rappel commercial. Scorecard personnalisé envoyé à votre email, relu par un humain.</p>
      </div>

      <details class="acad-skip">
        <summary>Préférez parler directement ?</summary>
        <p>Sautez le diagnostic et <a href="/contact">réservez 45 min</a>. On lit votre stack ensemble.</p>
      </details>
    </form>
  </Fragment>
</UtilityTemplate>

<style>
  .acad-intro { max-width: var(--wrap-prose); margin: 0 auto var(--space-5); text-align: left; font-size: var(--text-body); line-height: var(--leading-lede); color: var(--muted); }
  .acad-intro a { color: var(--accent-text); border-bottom: 1px solid currentColor; }
  .acad-form { max-width: var(--wrap-prose); margin: 0 auto; text-align: left; display: flex; flex-direction: column; gap: var(--space-5); }
  :global(.acad-section-k) { display: block; margin: var(--space-5) 0 var(--space-2); }
  fieldset { border: 1px solid var(--hairline); border-radius: var(--radius-xs); padding: 22px var(--space-5); display: flex; flex-direction: column; gap: 10px; }
  legend { font-family: var(--font-sans); font-weight: var(--fw-medium); font-size: var(--text-h3); line-height: 1.3; padding: 0 var(--space-2); }
  fieldset label { font-size: var(--text-small); line-height: var(--leading-lede); display: flex; align-items: baseline; gap: var(--space-2); cursor: pointer; padding: 6px 0; transition: color var(--dur-fast) var(--ease); }
  fieldset label:hover { color: var(--accent-text); }
  fieldset input[type="radio"] { accent-color: var(--accent-text); flex-shrink: 0; }
  .acad-cta { margin-top: var(--space-5); display: flex; flex-direction: column; gap: var(--space-3); align-items: flex-start; }
  .acad-foot { font-size: var(--text-small); color: var(--muted); margin: 0; }
  .acad-skip { margin-top: var(--space-5); font-size: var(--text-small); color: var(--muted); }
  .acad-skip summary { cursor: pointer; font-family: var(--font-mono); letter-spacing: 0.06em; padding: var(--space-2) 0; }
  .acad-skip a { color: var(--accent-text); border-bottom: 1px solid currentColor; }
  .form-row { display: flex; flex-direction: column; gap: 6px; }
  .form-row label {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    display: flex;
    gap: var(--space-1);
  }
  .form-row label span:last-child { color: var(--accent-text); }
  .form-row input {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    padding: var(--space-3) 14px;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-xs);
    background: var(--paper);
    color: var(--ink);
    transition: border-color var(--dur-fast) var(--ease);
  }
  .form-row input:focus { border-color: var(--accent-text); }
  .acad-email { margin-top: var(--space-3); }
  .form-error-global {
    color: var(--accent-text);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    margin: 0;
  }
</style>

<script is:inline>
(function () {
  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function bindForm(form) {
    if (form.dataset.academyBound) return;
    form.dataset.academyBound = '1';

    var langInput = form.querySelector('input[name="lang"]');
    var lang = langInput ? langInput.value : 'fr';
    var emailInput = form.querySelector('input[name="email"]');
    var errorEl = form.querySelector('[data-academy-error]');
    var btn = form.querySelector('button[type="submit"]');

    function showError(msg) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.removeAttribute('hidden');
    }
    function clearError() {
      if (!errorEl) return;
      errorEl.setAttribute('hidden', '');
      errorEl.textContent = '';
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      clearError();

      var email = emailInput ? emailInput.value.trim() : '';
      if (!email || !EMAIL_RE.test(email)) {
        showError(lang === 'fr' ? 'Adresse email invalide.' : 'Invalid email address.');
        if (emailInput) emailInput.focus();
        return;
      }

      if (btn) btn.disabled = true;

      var payload = Object.fromEntries(new FormData(form).entries());

      try {
        var res = await fetch('/api/academy', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        var data = await res.json();
        if (data.ok && data.redirect) {
          window.location.href = data.redirect;
        } else {
          showError(data.error || (lang === 'fr' ? 'Erreur, veuillez réessayer.' : 'Error, please try again.'));
          if (btn) btn.disabled = false;
        }
      } catch (_) {
        showError(lang === 'fr' ? 'Erreur réseau, veuillez réessayer.' : 'Network error, please try again.');
        if (btn) btn.disabled = false;
      }
    });
  }

  document.querySelectorAll('form[data-academy-form]').forEach(bindForm);
  document.addEventListener('astro:page-load', function () {
    document.querySelectorAll('form[data-academy-form]').forEach(function (form) {
      delete form.dataset.academyBound;
      bindForm(form);
    });
  });
})();
</script>
