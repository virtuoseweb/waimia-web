---
// Page · /ressources/cookbooks · Knowledge base · cookbooks
export const prerender = true;

// Source : waimia-handoff2 / knowledge-base.html
//
// Composé de · UtilityTemplate variant="list" (ex-ListIndexTemplate, fusion R6) (variant cookbooks · cards 2 cols)

import UtilityTemplate from '../../../components/templates/UtilityTemplate.astro';
import Kicker from '../../../components/ui/atoms/Kicker.astro';

const cookbooks = [
  { code: 'CB · 01', tag: 'RevOps', title: "Réconcilier HubSpot et l'entrepôt en 5 jours",
    lead: "Le runbook qu'on suit en interne. Inclut les requêtes dbt et les politiques d'écriture par champ." },
  { code: 'CB · 02', tag: 'AI Act', title: "Cartographier le périmètre AI Act d'une fintech",
    lead: "Template + 12 questions à poser au CRO. Sortie : matrice risque par cas d'usage signée." },
  { code: 'CB · 03', tag: 'FinOps', title: 'Couper 40-70 % de la facture LLM en 2 semaines',
    lead: 'Tokenisation, batching, caching, routage. Le checklist qu\'on applique en mission.' },
  { code: 'CB · 04', tag: 'Audit', title: 'Le scorecard 47 critères de maturité IA',
    lead: 'Notation pondérée par chantier · benchmark anonymisé secteur · estimation effort.' },
  { code: 'CB · 05', tag: 'Sécurité', title: "Pen tester un agent Claude · les 8 vecteurs d'attaque",
    lead: "Injection de prompt, exfil, jailbreaks, supply chain. Méthodologie d'audit signée." },
  { code: 'CB · 06', tag: 'Dette', title: 'Migrer 200 bots RPA vers des agents Claude',
    lead: 'Triage qui survit / qui meurt / qui était du théâtre. Inclut grille de priorisation.' },
];

// Featured = LE cookbook le plus représentatif (le runbook RevOps qu'on suit en interne,
// le plus vendeur : requêtes dbt + politiques d'écriture). Le reste reste en grille.
const [featured, ...rest] = cookbooks;
const cbMailto = (c: { code: string; title: string }) =>
  `mailto:bonjour@waimia.com?subject=${encodeURIComponent(c.code + ' · ' + c.title)}`;
---
<UtilityTemplate
  variant="list"
  title="Cookbooks · Recettes pratiques d'agence IA · Waimia"
  description="Les runbooks qu'on suit en interne. Réconciliation données, AI Act, FinOps LLM, audit maturité, pen testing : disponibles sous accord NDA."
  kicker="§ Cookbooks · 6 runbooks"
>
  <Fragment slot="headline">
    Six <i>recettes</i>. Pas de magie.
  </Fragment>
  <Fragment slot="lede">
    Les méthodes qu'on applique en mission, écrites pour être réutilisées. Chaque cookbook inclut le runbook étape par étape, les templates et les pièges connus.
  </Fragment>

  <Fragment slot="filters">
    <Kicker tone="accent">RevOps</Kicker>
    <Kicker>AI Act</Kicker>
    <Kicker>FinOps</Kicker>
    <Kicker>Audit</Kicker>
    <Kicker>Sécurité</Kicker>
    <Kicker>Dette</Kicker>
  </Fragment>

  <Fragment slot="list">
    <a class="cb-featured reveal" href={cbMailto(featured)}>
      <div class="cb-meta">
        <span class="cb-code">{featured.code}</span>
        <span class="cb-tag">Cookbook phare · {featured.tag}</span>
      </div>
      <h2 class="cb-featured-title">{featured.title}</h2>
      <p class="cb-featured-lead">{featured.lead}</p>
      <span class="cb-go">Demander le cookbook (NDA) →</span>
    </a>

    <div class="cb-grid reveal-stagger">
      {rest.map((c) => (
        <a class="cb-card" href={cbMailto(c)}>
          <div class="cb-meta">
            <span class="cb-code">{c.code}</span>
            <span class="cb-tag">{c.tag}</span>
          </div>
          <h2 class="cb-title">{c.title}</h2>
          <p class="cb-lead">{c.lead}</p>
          <span class="cb-go">Demander le cookbook (NDA) →</span>
        </a>
      ))}
    </div>
  </Fragment>
</UtilityTemplate>

<style>
  .cb-featured {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-9);
    margin-bottom: var(--space-6);
    background: var(--ink);
    color: var(--paper);
    border: 2px solid var(--accent);
    transition: transform 260ms var(--ease);
  }
  .cb-featured:hover { transform: translateY(-3px); }
  .cb-featured .cb-code { color: var(--accent-text); }
  .cb-featured .cb-tag { color: rgba(var(--paper-rgb), 0.6); }
  .cb-featured-title {
    font-family: var(--font-display);
    font-size: var(--text-h2-section);
    line-height: 1.0;
    letter-spacing: var(--tracking-display);
    font-weight: var(--fw-regular);
    margin: 0;
    text-wrap: balance;
  }
  .cb-featured-lead {
    font-size: var(--text-body-lead);
    line-height: 1.55;
    color: rgba(var(--paper-rgb), 0.78);
    text-wrap: pretty;
    margin: 0;
    max-width: 640px;
  }
  .cb-featured .cb-go { color: var(--accent-text); }
  .cb-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: 1px solid var(--hairline-strong); border-bottom: 1px solid var(--hairline-strong); }
  .cb-card { padding: var(--space-7); border-right: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); display: flex; flex-direction: column; gap: 14px; color: inherit; transition: background 240ms var(--ease); }
  .cb-card:nth-child(2n) { border-right: none; }
  .cb-card:nth-last-child(-n+2) { border-bottom: none; }
  .cb-card:hover { background: var(--paper-2); }
  .cb-meta { display: flex; gap: 14px; font-family: var(--font-mono); font-size: var(--text-eyebrow); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .cb-code { color: var(--accent-text); }
  .cb-title { font-family: var(--font-display); font-size: var(--text-h2-tight); line-height: 1.05; letter-spacing: -0.02em; font-weight: var(--fw-regular); margin: 0; text-wrap: balance; }
  .cb-lead { font-size: var(--text-body-sm); line-height: 1.55; color: var(--muted); text-wrap: pretty; margin: 0; max-width: 520px; }
  .cb-go { font-family: var(--font-mono); font-size: var(--text-eyebrow); letter-spacing: 0.1em; color: var(--accent-text); margin-top: auto; }
  @media (max-width: 800px) { .cb-grid { grid-template-columns: 1fr; } .cb-card { border-right: none; border-bottom: 1px solid var(--hairline); } .cb-card:last-child { border-bottom: none; } }
</style>
