---
export const prerender = true;

// Page SSG · /ressources/guides · HUB guides · rendu 100 % composable.
// noindex=true : hub mince (politique index-on-quality strategy/10 §3).
// Hero court + cartes via section catalogue `related-cards-band` (.min(2)/.max(3)).
// Collection vide → 0 carte → 0 band (pas de crash).
// Profondeur 3 niveaux (ressources/guides/) → imports en `../../../`.

import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SectionsRenderer from '../../../components/sections/SectionsRenderer.astro';
import MastheadBar from '../../../components/sections/MastheadBar.astro';
import type { SectionData, SectionByType } from '@waimia/ds-kernel';

const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fr';
const isFr = lang === 'fr';

type Card = SectionByType<'related-cards-band'>['cards'][number];

const cards: Card[] = (await getCollection('guides'))
  .sort((a, b) => (a.data.slug ?? a.id).localeCompare(b.data.slug ?? b.id))
  .map((e) => {
    const d = e.data;
    const shortTitle = (full: string) => full.split(' · ')[0].trim();
    return {
      kicker_fr: 'Guide',
      kicker_en: 'Guide',
      title_fr: shortTitle(d.title_fr),
      title_en: shortTitle(d.title_en),
      lead_fr: d.description_fr,
      lead_en: d.description_en,
      href: `/ressources/guides/${d.slug ?? e.id}`,
    };
  });

// Chunker équilibré 2-3 (jamais de singleton) : respecte .min(2)/.max(3) du schéma.
function chunkCards(items: Card[]): Card[][] {
  if (items.length < 2) return [];
  const chunks: Card[][] = [];
  let rest = [...items];
  while (rest.length > 0) {
    if (rest.length === 4) {
      chunks.push(rest.slice(0, 2));
      chunks.push(rest.slice(2, 4));
      rest = [];
    } else if (rest.length <= 3) {
      chunks.push(rest);
      rest = [];
    } else {
      chunks.push(rest.slice(0, 3));
      rest = rest.slice(3);
    }
  }
  return chunks;
}

const hero: SectionByType<'hero-hub-masthead'> = {
  type: 'hero-hub-masthead',
  background: 'paper',
  variant: 'listing',
  decoration: false,
  align: 'left',
  kicker_fr: '§ Guides · la méthode, étape par étape',
  kicker_en: '§ Guides · the method, step by step',
  h1_fr: '<span>Guides</span><br/><span><i>pratiques</i>.</span>',
  h1_en: '<span>Practical</span><br/><span><i>guides</i>.</span>',
  lede_fr: "Des how-to opérationnels et datés, pas des articles : chaque guide couvre un chantier de bout en bout, des prérequis aux premiers résultats. Des étapes, des exemples, des pièges à éviter.",
  lede_en: 'Operational, dated how-tos, not articles: each guide covers a project end to end, from prerequisites to first results. Steps, examples, pitfalls to avoid.',
};

const ctaFinal: SectionByType<'cta-final'> = {
  type: 'cta-final',
  background: 'ink',
  h2_fr: 'Envie d\'en parler ?',
  h2_en: 'Want to talk about it?',
  body_fr: 'Un diagnostic de 45 minutes, gratuit et sans engagement : on lit votre contexte ensemble et on vous dit vite où sont les leviers.',
  body_en: 'A 45-minute diagnostic, free and with no commitment: we read your context together and tell you quickly where the levers are.',
  cta_primary: {
    label_fr: 'Réserver un diagnostic (45 min) →',
    label_en: 'Book a diagnostic (45 min) →',
    href: '/contact',
    variant: 'primary',
  },
  cta_secondary: {
    label_fr: "Voir l'audit IA pour PME →",
    label_en: 'See the AI audit for SMBs →',
    href: '/audit-ia-pme',
    variant: 'ghost',
  },
};

const cardBands: SectionData[] = chunkCards(cards).map((chunk, i) => ({
  type: 'related-cards-band',
  background: i % 2 === 0 ? 'paper' : 'paper-2',
  ...(i === 0
    ? { kicker_fr: '§ Les guides disponibles', kicker_en: '§ Available guides' }
    : {}),
  cards: chunk,
}) satisfies SectionByType<'related-cards-band'>);

const signature: SectionByType<'manifesto-statement'> = {
  type: 'manifesto-statement',
  kicker_fr: '§ La promesse',
  kicker_en: '§ The promise',
  text_fr: 'Pas de théorie creuse. Des <i>étapes</i>, des exemples, des pièges à <span class="acc">éviter</span>.',
  text_en: 'No empty theory. <i>Steps</i>, examples, pitfalls to <span class="acc">avoid</span>.',
  tone: 'ink',
  show_grid: false,
  pinned: false,
};

const sections: SectionData[] = [hero, signature, ...cardBands, ctaFinal];
---

<Base
  title={isFr ? 'Guides pratiques IA · Waimia' : 'Practical AI guides · Waimia'}
  description={isFr
    ? "Des guides pratiques pour passer de l'intention à l'exécution sur vos projets IA. Des étapes claires, des exemples concrets, les pièges à éviter."
    : 'Practical guides to move from intent to execution on your AI projects. Clear steps, concrete examples, pitfalls to avoid.'}
  noindex={true}
>
  <MastheadBar
    lang={lang}
    items={[
      { label: isFr ? 'Accueil' : 'Home', href: isFr ? '/' : '/en' },
      { label: isFr ? 'Ressources' : 'Resources', href: isFr ? '/ressources' : '/en/ressources' },
      { label: 'Guides' },
    ]}
  />
  <SectionsRenderer sections={sections} lang={lang} />
</Base>
