---
// Page · /ressources/blog · Index notes & essais
export const prerender = true;

import { getCollection } from 'astro:content';
import UtilityTemplate from '../../../components/templates/UtilityTemplate.astro';
import EditorialWriteRow from '../../../components/ui/molecules/EditorialWriteRow.astro';
import { langFromPath } from '../../../lib/i18n';
import { blogEntryHref } from '../../../lib/blog-routing';
import { buildCollectionPage } from '../../../lib/seo/schema-builder';

const lang = langFromPath(Astro.url.pathname);

const allBlog = await getCollection('blog');
const sortedBlog = [...allBlog].sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const blogItems = sortedBlog.map((entry) => `https://waimia.com${blogEntryHref(entry)}`);
const collectionLd = buildCollectionPage(
  'Notes & essais · Waimia',
  'Pas de pensum SEO. Notes courtes, cas concrets, recettes pratiques. Un essai mensuel, jamais de promotion.',
  blogItems,
);

const formatDate = (d: Date) => {
  const dd = String(d.getDate()).padStart(2, '0');
  const mm = String(d.getMonth() + 1).padStart(2, '0');
  return `${dd}.${mm}`;
};
---
<UtilityTemplate
  variant="list"
  title="Notes & essais · Waimia"
  description="Pas de pensum SEO. Notes courtes, cas concrets, recettes pratiques. Un essai mensuel, jamais de promotion."
  kicker="§ Notes & essais · monthly"
  jsonLd={collectionLd}
>
  <Fragment slot="headline">
    Notes <i>lentes</i> du terrain.
  </Fragment>
  <Fragment slot="lede">
    Une newsletter mensuelle, jamais de promotion. Tout ce qu'on aurait voulu lire avant de commencer un chantier.
  </Fragment>

  <Fragment slot="list">
    <div class="blog-list">
      {sortedBlog.map((entry) => (
        <EditorialWriteRow
          date={formatDate(entry.data.publishedAt)}
          tag={(entry.data.editorialType ?? entry.data.type ?? 'NOTE').toUpperCase()}
          href={blogEntryHref(entry)}
          tone="paper"
        >
          {lang === 'fr' ? entry.data.title_fr : entry.data.title_en}
        </EditorialWriteRow>
      ))}
    </div>
  </Fragment>
</UtilityTemplate>

<style>
  /* max-width live + resserrage micro-rythme du blanc hero→liste (it.10) :
     le masthead `hero-hub-listing` (bottom clamp ~72px) + `.list-body` (top clamp ~100px)
     du template partagé creusaient une bande vide ; on remonte la liste d'un cran --space
     depuis la page (override local, template intact). */
  .blog-list {
    max-width: 1100px;
    margin-top: calc(-1 * var(--space-9));
  }
  @media (max-width: 768px) {
    .blog-list { margin-top: calc(-1 * var(--space-7)); }
  }
</style>
