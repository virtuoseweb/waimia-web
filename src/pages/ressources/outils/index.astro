---
// Page · /ressources/outils · Hub outils actionnables · Waimia
export const prerender = true;

// Composé de · UtilityTemplate variant="list" (ex-ListIndexTemplate, fusion R6) (variant outils · cards 2 cols)
// Le LISTING est déjà 100 % piloté par données (collection `outils`, cf getCollection ci-dessous) :
// seule la copy statique (headline/lede/labels de type) restait en props. Migrée en JSON
// (V5, 2026-07-19, entrée `outils-hub` kind:'hub-copy' de la collection `legal`).
// title/description restent calculés ici (dépendent du count live), donc hors JSON.

import { getCollection, getEntry } from 'astro:content';
import UtilityTemplate from '../../../components/templates/UtilityTemplate.astro';
import Kicker from '../../../components/ui/atoms/Kicker.astro';
import { buildCollectionPage } from '../../../lib/seo/schema-builder';

const hubCopyEntry = await getEntry('legal', 'outils-hub');
if (!hubCopyEntry) throw new Error('Collection "legal" · entrée "outils-hub" introuvable.');
const hubCopy = hubCopyEntry.data;
const TYPE_LABELS: Record<string, string> = hubCopy.typeLabels ?? {};

const allEntries = await getCollection('outils');

const entries = allEntries
  .filter((e) => !e.data.seo?.noindex)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// Types présents, dédupliqués, ordre d'apparition
const presentTypes = [...new Set(entries.map((e) => e.data.type))];

const count   = entries.length;
const kicker  = `§ Outils · ${count} disponible${count > 1 ? 's' : ''}`;

const outilsItems = entries.map((entry) => `https://waimia.com/ressources/outils/${entry.id}`);
const collectionLd = buildCollectionPage(
  'Outils IA gratuits pour PME · Waimia',
  'Calculateurs ROI et maturité IA gratuits pour PME B2B, sans inscription : un résultat immédiat à l\'écran.',
  outilsItems,
);
---
<UtilityTemplate
  variant="list"
  title="Outils IA gratuits pour PME · Calculateurs ROI et maturité · Waimia"
  description="Calculateurs ROI et maturité IA gratuits pour PME B2B, sans inscription : un résultat immédiat à l'écran."
  kicker={kicker}
  jsonLd={collectionLd}
  noindex={true}
>
  <Fragment slot="headline" set:html={hubCopy.headlineHtml} />
  <Fragment slot="lede" set:html={hubCopy.ledeHtml} />

  <Fragment slot="filters">
    {presentTypes.map((type) => (
      <Kicker>{TYPE_LABELS[type] ?? type}</Kicker>
    ))}
  </Fragment>

  <Fragment slot="list">
    <div class="cb-grid reveal-stagger">
      {entries.map((entry) => (
        <a class="cb-card" href={`/ressources/outils/${entry.id}`}>
          <div class="cb-meta">
            <span class="cb-code">{entry.data.category_fr ?? 'Outil'}</span>
            <span class="cb-tag">{TYPE_LABELS[entry.data.type] ?? entry.data.type}</span>
          </div>
          <h2 class="cb-title">{entry.data.title_fr}</h2>
          <p class="cb-lead">{entry.data.description_fr}</p>
          <span class="cb-go">Ouvrir l'outil →</span>
        </a>
      ))}
    </div>
  </Fragment>
</UtilityTemplate>

<style>
  .cb-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, calc(800px / 2)), 1fr)); gap: 0; border-top: 1px solid var(--hairline-strong); border-bottom: 1px solid var(--hairline-strong); }
  .cb-card { padding: var(--spacing-block); border-right: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); display: flex; flex-direction: column; gap: 14px; color: inherit; transition: background 240ms var(--ease); }
  .cb-card:nth-child(2n) { border-right: none; }
  .cb-card:nth-last-child(-n+2) { border-bottom: none; }
  .cb-card:hover { background: var(--paper-2); }
  .cb-meta { display: flex; gap: 14px; font-family: var(--font-mono); font-size: var(--text-small); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .cb-code { color: var(--accent-text); }
  .cb-title { font-family: var(--font-sans); font-size: var(--text-h2); line-height: 1.05; letter-spacing: -0.02em; font-weight: var(--fw-semibold); margin: 0; text-wrap: balance; }
  .cb-lead { font-size: var(--text-small); line-height: 1.55; color: var(--muted); text-wrap: pretty; margin: 0; max-width: 520px; }
  .cb-go { font-family: var(--font-mono); font-size: var(--text-small); letter-spacing: 0.1em; color: var(--accent-text); margin-top: auto; }
  @media (max-width: 800px) { .cb-grid { grid-template-columns: 1fr; } .cb-card { border-right: none; border-bottom: 1px solid var(--hairline); } .cb-card:last-child { border-bottom: none; } }
</style>
