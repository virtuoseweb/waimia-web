---
export const prerender = true;

// Page SSG · /ressources/outils/charte-ia-entreprise · lead magnet « Modèle de charte IA
// pour PME » (requête visée : charte ia entreprise). La charte est lisible en entier sur
// la page, personnalisable, utilisable en ligne et exportable en Word sans e-mail. Le PDF
// est VERROUILLÉ : e-mail obligatoire, livré en pièce jointe (organism LeadCapture `required`
// → /api/lead-magnet), jamais servi par le site.
// Route explicite : l'entrée `outils/charte-ia-entreprise` (JSON) ne sert qu'au listing
// du hub ; [...slug].astro l'exclut.

import Base from '../../../layouts/Base.astro';
import MastheadBar from '../../../components/sections/MastheadBar.astro';
import CtaFinal from '../../../components/sections/CtaFinal.astro';
import ToolIntro from '../../../components/ui/organisms/conversion/ToolIntro.astro';
import CharterDocument from '../../../components/ui/organisms/conversion/CharterDocument.astro';
import LeadCapture from '../../../components/ui/organisms/conversion/LeadCapture.astro';
import ResourceLinks from '../../../components/ui/organisms/conversion/ResourceLinks.astro';
import { buildArticle, buildWebApplication } from '../../../lib/seo/schema-builder';
import { SITE } from '../../../site.config';
import { CHARTE_HREF, auditCtaFinal } from '../../../data/conversion';
import { charterArticles } from '../../../data/charte-ia-pme';

const title = 'Charte IA entreprise : modèle gratuit pour PME (PDF et Word)';
const description = "Modèle de charte IA pour PME en neuf articles : outils autorisés, données interdites, validation humaine. En ligne et Word sans e-mail ; le PDF par e-mail.";
const ld = buildArticle({
  headline: title,
  description,
  datePublished: '2026-10-04',
  dateModified: '2026-10-04',
  mainEntityOfPage: `${SITE.url}${CHARTE_HREF}`,
});
// Le modèle se personnalise et s'exporte dans le navigateur : outil gratuit, balisé comme tel.
const webAppLd = buildWebApplication({ name: 'Modèle de charte IA pour PME', description, url: `${SITE.url}${CHARTE_HREF}` });
const cta = auditCtaFinal(
  'Une charte dit ce qui est permis. L\'audit dit par quelle tâche commencer.',
  '45 minutes en visio, gratuit : vos process passés en revue tâche par tâche, et une cartographie écrite à la fin.',
);
---
{/* showUpdated={false} : la date de mise à jour figure déjà dans les repères du bandeau d'introduction. */}
<Base title={title} description={description} jsonLd={[ld, webAppLd]} ogType="article" showUpdated={false}>
  <MastheadBar
    lang="fr"
    items={[
      { label: 'Accueil', href: '/' },
      { label: 'Ressources', href: '/ressources' },
      { label: 'Outils', href: '/ressources/outils' },
      { label: 'Charte IA entreprise' },
    ]}
  />
  <ToolIntro
    h1="Charte IA entreprise : un modèle pour PME, à adapter"
    lede={`${charterArticles.length} articles courts qui règlent les questions que vos équipes se posent déjà : quel outil, quelles données, qui relit, qui valide. Le texte est en entier ci-dessous.`}
    facts={[
      { label: 'Format', value: 'En ligne, Word, PDF par e-mail' },
      { label: 'Longueur', value: `${charterArticles.length} articles, 8 min de lecture` },
      { label: 'E-mail', value: 'Requis pour le PDF seulement' },
      { label: 'Mise à jour', value: '4 octobre 2026' },
    ]}
  />
  <CharterDocument />
  <LeadCapture
    band
    required
    anchorId="recevoir-le-pdf"
    slug="charte-ia-entreprise"
    title="Recevoir le PDF par e-mail"
    description="Le modèle de charte au format PDF, avec ses notes d'adaptation, arrive en pièce jointe. Il n'est pas disponible en téléchargement direct."
    buttonLabel="Recevoir le PDF"
  />
  <ResourceLinks exclude={['charte']} />
  <CtaFinal data={cta} lang="fr" />
</Base>
