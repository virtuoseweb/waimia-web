---
export const prerender = true;

import { getCollection, type CollectionEntry } from 'astro:content';
import EssayTemplate from '../../../components/templates/EssayTemplate.astro';
import ToolWidget from '../../../components/ui/organisms/ToolWidget.astro';
import LeadCapture from '../../../components/ui/organisms/conversion/LeadCapture.astro';
import { LEAD_MAGNETS, type LeadMagnetSlug } from '../../../data/conversion';
import { outilHeroIllustration } from '../../../lib/hero-illustrations';
import { SITE } from '../../../site.config';
import { buildWebApplication } from '../../../lib/seo/schema-builder';

export async function getStaticPaths() {
  const entries = await getCollection('outils');
  return entries
    .filter((entry) => !entry.data.seo?.noindex)
    // Entrées à route explicite (charte-ia-entreprise.astro, grille-taches-a-automatiser.astro,
    // checklist-90-jours-claude.astro) :
    // elles n'ont ni inputs ni outputs, leur JSON ne sert qu'au listing du hub.
    .filter((entry) => entry.data.inputs.length > 0 && entry.data.outputs.length > 0)
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

type Props = { entry: CollectionEntry<'outils'> };

const { entry } = Astro.props as Props;
const d = entry.data;
// Prose d'aide pré-rendue (décision nuit 0018) : le markdown MDX est devenu une donnée
// (body_sections[0].html_fr), injectée au slot body sous le widget interactif.
const bodyHtml = d.body_sections?.[0]?.html_fr ?? '';

const dateStr = d.publishedAt.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const categoryKicker = d.category_fr ? ` · ${d.category_fr}` : '';
const heroIllustration = d.heroIllustration ?? outilHeroIllustration(entry.id);
// Capture d'e-mail facultative : seulement si l'outil la demande ET que son slug est servi par /api/lead-magnet.
const captureSlug = d.captureEmail && entry.id in LEAD_MAGNETS ? (entry.id as LeadMagnetSlug) : null;

// JSON-LD WebApplication · décrit l'outil interactif (calculateur/score) comme une vraie
// web-app gratuite, en complément de l'Article émis par EssayTemplate. Émis au niveau page.
const toolUrl = `${SITE.url}/ressources/outils/${entry.id}`;
const webAppLd = buildWebApplication({ name: d.title_fr, description: d.description_fr, url: toolUrl });
---
<EssayTemplate
  title={d.title_fr}
  description={d.description_fr}
  kicker={`§ Outil · ${d.type}${categoryKicker}`}
  date={dateStr}
  datePublished={d.publishedAt.toISOString().slice(0, 10)}
  author={SITE.name}
  relatedCards={[
    { kicker: 'Outil', title_fr: "Grille des tâches à automatiser", title_en: "Grille des tâches à automatiser", lead_fr: "Listez vos tâches, leur fréquence et leur durée : la grille les classe par priorité.", lead_en: "Listez vos tâches, leur fréquence et leur durée : la grille les classe par priorité.", href: '/ressources/outils/grille-taches-a-automatiser' },
    { kicker: 'Diagnostic', title_fr: "Diagnostic de maturité IA", title_en: "Diagnostic de maturité IA", lead_fr: "Dix questions, un niveau de 1 à 5 et le point à traiter en premier.", lead_en: "Dix questions, un niveau de 1 à 5 et le point à traiter en premier.", href: '/ressources/diagnostics/maturite-ia' },
    { kicker: 'Audit gratuit', title_fr: "Audit IA pour PME", title_en: "Audit IA pour PME", lead_fr: "Le déroulé des 45 minutes et un exemple de livrable.", lead_en: "Le déroulé des 45 minutes et un exemple de livrable.", href: '/audit-ia-pme' },
  ]}
  lang="fr"
  breadcrumbItems={[
    { label: 'Accueil', href: '/' },
    { label: 'Outils', href: '/ressources/outils' },
    { label: d.title_fr },
  ]}
  illustration={heroIllustration}
>
  <Fragment slot="headline">{d.title_fr}</Fragment>
  <Fragment slot="lede">{d.description_fr}</Fragment>
  <Fragment slot="body">
    {d.inputs.length > 0 && d.outputs.length > 0 && (
      <ToolWidget inputs={d.inputs} outputs={d.outputs} lang="fr" />
    )}
    {captureSlug && (
      <LeadCapture
        slug={captureSlug}
        title="Recevoir ce calcul par e-mail"
        description="Vos hypothèses et les résultats affichés, dans un e-mail à garder ou à transférer."
        buttonLabel="Recevoir le calcul"
      />
    )}
    <Fragment set:html={bodyHtml} />
  </Fragment>
</EssayTemplate>

<script type="application/ld+json" set:html={JSON.stringify(webAppLd)} />

{/* Comportement du ToolWidget · hoisté au niveau page (le slot body d'EssayTemplate
    est capturé via Astro.slots.render() puis réinjecté en set:html, ce qui rend
    inerte un <script> porté par le composant). Cible générique [data-tool-widget]. */}
<script>
  function evalExpr(expr: string, vars: Record<string, number>): number {
    let i = 0;
    const s = expr;
    const skip = () => { while (i < s.length && s[i] === ' ') i++; };
    function primary(): number {
      skip();
      const c = s[i];
      if (c === '(') {
        i++;
        const v = add();
        skip();
        if (s[i] === ')') i++;
        return v;
      }
      const start = i;
      if (/[a-zA-Z_]/.test(c)) {
        while (i < s.length && /[a-zA-Z0-9_]/.test(s[i])) i++;
        return Number(vars[s.slice(start, i)] ?? 0);
      }
      while (i < s.length && /[0-9.]/.test(s[i])) i++;
      return Number(s.slice(start, i));
    }
    function mul(): number {
      let v = primary();
      skip();
      while (s[i] === '*' || s[i] === '/') {
        const op = s[i++];
        const r = primary();
        v = op === '*' ? v * r : v / r;
        skip();
      }
      return v;
    }
    function add(): number {
      let v = mul();
      skip();
      while (s[i] === '+' || s[i] === '-') {
        const op = s[i++];
        const r = mul();
        v = op === '+' ? v + r : v - r;
        skip();
      }
      return v;
    }
    return add();
  }

  function fmtResult(v: number, format: string, unit: string, lang: string): string {
    const loc = lang === 'en' ? 'en-US' : 'fr-FR';
    if (!isFinite(v)) v = 0;
    if (format === 'currency-eur') {
      return new Intl.NumberFormat(loc, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(Math.round(v));
    }
    if (format === 'percent') {
      return new Intl.NumberFormat(loc, { style: 'percent', maximumFractionDigits: 0 }).format(v);
    }
    const n = format === 'decimal2'
      ? new Intl.NumberFormat(loc, { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(v)
      : new Intl.NumberFormat(loc, { maximumFractionDigits: 0 }).format(Math.round(v));
    return unit ? `${n} ${unit}` : n;
  }

  function initToolWidgets(): void {
    document.querySelectorAll<HTMLElement>('[data-tool-widget]').forEach((widget) => {
      if (widget.dataset.twInit) return;
      widget.dataset.twInit = '1';
      const fields = Array.from(widget.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-key]'));
      const outputs = Array.from(widget.querySelectorAll<HTMLElement>('[data-output]'));
      const compute = () => {
        const vars: Record<string, number> = {};
        fields.forEach((f) => { vars[f.dataset.key as string] = Number(f.value) || 0; });
        outputs.forEach((out) => {
          const val = evalExpr(out.dataset.formula || '0', vars);
          const target = out.querySelector<HTMLElement>('[data-result-value]');
          if (target) target.textContent = fmtResult(val, out.dataset.format || 'integer', out.dataset.unit || '', out.dataset.lang || 'fr');
        });
      };
      fields.forEach((f) => {
        f.addEventListener('input', compute);
        f.addEventListener('change', compute);
      });
      compute();
    });
  }

  // Copie par e-mail (organism LeadCapture) : on fournit hypothèses + résultats affichés.
  document.addEventListener('cv:collect', (ev) => {
    const detail = (ev as CustomEvent).detail as { summary: { label: string; value: string }[]; headline: string };
    const widget = document.querySelector<HTMLElement>('[data-tool-widget]');
    if (!widget) return;
    widget.querySelectorAll<HTMLElement>('.tw-field').forEach((f) => {
      const label = f.querySelector('label')?.textContent?.trim() ?? '';
      const field = f.querySelector<HTMLInputElement | HTMLSelectElement>('[data-key]');
      if (!field) return;
      const unit = f.querySelector('.tw-input__unit')?.textContent?.trim() ?? '';
      const value = field instanceof HTMLSelectElement ? field.selectedOptions[0]?.textContent?.trim() ?? field.value : `${field.value} ${unit}`.trim();
      detail.summary.push({ label: `Hypothèse : ${label}`.slice(0, 120), value });
    });
    widget.querySelectorAll<HTMLElement>('[data-output]').forEach((o) => {
      const label = o.querySelector('.tw-result__label')?.textContent?.trim() ?? '';
      const value = o.querySelector('[data-result-value]')?.textContent?.trim() ?? '';
      detail.summary.push({ label: label.slice(0, 120), value });
      if (!detail.headline) detail.headline = `${label} : ${value}`.slice(0, 160);
    });
  });

  // Exécution immédiate (le module se charge en defer, l'événement astro:page-load
  // a pu déjà passer) + ré-init sur navigation View Transitions (ClientRouter).
  initToolWidgets();
  document.addEventListener('astro:page-load', initToolWidgets);
</script>
