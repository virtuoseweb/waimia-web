---
export const prerender = true;

// Page SSG · /ressources/outils/checklist-90-jours-claude · lead magnet « Checklist 90
// jours pour déployer Claude en PME » (prolonge le guide /ressources/guides/claude-pme).
// La checklist est lisible et cochable en entier sur la page et imprimable, sans e-mail. Le PDF
// est VERROUILLÉ : e-mail obligatoire, livré en pièce jointe (organism LeadCapture `required` →
// /api/lead-magnet), jamais servi par le site.
// Route explicite : l'entrée `outils/checklist-90-jours-claude` (JSON) ne sert qu'au
// listing du hub ; [...slug].astro l'exclut.

import Base from '../../../layouts/Base.astro';
import MastheadBar from '../../../components/sections/MastheadBar.astro';
import CtaFinal from '../../../components/sections/CtaFinal.astro';
import ToolIntro from '../../../components/ui/organisms/conversion/ToolIntro.astro';
import ChecklistDocument from '../../../components/ui/organisms/conversion/ChecklistDocument.astro';
import LeadCaptureBand from '../../../sections/lead-capture-band/Component.astro';
import ResourceLinks from '../../../components/ui/organisms/conversion/ResourceLinks.astro';
import { buildArticle } from '../../../lib/seo/schema-builder';
import { SITE } from '../../../site.config';
import { CHECKLIST_HREF, auditCtaFinal } from '../../../data/conversion';
import { prerequisites, phases } from '../../../data/checklist-90-jours-claude';

const nWeeks = phases.reduce((n, p) => n + p.weeks.length, 0);
const title = "Checklist Claude en 90 jours : 12 semaines à cocher (PDF)";
const description = "Checklist Claude en 90 jours : 6 prérequis, 12 semaines, une case par action et les indicateurs à suivre. À cocher en ligne sans e-mail, PDF par e-mail.";
const ld = buildArticle({
  headline: title,
  description,
  datePublished: '2026-10-05',
  dateModified: '2026-10-05',
  mainEntityOfPage: `${SITE.url}${CHECKLIST_HREF}`,
});
const cta = auditCtaFinal(
  'La checklist donne l\'ordre des actions. L\'audit choisit votre cas pilote.',
  '45 minutes en visio, gratuit : vos process passés en revue tâche par tâche, et un ou deux chantiers classés, écrits noir sur blanc.',
);
---
<Base title={title} description={description} jsonLd={ld} ogType="article">
  <MastheadBar
    lang="fr"
    items={[
      { label: 'Accueil', href: '/' },
      { label: 'Ressources', href: '/ressources' },
      { label: 'Outils', href: '/ressources/outils' },
      { label: 'Checklist 90 jours Claude' },
    ]}
  />
  <ToolIntro
    h1="Checklist 90 jours : déployer Claude dans votre PME"
    lede={`Le plan du guide « Déployer Claude dans votre PME », rendu actionnable : ${prerequisites.length} prérequis, ${phases.length} phases de 30 jours, une case par action et un livrable par semaine. Cochez en ligne ou imprimez-la pour votre réunion de lancement.`}
    facts={[
      { label: 'Format', value: 'En ligne, PDF par e-mail' },
      { label: 'Longueur', value: `${prerequisites.length} prérequis, ${nWeeks} semaines` },
      { label: 'E-mail', value: 'Requis pour le PDF seulement' },
    ]}
  >
    <a slot="actions" class="btn btn-ghost" href="/ressources/guides/claude-pme">Lire le guide complet</a>
  </ToolIntro>
  <ChecklistDocument />
  <LeadCaptureBand lang="fr" data={{ type: 'lead-capture-band', lead_magnet: 'checklist-90-jours-claude', background: 'ink', anchor_id: 'recevoir-le-pdf' }} />
  <ResourceLinks exclude={['checklist']} />
  <CtaFinal data={cta} lang="fr" />
</Base>
