---
export const prerender = true;

// Page SSG · /ressources/outils/grille-taches-a-automatiser · lead magnet « Grille :
// quelles tâches automatiser en premier ». Outil utilisable sans e-mail (organism
// TaskPriorityGrid) ; juste dessous, la section lead-capture-band (mode open) invite à recevoir
// le classement par e-mail.
// Route explicite : l'entrée `outils/grille-taches-a-automatiser` (JSON) ne sert qu'au
// listing du hub ; [...slug].astro l'exclut.

import Base from '../../../layouts/Base.astro';
import MastheadBar from '../../../components/sections/MastheadBar.astro';
import CtaFinal from '../../../components/sections/CtaFinal.astro';
import ToolIntro from '../../../components/ui/organisms/conversion/ToolIntro.astro';
import TaskPriorityGrid from '../../../components/ui/organisms/conversion/TaskPriorityGrid.astro';
import LeadCaptureBand from '../../../sections/lead-capture-band/Component.astro';
import ResourceLinks from '../../../components/ui/organisms/conversion/ResourceLinks.astro';
import { SITE } from '../../../site.config';
import { buildWebApplication } from '../../../lib/seo/schema-builder';
import { GRILLE_HREF, auditCtaFinal } from '../../../data/conversion';

// Title et H1 centrés sur l'OUTIL (grille, modèle à remplir) : la requête d'information
// « quelles tâches automatiser en premier » est portée par le guide
// /ressources/guides/taches-a-automatiser-pme (anti-cannibalisation, 2026-10-05). La question
// reste dans le chapô et renvoie au guide.
const title = 'Grille des tâches à automatiser : modèle gratuit à remplir';
const description = "Grille à remplir en ligne : listez vos tâches répétitives, leur fréquence et leur durée. Elle calcule les heures par mois et les classe. Sans inscription.";
const ld = buildWebApplication({ name: 'Grille des tâches à automatiser', description, url: `${SITE.url}${GRILLE_HREF}` });
const cta = auditCtaFinal(
  'Votre grille remplie est le meilleur point de départ de l\'audit.',
  'Apportez-la au rendez-vous : en 45 minutes on vérifie les durées, on tranche les cas limites et on retient un ou deux chantiers. Gratuit, en visio.',
);
---
<Base title={title} description={description} jsonLd={ld}>
  <MastheadBar
    lang="fr"
    items={[
      { label: 'Accueil', href: '/' },
      { label: 'Ressources', href: '/ressources' },
      { label: 'Outils', href: '/ressources/outils' },
      { label: 'Grille des tâches à automatiser' },
    ]}
  />
  <ToolIntro
    h1="Grille des tâches à automatiser : le modèle à remplir"
    lede="Quelles tâches automatiser en premier ? Celles qui reviennent souvent, qui prennent du temps et dont les règles sont stables. Remplissez la grille : elle met ces trois critères en chiffres et classe vos tâches."
    facts={[
      { label: 'Durée', value: '10 minutes pour 5 tâches' },
      { label: 'Résultat', value: 'Classement immédiat, export CSV' },
      { label: 'E-mail', value: 'Non requis pour le classement' },
      { label: 'Vos données', value: 'Restent dans votre navigateur' },
    ]}
  />
  <TaskPriorityGrid />
  <LeadCaptureBand lang="fr" data={{ type: 'lead-capture-band', lead_magnet: 'grille-taches-a-automatiser', background: 'ink', anchor_id: 'recevoir-par-email' }} />
  <ResourceLinks exclude={['grille']} extra={['guide-taches', 'guide-roi']} title="La méthode, et les autres outils sans inscription" />
  <CtaFinal data={cta} lang="fr" />
</Base>
