---
export const prerender = true;

// Page SSG · /ressources/diagnostics · HUB diagnostics · rendu 100 % composable.
// noindex=true : hub mince (2 enfants seulement, politique index-on-quality strategy/10 §3).
// Hero court + cartes dérivées via la section catalogue `related-cards-band` (cap .max(3),
// .min(2)). Compile collection vide (les .mdx arrivent en parallèle) : si <2 cartes, 0 band.
// Profondeur 3 niveaux (ressources/diagnostics/) → imports en `../../../`.

import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SectionsRenderer from '../../../components/sections/SectionsRenderer.astro';
import MastheadBar from '../../../components/sections/MastheadBar.astro';
import type { SectionData, SectionByType } from '../../../schemas/sections';

const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fr';
const isFr = lang === 'fr';

type Card = SectionByType<'related-cards-band'>['cards'][number];

const cards: Card[] = (await getCollection('diagnostics'))
  .sort((a, b) => (a.data.slug ?? a.id).localeCompare(b.data.slug ?? b.id))
  .map((e) => {
    const d = e.data;
    const shortTitle = (full: string) => full.split(' · ')[0].trim();
    return {
      kicker_fr: 'Diagnostic',
      kicker_en: 'Diagnostic',
      title_fr: shortTitle(d.title_fr),
      title_en: shortTitle(d.title_en),
      lead_fr: d.description_fr,
      lead_en: d.description_en,
      href: `/ressources/diagnostics/${d.slug ?? e.id}`,
    };
  });

// Chunker équilibré 2-3 (jamais de singleton) : respecte .min(2)/.max(3) du schéma.
function chunkCards(items: Card[]): Card[][] {
  if (items.length < 2) return [];
  const chunks: Card[][] = [];
  let rest = [...items];
  while (rest.length > 0) {
    if (rest.length === 4) {
      chunks.push(rest.slice(0, 2));
      chunks.push(rest.slice(2, 4));
      rest = [];
    } else if (rest.length <= 3) {
      chunks.push(rest);
      rest = [];
    } else {
      chunks.push(rest.slice(0, 3));
      rest = rest.slice(3);
    }
  }
  return chunks;
}

const hero: SectionByType<'hero-hub-masthead'> = {
  type: 'hero-hub-masthead',
  background: 'paper',
  variant: 'listing',
  decoration: false,
  align: 'left',
  kicker_fr: '§ Diagnostics · évaluez avant de décider',
  kicker_en: '§ Diagnostics · assess before you decide',
  h1_fr: '<span>Diagnostics</span><br/><span><i>gratuits</i>.</span>',
  h1_en: '<span>Free</span><br/><span><i>diagnostics</i>.</span>',
  lede_fr: "Des outils pour situer votre maturité IA et la qualité de votre site avant tout engagement. Vous repartez avec une lecture claire, pas un argumentaire commercial.",
  lede_en: 'Tools to assess your AI maturity and the quality of your website before any commitment. You leave with a clear read, not a sales pitch.',
};

const ctaFinal: SectionByType<'cta-final'> = {
  type: 'cta-final',
  background: 'ink',
  h2_fr: 'Envie d\'en <i>parler</i> ?',
  h2_en: 'Want to <i>talk</i> about it?',
  body_fr: 'Un diagnostic de 45 minutes, gratuit et sans engagement : on lit votre contexte ensemble et on vous dit vite où sont les leviers.',
  body_en: 'A 45-minute diagnostic, free and with no commitment: we read your context together and tell you quickly where the levers are.',
  cta_primary: {
    label_fr: 'Réserver un diagnostic (45 min) →',
    label_en: 'Book a diagnostic (45 min) →',
    href: '/contact',
    variant: 'primary',
  },
  cta_secondary: {
    label_fr: "Voir l'audit IA pour PME →",
    label_en: 'See the AI audit for SMBs →',
    href: '/audit-ia-pme',
    variant: 'ghost',
  },
};

const cardBands: SectionData[] = chunkCards(cards).map((chunk, i) => ({
  type: 'related-cards-band',
  background: i % 2 === 0 ? 'paper' : 'paper-2',
  ...(i === 0
    ? { kicker_fr: '§ Les diagnostics disponibles', kicker_en: '§ Available diagnostics' }
    : {}),
  cards: chunk,
}) satisfies SectionByType<'related-cards-band'>);

const sections: SectionData[] = [hero, ...cardBands, ctaFinal];
---

<Base
  title={isFr ? 'Diagnostics IA gratuits · Waimia' : 'Free AI diagnostics · Waimia'}
  description={isFr
    ? 'Diagnostics gratuits pour situer votre maturité IA et la qualité de votre site web avant tout engagement. Une lecture claire, sans argumentaire.'
    : 'Free diagnostics to assess your AI maturity and website quality before any commitment. A clear read, no sales pitch.'}
  noindex={true}
>
  <MastheadBar
    lang={lang}
    items={[
      { label: isFr ? 'Accueil' : 'Home', href: isFr ? '/' : '/en' },
      { label: isFr ? 'Ressources' : 'Resources', href: isFr ? '/ressources' : '/en/ressources' },
      { label: 'Diagnostics' },
    ]}
  />
  <SectionsRenderer sections={sections} lang={lang} />
</Base>
