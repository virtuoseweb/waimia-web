---
export const prerender = true;

// Page SSG · /ressources/diagnostics/[slug] · rendu 100 % composable (registry) ·
// mirror de services/[...slug].astro. MDX sans `sections:` = erreur de build (anti-orphelin).
// Profondeur 3 niveaux (ressources/diagnostics/) → imports en `../../../`.

import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SectionsRenderer from '../../../components/sections/SectionsRenderer.astro';
import MastheadBar from '../../../components/sections/MastheadBar.astro';
import { buildArticle } from '../../../lib/seo/schema-builder';
import { SITE } from '../../../site.config';

export async function getStaticPaths() {
  // `maturite-ia` a sa route explicite (maturite-ia.astro : diagnostic interactif).
  const entries = (await getCollection('diagnostics')).filter((e) => e.id !== 'maturite-ia');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const data = entry.data;

const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fr';
const title = lang === 'en' ? data.title_en : data.title_fr;
const description = lang === 'en' ? data.description_en : data.description_fr;

if (!Array.isArray(data.sections) || data.sections.length === 0) {
  throw new Error(`diagnostics/${entry.id} : frontmatter \`sections:\` requis (page diagnostic composable, anti-orphelin)`);
}

// JSON-LD métier · Article (GEO/AIO) + FAQPage depuis faq_fr/faq_en (miroir de la
// section faq-two-column). BreadcrumbList émis par le composant <MastheadBar>.
const canonicalUrl = `${SITE.url}/ressources/diagnostics/${entry.id}`;
const articleLd = buildArticle({
  headline: title,
  description,
  datePublished: new Date(data.publishedAt).toISOString().slice(0, 10),
  dateModified: data.updatedAt ? new Date(data.updatedAt).toISOString().slice(0, 10) : undefined,
  mainEntityOfPage: canonicalUrl,
});
// FAQPage JSON-LD émis une seule fois par la section catalogue `faq-accordion`
// (source canonique, cf docs/audits #56). La page ne le duplique plus ici.
const pageLd = [articleLd];
---

<Base title={title} description={description} jsonLd={pageLd} noindex={data.seo?.noindex}>
  <MastheadBar
    lang={lang}
    items={[
      { label: lang === 'fr' ? 'Accueil' : 'Home', href: lang === 'fr' ? '/' : '/en' },
      { label: lang === 'fr' ? 'Ressources' : 'Resources', href: lang === 'fr' ? '/ressources' : '/en/ressources' },
      { label: 'Diagnostics', href: lang === 'fr' ? '/ressources/diagnostics' : '/en/ressources/diagnostics' },
      { label: title.split(' · ')[0] },
    ]}
  />
  <SectionsRenderer sections={data.sections!} lang={lang} />
</Base>
