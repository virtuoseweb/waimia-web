---
export const prerender = true;

// Page SSG · /ressources/personas/[slug] · Consumer MDX collection "personas" (Tier 4.1d)
// Bonus SEO : pages personas pour ranking longue-traîne.

import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Kicker from '../../../components/ui/atoms/Kicker.astro';
import Breadcrumb from '../../../components/ui/molecules/Breadcrumb.astro';
import { langFromPath } from '../../../lib/i18n';
import PersonaAttributesGrid from '../../../components/sections/PersonaAttributesGrid.astro';
import type { SectionByType } from '../../../schemas/sections';

export async function getStaticPaths() {
  const entries = await getCollection('personas');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<'personas'> };
const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const data = entry.data;
const lang = langFromPath(Astro.url.pathname);

const title = lang === 'fr' ? data.title_fr : data.title_en;
const role = lang === 'fr' ? data.role_fr : data.role_en;
const pains = lang === 'fr' ? data.pain_points_fr : data.pain_points_en;
const criteria = lang === 'fr' ? data.decision_criteria_fr : data.decision_criteria_en;
const objections = lang === 'fr' ? data.objections_fr : data.objections_en;
const proofs = lang === 'fr' ? data.proof_points_fr : data.proof_points_en;

const attrData = {
  type: 'persona-attributes-grid' as const,
  blocks: [
    {
      kicker_fr: '§ Pain points',
      kicker_en: '§ Pain points',
      items_fr: data.pain_points_fr,
      items_en: data.pain_points_en,
    },
    {
      kicker_fr: '§ Critères de décision',
      kicker_en: '§ Decision criteria',
      items_fr: data.decision_criteria_fr,
      items_en: data.decision_criteria_en,
    },
    {
      kicker_fr: '§ Objections',
      kicker_en: '§ Objections',
      items_fr: data.objections_fr,
      items_en: data.objections_en,
    },
    {
      kicker_fr: '§ Proof points',
      kicker_en: '§ Proof points',
      items_fr: data.proof_points_fr,
      items_en: data.proof_points_en,
    },
  ],
  meta: [
    {
      kicker_fr: '§ Budget',
      kicker_en: '§ Budget',
      value_fr: data.budget_range_fr,
      value_en: data.budget_range_en,
    },
    {
      kicker_fr: '§ Timeline',
      kicker_en: '§ Timeline',
      value_fr: data.timeline_fr,
      value_en: data.timeline_en,
    },
    {
      kicker_fr: '§ Taille entreprise',
      kicker_en: '§ Company size',
      value_fr: data.company_size_fr,
      value_en: data.company_size_en,
    },
  ],
} satisfies SectionByType<'persona-attributes-grid'>;
---
<Base
  title={`${title} · Persona · Waimia`}
  description={lang === 'fr' ? data.description_fr : data.description_en}
>
  <article class="persona-detail">
    <div class="wrap-wide">
      <Breadcrumb
        items={[
          { href: '/ressources', label: lang === 'fr' ? 'Ressources' : 'Resources' },
          { href: '/ressources/personas', label: lang === 'fr' ? 'Personas' : 'Personas' },
          { href: `/ressources/personas/${entry.id}`, label: title, current: true },
        ]}
      />

      <header class="persona-detail__hd">
        <Kicker tone="accent">§ PERSONA</Kicker>
        <h1 class="persona-detail__title">{title}</h1>
        <p class="persona-detail__role">{role}</p>
        <p class="persona-detail__lede">{lang === 'fr' ? data.description_fr : data.description_en}</p>
      </header>

      <PersonaAttributesGrid data={attrData} lang={lang} />

      <section class="persona-detail__content">
        <Content />
      </section>
    </div>
  </article>
</Base>

<style>
  .persona-detail {
    padding-top: calc(var(--spacing-section) + var(--header-height));
    padding-bottom: var(--spacing-section);
  }
  .persona-detail__hd {
    margin: 32px 0 48px;
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 32px;
  }
  .persona-detail__title {
    font-family: var(--font-display);
    font-size: var(--text-h1-hero);
    line-height: 1.02;
    color: var(--ink);
    margin: 16px 0 0;
  }
  .persona-detail__role {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin: 12px 0 0;
  }
  .persona-detail__lede {
    font-family: var(--font-sans);
    font-size: var(--text-lede);
    line-height: 1.5;
    color: var(--ink-2);
    margin: 24px 0 0;
    max-width: 64ch;
  }
  .persona-detail__content {
    max-width: 72ch;
  }
  .persona-detail__content :global(p) {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    line-height: 1.7;
    color: var(--ink-2);
    margin: 0 0 16px;
  }
</style>
