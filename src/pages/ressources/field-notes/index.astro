---
export const prerender = true;

// Page SSG · /ressources/field-notes · Index field notes Waimia
// Post-fusion R1 (docs/audit-refonte/collections.md §F1) : alimentée par blog type === 'field-note'.

import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Kicker from '../../../components/ui/atoms/Kicker.astro';
import Breadcrumb from '../../../components/ui/molecules/Breadcrumb.astro';
import { langFromPath } from '../../../lib/i18n';
import type { SectionByType } from '../../../schemas/sections';
import HeroCentered from '../../../components/sections/HeroCentered.astro';
import { fieldNoteTagLabel } from '../../../lib/blog-routing';

const allBlog = await getCollection('blog');
const entries = allBlog.filter((e) => e.data.type === 'field-note');
const lang = langFromPath(Astro.url.pathname);
const sorted = entries.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const headerData = {
  type: 'hero-hub-masthead' as const,
  variant: 'listing' as const,
  decoration: true,
  align: 'left' as const,
  kicker_fr: '§ Field Notes · Waimia',
  kicker_en: '§ Field Notes · Waimia',
  h1_fr: 'Le <i>carnet de bord</i>',
  h1_en: 'The <i>logbook</i>',
  lede_fr: `${entries.length} notes courtes · cas, recettes, essais, notes. Mis à jour au fil des engagements.`,
  lede_en: `${entries.length} short notes · cases, cookbooks, essays, field notes. Updated as engagements unfold.`,
} satisfies SectionByType<'hero-hub-masthead'>;
---
<Base
  title={lang === 'fr' ? "Field Notes · Carnet de bord Waimia" : "Field Notes · Waimia logbook"}
  description={lang === 'fr' ? "Notes courtes, essais, cas et recettes. Le carnet de bord Waimia, mis à jour au fil des engagements." : "Short notes, essays, cases and cookbooks. Waimia's logbook, updated as engagements unfold."}
>
  <section class="fieldnotes-index">
    <HeroCentered data={headerData} lang={lang} />
    <div class="wrap-tight">
      <Breadcrumb
        items={[
          { href: '/ressources', label: lang === 'fr' ? 'Ressources' : 'Resources' },
          { href: '/ressources/field-notes', label: lang === 'fr' ? 'Field notes' : 'Field notes', current: true },
        ]}
      />

      <ul class="fieldnotes-index__list">
        {sorted.map((entry: any) => {
          const dateStr = new Intl.DateTimeFormat(lang === 'fr' ? 'fr-FR' : 'en-US', {
            day: 'numeric', month: 'long', year: 'numeric'
          }).format(entry.data.publishedAt);
          const tag = fieldNoteTagLabel(entry.data.editorialType, lang);
          return (
            <li class="fieldnotes-index__item">
              <a href={`/ressources/field-notes/${entry.id}`} class="fieldnotes-index__link">
                <div class="fieldnotes-index__meta">
                  <Kicker tone="accent" size={10}>§ {tag}</Kicker>
                  <time class="fieldnotes-index__date">{dateStr}</time>
                </div>
                <h2 class="fieldnotes-index__title">{lang === 'fr' ? entry.data.title_fr : entry.data.title_en}</h2>
                <p class="fieldnotes-index__short">{lang === 'fr' ? entry.data.description_fr : entry.data.description_en}</p>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</Base>

<style>
  .fieldnotes-index {
    padding-top: calc(var(--section-base) + var(--header-height));
    padding-bottom: var(--section-base);
  }
  .fieldnotes-index__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fieldnotes-index__item {
    border-bottom: 1px solid var(--hairline);
  }
  .fieldnotes-index__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5) 0;
    text-decoration: none;
    color: var(--ink);
    transition: background var(--dur-fast) var(--ease);
  }
  .fieldnotes-index__link:hover { background: var(--paper-2); padding-inline: var(--space-4); }
  .fieldnotes-index__meta {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
  }
  .fieldnotes-index__date {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .fieldnotes-index__title {
    font-family: var(--font-display);
    font-size: var(--text-h3-row);
    line-height: 1.2;
    color: var(--ink);
    margin: 0;
  }
  .fieldnotes-index__short {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    color: var(--muted);
    margin: 0;
  }
</style>
