---
export const prerender = true;

// Page SSG · /ressources/field-notes/[slug] · Consumer blog filtré type === 'field-note'
// Post-fusion R1 (docs/audit-refonte/collections.md §F1) : URLs héritées préservées.

import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Kicker from '../../../components/ui/atoms/Kicker.astro';
import Breadcrumb from '../../../components/ui/molecules/Breadcrumb.astro';
import { langFromPath } from '../../../lib/i18n';
import { fieldNoteTagLabel } from '../../../lib/blog-routing';

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  return entries
    .filter((entry) => entry.data.type === 'field-note' && !entry.data.seo?.noindex)
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

type Props = { entry: CollectionEntry<'blog'> };
const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const data = entry.data;
const lang = langFromPath(Astro.url.pathname);
const title = lang === 'fr' ? data.title_fr : data.title_en;
const tag = fieldNoteTagLabel(data.editorialType, lang);
const dateStr = new Intl.DateTimeFormat(lang === 'fr' ? 'fr-FR' : 'en-US', {
  day: 'numeric', month: 'long', year: 'numeric'
}).format(data.publishedAt);
---
<Base title={`${title} · Field Note · Waimia`} description={lang === 'fr' ? data.description_fr : data.description_en}>
  <article class="fieldnote-detail">
    <div class="wrap-tight">
      <Breadcrumb
        items={[
          { href: '/ressources', label: lang === 'fr' ? 'Ressources' : 'Resources' },
          { href: '/ressources/field-notes', label: lang === 'fr' ? 'Field notes' : 'Field notes' },
          { href: `/ressources/field-notes/${entry.id}`, label: title, current: true },
        ]}
      />

      <header class="fieldnote-detail__hd">
        <Kicker tone="accent">§ {tag}</Kicker>
        <h1 class="fieldnote-detail__title">{title}</h1>
        <time class="fieldnote-detail__date" datetime={data.publishedAt.toISOString()}>{dateStr}</time>
      </header>

      <div class="fieldnote-detail__content">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .fieldnote-detail {
    padding-top: calc(var(--section-base) + var(--header-height));
    padding-bottom: var(--section-base);
  }
  .fieldnote-detail__hd {
    margin: var(--space-6) 0 var(--space-8);
    border-bottom: 1px solid var(--hairline);
    padding-bottom: var(--space-5);
  }
  .fieldnote-detail__title {
    font-family: var(--font-display);
    font-size: var(--text-h1-hero);
    line-height: var(--leading-h2);
    color: var(--ink);
    margin: var(--space-4) 0 0;
  }
  .fieldnote-detail__date {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-top: var(--space-4);
    display: block;
  }
  .fieldnote-detail__content {
    margin-top: var(--space-6);
  }
  .fieldnote-detail__content :global(p) {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    line-height: 1.7;
    color: var(--ink-2);
    margin: 0 0 var(--space-4);
  }
  .fieldnote-detail__content :global(pre) {
    background: var(--ink);
    color: var(--paper);
    padding: var(--space-4);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-ui);
    line-height: var(--leading-body);
    margin: var(--space-5) 0;
  }
  .fieldnote-detail__content :global(code) {
    font-family: var(--font-mono);
    font-size: var(--text-ui);
    background: var(--paper-2);
    padding: 2px 6px;
  }
  .fieldnote-detail__content :global(strong) { color: var(--accent-text); }
</style>
