---
export const prerender = true;

import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Kicker from '../../../components/ui/atoms/Kicker.astro';
import Breadcrumb from '../../../components/ui/molecules/Breadcrumb.astro';
import { CLUSTERS } from '../../../data/taxonomies';
import type { SectionByType } from '../../../schemas/sections';
import CtaFinal from '../../../components/sections/CtaFinal.astro';
import { blogEntryHref, blogEntryListType } from '../../../lib/blog-routing';

type ResourceEntry =
  | CollectionEntry<'blog'>
  | CollectionEntry<'cookbooks'>
  | CollectionEntry<'livresBlancs'>
  | CollectionEntry<'cases'>;

type Item = {
  id: string;
  type: string;
  data: ResourceEntry['data'];
  href: string;
};

export async function getStaticPaths() {
  // Post-fusion R1 : la veille IA vit dans blog (type === 'veille-ia'),
  // href + label type-aware via blog-routing.
  const [blog, cookbooks, livresBlancs, cas] = await Promise.all([
    getCollection('blog'),
    getCollection('cookbooks'),
    getCollection('livresBlancs'),
    getCollection('cases'),
  ]);

  const getItems = (slug: string): Item[] => [
    ...blog
      .filter((e) => !e.data.seo?.noindex && e.data.cluster === slug)
      .map((e) => ({ id: e.id, type: blogEntryListType(e), data: e.data, href: blogEntryHref(e) })),
    ...cookbooks
      .filter((e) => !e.data.seo?.noindex && e.data.cluster === slug)
      .map((e) => ({ id: e.id, type: 'cookbook', data: e.data, href: `/ressources/cookbooks/${e.id}` })),
    ...livresBlancs
      .filter((e) => !e.data.seo?.noindex && e.data.cluster === slug)
      .map((e) => ({ id: e.id, type: 'livre-blanc', data: e.data, href: `/ressources/livres-blancs/${e.id}` })),
    ...cas
      .filter((e) => !e.data.seo?.noindex && e.data.cluster === slug)
      .map((e) => ({ id: e.id, type: 'cas', data: e.data, href: `/cas/${e.id}` })),
  ].sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());

  return Object.keys(CLUSTERS).map((slug) => ({
    params: { slug },
    props: { slug, items: getItems(slug) },
  }));
}

type Props = { slug: string; items: Item[] };

const { slug, items } = Astro.props as Props;
const cluster = CLUSTERS[slug];

const pillar = cluster.pillarSlug ? items.find((it) => it.id === cluster.pillarSlug) : null;
const otherItems = pillar ? items.filter((it) => it.id !== pillar.id) : items;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://waimia.com/' },
    { '@type': 'ListItem', position: 2, name: 'Ressources', item: 'https://waimia.com/ressources' },
    { '@type': 'ListItem', position: 3, name: cluster.label.fr },
  ],
};

const collectionPageLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Silo · ${cluster.label.fr} · Waimia`,
};

const ctaData = {
  type: 'cta-final' as const,
  h2_fr: 'Prêt à livrer un <em>agent</em>,<br />pas un slide deck ?',
  h2_en: 'Ready to ship an <em>agent</em>,<br />not a slide deck?',
  body_fr: 'Audit IA en 5 jours. Premier agent en production en 4 semaines. ROI mesuré, jamais estimé.',
  body_en: 'AI audit in 5 days. First agent in production in 4 weeks. Measured ROI, never estimated.',
  cta_primary: { label_fr: 'Réserver un audit →', label_en: 'Book an audit →', href: '/contact', variant: 'primary' as const },
  cta_secondary: { label_fr: 'Voir la pyramide →', label_en: 'See the pyramid →', href: '/offres', variant: 'ghost' as const },
  background: 'paper' as const,
} satisfies SectionByType<'cta-final'>;
---

<Base
  title={`Silo · ${cluster.label.fr} · ${items.length} ressources`}
  description={`Cluster éditorial : ${cluster.label.fr}. ${items.length} ressources liées (pillar + clusters).`}
  jsonLd={[breadcrumbLd, collectionPageLd]}
>
  <Breadcrumb lang="fr" items={[
    { label: 'Accueil', href: '/' },
    { label: 'Ressources', href: '/ressources' },
    { label: cluster.label.fr },
  ]} />
  <section class="silo-mast">
    <div class="wrap-tight">
      <Kicker class="silo-kicker">§ Silo · cluster éditorial · {items.length} ressources</Kicker>
      <h1 class="silo-h1 reveal-mask-up">{cluster.label.fr}</h1>
    </div>
  </section>

  {pillar && (
    <section class="silo-pillar-sec">
      <div class="wrap-tight">
        <Kicker>§ Article pillar</Kicker>
        <a href={pillar.href} class="silo-pillar-card">
          <h2>{pillar.data.title_fr}</h2>
          <p>{pillar.data.description_fr}</p>
          <span>Lire le pillar →</span>
        </a>
      </div>
    </section>
  )}

  <section class="silo-list-sec">
    <div class="wrap-tight">
      <Kicker>§ Articles clusters</Kicker>
      <ul class="silo-list">
        {otherItems.map((it) => (
          <li>
            <a href={it.href}>
              <span class="silo-type">{it.type}</span>
              <span class="silo-title">{it.data.title_fr}</span>
              <span class="silo-date">{new Date(it.data.publishedAt).toLocaleDateString('fr-FR', { year: 'numeric', month: 'short' })}</span>
            </a>
          </li>
        ))}
      </ul>
      {otherItems.length === 0 && <p class="silo-empty">Cluster en construction. Articles à venir.</p>}
    </div>
  </section>
  <CtaFinal data={ctaData} lang="fr" />
</Base>

<style>
  .silo-mast { padding: var(--section-loose) 0 var(--space-9); }
  :global(.silo-kicker) { color: var(--accent-text); margin-bottom: var(--space-5); }
  .silo-h1 {
    font-family: var(--font-display);
    font-size: var(--text-display);
    line-height: .92;
    letter-spacing: -.028em;
    font-weight: var(--fw-regular);
    margin: 0;
  }
  .silo-pillar-sec { padding: var(--space-10) 0; background: var(--paper-2); }
  .silo-pillar-card {
    display: block;
    padding: var(--space-6);
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xs);
    text-decoration: none;
    color: var(--ink);
    margin-top: var(--space-4);
    transition: border-color var(--dur-trim);
  }
  .silo-pillar-card:hover { border-color: var(--accent-text); }
  .silo-pillar-card h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2-tight);
    line-height: 1.05;
    margin: 0 0 var(--space-3);
    font-weight: var(--fw-regular);
  }
  .silo-pillar-card p {
    font-family: var(--font-display);
    font-size: var(--text-body-base);
    line-height: var(--leading-body);
    color: var(--muted);
    font-style: italic;
    margin: 0 0 var(--space-4);
  }
  .silo-pillar-card span {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--accent-text);
    letter-spacing: .08em;
  }
  .silo-list-sec { padding: var(--space-10) 0 var(--section-loose); }
  .silo-list { list-style: none; padding: 0; margin: var(--space-4) 0 0; border-top: 1px solid var(--hairline-strong); }
  .silo-list li { border-bottom: 1px solid var(--hairline); }
  .silo-list a {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    gap: var(--space-5);
    padding: 18px 0;
    color: var(--ink);
    text-decoration: none;
    align-items: baseline;
    transition: padding var(--dur-trim);
  }
  .silo-list a:hover { padding-left: var(--space-2); color: var(--accent-text); }
  .silo-type {
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .silo-title { font-family: var(--font-display); font-size: var(--text-body-md); line-height: 1.35; }
  .silo-date {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .silo-empty { font-family: var(--font-display); font-style: italic; color: var(--muted); padding: var(--space-6) 0; }
  .wrap-tight { max-width: 880px; margin: 0 auto; padding: 0 var(--space-8); }
</style>

<script>
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } }),
    { threshold: 0.08 }
  );
  document.querySelectorAll('.reveal, .reveal-mask-up').forEach((el) => io.observe(el));
</script>
