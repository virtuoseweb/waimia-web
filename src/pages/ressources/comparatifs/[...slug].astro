---
export const prerender = true;

// Page SSG · /ressources/comparatifs/[slug] · rendu 100 % composable (registry) ·
// mirror de ressources/diagnostics/[...slug].astro. MDX sans `sections:` = erreur de build (anti-orphelin).
// Profondeur 3 niveaux (ressources/comparatifs/) → imports en `../../../`.

import { getLiveCollection } from '../../../lib/live-collection';
import Base from '../../../layouts/Base.astro';
import SectionsRenderer from '../../../components/sections/SectionsRenderer.astro';
import MastheadBar from '../../../components/sections/MastheadBar.astro';
import { buildArticle } from '../../../lib/seo/schema-builder';
import { SITE } from '../../../site.config';
import { siloLabel } from '../../../data/taxonomies';

export async function getStaticPaths() {
  const entries = await getLiveCollection('comparatifs');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const data = entry.data;

const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fr';
const title = lang === 'en' ? data.title_en : data.title_fr;
// Titre SEO distinct du H1 quand `seoTitle_*` est renseigné (sinon titre de la page).
const seoTitle = (lang === 'en' ? data.seoTitle_en : data.seoTitle_fr) ?? title;
const description = lang === 'en' ? data.description_en : data.description_fr;

if (!Array.isArray(data.sections) || data.sections.length === 0) {
  throw new Error(`comparatifs/${entry.id} : frontmatter \`sections:\` requis (page composable, anti-orphelin)`);
}

// Sources déclarées au frontmatter : rendues en section `editorial-prose` (type catalogué),
// juste avant `footer-cta-band`. Garde anti-doublon : une section qui porte déjà un
// `<h2>Sources…` (liste écrite à la main) reste telle quelle.
const escHtml = (v: string) =>
  v.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const sourcesList = (data.sources ?? [])
  .map((s) => `<li><a href="${escHtml(s.url)}" rel="noopener" target="_blank">${escHtml(s.name)}</a></li>`)
  .join('');
const hasManualSources = data.sections!.some((s) =>
  [(s as { html_fr?: unknown }).html_fr, (s as { html_en?: unknown }).html_en].some(
    (h) => typeof h === 'string' && /<h2[^>]*>\s*Sources/i.test(h),
  ),
);
const sectionsWithSources: typeof data.sections = (() => {
  const base = data.sections!;
  if (sourcesList === '' || hasManualSources) return base;
  const html = `<h2 id="sources">Sources</h2><ul>${sourcesList}</ul>`;
  const at = base.findIndex((s) => s.type === 'footer-cta-band');
  // Fond opposé à la section qui précède le bloc : jamais deux bandes de même fond accolées
  // (même règle que implantations/[...slug].astro).
  const prev = base[(at === -1 ? base.length : at) - 1] as { background?: string } | undefined;
  const background = (prev?.background ?? 'paper') === 'paper' ? 'paper-2' : 'paper';
  const block = { type: 'editorial-prose', background, html_fr: html, html_en: html } as (typeof base)[number];
  return at === -1 ? [...base, block] : [...base.slice(0, at), block, ...base.slice(at)];
})();

// JSON-LD métier · Article (GEO/AIO) + FAQPage depuis faq_fr/faq_en. BreadcrumbList émis par <MastheadBar>.
const canonicalUrl = `${SITE.url}/ressources/comparatifs/${entry.id}`;
const articleLd = buildArticle({
  headline: title,
  description,
  datePublished: new Date(data.publishedAt).toISOString().slice(0, 10),
  dateModified: data.updatedAt ? new Date(data.updatedAt).toISOString().slice(0, 10) : undefined,
  mainEntityOfPage: canonicalUrl,
  articleSection: siloLabel(data.category, lang),
  citation: data.sources?.map((s) => s.url),
});
// FAQPage JSON-LD émis une seule fois par la section catalogue `faq-accordion`
// (source canonique, cf docs/audits #56). La page ne le duplique plus ici.
const pageLd = [articleLd];
---

<Base title={seoTitle} description={description} jsonLd={pageLd} noindex={data.seo?.noindex}>
  <MastheadBar
    lang={lang}
    items={[
      { label: lang === 'fr' ? 'Accueil' : 'Home', href: lang === 'fr' ? '/' : '/en' },
      { label: lang === 'fr' ? 'Ressources' : 'Resources', href: lang === 'fr' ? '/ressources' : '/en/ressources' },
      { label: 'Comparatifs', href: lang === 'fr' ? '/ressources/comparatifs' : '/en/ressources/comparatifs' },
      { label: title.split(' · ')[0] },
    ]}
  />
  <SectionsRenderer sections={sectionsWithSources!} lang={lang} />
</Base>
