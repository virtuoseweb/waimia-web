---
// Page · /atlas · Direction 3 (Atlas) — V7 refonte hero 2 colonnes
export const prerender = true;

// Pacing : Hero 2-col (copy + mini-map 4 piliers) → AtlasConnections → AtlasGrid → Persona → Cases → FieldNotes → CTA
// V7 : hero tient dans 1 viewport @1440×900, H1 ≤ 96px, mini-map col droite intégrée.

import Base from '../layouts/Base.astro';
import AtlasGrid       from '../components/ui/organisms/AtlasGrid.astro';
import PersonaSwitcher from '../components/ui/organisms/PersonaSwitcher.astro';
import CaseCardGrid    from '../components/sections/CaseCardGrid.astro';
import { caseCardGridData } from '../lib/case-card-grid-data';
import EditorialPreview from '../components/sections/EditorialPreview.astro';
import { editorialPreviewData } from '../lib/editorial-preview-data';
import type { SectionByType } from '../schemas/sections';
import CtaFinal from '../components/sections/CtaFinal.astro';
import AtlasConnections from '../components/motion/AtlasConnections.astro';
import HeroAtlas from '../components/sections/HeroAtlas.astro';
import { heroAtlasData } from '../lib/hero-atlas-data';

import { langFromPath, localizeHref } from '../lib/i18n';
const lang = langFromPath(Astro.url.pathname);

const ctaData = {
  type: 'cta-final' as const,
  h2_fr: 'Prêt à livrer un <em>agent</em>,<br />pas un slide deck ?',
  h2_en: 'Ready to ship an <em>agent</em>,<br />not a slide deck?',
  body_fr: 'Audit IA en 5 jours. Premier agent en production en 4 semaines. ROI mesuré, jamais estimé.',
  body_en: 'AI audit in 5 days. First agent in production in 4 weeks. Measured ROI, never estimated.',
  cta_primary: { label_fr: 'Réserver un audit →', label_en: 'Book an audit →', href: localizeHref('/contact', lang), variant: 'primary' as const },
  cta_secondary: { label_fr: 'Voir la pyramide →', label_en: 'See the pyramid →', href: localizeHref('/offres', lang), variant: 'ghost' as const },
  background: 'paper' as const,
} satisfies SectionByType<'cta-final'>;
---
<Base
  title={lang === 'fr' ? "Waimia · Atlas : quatre portes d'entrée" : 'Waimia · Atlas: four entry doors'}
  description={lang === 'fr'
    ? "Atlas Waimia : quatre piliers (Audit, Adoption, Orchestration, Souveraineté) et trois portes d'entrée par persona (CEO, DSI, CTO)."
    : 'Waimia Atlas: four pillars (Audit, Adoption, Orchestration, Sovereignty) and three entry doors per persona (CEO, CIO, CTO).'}
>
  {/* Hero 2 colonnes · V7 — branché sur HeroAtlas catalogue (data-driven) */}
  <HeroAtlas data={heroAtlasData(lang)} lang={lang} />

  <section class="atlas-howto">
    <div class="atlas-howto-inner">
      <div class="atlas-howto-kicker">
        <span class="atlas-howto-dot" aria-hidden="true"></span>
        {lang === 'fr' ? 'Comment lire cette carte' : 'How to read this map'}
      </div>
      <p class="atlas-howto-prose">
        {lang === 'fr'
          ? <>Sept territoires métier (acquisition, contenu, web, CRM, analytics, marque, automation). Quatre piliers Waimia (Audit, Adoption, Orchestration, Souveraineté). Trois portes d&rsquo;entrée par fonction (CEO, DSI, CTO). <i>Identifiez d&rsquo;abord votre douleur</i>, on déroule l&rsquo;itinéraire ensuite.</>
          : <>Seven business territories (acquisition, content, web, CRM, analytics, brand, automation). Four Waimia pillars (Audit, Adoption, Orchestration, Sovereignty). Three entry doors by role (CEO, CIO, CTO). <i>Identify your pain first</i>, we&rsquo;ll trace the itinerary next.</>}
      </p>
    </div>
  </section>

  <section class="atlas-connections-wrap">
    <div class="atlas-connections-inner">
      <AtlasConnections />
    </div>
  </section>

  <AtlasGrid />
  <PersonaSwitcher />
  <CaseCardGrid data={caseCardGridData('fr')} lang="fr" />
  <EditorialPreview data={editorialPreviewData('fr')} lang="fr" />
  <CtaFinal data={ctaData} lang={lang} />
</Base>

<style>
  /* Section "Comment lire cette carte" */
  .atlas-howto {
    padding: clamp(24px, 3vw, 40px) clamp(20px, 4vw, 48px) clamp(40px, 5vw, 60px);
    border-bottom: 1px solid var(--hairline);
  }
  .atlas-howto-inner {
    max-width: 1500px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
  }
  .atlas-howto-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1;
  }
  .atlas-howto-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--accent);
  }
  .atlas-howto-prose {
    font-family: var(--font-display);
    font-size: clamp(18px, 1.8vw, 24px);
    line-height: var(--leading-lede);
    color: var(--ink);
    margin: 0;
    max-width: 880px;
    text-wrap: pretty;
  }
  .atlas-howto-prose i {
    font-style: italic;
    color: var(--accent);
  }

  /* Section AtlasConnections */
  .atlas-connections-wrap {
    padding: 0 clamp(20px,4vw,48px) clamp(32px,4vw,56px);
  }
  .atlas-connections-inner {
    max-width: 1500px;
    margin: 0 auto;
  }

  @media (max-width: 860px) {
    .atlas-howto-inner {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
