---
// Page · /bienvenue/livre-blanc · Welcome post-download lead magnet
export const prerender = true;

// Template-as-data (V5, 2026-07-19) : contenu en JSON (src/content/legal/bienvenue-livre-blanc.json).
import { getEntry } from 'astro:content';
import WelcomeTemplate from '../../components/templates/WelcomeTemplate.astro';

const entry = await getEntry('legal', 'bienvenue-livre-blanc');
if (!entry) throw new Error('Collection "legal" · entrée "bienvenue-livre-blanc" introuvable.');
const d = entry.data;
---
<WelcomeTemplate
  title={d.title!}
  description={d.description!}
  kicker={d.kicker!}
  nextSteps={d.nextSteps!}
>
  <Fragment slot="headline" set:html={d.headlineHtml} />
  <Fragment slot="lede" set:html={d.ledeHtml} />
</WelcomeTemplate>
