---
// Page · /bienvenue/contact · Welcome post-form contact soumis
export const prerender = true;

// Atterrissage après POST /api/contact réussi (cf api/contact.ts redirect).
// Template-as-data (V5, 2026-07-19) : contenu en JSON (src/content/legal/bienvenue-contact.json).
import { getEntry } from 'astro:content';
import WelcomeTemplate from '../../components/templates/WelcomeTemplate.astro';

const entry = await getEntry('legal', 'bienvenue-contact');
if (!entry) throw new Error('Collection "legal" · entrée "bienvenue-contact" introuvable.');
const d = entry.data;
---

<WelcomeTemplate
  title={d.title!}
  description={d.description!}
  kicker={d.kicker!}
  nextSteps={d.nextSteps!}
>
  <Fragment slot="headline" set:html={d.headlineHtml} />
  <Fragment slot="lede" set:html={d.ledeHtml} />
</WelcomeTemplate>
