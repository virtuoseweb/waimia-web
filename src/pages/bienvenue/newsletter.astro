---
// Page · /bienvenue/newsletter · Welcome post-signup newsletter
export const prerender = true;

// Template-as-data (V5, 2026-07-19) : contenu en JSON (src/content/legal/bienvenue-newsletter.json).
import { getEntry } from 'astro:content';
import WelcomeTemplate from '../../components/templates/WelcomeTemplate.astro';

const entry = await getEntry('legal', 'bienvenue-newsletter');
if (!entry) throw new Error('Collection "legal" · entrée "bienvenue-newsletter" introuvable.');
const d = entry.data;
---
<WelcomeTemplate
  title={d.title!}
  description={d.description!}
  kicker={d.kicker!}
  nextSteps={d.nextSteps!}
>
  <Fragment slot="headline" set:html={d.headlineHtml} />
  <Fragment slot="lede" set:html={d.ledeHtml} />
</WelcomeTemplate>
