    : "Your acquisition rests on a site that doesn't learn, an incomplete CRM and late follow-ups. We wire an intelligent marketing system that captures, qualifies, converts and measures, each step connected to the next. No more spend per channel: one single system that grows the pipeline.",
  provider: { '@id': 'https://waimia.com/#organization' },
  areaServed: ['FR', 'CH', 'BE', 'LU'],
  serviceType: lang === 'fr' ? 'Système marketing intelligent par IA' : 'Intelligent AI marketing system',
};
