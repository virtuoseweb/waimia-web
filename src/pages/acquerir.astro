// page (hero), aucune donnée inventée (pas de prix, pas de date). provider = #organization.
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: lang === 'fr' ? 'Acquérir · Growth System IA' : 'Acquire · Growth System IA',
  description: lang === 'fr'
