---
export const prerender = true;

// Page SSG · /demonstrations · HUB démonstrations · rendu 100 % composable.
// noindex=true : hub mince (politique index-on-quality strategy/10 §3).
// Hero court + cartes via section catalogue `related-cards-band` (.min(2)/.max(3)).
// Collection vide → 0 carte → 0 band (pas de crash).
// Profondeur 2 niveaux (demonstrations/) → imports en `../../`.

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import MastheadBar from '../../components/sections/MastheadBar.astro';
import type { SectionData, SectionByType } from '@waimia/ds-kernel';
import { DEPUBLISHED_DEMONSTRATION_IDS } from '../../data/depublished';

const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fr';
const isFr = lang === 'fr';

type Card = SectionByType<'related-cards-band'>['cards'][number];

const cards: Card[] = (await getCollection('demonstrations'))
  .filter((e) => !DEPUBLISHED_DEMONSTRATION_IDS.has(e.id))
  .sort((a, b) => (a.data.slug ?? a.id).localeCompare(b.data.slug ?? b.id))
  .map((e) => {
    const d = e.data;
    const shortTitle = (full: string) => full.split(' · ')[0].trim();
    return {
      kicker_fr: 'Démonstration',
      kicker_en: 'Demonstration',
      title_fr: shortTitle(d.title_fr),
      title_en: shortTitle(d.title_en),
      lead_fr: d.description_fr,
      lead_en: d.description_en,
      href: `/demonstrations/${d.slug ?? e.id}`,
    };
  });

// Chunker équilibré 2-3 (jamais de singleton) : respecte .min(2)/.max(3) du schéma.
function chunkCards(items: Card[]): Card[][] {
  if (items.length < 2) return [];
  const chunks: Card[][] = [];
  let rest = [...items];
  while (rest.length > 0) {
    if (rest.length === 4) {
      chunks.push(rest.slice(0, 2));
      chunks.push(rest.slice(2, 4));
      rest = [];
    } else if (rest.length <= 3) {
      chunks.push(rest);
      rest = [];
    } else {
      chunks.push(rest.slice(0, 3));
      rest = rest.slice(3);
    }
  }
  return chunks;
}

const hero: SectionByType<'hero-hub-masthead'> = {
  type: 'hero-hub-masthead',
  background: 'paper',
  variant: 'listing',
  decoration: false,
  align: 'left',
  kicker_fr: '§ Démonstrations · voir avant de croire',
  kicker_en: '§ Demonstrations · see before you believe',
  h1_fr: '<span>Démonstrations</span><br/><span><i>concrètes</i>.</span>',
  h1_en: '<span>Concrete</span><br/><span><i>demonstrations</i>.</span>',
  lede_fr: "Des démonstrations réelles de ce que l'IA produit dans votre contexte. Pas de slides : des cas qui tournent, mesurés et reproductibles.",
  lede_en: 'Real demonstrations of what AI produces in your context. No slides: running cases, measured and reproducible.',
};

const ctaFinal: SectionByType<'cta-final'> = {
  type: 'cta-final',
  background: 'ink',
  h2_fr: 'Envie d\'en parler ?',
  h2_en: 'Want to talk about it?',
  body_fr: 'Un diagnostic de 45 minutes, gratuit et sans engagement : on lit votre contexte ensemble et on vous dit vite où sont les leviers.',
  body_en: 'A 45-minute diagnostic, free and with no commitment: we read your context together and tell you quickly where the levers are.',
  cta_primary: {
    label_fr: 'Réserver un diagnostic (45 min) →',
    label_en: 'Book a diagnostic (45 min) →',
    href: '/contact',
    variant: 'primary',
  },
  cta_secondary: {
    label_fr: "Voir l'audit IA pour PME →",
    label_en: 'See the AI audit for SMBs →',
    href: '/audit-ia-pme',
    variant: 'ghost',
  },
};

const cardBands: SectionData[] = chunkCards(cards).map((chunk, i) => ({
  type: 'related-cards-band',
  background: i % 2 === 0 ? 'paper' : 'paper-2',
  ...(i === 0
    ? { kicker_fr: '§ Les démonstrations disponibles', kicker_en: '§ Available demonstrations' }
    : {}),
  cards: chunk,
}) satisfies SectionByType<'related-cards-band'>);

const sections: SectionData[] = [hero, ...cardBands, ctaFinal];
---

<Base
  title={isFr ? 'Démonstrations IA concrètes · Waimia' : 'Concrete AI demonstrations · Waimia'}
  description={isFr
    ? "Des démonstrations réelles de ce que l'IA produit dans votre contexte. Pas de slides : des cas qui tournent, mesurés et reproductibles."
    : 'Real demonstrations of what AI produces in your context. No slides: running cases, measured and reproducible.'}
  noindex={true}
>
  <MastheadBar
    lang={lang}
    items={[
      { label: isFr ? 'Accueil' : 'Home', href: isFr ? '/' : '/en' },
      { label: isFr ? 'Démonstrations' : 'Demonstrations' },
    ]}
  />
  <SectionsRenderer sections={sections} lang={lang} />
</Base>
