---
export const prerender = true;

// Page SSG · /services/[slug] · rendu 100 % composable (registry) · ADR-003.
// MDX sans `sections:` = erreur de build volontaire (anti-orphelin).

import { getCollection } from 'astro:content';
import type { SectionData } from '@waimia/ds-kernel';
import Base from '../../layouts/Base.astro';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import MastheadBar from '../../components/sections/MastheadBar.astro';
import { buildService, buildFAQPage } from '../../lib/seo/schema-builder';
import { meshForServiceCasUsages } from '../../lib/internal-mesh';

export async function getStaticPaths() {
  const entries = await getCollection('services');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const data = entry.data;

const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fr';
const title = lang === 'en' ? data.title_en: data.title_fr;
const description = lang === 'en' ? data.description_en: data.description_fr;

if (!Array.isArray(data.sections) || data.sections.length === 0) {
  throw new Error(`services/${entry.id} : frontmatter \`sections:\` requis (page service composable, anti-orphelin)`);
}

// JSON-LD métier · Service (+ FAQPage depuis faq_fr/faq_en, miroir de la section
// faq-two-column · GEO/AIO). BreadcrumbList émis par le composant <Breadcrumb>.
const serviceLd = buildService({
  name: title,
  description,
  serviceType: data.seo?.serviceType,
  priceRange: data.seo?.priceRange,
  priceMin: data.seo?.priceMin,
  priceMax: data.seo?.priceMax,
});
const faqLd = buildFAQPage(lang === 'en' ? (data as any).faq_en : (data as any).faq_fr);
const pageLd = faqLd ? [serviceLd, faqLd] : [serviceLd];

// Maillage interne SERVICE -> CAS-USAGES (strat 11, GLOBAL via helper · source unique
// internal-mesh.ts). Comble le seul trou du maillage service (le related-cards-band
// existant ne pointe que service->service). On insere la section cataloguee
// `related-links` juste AVANT le climax de fin (footer-cta-band, sinon faq-accordion,
// sinon cta-band/cta-final ; defaut avant-derniere position). 0 lien hardcode.
const baseSections = data.sections as SectionData[];
const meshData = meshForServiceCasUsages(lang);
const meshSection = { ...meshData, background: 'paper-3' as const } as unknown as SectionData;
const endTypes = ['footer-cta-band', 'faq-accordion', 'cta-band', 'cta-final'];
let insertAt = -1;
for (const t of endTypes) {
  insertAt = baseSections.findIndex((s) => s.type === t);
  if (insertAt !== -1) break;
}
if (insertAt === -1) insertAt = baseSections.length <= 1 ? baseSections.length : baseSections.length - 1;
const sections: SectionData[] = [
  ...baseSections.slice(0, insertAt),
  meshSection,
  ...baseSections.slice(insertAt),
];
---

<Base title={title} description={description} jsonLd={pageLd} noindex={data.seo?.noindex}>
  <MastheadBar
    lang={lang}
    items={[
      { label: lang === 'fr' ? 'Accueil' : 'Home', href: lang === 'fr' ? '/' : '/en' },
      { label: 'Services' },
      { label: title.split(' · ')[0] },
    ]}
  />
  <SectionsRenderer sections={sections} lang={lang} />
</Base>
