---
export const prerender = true;

// Page SSG · /services/[slug] · rendu 100 % composable (registry) · ADR-003.
// MDX sans `sections:` = erreur de build volontaire (anti-orphelin).

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import MastheadBar from '../../components/sections/MastheadBar.astro';
import { buildService } from '../../lib/seo/schema-builder';
import { DEPUBLISHED_SERVICE_IDS } from '../../data/depublished';
import { hubChildren } from '../../lib/seo/service-catalog';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  const entries = await getCollection('services');
  // Audit #60 A5 · le gabarit interne `template-service-ref` est exclu du routing
  // (301 → /services dans astro.config.mjs). Le fichier de contenu reste la référence
  // interne de la séquence canonique de sections (le schéma services n'a pas de champ
  // `visible` : on exclut par id, seul gabarit non-livrable de la collection).
  return entries
    // Pivot IA 2026-10 · services fusionnés : même mécanisme (exclusion par id + 301),
    // liste dans src/data/depublished.ts. Les fichiers de contenu sont conservés.
    .filter((entry) => entry.id !== 'template-service-ref' && !DEPUBLISHED_SERVICE_IDS.has(entry.id))
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const data = entry.data;

const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fr';
const title = lang === 'en' ? data.title_en: data.title_fr;
// Titre SEO distinct du H1 quand `seoTitle_*` est renseigné (sinon titre de la page).
const seoTitle = (lang === 'en' ? data.seoTitle_en : data.seoTitle_fr) ?? title;
const description = lang === 'en' ? data.description_en: data.description_fr;

if (!Array.isArray(data.sections) || data.sections.length === 0) {
  throw new Error(`services/${entry.id} : frontmatter \`sections:\` requis (page service composable, anti-orphelin)`);
}

// Sources déclarées au frontmatter : rendues en section `editorial-prose` (type catalogué),
// juste avant `footer-cta-band`. Garde anti-doublon : une section qui porte déjà un
// `<h2>Sources…` (liste écrite à la main) reste telle quelle.
const escHtml = (v: string) =>
  v.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const sourcesList = (data.sources ?? [])
  .map((s) => `<li><a href="${escHtml(s.url)}" rel="noopener" target="_blank">${escHtml(s.name)}</a></li>`)
  .join('');
const hasManualSources = data.sections!.some((s) =>
  [(s as { html_fr?: unknown }).html_fr, (s as { html_en?: unknown }).html_en].some(
    (h) => typeof h === 'string' && /<h2[^>]*>\s*Sources/i.test(h),
  ),
);
const sectionsWithSources: typeof data.sections = (() => {
  const base = data.sections!;
  if (sourcesList === '' || hasManualSources) return base;
  const html = `<h2 id="sources">Sources</h2><ul>${sourcesList}</ul>`;
  const block = { type: 'editorial-prose', background: 'paper', html_fr: html, html_en: html } as (typeof base)[number];
  const at = base.findIndex((s) => s.type === 'footer-cta-band');
  return at === -1 ? [...base, block] : [...base.slice(0, at), block, ...base.slice(at)];
})();

// JSON-LD métier · Service (GEO/AIO). BreadcrumbList émis par le composant <Breadcrumb>.
// Le FAQPage JSON-LD est émis UNE seule fois par la section catalogue `faq-accordion`
// (source canonique, cf docs/audits #56). La page ne le duplique plus ici.
// Prix : `seo.priceMin` / `seo.priceMax` du contenu (affichés par la section de prix de la page).
// Hub : `hasOfferCatalog` liste ses services enfants (source : menu Solutions).
const pagePath = `/services/${entry.id}`;
const children = hubChildren(pagePath);
const serviceLd = buildService({
  name: title,
  description,
  url: `${SITE.url}${pagePath}`,
  serviceType: data.seo?.serviceType,
  ...(children.length > 0 ? { catalog: { name: title.split(' · ')[0], services: children } } : {}),
  priceRange: data.seo?.priceRange,
  priceMin: data.seo?.priceMin,
  priceMax: data.seo?.priceMax,
});
const pageLd = [serviceLd];
---

<Base title={seoTitle} description={description} jsonLd={pageLd} noindex={data.seo?.noindex}>
  <MastheadBar
    lang={lang}
    items={[
      { label: lang === 'fr' ? 'Accueil' : 'Home', href: lang === 'fr' ? '/' : '/en' },
      { label: 'Services' },
      { label: title.split(' · ')[0] },
    ]}
  />
  <SectionsRenderer sections={sectionsWithSources!} lang={lang} />
</Base>
