      price_fr: 'WORKFLOWS',
      price_en: 'WORKFLOWS',
      title_fr: 'Automatisation des processus',
      title_en: 'Process automation',
      lead_fr: 'Les workflows qui suppriment la ressaisie entre vos outils : une donnée saisie une fois circule partout où elle est utile.',
      lead_en: 'Workflows that remove re-keying between your tools: data entered once flows everywhere it is needed.',
      cta_fr: 'Voir le service →',
      cta_en: 'See the service →',
      href: '/services/automatisations',
    },
    {
      price_fr: 'N8N',
      price_en: 'N8N',
      title_fr: 'Automatisation n8n',
      title_en: 'n8n automation',
      lead_fr: 'Conception, mise en production et transfert de workflows n8n branchés à vos outils.',
      lead_en: 'Design, production rollout and handover of n8n workflows connected to your tools.',
