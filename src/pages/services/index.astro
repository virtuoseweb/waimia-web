// 4 · En appui : outils commerciaux et visibilité web (clairement secondaires)
const supportData = {
  type: 'related-cards-band' as const,
  background: 'paper' as const,
  pad_block: 'var(--section-base)',
  kicker_fr: '§ En appui · des outils au service du système',
  kicker_en: '§ In support · tools serving the system',
  cards: [
    {
      kicker_fr: 'OUTILS COMMERCIAUX',
      kicker_en: 'SALES TOOLING',
      title_fr: 'Prospection, CRM et relances automatisés',
      title_en: 'Automated prospecting, CRM and follow-ups',
      lead_fr: 'Les mêmes briques d’automatisation, appliquées au pipeline commercial : prospection, scoring et affectation dans le CRM, séquences de suivi.',
      lead_en: 'The same automation building blocks, applied to the sales pipeline: prospecting, scoring and assignment in the CRM, follow-up sequences.',
      href: '/services/systeme-commercial',
    },
    {
      kicker_fr: 'VISIBILITÉ WEB',
      kicker_en: 'WEB VISIBILITY',
      title_fr: 'Site, référencement Google et moteurs IA',
      title_en: 'Website, Google and AI-engine visibility',
      lead_fr: 'Waimia n’est pas une agence web. Un site rapide et lisible par les moteurs IA reste un outil utile quand il amène la demande que le système traite.',
      lead_en: 'Waimia is not a web agency. A fast site readable by AI engines remains a useful tool when it brings the demand the system processes.',
      href: '/services/systeme-acquisition',
    },
    {
      kicker_fr: 'CAS D’USAGE',
      kicker_en: 'USE CASES',
      title_fr: 'Partir du problème',
      title_en: 'Start from the problem',
      lead_fr: 'Standardiser un processus, centraliser des données, réduire le temps de reporting : les cas d’usage détaillent ce qu’on automatise et comment on mesure le gain.',
      lead_en: 'Standardise a process, centralise data, cut reporting time: the use cases detail what we automate and how the gain is measured.',
      href: '/cas-usages',
    },
  ],
} satisfies SectionByType<'related-cards-band'>;

const ctaData = {
  type: 'cta-final' as const,
  h2_fr: 'Par où <em>commencer</em> ?<br />Un audit gratuit le dit.',
  h2_en: 'Where to <em>start</em>?<br />A free audit tells you.',
  body_fr: 'Quarante-cinq minutes en visio, sans engagement. On passe vos processus en revue et vous repartez avec trois automatisations rentables identifiées.',
  body_en: 'Forty-five minutes on a call, no commitment. We review your processes and you leave with three profitable automations identified.',
  cta_primary: { label_fr: 'Réserver un audit →', label_en: 'Book an audit →', href: AUDIT_BOOKING_HREF, variant: 'primary' as const },
  cta_secondary: { label_fr: 'Voir les réalisations →', label_en: 'See our work →', href: '/cas-clients', variant: 'ghost' as const },
  background: 'ink' as const,
} satisfies SectionByType<'cta-final'>;

// Page composable : séquence de sections rendue par <SectionsRenderer> (registry).
const sections = [
  heroData,
  automationData,
  applicationsData,
  conseilData,
  supportData,
  ctaData,
] satisfies SectionData[];
---
<Base
  title="Solutions : automatisation, agents IA, applications métier · Waimia"
  description="Les prestations du studio Waimia pour PME et ETI : automatisation des processus, agents IA, applications métier, conseil et formation. Audit gratuit."
  jsonLd={solutionsJsonLd}
>

  <div class="wrap-wide" style="padding-top: 24px;">
    <MastheadBar items={[{label:'Accueil', href:'/'}, {label:'Solutions'}]} lang='fr' />
  </div>

  <!-- Séquence composable rendue par le registry (rythme porté par pad_block des sections). -->
  <SectionsRenderer sections={sections} lang="fr" />
</Base>
