const ctaData = {
  type: 'cta-final' as const,
  h2_fr: 'Par où <em>commencer</em> ?<br />Un audit gratuit le dit.',
  h2_en: 'Where to <em>start</em>?<br />A free audit tells you.',
  body_fr: '45 min, gratuit. Vous repartez avec la réponse sur votre site et votre système d\'acquisition, un plan d\'action pour votre objectif, et au moins 2 process à automatiser.',
  body_en: '45 min, free. You leave with the answer on your site and acquisition system, an action plan for your goal, and at least 2 processes to automate.',
  cta_primary: { label_fr: 'Réserver un audit →', label_en: 'Book an audit →', href: '/contact', variant: 'primary' as const },
  cta_secondary: { label_fr: 'Voir les cas clients →', label_en: 'See case studies →', href: '/cas-clients', variant: 'ghost' as const },
  background: 'ink' as const,
} satisfies SectionByType<'cta-final'>;
---
<Base
  title="Solutions · Waimia"
  description="Deux offres porteuses pour les PME : un site web intelligent qui acquiert, une intégration Claude qui standardise. Et l'audit pour savoir par où commencer."
  jsonLd={solutionsJsonLd}
>

  <div class="wrap-wide" style="padding-top: 24px;">
    <MastheadBar items={[{label:'Accueil', href:'/'}, {label:'Solutions'}]} />
  </div>

  <!-- 1. HERO éditorial -->
  <HeroCentered data={heroData} lang="fr" />

  <!-- 2. OFFRE I · SITE WEB INTELLIGENT (dominante) -->
  <div class="offer-rhythm-base">
    <OfferTierGrid data={offerWebData} lang="fr" />
  </div>

  <!-- 3. OFFRE II · INTÉGRATION CLAUDE -->
  <div class="offer-rhythm-base">
    <OfferTierGrid data={offerClaudeData} lang="fr" />
  </div>

  <!-- 4. RÉSOUDRE UN PROBLÈME -->
  <div class="related-rhythm-base">
    <RelatedCardsBand data={relatedProblemsData} lang="fr" />
  </div>

  <!-- 5. CTA BAND · AUDIT GRATUIT -->
  <CtaFinal data={ctaData} lang="fr" />
</Base>

<style>
  /* ── Resserrer le rythme des deux offres consécutives (suppression bandes mortes) ──
     Chaque .tier-section embarque --section-loose en haut ET en bas : entre deux
     offres cela empile du vide non intentionnel. On retombe sur --section-base
     (même famille de rythme, 0 nouveau token) pour que chaque offre reste dense. */
  .offer-rhythm-base :global(.tier-section) {
    padding-top: var(--section-base);
    padding-bottom: var(--section-base);
  }
  /* La bande Problèmes consomme un knob dédié du composant (fallback loose). */
  .related-rhythm-base {
    --related-cards-band-pad: var(--section-base);
  }
</style>
