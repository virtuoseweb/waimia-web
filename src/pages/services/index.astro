---
// Page · /services · Hub Solutions (architecture v8 : 3 systèmes business)
export const prerender = true;

import Base from '../../layouts/Base.astro';
import type { SectionByType, SectionData } from '@waimia/ds-kernel';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import MastheadBar from '../../components/sections/MastheadBar.astro';
import { SITE } from '../../site.config';

const solutionsJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Solutions Waimia : trois systèmes pour les PME',
  description: 'Trois systèmes pour les PME : acquisition de leads, développement commercial et opérations automatisées par l\'IA, sur une seule base.',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Système d\'acquisition', url: `${SITE.url}/services/systeme-acquisition` },
    { '@type': 'ListItem', position: 2, name: 'Système commercial', url: `${SITE.url}/services/systeme-commercial` },
    { '@type': 'ListItem', position: 3, name: 'Systèmes opérationnels et IA', url: `${SITE.url}/services/systemes-operationnels-ia` },
  ],
};

const heroData = {
  type: 'hero-hub-masthead' as const,
  variant: 'hub' as const,
  kicker_fr: '§ Solutions · Waimia',
  kicker_en: '§ Solutions · Waimia',
  h1_fr: 'Trois systèmes.<br/>Une seule <i>base</i>.',
  h1_en: 'Three systems.<br/>One <i>base</i>.',
  lede_fr: 'Acquisition, commercial et opérations : trois systèmes qui se branchent sur une même base, les services qui les composent, et l\'audit pour savoir par où commencer.',
  lede_en: 'Acquisition, sales and operations: three systems that wire onto one base, the services that compose them, and the audit to know where to start.',
  decoration: false as const,
  align: 'left' as const,
} satisfies SectionByType<'hero-hub-masthead'>;

// Bande média éditoriale qui ouvre l'offre I (habillage awwwards : texte étroit + visuel large,
// fond paper pour contraster avec l'OfferTierGrid ink qui suit). Image réelle du catalogue thèmes.
const offerWebMediaData = {
  type: 'feature-split-media' as const,
  background: 'paper' as const,
  proportion: '2-3' as const,
  mediaSide: 'right' as const,
  kicker_fr: 'I · SYSTÈME D\'ACQUISITION',
  kicker_en: 'I · ACQUISITION SYSTEM',
  h2_fr: 'Attirer, capter et qualifier la demande.',
  h2_en: 'Attract, capture and qualify demand.',
  body_fr: 'Site web IA, SEO, GEO et landing pages assemblés en une seule infrastructure. Chaque visite est captée, scorée et qualifiée, puis passée au système commercial.',
  body_en: 'AI website, SEO, GEO and landing pages assembled into one infrastructure. Every visit is captured, scored and qualified, then handed to the commercial system.',
  points: [
    { label_fr: 'Site web IA, SEO et GEO sur une seule base', label_en: 'AI website, SEO and GEO on one base' },
    { label_fr: 'Landing pages qui captent et qualifient', label_en: 'Landing pages that capture and qualify' },
    { label_fr: 'Passation des leads au système commercial', label_en: 'Leads handed to the commercial system' },
  ],
  media_src: '/images/themes/theme-acquisition.webp',
  media_alt_fr: 'Illustration éditoriale : le système d\'acquisition qui attire, capte et qualifie la demande.',
  media_alt_en: 'Editorial illustration: the acquisition system that attracts, captures and qualifies demand.',
  media_caption_fr: 'Acquisition · attirer, capter et qualifier sur une seule base',
  media_caption_en: 'Acquisition · attract, capture and qualify on one base',
  cta_label_fr: 'Voir le système →',
  cta_label_en: 'See the system →',
  cta_href: '/services/systeme-acquisition',
  reversed: false,
} satisfies SectionByType<'feature-split-media'>;

const offerWebData = {
  type: 'offer-tier-grid' as const,
  variant: 'featured' as const,
  background: 'ink' as const,
  wrap: false,
  // Rythme resserré (ex-.offer-rhythm-base page-level) : section-base au lieu de loose.
  pad_block: 'var(--section-base)',
  eyebrow_fr: 'I · SYSTÈME D\'ACQUISITION',
  eyebrow_en: 'I · ACQUISITION SYSTEM',
  h2_fr: 'Générer des leads B2B qualifiés.',
  h2_en: 'Generate qualified B2B leads.',
  lede_fr: 'Site web IA, contenu SEO et GEO, landing pages : une infrastructure qui attire, capte et qualifie la demande, puis alimente le commercial.',
  lede_en: 'AI website, SEO and GEO content, landing pages: an infrastructure that attracts, captures and qualifies demand, then feeds sales.',
  featured_card: {
    eyebrow_fr: 'LE SYSTÈME',
    eyebrow_en: 'THE SYSTEM',
    title_fr: 'Système d\'acquisition',
    title_en: 'Acquisition system',
    sub_fr: 'Attirer, capter et qualifier la demande.',
    sub_en: 'Attract, capture and qualify demand.',
    lead_fr: 'Site web IA, SEO, GEO et landing pages sur une seule base. Chaque visite est captée, scorée et qualifiée, puis passée au système commercial.',
    lead_en: 'AI website, SEO, GEO and landing pages on one base. Every visit is captured, scored and qualified, then handed to the commercial system.',
    cta_fr: 'Voir le système →',
    cta_en: 'See the system →',
    href: '/services/systeme-acquisition',
  },
  offers: [
    {
      price_fr: 'ATTIRER',
      price_en: 'ATTRACT',
      title_fr: 'SEO, GEO et contenu',
      title_en: 'SEO, GEO and content',
      lead_fr: 'Le moteur éditorial qui rend la marque visible sur Google et citable par les IA génératives.',
      lead_en: 'The editorial engine that makes the brand visible on Google and citable by generative AIs.',
      cta_fr: 'Voir le service →',
      cta_en: 'See the service →',
      href: '/services/seo-geo-contenu',
    },
    {
      price_fr: 'CAPTER',
      price_en: 'CAPTURE',
      title_fr: 'Landing pages et tunnels',
      title_en: 'Landing pages and funnels',
      lead_fr: 'Pages par persona et tunnels de qualification : chaque visite est captée, notée et orientée vers ce qui convertit.',
      lead_en: 'Per-persona pages and qualification funnels: every visit is captured, scored and steered toward what converts.',
      cta_fr: 'Voir le service →',
      cta_en: 'See the service →',
      href: '/services/landing-pages-tunnels',
    },
  ],
} satisfies SectionByType<'offer-tier-grid'>;

// Bande média éditoriale qui ouvre l'offre II (média à gauche pour alterner le rythme avec
// la bande de l'offre I, anti-monotonie). Image réelle du catalogue thèmes (productivité).
const offerClaudeMediaData = {
  type: 'feature-split-media' as const,
  background: 'paper' as const,
  proportion: '3-2' as const,
  mediaSide: 'left' as const,
  reversed: true,
  kicker_fr: 'II · SYSTÈMES OPÉRATIONNELS ET IA',
  kicker_en: 'II · OPERATIONAL AND AI SYSTEMS',
  h2_fr: 'L\'IA en <i>production</i>, pas en démo.',
  h2_en: 'AI in <i>production</i>, not in a demo.',
  body_fr: 'Automatisations, agents IA et Claude branché à vos outils via MCP. On exécute le répétitif, on outille vos équipes, on mesure et on trace.',
  body_en: 'Automations, AI agents and Claude wired to your tools via MCP. We run the repetitive, equip your teams, measure and trace.',
  points: [
    { label_fr: 'Workflows qui suppriment la ressaisie', label_en: 'Workflows that remove re-entry' },
    { label_fr: 'Agents branchés à vos outils via MCP', label_en: 'Agents wired to your tools via MCP' },
    { label_fr: 'Périmètre borné, validation humaine, tout tracé', label_en: 'Bounded scope, human validation, everything traced' },
  ],
  media_src: '/images/themes/theme-productivite.webp',
  media_alt_fr: 'Illustration éditoriale : le système opérationnel et l\'IA branchés aux outils de l\'entreprise.',
  media_alt_en: 'Editorial illustration: the operational system and AI wired to the company tools.',
  media_caption_fr: 'Opérations · automatiser le répétitif, outiller les équipes',
  media_caption_en: 'Operations · automate the repetitive, equip the teams',
  cta_label_fr: 'Voir le système →',
  cta_label_en: 'See the system →',
  cta_href: '/services/systemes-operationnels-ia',
} satisfies SectionByType<'feature-split-media'>;

const offerClaudeData = {
  type: 'offer-tier-grid' as const,
  variant: 'standard' as const,
  wrap: true,
  // Rythme resserré (ex-.offer-rhythm-base page-level) : section-base au lieu de loose.
  pad_block: 'var(--section-base)',
  eyebrow_fr: 'II · SYSTÈMES OPÉRATIONNELS ET IA',
  eyebrow_en: 'II · OPERATIONAL AND AI SYSTEMS',
  h2_fr: 'Automatiser et outiller vos opérations.',
  h2_en: 'Automate and equip your operations.',
  lede_fr: 'Automatisations, agents IA et intégration Claude en production : on exécute le répétitif et on outille vos équipes, sur une base gouvernée.',
  lede_en: 'Automations, AI agents and Claude integration in production: we run the repetitive and equip your teams, on a governed base.',
  featured_card: {
    eyebrow_fr: 'LE SYSTÈME',
    eyebrow_en: 'THE SYSTEM',
    title_fr: 'Systèmes opérationnels et IA',
    title_en: 'Operational and AI systems',
    sub_fr: 'L\'IA en production, pas en démo.',
    sub_en: 'AI in production, not in a demo.',
    lead_fr: 'Automatisations, agents IA, intégration Claude et applications internes sur une base gouvernée. On exécute le répétitif, on outille, on mesure.',
    lead_en: 'Automations, AI agents, Claude integration and internal apps on a governed base. We run the repetitive, equip, measure.',
    cta_fr: 'Voir le système →',
    cta_en: 'See the system →',
    href: '/services/systemes-operationnels-ia',
  },
  offers: [
    {
      price_fr: 'EXÉCUTER',
      price_en: 'EXECUTE',
      title_fr: 'Automatisations',
      title_en: 'Automations',
      lead_fr: 'Des workflows qui suppriment la ressaisie entre vos outils : le geste répétitif tourne seul, sans erreur.',
      lead_en: 'Workflows that remove re-entry between your tools: the repetitive gesture runs on its own, without error.',
      cta_fr: 'Voir le service →',
      cta_en: 'See the service →',
      href: '/services/automatisations',
    },
    {
      price_fr: 'RAISONNER',
      price_en: 'REASON',
      title_fr: 'Agents IA',
      title_en: 'AI agents',
      lead_fr: 'Des agents autonomes branchés à vos outils via MCP, sous supervision, mesurés sur le terrain.',
      lead_en: 'Autonomous agents wired to your tools via MCP, under supervision, measured in the field.',
      cta_fr: 'Voir le service →',
      cta_en: 'See the service →',
      href: '/services/agents-ia',
    },
  ],
} satisfies SectionByType<'offer-tier-grid'>;

const relatedProblemsData = {
  type: 'related-cards-band' as const,
  background: 'paper-2' as const,
  // Rythme resserré (ex-.related-rhythm-base page-level) : section-base au lieu de loose.
  pad_block: 'var(--section-base)',
  kicker_fr: '§ Ce que couvre chaque système',
  kicker_en: '§ What each system covers',
  cards: [
    {
      kicker_fr: 'SYSTÈME · ACQUISITION',
      kicker_en: 'SYSTEM · ACQUISITION',
      title_fr: 'Générer des leads B2B qualifiés',
      title_en: 'Generate qualified B2B leads',
      lead_fr: 'Le système d\'acquisition couvre le site web IA, le SEO, le GEO et les landing pages. Il attire, capte et qualifie la demande, puis passe les leads au système commercial.',
      lead_en: 'The acquisition system covers the AI website, SEO, GEO and landing pages. It attracts, captures and qualifies demand, then hands leads to the commercial system.',
      href: '/services/systeme-acquisition',
    },
    {
      kicker_fr: 'SYSTÈME · COMMERCIAL',
      kicker_en: 'SYSTEM · SALES',
      title_fr: 'Transformer vos prospects en clients',
      title_en: 'Turn prospects into customers',
      lead_fr: 'Le système commercial couvre la prospection, le CRM avec scoring et les séquences de suivi. Il alimente le pipeline, qualifie chaque lead et relance au bon moment.',
      lead_en: 'The commercial system covers prospecting, the CRM with scoring and follow-up sequences. It feeds the pipeline, qualifies each lead and follows up at the right time.',
      href: '/services/systeme-commercial',
    },
    {
      kicker_fr: 'SYSTÈME · OPÉRATIONS ET IA',
      kicker_en: 'SYSTEM · OPERATIONS AND AI',
      title_fr: 'Automatiser vos opérations avec l\'IA',
      title_en: 'Automate your operations with AI',
      lead_fr: 'Le système opérationnel et IA couvre les automatisations, les agents IA, l\'intégration Claude et les applications internes. Il exécute le répétitif et outille les équipes sur une base gouvernée.',
      lead_en: 'The operational and AI system covers automations, AI agents, Claude integration and internal apps. It runs the repetitive and equips teams on a governed base.',
      href: '/services/systemes-operationnels-ia',
    },
  ],
} satisfies SectionByType<'related-cards-band'>;

const ctaData = {
  type: 'cta-final' as const,
  h2_fr: 'Par où <em>commencer</em> ?<br />Un audit gratuit le dit.',
  h2_en: 'Where to <em>start</em>?<br />A free audit tells you.',
  body_fr: '45 min, gratuit. Vous repartez avec la réponse sur votre site et votre système d\'acquisition, un plan d\'action pour votre objectif, et au moins 2 process à automatiser.',
  body_en: '45 min, free. You leave with the answer on your site and acquisition system, an action plan for your goal, and at least 2 processes to automate.',
  cta_primary: { label_fr: 'Réserver un audit →', label_en: 'Book an audit →', href: '/contact', variant: 'primary' as const },
  cta_secondary: { label_fr: 'Voir les cas clients →', label_en: 'See case studies →', href: '/cas-clients', variant: 'ghost' as const },
  background: 'ink' as const,
} satisfies SectionByType<'cta-final'>;

// Page composable : séquence de sections rendue par <SectionsRenderer> (registry).
// Le rythme vertical ex-page-level (.offer-rhythm-base / .related-rhythm-base) est
// désormais porté par la prop `pad_block` des sections concernées (0 style page-level).
const sections = [
  heroData,
  offerWebMediaData,
  offerWebData,
  offerClaudeMediaData,
  offerClaudeData,
  relatedProblemsData,
  ctaData,
] satisfies SectionData[];
---
<Base
  title="Solutions IA pour PME : acquisition, commercial et opérations · Waimia"
  description="Trois systèmes IA pour les PME : acquisition de leads, développement commercial et opérations automatisées. L'audit gratuit dit par où commencer."
  jsonLd={solutionsJsonLd}
>

  <div class="wrap-wide" style="padding-top: 24px;">
    <MastheadBar items={[{label:'Accueil', href:'/'}, {label:'Solutions'}]} lang='fr' />
  </div>

  <!-- Séquence composable rendue par le registry (rythme porté par pad_block des sections). -->
  <SectionsRenderer sections={sections} lang="fr" />
</Base>
