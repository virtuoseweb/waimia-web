import { buildServicesHubCatalog } from '../../lib/seo/schema-builder';
import { serviceDomains } from '../../lib/seo/service-catalog';
import { AUDIT_BOOKING_HREF } from '../../data/sitemap';
import { AUDIT_PROMISE } from '../../data/conversion';
import { HOURLY_RATE_EUR, MAINTENANCE_TIERS_EUR } from '../../data/pricing';

// JSON-LD · catalogue des services : les cinq domaines du menu Solutions et leurs pages
// (source unique src/data/sitemap.ts), rattaché à l'Organization par `hasOfferCatalog`.
const solutionsJsonLd = buildServicesHubCatalog(
