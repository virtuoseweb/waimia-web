---
// Page · /services · Hub Solutions (refonte positionnement 2026-10).
// L'offre dans son ordre : (1) automatisation et agents IA, (2) applications métier,
// (3) sites web (décision du 14 octobre 2026 : un métier du studio, plus « en appui »),
// (4) conseil et formation, puis outils commerciaux, visibilité et cas d'usage.
// Les bandes média qui répétaient chaque bloc d'offre ont été retirées (doublon).
export const prerender = true;

import Base from '../../layouts/Base.astro';
import type { SectionByType, SectionData } from '@waimia/ds-kernel';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import MastheadBar from '../../components/sections/MastheadBar.astro';
import { SITE } from '../../site.config';
import { buildServicesHubCatalog } from '../../lib/seo/schema-builder';
import { serviceDomains } from '../../lib/seo/service-catalog';
import { AUDIT_BOOKING_HREF } from '../../data/sitemap';
import { AUDIT_PROMISE, AUDIT_BOOKING_LABEL } from '../../data/conversion';
import { HOURLY_RATE_EUR, MAINTENANCE_TIERS_EUR, PILOT_FLOOR_EUR, SCOPING_SPRINT_EUR, formatEur } from '../../data/pricing';

// JSON-LD · catalogue des services : les domaines du menu Solutions et leurs pages
// (source unique src/data/sitemap.ts), rattaché à l'Organization par `hasOfferCatalog`.
const solutionsJsonLd = buildServicesHubCatalog(
  'Solutions Waimia : automatisation, agents IA et applications métier pour PME',
  `${SITE.url}/services`,
  serviceDomains(),
);

const heroData = {
  type: 'hero-hub-masthead' as const,
  variant: 'hub' as const,
  kicker_fr: '§ Solutions · Waimia',
  kicker_en: '§ Solutions · Waimia',
  h1_fr: 'Services IA pour PME :<br/><i>automatiser, développer, conseiller</i>.',
  h1_en: 'AI services for SMEs:<br/><i>automate, build, advise</i>.',
  lede_fr: "Chaque donnée ressaisie à la main, chaque outil qui ne parle pas à l'autre coûte du temps à vos équipes. Nous relions vos outils, développons les logiciels qui manquent, puis formons vos équipes pour qu'elles gardent la main. À distance, ou sur site dans <a href=\"/implantations\">dix villes en France</a>.",
  lede_en: 'Waimia is an AI development studio and a process automation practice for SMEs. It connects your tools, builds the software that is missing, then trains your teams. Remote or, depending on the project, on site in <a href="/implantations">ten cities across France</a>.',
  decoration: false as const,
  align: 'left' as const,
} satisfies SectionByType<'hero-hub-masthead'>;

// 1 · Automatisation et agents IA (ink, bloc principal)
const automationData = {
  type: 'offer-tier-grid' as const,
  variant: 'featured' as const,
  background: 'ink' as const,
  wrap: false,
  pad_block: 'var(--section-base)',
  eyebrow_fr: 'AUTOMATISATION ET AGENTS IA',
  eyebrow_en: 'AUTOMATION AND AI AGENTS',
  h2_fr: 'Automatiser les processus, y brancher des agents IA.',
  h2_en: 'Automate processes, connect AI agents to them.',
  lede_fr: 'Le cœur de notre travail. Des workflows qui évitent de saisir deux fois la même chose, des agents qui exécutent sous supervision, le tout branché à vos outils et mesuré sur vos données.',
  lede_en: 'The core of the studio. Workflows that remove re-keying, agents that execute under supervision, all connected to your tools and measured on your data.',
  featured_card: {
    eyebrow_fr: 'VUE D’ENSEMBLE',
    eyebrow_en: 'OVERVIEW',
    title_fr: 'Automatisation IA pour PME',
    title_en: 'AI automation for SMEs',
    sub_fr: 'Les modules, leur articulation, les prix.',
    sub_en: 'The modules, how they fit, the prices.',
    lead_fr: 'Workflow, agent ou application interne : ce que fait chaque module, comment ils s’enchaînent et celui par lequel démarrer.',
    lead_en: 'Automations, AI agents, Claude integration, internal applications and reporting: what each module does, how they combine and which to start with.',
    cta_fr: 'Choisir par quel module commencer →',
    cta_en: 'See the automation offer →',
    href: '/services/systemes-operationnels-ia',
  },
  offers: [
    {
      price_fr: 'WORKFLOWS',
      price_en: 'WORKFLOWS',
      title_fr: 'Automatisation des processus',
      title_en: 'Process automation',
      lead_fr: 'Votre équipe ressaisit les mêmes données d’un outil à l’autre ? Nous construisons, sur n8n ou Make, les workflows qui les font circuler.',
      lead_en: 'Workflows that remove re-keying between your tools: data entered once flows everywhere it is needed.',
      cta_fr: 'Supprimer la ressaisie →',
      cta_en: 'See the service →',
      href: '/services/automatisations',
    },
    {
      price_fr: 'N8N',
      price_en: 'N8N',
      title_fr: 'Automatisation n8n',
      title_en: 'n8n automation',
      lead_fr: 'Votre choix est fait pour n8n : nous concevons, mettons en production et transférons des workflows branchés à vos outils.',
      lead_en: 'Design, production rollout and handover of n8n workflows connected to your tools.',
      cta_fr: 'Voir les prix et délais n8n →',
      cta_en: 'See the service →',
      href: '/services/automatisation-n8n',
    },
    {
      price_fr: 'AGENTS',
      price_en: 'AGENTS',
      title_fr: 'Agents IA',
      title_en: 'AI agents',
      lead_fr: 'Des agents sur Claude ou OpenAI qui agissent dans un périmètre défini, avec une validation humaine sur les actions sensibles.',
      lead_en: 'Agents on Claude or OpenAI acting within a defined scope, with human validation on sensitive actions.',
      cta_fr: 'Confier une mission à un agent →',
      cta_en: 'See the service →',
      href: '/services/agents-ia',
    },
  ],
} satisfies SectionByType<'offer-tier-grid'>;

// 2 · Applications métier (paper)
