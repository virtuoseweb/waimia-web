// 3 · Conseil et formation (paper-2)
const conseilData = {
  type: 'offer-tier-grid' as const,
  variant: 'standard' as const,
  background: 'paper-2' as const,
  wrap: true,
  pad_block: 'var(--section-base)',
  eyebrow_fr: 'CONSEIL ET FORMATION',
  eyebrow_en: 'ADVISORY AND TRAINING',
  h2_fr: 'Savoir où investir, puis rendre l’équipe autonome.',
  h2_en: 'Know where to invest, then make the team autonomous.',
  lede_fr: 'Avant le projet : un audit et une feuille de route. Après : des équipes formées. Formations dispensées via Akigora, organisme certifié Qualiopi ; prise en charge possible selon votre situation.',
