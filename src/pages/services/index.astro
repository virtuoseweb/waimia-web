  eyebrow_fr: 'APPLICATIONS MÉTIER',
  eyebrow_en: 'BUSINESS APPLICATIONS',
  h2_fr: 'Développer l’outil qui manque.',
  h2_en: 'Build the tool that is missing.',
  lede_fr: 'Quand le tableur ou le logiciel du marché ne suffit plus, nous développons l’outil. Avant de coder, nous vérifions qu’un outil existant ne fait pas déjà le travail.',
  lede_en: 'When the spreadsheet or off-the-shelf software is no longer enough. Before coding, we check that an existing tool does not already do the job.',
  featured_card: {
    eyebrow_fr: 'DÉVELOPPEMENT SUR MESURE',
    eyebrow_en: 'CUSTOM DEVELOPMENT',
    title_fr: 'Applications internes',
    title_en: 'Internal applications',
    sub_fr: 'Vous gardez le code.',
    sub_en: 'You keep the code.',
    lead_fr: 'Une interface simple, conçue avec ceux qui s’en servent, branchée à vos données et à vos automatisations. Le code est livré et hébergé chez vous.',
    lead_en: 'A simple interface, designed with its users, connected to your data and automations. The code is delivered and hosted on your side.',
    cta_fr: 'Remplacer votre tableur →',
    cta_en: 'See internal applications →',
    href: '/services/applications-internes',
  },
  offers: [
