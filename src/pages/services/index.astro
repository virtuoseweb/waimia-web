---
// Page · /services · Hub Solutions (refonte positionnement 2026-10).
// L'offre dans son ordre : (1) automatisation et agents IA, (2) applications métier,
// (3) conseil et formation, puis en retrait (4) outils commerciaux, (5) visibilité web.
// Les bandes média qui répétaient chaque bloc d'offre ont été retirées (doublon).
export const prerender = true;

import Base from '../../layouts/Base.astro';
import type { SectionByType, SectionData } from '@waimia/ds-kernel';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import MastheadBar from '../../components/sections/MastheadBar.astro';
import { SITE } from '../../site.config';
import { AUDIT_BOOKING_HREF } from '../../data/sitemap';
import { HOURLY_RATE_EUR, MAINTENANCE_TIERS_EUR } from '../../data/pricing';

const solutionsJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Solutions Waimia : automatisation, agents IA et applications métier pour PME',
  description: "Les prestations du studio Waimia pour les PME et ETI : automatisation des processus, agents IA, applications métier, conseil et formation.",
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Automatisation et agents IA', url: `${SITE.url}/services/systemes-operationnels-ia` },
    { '@type': 'ListItem', position: 2, name: 'Applications métier', url: `${SITE.url}/services/applications-internes` },
    { '@type': 'ListItem', position: 3, name: 'Conseil IA', url: `${SITE.url}/services/consultant-ia-claude` },
    { '@type': 'ListItem', position: 4, name: 'Outils commerciaux', url: `${SITE.url}/services/systeme-commercial` },
    { '@type': 'ListItem', position: 5, name: 'Visibilité web', url: `${SITE.url}/services/systeme-acquisition` },
  ],
};

const heroData = {
  type: 'hero-hub-masthead' as const,
  variant: 'hub' as const,
  kicker_fr: '§ Solutions · Waimia',
  kicker_en: '§ Solutions · Waimia',
  h1_fr: 'Automatiser, développer,<br/><i>conseiller</i>.',
  h1_en: 'Automate, build,<br/><i>advise</i>.',
  lede_fr: "Waimia est un studio de développement IA et un cabinet d'automatisation des processus pour PME et ETI. Trois métiers, dans cet ordre. Le site web et la prospection viennent en appui, quand le système en a besoin.",
  lede_en: 'Waimia is an AI development studio and a process automation practice for SMEs. Three trades, in this order. The website and prospecting come in support, when the system needs them.',
