      lead_en: 'Scattered data gathered in one base, and reporting that produces itself.',
      cta_fr: 'Réunir vos données →',
      cta_en: 'See the service →',
      href: '/services/donnees-reporting',
    },
    {
      price_fr: 'SUPPORT',
      price_en: 'SUPPORT',
      title_fr: 'Agent support client',
      title_en: 'Customer support agent',
      lead_fr: 'Un agent qui répond à partir de vos documents, trie les demandes et passe la main à un humain quand il le faut.',
      lead_en: 'An agent that answers from your documents, triages requests and hands over to a human when needed.',
      cta_fr: 'Alléger votre support →',
      cta_en: 'See the service →',
      href: '/services/agent-support-client',
    },
  ],
} satisfies SectionByType<'offer-tier-grid'>;

// 4 · Conseil et formation (paper)
const conseilData = {
  type: 'offer-tier-grid' as const,
  variant: 'standard' as const,
  background: 'paper-2' as const,
  wrap: true,
  pad_block: 'var(--section-base)',
  eyebrow_fr: 'CONSEIL ET FORMATION',
  eyebrow_en: 'ADVISORY AND TRAINING',
  h2_fr: 'Savoir où investir, puis rendre l’équipe autonome.',
  h2_en: 'Know where to invest, then make the team autonomous.',
  lede_fr: 'Avant le projet : un audit et une feuille de route. Après : des équipes formées. Formations dispensées via Akigora, organisme certifié Qualiopi ; prise en charge possible selon votre situation.',
  lede_en: 'Before the project: an audit and a roadmap. After: trained teams. Training delivered through Akigora, a Qualiopi-certified body; funding possible depending on your situation.',
  featured_card: {
    eyebrow_fr: 'PREMIÈRE ÉTAPE',
    eyebrow_en: 'FIRST STEP',
    title_fr: 'Audit IA PME',
    title_en: 'SME AI audit',
    sub_fr: AUDIT_PROMISE.general.tiny.fr,
    sub_en: AUDIT_PROMISE.general.tiny.en,
    lead_fr: 'En visio, nous passons vos processus en revue, tâche par tâche, sans qu’il vous en coûte un euro.',
    lead_en: 'On a video call, we go through your processes task by task. If nothing is worth it today, we tell you.',
    cta_fr: 'Voir le déroulé de l’audit →',
    cta_en: 'More about the audit →',
    href: '/audit-ia-pme',
  },
  offers: [
    {
      price_fr: 'FEUILLE DE ROUTE',
      price_en: 'ROADMAP',
      title_fr: 'Consultant IA',
      title_en: 'AI consultant',
      lead_fr: 'Vous ne savez pas encore où investir : un état des lieux par équipe, trois chantiers au plus, une charte d’usage de l’IA.',
      lead_en: 'An assessment per team, three projects at most, an AI usage policy.',
      cta_fr: 'Obtenir une feuille de route →',
      cta_en: 'See the service →',
      href: '/services/consultant-ia-claude',
    },
    {
      price_fr: 'INTÉGRATION',
      price_en: 'INTEGRATION',
      title_fr: 'Intégration Claude',
      title_en: 'Claude integration',
      lead_fr: 'Vous avez choisi Claude : nous le déployons dans l’entreprise, le branchons à vos outils et formons un référent IA, avec les règles d’usage.',
      lead_en: 'Claude deployed in the company and connected to your tools, with governance and a trained AI lead.',
      cta_fr: 'Déployer Claude →',
      cta_en: 'See the service →',
      href: '/services/integration-claude',
    },
    {
      price_fr: 'PRIX',
      price_en: 'PRICING',
      title_fr: 'Tarifs',
      title_en: 'Pricing',
      lead_fr: `Après l’audit gratuit, le sprint de cadrage coûte ${formatEur(SCOPING_SPRINT_EUR)} HT. Le pilote met en production un premier workflow ou outil, dès ${formatEur(PILOT_FLOOR_EUR)} HT. Ensuite, la maintenance démarre à ${MAINTENANCE_TIERS_EUR[0]} € HT par mois et les interventions se facturent ${HOURLY_RATE_EUR} € HT de l’heure.`,
      lead_en: `Free audit, scoping sprint at 999 € ex VAT, pilot from 2,000 € ex VAT, maintenance from ${MAINTENANCE_TIERS_EUR[0]} € ex VAT a month, extra work at ${HOURLY_RATE_EUR} € ex VAT an hour.`,
      cta_fr: 'Voir les tarifs →',
      cta_en: 'See pricing →',
      href: '/tarifs',
    },
  ],
} satisfies SectionByType<'offer-tier-grid'>;

// 5 · Outils commerciaux, visibilité et cas d'usage (paper-2)
const supportData = {
  type: 'related-cards-band' as const,
  background: 'paper' as const,
  pad_block: 'var(--section-base)',
  kicker_fr: '§ Commercial, visibilité et cas d’usage',
  kicker_en: '§ Sales, visibility and use cases',
  cards: [
    {
      kicker_fr: 'OUTILS COMMERCIAUX',
      kicker_en: 'SALES TOOLING',
      title_fr: 'Prospection, CRM et relances automatisés',
      title_en: 'Automated prospecting, CRM and follow-ups',
      lead_fr: 'Les mêmes briques d’automatisation, appliquées à votre pipeline commercial : prospection, scoring et affectation dans le CRM, séquences de suivi.',
      lead_en: 'The same automation building blocks, applied to the sales pipeline: prospecting, scoring and assignment in the CRM, follow-up sequences.',
      href: '/services/systeme-commercial',
    },
    {
      kicker_fr: 'SITES WEB',
      kicker_en: 'WEBSITES',
      title_fr: 'VirtuoseWeb, agence de création de site web',
      title_en: 'VirtuoseWeb, website design agency',
      lead_fr: 'Création, refonte et référencement de site : c’est le métier de VirtuoseWeb, le studio frère de Waimia.',
      lead_en: 'Website creation, redesign and search: this is the job of VirtuoseWeb, Waimia’s sister studio.',
      href: 'https://virtuoseweb.fr/',
    },
    {
      kicker_fr: 'CAS D’USAGE',
      kicker_en: 'USE CASES',
      title_fr: 'Partir du problème',
      title_en: 'Start from the problem',
      lead_fr: 'Standardiser un processus, centraliser des données, réduire le temps de reporting : chaque cas d’usage dit ce qu’on automatise et comment on mesure le gain.',
      lead_en: 'Standardise a process, centralise data, cut reporting time: the use cases detail what we automate and how the gain is measured.',
      href: '/cas-usages',
    },
  ],
} satisfies SectionByType<'related-cards-band'>;

const ctaData = {
  type: 'cta-final' as const,
  h2_fr: 'Par où <em>commencer</em>&nbsp;?<br />Un audit gratuit le dit.',
  h2_en: 'Where to <em>start</em>?<br />A free audit tells you.',
  body_fr: AUDIT_PROMISE.general.medium.fr,
  body_en: AUDIT_PROMISE.general.medium.en,
  cta_primary: { label_fr: `${AUDIT_BOOKING_LABEL.fr} →`, label_en: `${AUDIT_BOOKING_LABEL.en} →`, href: AUDIT_BOOKING_HREF, variant: 'primary' as const },
  cta_secondary: { label_fr: 'Voir les réalisations →', label_en: 'See our work →', href: '/cas-clients', variant: 'ghost' as const },
  background: 'ink' as const,
} satisfies SectionByType<'cta-final'>;

// Page composable : séquence de sections rendue par <SectionsRenderer> (registry).
const sections = [
  heroData,
  automationData,
  applicationsData,
  conseilData,
  supportData,
  ctaData,
] satisfies SectionData[];
---
<Base
  title="Services IA pour PME : automatisation, agents, logiciels"
  description="Tous les services Waimia pour PME et ETI : automatisation, agents IA, applications métier, conseil, formation. Tarifs affichés, audit gratuit 45 min."
  jsonLd={solutionsJsonLd}
>

  <div class="wrap-wide" style="padding-top: 24px;">
    <MastheadBar items={[{label:'Accueil', href:'/'}, {label:'Solutions'}]} lang='fr' />
  </div>

  <!-- Séquence composable rendue par le registry (rythme porté par pad_block des sections). -->
  <SectionsRenderer sections={sections} lang="fr" />
</Base>
