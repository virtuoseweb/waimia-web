---
// Page · /agence/trust-center · Trust Center
export const prerender = true;

// Source : waimia-handoff2 / trust-center.html
//
// Composé de · TrustLegalTemplate (TOC sticky + sections RGPD/AI Act/ISO/SOC/NDR)
// Sections empilées via slot `sections`.

import TrustLegalTemplate from '../../components/templates/TrustLegalTemplate.astro';
import Bi from '../../components/ui/atoms/Bi.astro';
import Callout from '../../components/editorial/Callout.astro';
import EditorialTable from '../../components/editorial/EditorialTable.astro';

const sections = [
  { id: 'gdpr',   title_fr: 'Règlement Général sur la Protection des Données', title_en: 'GDPR · General Data Protection Regulation' },
  { id: 'ai-act', title_fr: 'Règlement IA Européen',                            title_en: 'EU AI Act' },
  { id: 'iso',    title_fr: 'ISO 27001 · Système de management',                title_en: 'ISO 27001 · Management system' },
  { id: 'soc2',   title_fr: 'SOC 2 · Contrôles sécurité & disponibilité',       title_en: 'SOC 2 · Security & availability controls' },
  { id: 'data',   title_fr: 'Vos données, vos règles',                          title_en: 'Your data, your rules' },
  { id: 'design', title_fr: 'Nos principes de design',                          title_en: 'Our design principles' },
];
---
<TrustLegalTemplate
  title="Trust Center · Conformité, sécurité et traçabilité · Waimia"
  description="Notre politique de sécurité, conformité (RGPD, AI Act, ISO 27001, SOC 2) et de traitement des données pour les agents IA livrés en production."
  kickerFr="Trust Center · Conformité & sécurité"
  kickerEn="Trust Center · Compliance & security"
  revisedAt="2026-04-22"
  version="v3.1"
  sections={sections}
>
  <Fragment slot="headline">
    <i>Où nous</i><br />en sommes.
  </Fragment>
  <Fragment slot="lede">
    Une politique lisible de bout en bout. Pas de page de marketing sécurité. Voici ce qui est appliqué, mesurable, et auditable aujourd'hui.
  </Fragment>

  <Fragment slot="sections">
    <section id="gdpr">
      <h2><Bi fr="Règlement Général sur la Protection des Données" en="General Data Protection Regulation (GDPR)" /></h2>
      <p><Bi
        fr="Waimia est responsable de traitement pour les données qui transitent par VirtuoseOS. Aucune donnée client n'est conservée par les modèles Anthropic (no-retention agreement signé). Les données sont traitées dans la zone EU choisie par le client."
        en="Waimia is data controller for data transiting VirtuoseOS. No client data is retained by Anthropic models (signed no-retention agreement). Data is processed in the EU zone selected by the client."
      /></p>
      <h3><Bi fr="Bases légales" en="Legal bases" /></h3>
      <ul>
        <li><Bi fr="Exécution contractuelle (mission audit, livraison agent)." en="Contract performance (audit mission, agent delivery)." /></li>
        <li><Bi fr="Intérêt légitime (suivi qualité, métriques agrégées)." en="Legitimate interest (quality monitoring, aggregated metrics)." /></li>
        <li><Bi fr="Consentement explicite (newsletter, contact)." en="Explicit consent (newsletter, contact)." /></li>
      </ul>
      <h3><Bi fr="Vos droits" en="Your rights" /></h3>
      <Callout variant="info"><p><Bi fr="Accès, rectification, effacement, portabilité, opposition. Délai de réponse 30 jours. Contact" en="Access, rectification, erasure, portability, objection. 30-day response time. Contact" /> <a href="mailto:dpo@waimia.com">dpo@waimia.com</a>.</p></Callout>
    </section>

    <section id="ai-act">
      <h2><Bi fr={"Règlement IA Européen"} en={"EU AI Act"} /></h2>
      <p><Bi
        fr="VirtuoseOS classe chaque agent livré dans une catégorie AI Act (interdit / haut risque / risque limité / minimal). Les agents haut risque embarquent les obligations associées : trail audit, validation humaine, documentation technique signée."
        en="VirtuoseOS classifies every shipped agent under an AI Act category (prohibited / high-risk / limited / minimal). High-risk agents embed the matching obligations: audit trail, human validation, signed technical documentation."
      /></p>
      <h3><Bi fr="Obligations haut risque" en="High-risk obligations" /></h3>
      <Callout variant="warn"><ul>
        <li><Bi fr="Documentation technique signée (Annexe IV)." en="Signed technical documentation (Annex IV)." /></li>
        <li><Bi fr="Système de gestion de la qualité." en="Quality management system." /></li>
        <li><Bi fr="Traçabilité automatique (trail audit re-rejouable)." en="Automatic traceability (replayable audit trail)." /></li>
        <li><Bi fr="Surveillance humaine sur décisions critiques." en="Human oversight on critical decisions." /></li>
      </ul></Callout>
    </section>

    <section id="iso">
      <h2><Bi fr={"Système de management sécurité"} en={"Security management system"} /></h2>
      <p><Bi
        fr="ISO 27001 en cours de certification. Les contrôles techniques et organisationnels sont mappés sur le référentiel et audités annuellement par un commissaire externe indépendant. Résultats d'audit disponibles sous NDA."
        en="ISO 27001 certification underway. Technical and organizational controls are mapped to the standard and audited annually by an independent external auditor. Audit results available under NDA."
      /></p>
    </section>

    <section id="soc2">
      <h2><Bi fr={"Contrôles SOC 2"} en={"SOC 2 controls"} /></h2>
      <p><Bi
        fr="Type II en cours pour les contrôles availability + confidentiality. Rapport de synthèse disponible sous NDA pour les prospects qualifiés en sourcing : demander à dpo@waimia.com."
        en="Type II in progress for availability + confidentiality controls. Summary report available under NDA for qualified sourcing prospects: request at dpo@waimia.com."
      /></p>
    </section>

    <section id="data">
      <h2><Bi fr={"Vos données,"} en={"Your data,"} /><br /><i>vos règles</i>.</h2>
      {/* Grille de cards sobres 2 col : eyebrow mono + titre serif + corps (scannable, sérieux) */}
      <div class="tc-rules">
        <article class="tc-rule">
          <span class="tc-rule-k">01 · Rétention</span>
          <h3 class="tc-rule-t"><Bi fr={"Pas de rétention Anthropic"} en={"No Anthropic retention"} /></h3>
          <p class="tc-rule-d"><Bi fr="Accord no-retention signé avec Anthropic. Vos données traversent les modèles sans y rester." en="No-retention agreement signed with Anthropic. Your data flows through models without staying." /></p>
        </article>
        <article class="tc-rule">
          <span class="tc-rule-k">02 · Sortie</span>
          <h3 class="tc-rule-t"><Bi fr={"Zéro donnée sortante"} en={"Zero outgoing data"} /></h3>
          <p class="tc-rule-d"><Bi fr="Self-hosted disponible (vLLM/Ollama). Vos données ne quittent jamais votre infrastructure." en="Self-hosted available (vLLM/Ollama). Your data never leaves your infrastructure." /></p>
        </article>
        <article class="tc-rule">
          <span class="tc-rule-k">03 · Minimisation</span>
          <h3 class="tc-rule-t"><Bi fr={"Minimisation appliquée"} en={"Minimization applied"} /></h3>
          <p class="tc-rule-d"><Bi fr="Chaque agent reçoit le minimum de données nécessaires à son rôle. Documenté, signé, audité." en="Each agent receives the minimum data necessary for its role. Documented, signed, audited." /></p>
        </article>
        <article class="tc-rule">
          <span class="tc-rule-k">04 · Résidence</span>
          <h3 class="tc-rule-t"><Bi fr={"Résidence configurable"} en={"Configurable residency"} /></h3>
          <p class="tc-rule-d"><Bi fr="EU-Frankfurt par défaut. CH-Zurich pour clients suisses. US si explicitement choisi." en="EU-Frankfurt by default. CH-Zurich for Swiss clients. US if explicitly chosen." /></p>
        </article>
      </div>
      <EditorialTable
        caption="Sous-traitants de traitement"
        columns={['Sous-traitant', 'Rôle', 'Zone']}
        rows={[
          ['Anthropic', 'Modèles LLM', 'EU (no-retention)'],
          ['Vercel', 'Hébergement web', 'EU/US'],
          ['Resend', 'Emails transactionnels', 'EU'],
        ]}
        variant="default"
      />
    </section>

    <section id="design">
      <h2><Bi fr={"Nos principes"} en={"Our principles"} /><br /><i>de design</i>.</h2>
      {/* Six principes en rangs numérotés serif (séparateurs hairline, scannable) */}
      <ol class="tc-principles">
        <li><span class="tc-principles-n">01</span><h3 class="tc-principles-t"><Bi fr={"Human-in-the-loop sur les décisions critiques"} en={"Human-in-the-loop on critical decisions"} /></h3></li>
        <li><span class="tc-principles-n">02</span><h3 class="tc-principles-t"><Bi fr={"Traçabilité totale, zéro boîte noire"} en={"Full traceability, zero black box"} /></h3></li>
        <li><span class="tc-principles-n">03</span><h3 class="tc-principles-t"><Bi fr={"Scope minimal : l'agent ne fait que ce qu'il doit"} en={"Minimal scope: the agent only does what it should"} /></h3></li>
        <li><span class="tc-principles-n">04</span><h3 class="tc-principles-t"><Bi fr={"Dégradation gracieuse : l'agent échoue prévisiblement"} en={"Graceful degradation: the agent fails predictably"} /></h3></li>
        <li><span class="tc-principles-n">05</span><h3 class="tc-principles-t"><Bi fr={"Explicabilité à la demande"} en={"Explainability on demand"} /></h3></li>
        <li><span class="tc-principles-n">06</span><h3 class="tc-principles-t"><Bi fr={"Tests de biais et d'équité avant déploiement"} en={"Bias and fairness testing before deployment"} /></h3></li>
      </ol>
    </section>
  </Fragment>
</TrustLegalTemplate>

<style is:global>
  /* §data · Vos données : grille de cards sobres 2 col (eyebrow mono + titre serif + corps) */
  .tc-rules {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    margin: var(--space-7) 0;
  }
  .tc-rule {
    background: var(--paper);
    padding: var(--space-6);
  }
  .tc-rule-k {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-3);
  }
  .tc-rule-t {
    font-family: var(--font-display);
    font-size: var(--text-h3-card);
    line-height: var(--leading-h3);
    font-weight: var(--fw-regular);
    color: var(--ink);
    margin: 0 0 var(--space-3);
  }
  .tc-rule-d {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    color: var(--muted);
    margin: 0;
  }

  /* §design · Principes : rangs numérotés serif accent + séparateurs hairline */
  ol.tc-principles {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
  }
  ol.tc-principles li {
    display: grid;
    grid-template-columns: minmax(44px, auto) 1fr;
    column-gap: var(--space-6);
    align-items: baseline;
    padding: var(--space-5) 0;
    border-top: 1px solid var(--hairline);
    margin: 0;
  }
  ol.tc-principles li:last-child { border-bottom: 1px solid var(--hairline); }
  .tc-principles-n {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(24px, 2.6vw, 38px);
    line-height: 0.9;
    letter-spacing: var(--tracking-display);
    color: var(--accent);
  }
  .tc-principles-t {
    font-family: var(--font-sans);
    font-size: var(--text-h3-row);
    font-weight: var(--fw-medium);
    line-height: 1.2;
    color: var(--ink);
    margin: 0;
  }

  @media (max-width: 768px) {
    .tc-rules { grid-template-columns: 1fr; }
  }
</style>
