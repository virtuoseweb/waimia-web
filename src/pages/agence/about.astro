---
// Page · /agence/about · À propos
export const prerender = true;

import UtilityTemplate from '../../components/templates/UtilityTemplate.astro';
import Kicker from '../../components/ui/atoms/Kicker.astro';
import PortraitSimon from '../../components/svg/sumie/PortraitSimon.astro';

const aboutLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: "Le Studio · Pourquoi Waimia · Architecte de systèmes agentiques",
  description: "Un studio IA solo, francophone, basé à Montpellier. On livre des agents qui exécutent, pas des présentations qui tournent en comité.",
  url: `https://waimia.com${Astro.url.pathname}`,
  mainEntity: {
    '@type': 'Person',
    name: 'Simon Beros',
    jobTitle: 'Fondateur',
    worksFor: { '@type': 'Organization', '@id': 'https://waimia.com/#organization' },
  },
};
---
<UtilityTemplate
  title="Le Studio · Pourquoi Waimia · Architecte de systèmes agentiques"
  description="Un studio IA solo, francophone, basé à Montpellier. On livre des agents qui exécutent, pas des présentations qui tournent en comité."
  jsonLd={aboutLd}
  kicker="§ Le Studio"
  align="left"
  headlineFr="Un studio IA solo. <i>Francophone</i>, par choix."
  headlineEn="A solo AI studio. <i>Bilingual</i>, by choice."
  ledeFr="Pas de chaîne offshore. Un praticien qui livre du code le mardi et lit le pipeline le vendredi."
  ledeEn="No offshore chain. No PowerPoint model. A practitioner who ships code on Tuesdays and reads the pipeline on Fridays."
>
  <Fragment slot="body">
    <div class="about-grid reveal-stagger">

      {/* ── Colonne gauche · Narrative 60 % ── */}
      <article class="about-prose">

        <Kicker tone="" class="about-kicker">§ 01 · Origine</Kicker>
        <h2>Un studio né d'une <i>frustration</i> de chantier.</h2>
        <p>Waimia part d'une observation répétée&nbsp;: la plupart des projets IA livrent des démos, pas des produits. Un POC passe en comité, brille en showroom, puis cale en juin.</p>
        <p>L'angle du studio est l'inverse. On livre. On signe. On reste joignable si l'agent tombe. On apprend en faisant, pas en réunissant des comités.</p>

        {/* §02 · Stance : refus en grille à puces serif accent (idiome /agence cells) */}
        <Kicker tone="" class="about-kicker">§ 02 · Stance</Kicker>
        <h2>Ce que nous refusons.</h2>
        <ul class="about-refus">
          <li><span class="about-refus-x" aria-hidden="true">✕</span>Le théâtre IA&nbsp;: purple-glass, cerveau-circuit, hexagones flottants.</li>
          <li><span class="about-refus-x" aria-hidden="true">✕</span>Les ateliers de cadrage sans livrable signé.</li>
          <li><span class="about-refus-x" aria-hidden="true">✕</span>Les pitch decks qui promettent l'impossible et cachent les limites des modèles.</li>
          <li><span class="about-refus-x" aria-hidden="true">✕</span>Les agents non-auditables qui transforment le SaaS en boîte noire.</li>
        </ul>

        {/* §03 · Méthode : quatre livrables en rangs numérotés (idiome MethodTimeline) */}
        <Kicker tone="" class="about-kicker">§ 03 · Méthode</Kicker>
        <h2>Quatre livrables, jamais un de plus.</h2>
        <ol class="about-livrables">
          <li>
            <span class="about-livrables-n">01</span>
            <span class="about-livrables-t">Un schéma de l'existant</span>
            <span class="about-livrables-d">Vos vrais workflows cartographiés, pas vos présentations.</span>
          </li>
          <li>
            <span class="about-livrables-n">02</span>
            <span class="about-livrables-t">Un mode opératoire d'exécution</span>
            <span class="about-livrables-d">Ce que l'agent fait, étape par étape, reproductible.</span>
          </li>
          <li>
            <span class="about-livrables-n">03</span>
            <span class="about-livrables-t">Une trace d'audit rejouable</span>
            <span class="about-livrables-d">Chaque décision tracée, re-rejouable, jamais une boîte noire.</span>
          </li>
          <li>
            <span class="about-livrables-n">04</span>
            <span class="about-livrables-t">Un humain d'astreinte nommé</span>
            <span class="about-livrables-d">Ni slides, ni feuille de route à 18 mois. Un interlocuteur joignable.</span>
          </li>
        </ol>

        <Kicker tone="" class="about-kicker">§ 04 · L'interlocuteur</Kicker>
        <h2>Un <i>humain</i> derrière chaque mission.</h2>
        <p>Simon Beros câble et pilote chaque mission lui-même. Pas d'account manager rotatif, pas d'agence relai&nbsp;: vous parlez directement à celui qui livre. Quand la charge l'exige, le studio s'appuie sur un réseau de partenaires de confiance, nommés au cas par cas.</p>

      </article>

      {/* ── Colonne droite · Preuve 40 % sticky ── */}
      <div class="about-aside">

        <Kicker class="about-aside-k">Faits clés</Kicker>
        <dl class="about-facts">
          <div><dt>Forme</dt><dd>Studio solo · Waimia / VirtuoseWeb</dd></div>
          <div><dt>Fondateur</dt><dd>Simon Beros</dd></div>
          <div><dt>Ancrage</dt><dd>Montpellier (FR) · à distance partout</dd></div>
          <div><dt>Interlocuteur</dt><dd>Direct · celui qui câble est celui qui livre</dd></div>
          <div><dt>Périmètre</dt><dd>PME &amp; ETI · acquisition, CRM, productivité</dd></div>
          <div><dt>Partenariats</dt><dd>Anthropic · Activateur France Num</dd></div>
          <div><dt>Langues</dt><dd>Français + anglais (parité stricte)</dd></div>
        </dl>

        {/* Stats massifs */}
        <div class="about-stats" aria-label="Repères">
          <div class="about-stat">
            <span class="about-stat-n">5 j</span>
            <span class="about-stat-l">du brief à la première mesure</span>
          </div>
          <div class="about-stat">
            <span class="about-stat-n">4 sem</span>
            <span class="about-stat-l">premier agent en production</span>
          </div>
          <div class="about-stat">
            <span class="about-stat-n">1</span>
            <span class="about-stat-l">interlocuteur, pas un comité</span>
          </div>
        </div>

        {/* Portrait décoratif */}
        <div class="about-portrait" aria-hidden="true">
          <PortraitSimon />
        </div>

      </div>
    </div>

    {/* ── CTA FINAL ── */}
    <div class="about-cta reveal">
      <span class="about-cta-eyebrow">§ Travailler avec nous</span>
      <h2 class="about-cta-h2">Quarante-cinq minutes<br/>pour voir si c'est <i>le bon format</i>.</h2>
      <div class="about-cta-btns">
        <a href="/contact" class="about-cta-btn about-cta-btn--primary">Démarrer un diagnostic →</a>
        <a href="/agence/methode" class="about-cta-btn about-cta-btn--ghost">Voir la méthode</a>
      </div>
    </div>
  </Fragment>
</UtilityTemplate>

<style>
  /* ── Grid 60/40 ── */
  .about-grid {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: var(--space-10);
    max-width: 1200px;
  }

  /* ── Prose ── */
  .about-prose {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-prose);
    color: var(--ink-2);
  }
  :global(.about-kicker) { display: block; margin: var(--space-9) 0 var(--space-3); }
  :global(.about-prose > *:first-child) { margin-top: 0; }
  .about-prose h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    line-height: var(--leading-h3);
    letter-spacing: -0.02em;
    font-weight: var(--fw-semibold);
    margin: 0 0 var(--space-4);
    text-wrap: balance;
  }
  .about-prose h2 i { font-style: italic; color: var(--accent-text); }
  .about-prose p { margin: 0 0 1.1em; }
  .about-prose ul { margin: 0 0 1.2em 1.4em; }
  .about-prose ul li { margin-bottom: 0.45em; }
  .about-prose i { font-style: italic; }

  /* §02 · Refus : grille 2 col, puces ✕ accent, hairline (casse la prose) */
  .about-prose ul.about-refus {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
  }
  .about-refus li {
    margin: 0;
    background: var(--paper);
    padding: var(--space-5) var(--space-5) var(--space-5) var(--space-7);
    position: relative;
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--ink-2);
  }
  .about-refus-x {
    position: absolute;
    left: var(--space-5);
    top: var(--space-5);
    font-family: var(--font-mono);
    color: var(--accent-text);
    font-size: var(--text-small);
    line-height: var(--leading-lede);
  }

  /* §03 · Livrables : rangs numérotés serif accent (idiome MethodTimeline) */
  .about-prose ol.about-livrables {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .about-livrables li {
    display: grid;
    grid-template-columns: minmax(48px, auto) 1fr;
    column-gap: var(--space-6);
    align-items: baseline;
    padding: var(--space-5) 0;
    border-top: 1px solid var(--hairline);
  }
  .about-livrables li:last-child { border-bottom: 1px solid var(--hairline); }
  .about-livrables-n {
    grid-row: span 2;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-h2);
    line-height: 0.9;
    letter-spacing: var(--tracking-display);
    color: var(--accent-text);
  }
  .about-livrables-t {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: var(--fw-medium);
    line-height: 1.2;
    color: var(--ink);
  }
  .about-livrables-d {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--muted);
    margin-top: var(--space-2);
    max-width: 46ch;
  }

  /* ── Aside sticky ── */
  .about-aside {
    border-left: 1px solid var(--hairline);
    padding-left: var(--space-7);
    align-self: start;
    position: sticky;
    top: 100px;
  }
  :global(.about-aside-k) { display: block; margin-bottom: 18px; }

  /* Facts dl */
  .about-facts {
    margin: 0 0 var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .about-facts > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--hairline);
  }
  .about-facts > div:last-child { border-bottom: none; }
  .about-facts dt {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .about-facts dd {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    margin: 0;
    line-height: var(--leading-lede);
  }

  /* Stats bloc */
  .about-stats {
    display: flex;
    flex-direction: column;
    gap: 20px;
    border-top: 1px solid var(--hairline);
    padding-top: 28px;
    margin-bottom: 36px;
  }
  .about-stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .about-stat-n {
    font-family: var(--font-sans);
    font-size: var(--text-numeral-md);
    font-weight: 700;
    line-height: 1;
    color: var(--accent-text);
    letter-spacing: -0.03em;
  }
  .about-stat-l {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--muted);
  }

  /* Portrait */
  .about-portrait {
    opacity: 0.6;
    max-width: 180px;
    margin-top: var(--space-5);
  }
  .about-portrait :global(svg) { width: 100%; height: auto; }

  /* Responsive */
  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-prose ul.about-refus { grid-template-columns: 1fr; }
    .about-aside {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--hairline);
      padding-top: var(--space-6);
      position: static;
    }
    .about-stats { flex-direction: row; flex-wrap: wrap; gap: var(--space-5); }
    .about-portrait { display: none; }
  }

  /* ── CTA final ── */
  .about-cta {
    border-top: 1px solid var(--hairline);
    padding-top: var(--space-10);
    margin-top: var(--space-11);
  }
  .about-cta-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--accent-text);
    margin-bottom: var(--space-5);
  }
  .about-cta-h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    line-height: 1.05;
    letter-spacing: -0.015em;
    font-weight: var(--fw-semibold);
    text-wrap: balance;
    margin: 0 0 var(--space-7);
  }
  .about-cta-h2 i { font-style: italic; color: inherit; }
  .about-cta-btns {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    align-items: center;
  }
  .about-cta-btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    padding: var(--space-4) 36px;
    border: 1px solid var(--ink);
    transition: background var(--dur-trim) var(--ease), border-color var(--dur-trim) var(--ease), color var(--dur-trim) var(--ease);
    text-decoration: none;
    white-space: nowrap;
  }
  .about-cta-btn--primary {
    color: var(--paper);
    background: var(--ink);
  }
  .about-cta-btn--primary:hover { background: var(--accent); border-color: var(--accent-text); }
  .about-cta-btn--ghost {
    color: var(--ink);
    background: transparent;
  }
  .about-cta-btn--ghost:hover { background: var(--ink); color: var(--paper); }
</style>
