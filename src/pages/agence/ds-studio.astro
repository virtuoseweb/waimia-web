---
// Page static · /agence/ds-studio · DS STUDIO interactif (B3)
//
// Pourquoi (frustration Simon) : depuis /agence/design-system on VOIT les variables
// et les schémas, mais on ne voit RIEN visuellement et on ne peut pas PERSONNALISER
// pour observer l'impact. Ce Studio répond, à la manière d'ACSS / Core Framework :
//   1. un éditeur de tokens LIVE (édite --accent → tout le rendu change instantanément)
//   2. une galerie visuelle COMPLÈTE (tous les variants de chaque atome/molécule + sections)
//   3. une carte d'impact (token → fichiers consommateurs)
//   4. les doublons & la dette (avant de figer le DS)
//
// NE REMPLACE PAS /agence/design-system (catalogue documentaire). Studio = bac à sable.
// Contraintes : 0 nouveau token CSS · 0 hex/littéral en dur (var/clamp/% only) · 0 U+2014.

export const prerender = true;

import Base from '../../layouts/Base.astro';

// Atomes
import Kicker from '../../components/ui/atoms/Kicker.astro';
import ChapterLabel from '../../components/ui/atoms/ChapterLabel.astro';
import Button from '../../components/ui/atoms/Button.astro';
import PillCTA from '../../components/ui/atoms/PillCTA.astro';
import TerminalCTA from '../../components/ui/atoms/TerminalCTA.astro';
import Bi from '../../components/ui/atoms/Bi.astro';

// Molécules
import SectionHeader from '../../components/ui/molecules/SectionHeader.astro';
import StatRow from '../../components/ui/molecules/StatRow.astro';
import TechPillRow from '../../components/ui/molecules/TechPillRow.astro';
import RelatedCards from '../../components/ui/molecules/RelatedCards.astro';
import NewsletterSignup from '../../components/ui/molecules/NewsletterSignup.astro';
import PainPointInline from '../../components/ui/molecules/PainPointInline.astro';
import ShareButtons from '../../components/ui/molecules/ShareButtons.astro';
import ProofBand from '../../components/ui/molecules/ProofBand.astro';
import TagPills from '../../components/ui/molecules/TagPills.astro';
import Breadcrumb from '../../components/ui/molecules/Breadcrumb.astro';
import PricingTier from '../../components/ui/molecules/PricingTier.astro';
import TerminalMockup from '../../components/ui/molecules/TerminalMockup.astro';

// Sections cataloguées (rendu inline → réactif au token LIVE, contrairement aux iframes)
import { SECTION_REGISTRY, listSections, listCategories } from '../../lib/section-registry';
import { SECTION_DEMOS } from '../../lib/section-demos';
import { sectionSchema } from '../../schemas/sections';
import DsLocalNav from '../../components/library/DsLocalNav.astro';

import registry from '../../data/ds-registry.json';
import sectionManifest from '../../data/ds-section-manifest.json';

const lang = 'fr' as const;

// ── Préparation des contrôles de tokens (groupés) ────────────────────────────
type Token = { name: string; value: string; group: string; comment: string };
const tokens = registry.tokens as Token[];

const GROUP_ORDER = ['color', 'spacing', 'radius', 'type', 'layout', 'shadow', 'motion', 'z'];
const GROUP_LABEL: Record<string, string> = {
  color: 'Couleur', spacing: 'Espacement', radius: 'Rayon', type: 'Typographie',
  layout: 'Layout', shadow: 'Ombre', motion: 'Motion', z: 'Z-index',
};

const isHex = (v: string) => /^#[0-9a-fA-F]{3,8}$/.test(v.trim());
const RANGE_GROUPS = new Set(['spacing', 'radius', 'layout', 'type']);

function parseNumeric(v: string): { num: number; unit: string } | null {
  const m = String(v).trim().match(/^(-?\d*\.?\d+)(px|rem|em|%)?$/);
  if (!m) return null;
  return { num: parseFloat(m[1]), unit: m[2] || '' };
}

type Control =
  | { kind: 'color'; token: Token; def: string }
  | { kind: 'range'; token: Token; def: string; num: number; unit: string; min: number; max: number; step: number }
  | { kind: 'text'; token: Token; def: string };

function buildControl(token: Token): Control {
  const v = token.value;
  if (token.group === 'color' && isHex(v)) return { kind: 'color', token, def: v };
  if (RANGE_GROUPS.has(token.group)) {
    const n = parseNumeric(v);
    if (n && (n.unit === 'px' || n.unit === 'rem')) {
      const max = Math.max(Math.ceil(n.num * 4) || 1, n.num + (n.unit === 'rem' ? 2 : 8));
      const step = n.unit === 'rem' ? 0.05 : 1;
      return { kind: 'range', token, def: String(n.num), num: n.num, unit: n.unit, min: 0, max, step };
    }
  }
  return { kind: 'text', token, def: v };
}

const controlsByGroup = GROUP_ORDER
  .map((g) => ({
    group: g,
    label: GROUP_LABEL[g] ?? g,
    items: tokens.filter((t) => t.group === g).map(buildControl),
  }))
  .filter((b) => b.items.length > 0);

// ── Carte d'impact : token -> { count, files } (île JSON pour le JS) ──────────
type Consumer = { token: string; count: number; files: string[] };
const consumers = registry.tokenConsumers as Consumer[];
const consumerMap: Record<string, { count: number; files: string[] }> = {};
for (const c of consumers) consumerMap[c.token] = { count: c.count, files: c.files };

// ── Inspecteur de token : token -> sections cataloguées qui l'utilisent ───────
// Source : ds-section-manifest.json (lecture seule). Chaque entrée porte
// tokensUsed: [{ name, value }]. On inverse en token -> [type de section]
// pour offrir « ce token est utilisé par N sections : clique pour la voir ».
type ManifestEntry = { id: string; tokensUsed?: { name: string }[] };
const tokenSectionMap: Record<string, string[]> = {};
const knownSectionTypes = new Set(listSections().map((s) => s.type as string));
for (const entry of sectionManifest as ManifestEntry[]) {
  const sectionType = entry.id;
  if (!knownSectionTypes.has(sectionType)) continue; // n'expose que des types navigables
  for (const t of entry.tokensUsed ?? []) {
    const list = (tokenSectionMap[t.name] ??= []);
    if (!list.includes(sectionType)) list.push(sectionType);
  }
}
for (const list of Object.values(tokenSectionMap)) list.sort();

// ── Presets de démonstration soignés (couche C, palette cohérente) ────────────
// Seedés au 1er chargement si l'utilisateur n'a aucun preset perso. Chaque preset
// déplace accent + paper + ink de façon coordonnée (RGB miroir des hex inclus).
const DEMO_PRESETS: Record<string, Record<string, string>> = {
  'Encre & ardoise': {
    '--accent': '#3B6EA5', '--accent-sur-clair': '#2C5681', '--accent-rgb': '59, 110, 165',
    '--paper': '#F2F3F5', '--paper-2': '#E8EAEE', '--paper-3': '#DDE0E6',
    '--ink': '#10151C', '--ink-2': '#1C242F', '--ink-rgb': '16, 21, 28',
  },
  'Forêt sobre': {
    '--accent': '#2F7D5B', '--accent-sur-clair': '#246347', '--accent-rgb': '47, 125, 91',
    '--paper': '#F4F2EC', '--paper-2': '#EBE8DF', '--paper-3': '#E1DDD1',
    '--ink': '#101410', '--ink-2': '#1B221B', '--ink-rgb': '16, 20, 16',
  },
  'Nuit prune': {
    '--accent': '#B5547E', '--accent-sur-clair': '#933F64', '--accent-rgb': '181, 84, 126',
    '--paper': '#F4F1F3', '--paper-2': '#EBE6E9', '--paper-3': '#E1DADF',
    '--ink': '#161019', '--ink-2': '#241B28', '--ink-rgb': '22, 16, 25',
  },
};

const studioData = JSON.stringify({
  consumers: consumerMap,
  tokenSections: tokenSectionMap,
  demoPresets: DEMO_PRESETS,
  originals: Object.fromEntries(tokens.map((token) => [token.name, token.value])),
});

// ── Atelier de section : carte des champs éditables par type ──────────────────
// On introspecte le discriminatedUnion Zod pour récupérer, par type :
//   - background : options de l'enum `background` (ex. paper/paper-2/paper-3/ink)
//   - variants   : tout champ enum dont le nom contient « variant »
//   - texts      : champs texte principaux (titre/kicker/lede), classés par rôle
//     pour cibler un élément DOM générique dans la preview (h1/h2, kicker, lede).
// L'introspection est défensive (try/catch) : un échec n'empêche pas le build.
type WorkshopText = { field: string; role: 'title' | 'kicker' | 'lede'; value: string };
type WorkshopFieldMap = {
  background: string[];
  variants: Record<string, string[]>;
  texts: WorkshopText[];
};

const TITLE_KEYS = ['h1_fr', 'h2_fr', 'title_fr', 'heading_fr', 'name_lead', 'text_fr'];
const KICKER_KEYS = ['kicker_fr', 'eyebrow_fr', 'spec_fr', 'meta_kicker_fr', 'parent_kicker_fr', 'dept_fr', 'tier_fr'];
const LEDE_KEYS = ['lede_fr', 'lead_fr', 'intro_fr', 'context_fr', 'subtitle_fr', 'aside_fr'];

function enumOptions(node: any): string[] | null {
  // Déballe ZodOptional/ZodDefault/ZodNullable, retourne les options si c'est un ZodEnum.
  let cur = node;
  for (let i = 0; cur && i < 6; i += 1) {
    const def = cur._def;
    if (!def) break;
    // ZodEnum : valeurs en `values` (array) ou `entries` (objet) selon la version zod.
    if (Array.isArray(def.values)) return def.values.map(String);
    if (def.entries && typeof def.entries === 'object') {
      const vals = Object.values(def.entries).filter((v) => typeof v === 'string');
      if (vals.length) return vals as string[];
    }
    if (def.innerType) { cur = def.innerType; continue; }
    if (def.schema) { cur = def.schema; continue; }
    if (typeof def.type === 'object' && def.type?._def) { cur = def.type; continue; }
    break;
  }
  return null;
}

const workshopFields: Record<string, WorkshopFieldMap> = {};
let workshopDebug = '';
try {
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  const def = (sectionSchema as any)._def;
  // ZodDiscriminatedUnion · `optionsMap` est une Map<typeLiteral, optionSchema> :
  // la clé EST le type discriminant (source robuste, indépendante de l'accès au literal).
  const entries: Array<[string, any]> = [];
  const optionsMap = def?.optionsMap;
  const isMapLike = optionsMap && typeof optionsMap.forEach === 'function' && typeof optionsMap.size === 'number';
  if (isMapLike) {
    optionsMap.forEach((v: any, k: any) => entries.push([String(k), v]));
  } else if (Array.isArray(def?.options)) {
    for (const opt of def.options) {
      const rs = opt?._def?.shape;
      const sh = typeof rs === 'function' ? rs() : rs;
      // Le literal du discriminant peut être à .value (ZodLiteral) ou dans .values (Set).
      let lit: unknown = sh?.type?._def?.value;
      if (typeof lit !== 'string') {
        const vals = sh?.type?._def?.values;
        if (Array.isArray(vals) && typeof vals[0] === 'string') lit = vals[0];
        else if (vals && typeof vals.values === 'function') {
          const first = [...vals][0]; if (typeof first === 'string') lit = first;
        }
      }
      if (typeof lit === 'string') entries.push([lit, opt]);
    }
  }
  workshopDebug = `entries=${entries.length}`;
  for (const [literal, opt] of entries) {
    const rawShape = opt?._def?.shape;
    const shape = typeof rawShape === 'function' ? rawShape() : (rawShape ?? opt?.shape ?? null);
    if (!shape) continue;
    const demo = SECTION_DEMOS[literal as keyof typeof SECTION_DEMOS] as Record<string, unknown> | undefined;

    const map: WorkshopFieldMap = { background: [], variants: {}, texts: [] };

    const bg = enumOptions(shape.background);
    if (bg) map.background = bg.filter((v) => v !== 'accent'); // 'accent' n'est pas un data-bg générique

    for (const key of Object.keys(shape)) {
      if (key === 'type' || key === 'background') continue;
      if (key.toLowerCase().includes('variant')) {
        const opts = enumOptions(shape[key]);
        if (opts && opts.length) map.variants[key] = opts;
      }
    }

    const pushText = (key: string, role: WorkshopText['role']) => {
      if (!(key in shape)) return;
      const value = demo && typeof demo[key] === 'string' ? (demo[key] as string) : '';
      map.texts.push({ field: key, role, value });
    };
    // Un seul champ par rôle (le 1er présent), pour rester lisible.
    const titleKey = TITLE_KEYS.find((k) => k in shape);
    const kickerKey = KICKER_KEYS.find((k) => k in shape);
    const ledeKey = LEDE_KEYS.find((k) => k in shape);
    if (titleKey) pushText(titleKey, 'title');
    if (kickerKey) pushText(kickerKey, 'kicker');
    if (ledeKey) pushText(ledeKey, 'lede');

    workshopFields[literal] = map;
  }
} catch (err) {
  // Introspection impossible : l'atelier reste fonctionnel pour background générique.
  workshopDebug = `error: ${(err as Error)?.message ?? String(err)}`;
}

const workshopData = JSON.stringify({ fields: workshopFields, debug: workshopDebug });

// Token le plus consommé (sélection initiale de la carte d'impact)
const topConsumer = [...consumers].sort((a, b) => b.count - a.count)[0];

// ── Doublons & dette ─────────────────────────────────────────────────────────
type Dup = { signature: string; classes: string[] };
const duplicateClasses = registry.duplicateClasses as Dup[];
const stats = registry.stats as {
  tokenCount: number; classCount: number; duplicateGroupCount: number; scopedDuplicateGroupCount: number; unusedTokens: string[];
};

// ── Échantillon de sections variées (rendu inline, réactif au LIVE) ──────────
const SECTION_SAMPLE = [
  'hero-split', 'problems-grid', 'stat-block', 'method-timeline', 'feature-grid',
  'pricing-table', 'faq-accordion', 'testimonial-block', 'comparison-table',
  'marquee-band', 'proof-bar', 'services-grid', 'cta-final', 'manifesto-block',
];
const allSectionTypes = new Set(listSections().map((s) => s.type));
const sectionSample = SECTION_SAMPLE
  .filter((t) => allSectionTypes.has(t as any) && SECTION_DEMOS[t as keyof typeof SECTION_DEMOS])
  .map((t) => ({ type: t, C: SECTION_REGISTRY[t as keyof typeof SECTION_REGISTRY] as any, demo: SECTION_DEMOS[t as keyof typeof SECTION_DEMOS] }));

const sectionTotal = listSections().length;

// ── Catalogue complet (browser catégories + types, données registry) ─────────
const catalogCategories = listCategories();
const catalogDefaultType = allSectionTypes.has('hero-split' as any)
  ? 'hero-split'
  : catalogCategories[0]?.sectionTypes[0] ?? '';

// Atomes purement comportementaux (catalogués, pas de rendu statique pertinent)
const behavioralAtoms = [
  { name: 'CursorDot', role: 'Curseur magnétique custom (suit la souris)' },
  { name: 'ScrollProgress', role: 'Barre de progression de lecture (scroll global)' },
  { name: 'ProgressBar', role: 'Barre de progression générique (valeur 0..1)' },
  { name: 'SectionTransition', role: 'Transition inter-sections (hairline animée)' },
  { name: 'FormErrors', role: 'Liste d\'erreurs de formulaire (a11y live region)' },
];

// Compteurs pour le retour de mission
const atomVariantsRendered =
  6 /*Kicker*/ + 2 /*ChapterLabel*/ + 5 /*Button*/ + 3 /*PillCTA*/ + 8 /*TerminalCTA*/ + 1 /*Bi*/;
const moleculesRendered = 12;
---

<Base
  title="DS Studio · éditeur de tokens LIVE · Waimia"
  description="Bac à sable interactif du Design System Waimia : édite une valeur de token et vois tout le rendu changer en direct. Galerie complète des atomes, molécules et sections."
  noindex
>
  <div class="studio">
    <DsLocalNav active="studio" note="Ici : personnaliser les tokens et la DA. La bibliothèque de référence reste le Catalogue." />

    {/* ───────────── En-tête ───────────── */}
    <header class="studio-hd">
      <Kicker class="studio-eyebrow">§ DS Studio · bac à sable token-driven</Kicker>
      <h1 class="studio-h1">Édite un token. <i>Vois</i> tout changer.</h1>
      <p class="studio-lede">
        À la manière d'ACSS : déplace un curseur ou choisis une couleur, et chaque bouton, card et
        section ci-dessous se repeint <strong>en direct</strong> via <code>var(--token)</code>.
        Complémentaire au <a href="/agence/design-system">catalogue documentaire</a>.
      </p>
      <p class="studio-role">
        <strong>Rôle de cette page : personnaliser.</strong> Pour parcourir les composants sans quitter le
        studio : <a href="#catalogue">volet Catalogue ci-dessous</a> ({sectionTotal} sections,
        {catalogCategories.length} catégories). Pour la documentation complète :
        <a href="/agence/design-system">page Catalogue</a>.
      </p>
      <p class="studio-meta">
        {stats.tokenCount} tokens · {stats.classCount} classes · {sectionTotal} sections cataloguées ·
        verrou <code>check:token-lock</code> non-bloquant actif
      </p>
    </header>

    <div class="studio-toolbar" aria-label="Outils du Studio">
      <div class="studio-actions">
        <button id="token-undo" data-action="undo" class="studio-btn" type="button" disabled aria-label="Annuler">↶</button>
        <button id="token-redo" data-action="redo" class="studio-btn" type="button" disabled aria-label="Rétablir">↷</button>
      </div>
      <div class="studio-actions" role="group" aria-label="Viewport de la galerie">
        <button data-viewport="desktop" class="studio-btn is-active" type="button">Desktop</button>
        <button data-viewport="tablet" class="studio-btn" type="button">Tablet</button>
        <button data-viewport="mobile" class="studio-btn" type="button">Mobile</button>
      </div>
    </div>

    <details id="preview-panel" class="studio-tool-panel">
      <summary>Preview page</summary>
      <div class="studio-tool-body">
        <div class="studio-tool-row">
          <label class="studio-tool-field">
            <span>Route</span>
            <select id="preview-route" class="studio-text-input">
              <option value="/">/</option>
              <option value="/acquerir">/acquerir</option>
              <option value="/solutions/acquisition-ia">/solutions/acquisition-ia</option>
              <option value="/ressources/academy">/ressources/academy</option>
            </select>
          </label>
          <button id="preview-refresh" class="studio-btn" type="button">Rafraîchir</button>
        </div>
        <iframe
          id="page-preview"
          class="studio-page-preview"
          title="Preview pleine page"
          loading="lazy"
        ></iframe>
      </div>
    </details>

    <div class="studio-layout">
      {/* ───────────── 1. Éditeur de tokens LIVE (panneau) ───────────── */}
      <aside class="studio-panel" aria-label="Éditeur de tokens">
        <div class="studio-panel-inner">
          <div class="studio-panel-top">
            <h2 class="studio-h3">1 · Éditeur LIVE</h2>
            <div class="studio-actions">
              <button id="token-reset" data-action="reset" class="studio-btn" type="button">Reset</button>
              <button id="token-export" data-action="export" class="studio-btn studio-btn--accent" type="button">
                Exporter · <span id="export-count">0</span> modifiés
              </button>
            </div>
          </div>

          {/* Enregistrer (déployer) : DEV-ONLY : POST /api/ds/save (commit + push +
              rebuild preview). Le middleware n'existe que sous `astro dev`. */}
          <div class="studio-save">
            <label class="studio-save-field">
              <span class="studio-vh">Mot-clé de sauvegarde</span>
              <input
                type="password"
                data-save-keyword
                class="studio-text-input studio-text-input--wide"
                placeholder="mot-clé de sauvegarde"
                autocomplete="off"
              />
            </label>
            <button id="token-save" data-action="save" class="studio-btn studio-btn--save" type="button">
              Enregistrer (déployer)
            </button>
          </div>

          <label class="studio-search">
            <span class="studio-vh">Filtrer les tokens</span>
            <input id="token-search" type="search" placeholder="Filtrer : accent, space, radius…" autocomplete="off" />
          </label>

          <details class="studio-side-tool" open>
            <summary>Contraste</summary>
            <div id="contrast-list" class="studio-contrast-list" aria-live="polite"></div>
          </details>

          <details class="studio-side-tool">
            <summary>Thèmes &amp; presets</summary>
            <div class="studio-preset-create">
              <input id="preset-name" class="studio-text-input" type="text" placeholder="Nom du thème" />
              <button id="preset-save" class="studio-btn" type="button">Sauver l'état courant</button>
            </div>
            <div class="studio-preset-io">
              <button id="preset-export" class="studio-btn" type="button">Exporter (.json)</button>
              <button id="preset-import" class="studio-btn" type="button">Importer</button>
              <input id="preset-import-file" type="file" accept="application/json,.json" hidden />
              <button id="preset-seed" class="studio-btn" type="button">Charger les thèmes de démo</button>
            </div>
            <div id="preset-list" class="studio-preset-list"></div>
          </details>

          {/* ── Comparateur avant/après ─────────────────────────────────── */}
          <details id="compare-tool" class="studio-side-tool">
            <summary>Comparateur avant / après <span id="compare-count" class="studio-compare-tag">0</span></summary>
            <div class="studio-compare-body">
              <button id="compare-baseline" class="studio-btn studio-compare-hold" type="button" aria-pressed="false">
                Maintenir pour voir la baseline
              </button>
              <p class="studio-compare-help">
                Maintiens le bouton (ou la touche <kbd>B</kbd>) : tous tes overrides se retirent
                temporairement pour comparer avec l'état d'origine. Relâche pour revenir.
              </p>
              <div id="compare-diff" class="studio-compare-diff" aria-live="polite"></div>
            </div>
          </details>

          <div class="studio-groups">
            {controlsByGroup.map((block) => (
              <section class="studio-group" data-group-block={block.group}>
                <h3 class="studio-group-title">{block.label} <span>{block.items.length}</span></h3>
                <div class="studio-rows">
                  {block.items.map((ctrl) => (
                    <div class="studio-row" data-token-row={ctrl.token.name} data-group={block.group} title={ctrl.token.comment}>
                      <button class="studio-row-name" type="button">{ctrl.token.name}</button>
                      <div class="studio-row-ctrl">
                        {ctrl.kind === 'color' && (
                          <>
                            <input
                              type="color"
                              class="studio-swatch-input"
                              data-token={ctrl.token.name}
                              data-default={ctrl.def}
                              value={ctrl.def}
                              aria-label={`Couleur ${ctrl.token.name}`}
                            />
                            <input
                              type="text"
                              class="studio-text-input"
                              data-token={ctrl.token.name}
                              data-default={ctrl.def}
                              value={ctrl.def}
                              aria-label={`Valeur ${ctrl.token.name}`}
                            />
                          </>
                        )}
                        {ctrl.kind === 'range' && (
                          <>
                            <input
                              type="range"
                              class="studio-range"
                              data-token={ctrl.token.name}
                              data-unit={ctrl.unit}
                              data-default={ctrl.def}
                              min={ctrl.min}
                              max={ctrl.max}
                              step={ctrl.step}
                              value={ctrl.num}
                              aria-label={`Ajuster ${ctrl.token.name}`}
                            />
                            <input
                              type="number"
                              class="studio-num"
                              data-token={ctrl.token.name}
                              data-unit={ctrl.unit}
                              data-default={ctrl.def}
                              min={ctrl.min}
                              max={ctrl.max}
                              step={ctrl.step}
                              value={ctrl.num}
                              aria-label={`Valeur ${ctrl.token.name}`}
                            />
                            <span class="studio-unit">{ctrl.unit}</span>
                          </>
                        )}
                        {ctrl.kind === 'text' && (
                          <input
                            type="text"
                            class="studio-text-input studio-text-input--wide"
                            data-token={ctrl.token.name}
                            data-default={ctrl.def}
                            value={ctrl.def}
                            aria-label={`Valeur ${ctrl.token.name}`}
                          />
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              </section>
            ))}
          </div>

          <pre id="export-output" class="studio-export-out" aria-live="polite"></pre>
        </div>
      </aside>

      {/* ───────────── Galerie + impact + dette ───────────── */}
      <main class="studio-main studio-gallery">
        {/* Carte d'impact (sticky en haut du contenu) */}
        <section class="studio-impact" aria-label="Carte d'impact">
          <ChapterLabel num="FIG · 0" title="Impact d'un token" tone="muted" />
          <p class="studio-impact-help">
            Clique un token dans l'éditeur. « Si tu changes <code id="impact-token">{topConsumer?.token}</code>,
            ça impacte <strong id="impact-count">{topConsumer?.count ?? 0}</strong> fichiers. »
          </p>
          <ul id="impact-list" class="studio-impact-list">
            {(topConsumer?.files ?? []).map((f) => <li>{f}</li>)}
          </ul>

          {/* Inspecteur : sections cataloguées qui consomment ce token (manifest) */}
          <div class="studio-inspector">
            <p class="studio-inspector-help">
              <strong id="inspector-count">{tokenSectionMap[topConsumer?.token ?? '']?.length ?? 0}</strong>
              sections du catalogue utilisent <code id="inspector-token">{topConsumer?.token}</code>.
              Clique l'une d'elles : elle se charge dans l'aperçu du
              <a href="#catalogue">catalogue</a> et hérite de tes overrides.
            </p>
            <ul id="inspector-sections" class="studio-inspector-list">
              {(tokenSectionMap[topConsumer?.token ?? ''] ?? []).map((type) => (
                <li><button type="button" class="studio-inspector-btn" data-inspector-type={type}>{type}</button></li>
              ))}
            </ul>
          </div>
        </section>

        {/* 2. Galerie · Atomes */}
        <section class="studio-section">
          <ChapterLabel num="01" title={`Atomes · ${atomVariantsRendered} variants rendus`} />
          <p class="studio-section-lede">Chaque variant de chaque atome, rendu et réactif au panneau LIVE.</p>

          <h3 class="studio-h4">Kicker · tone × size</h3>
          <div class="studio-tiles">
            <article class="studio-tile"><Kicker tone="muted">§ Tone muted</Kicker><code class="studio-tag">tone="muted"</code></article>
            <article class="studio-tile"><Kicker tone="accent">§ Tone accent</Kicker><code class="studio-tag">tone="accent"</code></article>
            <article class="studio-tile studio-tile--dark"><Kicker tone="dim">§ Tone dim (on dark)</Kicker><code class="studio-tag">tone="dim"</code></article>
            <article class="studio-tile"><Kicker tone="muted" size={10}>§ Size 10</Kicker><code class="studio-tag">size={'{10}'}</code></article>
            <article class="studio-tile"><Kicker tone="accent" size={14}>§ Size 14</Kicker><code class="studio-tag">size={'{14}'}</code></article>
            <article class="studio-tile"><Kicker tone="muted" textTransform="none">§ Transform none</Kicker><code class="studio-tag">textTransform="none"</code></article>
          </div>

          <h3 class="studio-h4">ChapterLabel · tone</h3>
          <div class="studio-tiles">
            <article class="studio-tile"><ChapterLabel num="II · 2.0" title="Acte II · variant muted" tone="muted" /><code class="studio-tag">tone="muted"</code></article>
            <article class="studio-tile studio-tile--dark"><ChapterLabel num="IV · 4.0" title="Acte IV · variant dim" tone="dim" /><code class="studio-tag">tone="dim"</code></article>
          </div>

          <h3 class="studio-h4">Button · variant × size</h3>
          <div class="studio-tiles">
            <article class="studio-tile"><Button href="#" variant="primary">Primary</Button><code class="studio-tag">variant="primary"</code></article>
            <article class="studio-tile"><Button href="#" variant="ghost">Ghost</Button><code class="studio-tag">variant="ghost"</code></article>
            <article class="studio-tile"><Button href="#" variant="accent">Accent</Button><code class="studio-tag">variant="accent"</code></article>
            <article class="studio-tile"><Button href="#" variant="link">Link →</Button><code class="studio-tag">variant="link"</code></article>
            <article class="studio-tile"><Button href="#" variant="primary" size="lg" mag={0.18}>Primary · lg · magnetic</Button><code class="studio-tag">size="lg" mag</code></article>
          </div>

          <h3 class="studio-h4">PillCTA · variant</h3>
          <div class="studio-tiles">
            <article class="studio-tile"><PillCTA href="#" variant="accent">Pill accent</PillCTA><code class="studio-tag">variant="accent"</code></article>
            <article class="studio-tile studio-tile--dark"><PillCTA href="#" variant="ghost-dark">Pill ghost-dark</PillCTA><code class="studio-tag">variant="ghost-dark"</code></article>
            <article class="studio-tile"><PillCTA href="#" variant="accent-mono">▸ Pill accent-mono</PillCTA><code class="studio-tag">variant="accent-mono"</code></article>
          </div>

          <h3 class="studio-h4">TerminalCTA · variant × size</h3>
          <div class="studio-tiles">
            <article class="studio-tile"><TerminalCTA href="#" variant="ink">▸ ink</TerminalCTA><code class="studio-tag">ink · md</code></article>
            <article class="studio-tile"><TerminalCTA href="#" variant="ink-ghost">ink-ghost →</TerminalCTA><code class="studio-tag">ink-ghost · md</code></article>
            <article class="studio-tile studio-tile--dark"><TerminalCTA href="#" variant="accent">▸ accent</TerminalCTA><code class="studio-tag">accent · md</code></article>
            <article class="studio-tile studio-tile--dark"><TerminalCTA href="#" variant="ghost-dark">ghost-dark →</TerminalCTA><code class="studio-tag">ghost-dark · md</code></article>
            <article class="studio-tile"><TerminalCTA href="#" variant="ink" size="sm">▸ ink sm</TerminalCTA><code class="studio-tag">ink · sm</code></article>
            <article class="studio-tile"><TerminalCTA href="#" variant="ink-ghost" size="sm">ink-ghost sm →</TerminalCTA><code class="studio-tag">ink-ghost · sm</code></article>
            <article class="studio-tile studio-tile--dark"><TerminalCTA href="#" variant="accent" size="sm">▸ accent sm</TerminalCTA><code class="studio-tag">accent · sm</code></article>
            <article class="studio-tile studio-tile--dark"><TerminalCTA href="#" variant="ghost-dark" size="sm">ghost-dark sm →</TerminalCTA><code class="studio-tag">ghost-dark · sm</code></article>
          </div>

          <h3 class="studio-h4">Bi · contenu bilingue</h3>
          <div class="studio-tiles">
            <article class="studio-tile"><p><Bi fr="Rendu côté FR" en="Rendered EN side" /></p><code class="studio-tag">{'<Bi fr en />'}</code></article>
          </div>

          <h3 class="studio-h4">Atomes comportementaux (catalogués)</h3>
          <div class="studio-tiles">
            {behavioralAtoms.map((a) => (
              <article class="studio-tile studio-tile--note">
                <span class="studio-note-name">{a.name}</span>
                <span class="studio-note-role">{a.role}</span>
              </article>
            ))}
          </div>
        </section>

        {/* 2bis. Galerie · Molécules */}
        <section class="studio-section">
          <ChapterLabel num="02" title={`Molécules · ${moleculesRendered} rendues`} />
          <p class="studio-section-lede">Variants principaux de chaque molécule, données de démo FR.</p>

          <div class="studio-mol">
            <h3 class="studio-h4">SectionHeader · tone</h3>
            <div class="studio-mol-row">
              <SectionHeader roman="II" label="Acte II · La méthode" id="studio-sh-1" tone="accent" />
            </div>
          </div>

          <div class="studio-mol">
            <h3 class="studio-h4">StatRow · tone paper / ink</h3>
            <StatRow stats={[
              { k: '+312%', label_fr: 'Trafic organique', label_en: 'Organic traffic' },
              { k: '6 sem.', label_fr: 'Mise en ligne', label_en: 'Go-live' },
              { k: '0', label_fr: 'Dépendance no-code', label_en: 'No-code lock-in' },
            ]} tone="paper" />
            <StatRow stats={[
              { k: '24/7', label_fr: 'Disponibilité', label_en: 'Uptime' },
              { k: '< 1s', label_fr: 'LCP médian', label_en: 'Median LCP' },
              { k: '100', label_fr: 'Score perf', label_en: 'Perf score' },
            ]} tone="ink" />
          </div>

          <div class="studio-mol">
            <h3 class="studio-h4">TechPillRow · kind primary / open / neutral</h3>
            <TechPillRow pills={[
              { label: 'Astro', kind: 'primary' },
              { label: 'TypeScript', kind: 'open' },
              { label: 'Tailwind', kind: 'neutral' },
              { label: 'Vercel', kind: 'open' },
            ]} />
          </div>

          <div class="studio-mol">
            <h3 class="studio-h4">PainPointInline · severity (4)</h3>
            <PainPointInline severity="critical" pain="Le site ne convertit pas." solution="Tunnel repensé orienté preuve." />
            <PainPointInline severity="high" pain="Dépendance à un no-code fermé." solution="Stack ouverte, code possédé." />
            <PainPointInline severity="medium" pain="SEO technique négligé." solution="Rendu statique + données structurées." />
            <PainPointInline severity="low" pain="Pas d'analytics propre." solution="Mesure first-party respectueuse." />
          </div>

          <div class="studio-mol studio-mol--2col">
            <div>
              <h3 class="studio-h4">NewsletterSignup · card</h3>
              <NewsletterSignup variant="card" lang="fr" />
            </div>
            <div>
              <h3 class="studio-h4">NewsletterSignup · inline</h3>
              <NewsletterSignup variant="inline" lang="fr" />
            </div>
          </div>

          <div class="studio-mol">
            <h3 class="studio-h4">RelatedCards</h3>
            <RelatedCards cards={[
              { kicker: 'Méthode', title_fr: 'Notre approche', title_en: 'Our approach', lead_fr: 'Du diagnostic à la mise en ligne.', lead_en: 'From audit to go-live.', href: '#' },
              { kicker: 'Cas', title_fr: 'Étude de cas', title_en: 'Case study', lead_fr: 'Un site refait en 6 semaines.', lead_en: 'A site rebuilt in 6 weeks.', href: '#' },
              { kicker: 'Offre', title_fr: 'Audit de maturité', title_en: 'Maturity audit', lead_fr: 'Mesure où vous en êtes.', lead_en: 'Measure where you stand.', href: '#' },
            ]} />
          </div>

          <div class="studio-mol">
            <h3 class="studio-h4">ProofBand</h3>
            <ProofBand
              quote_fr="L'équipe a livré un site qui convertit, sans dépendance."
              quote_en="The team shipped a converting site, no lock-in."
              attr_fr="Direction · PME industrielle"
              attr_en="Management · Industrial SMB"
              metrics={[
                { k: '+48%', label_fr: 'Leads qualifiés', label_en: 'Qualified leads' },
                { k: '6 sem.', label_fr: 'Délai', label_en: 'Lead time' },
              ]}
            />
          </div>

          <div class="studio-mol">
            <h3 class="studio-h4">PricingTier · highlight</h3>
            <div class="studio-mol-grid3">
              <PricingTier idx="01" tier="Starter" price="2 000 €" period="HT · forfait" desc_fr="Site vitrine orienté preuve." desc_en="Proof-first showcase site." features={['Jusqu\'à 8 pages', 'SEO technique', 'Mise en ligne 4 sem.']} ctaLabel="Démarrer" ctaHref="#" />
              <PricingTier idx="02" tier="Standard" highlight price="4 000 €" period="HT · forfait" desc_fr="Tunnel de conversion complet." desc_en="Full conversion funnel." features={['Pages illimitées', 'Tunnel + CRM', 'A/B testing']} ctaLabel="Recommandé" ctaHref="#" />
              <PricingTier idx="03" tier="Custom" price="Sur devis" desc_fr="Plateforme sur-mesure." desc_en="Bespoke platform." features={['Architecture dédiée', 'Intégrations API', 'Support prioritaire']} ctaLabel="Nous contacter" ctaHref="#" />
            </div>
          </div>

          <div class="studio-mol studio-mol--2col">
            <div>
              <h3 class="studio-h4">TagPills</h3>
              <TagPills tags={['agent-ia', 'anthropic', 'automatisation', 'claude']} lang="fr" />
            </div>
            <div>
              <h3 class="studio-h4">Breadcrumb</h3>
              <Breadcrumb items={[
                { label: 'Accueil', href: '/' },
                { label: 'Agence', href: '/agence' },
                { label: 'DS Studio' },
              ]} lang="fr" />
            </div>
          </div>

          <div class="studio-mol">
            <h3 class="studio-h4">ShareButtons</h3>
            <ShareButtons url="/agence/ds-studio" title="DS Studio Waimia" lang="fr" />
          </div>

          <div class="studio-mol">
            <h3 class="studio-h4">TerminalMockup · tone ink / paper</h3>
            <div class="studio-mol--2col">
              <TerminalMockup label="waimia · studio" status="◉ live" tone="ink">
                <p style="font-family:var(--font-mono);color:var(--accent-text);font-size:var(--text-small)">$ édite --accent → tout se repeint</p>
              </TerminalMockup>
              <TerminalMockup label="waimia · studio" status="◉ paper" tone="paper">
                <p style="font-family:var(--font-mono);color:var(--ink);font-size:var(--text-small)">$ tone paper</p>
              </TerminalMockup>
            </div>
          </div>
        </section>

        {/* 2ter. Galerie · Sections (échantillon, rendu inline → réactif LIVE) */}
        <section class="studio-section">
          <ChapterLabel num="03" title={`Sections · ${sectionSample.length} échantillon sur ${sectionTotal}`} />
          <p class="studio-section-lede">
            Rendu inline (pas iframe) pour rester réactif au token LIVE. Aperçu tronqué en hauteur.
            <a href="#catalogue"> Catalogue complet des {sectionTotal} sections ci-dessous ↓</a>
          </p>
          <div class="studio-sec-grid">
            {sectionSample.map(({ type, C, demo }) => (
              <article class="studio-sec-tile">
                <div class="studio-sec-head">
                  <code>{type}</code>
                  <a href={`/preview/${type}`} class="studio-sec-link">grand →</a>
                </div>
                <div class="studio-sec-frame">
                  {C && demo ? <C data={demo} lang={lang} /> : <p class="studio-sec-miss">section inconnue</p>}
                  <span class="studio-sec-fade" aria-hidden="true"></span>
                </div>
              </article>
            ))}
          </div>
        </section>

        {/* 3bis. Catalogue complet (browser catégories + types + aperçu live) */}
        <section class="studio-section studio-catalog" id="catalogue">
          <ChapterLabel num="04" title={`Catalogue · ${sectionTotal} sections · ${catalogCategories.length} catégories`} />
          <p class="studio-section-lede">
            Toutes les sections du registry, par catégorie. <strong>Clique un type</strong> : son aperçu
            se charge ci-contre et <strong>hérite des tokens édités</strong> dans le panneau LIVE.
            Chaque type a aussi son rendu isolé (<code>preview</code>) et sa fiche technique
            (<code>fiche</code>) ; chaque catégorie a sa page dédiée.
          </p>
          <div class="studio-catalog-layout">
            <div class="studio-catalog-list" data-catalog-categories={catalogCategories.length}>
              {catalogCategories.map((cat, i) => (
                <details class="studio-cat" data-catalog-category={cat.slug} open={i === 0}>
                  <summary>
                    <strong class="studio-cat-label">{cat.label}</strong>
                    <span class="studio-cat-count">{cat.count}</span>
                  </summary>
                  <ul class="studio-cat-types">
                    <li class="studio-cat-all">
                      <a href={`/categories/${cat.slug}`}>Ouvrir la catégorie « {cat.label} » →</a>
                    </li>
                    {cat.sectionTypes.map((type) => (
                      <li class="studio-cat-type">
                        <button type="button" class="studio-cat-type-btn" data-catalog-type={type}>{type}</button>
                        <span class="studio-cat-links">
                          <a href={`/preview/${type}`} title={`Rendu isolé de ${type}`}>preview</a>
                          <a href={`/components/${type}`} title={`Fiche technique de ${type}`}>fiche</a>
                        </span>
                      </li>
                    ))}
                  </ul>
                </details>
              ))}
            </div>
            <aside class="studio-catalog-side" aria-label="Aperçu du type sélectionné">
              <div class="studio-catalog-side-head">
                <code id="catalog-current">{catalogDefaultType}</code>
                <span class="studio-catalog-side-links">
                  <a id="catalog-open-fiche" href={`/components/${catalogDefaultType}`}>fiche →</a>
                  <a id="catalog-open-preview" href={`/preview/${catalogDefaultType}`}>plein écran →</a>
                </span>
              </div>
              <iframe
                id="catalog-preview"
                src={`/preview/${catalogDefaultType}`}
                title="Aperçu de la section sélectionnée (hérite des tokens édités)"
                loading="lazy"
              ></iframe>
              <p class="studio-catalog-note">
                Cet aperçu hérite des tokens modifiés : édite une couleur dans le panneau LIVE,
                ce cadre se repeint.
              </p>
            </aside>
          </div>
        </section>

        {/* 3ter. Atelier de section : personnalise UNE section, preview LIVE sans reload */}
        <section class="studio-section studio-workshop" id="ds-workshop">
          <ChapterLabel num="04 bis" title="Atelier de section" />
          <p class="studio-section-lede">
            Sélectionne un type dans le catalogue ci-dessus (ou ci-dessous le type courant),
            puis change son <strong>fond</strong>, sa <strong>variante</strong> ou ses
            <strong>textes</strong> : l'aperçu réagit <strong>en direct, sans rechargement</strong>.
            Le fond applique <code>data-bg</code> sur la section ; les composants ink-ready se
            repeignent instantanément.
          </p>

          <div class="studio-workshop-layout">
            <aside class="studio-workshop-controls" aria-label="Variables de la section">
              <div class="studio-workshop-head">
                <span class="studio-workshop-head-label">Type</span>
                <code id="workshop-current-type" data-default-type={catalogDefaultType}>{catalogDefaultType}</code>
              </div>

              <div class="workshop-field" data-workshop-bg-wrap>
                <span class="workshop-field-label">background (data-bg)</span>
                <div id="workshop-bg-group" class="workshop-btn-row" role="group" aria-label="Fond de la section"></div>
              </div>

              <div id="workshop-variants" class="studio-workshop-variants" hidden></div>

              <div id="workshop-texts" class="studio-workshop-texts" hidden></div>

              <p id="workshop-empty" class="studio-workshop-empty" hidden>
                Ce type n'expose pas de variable simple (fond / variante / texte) dans l'atelier.
              </p>

              <div class="studio-actions studio-workshop-actions">
                <button id="workshop-reset" class="studio-btn" type="button">Réinitialiser</button>
                <button id="workshop-export" class="studio-btn studio-btn--accent" type="button">Exporter la config JSON</button>
              </div>
              <pre id="workshop-export-out" class="studio-export-out" aria-live="polite"></pre>
            </aside>

            <div class="studio-workshop-stage">
              <div class="studio-workshop-stage-head">
                <span class="studio-workshop-stage-title">Aperçu LIVE</span>
                <a id="workshop-open-preview" href={`/preview/${catalogDefaultType}`} class="studio-workshop-open">plein écran →</a>
              </div>
              <iframe
                id="workshop-preview"
                class="studio-workshop-frame"
                title="Aperçu live de la section personnalisée (sans rechargement)"
                loading="lazy"
              ></iframe>
              <p class="studio-workshop-note">
                Les modifications de fond / variante / texte ne rechargent jamais ce cadre :
                elles manipulent directement son DOM.
              </p>
            </div>
          </div>
        </section>

        {/* 3. Doublons & dette */}
        <section class="studio-section studio-section--debt">
          <ChapterLabel num="05" title="Doublons & dette (avant de figer le DS)" />

          <div class="studio-debt-grid">
            <div class="studio-debt-card">
              <span class="studio-debt-k">{stats.duplicateGroupCount}</span>
              <span class="studio-debt-l">groupes de classes au corps identique</span>
            </div>
            <div class="studio-debt-card">
              <span class="studio-debt-k">{stats.scopedDuplicateGroupCount}</span>
              <span class="studio-debt-l">groupes de déclarations dupliqués dans les styles scoped (cross-fichiers)</span>
            </div>
            <div class="studio-debt-card">
              <span class="studio-debt-k">{stats.unusedTokens.length}</span>
              <span class="studio-debt-l">tokens déclarés jamais consommés via var()</span>
            </div>
            <div class="studio-debt-card">
              <span class="studio-debt-k">{stats.tokenCount}</span>
              <span class="studio-debt-l">tokens dans le verrou (check:token-lock)</span>
            </div>
          </div>

          <p class="studio-lock-note">
            Verrou non-bloquant actif. Il passera <strong>bloquant</strong> via
            <code> DS_TOKEN_LOCK_ENFORCE=1</code> quand le DS sera figé.
          </p>

          <h3 class="studio-h4">Tokens inutilisés ({stats.unusedTokens.length})</h3>
          <div class="studio-unused">
            {stats.unusedTokens.map((t) => <code class="studio-unused-pill">{t}</code>)}
          </div>

          <h3 class="studio-h4">Classes au corps identique ({duplicateClasses.length} groupes)</h3>
          <p class="studio-section-lede">Corps CSS normalisé identique = candidates à la fusion avant de figer le DS.</p>
          <ul class="studio-dup-list">
            {duplicateClasses.map((d) => (
              <li class="studio-dup">
                <div class="studio-dup-classes">
                  {d.classes.map((c) => <code>.{c}</code>)}
                </div>
                <pre class="studio-dup-sig">{d.signature.length > 160 ? d.signature.slice(0, 160) + '…' : d.signature}</pre>
              </li>
            ))}
          </ul>
        </section>
      </main>
    </div>
  </div>

  <div id="save-diff-modal" class="studio-modal" role="dialog" aria-modal="true" aria-labelledby="save-diff-title" hidden>
    <div class="studio-modal-card">
      <h2 id="save-diff-title" class="studio-h3">Diff avant enregistrement</h2>
      <div id="save-diff-list" class="studio-diff-list"></div>
      <div class="studio-actions">
        <button id="save-diff-confirm" class="studio-btn studio-btn--save" type="button">Confirmer l'enregistrement</button>
        <button id="save-diff-cancel" class="studio-btn" type="button">Annuler</button>
      </div>
    </div>
  </div>

  {/* Île de données pour le JS (carte d'impact) */}
  <script type="application/json" id="ds-studio-data" set:html={studioData}></script>
  {/* Île de données pour l'atelier de section (champs éditables par type) */}
  <script type="application/json" id="ds-workshop-data" set:html={workshopData}></script>
  <script>
    import '../../scripts/ds-studio.js';
    import '../../scripts/ds-section-workshop.js';
  </script>
</Base>

<style>
  .studio {
    max-width: var(--wrap-wide);
    margin-inline: auto;
    padding-inline: var(--space-5);
    padding-block: var(--space-9) var(--space-12);
    color: var(--ink);
  }
  .studio-vh {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0, 0, 0, 0); white-space: nowrap;
  }

  /* ── En-tête ── */
  .studio-hd { max-width: var(--wrap-read); margin-bottom: var(--space-9); }
  .studio-eyebrow { margin-bottom: var(--space-4); }
  .studio-h1 {
    font-family: var(--font-display); font-size: var(--text-h1);
    line-height: var(--leading-h1); letter-spacing: var(--tracking-display);
    margin: 0 0 var(--space-4);
  }
  .studio-h1 i { color: var(--accent-text); font-style: italic; }
  .studio-lede {
    font-family: var(--font-sans); font-size: var(--text-h3);
    line-height: var(--leading-lede); color: var(--ink-2); margin: 0 0 var(--space-3);
  }
  .studio-lede a, .studio-section-lede a { color: var(--accent-text); text-decoration: underline; text-underline-offset: 0.2em; }
  .studio-meta {
    font-family: var(--font-mono); font-size: var(--text-small);
    color: var(--muted); margin: 0;
  }
  .studio code {
    font-family: var(--font-mono); font-size: 0.92em;
    background: var(--paper-2); padding: 0.1em 0.4em; border-radius: var(--radius-sm);
  }

  /* ── Layout 2 colonnes ── */
  .studio-layout {
    display: grid; grid-template-columns: 340px minmax(0, 1fr);
    gap: var(--space-8); align-items: start;
  }
  .studio-toolbar {
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-3);
    margin-bottom: var(--space-4); padding: var(--space-3);
    border: 1px solid var(--hairline-strong); border-radius: var(--radius-md); background: var(--paper);
  }
  .studio-toolbar .studio-btn.is-active { border-color: var(--accent-text); color: var(--accent-text); }
  .studio-btn:disabled { opacity: 0.45; cursor: not-allowed; }
  .studio-tool-panel {
    margin-bottom: var(--space-5); border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-md); background: var(--paper);
  }
  .studio-tool-panel summary, .studio-side-tool summary {
    font-family: var(--font-mono); font-size: var(--text-small); color: var(--ink);
    cursor: pointer; padding: var(--space-3);
  }
  .studio-tool-body { padding: 0 var(--space-3) var(--space-3); }
  .studio-tool-row { display: flex; align-items: end; gap: var(--space-3); margin-bottom: var(--space-3); }
  .studio-tool-field { display: flex; flex-direction: column; gap: var(--space-1); flex: 1; font-family: var(--font-mono); font-size: var(--text-small); color: var(--muted); }
  .studio-page-preview {
    display: block; width: 100%; height: 70vh; border: 1px solid var(--hairline);
    border-radius: var(--radius-xs); background: var(--paper);
  }
  @media (max-width: 1080px) {
    .studio-layout { grid-template-columns: 1fr; }
  }
  :global(body.ds-clean) .studio-layout { grid-template-columns: 1fr; }
  :global(body.ds-clean) .studio-panel,
  :global(body.ds-clean) .studio-hd,
  :global(body.ds-clean) .studio-impact,
  :global(body.ds-clean) .studio-catalog,
  :global(body.ds-clean) .studio :global(.ds-local-nav),
  :global(body.ds-clean) .studio-workshop,
  :global(body.ds-clean) .studio-section--debt {
    display: none;
  }

  /* ── Panneau éditeur ── */
  .studio-panel { position: sticky; top: var(--space-5); }
  @media (max-width: 1080px) { .studio-panel { position: static; } }
  .studio-panel-inner {
    border: 1px solid var(--hairline-strong); border-radius: var(--radius-lg);
    background: var(--paper); padding: var(--space-5);
    max-height: calc(100vh - var(--space-9)); overflow-y: auto;
  }
  @media (max-width: 1080px) { .studio-panel-inner { max-height: none; } }
  .studio-panel-top { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-3); }
  .studio-h3 { font-family: var(--font-display); font-size: var(--text-h3); margin: 0; }
  .studio-actions { display: flex; gap: var(--space-2); }
  .studio-btn {
    font-family: var(--font-mono); font-size: var(--text-small);
    border: 1px solid var(--hairline-strong); border-radius: var(--radius-xs);
    background: var(--paper-2); color: var(--ink); padding: var(--space-2) var(--space-3);
    cursor: pointer; transition: background var(--dur-fast) var(--ease);
  }
  .studio-btn:hover { background: var(--paper-3); }
  .studio-btn--accent { background: var(--accent); color: var(--accent-ink); border-color: var(--accent-text); }
  .studio-btn--accent:hover { background: var(--accent-sur-clair); }

  .studio-search { display: block; margin: var(--space-4) 0; }
  .studio-search input {
    width: 100%; box-sizing: border-box; font-family: var(--font-mono);
    font-size: var(--text-small); padding: var(--space-2) var(--space-3);
    border: 1px solid var(--hairline-strong); border-radius: var(--radius-xs);
    background: var(--paper-2); color: var(--ink);
  }

  .studio-group { margin-bottom: var(--space-5); }
  .studio-group-title {
    font-family: var(--font-mono); font-size: var(--text-small);
    text-transform: uppercase; letter-spacing: var(--tracking-mono);
    color: var(--muted); margin: 0 0 var(--space-2);
    border-bottom: 1px solid var(--hairline); padding-bottom: var(--space-1);
    display: flex; justify-content: space-between;
  }
  .studio-rows { display: flex; flex-direction: column; gap: var(--space-2); }
  .studio-row {
    display: grid; grid-template-columns: 1fr; gap: var(--space-1);
    padding: var(--space-2); border-radius: var(--radius-xs);
    border: 1px solid transparent; cursor: pointer;
  }
  .studio-row:hover { background: var(--paper-2); }
  .studio-row.is-selected { border-color: var(--accent-text); background: var(--paper-2); }
  .studio-row.is-dirty .studio-row-name { color: var(--accent-text); }
  .studio-row-name {
    font-family: var(--font-mono); font-size: var(--text-small);
    color: var(--ink-2); background: none; border: none; padding: 0;
    text-align: left; cursor: pointer; word-break: break-all;
  }
  .studio-row.is-dirty .studio-row-name::after { content: ' ●'; color: var(--accent-text); }
  .studio-row-ctrl { display: flex; align-items: center; gap: var(--space-2); }
  .studio-swatch-input {
    width: 32px; height: 28px; padding: 0; border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-xs); background: none; cursor: pointer; flex: none;
  }
  .studio-text-input, .studio-num {
    font-family: var(--font-mono); font-size: var(--text-small);
    border: 1px solid var(--hairline); border-radius: var(--radius-xs);
    background: var(--paper); color: var(--ink); padding: var(--space-1) var(--space-2);
    width: 100%; box-sizing: border-box; min-width: 0;
  }
  .studio-text-input--wide { width: 100%; }
  .studio-range { flex: 1 1 auto; min-width: 0; accent-color: var(--accent-text); }
  .studio-num { width: 64px; flex: none; }
  .studio-unit { font-family: var(--font-mono); font-size: var(--text-small); color: var(--muted); flex: none; }

  .studio-export-out {
    font-family: var(--font-mono); font-size: var(--text-small);
    background: var(--ink); color: var(--accent-ink); padding: var(--space-3);
    border-radius: var(--radius-xs); margin-top: var(--space-4);
    white-space: pre-wrap; word-break: break-all; max-height: 200px; overflow: auto;
  }
  .studio-export-out:empty { display: none; }
  .studio-side-tool {
    border: 1px solid var(--hairline); border-radius: var(--radius-xs);
    margin-bottom: var(--space-4); background: var(--paper-2);
  }
  .studio-contrast-list, .studio-preset-list { display: flex; flex-direction: column; gap: var(--space-2); padding: 0 var(--space-3) var(--space-3); }
  .studio-contrast-row, .studio-preset-row, .studio-diff-row {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-2);
    font-family: var(--font-mono); font-size: var(--text-small);
  }
  .studio-contrast-badge { padding: var(--space-1) var(--space-2); border: 1px solid var(--hairline-strong); border-radius: var(--radius-pill); white-space: nowrap; }
  .studio-preset-create { display: flex; flex-direction: column; gap: var(--space-2); padding: 0 var(--space-3) var(--space-3); }
  .studio-preset-row .studio-actions { flex: none; }
  .studio-preset-io {
    display: flex; flex-wrap: wrap; gap: var(--space-2);
    padding: 0 var(--space-3) var(--space-3);
  }
  .studio-preset-row { padding: var(--space-1) 0; }
  .studio-preset-row.is-demo .studio-preset-row-name::before {
    content: '◆ '; color: var(--accent-text);
  }

  /* Comparateur avant / après */
  .studio-compare-tag {
    font-family: var(--font-mono); font-size: var(--text-small); color: var(--accent-text);
    border: 1px solid var(--hairline-strong); border-radius: var(--radius-pill);
    padding: 0 var(--space-2); margin-left: var(--space-2);
  }
  .studio-compare-body { display: flex; flex-direction: column; gap: var(--space-2); padding: 0 var(--space-3) var(--space-3); }
  .studio-compare-hold { width: 100%; }
  .studio-compare-hold[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent-text); }
  .studio-compare-help { font-family: var(--font-sans); font-size: var(--text-small); color: var(--muted); margin: 0; }
  .studio-compare-help kbd {
    font-family: var(--font-mono); font-size: 0.9em; background: var(--paper-3);
    border: 1px solid var(--hairline-strong); border-radius: var(--radius-sm); padding: 0 0.35em;
  }
  .studio-compare-diff { display: flex; flex-direction: column; gap: var(--space-1); }
  .studio-compare-diff:empty::after {
    content: 'Aucun token modifié pour l\'instant.'; color: var(--muted-2);
    font-family: var(--font-mono); font-size: var(--text-small);
  }
  .studio-compare-row {
    display: grid; grid-template-columns: 1fr auto; gap: var(--space-2); align-items: center;
    font-family: var(--font-mono); font-size: var(--text-small);
    padding: var(--space-1) 0; border-bottom: 1px solid var(--hairline);
  }
  .studio-compare-row-token { color: var(--ink-2); word-break: break-all; }
  .studio-compare-row-vals { display: flex; align-items: center; gap: var(--space-1); flex: none; }
  .studio-compare-old { color: var(--muted); text-decoration: line-through; }
  .studio-compare-arrow { color: var(--muted-2); }
  .studio-compare-new { color: var(--accent-text); }
  .studio-compare-swatch {
    width: var(--space-3); height: var(--space-3); border-radius: var(--radius-sm);
    border: 1px solid var(--hairline-strong); flex: none;
  }

  /* Inspecteur de token (sections du catalogue) */
  .studio-inspector { margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--hairline); }
  .studio-inspector-help { font-family: var(--font-sans); font-size: var(--text-small); color: var(--ink-2); margin: 0 0 var(--space-2); }
  .studio-inspector-help a { color: var(--accent-text); text-decoration: underline; text-underline-offset: 0.2em; }
  .studio-inspector-list {
    list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-1);
    max-height: 180px; overflow: auto;
  }
  .studio-inspector-list:empty::after {
    content: 'Aucune section du catalogue ne référence ce token.'; color: var(--muted-2);
    font-family: var(--font-mono); font-size: var(--text-small);
  }
  .studio-inspector-btn {
    font-family: var(--font-mono); font-size: var(--text-small); color: var(--ink-2);
    background: var(--paper-2); border: 1px solid var(--hairline);
    border-radius: var(--radius-xs); padding: var(--space-1) var(--space-2); cursor: pointer;
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .studio-inspector-btn:hover { background: var(--accent); color: var(--accent-ink); border-color: var(--accent-text); }

  /* ── Main / galerie ── */
  .studio-main {
    min-width: 0; width: 100%; display: flex; flex-direction: column; gap: var(--space-9);
    margin-inline: auto; padding: var(--space-3); border: 1px solid var(--hairline);
    border-radius: var(--radius-md); box-sizing: border-box;
  }
  .studio-main[data-active-viewport="tablet"] { max-width: 768px; }
  .studio-main[data-active-viewport="mobile"] { max-width: 390px; }
  .studio-section { display: flex; flex-direction: column; gap: var(--space-3); }
  .studio-section-lede {
    font-family: var(--font-sans); font-size: var(--text-small);
    color: var(--muted); margin: 0 0 var(--space-2); max-width: var(--wrap-read);
  }
  .studio-h4 {
    font-family: var(--font-mono); font-size: var(--text-small); text-transform: uppercase;
    letter-spacing: var(--tracking-mono); color: var(--ink-2);
    margin: var(--space-4) 0 var(--space-2);
  }

  /* Carte d'impact */
  .studio-impact {
    border: 1px solid var(--hairline-strong); border-left: 3px solid var(--accent);
    border-radius: var(--radius-md); padding: var(--space-4) var(--space-5); background: var(--paper);
  }
  .studio-impact-help { font-family: var(--font-sans); font-size: var(--text-small); color: var(--ink-2); margin: var(--space-2) 0; }
  .studio-impact-list {
    list-style: none; margin: 0; padding: 0; columns: 2; column-gap: var(--space-5);
    font-family: var(--font-mono); font-size: var(--text-small); color: var(--muted);
    max-height: 220px; overflow: auto;
  }
  .studio-impact-list li { break-inside: avoid; padding: 0.1em 0; }
  .studio-impact-empty { color: var(--muted-2); }
  @media (max-width: 640px) { .studio-impact-list { columns: 1; } }

  /* Tiles atomes */
  .studio-tiles { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .studio-tile {
    display: flex; flex-direction: column; gap: var(--space-2); align-items: flex-start;
    justify-content: center; padding: var(--space-4); min-height: 96px; min-width: 160px;
    border: 1px solid var(--hairline); border-radius: var(--radius-md); background: var(--paper);
  }
  .studio-tile--dark { background: var(--ink); border-color: var(--ink-3); }
  .studio-tile--dark .studio-tag { color: var(--muted-2); background: var(--ink-2); }
  .studio-tile--note { min-height: 72px; }
  .studio-note-name { font-family: var(--font-mono); font-size: var(--text-small); color: var(--accent-text); }
  .studio-note-role { font-family: var(--font-sans); font-size: var(--text-small); color: var(--muted); }
  .studio-tag {
    font-family: var(--font-mono); font-size: var(--text-small); color: var(--muted);
    background: var(--paper-2); padding: 0.1em 0.4em; border-radius: var(--radius-sm);
  }

  /* Molécules */
  .studio-mol {
    padding: var(--space-4); border: 1px solid var(--hairline); border-radius: var(--radius-md);
    background: var(--paper); display: flex; flex-direction: column; gap: var(--space-3);
  }
  .studio-mol--2col { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-5); }
  .studio-mol-grid3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4); }

  /* Sections échantillon */
  .studio-sec-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--space-5); }
  .studio-sec-tile { border: 1px solid var(--hairline-strong); border-radius: var(--radius-md); overflow: hidden; background: var(--paper); }
  .studio-sec-head {
    display: flex; justify-content: space-between; align-items: center;
    padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--hairline);
    font-family: var(--font-mono); font-size: var(--text-small);
  }
  .studio-sec-link { color: var(--accent-text); text-decoration: none; }
  .studio-sec-frame { position: relative; max-height: 280px; overflow: hidden; }
  .studio-sec-frame > :first-child { transform: none; }
  .studio-sec-fade {
    position: absolute; left: 0; right: 0; bottom: 0; height: var(--space-9);
    background: linear-gradient(to bottom, transparent, var(--paper)); pointer-events: none;
  }
  .studio-sec-miss { font-family: var(--font-mono); padding: var(--space-4); color: var(--muted); }

  /* Rôle de la page (intro une ligne) */
  .studio-role {
    font-family: var(--font-sans); font-size: var(--text-small);
    line-height: var(--leading-body); color: var(--ink-2); margin: 0 0 var(--space-3);
  }
  .studio-role strong { font-weight: var(--fw-semibold); color: var(--ink); }
  .studio-role a { color: var(--accent-text); text-decoration: underline; text-underline-offset: 0.2em; }

  /* ── Catalogue complet (browser + aperçu live) ── */
  .studio-catalog-layout {
    display: grid; grid-template-columns: minmax(280px, 400px) minmax(0, 1fr);
    gap: var(--space-5); align-items: start;
  }
  @media (max-width: 1080px) { .studio-catalog-layout { grid-template-columns: 1fr; } }
  .studio-catalog-list {
    border: 1px solid var(--hairline-strong); border-radius: var(--radius-md);
    background: var(--paper); max-height: 72vh; overflow-y: auto;
  }
  .studio-cat { border-bottom: 1px solid var(--hairline); }
  .studio-cat:last-child { border-bottom: none; }
  .studio-cat summary {
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-3);
    padding: var(--space-3) var(--space-4); cursor: pointer;
  }
  .studio-cat summary:hover { background: var(--paper-2); }
  .studio-cat-label {
    font-family: var(--font-sans); font-size: var(--text-small);
    font-weight: var(--fw-semibold); color: var(--ink);
  }
  .studio-cat[open] > summary .studio-cat-label { color: var(--accent-text); }
  .studio-cat-count {
    font-family: var(--font-mono); font-size: var(--text-small); color: var(--muted);
    border: 1px solid var(--hairline-strong); border-radius: var(--radius-pill);
    padding: var(--space-1) var(--space-2); flex: none;
  }
  .studio-cat-types {
    list-style: none; margin: 0; padding: 0 var(--space-3) var(--space-3);
    display: flex; flex-direction: column; gap: var(--space-1);
  }
  .studio-cat-all a {
    display: inline-block; font-family: var(--font-sans); font-size: var(--text-small);
    color: var(--accent-text); text-decoration: none; padding: var(--space-1) var(--space-2);
  }
  .studio-cat-all a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .studio-cat-type {
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-2);
  }
  .studio-cat-type-btn {
    font-family: var(--font-mono); font-size: var(--text-small); color: var(--ink-2);
    background: none; border: none; padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-xs); cursor: pointer; text-align: left;
    min-width: 0; overflow-wrap: anywhere;
  }
  .studio-cat-type-btn:hover { background: var(--paper-2); color: var(--ink); }
  .studio-cat-type-btn.is-active { background: var(--ink); color: var(--paper); }
  .studio-cat-links { display: flex; gap: var(--space-2); flex: none; }
  .studio-cat-links a {
    font-family: var(--font-mono); font-size: var(--text-small);
    color: var(--muted); text-decoration: none;
  }
  .studio-cat-links a:hover { color: var(--accent-text); text-decoration: underline; text-underline-offset: 0.2em; }
  .studio-catalog-side {
    position: sticky; top: var(--space-5);
    border: 1px solid var(--hairline-strong); border-radius: var(--radius-md);
    background: var(--paper); overflow: hidden;
  }
  @media (max-width: 1080px) { .studio-catalog-side { position: static; } }
  .studio-catalog-side-head {
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-3);
    padding: var(--space-2) var(--space-3); background: var(--ink);
  }
  .studio-catalog-side-head code {
    background: none; padding: 0; color: var(--paper);
    font-size: var(--text-small); font-weight: var(--fw-semibold);
  }
  .studio-catalog-side-links { display: flex; gap: var(--space-3); flex: none; }
  .studio-catalog-side-links a {
    font-family: var(--font-mono); font-size: var(--text-small);
    color: color-mix(in srgb, var(--paper) 68%, var(--ink)); text-decoration: none;
  }
  .studio-catalog-side-links a:hover { color: var(--paper); text-decoration: underline; text-underline-offset: 0.2em; }
  #catalog-preview { display: block; width: 100%; height: 62vh; border: 0; background: var(--paper); }
  .studio-catalog-note {
    font-family: var(--font-sans); font-size: var(--text-small); color: var(--muted);
    margin: 0; padding: var(--space-2) var(--space-3); border-top: 1px solid var(--hairline);
  }

  /* ── Atelier de section ── */
  .studio-workshop-layout {
    display: grid; grid-template-columns: minmax(280px, 360px) minmax(0, 1fr);
    gap: var(--space-5); align-items: start;
  }
  @media (max-width: 1080px) { .studio-workshop-layout { grid-template-columns: 1fr; } }
  .studio-workshop-controls {
    border: 1px solid var(--hairline-strong); border-radius: var(--radius-md);
    background: var(--paper); padding: var(--space-4);
    display: flex; flex-direction: column; gap: var(--space-4);
  }
  .studio-workshop-head {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);
    padding-bottom: var(--space-3); border-bottom: 1px solid var(--hairline);
  }
  .studio-workshop-head-label {
    font-family: var(--font-mono); font-size: var(--text-small); text-transform: uppercase;
    letter-spacing: var(--tracking-mono); color: var(--muted);
  }
  .studio-workshop-head code {
    font-size: var(--text-small); font-weight: var(--fw-semibold); color: var(--accent-text);
    background: var(--paper-2);
  }
