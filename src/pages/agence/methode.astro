---
// Page · /agence/methode · Méthode Waimia : audit, pilote, mesure, transfert
export const prerender = true;

import UtilityTemplate from '../../components/templates/UtilityTemplate.astro';
import Kicker from '../../components/ui/atoms/Kicker.astro';
import Timeline from '../../components/editorial/Timeline.astro';
import SpecBar from '../../components/sections/SpecBar.astro';
import { buildHowTo } from '../../lib/seo/schema-builder';
// Données de section (vague V3) → `src/data/methode-sections.ts`. Le body bespoke reste ici.
import { phases, cadenceData } from '../../data/methode-sections';

const timelineEvents = phases.map(p => ({
  num: p.n,
  title: p.label_fr,
  body: p.body_fr,
}));

// JSON-LD HowTo dérivé des phases (source unique = `methode-sections.ts`, 0 duplication).
const howToLd = buildHowTo('Méthode Waimia : audit, pilote, mesure, transfert',
  phases.map(p => ({ name: p.label_fr, text: p.body_fr })),
);
---
<UtilityTemplate
  title="Méthode : audit, pilote, mesure, transfert · Waimia"
  description="La méthode du studio en quatre étapes : audit gratuit, pilote en production, mesure sur vos données, transfert du code et des workflows."
  jsonLd={howToLd}
  kicker="§ La méthode"
  breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'Le studio', href: '/agence' }, { label: 'Méthode' }]}
  align="left"
  showCta={true}
  headlineFr="Audit, pilote, mesure, <i>transfert</i>."
  headlineEn="Audit, pilot, measure, <i>handover</i>."
  ledeFr="Quatre étapes, toujours dans cet ordre. Un ingénieur travaille avec vos équipes métier, sur vos outils et vos données, jusqu'à ce que le système tourne sans lui."
  ledeEn="Four steps, always in this order. One engineer works with your business teams, on your tools and your data, until the system runs without him."
>
  <Fragment slot="body">

    {/* ── CADENCE · proof-bar specs (paper-2) ── */}
    <div class="meth-cadence reveal">
      <SpecBar data={cadenceData} lang="fr" />
    </div>

    {/* ── PHASES via Timeline ── */}
    <h2 class="sr-only">Les quatre étapes</h2>
    <Timeline events={timelineEvents} numbered={true} />

    {/* ── GARANTIES ── */}
    <div class="meth-garanties reveal">
      <Kicker class="meth-garanties-kicker">§ Engagements</Kicker>
      <div class="meth-garanties-grid">
        <div class="meth-garantie">
          <p class="meth-garantie-title">Tout est journalisé</p>
          <p class="meth-garantie-body">Chaque action d'agent est journalisée et exportable. Vous lisez ce qui s'est passé, sans nous demander.</p>
        </div>
        <div class="meth-garantie">
          <p class="meth-garantie-title">Zéro dépendance propriétaire</p>
          <p class="meth-garantie-body">Les workflows tournent sur vos outils et dans vos comptes. Si vous arrêtez de travailler avec le studio, le système continue.</p>
        </div>
        <div class="meth-garantie">
          <p class="meth-garantie-title">Un interlocuteur unique</p>
          <p class="meth-garantie-body">Simon Beros audite, construit et transfère lui-même. Vous parlez à celui qui fait le travail, du premier appel à la remise du code. Ce rôle a un nom : <a href="/blog/forward-deployed-engineer">forward deployed engineer</a>.</p>
        </div>
      </div>
    </div>

    {/* ── MENTION VIRTUOSEOS ── */}
    <div class="meth-os reveal">
      <Kicker class="meth-os-kicker">§ Sous le capot</Kicker>
      <h2 class="meth-os-h2">VirtuoseOS · le <i>cadre</i> qu'on a construit pour ça.</h2>
      <p class="meth-os-body">
        Sans cadre commun, chaque mission redémarre à zéro. VirtuoseOS est le noyau d'orchestration du studio : il journalise les actions, garde la trace et coordonne les agents.
      </p>
      <p class="meth-os-body">
        Vous n'avez pas à l'acheter. Il sert de base de travail au studio, par exemple sur une <a href="/services/integration-claude">intégration de Claude</a> ou une <a href="/services/automatisations">automatisation des processus</a>.
      </p>
    </div>

    {/* CTA final canonique = `CtaFinal` rendu par UtilityTemplate (showCta).
       L'ancien bloc `.meth-cta` inline (CTA dupliqué) a été retiré (W5 dédup). */}

  </Fragment>
</UtilityTemplate>

<style>
  /* ── Cadence · spec-bar (breakout du padding body pour pleine largeur) ── */
  .meth-cadence {
    margin-inline: calc(-1 * var(--space-6));
  }
  .meth-cadence { margin-block: var(--space-9) var(--space-10); }

  /* ── Garanties ── */
  .meth-garanties {
    margin: var(--space-11) 0 var(--space-10);
  }
  :global(.meth-garanties-kicker) { display: block; margin-bottom: 28px; }
  .meth-garanties-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border: 1px solid var(--hairline);
  }
  .meth-garantie {
    padding: var(--space-8);
    border-right: 1px solid var(--hairline);
  }
  .meth-garantie:last-child { border-right: none; }
  .meth-garantie-title {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: var(--fw-medium);
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-3);
    color: var(--ink);
  }
  .meth-garantie-body {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-prose);
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 768px) {
    .meth-garanties-grid { grid-template-columns: 1fr; }
    .meth-garantie { border-right: none; border-bottom: 1px solid var(--hairline); }
    .meth-garantie:last-child { border-bottom: none; }
  }

  /* ── VirtuoseOS · encart mis en valeur (barre accent) ── */
  .meth-os {
    background: var(--paper-2);
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--accent);
    padding: var(--space-8);
    margin-bottom: var(--space-12);
    max-width: 800px;
  }
  :global(.meth-os-kicker) { display: block; margin-bottom: 20px; }
  .meth-os-h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.022em;
    line-height: 1.05;
    margin: 0 0 var(--space-5);
    text-wrap: balance;
  }
  .meth-os-h2 :global(i) { font-style: italic; color: var(--accent-text); }
  .meth-os-body {
    font-family: var(--font-sans);
    color: var(--muted);
    font-size: var(--text-body);
    line-height: var(--leading-prose);
    margin: 0 0 var(--space-3);
    max-width: 640px;
  }
  .meth-os-body:last-child { margin-bottom: 0; }

  @media (max-width: 700px) {
    .meth-os { padding-inline: var(--space-5); }
  }
</style>
