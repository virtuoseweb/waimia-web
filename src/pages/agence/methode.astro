---
// Page · /agence/methode · Méthode Waimia · Process Intelligence
export const prerender = true;

import UtilityTemplate from '../../components/templates/UtilityTemplate.astro';
import Kicker from '../../components/ui/atoms/Kicker.astro';
import Timeline from '../../components/editorial/Timeline.astro';
import MetricCalloutBand from '../../components/sections/MetricCalloutBand.astro';
import SpecBar from '../../components/sections/SpecBar.astro';
import { getProofPoint } from '../../data/proof-points';

const phases = [
  {
    n: '01',
    label_fr: 'Cartographie',
    body_fr: "On regarde votre métier, pas vos présentations. Vos vrais workflows, vos vrais bouchons. Le mardi on observe, le vendredi on chiffre.",
  },
  {
    n: '02',
    label_fr: 'Priorisation',
    body_fr: "On classe les workflows par ROI, pas par sophistication technique. Le gain rapide passe en premier.",
  },
  {
    n: '03',
    label_fr: 'Câblage',
    body_fr: "On câble les agents IA dans vos outils existants : Excel, HubSpot, Outlook, votre ERP. Pas de migration. On connecte ce qui marche.",
  },
  {
    n: '04',
    label_fr: 'Mesure',
    body_fr: "Chaque workflow a sa métrique avant/après. Si ça ne mesure rien, ça n'existe pas.",
  },
  {
    n: '05',
    label_fr: 'Passation',
    body_fr: "Vous prenez la main. Documentation, mode opératoire, formation. Pas de boîte noire : vous pouvez nous virer.",
  },
];

const timelineEvents = phases.map(p => ({
  num: p.n,
  title: p.label_fr,
  body: p.body_fr,
}));

// ── Cadence de la méthode · SpecBar (rythme rejouable, fond paper-2) ──
const cadenceData = {
  type: 'spec-bar' as const,
  background: 'paper-2' as const,
  kicker_fr: '§ Cadence',
  kicker_en: '§ Cadence',
  specs: [
    { label_fr: 'Phases', label_en: 'Phases', value: '5' },
    { label_fr: 'Audit livré', label_en: 'Audit delivered', value: '5 jours' },
    { label_fr: 'Pilote en prod', label_en: 'Pilot in prod', value: '2 semaines' },
    { label_fr: 'Pour démarrer', label_en: 'To get started', value: '45 min' },
  ],
} satisfies import('../../schemas/sections').SectionByType<'spec-bar'>;

// ── Impact mesuré · MetricCalloutBand INK · 3 chiffres canoniques (proof-points.ts, 0 invention) ──
const _audit = getProofPoint('time-5-jours-audit');
const _pilote = getProofPoint('time-2-semaines-pilote');
const _equipe = getProofPoint('adoption-100pct-equipe');
const impactData = {
  type: 'metric-callout-band' as const,
  background: 'ink' as const,
  kicker_fr: '§ Ce que la méthode garantit',
  kicker_en: '§ What the method guarantees',
  context_fr: 'On ne vend pas un cabinet : un protocole rejouable, chiffré à chaque étape. Trois engagements tenus sur chaque mission.',
  context_en: 'We do not sell a consultancy: a replayable protocol, measured at every step. Three commitments kept on every mission.',
  metrics: [
    { value: _audit?.value ?? '5 jours', label_fr: 'pour l\'audit complet de maturité IA', label_en: 'for the full AI maturity audit' },
    { value: _pilote?.value ?? '2 semaines', label_fr: 'pour un premier pilote en production', label_en: 'for a first pilot in production' },
    { value: _equipe?.value ?? '100%', label_fr: 'des équipes formées et autonomes', label_en: 'of teams trained and autonomous' },
  ],
} satisfies import('../../schemas/sections').SectionByType<'metric-callout-band'>;
---
<UtilityTemplate
  title="Notre méthode · Process Intelligence · Waimia"
  description="Cinq phases. Audit, priorisation, câblage, mesure, passation. Pas de diaporama. Le mardi on câble, le vendredi on mesure."
  kicker="§ Notre méthode · Process Intelligence"
  align="left"
  showCta={true}
  headlineFr="Cinq <i>phases</i>. Pas de <i>diaporama</i>."
  headlineEn="Five <i>phases</i>. No <i>slideshow</i>."
  ledeFr="On documente, on mesure, on corrige. Un protocole rejouable, pas un cabinet."
  ledeEn="We have a method. We write it. We measure it. We correct it. Not a cabinet secret: a protocol that can be replayed."
>
  <Fragment slot="body">

    {/* ── CADENCE · proof-bar specs (paper-2) ── */}
    <div class="meth-cadence reveal">
      <SpecBar data={cadenceData} lang="fr" />
    </div>

    {/* ── PHASES via Timeline ── */}
    <h2 class="sr-only">Les cinq phases</h2>
    <Timeline events={timelineEvents} numbered={true} />

    {/* ── IMPACT MESURÉ · bande INK + 3 métriques réelles ── */}
    <div class="meth-impact reveal">
      <MetricCalloutBand data={impactData} lang="fr" />
    </div>

    {/* ── GARANTIES ── */}
    <div class="meth-garanties reveal">
      <Kicker class="meth-garanties-kicker">§ Engagements</Kicker>
      <div class="meth-garanties-grid">
        <div class="meth-garantie">
          <p class="meth-garantie-title">Auditabilité totale</p>
          <p class="meth-garantie-body">Chaque action d'agent est tracée, rejouable, exportable. Vous lisez ce qui s'est passé, sans nous demander.</p>
        </div>
        <div class="meth-garantie">
          <p class="meth-garantie-title">Zéro dépendance propriétaire</p>
          <p class="meth-garantie-body">Aucun lock-in. Les workflows tournent sur vos outils existants. Vous pouvez nous virer demain : le système continue.</p>
        </div>
        <div class="meth-garantie">
          <p class="meth-garantie-title">Humain d'astreinte nommé</p>
          <p class="meth-garantie-body">Pas un chatbot de support. Un nom, un numéro, une responsabilité claire. Joignable si quelque chose tombe.</p>
        </div>
      </div>
    </div>

    {/* ── MENTION VIRTUOSEOS ── */}
    <div class="meth-os reveal">
      <Kicker class="meth-os-kicker">§ Sous le capot</Kicker>
      <h2 class="meth-os-h2">VirtuoseOS · le <i>cadre</i> qu'on a construit pour ça.</h2>
      <p class="meth-os-body">
        Cinq ans à câbler des systèmes IA nous ont appris que sans cadre commun, chaque mission redémarre à zéro. VirtuoseOS est notre noyau d'orchestration : il audite les actions, garde la trace, coordonne les agents.
      </p>
      <p class="meth-os-body">
        Vous n'avez pas à l'acheter. Il tourne sous chaque mission Waimia. C'est tout.
      </p>
    </div>

    {/* ── CTA INLINE ── */}
    <div class="meth-cta reveal">
      <h2 class="meth-cta-h2">Cinq phases. Quarante-cinq minutes pour démarrer.</h2>
      <div class="meth-cta-btns">
        <a href="/contact" class="meth-cta-btn meth-cta-btn--primary">Démarrer →</a>
        <a href="/offres" class="meth-cta-btn meth-cta-btn--ghost">Voir les offres</a>
      </div>
    </div>

  </Fragment>
</UtilityTemplate>

<style>
  /* ── Cadence · spec-bar (breakout du padding body pour pleine largeur) ── */
  .meth-cadence,
  .meth-impact {
    margin-inline: calc(-1 * var(--space-6));
  }
  .meth-cadence { margin-block: clamp(40px, 5vw, 64px) clamp(56px, 7vw, 88px); }
  .meth-impact { margin-block: clamp(56px, 7vw, 88px); }

  /* ── Garanties ── */
  .meth-garanties {
    margin: clamp(64px, 8vw, 100px) 0 clamp(48px, 6vw, 80px);
  }
  :global(.meth-garanties-kicker) { display: block; margin-bottom: 28px; }
  .meth-garanties-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border: 1px solid var(--hairline);
  }
  .meth-garantie {
    padding: clamp(28px, 3.5vw, 48px);
    border-right: 1px solid var(--hairline);
  }
  .meth-garantie:last-child { border-right: none; }
  .meth-garantie-title {
    font-family: var(--font-display);
    font-size: clamp(17px, 1.8vw, 22px);
    font-weight: var(--fw-regular);
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-3);
    color: var(--ink);
  }
  .meth-garantie-body {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    line-height: var(--leading-prose);
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 768px) {
    .meth-garanties-grid { grid-template-columns: 1fr; }
    .meth-garantie { border-right: none; border-bottom: 1px solid var(--hairline); }
    .meth-garantie:last-child { border-bottom: none; }
  }

  /* ── VirtuoseOS · encart mis en valeur (barre accent) ── */
  .meth-os {
    background: var(--paper-2);
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--accent);
    padding: clamp(32px, 4vw, 56px);
    margin-bottom: clamp(72px, 9vw, 120px);
    max-width: 800px;
  }
  :global(.meth-os-kicker) { display: block; margin-bottom: 20px; }
  .meth-os-h2 {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.8vw, 44px);
    font-weight: var(--fw-regular);
    letter-spacing: -0.022em;
    line-height: 1.05;
    margin: 0 0 var(--space-5);
    text-wrap: balance;
  }
  .meth-os-h2 :global(i) { font-style: italic; color: var(--accent); }
  .meth-os-body {
    font-family: var(--font-sans);
    color: var(--muted);
    font-size: var(--text-body-lead);
    line-height: var(--leading-prose);
    margin: 0 0 var(--space-3);
    max-width: 640px;
  }
  .meth-os-body:last-child { margin-bottom: 0; }

  /* ── CTA final ── */
  .meth-cta {
    text-align: left;
    border-top: 1px solid var(--hairline);
    padding-top: clamp(48px, 6vw, 72px);
    display: flex;
    align-items: center;
    gap: clamp(28px, 4vw, 56px);
    flex-wrap: wrap;
  }
  .meth-cta-h2 {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.5vw, 52px);
    font-weight: var(--fw-regular);
    letter-spacing: -0.022em;
    line-height: var(--leading-h3);
    margin: 0;
    flex: 1 1 360px;
    text-wrap: balance;
  }
  .meth-cta-btns {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
  }
  .meth-cta-btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-ui);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    padding: var(--space-4) 36px;
    border: 1px solid var(--ink);
    transition: background var(--dur-trim) var(--ease), border-color var(--dur-trim) var(--ease), color var(--dur-trim) var(--ease);
    text-decoration: none;
    white-space: nowrap;
  }
  .meth-cta-btn--primary {
    color: var(--paper);
    background: var(--ink);
  }
  .meth-cta-btn--primary:hover { background: var(--accent); border-color: var(--accent); }
  .meth-cta-btn--ghost {
    color: var(--ink);
    background: transparent;
  }
  .meth-cta-btn--ghost:hover { background: var(--ink); color: var(--paper); }

  @media (max-width: 700px) {
    .meth-os { padding-inline: var(--space-5); }
    .meth-cta { flex-direction: column; align-items: flex-start; }
    .meth-cta-btns { flex-direction: column; align-items: flex-start; }
  }
</style>
