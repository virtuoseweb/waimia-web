---
export const prerender = true;

import Base from '../../layouts/Base.astro';
import HeroOfferDetail from '../../components/sections/HeroOfferDetail.astro';
import type { SectionByType } from '../../schemas/sections';

const demoBase = {
  type: 'hero-offer-detail',
  tier_fr: 'Offre signature · Acquisition',
  tier_en: 'Signature offer · Acquisition',
  h1_fr: 'Growth System <i class="acc">IA</i>',
  h1_en: '<i class="acc">AI</i> Growth System',
  lead_fr: 'Un système d’acquisition qui relie contenu, CRM et conversion.<span>Vos équipes gardent leurs outils, l’IA absorbe les tâches répétitives.</span>',
  lead_en: 'An acquisition system connecting content, CRM and conversion.<span>Your teams keep their tools while AI handles repetitive work.</span>',
  cta: {
    href: '/contact',
    label_fr: 'Réserver un audit',
    label_en: 'Book an audit',
    variant: 'primary',
  },
  meta_fr: 'Déploiement pilote · 5 jours',
  meta_en: 'Pilot deployment · 5 days',
  tags: [
    { label_fr: 'Acquisition', label_en: 'Acquisition' },
    { label_fr: 'Scoring leads', label_en: 'Lead scoring' },
    { label_fr: 'CRM augmenté', label_en: 'AI-powered CRM' },
    { label_fr: 'Contenu utile', label_en: 'Useful content' },
  ],
} satisfies Omit<SectionByType<'hero-offer-detail'>, 'hero_variant'>;

const proposals = [
  { id: 'a', label: 'Proposition A · Équilibré', variant: 'equilibre' },
  { id: 'b', label: 'Proposition B · Showcase', variant: 'showcase' },
  { id: 'c', label: 'Proposition C · Encadré', variant: 'encadre' },
] as const;
---

<Base
  title="Hero Lab · Propositions offre, secteur et solution · Waimia"
  description="Comparatif interne des trois variantes du hero détail Waimia."
  noindex
>
  <header class="hero-lab__header">
    <div class="hero-lab__wrap">
      <a class="hero-lab__back" href="/agence/design-system">← Retour au design system</a>
      <h1>Hero Lab · offre, secteur, solution</h1>
      <p>Trois directions servies depuis le composant catalogue <code>HeroOfferDetail</code>.</p>
    </div>
  </header>

  {proposals.map((proposal) => (
    <section class="hero-lab__proposal" aria-labelledby={`proposal-${proposal.id}`}>
      <div class="hero-lab__label">
        <h2 id={`proposal-${proposal.id}`}>{proposal.label}</h2>
        <code>hero_variant="{proposal.variant}"</code>
      </div>
      <HeroOfferDetail
        data={{ ...demoBase, hero_variant: proposal.variant }}
        lang="fr"
        transitionId={`hero-lab-${proposal.id}`}
        cardTransitionId={`hero-lab-${proposal.id}`}
        geoReveal={true}
      />
    </section>
  ))}
</Base>

<style>
  .hero-lab__header {
    padding: calc(var(--header-height) + var(--space-8)) 0 var(--space-8);
    border-bottom: 1px solid var(--hairline);
  }
  .hero-lab__wrap,
  .hero-lab__label {
    max-width: var(--wrap-wide);
    margin-inline: auto;
    padding-inline: var(--gut);
  }
  .hero-lab__back {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent);
  }
  .hero-lab__header h1 {
    font-family: var(--font-display);
    font-size: clamp(48px, 7vw, 108px);
    line-height: var(--leading-h1);
    letter-spacing: var(--tracking-display);
    font-weight: var(--fw-regular);
    margin: var(--space-5) 0 var(--space-4);
  }
  .hero-lab__header p {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    color: var(--ink-2);
    margin: 0;
  }
  .hero-lab__proposal { border-bottom: 1px solid var(--hairline); }
  .hero-lab__label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--hairline);
  }
  .hero-lab__label h2 {
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 44px);
    font-weight: var(--fw-regular);
    margin: 0;
  }
  .hero-lab__label code {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    color: var(--muted);
  }
  @media (max-width: 880px) {
    .hero-lab__label { align-items: flex-start; flex-direction: column; }
  }
</style>
