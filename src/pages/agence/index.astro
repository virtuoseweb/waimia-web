    lead_en: 'n8n and Make for workflows, Claude and OpenAI for agents, MCP and APIs to connect them to your tools. We choose based on your constraints, not on a vendor preference. The layer-by-layer detail is on the <a href="/technologies">stack and technologies</a> page.',
    pills: [
      { label_fr: 'n8n', label_en: 'n8n', kind: 'primary' },
      { label_fr: 'Make', label_en: 'Make', kind: 'primary' },
