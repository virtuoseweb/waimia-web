const lang = langFromPath(Astro.url.pathname);
---
<Base
  title="L'Agence · Studio IA solo à Montpellier · Waimia"
  description="Studio IA solo à Montpellier. Méthode Process Intelligence, expert de l'écosystème Anthropic. On livre des agents qui exécutent, pas des slides."
>
  <MastheadBar lang={lang} items={[
    { label: lang === 'fr' ? 'Accueil' : 'Home', href: lang === 'fr' ? '/' : '/en' },
    { label: lang === 'fr' ? "L'Agence" : 'The Agency' },
  ]} />
  <SectionsRenderer sections={agenceSections} lang={lang} />
</Base>
