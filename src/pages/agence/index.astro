const lang = langFromPath(Astro.url.pathname);
---
<Base
  title="Waimia, studio IA indépendant : de l'audit au code remis"
  description="Waimia, studio de développement IA indépendant à Bordeaux : Simon Beros audite, construit et transfère code et workflows. Audit gratuit de 45 min en visio."
>
  <MastheadBar lang={lang} items={[
    { label: lang === 'fr' ? 'Accueil' : 'Home', href: lang === 'fr' ? '/' : '/en' },
    { label: lang === 'fr' ? 'Le studio' : 'The studio' },
  ]} />
  <SectionsRenderer sections={agenceSections} lang={lang} />
</Base>
