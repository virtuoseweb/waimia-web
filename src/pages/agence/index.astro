      { label_fr: 'Activateur France Num', label_en: 'France Num activator' },
    ],
    media_src: '/images/editorial/gentlemanhandcraftergoworknow.webp',
    media_alt_fr: "Illustration éditoriale : l'artisan solo au travail, posture du studio.",
    media_alt_en: 'Editorial illustration: the solo craftsman at work, the studio posture.',
    media_caption_fr: 'Studio solo · un seul interlocuteur',
    media_caption_en: 'Solo studio · a single point of contact',
    cta_label_fr: 'Voir le parcours de Simon Beros',
    cta_label_en: 'See Simon Beros’s background',
    cta_href: '/equipe/simon-beros',
  },

  // 7 · FAITS CLÉS (paper) — la fiche d'identité du studio.
  {
    type: 'spec-bar',
    background: 'paper',
    kicker_fr: '§ Faits clés',
    kicker_en: '§ Key facts',
    specs: [
      { label_fr: 'Forme', label_en: 'Structure', value: 'Studio solo · Waimia / VirtuoseWeb' },
      { label_fr: 'Fondateur', label_en: 'Founder', value: 'Simon Beros' },
      { label_fr: 'Métier', label_en: 'Trade', value: 'Automatisation, agents IA, applications métier, sites web, conseil et formation' },
      { label_fr: 'Clients', label_en: 'Clients', value: 'PME et ETI françaises · 10 à 250 collaborateurs' },
      { label_fr: 'Ancrage', label_en: 'Based in', value: 'Bordeaux (FR) · missions à distance : Bordeaux, Montpellier, Lyon, Paris' },
      { label_fr: 'Formation', label_en: 'Training', value: 'Formations dispensées via Akigora, organisme certifié Qualiopi' },
      { label_fr: 'Référencement', label_en: 'Listing', value: 'Activateur France Num' },
    ],
  },

  // 8 · CTA FINAL (INK)
  {
    type: 'cta-final',
    background: 'ink',
    chapter_num: '§',
    chapter_title_fr: 'Première étape',
    chapter_title_en: 'First step',
    h2_fr: 'Quarante-cinq minutes pour voir si c&rsquo;est <i>le bon format</i>.',
    h2_en: 'Forty-five minutes to see if it is <i>the right fit</i>.',
    body_fr: "Un audit gratuit, en visio, avec l'ingénieur qui fera le travail. Si on n'a rien d'utile à vous proposer, on le dit, et on ne relance pas.",
    body_en: 'A free audit, on a call, with the engineer who will do the work. If we have nothing useful to offer, we say so, and we do not follow up.',
