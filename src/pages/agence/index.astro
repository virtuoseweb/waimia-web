      { title_fr: 'Une documentation et une formation', title_en: 'Documentation and training', body_fr: "Le mode opératoire écrit et une équipe formée à faire évoluer le système.", body_en: 'The written runbook and a team trained to evolve the system.' },
    ],
  },

  // 5 · STACK (paper) — outils réellement utilisés (détail sur /technologies)
  {
    type: 'tech-stack-band',
    background: 'paper',
    kicker_fr: '§ Les outils',
