const lang = langFromPath(Astro.url.pathname);
---
<Base
  title="L'Agence · Waimia · Architectes de systèmes agentiques"
  description="Studio IA solo basé à Montpellier. Méthode Process Intelligence, expert de l'écosystème Anthropic. On livre des agents qui exécutent, pas des présentations qui tournent en comité."
>
  <Breadcrumb lang={lang} items={[
    { label: lang === 'fr' ? 'Accueil' : 'Home', href: lang === 'fr' ? '/' : '/en' },
    { label: lang === 'fr' ? "L'Agence" : 'The Agency' },
  ]} />
  <SectionsRenderer sections={agenceSections} lang={lang} />
</Base>
