---
// Page · /agence · Le studio (URL inchangée, libellé « Le studio » depuis la refonte
// positionnement 2026-10).
// Rendu 100 % composable : tableau `sections` typé SectionData → SectionsRenderer
// (registry). AUCUN markup de section inline (règle anti-orphelin CLAUDE.md).
//
// Ce que la page doit faire comprendre en 5 secondes : Waimia est un studio de
// développement IA et un cabinet d'automatisation des processus, tenu par un seul
// ingénieur (studio solo assumé). Méthode = audit, pilote, mesure, transfert.
// Retirés à la refonte : bande de métriques « 5 jours / 4 sem. / J+1 » (ordres de grandeur
// non sourcés), second bloc méthode (doublon), bande « partenariats » à deux cellules.
export const prerender = true;

import Base from '../../layouts/Base.astro';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import MastheadBar from '../../components/sections/MastheadBar.astro';
import { langFromPath } from '../../lib/i18n';
import { AUDIT_BOOKING_HREF, AUDIT_BOOKING_LABEL, AUDIT_PROMISE, auditCtaBand } from '../../data/conversion';
import type { SectionData } from '@waimia/ds-kernel';

// Tableau partagé (bilingue) — exporté pour le miroir EN.
export const agenceSections: SectionData[] = [
  // 1 · HERO (paper) — le métier + qui le fait
  {
    type: 'hero-hub-stats',
    background: 'paper',
    meta_kicker_fr: '§ Le studio · Waimia',
    meta_kicker_en: '§ The studio · Waimia',
    hub_num: '00',
    h1_fr: 'Un studio de développement IA.<br/><i>Solo</i>, et assumé.',
    h1_en: 'An AI development studio.<br/><i>Solo</i>, by choice.',
    lede_fr: "Waimia est un studio de développement IA et un cabinet d'automatisation des processus pour PME et ETI. Un seul ingénieur, Simon Beros, audite, construit et transfère. Personne entre vous et celui qui fait le travail. Basé à Bordeaux, il intervient à distance ou, selon la mission, sur site dans <a href=\"/implantations\">dix villes en France</a>.",
    lede_en: 'Waimia is an AI development studio and a process automation practice for SMEs. One engineer, Simon Beros, audits, builds and hands over. Nobody stands between you and the person doing the work. Based in Bordeaux, he works remotely or, depending on the engagement, on site in <a href="/implantations">ten cities across France</a>.',
    stats: [
      { value: 'Solo', label_fr: 'un ingénieur, votre interlocuteur', label_en: 'one engineer, your contact', emphasis: true },
      { value: 'Bordeaux', label_fr: 'ancrage · missions à distance', label_en: 'based in · remote engagements', emphasis: false },
      { value: 'PME · ETI', label_fr: '10 à 250 collaborateurs', label_en: '10 to 250 people', emphasis: false },
      { value: 'Transfert', label_fr: 'code et workflows à vous', label_en: 'code and workflows are yours', emphasis: false },
    ],
  },

  // 2 · CONVICTION (INK)
  {
    type: 'manifesto-statement',
    kicker_fr: '§ La conviction',
    kicker_en: '§ The conviction',
    text_fr: 'Le studio met <span class="acc">en production</span>, mesure, puis remet le code.',
    text_en: 'The studio ships <span class="acc">to production</span>, measures, then hands over the code.',
    tone: 'ink',
    show_grid: true,
    pinned: true,
  },

  // 2 bis · CTA de page (paper-2) : sans elle, le premier CTA de page arrivait à 6 484 px en
  // mobile (audit v5, point 4). Texte et lien depuis data/conversion.ts.
  auditCtaBand(),

  // 3 · MÉTHODE (paper) — audit, pilote, mesure, transfert (détail sur /agence/methode)
  {
    type: 'method-timeline',
    background: 'paper',
    kicker_fr: '§ La méthode',
    kicker_en: '§ The method',
    h2_fr: 'Audit, pilote, mesure, transfert.',
    h2_en: 'Audit, pilot, measure, handover.',
