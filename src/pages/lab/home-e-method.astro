---
export const prerender = true;

/**
 * Home · lab E · comparaison des 4 LAYOUTS de la section méthode (sticky-scroll-storytelling).
 * noindex, hors nav, hors sitemap. Ne remplace PAS la home live.
 *
 * Objectif (verdict gate B home E) : Simon veut pour l'accueil une variante de la section
 * méthode avec un LAYOUT différent. Cette page rend les 4 propositions À LA SUITE, à CONTENU
 * ÉGAL (la config sticky-scroll de c.json, 4 steps méthode), pour comparer les seuls layouts.
 * Les 4 restent LE MÊME composant catalogué : chaque variante = axes optionnels du schéma
 * (frame / mediaMode / mediaTreatment / railStyle), 0 fork, 0 markup bespoke pour la section.
 *
 * Séquence (alternance de fonds, jamais 2 ink adjacents ; V2 = ink par construction) :
 *   V1 Miroir éditorial   · axes existants (paper)
 *   V2 Carte expand-ink   · carte ink qui s'étend au scroll (paper, carte ink)
 *   V3 Rail tissé         · images inline alternées, media sticky supprimée (paper-2)
 *   V4 Média immersif + ledger · panneau bleed + filets séparateurs (paper)
 */
import Base from '../../layouts/Base.astro';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import homeVariantC from '../../data/page-variants/home/c.json';
import type { SectionData } from '@waimia/ds-kernel';

const sectionsC = homeVariantC.sections as any[];
const methodBase = sectionsC.find((s) => s.type === 'sticky-scroll-storytelling');
// 1 seule config méthode, 4 layouts. On retire `anchor` (évite un id dupliqué 4 fois).
const { anchor: _anchor, ...method } = methodBase;

const variants: { label: string; section: SectionData }[] = [
  {
    label: 'V1 · Miroir éditorial · axes existants : textSide right + media-wide + 3:2 + compact',
    section: {
      ...method,
      background: 'paper',
      textSide: 'right',
      proportion: 'media-wide',
      mediaRatio: '3-2',
      density: 'compact',
    } as SectionData,
  },
  {
    label: 'V2 · Carte expand-ink · la section vit dans une carte ink qui s’étend au scroll (idiome so)',
    section: {
      ...method,
      background: 'paper',
      frame: 'expand-ink',
      proportion: 'media-led',
      mediaRatio: '4-5',
      density: 'base',
    } as SectionData,
  },
  {
    label: 'V3 · Rail tissé · images inline alternées, colonne média sticky supprimée',
    section: {
      ...method,
      background: 'paper-2',
      mediaMode: 'inline',
      proportion: 'balanced',
      density: 'ample',
    } as SectionData,
  },
  {
    label: 'V4 · Média immersif + rail ledger · panneau bleed + filets séparateurs',
    section: {
      ...method,
      background: 'paper',
      mediaTreatment: 'bleed',
      railStyle: 'ledger',
      textSide: 'right',
      proportion: 'media-wide',
      mediaRatio: '4-5',
      density: 'base',
    } as SectionData,
  },
];
---
<Base
  title="Home lab · méthode · 4 layouts · Waimia"
  description="Comparaison lab des 4 layouts de la section méthode. Page de laboratoire, non indexée."
  noindex
>
  <div class="wrap-wide lab-head">
    <p class="lab-head__kicker">Lab · gate B · home E</p>
    <h1 class="lab-head__title">Section méthode : 4 layouts à contenu égal</h1>
    <p class="lab-head__note">
      Même configuration sticky-scroll (c.json, 4 paliers), 4 axes de layout du composant
      catalogué. On compare les silhouettes, pas le contenu.
    </p>
  </div>

  {variants.map((v) => (
    <Fragment>
      <div class="wrap-wide lab-band">
        <span class="lab-band__tag">{v.label}</span>
      </div>
      <SectionsRenderer sections={[v.section]} lang="fr" />
    </Fragment>
  ))}
</Base>

<style>
  .lab-head {
    padding-block: var(--section-base) var(--space-6);
  }
  .lab-head__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-kicker);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0 0 var(--space-4);
  }
  .lab-head__title {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    font-weight: var(--fw-medium);
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-display);
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .lab-head__note {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--muted);
    margin: var(--space-4) 0 0;
    max-width: var(--wrap-prose);
  }

  /* Bande mono discrète : label de la variante (seul markup direct autorisé en lab). */
  .lab-band {
    padding-block: var(--space-6) var(--space-2);
  }
  .lab-band__tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono-tight);
    text-transform: uppercase;
    color: var(--muted);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-pill);
  }
</style>
