<style>
  /* ── Rythme de section · hierarchie par l'echelle (compaction iter 6 : gagner sur les vides) ── */
  .he-sec { padding-block: var(--section-base); }
  /* MONEY SLOT : iter 6 passe --section-loose -> --section-base (poids porte par he-h2--xl + la
     densite du contenu, pas par 160px de vide). Reste le slot le plus riche de la page. */
  .he-offres { padding-block: var(--section-base); }

  /* 05 · La tension INK (rythme iter 6) · idiome DS carte-sur-ink (repris de TestimonialWall) :
     fond ink, header en paper, cartes en surface ink elevee (rgba paper) + hairline clair.
     Le contexte [data-bg='ink'] remappe deja --muted/--hairline/--accent-text (global.css) →
     desc/severite/hairlines passent clairs automatiquement. 0 nouveau token. */
  .he-tension[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .he-tension[data-bg='ink'] .he-h2 { color: var(--paper); }
  .he-tension[data-bg='ink'] .he-pain {
    background: rgba(var(--paper-rgb), 0.04);
    border: 1px solid rgba(var(--paper-rgb), 0.12);
    box-shadow: none;
  }
  .he-tension[data-bg='ink'] .he-pain__title,
  .he-tension[data-bg='ink'] .he-pain__fix { color: var(--paper); }

  /* ── En-tete de chapitre (kicker mono § + h2 + lede) ── */
  .he-head {
    max-width: var(--wrap-read);
    margin-bottom: var(--space-7); /* iter 6 : space-9 -> space-7 (respiration gardee, vide reduit) */
  }
  .he-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-kicker);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0 0 var(--space-4);
  }
  .he-h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    font-weight: var(--fw-medium);
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-display);
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  /* Money/proof : cran display superieur (varie l'echelle typographique) */
  .he-h2--xl { font-size: var(--text-h1); line-height: var(--leading-h1); }
  .he-lede {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: var(--leading-lede);
    color: var(--muted);
    margin: var(--space-5) 0 0;
    max-width: var(--wrap-prose);
  }

  /* ── 03 · Tabs familles (etage V8) · barre hairline sobre, PAS de pills ──
     Idiome repris de FeatureTabs (underline hairline + segment actif accent). */
  .he-tabs { margin-bottom: var(--space-7); } /* iter 6 : space-9 -> space-7 */
  .he-tabs__list {
    display: flex;
    gap: var(--space-6);
    border-bottom: 1px solid var(--hairline);
    margin-bottom: var(--space-6); /* iter 6 : space-8 -> space-6 */
    overflow-x: auto;
    scrollbar-width: none;
  }
  .he-tabs__list::-webkit-scrollbar { display: none; }
  .he-tab {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) 0;
    margin-bottom: -1px;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono-tight);
    color: var(--muted);
    white-space: nowrap;
    transition:
      color var(--dur-trim) var(--ease),
      border-color var(--dur-trim) var(--ease);
  }
  .he-tab.is-active {
    color: var(--ink);
    border-bottom-color: var(--accent-text);
  }
  .he-tab:not(.is-disabled):not(.is-active):hover { color: var(--ink); }
  .he-tab.is-disabled { cursor: not-allowed; color: var(--muted); }
  .he-tab__badge {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent-text);
    padding: var(--space-1) var(--space-2);
