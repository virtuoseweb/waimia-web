---
export const prerender = true;

/**
 * Home · variante E · MAQUETTE design-lab (etapes 0 a 2, arret GATE B).
 * noindex, hors nav, hors sitemap. Ne remplace PAS la home live.
 *
 * Objectif E = la home LIVE raccourcie, hierarchisee, dedoublonnee, clarifiee,
 * en gardant la richesse visuelle du live (SVG line-art, animations au scroll).
 * Corrige la variante D (rejetee : trop plate + ~20 px en dur) : ici 0 valeur en
 * dur (100 % var(--token) ; hairlines = box-shadow --shadow-card-rest + global
 * .hline + barre de tabs en 1px var(--hairline)/2px var(--accent-text), idiome DS
 * canonique et exception hairline rule 60 ; pas d'AUTRE literal px hors @media /
 * viewBox SVG) + SVG dessines au scroll.
 *
 * Sequence (12 slots) · alternance paper/ink stricte, jamais 2 ink adjacents :
 *   01 Hero (live, paper, composant INTOUCHE)
 *   02 Ecosysteme opere · logo-marquee (SectionsRenderer, ink + grayscale) · bande courte
 *   03 Les deux offres (#offres) · MONEY SLOT · diptyque + rangee 6 services + dorsale SVG (paper)
 *   04 La boucle · statement-orbit CATALOGUE (SectionsRenderer, carte ink dans paper) · PIVOT
 *      conceptuel : les 2 offres = une boucle lire/mesurer/reinjecter · globe filaire line-art
 *   05 La tension · 3 douleurs sobres (direct, paper-2)
 *   06 Cas clients · 3 cartes compactes + ligne CTA discrete (direct, paper)
 *   07 Methode · sticky-scroll-storytelling CATALOGUE (SectionsRenderer, paper-2) · media sticky
 *      crossfade au scroll, contenu c.json TEL QUEL (4 steps), layout differencie de SWI par axes
 *   08 Temoignages · testimonial-wall CATALOGUE (SectionsRenderer, paper) · 6 avis de SWI, en-tete home
 *   09 Tableau de bord media · eeat-panel variant media (SectionsRenderer, ink) · profil/reperes/secteurs
 *      des contenus (cas/blog/ressources/cas-usages/services), liens internes reels verifies
 *   10 Climax chiffre · 2e stats-bento de C (SectionsRenderer, paper-2) · pre-FAQ
 *   11 FAQ · 6 questions, prix garde (FaqAccordion, paper) · SEULE mention de prix
 *   12 Action · BookSession (ink) + FooterMarquee
 *
 * Gate B iter 4 (demande Simon 2026-07-12) : le MONEY SLOT 03 gagne un niveau de TABS (etage
 * FAMILLES du positionnement V8, cf strategy/10 §0bis) : onglet 1 « Systeme marketing » ACTIF
 * (contient toute la matiere du slot : intro d'offre + diptyque + dorsale + rangee 6 services),
 * onglet 2 « Systeme commercial » DESACTIVE (badge « bientot », aria-disabled, non focusable, sans
 * panel) pour materialiser l'extensibilite. Idiome tabs repris de FeatureTabs/pricing-tabs-showcase
 * (aria role tablist/tab/tabpanel + clavier ←/→/Home/End + re-init astro:page-load), style hairline
 * sobre (PAS de pills). Repositionnement INGENIERIE IA : le header du slot pose « Waimia, agence
 * d'ingenierie IA et d'applications pour PME » (kicker) + la definition-citation Simon en lede
 * (« Un systeme metier IA n'est pas une automatisation isolee... »), et la carte 02 devient
 * « Automation & IA » (multi-modeles Claude/ChatGPT/Mistral via MCP, PAS anthropic-first). Touches
 * « ingenierie » legeres ailleurs : lede statement-orbit (04) + kicker methode (07). Hero INTOUCHE.
 *
 * Gate B iter 3 (demandes Simon 2026-07-12) : ajout de deux sections catalogue. `statement-orbit`
 * (slot 04) reintroduit le liant conceptuel perdu avec l'ArchitectureDiagram (les 2 offres forment
 * UNE boucle d'amelioration continue), avec un COPY neuf adapte home (0 reprise du copy SWI). Le
 * `eeat-panel` variant media « tableau de bord media » (slot 09, correction Simon : c'etait CE
 * dashboard qui etait voulu) remplace le media-bento initial ; contenu + liens internes GLOBAUX
 * portes par le composant. Tout passe par <SectionsRenderer> (0 markup inline neuf, 0 fork).
 *
 * Gate B iter 2 (verdict Simon 2026-07-12) : la methode redevient RICHE via le composant catalogue
 * `sticky-scroll-storytelling` (la frise inline condensee + son SVG rail sont SUPPRIMES), les
 * temoignages `testimonial-wall` de SWI s'ajoutent, et le tableau de bord media se DEPLACE juste
 * au-dessus de la FAQ. Tout passe par <SectionsRenderer> (0 markup inline neuf, 0 fork).
 *
 * Doublons du live supprimes (a NE PAS reintroduire) : feature-zigzag (absorbe slot 03),
 * ServicesGrid (absorbe slot 03), pricing-cards (directive : pas de prix hors FAQ), CtaBand
 * accent (remplace par la ligne CTA slot 05), SectionTransition (hierarchie par le design),
 * 1er stats-bento Acte I, bento-grid, eeat-panel, hero-masthead-card (Hero live garde),
 * ArchitectureDiagram (doublon du recit systeme deja porte par le money slot 03).
 */
import Base from '../../layouts/Base.astro';
import Hero from '../../components/ui/organisms/Hero.astro';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import FaqAccordion from '../../components/sections/FaqAccordion.astro';
import BookSession from '../../components/ui/organisms/BookSession.astro';
import FooterMarquee from '../../components/ui/organisms/FooterMarquee.astro';
import homeVariantC from '../../data/page-variants/home/c.json';
import swiContent from '../../content/services/site-web-intelligent.json';
import { SIX_SERVICES } from '../../data/sitemap';
import type { SectionData } from '@waimia/ds-kernel';

const sectionsC = homeVariantC.sections as any[];
const cByType = (t: string) => sectionsC.find((s) => s.type === t);
const swiTestimonials = (swiContent.sections as any[]).find((s) => s.type === 'testimonial-wall');

// 02 · ecosysteme opere · logo-marquee sur fond ink + grayscale (config C, bande courte).
const logoMarquee = {
  ...cByType('logo-marquee'),
  background: 'ink',
  grayscale: true,
  kicker_fr: "§ L’écosystème qu’on opère",
} as SectionData;

// 10 · climax chiffre = 2e stats-bento de C (layout bento : tuile vedette + KPI) · pre-FAQ.
// paper-2 (couleur du live) : l'eeat-panel ink du slot 09 le precede, jamais 2 ink adjacents.
const statsBentoDashboard = {
  ...sectionsC.filter((s) => s.type === 'stats-bento')[1],
  background: 'paper-2',
  kicker_fr: '§ Ce que ça change',
} as SectionData;

// 05 · La tension · 3 douleurs les plus critiques (pain-severity-list de C, contenu reel).
const painItems = (cByType('pain-severity-list').items as any[]).map((it) => ({
  severity: it.severity as string,
  title: it.title_fr as string,
  desc: it.desc_fr as string,
  fix: it.fix_fr as string,
}));
const sevLabel: Record<string, string> = { critical: 'Critique', high: 'Élevé', medium: 'Moyen' };

// 06 · Cas clients · 3 cartes compactes (case-card-grid de C, contenu reel).
const caseItems = (cByType('case-card-grid').cases as any[]).map((c) => ({
  client: c.client as string,
  meta: `${c.sector_fr} · ${c.duration}`,
  impact: c.impact_fr as string,
  href: c.href as string,
}));

// 07 · Methode · sticky-scroll-storytelling CATALOGUE · contenu c.json TEL QUEL (4 steps home,
// media_src illustrations, media sticky crossfade au scroll). Layout DIFFERENCIE de SWI via les
// SEULS axes existants du schema. Layout V1 CHOISI (verdict Simon 2026-07-12, gate B iter 3 :
// « je garde la mise en page actuelle pour méthode ») ; V2/V3/V4 restent au catalogue (lab/home-e-method).
const methodStory = {
  ...cByType('sticky-scroll-storytelling'),
  background: 'paper-2',
  kicker_fr: '§ Méthode · l’ingénierie se construit par paliers',
  textSide: 'right',
  proportion: 'media-wide',
  mediaRatio: '3-2',
  density: 'compact',
  numbering: 'serif',
} as SectionData;

// 08 · Temoignages · testimonial-wall CATALOGUE · les 6 avis de SWI TELS QUELS (0 avis reinvente).
// En-tete ADAPTE a la home (parle du systeme/du studio, pas seulement du site qui qualifie).
const testimonialsHome = {
  ...swiTestimonials,
  background: 'paper',
  kicker_fr: '§ Ils ont mis leur système au travail',
  kicker_en: '§ They put their system to work',
  h2_fr: 'Ce que disent les équipes qui ont mis leur <i>système au travail</i>',
  h2_en: 'What teams who put their <i>system to work</i> are saying',
  subtitle_fr: 'Des dirigeants et des équipes qui ont arrêté de subir leurs outils et fait travailler leur système d’acquisition.',
  subtitle_en: 'Leaders and teams who stopped enduring their tools and put their acquisition system to work.',
} as SectionData;

// 11 · FAQ · 6 questions (sous-ensemble des 8 de C) · Q.01 = prix (SEULE mention de prix), ouverte.
const faqAll = (cByType('faq-accordion').items as any[]);
const faqItems = [0, 1, 2, 3, 4, 6].map((i) => ({ q: faqAll[i].q_fr, a: faqAll[i].a_fr }));

// 03 · 6 services (label + mini-lead + lien) · ABSORPTION de ServicesGrid · source SIX_SERVICES.
const services = SIX_SERVICES.map((s) => ({
  metric: s.metric.fr,
  label: s.label.fr,
  sub: s.connectors.fr,
  href: s.href,
}));

// 04 · statement-orbit CATALOGUE · PIVOT apres le money slot · liant conceptuel : les 2 offres
// forment UNE boucle d'amelioration continue (lire/mesurer/reinjecter). Copy NEUF adapte home,
// 0 reprise du copy SWI (« Chaque brique... » sert de TON, pas de source). Carte ink contenue
// -> pleine largeur au scroll (motion signature du composant). media = globe filaire line-art
// `orbit-network.svg` INLINE par le composant (import ?raw) -> currentColor = paper sur ink :
// traits clairs, PAS de footgun <img>/currentColor-noir (le SVG n'est jamais servi en <img>).
// Pas de CTA : le hero + la ligne cas clients + BookSession couvrent deja /contact, et la
// rangee 6 services du money slot porte deja la nav /services -> un CTA ici serait redondant.
const statementOrbit = {
  type: 'statement-orbit',
  background: 'paper',
  kicker_fr: '§ La boucle',
  kicker_en: '§ The loop',
  h2_fr: 'Les deux offres forment une <i class="acc">boucle</i> : lire, mesurer, réinjecter.',
  h2_en: 'Both offers form one <i class="acc">loop</i>: read, measure, feed back.',
  lede_fr: 'Votre site qualifie chaque visite, les agents traitent et mesurent, ce qui remonte nourrit le cycle suivant. Une ingénierie qui gagne en justesse à chaque tour, sans refonte à chaque palier.',
  lede_en: 'Your site qualifies every visit, the agents process and measure, what comes back feeds the next cycle. A setup that sharpens with every turn, with no rebuild at each tier.',
  media_src: '/images/line-art/orbit-network.svg',
  media_alt_fr: 'Globe filaire aux nœuds relies par des arcs : le site, le CRM, le contenu et les agents tournent en une seule boucle d’acquisition.',
  media_alt_en: 'Wireframe globe with nodes linked by arcs: site, CRM, content and agents turn as one acquisition loop.',
} as SectionData;

// 09 · eeat-panel variant media (INK) = le « TABLEAU DE BORD MÉDIA » de SWI (kicker litteral du
// composant) : profil auteur, reperes, secteurs, badges E-E-A-T. Contenu + liens internes GLOBAUX
// portes par le composant (source unique, meme rendu que SWI). Correction Simon 2026-07-12 :
// c'etait CE dashboard qui etait demande, pas un media-bento de decouverte (retire).
const mediaDashboard = {
  type: 'eeat-panel',
  variant: 'media',
  background: 'ink',
} as SectionData;
---
<Base
  title="Home variante E · maquette design-lab · Waimia"
  description="Maquette interne de la home variante E. Page de laboratoire, non indexée."
  noindex
>
  {/* 01 · Hero live · promesse + mini-map 6 territoires + CTAs · INTOUCHE (reference qualite) */}
  <Hero />

  {/* 02 · Ecosysteme opere · logo-marquee ink + grayscale · bande courte */}
  <SectionsRenderer sections={[logoMarquee]} lang="fr" />

  {/* 03 · Les deux offres · MONEY SLOT · diptyque + dorsale SVG + rangee 6 services */}
  <section class="he-sec he-offres" id="offres" aria-labelledby="he-offres-h2">
    <div class="wrap-wide">
      <header class="he-head reveal">
        <p class="he-kicker">§ Agence d’ingénierie IA &amp; applications</p>
        <h2 id="he-offres-h2" class="he-h2 he-h2--xl u-serif-accent">On <i>conçoit le système</i>, pas juste l’outil.</h2>
        <p class="he-lede">Un système métier IA n’est pas une automatisation isolée, c’est un ensemble cohérent d’applications, de données, de workflows et d’agents conçu autour de vos opérations.</p>
      </header>

      {/* Niveau FAMILLES · tabs (etage V8) · tab 1 « Systeme marketing » actif, tab 2 « commercial » inerte */}
      <div class="he-tabs" data-he-tabs>
        <div class="he-tabs__list" role="tablist" aria-label="Familles de systèmes">
          <button
            class="he-tab is-active"
            role="tab"
            id="he-tab-marketing"
            aria-controls="he-panel-marketing"
            aria-selected="true"
            tabindex="0"
            type="button"
          >
            <span class="he-tab__label">Système marketing</span>
          </button>
          <button
            class="he-tab is-disabled"
            role="tab"
            id="he-tab-commercial"
            aria-selected="false"
            aria-disabled="true"
            tabindex="-1"
            type="button"
            disabled
          >
            <span class="he-tab__label">Système commercial</span>
            <span class="he-tab__badge">bientôt</span>
          </button>
        </div>

        <div
          class="he-tab-panel is-active"
          role="tabpanel"
          id="he-panel-marketing"
          aria-labelledby="he-tab-marketing"
          tabindex="0"
        >
          <div class="he-tabintro reveal">
            <p class="he-tabintro__eyebrow">§ Système marketing · équipes marketing de PME</p>
            <p class="he-tabintro__lede">Un inbound et un outbound qui rapportent vraiment : le site qualifie chaque visite, les agents relancent et mesurent. Deux briques d’un même système, à un early pricing de lancement.</p>
          </div>

          <div class="he-diptych reveal-stagger">
            <article class="he-offer">
              <p class="he-offer__tag">Offre 01</p>
              <h3 class="he-offer__title">Site web intelligent</h3>
              <p class="he-offer__body">Un site Astro + IA, rapide, indexé par Google ET par les moteurs IA, branché à votre CRM. Vitrine et acquisition dans un même canal : landing, tunnel et pages évolutives reliés au pipeline, pas une plaquette figée.</p>
              <div class="hline"></div>
              <ul class="he-offer__points">
                <li>Astro + IA, trouvé par Google et les IA</li>
                <li>Landing, tunnel et pages branchés au CRM</li>
                <li>Vitrine et acquisition dans un même canal</li>
              </ul>
              <a class="he-offer__link" href="/services/site-web-intelligent">Voir l’offre →</a>
            </article>

            <article class="he-offer">
              <p class="he-offer__tag">Offre 02</p>
              <h3 class="he-offer__title">Automation &amp; IA</h3>
              <p class="he-offer__body">On déploie et configure Claude, ChatGPT (Codex d’OpenAI) ou encore Mistral et leurs agents dans votre entreprise, et on les branche à vos outils via MCP : CRM, e-mail, base de données, dépôt Git. Ce qui fait passer un assistant de la conversation à l’action, sur vos données réelles.</p>
              <div class="hline"></div>
              <ul class="he-offer__points">
                <li>Claude, ChatGPT ou Mistral en production</li>
                <li>Serveurs MCP propres vers vos outils</li>
                <li>Gouvernance, mesure et passation incluses</li>
              </ul>
              <a class="he-offer__link" href="/services/integrateur-claude">Voir l’offre →</a>
            </article>
          </div>

          {/* Dorsale line-art · relie visuellement les 2 cartes puis les 6 services · dessinee au scroll */}
          <div class="he-rail hd-draw" aria-hidden="true">
        <svg class="he-rail__svg" viewBox="0 0 1200 150" xmlns="http://www.w3.org/2000/svg" fill="none" role="presentation" focusable="false">
          <path class="hd-line hd-line--2" pathLength="1" d="M300 4 C 300 46, 600 22, 600 62" stroke="var(--accent)" stroke-width="1.2" stroke-opacity="0.7"/>
          <path class="hd-line hd-line--2" pathLength="1" d="M900 4 C 900 46, 600 22, 600 62" stroke="var(--accent)" stroke-width="1.2" stroke-opacity="0.7"/>
          <path class="hd-line hd-line--3" pathLength="1" d="M600 62 L600 108" stroke="var(--accent)" stroke-width="1.2" stroke-opacity="0.6"/>
          <path class="hd-line" pathLength="1" d="M100 108 L1100 108" stroke="var(--hairline-strong)" stroke-width="1"/>
          <path class="hd-line hd-line--3" pathLength="1" d="M100 108 L100 146" stroke="var(--hairline-strong)" stroke-width="1"/>
          <path class="hd-line hd-line--3" pathLength="1" d="M300 108 L300 146" stroke="var(--hairline-strong)" stroke-width="1"/>
          <path class="hd-line hd-line--3" pathLength="1" d="M500 108 L500 146" stroke="var(--hairline-strong)" stroke-width="1"/>
          <path class="hd-line hd-line--3" pathLength="1" d="M700 108 L700 146" stroke="var(--hairline-strong)" stroke-width="1"/>
          <path class="hd-line hd-line--3" pathLength="1" d="M900 108 L900 146" stroke="var(--hairline-strong)" stroke-width="1"/>
          <path class="hd-line hd-line--3" pathLength="1" d="M1100 108 L1100 146" stroke="var(--hairline-strong)" stroke-width="1"/>
          <circle class="hd-node" cx="600" cy="62" r="4" fill="var(--accent)"/>
          <circle class="hd-node" cx="100" cy="146" r="3" fill="var(--accent)"/>
          <circle class="hd-node" cx="300" cy="146" r="3" fill="var(--accent)"/>
          <circle class="hd-node" cx="500" cy="146" r="3" fill="var(--accent)"/>
          <circle class="hd-node" cx="700" cy="146" r="3" fill="var(--accent)"/>
          <circle class="hd-node" cx="900" cy="146" r="3" fill="var(--accent)"/>
          <circle class="hd-node" cx="1100" cy="146" r="3" fill="var(--accent)"/>
        </svg>
          </div>

          <p class="he-services__intro reveal">§ Six services, une seule équipe. On active celui qui sert d’abord.</p>
          <div class="he-services reveal-stagger">
            {services.map((s) => (
              <a class="he-svc" href={s.href}>
                <span class="he-svc__k">{s.metric}</span>
                <span class="he-svc__label">{s.label}</span>
                <span class="he-svc__sub">{s.sub}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 04 · La boucle · statement-orbit CATALOGUE (carte ink dans paper) · PIVOT conceptuel */}
  <SectionsRenderer sections={[statementOrbit]} lang="fr" />

  {/* 05 · La tension · 3 douleurs sobres (paper-2) */}
  <section class="he-sec he-tension" aria-labelledby="he-tension-h2">
    <div class="wrap-wide">
      <header class="he-head reveal">
        <p class="he-kicker">§ La tension</p>
        <h2 id="he-tension-h2" class="he-h2 u-serif-accent">Là où l’argent <i>fuit</i> en interne.</h2>
      </header>
      <ul class="he-pains reveal-stagger">
        {painItems.map((p) => (
          <li class="he-pain">
            <span class="he-pain__sev" data-sev={p.severity}>{sevLabel[p.severity] ?? p.severity}</span>
            <h3 class="he-pain__title">{p.title}</h3>
            <p class="he-pain__desc">{p.desc}</p>
            <div class="hline"></div>
            <p class="he-pain__fix">{p.fix}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* 06 · Cas clients · 3 cartes compactes + ligne CTA discrete (paper) */}
  <section class="he-sec he-cases" aria-labelledby="he-cases-h2">
    <div class="wrap-wide">
      <header class="he-head reveal">
        <p class="he-kicker">§ Cas clients</p>
        <h2 id="he-cases-h2" class="he-h2 u-serif-accent"><i>Promesse</i> vérifiable, pas discours.</h2>
      </header>
      <div class="he-cases__grid reveal-stagger">
        {caseItems.map((c) => (
          <a class="he-case" href={c.href}>
            <p class="he-case__client">{c.client}</p>
            <p class="he-case__meta">{c.meta}</p>
            <p class="he-case__impact">{c.impact}</p>
            <span class="he-case__link">Lire le cas →</span>
          </a>
        ))}
      </div>
      <div class="he-cases__foot reveal">
        <a class="he-cases__all" href="/cas-clients">Voir tous les cas →</a>
        <p class="he-cases__cta">Pas sûr du point de départ ? <a href="/contact">Réserver un audit →</a></p>
      </div>
    </div>
  </section>

  {/* 07 · Methode · sticky-scroll-storytelling CATALOGUE (paper-2) · media sticky crossfade au scroll */}
  <SectionsRenderer sections={[methodStory]} lang="fr" />

  {/* 08 · Temoignages · testimonial-wall CATALOGUE (paper) · 6 avis de SWI, en-tete home */}
  <SectionsRenderer sections={[testimonialsHome]} lang="fr" />

  {/* 09 · Tableau de bord media · eeat-panel variant media (ink) · profil, reperes, secteurs, liens globaux */}
  <SectionsRenderer sections={[mediaDashboard]} lang="fr" />

  {/* 10 · Climax chiffre (2e stats-bento de C, paper-2) · pre-FAQ */}
  <SectionsRenderer sections={[statsBentoDashboard]} lang="fr" />

  {/* 11 · FAQ · 6 questions · Q.01 prix ouverte (SEULE mention de prix de la page) */}
  <FaqAccordion
    items={faqItems}
    heading="Ce qu’on écrit par mail avant de se parler."
    intro="Six réponses nettes, pas des slides, pas du jargon."
    background="paper"
    openFirst
  />

  {/* 12 · Action · BookSession (ink) + FooterMarquee */}
  <BookSession />
  <FooterMarquee />
</Base>

<style>
  /* ── Rythme de section · hierarchie par l'echelle (money/proof amples, soutien compacts) ── */
  .he-sec { padding-block: var(--section-base); }
  .he-offres { padding-block: var(--section-loose); } /* MONEY SLOT : poids visuel maximal */
  .he-tension { background: var(--paper-2); }

  /* ── En-tete de chapitre (kicker mono § + h2 + lede) ── */
  .he-head {
    max-width: var(--wrap-read);
    margin-bottom: var(--space-9);
  }
  .he-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-kicker);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0 0 var(--space-4);
  }
  .he-h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    font-weight: var(--fw-medium);
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-display);
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  /* Money/proof : cran display superieur (varie l'echelle typographique) */
  .he-h2--xl { font-size: var(--text-h1); line-height: var(--leading-h1); }
  .he-lede {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: var(--leading-lede);
    color: var(--muted);
    margin: var(--space-5) 0 0;
    max-width: var(--wrap-prose);
  }

  /* ── 03 · Tabs familles (etage V8) · barre hairline sobre, PAS de pills ──
     Idiome repris de FeatureTabs (underline hairline + segment actif accent). */
  .he-tabs { margin-bottom: var(--space-9); }
  .he-tabs__list {
    display: flex;
    gap: var(--space-6);
    border-bottom: 1px solid var(--hairline);
    margin-bottom: var(--space-8);
    overflow-x: auto;
    scrollbar-width: none;
  }
