  /* ── 03 · Dorsale line-art (relie 2 cartes -> 6 services) ── */
  .he-rail {
    margin: var(--space-4) 0 var(--space-3); /* iter 6 : resserre le vide autour de la dorsale */
  }
  .he-rail__svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ── 03 · Rangee compacte des 6 services (absorption ServicesGrid) ── */
  .he-services__intro {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono-tight);
    color: var(--muted);
    margin: 0 0 var(--space-4); /* iter 6 : space-5 -> space-4 */
  }
  .he-services {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .he-svc {
    display: flex;
