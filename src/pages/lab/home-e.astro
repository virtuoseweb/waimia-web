    color: var(--accent-text);
    font-weight: var(--fw-medium);
    transition: color var(--dur-trim) var(--ease);
  }
  .he-cases__cta a:hover { color: var(--accent); }

  /* ── SVG dessine au scroll · dorsale du money slot (03) ──
     pathLength=1 -> dasharray:1 ; l'IntersectionObserver ajoute .is-drawn (offset -> 0). */
  .hd-line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset var(--dur-slow) var(--ease-out);
  }
  .hd-line--2 { transition-delay: var(--dur-base); }
  .hd-line--3 { transition-delay: var(--dur-panel); }
  .hd-draw.is-drawn .hd-line { stroke-dashoffset: 0; }
  .hd-node {
    opacity: 0;
    transition: opacity var(--dur-reveal) var(--ease-out) var(--dur-panel);
  }
  .hd-draw.is-drawn .hd-node { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .hd-line { stroke-dashoffset: 0; transition: none; }
    .hd-node { opacity: 1; transition: none; }
    .he-offer:hover,
    .he-svc:hover,
    .he-case:hover { transform: none; }
  }

  /* ── Responsive · litteraux px en @media UNIQUEMENT (var() interdit en condition) ── */
  @media (max-width: 900px) {
    .he-diptych,
    .he-pains,
    .he-cases__grid { grid-template-columns: 1fr; }
    .he-services { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .he-rail { display: none; } /* la dorsale n'a de sens qu'en grille large */
  }
  @media (max-width: 560px) {
    .he-services { grid-template-columns: 1fr; }
    .he-cases__foot { flex-direction: column; align-items: flex-start; }
  }
</style>

<script is:inline>
  /* Dessin des SVG au scroll · IntersectionObserver -> .is-drawn (stroke-dashoffset).
     Reduced-motion : le CSS montre deja l'etat final. Re-init compatible ClientRouter. */
  (() => {
    if (typeof window === 'undefined') return;
    function initHeDraw() {
      const nodes = document.querySelectorAll('.hd-draw');
      if (!nodes.length) return;
      const io = new IntersectionObserver((entries, obs) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-drawn');
            obs.unobserve(e.target);
          }
        });
      }, { threshold: 0.2 });
      nodes.forEach((n) => {
        if (n.dataset.drawBound === '1') return;
        n.dataset.drawBound = '1';
        io.observe(n);
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeDraw);
    } else {
      initHeDraw();
    }
    document.addEventListener('astro:page-load', initHeDraw);
  })();
</script>

<script is:inline>
  /* Tabs familles (money slot 03) · aria tablist/tab/tabpanel + clavier ←/→/Home/End.
     Idiome FeatureTabs/pricing-tabs, adapte : les onglets desactives (aria-disabled) sont
     ignores (non focusables, sans panel). 1 seul onglet actif ici, structure prete pour N.
     Re-init compatible ClientRouter (astro:page-load) + garde anti double-binding. */
  (() => {
    if (typeof window === 'undefined') return;
    function initHeTabs() {
      const root = document.querySelector('[data-he-tabs]');
      if (!root || root.dataset.tabsBound === '1') return;
      const tabs = Array.from(root.querySelectorAll('[role="tab"]'))
        .filter((t) => t.getAttribute('aria-disabled') !== 'true' && !t.hasAttribute('disabled'));
      if (!tabs.length) return;
      root.dataset.tabsBound = '1';
      function activate(idx) {
        tabs.forEach((tab, i) => {
          const active = i === idx;
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
          tab.tabIndex = active ? 0 : -1;
          tab.classList.toggle('is-active', active);
          const pid = tab.getAttribute('aria-controls');
          const panel = pid && document.getElementById(pid);
          if (panel) {
            panel.classList.toggle('is-active', active);
            panel.toggleAttribute('hidden', !active);
          }
        });
      }
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => { activate(i); tab.focus(); });
        tab.addEventListener('keydown', (e) => {
          const total = tabs.length;
          if (e.key === 'ArrowRight') { e.preventDefault(); activate((i + 1) % total); tabs[(i + 1) % total].focus(); }
          if (e.key === 'ArrowLeft')  { e.preventDefault(); activate((i - 1 + total) % total); tabs[(i - 1 + total) % total].focus(); }
          if (e.key === 'Home') { e.preventDefault(); activate(0); tabs[0].focus(); }
          if (e.key === 'End')  { e.preventDefault(); activate(total - 1); tabs[total - 1].focus(); }
        });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeTabs);
    } else {
      initHeTabs();
    }
    document.addEventListener('astro:page-load', initHeTabs);
  })();
</script>
