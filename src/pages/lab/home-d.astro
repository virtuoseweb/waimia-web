---
export const prerender = true;

/**
 * Home · variante D · MAQUETTE design-lab (etapes 0 a 2, arret GATE B).
 * noindex, hors nav, hors sitemap. Ne remplace PAS la home live.
 *
 * Modele HOME distinct des templates services : meme DA, rythme et structure propres.
 * Pas d'appareil fig (« FIG II · 2.0 »), ouverture editoriale par kicker mono §,
 * diptyque des offres, diagramme systeme dessine, une idee par slot, on aiguille.
 *
 * Sequence (10 slots) · alternance paper/ink stricte, jamais 2 ink adjacents :
 *   01 Hero (live, paper, composant intouche)
 *   02 logo-marquee « ecosysteme opere » (SectionsRenderer, ink + grayscale)
 *   03 Deux offres · diptyque (direct, paper) [#offres]
 *   04 Le modele connecte (direct, ink) · fusion ArchitectureDiagram + bento-grid
 *   05 La tension (direct, paper-2) · pain-severity adapte
 *   06 Tableau de bord media (SectionsRenderer, stats-bento index 8, ink) · CLIMAX
 *   07 Cas clients (direct, paper) · case-card-grid adapte
 *   08 Methode paliers (direct, paper-2) · sticky-scroll steps declines
 *   09 FAQ (direct, paper) · 6 questions PME
 *   10 CTA final (direct, ink) · footer-cta-band adapte
 *
 * Doublons live/C tranches : stats-bento index 1 (retire), bento-grid (fusionne 04),
 * hero-masthead-card (retire, Hero live garde), eeat-panel (retire), pricing-cards
 * (retire, directive 4 : pas de prix sur la home). Rapport : /tmp/codex-missions/waimia-home-d/REPORT.md
 */
import Base from '../../layouts/Base.astro';
import Hero from '../../components/ui/organisms/Hero.astro';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import homeVariantC from '../../data/page-variants/home/c.json';
import type { SectionData } from '@waimia/ds-kernel';

const sectionsC = homeVariantC.sections as any[];
const cByType = (t: string) => sectionsC.find((s) => s.type === t);

// 02 · ecosysteme opere · logo-marquee sur fond ink + grayscale (directive « a garder »).
const logoMarquee = {
  ...cByType('logo-marquee'),
  background: 'ink',
  grayscale: true,
  kicker_fr: "§ L'ecosysteme qu'on opere",
} as SectionData;

// 06 · tableau de bord media = 2e stats-bento de C (index 8, layout bento : tuile vedette
// ink + chiffre geant + KPI secondaires). Kicker service « Acte III » neutralise pour la home.
const statsBentoDashboard = {
  ...sectionsC.filter((s) => s.type === 'stats-bento')[1],
  background: 'ink',
  kicker_fr: '§ Ce que ca change',
} as SectionData;
---
<Base
  title="Home variante D · maquette design-lab · Waimia"
  description="Maquette interne de la home variante D. Page de laboratoire, non indexee."
  noindex
>
  {/* 01 · Hero live · promesse + mini-map 6 territoires + CTAs · INTOUCHE (reference qualite) */}
  <Hero />

  {/* 02 · Ecosysteme opere · logo-marquee ink + grayscale (SectionsRenderer, config C) */}
  <SectionsRenderer sections={[logoMarquee]} lang="fr" />

  {/* 03 · Deux offres · diptyque (money section, aiguillage) */}
  <section class="hd-sec hd-offres" id="offres" aria-labelledby="hd-offres-h2">
    <div class="wrap-wide">
      <header class="hd-head reveal">
        <p class="hd-kicker">§ Deux offres, une couche continue</p>
        <h2 id="hd-offres-h2" class="hd-h2">Un <i>site qui travaille</i>, des agents qui <i>agissent</i>.</h2>
        <p class="hd-lede">Deux portes d'entree, une meme couche continue. On active celle qui sert votre maturite, on branche le reste quand c'est rentable.</p>
      </header>
      <div class="hd-offres__grid reveal-stagger">
        <article class="hd-offer">
          <p class="hd-offer__tag">Offre 01</p>
          <h3 class="hd-offer__title">Site web intelligent</h3>
          <p class="hd-offer__body">Un site Astro + IA, rapide, indexe par Google ET par les moteurs IA, branche a votre CRM. Vitrine et acquisition dans un meme canal : landing, tunnel et pages evolutives relies au pipeline, pas une plaquette figee.</p>
          <ul class="hd-offer__points">
            <li>Astro + IA, trouve par Google et les IA</li>
            <li>Landing, tunnel et pages branches au CRM</li>
            <li>Vitrine et acquisition dans un meme canal</li>
          </ul>
          <a class="hd-offer__link" href="/services/site-web-ia">Voir l'offre &rarr;</a>
        </article>
        <article class="hd-offer">
          <p class="hd-offer__tag">Offre 02</p>
          <h3 class="hd-offer__title">Integration Claude</h3>
          <p class="hd-offer__body">On deploie Claude et ses agents dans votre entreprise et on les branche a vos outils via MCP : CRM, e-mail, base de donnees, depot Git. La couche qui fait passer un assistant de la conversation a l'action, sur vos donnees reelles.</p>
          <ul class="hd-offer__points">
            <li>Claude et ses agents en production</li>
            <li>Serveurs MCP propres vers vos outils</li>
            <li>Gouvernance, mesure et passation incluses</li>
          </ul>
          <a class="hd-offer__link" href="/services/integration-claude">Voir l'offre &rarr;</a>
        </article>
      </div>
    </div>
  </section>

  {/* 04 · Le modele connecte · UN seul recit d'architecture (fusion ArchitectureDiagram + bento-grid) */}
  <section class="hd-sec hd-system on-dark" aria-labelledby="hd-system-h2">
    <div class="wrap-wide">
      <header class="hd-head reveal">
        <p class="hd-kicker">§ Le systeme connecte</p>
        <h2 id="hd-system-h2" class="hd-h2">Une seule <i>architecture</i>.<br />Six entrees, un systeme, mille decisions.</h2>
      </header>
      <div class="hd-flow reveal">
        <div class="hd-flow__side">
          <p class="hd-flow__label">6 entrees</p>
          <ul class="hd-flow__col">
            <li>Ads</li><li>Contenu</li><li>Site</li><li>CRM</li><li>Analytics</li><li>Marque</li>
          </ul>
        </div>
        <div class="hd-flow__core" aria-hidden="true">
          <span class="hd-flow__core-kicker">AI SYSTEM</span>
          <span class="hd-flow__core-name">Waimia</span>
          <span class="hd-flow__core-sub">multi-agents</span>
        </div>
        <div class="hd-flow__side">
          <p class="hd-flow__label">4 sorties</p>
          <ul class="hd-flow__col hd-flow__col--out">
            <li>Actions</li><li>Supports</li><li>Reporting</li><li>Pipeline</li>
          </ul>
        </div>
      </div>
      <p class="hd-flow__loop reveal">&#8635;&ensp;Boucle d'amelioration continue</p>
      <p class="hd-flow__caption reveal">Six canaux entrent. Quatre familles d'<i>actions</i> sortent. Au milieu, un systeme multi-agents qui mesure, apprend et reinjecte, sans relance manuelle. La continuite entre vos outils, pas un enieme logiciel de plus.</p>
    </div>
  </section>

  {/* 05 · La tension · le vrai probleme (pain-severity adapte) */}
  <section class="hd-sec hd-tension" aria-labelledby="hd-tension-h2">
    <div class="wrap-wide">
      <header class="hd-head reveal">
        <p class="hd-kicker">§ La tension</p>
        <h2 id="hd-tension-h2" class="hd-h2">La ou l'argent <i>fuit</i> en interne.</h2>
      </header>
      <ul class="hd-pains reveal-stagger">
        <li class="hd-pain">
          <span class="hd-pain__sev" data-sev="critical">Critique</span>
          <h3 class="hd-pain__title">L'argent fuit dans les passations</h3>
          <p class="hd-pain__body">Lead vers CRM, CRM vers vente, vente vers livraison. Chaque rupture coute un client. Le reflexe de tout refaire trompe : c'est la continuite qui manque.</p>
          <p class="hd-pain__fix">Reconnecter le pipeline de bout en bout.</p>
        </li>
        <li class="hd-pain">
          <span class="hd-pain__sev" data-sev="high">Eleve</span>
          <h3 class="hd-pain__title">Une demo qui n'atteint jamais la production</h3>
          <p class="hd-pain__body">Un POC qui impressionne en reunion, puis dort dans un Notion six mois plus tard : aucun process automatise, aucune heure gagnee.</p>
          <p class="hd-pain__fix">Mise en production, du POC au workflow reel.</p>
        </li>
        <li class="hd-pain">
          <span class="hd-pain__sev" data-sev="medium">Moyen</span>
          <h3 class="hd-pain__title">L'humain reste la couche d'integration</h3>
          <p class="hd-pain__body">Vos outils ne se parlent pas : les equipes copient, relancent et font le pont a la main toute la journee, sans donnees metier structurees.</p>
          <p class="hd-pain__fix">Brancher les outils via MCP, donnees reliees.</p>
        </li>
      </ul>
    </div>
  </section>

  {/* 06 · Tableau de bord media · CLIMAX (stats-bento index 8, ink, tuile vedette + KPI) */}
  <SectionsRenderer sections={[statsBentoDashboard]} lang="fr" />

  {/* 07 · Cas clients · preuve verifiable (case-card-grid adapte) */}
  <section class="hd-sec hd-cases" aria-labelledby="hd-cases-h2">
    <div class="wrap-wide">
      <header class="hd-head reveal">
        <p class="hd-kicker">§ Cas clients</p>
        <h2 id="hd-cases-h2" class="hd-h2"><i>Promesse</i> verifiable, pas discours.</h2>
      </header>
      <div class="hd-cases__grid reveal-stagger">
        <a class="hd-case" href="/cas-clients/amploi">
          <p class="hd-case__client">Amploi &middot; groupe Vigiscope</p>
          <p class="hd-case__meta">Externalisation RH &middot; 6 sem.</p>
          <p class="hd-case__impact">Site cree avec formulaires branches HubSpot pour l'attribution des leads et balisage schema.org pense pour les citations IA (Perplexity, ChatGPT, Claude).</p>
          <span class="hd-case__link">Lire le cas &rarr;</span>
        </a>
        <a class="hd-case" href="/cas-clients/les-carnets-de-montpellier">
          <p class="hd-case__client">Les Carnets de Montpellier</p>
          <p class="hd-case__meta">Patrimoine / Media local &middot; 6 sem.</p>
          <p class="hd-case__impact">Plateforme creee de zero avec pipeline editorial assiste par IA : 40 articles, 150 membres, 35 abonnes payants et top 10 Google local en 3 mois.</p>
          <span class="hd-case__link">Lire le cas &rarr;</span>
        </a>
        <a class="hd-case" href="/cas-clients/balzeo">
          <p class="hd-case__client">Balzeo</p>
          <p class="hd-case__meta">E-commerce ecoresponsable &middot; 8 sem.</p>
          <p class="hd-case__impact">Refonte complete pilotable depuis un chatbot IA : temps de chargement reduit de moitie (5,2 s a 2,4 s), retention +35 %, cout de maintenance -84 %.</p>
          <span class="hd-case__link">Lire le cas &rarr;</span>
        </a>
      </div>
      <a class="hd-cases__all" href="/cas-clients">Voir tous les cas &rarr;</a>
    </div>
  </section>

  {/* 08 · Methode · comment on monte (sticky-scroll steps declines en step-line compacte) */}
  <section class="hd-sec hd-method" aria-labelledby="hd-method-h2">
    <div class="wrap-wide">
      <header class="hd-head reveal">
        <p class="hd-kicker">§ Methode</p>
        <h2 id="hd-method-h2" class="hd-h2">Du <i>diagnostic</i> a l'infrastructure.</h2>
        <p class="hd-lede">Chaque palier prepare le suivant : vous montez quand vous etes pret. Vous savez avant de signer quel levier on attaque en premier et ce qu'il rapporte.</p>
      </header>
      <ol class="hd-steps reveal-stagger">
        <li class="hd-step">
          <span class="hd-step__num">I</span>
          <p class="hd-step__eyebrow">Activation rapide</p>
          <h3 class="hd-step__title">Identifier le levier et livrer vite</h3>
          <p class="hd-step__body">Audit process en 5 jours, formation, premier workflow en production. On part du concret, pas d'un PowerPoint.</p>
        </li>
        <li class="hd-step">
          <span class="hd-step__num">II</span>
          <p class="hd-step__eyebrow">Productivite operationnelle</p>
          <h3 class="hd-step__title">Supprimer les taches recurrentes</h3>
          <p class="hd-step__body">On retire les taches repetitives et on fluidifie les workflows internes : ils tournent sans relance quotidienne.</p>
        </li>
        <li class="hd-step">
          <span class="hd-step__num">III</span>
          <p class="hd-step__eyebrow">Acquisition &amp; pilotage</p>
          <h3 class="hd-step__title">Connecter site, CRM et contenu</h3>
          <p class="hd-step__body">Pipeline commercial, tableaux de pilotage, contenu SEO/GEO : tout converge vers un canal qui mesure et apprend.</p>
        </li>
        <li class="hd-step">
          <span class="hd-step__num">IV</span>
          <p class="hd-step__eyebrow">Infrastructure</p>
          <h3 class="hd-step__title">Industrialiser et passer la main</h3>
          <p class="hd-step__body">Systemes connectes multi-equipes, gouvernance stricte. La passation fait partie du livrable : vous gardez la main et la stack.</p>
        </li>
      </ol>
    </div>
  </section>

  {/* 09 · FAQ · objections PME avant l'appel (6 questions, 1re ouverte) */}
  <section class="hd-sec hd-faq" aria-labelledby="hd-faq-h2">
    <div class="wrap-tight">
      <header class="hd-head reveal">
        <p class="hd-kicker">§ Questions frequentes</p>
        <h2 id="hd-faq-h2" class="hd-h2">Ce qu'on ecrit par mail <i>avant</i> de se parler.</h2>
      </header>
      <div class="hd-faq__list reveal">
        <details class="hd-faq__item" open>
          <summary class="hd-faq__q">Pour qui c'est fait, et pour qui ce n'est pas fait ?</summary>
          <p class="hd-faq__a">PME francaises, 10 a 250 collaborateurs. Pas les grands groupes deja bardes de prestataires, pas les startups trop jeunes qui changent de cap chaque semaine. Nos meilleurs profils : services B2B, industrie, cabinets finance et compta, commerces qui veulent un site qui travaille.</p>
        </details>
        <details class="hd-faq__item">
          <summary class="hd-faq__q">En combien de temps voit-on un retour sur investissement ?</summary>
          <p class="hd-faq__a">Un premier systeme part en production en 1 a 2 semaines, mesure avant/apres incluse. Un systeme complet se deploie en 5 a 12 semaines selon le perimetre. On orchestre, puis on mesure : le ROI est releve sur vos donnees, pas un chiffre moyen invente.</p>
        </details>
        <details class="hd-faq__item">
          <summary class="hd-faq__q">Faut-il refaire notre site et notre CMS actuels ?</summary>
          <p class="hd-faq__a">Non. On se branche sur votre CMS existant (WordPress, Webflow, Sanity, headless) ou on bascule vers un CMS Git-based si la maturite de l'equipe le permet. Sites IA-first, landing et pages evolutives peuvent vivre en parallele ou remplacer progressivement l'existant, a votre rythme.</p>
        </details>
        <details class="hd-faq__item">
          <summary class="hd-faq__q">Travaillez-vous avec notre stack actuelle (HubSpot, Salesforce, Excel) ?</summary>
          <p class="hd-faq__a">Oui : HubSpot, Salesforce, Pipedrive, Notion, Excel, Office, ERP. Pas de migration imposee. Si vous n'avez pas de CRM, on en propose un adapte a votre volume. La connexion passe par des serveurs MCP propres et documentes.</p>
        </details>
        <details class="hd-faq__item">
          <summary class="hd-faq__q">Comment garantissez-vous la conformite RGPD et la tracabilite ?</summary>
          <p class="hd-faq__a">Chaque systeme inclut par defaut : journal des actions, export CSV/JSON, retour arriere possible, classification du risque AI Act. Chaque agent a un perimetre defini et des permissions explicites ; les actions sensibles passent par une validation humaine, jamais en boite noire.</p>
        </details>
        <details class="hd-faq__item">
          <summary class="hd-faq__q">Et si on veut reprendre la main en interne ?</summary>
          <p class="hd-faq__a">Tout est documente, ouvert, transmissible. Pas de boite noire, pas de captivite. On forme votre equipe pendant la mission (2 a 3 jours) et on livre le mode operatoire complet. Vous gardez la plateforme et la stack quand on part.</p>
        </details>
      </div>
    </div>
  </section>

  {/* 10 · CTA final · sortie audit gratuit (footer-cta-band adapte) */}
  <section class="hd-sec hd-cta on-dark" aria-labelledby="hd-cta-h2">
    <div class="wrap-tight hd-cta__inner reveal">
      <p class="hd-kicker">§ Pret a mettre l'IA en production ?</p>
      <h2 id="hd-cta-h2" class="hd-h2">Sortez l'IA de la demo, mettez-la en <i>production</i>.</h2>
      <p class="hd-lede">Un diagnostic gratuit et sans engagement : vous repartez avec une cartographie de vos cas d'usage et un premier levier cible, qu'on travaille ensemble ou non. En face, le fondateur qui audite, concoit et mesure lui-meme, pas un pool de sous-traitants.</p>
      <div class="hd-cta__actions">
        <a class="btn btn-primary btn-lg" href="/contact">Reserver un audit gratuit &rarr;</a>
        <a class="btn btn-ghost btn-lg" href="#offres">Voir les deux offres</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Base de section home-d · rythme respirant, hairline entre chapitres ── */
  .hd-sec {
    padding-block: var(--section-base);
    border-bottom: 1px solid var(--hairline);
  }
  .hd-tension,
  .hd-method { background: var(--paper-2); }
  .hd-system,
  .hd-cta {
    background: var(--ink);
    color: var(--paper);
  }

  /* ── En-tete de chapitre (kicker mono § + h2 sans + lede) ── */
  .hd-head {
    max-width: var(--wrap-read);
    margin-bottom: var(--space-12);
  }
  .hd-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-kicker);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0 0 var(--space-4);
  }
  .hd-h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    font-weight: var(--fw-medium);
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-display);
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .hd-system .hd-h2,
  .hd-cta .hd-h2 { color: var(--paper); }
  .hd-lede {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: var(--leading-lede);
    color: var(--muted);
    margin: var(--space-5) 0 0;
    max-width: var(--wrap-prose);
  }

  /* ── 03 · Diptyque des offres ── */
  .hd-offres__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gut);
  }
  .hd-offer {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-9);
    background: var(--paper-2);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    transition:
      transform var(--dur-hover) var(--ease),
      box-shadow var(--dur-hover) var(--ease);
  }
  .hd-offer:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }
  .hd-offer__tag {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0;
  }
  .hd-offer__title {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: var(--fw-semibold);
    color: var(--ink);
    margin: 0;
  }
  .hd-offer__body {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--muted);
    margin: 0;
  }
  .hd-offer__points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    border-top: 1px solid var(--hairline);
    padding-top: var(--space-5);
  }
  .hd-offer__points li {
    position: relative;
    padding-left: var(--space-5);
    font-size: var(--text-body);
    color: var(--ink);
  }
  .hd-offer__points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--accent);
  }
  .hd-offer__link {
    margin-top: auto;
    padding-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono-tight);
    color: var(--accent-text);
    text-decoration: none;
    transition: color var(--dur-trim) var(--ease);
  }
  .hd-offer__link:hover { color: var(--accent); }

  /* ── 04 · Le modele connecte · diagramme entrees / noyau / sorties ── */
  .hd-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-9);
    align-items: center;
  }
  .hd-flow__label {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0 0 var(--space-4);
  }
  .hd-flow__col {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .hd-flow__col li {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: var(--fw-medium);
    color: var(--paper);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    background: var(--ink-2);
  }
  .hd-flow__col--out { align-items: stretch; text-align: right; }
  .hd-flow__core {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    text-align: center;
    min-width: 14rem;
    padding: var(--space-9);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-lg);
    background: var(--ink-2);
  }
  .hd-flow__core-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .hd-flow__core-name {
    font-family: var(--font-sans);
    font-weight: var(--fw-semibold);
    font-size: var(--text-stat);
    line-height: var(--leading-h1);
    letter-spacing: -0.015em;
    color: var(--paper);
  }
  .hd-flow__core-sub {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--muted);
  }
  .hd-flow__loop {
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
