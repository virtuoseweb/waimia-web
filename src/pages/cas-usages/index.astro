---
export const prerender = true;

// Page SSG · /cas-usages · HUB des cas d'usage · rendu 100 % composable (registry).
// Hero court (hero-hub-masthead) + cartes dérivées de la collection via la section
// catalogue `related-cards-band` (chunkée 2-3, cap schéma .max(3)). 0 CSS bespoke.
// Compile même collection vide (les .mdx arrivent en parallèle) : si <2 cartes, on
// n'émet aucun band (page reste valide : hero + CTA).
// Rubrique « Études de cas du marché » (section catalogue `market-cases`, variante digest) :
// cas réels réalisés par des TIERS, lus dans src/data/market-cases.ts, rendus dans un bloc
// séparé des cartes Waimia. Aucun de leurs chiffres ne remonte dans le hero ni les cartes.

import { AUDIT_BOOKING_HREF, AUDIT_BOOKING_LABEL } from '../../data/conversion';
import { getLiveCollection } from '../../lib/live-collection';
import Base from '../../layouts/Base.astro';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import MastheadBar from '../../components/sections/MastheadBar.astro';
import { buildCollectionPage } from '../../lib/seo/schema-builder';
import type { SectionData, SectionByType } from '@waimia/ds-kernel';
import { SITE } from '../../site.config';
import { MARKET_CASE_FUNCTION_LABEL } from '../../data/market-cases';

const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fr';
const isFr = lang === 'fr';

type Card = SectionByType<'related-cards-band'>['cards'][number];

// Pages « par fonction » : celles qui portent une rubrique d'études de cas du marché.
const FUNCTION_HREFS = new Set(Object.values(MARKET_CASE_FUNCTION_LABEL).map((l) => l.href));

const cards: Card[] = (await getLiveCollection('cas-usages'))
  .filter((e) => e.data.seo?.noindex !== true)
  .sort((a, b) => (a.data.slug ?? a.id).localeCompare(b.data.slug ?? b.id))
  .map((e) => {
    const d = e.data;
    // Libellé de carte court dérivé du title long (segment avant « · »).
    const shortTitle = (full: string) => full.split(' · ')[0].trim();
    return {
      kicker_fr: "Cas d'usage",
      kicker_en: 'Use case',
      title_fr: shortTitle(d.title_fr),
      title_en: shortTitle(d.title_en),
      lead_fr: d.description_fr,
      lead_en: d.description_en,
      href: `/cas-usages/${d.slug ?? e.id}`,
    };
  });

// Chunker équilibré 2-3 (jamais de singleton) : respecte .min(2)/.max(3) du schéma.
function chunkCards(items: Card[]): Card[][] {
  if (items.length < 2) return [];
  const chunks: Card[][] = [];
  let rest = [...items];
  while (rest.length > 0) {
    if (rest.length === 4) {
      chunks.push(rest.slice(0, 2));
      chunks.push(rest.slice(2, 4));
      rest = [];
    } else if (rest.length <= 3) {
      chunks.push(rest);
      rest = [];
    } else {
      chunks.push(rest.slice(0, 3));
      rest = rest.slice(3);
    }
  }
  return chunks;
}

const hero: SectionByType<'hero-hub-masthead'> = {
  type: 'hero-hub-masthead',
  background: 'paper',
  variant: 'hub',
  decoration: false,
  align: 'left',
  kicker_fr: "§ Cas d'usage · ce que l'IA débloque concrètement",
  kicker_en: '§ Use cases · what AI unblocks concretely',
  h1_fr: '<span>Cas d\'usage <i>IA</i> en PME :</span><br/><span>le gain réel, pas une démo.</span>',
  h1_en: '<span><i>AI</i> use cases:</span><br/><span>real gain, not a demo.</span>',
  lede_fr: "Par problème (administratif, données, suivi commercial) et par fonction (support, comptabilité, RH). Chaque page dit ce qu'on automatise, dans quel ordre et où sont les limites. Les cas réalisés par d'autres que Waimia sont sourcés et présentés à part.",
  lede_en: 'By problem (admin, data, sales follow-up) and by function (support, accounting, HR). Each page says what to automate, in what order and where the limits are. Cases delivered by others than Waimia are sourced and shown separately.',
};

const ctaFinal: SectionByType<'cta-final'> = {
  type: 'cta-final',
  background: 'ink',
  h2_fr: 'Un cas qui ressemble au <i>vôtre</i> ?',
  h2_en: 'A case that looks like <i>yours</i>?',
  body_fr: "L'audit gratuit de 45 minutes part de vos processus et dit quel cas d'usage attaquer en premier, qu'on travaille ensemble ou non.",
  body_en: 'We frame your need in 45 minutes and tell you quickly which use case to tackle first, whether we work together or not.',
  cta_primary: {
    label_fr: AUDIT_BOOKING_LABEL.fr,
    label_en: AUDIT_BOOKING_LABEL.en,
    href: AUDIT_BOOKING_HREF,
    variant: 'primary',
  },
  cta_secondary: {
    label_fr: 'Voir les services →',
    label_en: 'See the services →',
    href: '/services/integration-claude',
    variant: 'ghost',
  },
};

// Deux groupes de cartes : par problème (pages historiques) puis par fonction.
const bandsFor = (items: Card[], kicker: { fr: string; en: string }, background: 'paper' | 'paper-2'): SectionData[] =>
  chunkCards(items).map((chunk, i) => ({
    type: 'related-cards-band',
    background,
    ...(i === 0 ? { kicker_fr: kicker.fr, kicker_en: kicker.en } : {}),
    cards: chunk,
  }) satisfies SectionByType<'related-cards-band'>);

const cardBands: SectionData[] = [
  ...bandsFor(cards.filter((c) => !FUNCTION_HREFS.has(c.href)), { fr: '§ Par problème à résoudre', en: '§ By problem to solve' }, 'paper'),
  ...bandsFor(cards.filter((c) => FUNCTION_HREFS.has(c.href)), { fr: "§ Par fonction de l'entreprise", en: '§ By business function' }, 'paper-2'),
];

const marketCases: SectionByType<'market-cases'> = {
  type: 'market-cases',
  background: 'paper-3',
  variant: 'digest',
  kicker_fr: '§ Études de cas du marché',
  kicker_en: '§ Market case studies',
  h2_fr: 'Études de cas du marché',
  h2_en: 'Market case studies',
  intro_fr: "Des déploiements réels, menés par d'autres entreprises et publiés par elles ou par les éditeurs de leurs outils. Nous avons lu chaque source ; le résultat est rapporté tel qu'elle le formule. Le détail de ce qui a été automatisé et la citation exacte sont sur la page de chaque fonction.",
  intro_en: 'Real rollouts, run by other companies and published by them or by their tool vendors. We read each source; the result is reported as the source words it. What was automated in detail and the exact quote are on each function page.',
  groups: (Object.entries(MARKET_CASE_FUNCTION_LABEL) as Array<[string, (typeof MARKET_CASE_FUNCTION_LABEL)[keyof typeof MARKET_CASE_FUNCTION_LABEL]]>).map(
    ([fn, l]) => ({ function: fn, title_fr: l.fr, title_en: l.en, href: `${l.href}#etudes-de-cas-du-marche` }),
  ),
};

const sections: SectionData[] = [hero, ...cardBands, { ...marketCases, anchor: 'etudes-de-cas-du-marche' } as SectionData, ctaFinal];

const pageLd = buildCollectionPage(
  isFr ? "Cas d'usage IA pour PME · Waimia" : 'AI use cases for SMBs · Waimia',
  isFr
    ? "Cas d'usage IA pour PME, par problème et par fonction : administratif, données, suivi commercial, support, comptabilité, RH."
    : 'AI use cases for SMBs, by problem and by function: admin, data, sales follow-up, support, accounting, HR.',
  cards.map((c) => ({ '@type': 'WebPage', name: isFr ? c.title_fr : c.title_en, url: `${SITE.url}${c.href}` })),
);
---

<Base
  title={isFr ? "Cas d'usage IA et automatisation pour PME · Waimia" : 'AI use cases for SMBs · Waimia'}
  description={isFr
    ? "Cas d'usage IA pour PME, par problème et par fonction : administratif, données, suivi commercial, support, comptabilité, RH. Limites et sources comprises."
    : 'AI use cases for SMBs, by problem and by function: admin, data, sales follow-up, support, accounting, HR. Limits and sources included.'}
  jsonLd={pageLd}
>
  <MastheadBar
    lang={lang}
    items={[
      { label: isFr ? 'Accueil' : 'Home', href: isFr ? '/' : '/en' },
      { label: isFr ? "Cas d'usage" : 'Use cases' },
    ]}
  />
  <SectionsRenderer sections={sections} lang={lang} />
</Base>
