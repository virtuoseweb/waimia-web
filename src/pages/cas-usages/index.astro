---
export const prerender = true;

// Page SSG · /cas-usages · HUB des cas d'usage · rendu 100 % composable (registry).
// Hero court (hero-hub-masthead) + cartes dérivées de la collection via la section
// catalogue `related-cards-band` (chunkée 2-3, cap schéma .max(3)). 0 CSS bespoke.
// Compile même collection vide (les .mdx arrivent en parallèle) : si <2 cartes, on
// n'émet aucun band (page reste valide : hero + CTA).

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import MastheadBar from '../../components/sections/MastheadBar.astro';
import { buildCollectionPage } from '../../lib/seo/schema-builder';
import type { SectionData, SectionByType } from '@waimia/ds-kernel';

const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fr';
const isFr = lang === 'fr';

type Card = SectionByType<'related-cards-band'>['cards'][number];

const cards: Card[] = (await getCollection('cas-usages'))
  .filter((e) => e.data.seo?.noindex !== true)
  .sort((a, b) => (a.data.slug ?? a.id).localeCompare(b.data.slug ?? b.id))
  .map((e) => {
    const d = e.data;
    // Libellé de carte court dérivé du title long (segment avant « · »).
    const shortTitle = (full: string) => full.split(' · ')[0].trim();
    return {
      kicker_fr: "Cas d'usage",
      kicker_en: 'Use case',
      title_fr: shortTitle(d.title_fr),
      title_en: shortTitle(d.title_en),
      lead_fr: d.description_fr,
      lead_en: d.description_en,
      href: `/cas-usages/${d.slug ?? e.id}`,
    };
  });

// Chunker équilibré 2-3 (jamais de singleton) : respecte .min(2)/.max(3) du schéma.
function chunkCards(items: Card[]): Card[][] {
  if (items.length < 2) return [];
  const chunks: Card[][] = [];
  let rest = [...items];
  while (rest.length > 0) {
    if (rest.length === 4) {
      chunks.push(rest.slice(0, 2));
      chunks.push(rest.slice(2, 4));
      rest = [];
    } else if (rest.length <= 3) {
      chunks.push(rest);
      rest = [];
    } else {
      chunks.push(rest.slice(0, 3));
      rest = rest.slice(3);
    }
  }
  return chunks;
}

const hero: SectionByType<'hero-hub-masthead'> = {
  type: 'hero-hub-masthead',
  background: 'paper',
  variant: 'hub',
  decoration: false,
  align: 'left',
  kicker_fr: "§ Cas d'usage · ce que l'IA débloque concrètement",
  kicker_en: '§ Use cases · what AI unblocks concretely',
  h1_fr: '<span>Cas d\'usage <i>IA</i> :</span><br/><span>le gain réel, pas une démo.</span>',
  h1_en: '<span><i>AI</i> use cases:</span><br/><span>real gain, not a demo.</span>',
  lede_fr: "Des cas d'usage concrets : générer des leads, réduire le reporting, centraliser vos données. On part du gain réel pour votre PME, jamais d'une promesse en l'air.",
  lede_en: 'Concrete use cases: generate leads, cut reporting, centralize your data. We start from the real gain for your SMB, never from an empty promise.',
};

const ctaFinal: SectionByType<'cta-final'> = {
  type: 'cta-final',
  background: 'ink',
  h2_fr: 'Un cas qui ressemble au <i>vôtre</i> ?',
  h2_en: 'A case that looks like <i>yours</i>?',
  body_fr: "On cadre votre besoin en 45 minutes et on vous dit vite quel cas d'usage attaquer en premier, qu'on travaille ensemble ou non.",
  body_en: 'We frame your need in 45 minutes and tell you quickly which use case to tackle first, whether we work together or not.',
  cta_primary: {
    label_fr: 'Réserver un diagnostic (45 min) →',
    label_en: 'Book a diagnostic (45 min) →',
    href: '/contact?intent=diagnostic',
    variant: 'primary',
  },
  cta_secondary: {
    label_fr: 'Voir les services →',
    label_en: 'See the services →',
    href: '/services/integration-claude',
    variant: 'ghost',
  },
};

const cardBands: SectionData[] = chunkCards(cards).map((chunk, i) => ({
  type: 'related-cards-band',
  background: i % 2 === 0 ? 'paper' : 'paper-2',
  ...(i === 0
    ? { kicker_fr: '§ Les cas que nous traitons', kicker_en: '§ The cases we handle' }
    : {}),
  cards: chunk,
}) satisfies SectionByType<'related-cards-band'>);

const sections: SectionData[] = [hero, ...cardBands, ctaFinal];

const pageLd = buildCollectionPage(
  isFr ? "Cas d'usage IA pour PME · Waimia" : 'AI use cases for SMBs · Waimia',
  isFr
    ? "Cas d'usage IA concrets pour PME : générer des leads, réduire le reporting, centraliser les données, standardiser les processus."
    : 'Concrete AI use cases for SMBs: generate leads, cut reporting, centralize data, standardize processes.',
  cards.map((c) => ({ '@type': 'WebPage', name: isFr ? c.title_fr : c.title_en, url: `https://waimia.com${c.href}` })),
);
---

<Base
  title={isFr ? "Cas d'usage IA pour PME · Waimia" : 'AI use cases for SMBs · Waimia'}
  description={isFr
    ? "Cas d'usage IA concrets pour PME : générer des leads, réduire le reporting, centraliser les données, standardiser les processus. Le gain réel, pas une démo."
    : 'Concrete AI use cases for SMBs: generate leads, cut reporting, centralize data, standardize processes. The real gain, not a demo.'}
  jsonLd={pageLd}
>
  <MastheadBar
    lang={lang}
    items={[
      { label: isFr ? 'Accueil' : 'Home', href: isFr ? '/' : '/en' },
      { label: isFr ? "Cas d'usage" : 'Use cases' },
    ]}
  />
  <SectionsRenderer sections={sections} lang={lang} />
</Base>
