---
export const prerender = true;

// Page SSG · /cas-usages/[slug] · rendu 100 % composable (registry) · mirror de
// services/[...slug].astro. MDX sans `sections:` = erreur de build volontaire (anti-orphelin).

import { getCollection } from 'astro:content';
import type { SectionData } from '@waimia/ds-kernel';
import Base from '../../layouts/Base.astro';
import SectionsRenderer from '../../components/sections/SectionsRenderer.astro';
import MastheadBar from '../../components/sections/MastheadBar.astro';
import { buildArticle } from '../../lib/seo/schema-builder';
import { meshForCasUsage } from '../../lib/internal-mesh';

export async function getStaticPaths() {
  const entries = await getCollection('cas-usages');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const data = entry.data;

const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fr';
const title = lang === 'en' ? data.title_en : data.title_fr;
const description = lang === 'en' ? data.description_en : data.description_fr;

if (!Array.isArray(data.sections) || data.sections.length === 0) {
  throw new Error(`cas-usages/${entry.id} : frontmatter \`sections:\` requis (page cas-usage composable, anti-orphelin)`);
}

// JSON-LD métier · Article (GEO/AIO, cas d'usage = contenu éditorial orienté
// intention) + FAQPage depuis faq_fr/faq_en (miroir de la section faq-two-column).
// BreadcrumbList émis par le composant <MastheadBar>/<Breadcrumb>.
const canonicalUrl = `https://waimia.com/cas-usages/${entry.id}`;
const articleLd = buildArticle({
  headline: title,
  description,
  datePublished: new Date(data.publishedAt).toISOString().slice(0, 10),
  dateModified: data.updatedAt ? new Date(data.updatedAt).toISOString().slice(0, 10) : undefined,
  mainEntityOfPage: canonicalUrl,
});
// FAQPage JSON-LD émis une seule fois par la section catalogue `faq-accordion`
// (source canonique, cf docs/audits #56). La page ne le duplique plus ici.
const pageLd = [articleLd];

// Maillage interne (strat 11, GLOBAL via helper · source unique internal-mesh.ts).
// On insere la section cataloguee `related-links` juste AVANT le climax de fin
// (footer-cta-band, sinon faq-accordion, sinon cta-band/cta-final ; defaut avant-derniere
// position). Helper-driven : 0 lien hardcode, propagation auto a tous les cas-usages.
const baseSections = data.sections as SectionData[];
const meshData = meshForCasUsage({ slug: entry.id, category: data.category }, lang);
const meshSection = { ...meshData, background: 'paper-3' as const } as unknown as SectionData;
const endTypes = ['footer-cta-band', 'faq-accordion', 'cta-band', 'cta-final'];
let insertAt = -1;
for (const t of endTypes) {
  insertAt = baseSections.findIndex((s) => s.type === t);
  if (insertAt !== -1) break;
}
if (insertAt === -1) insertAt = baseSections.length <= 1 ? baseSections.length : baseSections.length - 1;
const sections: SectionData[] = [
  ...baseSections.slice(0, insertAt),
  meshSection,
  ...baseSections.slice(insertAt),
];
---

<Base title={title} description={description} jsonLd={pageLd} noindex={data.seo?.noindex}>
  <MastheadBar
    lang={lang}
    items={[
      { label: lang === 'fr' ? 'Accueil' : 'Home', href: lang === 'fr' ? '/' : '/en' },
      { label: lang === 'fr' ? "Cas d'usage" : 'Use cases', href: lang === 'fr' ? '/cas-usages' : '/en/cas-usages' },
      { label: title.split(' · ')[0] },
    ]}
  />
  <SectionsRenderer sections={sections} lang={lang} />
</Base>
