---
// Waimia · Co-location DS · module `numbered-layer-list` · Component.
// Markup + CSS EXTRAITS FIDELEMENT du bloc inline `.tech-layers` de src/pages/technologies.astro
// (rangs numerotes serif accent + titre + intro + puces « → »). Classes renommees en BEM scope
// composant, proprietes CSS strictement identiques -> 0 changement de rendu du bloc. Full-bleed :
// la section porte `padding-inline: var(--space-6)` + `.wrap-wide` (gut) pour reproduire l'indent
// editorial 64px du bloc d'origine (align sur le hero), contenu cape a 920px. Le conteneur garde
// la classe GLOBALE `reveal-stagger` (observer scroll-reveal). 100 % tokens DS existants,
// 0 token cree, 0 hardcode nouveau.
import type { NumberedLayerListData } from '@waimia/ds-kernel/sections/numbered-layer-list/schema';

interface Props {
  data: NumberedLayerListData;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const srHeading = isFr ? data.srHeading_fr : data.srHeading_en;
---
<section class="numbered-layer-list" data-bg={data.background}>
  <div class="wrap-wide">
    {srHeading && <h2 class="sr-only">{srHeading}</h2>}
    <div class="numbered-layer-list__layers reveal-stagger">
      {data.layers.map((layer) => {
        const intro = isFr ? layer.intro_fr : layer.intro_en;
        return (
          <article class="numbered-layer-list__layer">
            <span class="numbered-layer-list__n">{layer.n}</span>
            <div class="numbered-layer-list__main">
              <h3 class="numbered-layer-list__title">{isFr ? layer.label_fr : layer.label_en}</h3>
              {intro && <p class="numbered-layer-list__intro">{intro}</p>}
              <ul class="numbered-layer-list__list">
                {layer.items.map((item) => <li>{isFr ? item.text_fr : item.text_en}</li>)}
              </ul>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* Full-bleed : indent editorial 64px = padding-inline var(--space-6) (32) + gut wrap-wide (32),
     contenu cape a 920px (parite `.tech-layers` d'origine). */
  .numbered-layer-list {
    padding-block: var(--section-base);
    padding-inline: var(--space-6);
  }
  .numbered-layer-list__layers {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 920px;
  }
  .numbered-layer-list__layer {
    display: grid;
    grid-template-columns: minmax(56px, auto) 1fr;
    column-gap: var(--space-7);
    align-items: start;
    padding: var(--space-8) 0;
    border-top: 1px solid var(--hairline);
  }
  .numbered-layer-list__layer:last-child { border-bottom: 1px solid var(--hairline); }
  .numbered-layer-list__n {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-h2);
    line-height: 0.9;
    letter-spacing: var(--tracking-display);
    color: var(--accent-text);
  }
  .numbered-layer-list__title {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: var(--fw-medium);
    line-height: 1.2;
    color: var(--ink);
    margin: 0 0 var(--space-3);
  }
  .numbered-layer-list__intro {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    line-height: var(--leading-prose);
    color: var(--ink-2);
    margin: 0 0 var(--space-5);
    max-width: 60ch;
  }
  .numbered-layer-list__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .numbered-layer-list__list li {
    position: relative;
    padding-left: var(--space-6);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--muted);
    max-width: 64ch;
  }
  .numbered-layer-list__list li::before {
    content: '→';
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    color: var(--accent-text);
    font-size: var(--text-small);
  }

  /* ── Variante dark `ink` (directive 02-dark, idiome data-bg) ── */
  .numbered-layer-list[data-bg='paper-2'] { background: var(--paper-2); }
  .numbered-layer-list[data-bg='paper-3'] { background: var(--paper-3); }
  .numbered-layer-list[data-bg='ink'] { background: var(--ink); }
  .numbered-layer-list[data-bg='ink'] .numbered-layer-list__title { color: var(--paper); }
  .numbered-layer-list[data-bg='ink'] .numbered-layer-list__intro { color: rgba(var(--paper-rgb), 0.72); }
  .numbered-layer-list[data-bg='ink'] .numbered-layer-list__list li { color: rgba(var(--paper-rgb), 0.6); }
  .numbered-layer-list[data-bg='ink'] .numbered-layer-list__layer { border-color: rgba(var(--paper-rgb), 0.14); }

  @media (max-width: 700px) {
    .numbered-layer-list__layer {
      grid-template-columns: 1fr;
      row-gap: var(--space-4);
      padding: var(--space-7) 0;
    }
    .numbered-layer-list__n { font-size: var(--text-h3); }
  }
</style>
