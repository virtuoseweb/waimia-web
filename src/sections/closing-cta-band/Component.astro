---
// Waimia · Co-location DS · module `closing-cta-band` · Component.
// Markup + CSS EXTRAITS FIDELEMENT du bloc inline `author-cta` de AuthorPageTemplate (classes
// renommees en BEM scope composant, proprietes CSS strictement identiques : 0 changement de
// rendu). Titre rendu via set:html (accent <em>). Garde `g12`/`g12--full`/`col-prose`/`reveal`
// + atomes globaux `btn`/`btn-primary`. 100 % tokens DS existants, 0 token cree.
import Kicker from '../../components/ui/atoms/Kicker.astro';
import type { ClosingCtaBandData } from '@waimia/ds-kernel/sections/closing-cta-band/schema';

interface Props {
  data: ClosingCtaBandData;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isEn = lang === 'en';
const kicker = isEn ? data.kicker_en : data.kicker_fr;
const h2Html = isEn ? data.h2_html_en : data.h2_html_fr;
const buttonLabel = isEn ? data.button_label_en : data.button_label_fr;
---
{/* Fond toujours ink (CSS ci-dessous, quel que soit `background`) : `data-bg="ink"` active
    l'idiome sombre de global.css (--accent-text sur sombre, btn-primary papier). Sans lui,
    le kicker accent tombait à 3,14:1 et le bouton était encre sur encre. */}
<section class="closing-cta-band g12 g12--full" data-bg="ink">
  <div class="col-prose closing-cta-band__inner reveal">
    <Kicker as="span" tone="accent" letterSpacing="0.12em" class="eyebrow">{kicker}</Kicker>
    <h2 class="display-lg" set:html={h2Html} />
    <a href={data.button_href} class="btn btn-primary">{buttonLabel}</a>
  </div>
</section>

<style>
  /* Chrome : parite `.author-cta` (regles groupees padding-inline space-8 + padding-block
     space-12 + border-top hairline de AuthorPageTemplate) + fond ink. */
  .closing-cta-band {
    padding-inline: var(--space-8);
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
    border-top: 1px solid var(--hairline);
    background: var(--ink);
    color: var(--paper);
  }

  /* Kicker inline (parite `.author-cta :global(.eyebrow)`). */
  .closing-cta-band :global(.eyebrow) { display: inline-block; }

  /* Titre : parite `.display-lg` + `.display-lg em` (italique accent) + override
     `.author-cta .display-lg { color: paper }`. */
  .display-lg {
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    font-weight: var(--fw-semibold);
    line-height: var(--leading-h1);
    letter-spacing: -0.015em;
    margin: var(--space-3, 12px) 0 var(--space-6, 32px);
    text-wrap: balance;
    color: var(--paper);
  }
  .display-lg :global(em) {
    font-style: italic;
    color: var(--accent-text);
  }

  /* Colonne interne : parite `.author-cta-inner`. */
  .closing-cta-band__inner { max-width: 820px; }

  @media (max-width: 900px) {
    .closing-cta-band__inner {
      grid-column: 1 / -1;
    }
  }

  /* ── Axe déclinaison #118 : fonds clairs (défaut ABSENT = ink signature, rendu inchangé).
     paper/paper-2/paper-3 basculent la bande CTA sur fond clair ; l'accent <em> reste coral. ── */
  .closing-cta-band[data-bg='paper'],
  .closing-cta-band[data-bg='paper-2'],
  .closing-cta-band[data-bg='paper-3'] { color: var(--ink); }
  .closing-cta-band[data-bg='paper'] { background: var(--paper); }
  .closing-cta-band[data-bg='paper-2'] { background: var(--paper-2); }
  .closing-cta-band[data-bg='paper-3'] { background: var(--paper-3); }
  .closing-cta-band[data-bg^='paper'] .display-lg { color: var(--ink); }
</style>
