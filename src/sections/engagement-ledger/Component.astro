---
// Waimia · module `engagement-ledger` · Component.
// Registre tarifaire : chaque ligne = une étape du parcours (repère, nom, ce qui est livré,
// durée, prix, action). Pas de cartes, pas d'onglets : le parcours entier se lit d'un regard,
// les prix sont alignés sur une même colonne. Tokens DS uniquement (0 nouvelle variable).
import type { SectionByType } from '@waimia/ds-kernel';
import Kicker from '../../components/ui/atoms/Kicker.astro';
import Button from '../../components/ui/atoms/Button.astro';

interface Props {
  data: SectionByType<'engagement-ledger'>;
  lang: 'fr' | 'en';
}

const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const h1 = isFr ? data.h1_fr : data.h1_en;
const h2 = isFr ? data.h2_fr : data.h2_en;
const kicker = isFr ? data.kicker_fr : data.kicker_en;
const lede = isFr ? data.lede_fr : data.lede_en;
const footnote = isFr ? data.footnote_fr : data.footnote_en;
const uid = `ledger-${Math.random().toString(36).slice(2, 8)}`;
// Niveau des titres de ligne : h2 quand la section porte le h1 de la page, h3 sinon.
const RowHeading = h1 ? 'h2' : 'h3';
---

<section class="ledger sec-base" data-bg={data.background} aria-labelledby={`${uid}-title`}>
  <div class="wrap-wide">
    <header class="ledger__head">
      {kicker && <Kicker tone="muted">{kicker}</Kicker>}
      {h1 && <h1 id={`${uid}-title`} class="ledger__title" set:html={h1} />}
      {!h1 && h2 && <h2 id={`${uid}-title`} class="ledger__title sec-base-h2" set:html={h2} />}
      {lede && <p class="ledger__lede">{lede}</p>}
    </header>

    <ol class="ledger__rows">
      {data.rows.map((row) => {
        const step = isFr ? row.step_fr : row.step_en;
        const duration = isFr ? row.duration_fr : row.duration_en;
        const note = isFr ? row.price_note_fr : row.price_note_en;
        return (
          <li class:list={['ledger__row', row.entry && 'is-entry']}>
            <p class="ledger__step">{step ?? ''}</p>
            <div class="ledger__what">
              <RowHeading class="ledger__name">{isFr ? row.name_fr : row.name_en}</RowHeading>
              <p class="ledger__body">{isFr ? row.body_fr : row.body_en}</p>
            </div>
            <ul class="ledger__includes">
              {(isFr ? row.includes_fr : row.includes_en).map((item) => <li>{item}</li>)}
            </ul>
            <div class="ledger__cost">
              <p class="ledger__price">{isFr ? row.price_fr : row.price_en}</p>
              {(duration || note) && (
                <p class="ledger__terms">
                  {duration && <span>{duration}</span>}
                  {note && <span>{note}</span>}
                </p>
              )}
              {row.cta && (
                <Button href={row.cta.href} variant={row.entry ? 'primary' : 'link'} size="md" class="ledger__cta">
                  {isFr ? row.cta.label_fr : row.cta.label_en}
                </Button>
              )}
            </div>
          </li>
        );
      })}
    </ol>

    {data.aside && (
      <aside class="ledger__aside" aria-labelledby={`${uid}-aside`}>
        <div class="ledger__aside-head">
          <p id={`${uid}-aside`} class="ledger__aside-title">{isFr ? data.aside.title_fr : data.aside.title_en}</p>
          {(isFr ? data.aside.body_fr : data.aside.body_en) && (
            <p class="ledger__aside-body">{isFr ? data.aside.body_fr : data.aside.body_en}</p>
          )}
        </div>
        <ul class="ledger__aside-items">
          {data.aside.items.map((item) => (
            <li>
              {item.href
                ? <a href={item.href}>{isFr ? item.label_fr : item.label_en}</a>
                : <span>{isFr ? item.label_fr : item.label_en}</span>}
              <span class="ledger__aside-price">{isFr ? item.price_fr : item.price_en}</span>
            </li>
          ))}
        </ul>
      </aside>
    )}

    {footnote && <p class="ledger__footnote">{footnote}</p>}
  </div>
</section>

<style>
  .ledger__head {
    display: grid;
    gap: var(--space-4);
    max-width: var(--wrap-read);
    margin-bottom: var(--space-9);
  }
  .ledger__title {
    margin: 0;
    color: var(--ink);
    text-wrap: balance;
  }
  .ledger__lede {
    margin: 0;
    max-width: 62ch;
    color: var(--ink-2);
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: var(--leading-lede);
    text-wrap: pretty;
  }

  /* Le registre : 4 colonnes alignées sur toute la hauteur, hairline entre les lignes. */
  .ledger__rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .ledger__row {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1.15fr) minmax(0, 1fr) minmax(18rem, 0.7fr);
    column-gap: var(--space-8);
    align-items: start;
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--hairline);
  }
  .ledger__step {
    margin: 0;
    padding-top: 0.45em;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono-tight);
  }
  .ledger__name {
    margin: 0 0 var(--space-3);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: var(--fw-regular);
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-display);
  }
  .ledger__body {
    margin: 0;
    max-width: 46ch;
    color: var(--ink-2);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    text-wrap: pretty;
  }
  .ledger__includes {
    list-style: none;
    margin: 0;
    padding: 0.35em 0 0;
    display: grid;
    gap: var(--space-2);
    color: var(--ink-2);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-lede);
  }
  .ledger__includes li {
    padding-left: var(--space-5);
    position: relative;
  }
  .ledger__includes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: var(--space-3);
    height: 1px;
    background: var(--accent-text);
  }
  .ledger__cost {
    display: grid;
    justify-items: end;
    gap: var(--space-2);
    text-align: right;
  }
  .ledger__price {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--text-title-lg);
    font-weight: var(--fw-medium);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-display);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ledger__row.is-entry .ledger__price { color: var(--accent-text); }
  .ledger__terms {
    margin: 0;
    max-width: 32ch;
    display: grid;
    gap: 2px;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-lede);
  }
  .ledger__cost :global(.ledger__cta) { margin-top: var(--space-3); }

  /* Lignes secondaires : en retrait, corps plus petit, pas de CTA plein. */
  .ledger__aside {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1.15fr) minmax(0, 1.6fr);
    column-gap: var(--space-8);
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--hairline);
  }
  .ledger__aside-head { grid-column: 2; }
  .ledger__aside-title {
    margin: 0 0 var(--space-2);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: var(--fw-medium);
    line-height: var(--leading-h3);
  }
  .ledger__aside-body {
    margin: 0;
    max-width: 46ch;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-relaxed);
  }
  .ledger__aside-items {
    grid-column: 3;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ledger__aside-items li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-5);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--hairline);
    color: var(--ink-2);
    font-family: var(--font-sans);
    font-size: var(--text-body);
  }
  .ledger__aside-items li:first-child { padding-top: 0; }
  .ledger__aside-items li:last-child { border-bottom: 0; }
  .ledger__aside-items a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--hairline);
    text-underline-offset: 0.25em;
  }
  .ledger__aside-items a:hover { color: var(--accent-text); text-decoration-color: currentColor; }
  .ledger__aside-price {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }
  .ledger__footnote {
    margin: var(--space-6) 0 0;
    max-width: 78ch;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-relaxed);
  }

  /* Fond ink : l'idiome global remappe --muted / --hairline / --accent-text. */
  .ledger[data-bg='ink'] { background: var(--ink); color: var(--paper); }
  .ledger[data-bg='ink'] :is(.ledger__title, .ledger__name, .ledger__price, .ledger__aside-title, .ledger__aside-price, .ledger__aside-items a) { color: var(--paper); }
  .ledger[data-bg='ink'] :is(.ledger__lede, .ledger__body, .ledger__includes, .ledger__aside-items li) { color: rgba(var(--paper-rgb), 0.78); }
  .ledger[data-bg='ink'] .ledger__rows { border-top-color: var(--paper); }
  .ledger[data-bg='ink'] .ledger__row.is-entry .ledger__price { color: var(--accent-text); }

  @media (max-width: 1100px) {
    .ledger__row {
      grid-template-columns: 5.5rem minmax(0, 1fr) minmax(15rem, auto);
      column-gap: var(--space-6);
      row-gap: var(--space-5);
    }
    .ledger__includes { grid-column: 2 / -1; grid-row: 2; padding-top: 0; }
    .ledger__cost { grid-column: 3; grid-row: 1; }
    .ledger__aside { grid-template-columns: 5.5rem minmax(0, 1fr); column-gap: var(--space-6); row-gap: var(--space-5); }
    .ledger__aside-items { grid-column: 2; }
  }
  @media (max-width: 700px) {
    .ledger__head { margin-bottom: var(--space-7); }
    .ledger__row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-4);
      padding-block: var(--space-6);
    }
    .ledger__step { padding-top: 0; }
    .ledger__includes { grid-column: 1; grid-row: auto; }
    .ledger__cost {
      grid-column: 1;
      grid-row: auto;
      justify-items: start;
      text-align: left;
      padding-top: var(--space-2);
    }
    .ledger__aside { grid-template-columns: minmax(0, 1fr); }
    .ledger__aside-head, .ledger__aside-items { grid-column: 1; }
    .ledger__aside-items li { flex-wrap: wrap; gap: var(--space-1) var(--space-4); }
  }
</style>
