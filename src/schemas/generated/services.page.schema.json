{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Waimia page document - services",
  "type": "object",
  "properties": {
    "title_fr": {
      "type": "string",
      "minLength": 1
    },
    "title_en": {
      "type": "string",
      "minLength": 1
    },
    "description_fr": {
      "type": "string",
      "minLength": 40,
      "maxLength": 180
    },
    "description_en": {
      "type": "string",
      "minLength": 40,
      "maxLength": 180
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "publishedAt": {},
    "updatedAt": {},
    "canonical": {
      "type": "string",
      "format": "uri"
    },
    "seo": {
      "type": "object",
      "properties": {
        "ogImage": {
          "type": "string"
        },
        "noindex": {
          "default": false,
          "type": "boolean"
        },
        "serviceType": {
          "type": "string"
        },
        "priceRange": {
          "type": "string"
        },
        "priceMin": {
          "type": "number"
        },
        "priceMax": {
          "type": "number"
        }
      }
    },
    "faq_fr": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "a": {
            "type": "string"
          }
        },
        "required": [
          "q",
          "a"
        ]
      }
    },
    "faq_en": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "a": {
            "type": "string"
          }
        },
        "required": [
          "q",
          "a"
        ]
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "acquisition",
        "crm",
        "contenu-seo-geo",
        "productivite",
        "support",
        "pilotage",
        "data",
        "gouvernance"
      ]
    },
    "cluster": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "sources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "type": {
            "type": "string",
            "enum": [
              "state",
              "university",
              "journal",
              "enterprise",
              "research"
            ]
          },
          "publishedAt": {},
          "author": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "url",
          "type"
        ]
      }
    },
    "relatedSolutions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedOffres": {
      "default": [],
