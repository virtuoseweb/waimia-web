---
/**
 * SolutionsDetailTemplate · sub-page Solutions (focus département métier)
 *
 * Sections (7) sémantiquement différenciées d'OffresDetail :
 *   1. Hero Department · breadcrumb + DEPT badge + h1 + lead italique + tags row + meta + SVG rect rotated 15°
 *   2. Pain Points · 3 cards numérotées 01/02/03 (empathie métier "pourquoi ça bloque")
 *   3. Workflows Table · BRIQUE SIGNATURE 5 colonnes : numéro / kicker+h3 / model / gain / how
 *   4. ROI Band Dark · BRIQUE SIGNATURE 4 chiffres énormes 88px en background ink
 *   5. Case Study Split · split dark/light 50/50 (case dark + résultats light)
 *   6. Department Stack · 3×2 cards (kicker + h3 + body + pill type)
 *   7. CTA Dept-Augmented Dark · h2 personnalisé "Votre équipe X, augmentée."
 *
 * Briques signatures Solutions : Workflows Table + ROI Band (densité métier).
 * Géométrie hero : rectangle rotated 15° (≠ cercles d'OffresDetail) — signal visuel de différenciation.
 * Source handoff : project/pages/solutions/detail.html (lignes 157-280, dict SOLUTIONS).
 *
 * Usage minimal (props) :
 *   <SolutionsDetailTemplate
 *     dept="DÉPARTEMENT"
 *     deptLabel="Finance & Comptabilité"
 *     meta="Finance · Comptabilité · Contrôle de gestion"
 *     title="Solutions · Finance"
 *     description="Réconciliation automatisée, mémos financiers, reporting intelligent."
 *   >
 *     <Fragment slot="title"><i>Finance</i><br/>&amp; Comptabilité</Fragment>
 *     <Fragment slot="lead">Lead html...</Fragment>
 *     <Fragment slot="tags">5 pills...</Fragment>
 *     ... etc
 *   </SolutionsDetailTemplate>
 */
import Base from '../../layouts/Base.astro';
import Callout from '../editorial/Callout.astro';
import Timeline from '../editorial/Timeline.astro';
import KeyMetric from '../editorial/KeyMetric.astro';
import EditorialTable from '../editorial/EditorialTable.astro';
import Dingbat from '../editorial/Dingbat.astro';
import HeroOfferDetail from '../sections/HeroOfferDetail.astro';
import MetricCalloutBand from '../sections/MetricCalloutBand.astro';
import CaseSpotlight from '../sections/CaseSpotlight.astro';
import FeatureSplitMedia from '../sections/FeatureSplitMedia.astro';
import DiagnosticStages from '../sections/DiagnosticStages.astro';
import MethodTimeline from '../sections/MethodTimeline.astro';
import MetricShift from '../sections/MetricShift.astro';
import TrustBadgesBand from '../sections/TrustBadgesBand.astro';
import Breadcrumb from '../ui/molecules/Breadcrumb.astro';
import Kicker from '../ui/atoms/Kicker.astro';
import { langFromPath } from '../../lib/i18n';
import { buildService } from '../../lib/seo/schema-builder';
import type { SectionByType } from '../../schemas/sections';

interface Props {
  /** SEO meta · title de la page (browser tab) */
  title: string;
  /** SEO meta · description */
  description: string;
  /** Pas d'index (pages WIP) — forwardé à Base */
  noindex?: boolean;
  /** Department badge (kicker au-dessus du h1) ex: "DÉPARTEMENT" */
  dept: string;
  /** Label du breadcrumb second segment ex: "Finance & Comptabilité" */
  deptLabel: string;
  /** Meta sous le CTA hero ex: "Finance · Comptabilité · Contrôle de gestion" */
  meta?: string;
  /** Href du CTA hero (default /contact) */
  ctaHref?: string;
  /** Label du CTA hero (default "Parler à un expert →") */
  ctaLabel?: string;
  /** Props typed arrays (MDX frontmatter) — backward compat slots preserved */
  pains?: Array<{ title_fr: string; body_fr: string; title_en?: string; body_en?: string }>;
  roi_metrics?: Array<{ value: string; label_fr: string; label_en?: string }>;
  stack?: Array<{ name: string; role_fr: string; role_en?: string; category?: string }>;
  case_kicker?: string;
  case_body_fr?: string;
  case_body_en?: string;
  case_cta_label_fr?: string;
  case_cta_label_en?: string;
  case_results?: Array<{ value: string; label_fr: string; label_en?: string }>;
  cta_title_fr?: string;
  cta_title_en?: string;
  cta_body_fr?: string;
  cta_body_en?: string;
  /** Recomposition (tpl-recomp) — sections cataloguées INK/habillées, fed par la page.
   *  Optionnelles : si absentes, le template garde le rendu legacy (backward-compat). */
  impactBand?: SectionByType<'metric-callout-band'>;
  caseSpotlight?: SectionByType<'case-spotlight'>;
  featureSplit?: SectionByType<'feature-split-media'>;
  diagnostic?: SectionByType<'diagnostic-stages'>;
  methodTimeline?: SectionByType<'method-timeline'>;
  metricShift?: SectionByType<'metric-shift'>;
  trustBadges?: SectionByType<'trust-badges-band'>;
  /** Différenciation de composition (mandat secteurs) — ordre des blocs recompo.
   *  Chaque clé : 'impact' | 'case' | 'feature' | 'diagnostic'. Les clés listées dans
   *  `recompoAfterStack` sont rendues APRÈS le bloc Stack (variation de rythme : un bloc ink
   *  peut ouvrir ou clore la séquence selon le secteur). Toute clé absente des deux listes
   *  n'est pas rendue. Si `recompoOrder` est absent → ordre legacy fixe (solutions inchangées). */
  recompoOrder?: Array<'impact' | 'case' | 'feature' | 'diagnostic' | 'method' | 'shift'>;
  recompoAfterStack?: Array<'impact' | 'case' | 'feature' | 'diagnostic' | 'method' | 'shift'>;
}

const {
  title,
  description,
  noindex = false,
  dept,
  deptLabel,
  meta = '',
  ctaHref = '/contact',
  ctaLabel = 'Parler à un expert →',
  pains: propsPains = [],
  roi_metrics: propsROI = [],
  stack: propsStack = [],
  case_kicker: propsCaseKicker,
  case_body_fr: propsCaseBodyFr,
  case_body_en: propsCaseBodyEn,
  case_cta_label_fr: propsCaseCta,
  case_results: propsCaseResults = [],
  cta_title_fr: propsCtaTitleFr,
  cta_body_fr: propsCtaBodyFr,
  impactBand,
  caseSpotlight,
  featureSplit,
  diagnostic,
  methodTimeline,
  metricShift,
  trustBadges,
  recompoOrder,
  recompoAfterStack = [],
} = Astro.props;

const lang = langFromPath(Astro.url.pathname);
const pageTransitionId = Astro.url.pathname
  .replace(/^\/(?:en\/)?/, '')
  .replace(/\/$/, '')
  .replace(/[^a-z0-9]+/gi, '-')
  .replace(/^-|-$/g, '') || 'home';
const painHtml = (await Astro.slots.render('pains')) ?? '';
const painAsideHtml = (await Astro.slots.render('pain-aside')) ?? '';
const workflowsHtml = (await Astro.slots.render('workflows')) ?? '';
const workflowsAsideHtml = (await Astro.slots.render('workflows-aside')) ?? '';
const roiHtml = (await Astro.slots.render('roi')) ?? '';
const stackHtml = (await Astro.slots.render('stack')) ?? '';
const stackAsideHtml = (await Astro.slots.render('stack-aside')) ?? '';
const faqHtml = (await Astro.slots.render('faq')) ?? '';
const livrablesHtml = (await Astro.slots.render('livrables')) ?? '';
// Slot optionnel (mandat secteurs-cas) : section additionnelle insérée avant le CTA.
// Pages /solutions ne le passent pas → 0 changement visuel pour elles.
// Pass-through direct (pas de render string) pour préserver styles scopés + reveal.
const hasExtraCases = Astro.slots.has('extra-cases');
const heroTitleHtml = (await Astro.slots.render('title')) ?? '';
const heroLeadHtml = (await Astro.slots.render('lead')) ?? '';
const heroTagsHtml = (await Astro.slots.render('tags')) ?? '';

const stripHtml = (html: string) =>
  html
    .replace(/<br\s*\/?>/gi, ' ')
    .replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const unwrapParagraph = (html: string) =>
  html.trim().replace(/^<p(?:\s[^>]*)?>([\s\S]*)<\/p>$/i, '$1');

const extract = (html: string, selectorClass: string) => {
  const match = html.match(new RegExp(`<[^>]*class=["'][^"']*${selectorClass}[^"']*["'][^>]*>([\\s\\S]*?)<\\/[^>]+>`, 'i'));
  return match ? stripHtml(match[1] ?? '') : '';
};

const extractTag = (html: string, tag: string) => {
  const match = html.match(new RegExp(`<${tag}[^>]*>([\\s\\S]*?)<\\/${tag}>`, 'i'));
  return match ? stripHtml(match[1] ?? '') : '';
};

const splitCards = (html: string, className: string) =>
  html
    .split(new RegExp(`<div class=["'][^"']*${className}[^"']*["'][^>]*>`, 'i'))
    .slice(1);

const frictionPoints = splitCards(painHtml, 'pain-card')
  .map((block, index) => {
    const title = extractTag(block, 'h3');
    const meta = extract(block, 'pk');
    const body = extractTag(block, 'p') || meta || title;
    return {
      num: extract(block, 'pn') || String(index + 1).padStart(2, '0'),
      meta,
      title,
      body,
      variant: index === 0 ? ('highlight' as const) : ('default' as const),
    };
  })
  .filter((event) => event.title && event.body);

const proofMetrics = Array.from(
  roiHtml.matchAll(/<div class=["'](?:roi-cell|[^"']*\broi-cell\b[^"']*)["'][^>]*>[\s\S]*?<div class=["']roi-v["']>([\s\S]*?)<\/div>[\s\S]*?<div class=["']roi-l["']>([\s\S]*?)<\/div>[\s\S]*?<\/div>/g)
).map((match) => ({
  value: stripHtml(match[1] ?? ''),
  label: stripHtml(match[2] ?? ''),
}));

const fallbackProofMetrics = Array.from(
  roiHtml.matchAll(/<div class=["']metric-v["']>([\s\S]*?)<\/div>[\s\S]*?<div class=["']metric-l["']>([\s\S]*?)<\/div>/g)
).map((match) => ({
  value: stripHtml(match[1] ?? ''),
  label: stripHtml(match[2] ?? ''),
}));

const proofMetricRows = proofMetrics.length > 0 ? proofMetrics : fallbackProofMetrics;

const proofMetricPlacements = [
  { class: 'col-6 start-1', size: 'lg', align: 'left', variant: 'default' },
  { class: 'col-5 start-8', size: 'lg', align: 'left', variant: 'accent' },
  { class: 'col-6 start-1', size: 'md', align: 'left', variant: 'default' },
  { class: 'col-5 start-8', size: 'md', align: 'left', variant: 'default' },
  { class: 'col-6 start-1', size: 'md', align: 'left', variant: 'default' },
  { class: 'col-5 start-8', size: 'md', align: 'left', variant: 'default' },
] as const;

const stackRows = splitCards(stackHtml, 'stack-card')
  .map((block) => {
    const category = extract(block, 'stack-k') || extract(block, 'kicker');
    const tool = extractTag(block, 'h3');
    const role = extractTag(block, 'p');
    return [category, tool, role];
  })
  .filter((row) => row.every(Boolean));

const defaultToolRows = [
  ['Modèle raisonnement', 'Claude Sonnet 4.6', 'Scoring leads, séquences et synthèses métier'],
  ['Modèle volume', 'Claude Haiku 4.5', 'Qualification, tri, extraction et déduplication'],
  ['CRM', 'HubSpot / Salesforce / Pipedrive', 'Pipeline, tracking et attribution'],
  ['Email', 'Resend / Postmark', 'Délivrabilité et relances mesurées'],
  ['Analytics', 'GA4 + Mixpanel', 'Conversion et signaux comportementaux'],
  ['Orchestration', 'LangGraph open-source', 'Workflows IA durables et transférables'],
];

const toolRows = stackRows.length > 0 ? stackRows : defaultToolRows;

// Props-based overrides (from MDX frontmatter) — bypass slot parsing
const effectiveFriction =
  propsPains.length > 0
    ? propsPains.map((p, i) => ({
        num: String(i + 1).padStart(2, '0'),
        meta: '',
        title: lang === 'en' ? (p.title_en ?? p.title_fr) : p.title_fr,
        body: lang === 'en' ? (p.body_en ?? p.body_fr) : p.body_fr,
        variant: i === 0 ? ('highlight' as const) : ('default' as const),
      }))
    : frictionPoints;

const effectiveROI =
  propsROI.length > 0
    ? propsROI.map((m) => ({
        value: m.value,
        label: (lang === 'en' ? (m.label_en ?? m.label_fr) : m.label_fr).replace(/\\n/g, '\n'),
      }))
    : proofMetricRows;

const effectiveStack =
  propsStack.length > 0
    ? propsStack.map(
        (s) =>
          [
            s.category ?? '',
            s.name,
            lang === 'en' ? (s.role_en ?? s.role_fr) : s.role_fr,
          ] as [string, string, string],
      )
    : toolRows;

const serviceLd = buildService({ name: title, description });
const heroTags = Array.from(heroTagsHtml.matchAll(/<span[^>]*>([\s\S]*?)<\/span>/gi))
  .map((match) => stripHtml(match[1] ?? ''))
  .filter(Boolean)
  .map((label) => ({ label_fr: label, label_en: label }));
const heroData: SectionByType<'hero-sector'> = {
  type: 'hero-sector',
  dept_fr: dept,
  dept_en: dept,
  h1_fr: heroTitleHtml,
  h1_en: heroTitleHtml,
  lead_fr: unwrapParagraph(heroLeadHtml),
  lead_en: unwrapParagraph(heroLeadHtml),
  cta: { label_fr: ctaLabel, label_en: ctaLabel, href: ctaHref, variant: 'primary' },
  meta_fr: meta || undefined,
  meta_en: meta || undefined,
  tags: heroTags,
};

/* Différenciation de composition (mandat secteurs) — résolution de l'ordre des blocs recompo.
   Legacy (recompoOrder absent) : ordre fixe historique impact → case → feature → diagnostic,
   tous avant le Stack. Les pages /solutions ne passent pas recompoOrder → 0 changement pour elles. */
const recompoBlocks = {
  impact: impactBand ? ('impact' as const) : null,
  case: caseSpotlight ? ('case' as const) : null,
  feature: featureSplit ? ('feature' as const) : null,
  diagnostic: diagnostic ? ('diagnostic' as const) : null,
  method: methodTimeline ? ('method' as const) : null,
  shift: metricShift ? ('shift' as const) : null,
};
type RecompoKey = 'impact' | 'case' | 'feature' | 'diagnostic' | 'method' | 'shift';
const LEGACY_ORDER: RecompoKey[] = ['impact', 'case', 'feature', 'diagnostic'];
const requestedOrder: RecompoKey[] = recompoOrder ?? LEGACY_ORDER;
// Une clé n'est rendue qu'une fois et seulement si son bloc existe.
const afterStackKeys = new Set<RecompoKey>(recompoAfterStack.filter((k) => recompoBlocks[k]));
const beforeStack: RecompoKey[] = requestedOrder.filter(
  (k) => recompoBlocks[k] && !afterStackKeys.has(k),
);
const afterStack: RecompoKey[] = requestedOrder.filter((k) => afterStackKeys.has(k));
---
<Base {title} {description} {noindex} jsonLd={[serviceLd]}>
    <Breadcrumb
      lang={lang}
      items={[
        { label: lang === 'fr' ? 'Accueil' : 'Home', href: lang === 'fr' ? '/' : '/en' },
        { label: lang === 'fr' ? 'Solutions' : 'Solutions', href: lang === 'fr' ? '/solutions' : '/en/solutions' },
        { label: deptLabel },
      ]}
    />
    {/* ────────── 1. HERO DEPARTMENT ────────── */}
    <HeroOfferDetail
      data={heroData}
      {lang}
      transitionId={pageTransitionId}
      cardTransitionId={pageTransitionId}
      geoReveal={true}
    />

    {/* ────────── 2. PAIN POINTS ────────── */}
    <section class="sol-sec sol-friction reveal-stagger" data-screen-label="02 Pain Points">
      <div class="wrap g12 g12--full">
        <header class="sol-sec-hd section-eyebrow col-prose">
          <Kicker as="span" tone="accent" letterSpacing="0.12em" class="eyebrow">§ Friction</Kicker>
          <h2><i>Points</i><br/>de friction</h2>
        </header>
        <aside class="sol-aside col-aside">
          <Callout variant="note" size="sm">
            {painAsideHtml.trim() ? (
              <Fragment set:html={painAsideHtml} />
            ) : (
              <>Avant d'automatiser, comprendre où le temps se perd. Les frictions récurrentes que nous voyons sur le terrain.</>
            )}
          </Callout>
        </aside>
        <div class="sol-pain-grid col-12">
          {effectiveFriction.length > 0 ? (
            <Timeline events={effectiveFriction} numbered={true} />
          ) : (
            <Fragment set:html={painHtml} />
          )}
        </div>
      </div>
    </section>

    {/* ────────── 3. WORKFLOWS TABLE ────────── */}
    <section class="sol-sec sol-sec-paper sol-workflows reveal-stagger" data-screen-label="03 Workflows">
      <div class="wrap g12 g12--full">
        <header class="sol-sec-hd section-eyebrow col-prose">
          <Kicker as="span" tone="accent" letterSpacing="0.12em" class="eyebrow">§ Workflows</Kicker>
          <h2><i>Ce qu'on</i><br/>automatise</h2>
        </header>
        <aside class="sol-aside col-aside">
          <Callout variant="info" size="sm">
            {workflowsAsideHtml.trim() ? (
              <Fragment set:html={workflowsAsideHtml} />
            ) : (
              <>Chaque workflow est nommé, mesuré, attribué à un modèle précis. Pas de boîte noire.</>
            )}
          </Callout>
        </aside>
        <div class="sol-workflow-table col-12">
          <div class="sol-workflow-head reveal-stagger">
            <div class="sol-wf-col-n">№</div>
            <div class="sol-wf-col-name">Workflow</div>
            <div class="sol-wf-col-model">Modèle</div>
            <div class="sol-wf-col-gain">Gain</div>
            <div class="sol-wf-col-how">Comment</div>
          </div>
          <div class="sol-workflow-body reveal-stagger"><Fragment set:html={workflowsHtml} /></div>
        </div>
      </div>
    </section>

    {/* ────────── 4. LEGACY FALLBACK — ROI Band INK (solutions sans metric-callout-band typé) ────────── */}
    {!impactBand && (
      <section class="sol-sec sol-sec-dark sol-proof reveal-stagger" data-screen-label="04 ROI Band">
        <div class="wrap g12 g12--full">
          <header class="sol-roi-hd section-eyebrow col-12">
            <Kicker as="span" tone="accent" letterSpacing="0.12em" class="eyebrow">§ Preuve macro</Kicker>
            <h2><i>Preuve</i> macro</h2>
          </header>
          <div class="sol-roi-grid col-12 g12">
            {effectiveROI.length > 0 ? (
              effectiveROI.map((metric, index) => {
                const placement = proofMetricPlacements[index % proofMetricPlacements.length];
                return (
                  <div class={placement.class}>
                    <KeyMetric
                      value={metric.value}
                      label={metric.label}
                      size={placement.size}
                      align={placement.align}
                      variant={placement.variant}
                    />
                  </div>
                );
              })
            ) : (
              <Fragment set:html={roiHtml} />
            )}
          </div>
        </div>
      </section>
    )}

    {/* ────────── 5. LEGACY FALLBACK — Case Study Split (solutions sans case-spotlight typé) ────────── */}
    {!caseSpotlight && (
      <section class="sol-case reveal-stagger" data-screen-label="05 Case Study">
        <div class="sol-case-grid">
          <div class="sol-case-dark">
            <div class="wrap-inner">
              <Kicker><slot name="case-kicker">{propsCaseKicker ?? 'Cas client'}</slot></Kicker>
              <h2 class="sol-case-title"><slot name="case-title" /></h2>
              <p class="sol-case-body">
                {propsCaseBodyFr
                  ? (lang === 'en' ? (propsCaseBodyEn ?? propsCaseBodyFr) : propsCaseBodyFr)
                  : <slot name="case-body" />}
              </p>
              <a class="sol-case-cta" href={lang === 'fr' ? '/cas' : '/en/cas'}>
                <slot name="case-cta-label">{propsCaseCta ?? 'Voir le cas complet →'}</slot>
              </a>
            </div>
          </div>
          <div class="sol-case-light">
            <div class="wrap-inner">
              <Kicker>Résultats</Kicker>
              <div class="sol-case-results">
                {propsCaseResults.length > 0 ? (
                  propsCaseResults.map((r) => (
                    <div class="res-row">
                      <div class="res-v">{r.value}</div>
                      <div class="res-l" set:html={(lang === 'en' ? (r.label_en ?? r.label_fr) : r.label_fr).replace(/\n/g, '<br/>')} />
                    </div>
                  ))
                ) : (
                  <slot name="case-results" />
                )}
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    {/* ────────── 5b. RECOMPO BLOCS (ordre pilotable par secteur — variation de composition) ──────────
         beforeStack : blocs typés rendus AVANT le Stack, dans l'ordre `recompoOrder` du secteur.
         Pages /solutions : impactBand/caseSpotlight absents → la liste beforeStack est vide,
         seuls les fallbacks legacy ci-dessus s'affichent (0 changement). */}
    {beforeStack.map((key) => (
      key === 'impact' && impactBand ? <MetricCalloutBand data={impactBand} {lang} />
      : key === 'case' && caseSpotlight ? <CaseSpotlight data={caseSpotlight} {lang} />
      : key === 'feature' && featureSplit ? <FeatureSplitMedia data={featureSplit} {lang} />
      : key === 'diagnostic' && diagnostic ? <DiagnosticStages data={diagnostic} {lang} />
      : key === 'method' && methodTimeline ? <MethodTimeline data={methodTimeline} {lang} />
      : key === 'shift' && metricShift ? <MetricShift data={metricShift} {lang} />
      : null
    ))}

    {/* ────────── 6. DEPARTMENT STACK ────────── */}
    <section class="sol-sec sol-sec-paper sol-tools reveal" data-screen-label="06 Stack">
      <div class="wrap g12 g12--full">
        <header class="sol-sec-hd section-eyebrow col-prose">
          <Kicker as="span" tone="accent" letterSpacing="0.12em" class="eyebrow">§ Stack outils</Kicker>
          <h2><i>Outils</i><br/>déployés</h2>
        </header>
        <aside class="sol-aside col-aside">
          <Callout variant="note" size="sm">
            {stackAsideHtml.trim() ? (
              <Fragment set:html={stackAsideHtml} />
            ) : (
              <>Le triptyque Anthropic primary + intégrations métier secondary + open source pour l'orchestration.</>
            )}
          </Callout>
        </aside>
        <div class="sol-stack-grid col-12">
          <EditorialTable
            caption={`Stack typique · ${deptLabel}`}
            columns={['Catégorie', 'Outil', 'Rôle']}
            rows={effectiveStack}
            variant="editorial"
          />
        </div>
      </div>
    </section>

    {/* ────────── 6a. RECOMPO BLOCS APRÈS STACK (variation de rythme par secteur) ──────────
         Un secteur peut faire clore sa séquence par un bloc ink/diagnostic APRÈS le Stack
         (≠ legacy : tout avant le Stack). Vide pour /solutions (recompoAfterStack non passé). */}
    {afterStack.map((key) => (
      key === 'impact' && impactBand ? <MetricCalloutBand data={impactBand} {lang} />
      : key === 'case' && caseSpotlight ? <CaseSpotlight data={caseSpotlight} {lang} />
      : key === 'feature' && featureSplit ? <FeatureSplitMedia data={featureSplit} {lang} />
      : key === 'diagnostic' && diagnostic ? <DiagnosticStages data={diagnostic} {lang} />
      : key === 'method' && methodTimeline ? <MethodTimeline data={methodTimeline} {lang} />
      : key === 'shift' && metricShift ? <MetricShift data={metricShift} {lang} />
      : null
    ))}

    {/* ────────── 6b. LIVRABLES (optionnel) ────────── */}
    {livrablesHtml.trim() && (
      <section class="sol-sec sol-livrables reveal-stagger" data-screen-label="06b Livrables">
        <div class="wrap g12 g12--full">
          <header class="sol-sec-hd section-eyebrow col-prose">
            <Kicker as="span" tone="accent" letterSpacing="0.12em" class="eyebrow">§ Livrables</Kicker>
            <h2><i>Ce qu'on</i><br/>livre</h2>
          </header>
          <div class="sol-livrables-body col-12">
            <Fragment set:html={livrablesHtml} />
          </div>
        </div>
      </section>
    )}

    {/* ────────── 6c. CAS CLIENTS (slot optionnel — secteurs) ────────── */}
    {hasExtraCases && <slot name="extra-cases" />}

    {/* ────────── 6d. RÉASSURANCE — INK strip (recompo : trust-badges-band) ────────── */}
    {trustBadges && <TrustBadgesBand data={trustBadges} {lang} />}

