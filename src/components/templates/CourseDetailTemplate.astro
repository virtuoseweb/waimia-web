---
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../ui/molecules/Breadcrumb.astro';
import HeroCentered from '../sections/HeroCentered.astro';
import { buildCourseSchema, buildBreadcrumbList } from '../../lib/seo/schema-builder';
import type { SectionByType } from '../../schemas/sections';

interface Props {
  entry: CollectionEntry<'courses'>;
  lang: 'fr' | 'en';
}

const { entry, lang } = Astro.props;
const data = entry.data;

// ── Discriminated union narrowing ──────────────────────────────────────────
type CourseData = CollectionEntry<'courses'>['data'];
const fd = data.course_type === 'formation'     ? (data as Extract<CourseData, { course_type: 'formation' }>)     : null;
const pd = data.course_type === 'parcours'      ? (data as Extract<CourseData, { course_type: 'parcours' }>)      : null;
const ad = data.course_type === 'atelier'       ? (data as Extract<CourseData, { course_type: 'atelier' }>)       : null;
const cd = data.course_type === 'certification' ? (data as Extract<CourseData, { course_type: 'certification' }>) : null;

// ── i18n ───────────────────────────────────────────────────────────────────
const fr = lang === 'fr';
const title = fr ? data.title_fr : data.title_en;
const description = fr ? data.description_fr : data.description_en;

const TYPE_LABELS: Record<string, [string, string]> = {
  formation:    ['FORMATION',    'COURSE'],
  parcours:     ['PARCOURS',     'LEARNING PATH'],
  atelier:      ['ATELIER',      'WORKSHOP'],
  certification:['CERTIFICATION','CERTIFICATION'],
};
const typeLabel = TYPE_LABELS[data.course_type]?.[fr ? 0 : 1] ?? data.course_type.toUpperCase();

const LEVEL_LABELS: Record<string, [string, string]> = {
  debutant:      ['Débutant',       'Beginner'],
  intermediaire: ['Intermédiaire',  'Intermediate'],
  avance:        ['Avancé',         'Advanced'],
  expert:        ['Expert',         'Expert'],
};

const FORMAT_ATELIER: Record<string, [string, string]> = {
  'live-online': ['Live en ligne', 'Live online'],
  'live-paris':  ['Live Paris',    'Live Paris'],
  'live-geneve': ['Live Genève',   'Live Geneva'],
  'replay-only': ['Replay',        'Replay only'],
};

const EXAM_FORMAT: Record<string, [string, string]> = {
  qcm:    ['QCM',    'Multiple choice'],
  projet: ['Projet', 'Project'],
  oral:   ['Oral',   'Oral exam'],
  mixte:  ['Mixte',  'Mixed'],
};

const MODULE_TYPE: Record<string, [string, string]> = {
  lecture:    ['Cours',      'Lecture'],
  exercice:   ['Exercice',   'Exercise'],
  projet:     ['Projet',     'Project'],
  evaluation: ['Évaluation', 'Assessment'],
};

// ── Pricing & CTA ──────────────────────────────────────────────────────────
let stripeLink: string | undefined;
let priceStr: string | null = null;
let priceStrFr: string | null = null;
let priceStrEn: string | null = null;

if (fd) {
  stripeLink = fd.pricing?.stripe_payment_link;
  const p = fd.pricing?.one_time_eur ?? fd.pricing?.subscription_eur;
  priceStrFr = p === 0 ? 'Gratuit' : p != null ? `${p} €` : null;
  priceStrEn = p === 0 ? 'Free': p != null ? `${p} €`: null;
} else if (pd) {
  stripeLink = pd.stripe_payment_link;
  priceStrFr = `${pd.pricing_eur} €`;
  priceStrEn = `${pd.pricing_eur} €`;
} else if (ad) {
  stripeLink = ad.stripe_payment_link;
  priceStrFr = ad.pricing_eur === 0 ? 'Gratuit' : `${ad.pricing_eur} €`;
  priceStrEn = ad.pricing_eur === 0 ? 'Free': `${ad.pricing_eur} €`;
} else if (cd) {
  stripeLink = cd.stripe_payment_link;
  priceStrFr = cd.pricing_eur === 0 ? 'Gratuit' : `${cd.pricing_eur} €`;
  priceStrEn = cd.pricing_eur === 0 ? 'Free': `${cd.pricing_eur} €`;
}
priceStr = fr ? priceStrFr : priceStrEn;

const isPlaceholder = !stripeLink || stripeLink.includes('PLACEHOLDER');
const ctaEnroll = fr
  ? `S'inscrire${priceStr ? `: ${priceStr}` : ''}`
  : `Enroll${priceStr ? `: ${priceStr}` : ''}`;
type HeroCoursePill = SectionByType<'hero-course'>['pills'][number];
const heroPills: HeroCoursePill[] = [];
if (fd) {
  heroPills.push(
    { label_fr: LEVEL_LABELS[fd.level]?.[0] ?? fd.level, label_en: LEVEL_LABELS[fd.level]?.[1] ?? fd.level, variant: 'default' },
    { label_fr: `${fd.duration_hours}h`, label_en: `${fd.duration_hours}h`, variant: 'default' },
    { label_fr: fd.format, label_en: fd.format, variant: 'default' },
  );
  if (fd.certification) heroPills.push({ label_fr: 'Certifiant', label_en: 'Certificate', variant: 'accent' });
}
if (pd) {
  heroPills.push(
    { label_fr: LEVEL_LABELS[pd.level]?.[0] ?? pd.level, label_en: LEVEL_LABELS[pd.level]?.[1] ?? pd.level, variant: 'default' },
    { label_fr: `${pd.duration_weeks} semaines`, label_en: `${pd.duration_weeks} weeks`, variant: 'default' },
    { label_fr: `${pd.total_hours}h au total`, label_en: `${pd.total_hours}h total`, variant: 'default' },
  );
  if (pd.certification) heroPills.push({ label_fr: 'Certifiant', label_en: 'Certificate', variant: 'accent' });
}
if (ad) {
  heroPills.push(
    { label_fr: FORMAT_ATELIER[ad.format]?.[0] ?? ad.format, label_en: FORMAT_ATELIER[ad.format]?.[1] ?? ad.format, variant: 'default' },
    { label_fr: `${ad.duration_hours}h`, label_en: `${ad.duration_hours}h`, variant: 'default' },
    { label_fr: `${ad.seats_remaining}/${ad.seats_total} places`, label_en: `${ad.seats_remaining}/${ad.seats_total} seats`, variant: 'default' },
  );
}
if (cd) {
  heroPills.push(
    { label_fr: LEVEL_LABELS[cd.certification_level]?.[0] ?? cd.certification_level, label_en: LEVEL_LABELS[cd.certification_level]?.[1] ?? cd.certification_level, variant: 'default' },
    { label_fr: `${cd.duration_hours}h`, label_en: `${cd.duration_hours}h`, variant: 'default' },
    { label_fr: EXAM_FORMAT[cd.exam_format]?.[0] ?? cd.exam_format, label_en: EXAM_FORMAT[cd.exam_format]?.[1] ?? cd.exam_format, variant: 'default' },
  );
  if (cd.passing_score != null) heroPills.push({ label_fr: `${cd.passing_score}% requis`, label_en: `${cd.passing_score}% required`, variant: 'default' });
}
if (priceStrFr && priceStrEn) {
  heroPills.push({ label_fr: priceStrFr, label_en: priceStrEn, variant: 'price' });
}
const heroData = {
  type: 'hero-course',
  type_label_fr: TYPE_LABELS[data.course_type]?.[0] ?? data.course_type.toUpperCase(),
  type_label_en: TYPE_LABELS[data.course_type]?.[1] ?? data.course_type.toUpperCase(),
  title_fr: data.title_fr,
  title_en: data.title_en,
  lede_fr: data.description_fr,
  lede_en: data.description_en,
  pills: heroPills,
  // Hiérarchie CTA : quand l'inscription n'est pas encore ouverte (placeholder),
  // le seul chemin réellement actionnable est « nous contacter ». On le promeut
  // donc en CTA primaire (solide, cliquable) et on relègue l'état « bientôt
  // disponible » au lien secondaire informatif — au lieu d'afficher un bouton
  // primaire désactivé/grisé qui domine visuellement un lien actif plus discret.
  cta_primary: isPlaceholder
    ? {
        label_fr: 'Une question ? Parlons-en →',
        label_en: 'Have a question? Let’s talk →',
        href: '/contact',
        variant: 'primary',
      }
    : {
        label_fr: `S'inscrire${priceStrFr ? `: ${priceStrFr}` : ''}`,
        label_en: `Enroll${priceStrEn ? `: ${priceStrEn}`: ''}`,
        href: stripeLink ?? '#',
        variant: 'primary',
      },
  cta_secondary: isPlaceholder
    ? {
        label_fr: 'Inscriptions bientôt disponibles',
        label_en: 'Enrollment coming soon',
        href: '/contact',
        variant: 'ghost',
      }
    : {
        label_fr: 'Une question ? →',
        label_en: 'Have a question? →',
        href: '/contact',
        variant: 'ghost',
      },
} satisfies SectionByType<'hero-course'>;

// ── Breadcrumb ─────────────────────────────────────────────────────────────
const crumbs = [
  { label: fr ? 'Accueil' : 'Home', href: fr ? '/' : '/en/' },
  { label: fr ? 'École' : 'Academy', href: fr ? '/ecole' : '/en/ecole' },
  { label: typeLabel },
  { label: title },
];

// ── Atelier date ───────────────────────────────────────────────────────────
const atelierDate = ad?.scheduled_at
  ? ad.scheduled_at.toLocaleDateString(fr ? 'fr-FR' : 'en-GB', {
      weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
    })
  : null;

const SITE_URL = 'https://waimia.com';
// ── Canonical dedup ──────────────────────────────────────────────────────────
// Les formations (course_type === 'formation') sont rendues sur 2 routes :
//   /ecole/cours/{id}      (route dédiée, forme CANONIQUE — référencée par le sitemap)
//   /ecole/formation/{id}  (route générique [type]/[slug], duplicate)
// On force TOUJOURS le canonical vers la forme /ecole/cours/{id} (lang-aware),
// pour que /ecole/formation/{id} pointe vers la forme cours (dedup SEO) et que
// /ecole/cours/{id} reste self-référent. Les cours sont FR-only (pas de route /en/),
// la branche EN reste défensive/future-proof.
const canonicalUrl = fr
  ? `${SITE_URL}/ecole/cours/${entry.id}`
  : `${SITE_URL}/en/ecole/cours/${entry.id}`;
const jsonLd = [
  buildCourseSchema(entry, lang),
  buildBreadcrumbList([
    { name: fr ? 'Accueil' : 'Home', url: fr ? SITE_URL : `${SITE_URL}/en` },
    { name: fr ? 'École' : 'Academy', url: fr ? `${SITE_URL}/ecole` : `${SITE_URL}/en/ecole` },
    { name: typeLabel },
    { name: title },
  ]),
];
---

<Base title={title} description={description} jsonLd={jsonLd} canonical={canonicalUrl}>
  <article class="course-detail" data-type={data.course_type}>
    <div class="wrap-wide">

      <Breadcrumb items={crumbs} lang={lang} noJsonLd />

      <!-- ── HERO · composant catalogué hero-course (contenu via props). ── -->
      <HeroCentered
        data={heroData}
        lang={lang}
        topPad="0"
        wrap={false}
        ctaPrimaryDisabled={false}
        ctaPrimaryExternal={!isPlaceholder}
        ghostStyle="legacy"
      />

      <!-- ── FORMATION ──────────────────────────────────────────────────── -->
      {fd && (
        <div class="type-sections">
          <section class="section">
            <h2 class="section-heading">{fr ? 'Ce que vous allez apprendre' : "What you'll learn"}</h2>
            <ol class="objectives-list">
              {(fr ? fd.learning_objectives_fr : fd.learning_objectives_en).map((obj) => (
                <li class="objective-item">{obj}</li>
              ))}
            </ol>
          </section>

          <section class="section" id="programme">
            <h2 class="section-heading">{fr ? 'Programme détaillé' : 'Full program'}</h2>
            <div class="modules-table">
              {fd.modules.map((mod) => (
                <div class="module-row">
                  <span class="mono muted">{mod.num}</span>
                  <span class="mod-title">{fr ? mod.title_fr : mod.title_en}</span>
                  <span class="mono muted">{mod.duration_minutes}min</span>
                  <span class={`type-pill type-pill--${mod.type}`}>
                    {MODULE_TYPE[mod.type]?.[fr ? 0 : 1] ?? mod.type}
                  </span>
                </div>
              ))}
            </div>
          </section>

          {(fr ? fd.prerequisites_fr : fd.prerequisites_en).length > 0 && (
            <section class="section">
              <h2 class="section-heading">{fr ? 'Prérequis' : 'Prerequisites'}</h2>
              <ul class="prereq-list">
                {(fr ? fd.prerequisites_fr : fd.prerequisites_en).map((p) => (
                  <li class="prereq-item">{p}</li>
                ))}
              </ul>
            </section>
          )}
        </div>
      )}

      <!-- ── PARCOURS ───────────────────────────────────────────────────── -->
      {pd && (
        <div class="type-sections">
          <section class="section">
            <h2 class="section-heading">{fr ? 'Ce que vous allez accomplir' : 'What you will achieve'}</h2>
            <ol class="objectives-list">
              {(fr ? pd.outcomes_fr : pd.outcomes_en).map((out) => (
                <li class="objective-item">{out}</li>
              ))}
            </ol>
          </section>

          <section class="section">
            <h2 class="section-heading">{fr ? 'Cours inclus' : 'Included courses'}</h2>
            <div class="courses-chain">
              {pd.courses.map((slug, i) => (
                <div class="chain-item">
                  <span class="mono muted chain-num">{String(i + 1).padStart(2, '0')}</span>
                  <a class="chain-link" href={`/ecole/courses/${slug}`}>{slug}</a>
                </div>
              ))}
            </div>
          </section>
        </div>
      )}

      <!-- ── ATELIER ────────────────────────────────────────────────────── -->
      {ad && (
        <div class="type-sections">
          <section class="section">
            <h2 class="section-heading">{fr ? 'Informations pratiques' : 'Practical information'}</h2>
            <dl class="info-grid">
              {atelierDate && (
                <>
                  <dt>{fr ? 'Date' : 'Date'}</dt>
                  <dd class="info-val">{atelierDate}</dd>
                </>
              )}
              <dt>{fr ? 'Durée' : 'Duration'}</dt>
              <dd class="info-val">{ad.duration_hours}h</dd>
              <dt>{fr ? 'Format' : 'Format'}</dt>
              <dd class="info-val">{FORMAT_ATELIER[ad.format]?.[fr ? 0 : 1]}</dd>
              <dt>{fr ? 'Places' : 'Seats'}</dt>
              <dd class="info-val">
                {ad.seats_remaining > 0
                  ? `${ad.seats_remaining} / ${ad.seats_total} ${fr ? 'disponibles' : 'available'}`
                  : (fr ? 'Complet' : 'Sold out')}
              </dd>
              {ad.replay_available && (
                <>
                  <dt>{fr ? 'Replay' : 'Replay'}</dt>
                  <dd class="info-val">
                    {ad.recording_url
                      ? <a href={ad.recording_url} class="inline-link">{fr ? 'Voir le replay' : 'Watch replay'} →</a>
                      : (fr ? 'Disponible après le live' : 'Available after live')
                    }
                  </dd>
                </>
              )}
            </dl>
          </section>
        </div>
      )}

      <!-- ── CERTIFICATION ──────────────────────────────────────────────── -->
      {cd && (
        <div class="type-sections">
          <section class="section">
            <h2 class="section-heading">{fr ? "Modalités d'examen" : 'Exam details'}</h2>
            <dl class="info-grid">
              <dt>{fr ? 'Méthode de validation' : 'Validation method'}</dt>
              <dd class="info-val">{cd.validation_method}</dd>
              <dt>{fr ? "Format de l'examen" : 'Exam format'}</dt>
              <dd class="info-val">{EXAM_FORMAT[cd.exam_format]?.[fr ? 0 : 1]}</dd>
              <dt>{fr ? 'Durée' : 'Duration'}</dt>
              <dd class="info-val">{cd.duration_hours}h</dd>
              {cd.passing_score != null && (
                <>
                  <dt>{fr ? 'Score minimum' : 'Passing score'}</dt>
                  <dd class="info-val">{cd.passing_score} %</dd>
                </>
              )}
              {cd.validity_years != null && (
                <>
                  <dt>{fr ? 'Validité' : 'Validity'}</dt>
                  <dd class="info-val">{cd.validity_years} {fr ? 'an(s)' : 'year(s)'}</dd>
                </>
              )}
            </dl>
          </section>

          {(fr ? cd.prerequisites_fr : cd.prerequisites_en).length > 0 && (
            <section class="section">
              <h2 class="section-heading">{fr ? 'Prérequis' : 'Prerequisites'}</h2>
              <ul class="prereq-list">
                {(fr ? cd.prerequisites_fr : cd.prerequisites_en).map((p) => (
                  <li class="prereq-item">{p}</li>
                ))}
              </ul>
            </section>
          )}

          {cd.related_formations.length > 0 && (
            <section class="section">
              <h2 class="section-heading">{fr ? 'Formations recommandées' : 'Recommended courses'}</h2>
              <div class="courses-chain">
                {cd.related_formations.map((slug, i) => (
                  <div class="chain-item">
                    <span class="mono muted chain-num">{String(i + 1).padStart(2, '0')}</span>
                    <a class="chain-link" href={`/ecole/courses/${slug}`}>{slug}</a>
                  </div>
                ))}
              </div>
            </section>
          )}
        </div>
      )}

      <!-- ── MDX BODY ───────────────────────────────────────────────────── -->
      <!-- Layout éditorial 2 colonnes : prose à gauche (mesure de lecture
           contrôlée), rail meta sticky à droite (type, durée, prix, CTA) pour
           supprimer la moitié droite morte du mur de prose. -->
      <section class="section mdx-section">
        <div class="mdx-layout">
          <div class="mdx-body">
            <slot />
          </div>
          <aside class="mdx-rail">
            <div class="mdx-rail__inner">
              <span class="mdx-rail__type">§ {typeLabel}</span>
              {heroPills.length > 0 && (
                <ul class="mdx-rail__facts">
                  {heroPills.map((p) => (
                    <li class={`mdx-rail__fact${p.variant === 'price' ? ' is-price' : ''}${p.variant === 'accent' ? ' is-accent' : ''}`}>
                      {fr ? p.label_fr : p.label_en}
                    </li>
                  ))}
                </ul>
              )}
              {isPlaceholder ? (
                <a class="mdx-rail__cta" href="/contact">{fr ? 'Une question ? Parlons-en →' : 'Have a question? Let’s talk →'}</a>
              ) : (
                <a class="mdx-rail__cta" href={stripeLink} target="_blank" rel="noopener noreferrer">{ctaEnroll}</a>
              )}
              {isPlaceholder && (
                <span class="mdx-rail__note">{fr ? 'Inscriptions bientôt disponibles' : 'Enrollment coming soon'}</span>
              )}
            </div>
          </aside>
        </div>
      </section>

      <!-- ── CTA FINALE ─────────────────────────────────────────────────── -->
      <div class="cta-finale">
        {!isPlaceholder ? (
          <div class="cta-row">
            <a class="btn-primary" href={stripeLink} target="_blank" rel="noopener noreferrer">{ctaEnroll}</a>
            <a class="cta-link" href="/contact">{fr ? 'Une question ?' : 'Have a question?'} →</a>
          </div>
        ) : (
          <div class="cta-row">
            <a class="cta-link cta-accent" href="/contact">
              {fr ? 'Disponible prochainement : nous contacter' : 'Coming soon: contact us'} →
            </a>
          </div>
        )}
      </div>

    </div>
  </article>
</Base>

<style>
  .course-detail {
    padding-top: calc(var(--section-base) + var(--header-height));
    background: var(--paper);
  }

  .wrap-wide {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--space-page-x, 24px);
  }

  /* Masthead migré vers le composant catalogué `HeroCourse` (sections/).
     Règles `.course-detail__hd/.hd-title/.hd-lede/.meta-pills/.pill/.pill--accent/.pill--price/.cta-group`
     supprimées (structure + CSS désormais portés par le composant — source unique). */

  .btn-primary {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: var(--fw-semibold);
    padding: var(--space-3) var(--space-5);
    background: var(--ink, #111);
    color: var(--paper);
    text-decoration: none;
    border: 1px solid var(--ink, #111);
    transition: background 0.15s, border-color 0.15s;
  }

  .btn-primary:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  .btn-disabled {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }

  .btn-ghost {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--text-secondary, #444);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s;
  }

  .btn-ghost:hover { color: var(--accent); }

  /* SECTIONS */
  .type-sections { margin-top: 0; }

  .section {
    padding: var(--space-8) 0 0;
  }

  .section-heading {
    font-family: var(--font-sans);
    font-size: clamp(20px, 2.8vw, 26px);
    font-weight: var(--fw-medium);
    margin: 0 0 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--hairline);
  }

  /* OBJECTIVES */
  .objectives-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--hairline);
    counter-reset: obj;
  }

  .objective-item {
    counter-increment: obj;
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--hairline);
    font-family: var(--font-sans);
    font-size: var(--text-body-lead);
    line-height: var(--leading-body);
  }

  .objective-item::before {
    content: counter(obj, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    color: var(--accent);
    margin-top: 3px;
  }

  /* MODULES TABLE */
  .modules-table { border-top: 1px solid var(--hairline); }

  .module-row {
    display: grid;
    grid-template-columns: 36px 1fr 64px 96px;
    gap: 0 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--hairline);
    align-items: center;
  }

  .mod-title {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: var(--fw-medium);
    line-height: var(--leading-lede);
  }

  .mono { font-family: var(--font-mono); font-size: var(--text-caption); }
  .muted { color: var(--text-muted, #888); }

  .type-pill {
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 6px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xs);
    color: var(--text-muted, #888);
  }

  .type-pill--lecture    { border-color: #3a7d44; color: #3a7d44; }
  .type-pill--exercice   { border-color: var(--accent); color: var(--accent); }
  .type-pill--projet     { border-color: #7b4ea6; color: #7b4ea6; }
  .type-pill--evaluation { border-color: var(--ink, #111); color: var(--ink, #111); }

  /* PREREQS */
  .prereq-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--hairline);
  }

  .prereq-item {
    position: relative;
