---
// Template · CaseStudyTemplate · cas client (long-form)
//
// Mapping handoff2 :
//  - case-plateau.html → /ressources/cas/plateau
//  - (autres cas seront stubs jusqu'à contenu validé)
//
// Squelette : Masthead + Spec bar + Context + Approach (steps) + Proof band
//             + Tech stack + Related + CTA final
//
// Composé de · Bi, Kicker, ChapterLabel atoms · ProcessSteps, ProofBand,
//              TechPillRow, RelatedCards molecules · CtaFinal section.

import Base from '../../layouts/Base.astro';
import Bi from '../ui/atoms/Bi.astro';
import Kicker from '../ui/atoms/Kicker.astro';
import { langFromPath, localizeHref } from '../../lib/i18n';
import ChapterLabel from '../ui/atoms/ChapterLabel.astro';
import MethodTimeline from '../sections/MethodTimeline.astro';
import HeroCentered from '../sections/HeroCentered.astro';
import ProblemStatement from '../sections/ProblemStatement.astro';
import FeatureGrid from '../sections/FeatureGrid.astro';
import MetricShift from '../sections/MetricShift.astro';
import StatBlock from '../sections/StatBlock.astro';
import PullQuoteBlock from '../sections/PullQuoteBlock.astro';
import TechPillRow from '../ui/molecules/TechPillRow.astro';
import CtaFinal from '../sections/CtaFinal.astro';
import KeyMetric from '../editorial/KeyMetric.astro';
import Breadcrumb from '../ui/molecules/Breadcrumb.astro';
import type { SectionByType } from '../../schemas/sections';

interface SpecItem {
  label_fr: string;
  label_en: string;
  value: string;
}
interface Step {
  sn: string;
  kicker_fr: string;
  kicker_en: string;
  title_fr: string;
  title_en: string;
  body_fr: string;
  body_en: string;
}
interface Pill {
  label: string;
  kind?: 'primary' | 'open' | 'neutral';
}
interface Metric {
  k: string;
  label_fr: string;
  label_en: string;
}
interface RelatedCard {
  kicker: string;
  title_fr: string;
  title_en: string;
  lead_fr: string;
  lead_en: string;
  href: string;
}
interface Bottleneck {
  num?: string;
  kicker_fr: string;
  kicker_en: string;
  title_fr: string;
  title_en: string;
  body_fr: string;
  body_en: string;
}
interface Phase {
  num: string;
  label_fr: string;
  label_en: string;
  body_fr: string;
  body_en: string;
  meta_fr?: string;
  meta_en?: string;
}
interface DeliverableCard {
  title_fr: string;
  title_en: string;
  body_fr: string;
  body_en: string;
  format_fr?: string;
  format_en?: string;
}
interface Shift {
  label_fr: string;
  label_en: string;
  before: string;
  after: string;
  delta_fr?: string;
  delta_en?: string;
  trend?: 'up' | 'down' | 'flat';
}
interface ContextStat {
  value: string;
  label_fr: string;
  label_en: string;
}
interface Props {
  title: string;
  description: string;
  /** Label personnalisé pour le breadcrumb. */
  caseTitle?: string;
  /** Numéro éditorial (Case 04, Case 07…) */
  caseNum: string;
  /** Titre h1 (était slot "headline" ; passé en prop pour HeroCaseStudy). */
  h1_fr: string;
  h1_en: string;
  /** Spec bar (5 items typiquement : Client, Sector, Duration, Stack, Services) */
  specs: SpecItem[];
  /** Steps process (4 typiquement). Legacy/rétro-compat — préférer `phases`. */
  steps: Step[];
  /** Proof quote + metrics */
  proofQuoteFr: string;
  proofQuoteEn: string;
  proofAttrFr: string;
  proofAttrEn: string;
  proofMetrics: Metric[];
  /** Tech stack pills */
  techPills: Pill[];
  /** Related cards (3 cas connexes) */
  relatedCards: RelatedCard[];
  /** Offres liées (cross-collection) */
  relatedOffresLinks?: Array<{ title: string; href: string }>;
  /** Slug pour ViewTransition (ex: "cas-plateau") */
  transitionSlug?: string;
  /** Provenance double-label (docs/strategy/03 §5). first-party = chip plein « Cas client · Waimia » ; second-party = chip outline « Analyse · sources tierces ». */
  provenance?: 'first-party' | 'second-party';
  /** Bloc(s) JSON-LD spécifiques (Article/CreativeWork…) injectés dans <Base>. */
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  // ── Refonte éditoriale W2 (docs/25) : composition de sections cataloguées.
  //    Tous optionnels → rendu conditionnel. Si absents, le template garde son
  //    comportement legacy (slot context = <Content/>, pas de section approach vide).
  /** Énoncé contexte → ProblemStatement (sinon slot "context" legacy). */
  contextStatementFr?: string;
  contextStatementEn?: string;
  contextStats?: ContextStat[];
  /** 3 goulots → ProblemsGrid. */
  bottlenecks?: Bottleneck[];
  /** Phases réelles → MethodTimeline (remplace le husk steps=[]). */
  phases?: Phase[];
  /** Livrables → DeliverablesGrid. */
  deliverableCards?: DeliverableCard[];
  /** Avant→après → MetricShift. */
  shifts?: Shift[];
  /** Citation magnifiée → PullQuoteBlock (sinon bloc case-proof legacy). */
  pullQuoteFr?: string;
  pullQuoteEn?: string;
  pullQuoteCiteFr?: string;
  pullQuoteCiteEn?: string;
}
const {
  title, description, caseTitle, caseNum, h1_fr, h1_en, specs, steps,
  proofQuoteFr, proofQuoteEn, proofAttrFr, proofAttrEn, proofMetrics,
  techPills, relatedCards, relatedOffresLinks, transitionSlug, jsonLd,
  contextStatementFr, contextStatementEn, contextStats,
  bottlenecks, phases, deliverableCards, shifts,
  pullQuoteFr, pullQuoteEn, pullQuoteCiteFr, pullQuoteCiteEn,
  provenance = 'first-party',
} = Astro.props;
// Double-label (docs/strategy/03 §5) : famille A first-party = chip plein,
// famille B second-party = chip outline. Cliquable → /sources-methodologie.
const isFirstParty = provenance !== 'second-party';
const provenanceLabel = {
  fr: isFirstParty ? 'Cas client · Waimia' : 'Analyse · sources tierces',
  en: isFirstParty ? 'Client case · Waimia' : 'Analysis · third-party sources',
};
const lang = langFromPath(Astro.url.pathname);
const pageTransitionId = Astro.url.pathname
  .replace(/^\/(?:en\/)?/, '')
  .replace(/\/$/, '')
  .replace(/[^a-z0-9]+/gi, '-')
  .replace(/^-|-$/g, '') || 'home';
const cardTransitionId = transitionSlug ?? pageTransitionId;
const heroData = {
  type: 'hero-case-study',
  case_num: caseNum,
  eyebrow_fr: '§ Cas client',
  eyebrow_en: '§ Cas client', // legacy hardcodait '§ Cas client' même en EN (parité 0-régression)
  h1_fr,
  h1_en,
  specs: specs.map((s) => ({ label_fr: s.label_fr, label_en: s.label_en, value: s.value })),
} satisfies SectionByType<'hero-case-study'>;
const caseLabel = caseTitle ?? title.split(' · ')[0];
const ctaData = {
  type: 'cta-final',
  h2_fr: 'Votre prochain <i>cas</i> doit produire quoi ?',
  h2_en: 'What should your next <i>case</i> actually produce?',
  body_fr: `Si ${caseLabel} ressemble à votre contexte, on cadre le vôtre en 45 minutes et on vous dit vite si le terrain est opérable.`,
  body_en: `If ${caseLabel} looks like your context, we can frame yours in 45 minutes and tell you quickly whether the field is operationally viable.`,
  cta_primary: {
    label_fr: 'Réserver un audit →',
    label_en: 'Book an audit →',
    href: localizeHref('/contact', lang),
    variant: 'primary',
  },
  cta_secondary: {
    label_fr: 'Voir les offres →',
    label_en: 'See services →',
    href: localizeHref('/offres', lang),
    variant: 'ghost',
  },
  background: 'paper',
} satisfies SectionByType<'cta-final'>;

// ── Composition éditoriale (docs/25) : data des sections cataloguées, construites
//    seulement si la donnée frontmatter est présente (sinon rendu legacy conditionnel).
const hasContextStatement = Boolean(contextStatementFr || contextStatementEn);
const problemStatementData = hasContextStatement
  ? ({
      type: 'problem-statement',
      kicker_fr: '§ Le contexte',
      kicker_en: '§ Context',
      statement_fr: contextStatementFr ?? contextStatementEn ?? '',
      statement_en: contextStatementEn ?? contextStatementFr ?? '',
      ...(contextStats && contextStats.length > 0 ? { stats: contextStats } : {}),
    } satisfies SectionByType<'problem-statement'>)
  : null;

const problemsGridData = bottlenecks && bottlenecks.length >= 2
  ? ({
      type: 'problems-grid',
      h2_fr: 'Trois goulots structurels.',
      h2_en: 'Three structural bottlenecks.',
      problems: bottlenecks,
    } satisfies SectionByType<'problems-grid'>)
  : null;

const methodTimelineData = phases && phases.length >= 2
  ? ({
      type: 'method-timeline',
      kicker_fr: "§ 02 · L'approche",
      kicker_en: '§ 02 · The approach',
      h2_fr: "Ce qu'on a câblé.",
      h2_en: 'What we built.',
      steps: phases,
    } satisfies SectionByType<'method-timeline'>)
  : null;

const deliverablesGridData = deliverableCards && deliverableCards.length >= 2
  ? ({
      type: 'deliverables-grid',
      kicker_fr: '§ Livré',
      kicker_en: '§ Shipped',
      title_fr: "Ce qu'on a livré.",
      title_en: 'What we shipped.',
      items: deliverableCards,
    } satisfies SectionByType<'deliverables-grid'>)
  : null;

const metricShiftData = shifts && shifts.length >= 2
  ? ({
      type: 'metric-shift',
      kicker_fr: '§ Avant → après',
      kicker_en: '§ Before → after',
      shifts,
      background: 'paper',
    } satisfies SectionByType<'metric-shift'>)
  : null;

const statBlockData = proofMetrics.length > 0
  ? ({
      type: 'stat-block',
      h2_fr: 'Résultats mesurés.',
      h2_en: 'Measured results.',
      metrics: proofMetrics.map((m) => ({
        value: m.k,
        label_fr: m.label_fr,
        label_en: m.label_en,
        emphasis: false,
      })),
      layout: 'grid-3' as const,
    } satisfies SectionByType<'stat-block'>)
  : null;

const hasPullQuote = Boolean(pullQuoteFr || pullQuoteEn);
const pullQuoteData = hasPullQuote
  ? ({
      type: 'pull-quote-block',
      quote_fr: pullQuoteFr ?? pullQuoteEn ?? '',
      quote_en: pullQuoteEn ?? pullQuoteFr ?? '',
      ...(pullQuoteCiteFr || pullQuoteCiteEn
        ? { cite_fr: pullQuoteCiteFr ?? pullQuoteCiteEn, cite_en: pullQuoteCiteEn ?? pullQuoteCiteFr }
        : {}),
      variant: 'centered' as const,
    } satisfies SectionByType<'pull-quote-block'>)
  : null;

// Husk éliminé : on ne rend la timeline legacy QUE si des steps existent vraiment.
const hasLegacySteps = steps && steps.length > 0;
const showAuthorBand = Astro.slots.has('author-byline') || Astro.slots.has('author-card');
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <Breadcrumb
    lang={lang}
    items={[
      { label: lang === 'fr' ? 'Accueil' : 'Home', href: lang === 'fr' ? '/' : '/en' },
      { label: lang === 'fr' ? 'Cas clients' : 'Case studies', href: lang === 'fr' ? '/realisations' : '/en/realisations' },
      { label: caseTitle ?? title },
    ]}
  />
  {/* MASTHEAD + SPEC BAR → HeroCaseStudy (sections/) */}
  <HeroCentered
    data={heroData}
    lang={lang}
    transitionId={pageTransitionId}
    cardTransitionId={cardTransitionId}
    topPad="clamp(80px, 10vw, 120px)"
    h1Gap="48px"
  />

  {/* DOUBLE-LABEL · famille A/B (docs/strategy/03 §5) : chip de provenance,
      cliquable vers la page méthodologie. Plein si first-party, outline sinon. */}
  <section class="case-provenance reveal">
    <div class="wrap-wide">
      <a
        class:list={['case-provenance-chip', isFirstParty ? 'case-provenance-chip--solid' : 'case-provenance-chip--outline']}
        href={localizeHref('/sources-methodologie', lang)}
      >
        {lang === 'en' ? provenanceLabel.en : provenanceLabel.fr}
      </a>
    </div>
  </section>

  {Astro.slots.has('hero-image') && <div class="case-hero-image"><slot name="hero-image" /></div>}

  {/* AUTHOR BAND (byline en tête — bande dédiée propre, hors pavé) */}
  {showAuthorBand && Astro.slots.has('author-byline') && (
    <section class="case-author-band reveal">
      <div class="wrap-wide"><slot name="author-byline" /></div>
    </section>
  )}

  {/* CONTEXT — composé (problem-statement) si frontmatter migré, sinon slot legacy <Content/> */}
  {problemStatementData ? (
    <ProblemStatement data={problemStatementData} lang={lang} />
  ) : (
    <section class="case-context reveal">
      <div class="wrap-wide case-context-grid">
        <div>
          <ChapterLabel num="§ 01" title="Context" class="case-sticky" />
        </div>
        <div>
          <Kicker tone="accent" class="case-context-k"><Bi fr="Le brief" en="The brief" /></Kicker>
          <slot name="context" />
        </div>
      </div>
    </section>
  )}

  {/* BOTTLENECKS → problems-grid (migré uniquement) */}
  {problemsGridData && <FeatureGrid data={problemsGridData} lang={lang} />}

  {/* APPROACH · timeline — phases migrées (préféré) sinon steps legacy. Husk éliminé :
      ne rend la section QUE si une des deux sources existe. */}
  {methodTimelineData ? (
    <MethodTimeline data={methodTimelineData} lang={lang} />
  ) : hasLegacySteps ? (
    <section class="case-approach reveal-stagger">
      <div class="wrap-wide">
        <header class="case-section-hd">
          <Kicker tone="accent">§ 02 · <Bi fr="L'approche" en="The approach" /></Kicker>
          <h2 class="case-section-h2 u-serif-accent"><slot name="approach-headline" /></h2>
          <p class="case-section-aside"><slot name="approach-aside" /></p>
        </header>
        <MethodTimeline
          data={{
            type: 'method-timeline',
            h2_fr: '',
            h2_en: '',
            steps: steps.map((s) => ({
              num: s.sn,
              label_fr: s.title_fr,
              label_en: s.title_en,
              body_fr: s.body_fr,
              body_en: s.body_en,
              meta_fr: s.kicker_fr || undefined,
              meta_en: s.kicker_en || undefined,
            })),
          }}
          lang={lang}
        />
      </div>
    </section>
  ) : null}

  {/* DELIVERABLES → deliverables-grid (migré uniquement) */}
  {deliverablesGridData && <FeatureGrid data={deliverablesGridData} lang={lang} />}

  {/* METRIC SHIFT → before→after magnifié (migré uniquement) */}
  {metricShiftData && <MetricShift data={metricShiftData} lang={lang} />}

  {/* KEY METRICS → stat-block catalogué (remplace le bloc bespoke case-key-metrics) */}
  {statBlockData && <StatBlock data={statBlockData} lang={lang} />}

  {/* PROOF — pull-quote-block catalogué si migré, sinon bloc témoignage legacy */}
  {pullQuoteData ? (
    <PullQuoteBlock data={pullQuoteData} lang={lang} />
  ) : (
    <section class="case-proof reveal">
      <div class="wrap-wide">
        <Kicker as="span" tone="accent" letterSpacing="0.12em" class="eyebrow">§ 03 · Témoignage</Kicker>
        <blockquote class="case-proof-quote">
          <Bi fr={`« ${proofQuoteFr} »`} en={`"${proofQuoteEn}"`} />
        </blockquote>
        <cite class="case-proof-attr">
          <Bi fr={proofAttrFr} en={proofAttrEn} />
        </cite>
      </div>
    </section>
  )}

  {/* STACK */}
  <section class="case-stack reveal">
    <div class="wrap-wide">
      <Kicker tone="accent" class="case-stack-k">§ 04 · <Bi fr="La stack" en="The stack" /></Kicker>
      <p class="case-stack-lead">
        <slot name="stack-lead" />
      </p>
      <TechPillRow pills={techPills} />
    </div>
  </section>

  {/* AUTHOR CARD (bande dédiée propre — hors pavé) */}
  {Astro.slots.has('author-card') && (
    <section class="case-author-card-band reveal">
      <div class="wrap-wide"><slot name="author-card" /></div>
    </section>
  )}

  {relatedOffresLinks && relatedOffresLinks.length > 0 && (
    <section class="case-related-offres">
      <p class="case-related-offres__label">
        {lang === 'en' ? 'Service used' : 'Offre utilisée'}
      </p>
      <div class="case-related-offres__links">
        {relatedOffresLinks.map(off => (
          <a href={off.href} class="case-offre-link">
            <span>{off.title}</span>
            <span aria-hidden>→</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {/* RELATED */}
  <section class="case-related reveal-stagger">
    <div class="wrap-wide">
      <Kicker as="span" tone="accent" letterSpacing="0.12em" class="eyebrow">§ Autres cas</Kicker>
      <div class="case-related-grid">
        {relatedCards.map((c) => (
          <a class="related-case-card" href={c.href}>
            <span class="related-case-kicker">{c.kicker}</span>
            <h3 class="related-case-title">{lang === 'en' ? c.title_en: c.title_fr}</h3>
            <p class="related-case-lead">{lang === 'en' ? c.lead_en: c.lead_fr}</p>
            <span class="related-case-go" aria-hidden>→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaFinal data={ctaData} lang={lang} />
  <slot name="body-end" />
</Base>

<style>
  /* Double-label · chip provenance (docs/strategy/03 §5). Tokens DS existants
     uniquement : --font-mono, --text-small, --accent, --ink, --paper,
     --accent-text, --radius-pill, --hairline-strong, --space-*, --dur-fast, --ease. */
  .case-provenance { padding: var(--space-5) var(--space-6) 0; }
  .case-provenance-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: opacity var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }
  .case-provenance-chip--solid {
    background: var(--accent);
    color: var(--paper);
    border: 1px solid var(--accent);
  }
  .case-provenance-chip--solid:hover { opacity: 0.85; }
  .case-provenance-chip--outline {
    background: transparent;
    color: var(--accent-text);
    border: 1px solid var(--hairline-strong);
  }
  .case-provenance-chip--outline:hover { background: var(--paper-2); }

  .case-author-band { padding: var(--space-9) var(--space-6) 0; }
  .case-author-card-band {
    padding: var(--space-10) var(--space-6);
    border-top: 1px solid var(--hairline);
  }
  .case-context { padding: var(--space-10) var(--space-6); }
  .case-context-grid {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--space-9);
  }
  :global(.case-sticky) { position: sticky; top: 100px; }
  :global(.case-context-k) { display: block; margin-bottom: var(--space-5); }

  .case-approach { padding: var(--space-10) var(--space-6); background: var(--paper-2); border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
  .case-section-hd {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-9);
    margin-bottom: var(--space-9);
    align-items: end;
  }
  .case-section-h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    line-height: 0.95;
    letter-spacing: -0.024em;
    text-wrap: balance;
    font-weight: var(--fw-medium);
    margin: 14px 0 0;
  }
  .case-section-aside {
    font-size: var(--text-small);
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
    max-width: 400px;
    margin: 0;
  }

  .case-proof { padding: var(--space-10) var(--space-6); }
  .case-proof-quote {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: var(--leading-h3);
    letter-spacing: -0.018em;
    font-weight: var(--fw-regular);
    font-style: italic;
    text-wrap: pretty;
    max-width: 860px;
    margin: 0 0 var(--space-5);
  }
  .case-proof-attr {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--muted);
    letter-spacing: 0.06em;
    font-style: normal;
  }
  .case-key-metrics {
    padding: var(--space-10) var(--space-6);
    background: var(--ink);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .case-key-metrics .eyebrow { color: var(--accent-text); margin-bottom: var(--space-7); }
  .case-km-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-9);
    align-items: end;
  }
  .case-key-metrics :global(.key-metric-value) { color: var(--paper); }
  .case-key-metrics :global(.key-metric-label) { color: rgba(var(--paper-rgb), 0.55); }
  .case-stack { padding: var(--space-10) var(--space-6); background: var(--paper-2); border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
  :global(.case-stack-k) { display: block; margin-bottom: var(--space-4); }
  .case-stack-lead {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.3;
    color: var(--muted);
    max-width: 760px;
    text-wrap: balance;
    margin: 0 0 var(--space-8);
  }

  .case-related { padding: var(--space-10) var(--space-6); }
  :global(.case-related-k) { display: block; margin-bottom: var(--space-6); }
  .case-related-offres {
    margin: var(--space-6, 2rem) 0;
    padding: var(--space-4, 1.5rem);
    border: 1px solid var(--hairline-strong);
    border-left: 3px solid var(--accent);
  }
  .case-related-offres__label {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-2, 0.75rem);
  }
  .case-offre-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2, 0.75rem) 0;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--hairline-strong);
    transition: color var(--dur-fast) var(--ease);
  }
  .case-offre-link:last-child { border-bottom: none; }
  .case-offre-link:hover { color: var(--accent-text); }

  @media (max-width: 900px) {
    .case-context-grid,
    .case-section-hd { grid-template-columns: 1fr; }
  }

  .case-hero-image { aspect-ratio: 16/9; margin: var(--space-10) var(--space-6); overflow: hidden; }
  .case-hero-image :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Eyebrow · Kicker canonisé (R6) : typo + couleur portées par l'atome
     (tone="accent", letterSpacing 0.12em = ex var(--tracking-mono)) ; ici layout seul.
