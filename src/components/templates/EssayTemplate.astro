---
// Template · EssayTemplate · article éditorial long-form (essais, blog)
//
// Mapping handoff2 :
//  - essay-brain-circuit.html → /blog/brain-circuit
//  - changelog.html (variant)
//
// Squelette : Masthead minimaliste + lede + body slot (rich text) + Author footer
//             + Related cards + CTABand
//
// Décision : pas de spec bar (différencie d'un Case). Le squelette est plus simple
// et laisse 100 % du body en slot pour le HTML rich text (h2, h3, p, blockquote, code).

import { AUDIT_BOOKING_HREF, AUDIT_BOOKING_LABEL, auditCtaBand } from '../../data/conversion';
import Base from '../../layouts/Base.astro';
import Bi from '../ui/atoms/Bi.astro';
import Kicker from '../ui/atoms/Kicker.astro';
import RelatedCards from '../ui/molecules/RelatedCards.astro';
import AuthorCard from '../ui/molecules/AuthorCard.astro';
import CtaBandSection from '../sections/CtaBandSection.astro';
import FaqAccordion from '../sections/FaqAccordion.astro';
import CtaFinal from '../sections/CtaFinal.astro';
import LeadCaptureBand from '../../sections/lead-capture-band/Component.astro';
import HeroCentered from '../sections/HeroCentered.astro';
import { buildArticle } from '../../lib/seo/schema-builder';
import MastheadBar from '../sections/MastheadBar.astro';
import TableOfContents from '../ui/molecules/TableOfContents.astro';
import ShareButtons from '../ui/molecules/ShareButtons.astro';
import RelatedByCluster from '../ui/molecules/RelatedByCluster.astro';
import TagPills from '../ui/molecules/TagPills.astro';
import type { SectionByType } from '@waimia/ds-kernel';
import { localizeHref } from '../../lib/i18n';
import AuthorByline from '../ui/molecules/AuthorByline.astro';
import { splitLocaleHtml, filterHeadingsForHtml } from '../../lib/blog-locale-split';
import { SITE } from '../../site.config';
import { siloCtaText } from '../../data/taxonomies';

interface RelatedCard {
  kicker: string;
  title_fr: string;
  title_en: string;
  lead_fr: string;
  lead_en: string;
  href: string;
}
interface Props {
  title: string;
  /** <title> SEO distinct du H1 (sinon `title`). */
  seoTitle?: string;
  description: string;
  /** Exclure la page de l'index (robots noindex) · forwarded to Base */
  noindex?: boolean;
  /** Catégorie + numéro éditorial (Essay 03, Note 12) */
  kicker: string;
  /** Date publication ISO ou format libre */
  date: string;
  /** Auteur */
  author: string;
  /** Reading time approximé */
  readingTime?: string;
  /** Related cards (3 articles connexes) */
  relatedCards: RelatedCard[];
  /** Slug auteur pour AuthorCard dans le footer */
  authorSlug?: string;
  /** Sources bibliographiques (depuis frontmatter) */
  sources?: Array<{ name: string; url: string; type: string }>;
  /** Image absolue ou relative pour Article schema. */
  image?: string;
  /** Date ISO optionnelle quand la date affichée est localisée. */
  datePublished?: string;
  /** Date de mise à jour ISO optionnelle. */
  dateModified?: string;
  /** Actualité : dates à la minute (ISO avec fuseau), JSON-LD NewsArticle, heure dans la signature. */
  news?: boolean;
  /** Canonical absolue optionnelle. */
  canonical?: string;
  /** Libellé du silo (JSON-LD articleSection). */
  category?: string;
  /** Clé du silo (SILOS) : choisit la question du bandeau CTA. Absent = question générique. */
  silo?: string;
  /** Tags SEO/GEO. */
  tags?: string[];
  /** Breadcrumb custom (si absent, calcule automatiquement depuis kicker) */
  breadcrumbItems?: Array<{ label: string; href?: string }>;
  /** Lang pour breadcrumb */
  lang?: 'fr' | 'en';
  /** Cas clients liés (cross-collection) */
  relatedCasesData?: Array<{ id: string; title: string; href: string }>;
  /** Offres liées (cross-collection) */
  relatedOffresData?: Array<{ id: string; title: string; href: string }>;
  /** Headings pour la table des matières (issus de render() Astro MDX) */
  headings?: Array<{ depth: number; slug: string; text: string }>;
  /** Cluster éditorial pour RelatedByCluster */
  cluster?: string;
  /** ID de l'article courant (pour exclure de RelatedByCluster) */
  articleId?: string;
  /** Slug auteur pour le byline en tête d'article. */
  bylineAuthorSlug?: string;
  /** Date de publication brute (pour le byline en tête). */
  publishedAt?: Date | string;
  /** Habillage editorial : illustration duotone en overlap du hero (optionnel). */
  illustration?: { src: string; alt_fr: string; alt_en: string; side?: 'left' | 'right' };
  /** FAQ (optionnel) : rendue via le composant catalogue FaqAccordion, qui émet
   *  aussi l'unique JSON-LD FAQPage (source canonique · GEO/AIO). Absent = 0 rendu. */
  faqItems?: Array<{ q: string; a: string }>;
  /** Ressource liée (bloc `lead` du template essay, résolu par `resolveEssayLead`) :
   *  `lead-capture-band` en carte à la fin de la prose (PDF verrouillé) ou `cta-final`
   *  après le corps (outil interactif). Absent = 0 rendu. */
  leadSection?: SectionByType<'lead-capture-band'> | SectionByType<'cta-final'>;
  /** Variante de page. `tool` (route /ressources/outils/[...slug] seulement) : héros compact
   *  et slot `stage` rendu pleine largeur entre le héros et la prose. Défaut `essay` = rendu inchangé. */
  /** Billet : bande CTA d'audit après l'introduction (avant le premier H2 du corps). */
  midCta?: boolean;
  variant?: 'essay' | 'tool';
}
const {
  title,
  description,
  kicker,
  date,
  author,
  readingTime,
  relatedCards,
  authorSlug,
  sources,
  image,
  datePublished,
  dateModified,
  news = false,
  canonical,
  category,
  silo,
  tags = [],
  breadcrumbItems,
  lang = 'fr',
  relatedCasesData,
  relatedOffresData,
  headings,
  cluster,
  articleId,
  bylineAuthorSlug,
  publishedAt,
  illustration,
  faqItems,
  leadSection,
  noindex = false,
  seoTitle,
  variant = 'essay',
  midCta = false,
} = Astro.props as Props;
const isTool = variant === 'tool';

const headlineHtml = (await Astro.slots.render('headline')).trim();
const ledeHtml = (await Astro.slots.render('lede')).trim();

// Corps MDX bilingue : on isole la moitié de la locale rendue (FR avant le
// premier <hr> racine, EN après) et on retire le séparateur. Sommaire + a11y
// filtrés sur les seuls headings présents dans la moitié retenue.
const rawBodyHtml = await Astro.slots.render('body');
const localizedBodyHtml = splitLocaleHtml(rawBodyHtml, lang);
// CTA de milieu (billets, audit v5 point 4) : le corps est coupé avant le premier H2 qui suit
// un paragraphe, donc après l'introduction (un « En bref » en liste ouvre souvent le corps,
// le premier paragraphe vient ensuite). Sans paragraphe suivi d'un H2, pas de bande.
const firstP = midCta && !isTool ? localizedBodyHtml.search(/<p[\s>]/i) : -1;
const h2AfterP = firstP >= 0 ? localizedBodyHtml.slice(firstP).search(/<h2[\s>]/i) : -1;
const introEnd = h2AfterP > 0 ? firstP + h2AfterP : -1;
const bodyIntroHtml = introEnd > 0 ? localizedBodyHtml.slice(0, introEnd) : localizedBodyHtml;
const bodyRestHtml = introEnd > 0 ? localizedBodyHtml.slice(introEnd) : '';
// Préréglage boîte `cta-inline` du composant catalogué cta-band (in-flow, colonne de lecture).
// Accroche `tiny`, distincte de la bande finale (siloCtaText).
const midCtaData = introEnd > 0
  ? ({ ...auditCtaBand({ promise: 'tiny' }), type: 'cta-inline' } satisfies SectionByType<'cta-inline'>)
  : null;
const localizedHeadings = filterHeadingsForHtml(headings, localizedBodyHtml);
const tocCount = localizedHeadings.filter((h) => h.depth === 2 || h.depth === 3).length;
const hasToc = tocCount >= 2;
const heroData = {
  type: 'hero-essay',
  kicker_fr: kicker,
  kicker_en: kicker,
  h1_fr: headlineHtml,
  h1_en: headlineHtml,
  lede_fr: ledeHtml,
  lede_en: ledeHtml,
  author,
  date,
  reading_time_fr: readingTime,
  reading_time_en: readingTime,
  ...(illustration ? { illustration: { side: 'right' as const, ...illustration } } : {}),
} satisfies SectionByType<'hero-essay'>;

const siteUrl = SITE.url;
const pageTransitionId = Astro.url.pathname
  .replace(/^\/(?:en\/)?/, '')
  .replace(/\/$/, '')
  .replace(/[^a-z0-9]+/gi, '-')
  .replace(/^-|-$/g, '') || 'home';
const canonicalUrl = canonical ?? Astro.url.href;
const absoluteImage = image
  ? (image.startsWith('http') ? image : `${siteUrl}${image}`)
  : `${siteUrl}/og/default.png`;
const articleSection = category ?? kicker.replace(/^§\s*/, '').split('·')[0]?.trim();
const ctaData = {
  type: 'cta-band',
  text_fr: siloCtaText(silo, 'fr'),
  text_en: siloCtaText(silo, 'en'),
  cta: {
    label_fr: `${AUDIT_BOOKING_LABEL.fr} →`,
    label_en: `${AUDIT_BOOKING_LABEL.en} →`,
    href: AUDIT_BOOKING_HREF,
    variant: 'primary',
  },
  background: 'paper-2',
} satisfies SectionByType<'cta-band'>;

// JSON-LD Article schema · GEO/AIO indexable par crawlers LLM
// Une actualité porte l'illustration du hero (≥ 1 200 px, vérifiée par check:news) en plus de
// l'image Open Graph : Google choisit la mieux adaptée à chaque surface.
const newsImages = news && illustration?.src ? [`${siteUrl}${illustration.src}`, absoluteImage] : undefined;
const articleLd = buildArticle({
  type: news ? 'NewsArticle' : 'Article',
  headline: title,
  description,
  image: newsImages ?? absoluteImage,
  datePublished: datePublished ?? date,
  dateModified: dateModified ?? datePublished ?? date,
  author: {
    '@type': 'Person',
    ...(authorSlug ? { '@id': `${siteUrl}/equipe/${authorSlug}#person`, url: `${siteUrl}/equipe/${authorSlug}` } : {}),
    name: author,
  },
  mainEntityOfPage: canonicalUrl,
  articleSection,
  keywords: tags,
});
---
<Base title={seoTitle ?? title} description={description} jsonLd={articleLd} noindex={noindex}>
  {breadcrumbItems && breadcrumbItems.length > 0 && (
    <MastheadBar lang={lang ?? 'fr'} items={breadcrumbItems} />
  )}
  <article class:list={['essay', { 'essay--tool': isTool }]}>
    {/* MASTHEAD */}
    <HeroCentered
      data={heroData}
      lang={lang}
      transitionId={pageTransitionId}
      cardTransitionId={pageTransitionId}
      topPad={isTool ? undefined : '140px'}
    />

    {/* STAGE · outil interactif pleine largeur (variante tool), hors colonne de lecture */}
    {isTool && Astro.slots.has('stage') && <slot name="stage" />}

    {/* BODY */}
    <div class="essay-body">
      <div class:list={['essay-layout', {
        'essay-layout--three-col': hasToc && sources && sources.length > 0,
        'essay-layout--with-toc': hasToc && !(sources && sources.length > 0),
        'essay-layout--with-aside': !hasToc && sources && sources.length > 0,
      }]}>
        {hasToc && (
          <aside class="essay-toc">
            <TableOfContents headings={localizedHeadings} lang={lang} />
          </aside>
        )}
        <div class="essay-prose reveal">
          <AuthorByline authorSlug={bylineAuthorSlug} date={publishedAt} updatedAt={dateModified} readingTime={readingTime} showTime={news} />
          <Fragment set:html={bodyIntroHtml} />
          {midCtaData && (
            <div class="essay-mid-cta">
              <CtaBandSection data={midCtaData} lang={lang} />
            </div>
          )}
          {bodyRestHtml && <Fragment set:html={bodyRestHtml} />}
          {leadSection?.type === 'lead-capture-band' && <LeadCaptureBand data={leadSection} lang={lang} />}
          <div class="essay-share-end">
            <ShareButtons url={canonicalUrl} title={title} lang={lang} />
          </div>
          {tags.length > 0 && (
            <div class="essay-tags-end">
              <TagPills tags={tags} cluster={cluster} lang={lang} />
            </div>
          )}
        </div>
        {sources && sources.length > 0 && (
          <aside class="essay-sources">
            <span class="essay-sources-label">§ Sources</span>
            <ul class="essay-sources-list">
              {sources.map(src => (
                <li class="essay-source-item">
                  <a href={src.url} class="essay-source-link" target="_blank" rel="noopener noreferrer">
                    {src.name}
                  </a>
                  <span class="essay-source-type">{src.type}</span>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>
    </div>

    {leadSection?.type === 'cta-final' && <CtaFinal data={leadSection} lang={lang} />}

    {cluster && (
      <div class="wrap-wide essay-related-cluster">
        <RelatedByCluster cluster={cluster} excludeId={articleId} limit={4} />
      </div>
    )}

    {/* FOOTER 3-COL · Related + Author + CTA */}
    <footer class="essay-footer reveal">
      <div class="wrap-wide essay-footer-grid">
        <div class="essay-footer-related">
          <Kicker class="essay-related-k"><Bi fr="À lire ensuite" en="Related notes" /></Kicker>
          {Boolean(relatedCasesData?.length || relatedOffresData?.length) && (
            <section class="essay-related-cross">
              <h2 class="essay-related-cross__title">
                {lang === 'en' ? 'Related to this article' : 'En lien avec cet article'}
              </h2>
              <div class="essay-related-cross__grid">
                {relatedCasesData?.map(cas => (
                  <a href={cas.href} class="related-card related-card--case">
                    <Kicker as="span">{lang === 'en' ? '§ Customer case' : '§ Cas client'}</Kicker>
                    <h3>{cas.title}</h3>
                  </a>
                ))}
                {relatedOffresData?.map(off => (
                  <a href={off.href} class="related-card related-card--offre">
                    <Kicker as="span">{lang === 'en' ? '§ Service' : '§ Offre'}</Kicker>
                    <h3>{off.title}</h3>
                  </a>
                ))}
              </div>
            </section>
          )}
          <RelatedCards cards={relatedCards} />
        </div>
        {authorSlug && (
          <div class="essay-footer-author">
            <Kicker>§ Auteur</Kicker>
            <AuthorCard authorSlug={authorSlug} variant="mini" />
          </div>
        )}
        <div class="essay-footer-cta">
          <Kicker>§ Audit IA</Kicker>
          <p class="essay-cta-text">Ce sujet vous concerne&nbsp;? 45 minutes pour en parler sur vos processus.</p>
          <a href={AUDIT_BOOKING_HREF} class="essay-cta-link">{AUDIT_BOOKING_LABEL.fr} →</a>
        </div>
      </div>
    </footer>
  </article>

  {faqItems && faqItems.length > 0 && (
    <FaqAccordion
      items={faqItems}
      heading={lang === 'en' ? 'Frequently asked questions' : 'Questions fréquentes'}
      background="paper-2"
    />
  )}

  <CtaBandSection data={ctaData} lang={lang} />
</Base>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08 }
  );
  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>

<style>
/* ── Body layout ──────────────────────────────────────── */
.essay-body {
  padding: var(--space-11) var(--space-6);
}
.essay-layout {
  max-width: 1200px;
  margin: 0 auto;
}
.essay-layout--with-aside {
  display: grid;
  grid-template-columns: 1fr 260px;
  gap: var(--space-10);
  align-items: start;
}

/* TOC sidebar layout */
.essay-layout--with-toc {
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: var(--space-9);
  align-items: start;
  max-width: 1200px;
  margin: 0 auto;
}
.essay-layout--three-col {
  display: grid;
  grid-template-columns: 220px 1fr 260px;
  gap: var(--space-9);
  align-items: start;
  max-width: 1200px;
  margin: 0 auto;
}
.essay-toc {
  position: sticky;
  top: var(--space-11);
  align-self: start;
  min-width: 0;
}
.essay-share-end {
  margin: var(--space-9) 0 var(--space-5);
  padding-top: var(--space-5);
  border-top: 1px solid var(--hairline);
}
.essay-tags-end {
  margin: 0;
}
.essay-related-cluster {
  padding: 0 var(--space-6) var(--space-9);
}

/* ── Prose ────────────────────────────────────────────── */
.essay-prose {
  max-width: var(--wrap-prose);
  font-family: var(--font-sans);
  font-size: var(--text-small);
  line-height: var(--leading-prose);
  color: var(--ink);
  min-width: 0;
}

/* Drop cap sur premier paragraphe */
.essay-prose :global(p:first-of-type:not(.essay-mid-cta *)::first-letter) {
  float: left;
  font-family: var(--font-display);
  font-size: 5em;
  line-height: 0.85;
  margin: 0.05em 0.08em -0.05em 0;
  color: var(--ink);
  font-style: italic;
}

/* Drop cap apres chaque hr = nouveau chapitre */
.essay-prose :global(hr + p::first-letter) {
  float: left;
  font-family: var(--font-display);
  font-size: 5em;
  line-height: 0.85;
  margin: 0.05em 0.08em -0.05em 0;
  color: var(--ink);
  font-style: italic;
}

.essay-prose :global(h2) {
  font-family: var(--font-sans);
  font-size: var(--text-h2);
  font-weight: var(--fw-medium);
  letter-spacing: -0.012em;
  line-height: 1.15;
  /* Rythme resserré : palier 40→56px (esprit --space-7/8) au lieu de 48→72px.
     Supprime les bandes mortes des contenus courts (cookbooks : 1 phrase/section)
     sans tasser les essais longs (h2 28-40px → 40-56px reste aéré). */
  margin: var(--space-8) 0 var(--space-5);
  color: var(--ink);
  max-width: 880px;
  text-wrap: balance;
}
.essay-prose :global(h2)::before {
  content: '§';
  display: inline-block;
  margin-right: 0.4em;
  color: var(--accent-text);
  font-style: normal;
  font-family: var(--font-mono);
  font-size: 0.6em;
  vertical-align: 0.2em;
  letter-spacing: 0;
}
.essay-prose :global(h2 i) { font-style: italic; color: var(--accent-text); }
.essay-prose :global(h3) {
  font-family: var(--font-sans);
  font-size: var(--text-h3);
  font-weight: var(--fw-medium);
  margin: var(--space-8) 0 var(--space-4);
  line-height: 1.2;
}
.essay-prose :global(p:not(.essay-mid-cta *)) { margin: 0 0 1.4em; }
/* Bande CTA de milieu : hors des règles de prose (lettrine, liens soulignés, marges de p,
   exclues par :not(.essay-mid-cta *)) ; la boîte suit la colonne de lecture. */
.essay-mid-cta { margin: var(--space-6) 0 var(--space-7); }
.essay-mid-cta :global(.wrap-wide) { padding-inline: 0; max-width: none; }

.essay-prose :global(blockquote) {
  border-left: 2px solid var(--ink-2);
  padding: var(--space-3) 0 var(--space-3) var(--space-5);
  margin: var(--space-7) 0;
  font-family: var(--font-sans);
  font-size: var(--text-h3);
  line-height: 1.45;
  font-weight: var(--fw-medium);
  color: var(--ink-2);
  max-width: 640px;
}
.essay-prose :global(blockquote p:last-child) {
  margin: var(--space-3) 0 0;
  font-size: var(--text-small);
  font-family: var(--font-mono);
  text-transform: uppercase;
  letter-spacing: var(--tracking-mono-tight);
  color: var(--muted);
  font-style: normal;
}

.essay-prose :global(a:not(.essay-mid-cta *)) {
  color: var(--ink);
  background-image: linear-gradient(var(--accent), var(--accent));
  background-size: 100% 1px;
  background-repeat: no-repeat;
  background-position: 0 100%;
  text-decoration: none;
  padding-bottom: 1px;
  transition: background-size 120ms var(--ease);
}
.essay-prose :global(a:not(.essay-mid-cta *):hover) {
  background-size: 100% 2px;
}

.essay-prose :global(code) {
  font-family: var(--font-mono);
  font-size: 0.85em;
  background: var(--paper-2);
  padding: 2px var(--space-2);
  border-radius: var(--radius-sm);
  border: 1px solid var(--hairline);
}

.essay-prose :global(pre) {
  overflow-x: auto;
  max-width: 100%;
}

.essay-prose :global(ul),
.essay-prose :global(ol) {
  margin: 0 0 1.4em 1.5em;
  max-width: 640px;
}
/* Listes du corps : mêmes taille et couleur que les paragraphes, puces visibles (le reset
   global retire les marqueurs et les listes héritaient de la taille « small » du conteneur). */
.essay-prose :global(ul) { list-style: disc; }
.essay-prose :global(ol) { list-style: decimal; }
.essay-prose :global(li) { margin-bottom: 0.4em; font-size: var(--text-body); line-height: var(--leading-body); }
.essay-prose :global(li)::marker { color: var(--accent-text); }

.essay-prose :global(hr) {
  border: none;
  height: 1px;
  background: var(--hairline-strong);
  margin: var(--space-9) 0;
  width: 100%;
}

/* ── Aside sources ────────────────────────────────────── */
.essay-sources {
  position: sticky;
  top: var(--space-11);
  align-self: start;
  padding-left: var(--space-5);
  border-left: 1px solid var(--hairline-strong);
}
.essay-sources-label {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--text-small);
  text-transform: uppercase;
  letter-spacing: var(--tracking-mono);
  color: var(--muted);
  margin-bottom: var(--space-4);
}
.essay-sources-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.essay-source-item {
  padding: 10px 0;
  border-bottom: 1px solid var(--hairline);
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}
.essay-source-item:last-child { border-bottom: none; }
.essay-source-link {
  font-family: var(--font-mono);
  font-size: var(--text-small);
  color: var(--ink);
  text-decoration: underline;
  text-underline-offset: 3px;
  word-break: break-word;
}
.essay-source-link:hover { color: var(--accent-text); }
.essay-source-type {
  font-family: var(--font-mono);
  font-size: var(--text-small);
  text-transform: uppercase;
  letter-spacing: var(--tracking-mono-tight);
  color: var(--muted);
}

.essay-related-cross {
  margin: var(--space-8, 3rem) 0;
  padding-top: var(--space-6, 2rem);
  border-top: 1px solid var(--hairline-strong, rgba(var(--ink-rgb), 0.18));
}
.essay-related-cross__title {
  font-family: var(--font-mono);
  font-size: var(--text-small);
  letter-spacing: var(--tracking-mono-tight);
