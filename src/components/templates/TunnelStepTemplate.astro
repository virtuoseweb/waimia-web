---
import HeroTunnelStep from '../sections/HeroTunnelStep.astro';
import TunnelStepNav from '../sections/TunnelStepNav.astro';

interface Props {
  offre_slug: string;
  offre_label: string;
  step: number;
  progress_total: number;
  step_title_fr: string;
  step_title_en: string;
  description_fr: string;
  description_en: string;
  next_step?: string;
  prev_step?: string;
  cta_label_fr: string;
  cta_label_en: string;
  cta_href: string;
  cta_variant?: 'primary' | 'accent' | 'ghost';
  lang: 'fr' | 'en';
}

const {
  offre_slug,
  offre_label,
  step,
  progress_total,
  step_title_fr,
  step_title_en,
  description_fr,
  description_en,
  prev_step,
  cta_label_fr,
  cta_label_en,
  cta_href,
  cta_variant = 'primary',
  lang,
} = Astro.props;

const back_href = `/offres/${offre_slug}`;
const prev_href = prev_step ? `/offres/${offre_slug}/tunnel/${step - 1}` : undefined;
const next_href = cta_href;
const isFr = lang === 'fr';
const padStep = (n: number) => String(n).padStart(2, '0');
const railSteps = Array.from({ length: progress_total }, (_, i) => i + 1);
---

<article class="tunnel-template">
  <HeroTunnelStep
    data={{
      type: 'tunnel-step-hero',
      offre_label,
      step,
      progress_total,
      h1_fr: step_title_fr,
      h1_en: step_title_en,
      lede_fr: description_fr,
      lede_en: description_en,
    }}
    lang={lang}
  />

  <div class="tnl-body wrap-wide">
    <div class="tnl-layout">
      <section class="tnl-prose">
        <slot />
      </section>

      <aside class="tnl-rail">
        <div class="tnl-rail__inner">
          <span class="tnl-rail__gauge">{padStep(step)}<span class="tnl-rail__gauge-sep">/</span>{padStep(progress_total)}</span>
          <span class="tnl-rail__offre">{offre_label}</span>
          <ol class="tnl-rail__steps" aria-label={isFr ? `Progression : étape ${step} sur ${progress_total}` : `Progress: step ${step} of ${progress_total}`}>
            {railSteps.map((n) => (
              <li
                class:list={['tnl-rail__step', n === step && 'is-current', n < step && 'is-done']}
                aria-current={n === step ? 'step' : undefined}
              >
                <span class="tnl-rail__step-num">{padStep(n)}</span>
              </li>
            ))}
          </ol>
          <a href={next_href} class="tnl-rail__cta">{isFr ? cta_label_fr : cta_label_en}</a>
          <span class="tnl-rail__reading">{isFr ? 'Lecture · 2 min' : 'Read · 2 min'}</span>
        </div>
      </aside>
    </div>
  </div>

  <TunnelStepNav
    data={{
      type: 'tunnel-step-nav',
      prev_href,
      prev_label_fr: '← Étape précédente',
      prev_label_en: '← Previous step',
      cta: {
        label_fr: cta_label_fr,
        label_en: cta_label_en,
        href: cta_href,
        variant: cta_variant,
      },
      reading_fr: 'Temps de lecture : 2 min',
      reading_en: '2 min read',
      back_href,
      back_label: `← ${offre_label}`,
    }}
    lang={lang}
  />
</article>

<style>
/* ── Layout ── */
.tunnel-template { padding-block: 0; }
.wrap-wide { max-width: 1200px; margin-inline: auto; padding-inline: var(--gut); }

/* ── Body (prose riche — reste dans le template, hybride intentionnel) ── */
/* Le hero porte déjà un padding-bottom + un margin-bottom de lede importants :
   le top du body est donc resserré pour supprimer le vide hero→hr (~250 px). */
.tnl-body {
  padding-top: var(--space-7);
  padding-bottom: clamp(48px, 6vw, 80px);
  border-top: 1px solid var(--hairline);
}

/* ── Layout éditorial 2 colonnes (prose + rail meta sticky à droite) ── */
.tnl-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 232px;
  gap: clamp(40px, 5vw, 88px);
  align-items: start;
}
.tnl-prose { max-width: var(--wrap-prose); min-width: 0; }

/* ── Rail meta (composition-only · reprend l'idiome progress du hero) ── */
.tnl-rail { min-width: 0; }
.tnl-rail__inner {
  position: sticky;
  top: calc(var(--header-height, 72px) + var(--space-6));
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-4);
  padding-left: var(--space-5);
  border-left: 1px solid var(--hairline-strong);
}
.tnl-rail__gauge {
  font-family: var(--font-display);
  font-size: clamp(40px, 4.5vw, 56px);
  line-height: 0.9;
  letter-spacing: -.02em;
  color: var(--ink);
}
.tnl-rail__gauge-sep { color: var(--muted); }
.tnl-rail__offre {
  font-family: var(--font-mono);
  font-size: var(--text-mono-xs);
  letter-spacing: var(--tracking-mono);
  text-transform: uppercase;
  color: var(--muted);
}
.tnl-rail__steps {
  list-style: none;
  margin: var(--space-2) 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  width: 100%;
}
.tnl-rail__step {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}
.tnl-rail__step::before {
  content: '';
  width: 18px;
  height: 1px;
  background: var(--hairline-strong);
  flex: none;
}
.tnl-rail__step.is-current::before,
.tnl-rail__step.is-done::before { background: var(--accent); }
.tnl-rail__step-num {
  font-family: var(--font-mono);
  font-size: var(--text-eyebrow);
  letter-spacing: .06em;
  color: var(--muted);
}
.tnl-rail__step.is-done .tnl-rail__step-num { color: var(--ink); }
.tnl-rail__step.is-current .tnl-rail__step-num { color: var(--accent); font-weight: var(--fw-semibold); }
.tnl-rail__cta {
  margin-top: var(--space-3);
  font-family: var(--font-sans);
  font-size: var(--text-body-sm);
  font-weight: var(--fw-semibold);
  color: var(--ink);
  text-decoration: none;
  border-bottom: 1px solid var(--accent);
  padding-bottom: 3px;
  transition: color .15s var(--ease);
}
.tnl-rail__cta:hover { color: var(--accent); }
.tnl-rail__reading {
  font-family: var(--font-mono);
  font-size: var(--text-mono-xs);
  letter-spacing: var(--tracking-mono);
  text-transform: uppercase;
  color: var(--muted);
}

@media (max-width: 900px) {
  .tnl-layout { grid-template-columns: 1fr; gap: var(--space-7); }
  .tnl-rail { order: -1; }
  .tnl-rail__inner {
    position: static;
    flex-flow: row wrap;
    align-items: center;
    gap: var(--space-4) var(--space-5);
    padding-left: 0;
    padding-bottom: var(--space-5);
    border-left: none;
    border-bottom: 1px solid var(--hairline-strong);
  }
  .tnl-rail__gauge { font-size: clamp(32px, 9vw, 44px); }
  .tnl-rail__steps { flex-flow: row wrap; width: auto; margin-top: 0; gap: var(--space-3); }
  .tnl-rail__step::before { width: 12px; }
  .tnl-rail__cta { margin-top: 0; }
  .tnl-prose { max-width: none; }
}
.tnl-body :global(h2) {
  font-family: var(--font-sans);
  font-weight: var(--fw-medium);
  font-size: var(--text-h2-section);
  line-height: var(--leading-h3);
  letter-spacing: -.01em;
  color: var(--ink);
  margin-bottom: var(--space-6);
}
.tnl-body :global(h3) {
  font-family: var(--font-sans);
  font-weight: var(--fw-medium);
  font-size: var(--text-h3-row);
  line-height: 1.25;
  color: var(--ink);
  margin-bottom: var(--space-5);
}
.tnl-body :global(p) {
  font-family: var(--font-sans);
  font-size: clamp(15px, 1.4vw, 17px);
  line-height: 1.7;
  color: var(--ink);
  max-width: 68ch;
  margin-bottom: var(--space-5);
}
.tnl-body :global(strong) { font-weight: var(--fw-semibold); }
.tnl-body :global(em) { font-family: var(--font-display); font-weight: var(--fw-regular); font-style: italic; }
.tnl-body :global(ul) {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}
.tnl-body :global(ul li) {
  font-family: var(--font-sans);
  font-size: clamp(14px, 1.3vw, 16px);
  color: var(--ink);
  padding-left: var(--space-6);
  position: relative;
  line-height: var(--leading-relaxed);
}
.tnl-body :global(ul li::before) {
  content: '';
  position: absolute;
  left: 2px;
  top: 0.7em;
  width: 5px;
  height: 5px;
  border-radius: var(--radius-full);
  background: var(--accent);
}
.tnl-body :global(blockquote) {
  border-left: 2px solid var(--accent);
  padding: var(--space-5) var(--space-6);
  margin: var(--space-7) 0;
  background: rgba(var(--accent-rgb), .04);
  font-family: var(--font-display);
  font-size: clamp(16px, 1.8vw, 20px);
  font-style: italic;
  color: var(--ink);
  line-height: var(--leading-body);
}
.tnl-body :global(hr) {
  border: none;
  border-top: 1px solid var(--hairline);
  margin-block: var(--space-7);
}
.tnl-body :global(table) {
  width: 100%;
  border-collapse: collapse;
  font-family: var(--font-sans);
  font-size: clamp(13px, 1.2vw, 15px);
  margin-bottom: var(--space-6);
}
.tnl-body :global(th) {
  font-family: var(--font-mono);
  font-size: var(--text-eyebrow);
  letter-spacing: .06em;
  text-transform: uppercase;
  color: var(--muted);
  border-bottom: 1px solid var(--hairline);
  padding: var(--space-3) var(--space-4);
  text-align: left;
}
.tnl-body :global(td) {
  color: var(--ink);
  border-bottom: 1px solid var(--hairline);
  padding: var(--space-3) var(--space-4);
  line-height: var(--leading-body);
}
</style>
