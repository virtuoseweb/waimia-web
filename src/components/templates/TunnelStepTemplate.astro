---
import HeroTunnelStep from '../sections/HeroTunnelStep.astro';
import TunnelStepNav from '../sections/TunnelStepNav.astro';

interface Props {
  offre_slug: string;
  offre_label: string;
  step: number;
  progress_total: number;
  step_title_fr: string;
  step_title_en: string;
  description_fr: string;
  description_en: string;
  next_step?: string;
  prev_step?: string;
  cta_label_fr: string;
  cta_label_en: string;
  cta_href: string;
  cta_variant?: 'primary' | 'accent' | 'ghost';
  lang: 'fr' | 'en';
}

const {
  offre_slug,
  offre_label,
  step,
  progress_total,
  step_title_fr,
  step_title_en,
  description_fr,
  description_en,
  prev_step,
  cta_label_fr,
  cta_label_en,
  cta_href,
  cta_variant = 'primary',
  lang,
} = Astro.props;

const back_href = `/offres/${offre_slug}`;
const prev_href = prev_step ? `/offres/${offre_slug}/tunnel/${step - 1}` : undefined;
---

<article class="tunnel-template">
  <HeroTunnelStep
    data={{
      type: 'tunnel-step-hero',
      offre_label,
      step,
      progress_total,
      h1_fr: step_title_fr,
      h1_en: step_title_en,
      lede_fr: description_fr,
      lede_en: description_en,
    }}
    lang={lang}
  />

  <section class="tnl-body wrap-wide">
    <slot />
  </section>

  <TunnelStepNav
    data={{
      type: 'tunnel-step-nav',
      prev_href,
      prev_label_fr: '← Étape précédente',
      prev_label_en: '← Previous step',
      cta: {
        label_fr: cta_label_fr,
        label_en: cta_label_en,
        href: cta_href,
        variant: cta_variant,
      },
      reading_fr: 'Temps de lecture : 2 min',
      reading_en: '2 min read',
      back_href,
      back_label: `← ${offre_label}`,
    }}
    lang={lang}
  />
</article>

<style>
/* ── Layout ── */
.tunnel-template { padding-block: 0; }
.wrap-wide { max-width: 1200px; margin-inline: auto; padding-inline: var(--gut); }

/* ── Body (prose riche — reste dans le template, hybride intentionnel) ── */
.tnl-body {
  padding-block: clamp(48px, 6vw, 80px);
  border-top: 1px solid var(--hairline);
}
.tnl-body :global(h2) {
  font-family: var(--font-display);
  font-size: var(--text-h2-section);
  line-height: var(--leading-h3);
  letter-spacing: -.01em;
  color: var(--ink);
  margin-bottom: var(--space-6);
}
.tnl-body :global(h3) {
  font-family: var(--font-display);
  font-size: var(--text-h3-row);
  line-height: 1.25;
  color: var(--ink);
  margin-bottom: var(--space-5);
}
.tnl-body :global(p) {
  font-family: var(--font-sans);
  font-size: clamp(15px, 1.4vw, 17px);
  line-height: 1.7;
  color: var(--ink);
  max-width: 68ch;
  margin-bottom: var(--space-5);
}
.tnl-body :global(strong) { font-weight: var(--fw-semibold); }
.tnl-body :global(em) { font-style: italic; }
.tnl-body :global(ul) {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}
.tnl-body :global(ul li) {
  font-family: var(--font-sans);
  font-size: clamp(14px, 1.3vw, 16px);
  color: var(--ink);
  padding-left: var(--space-6);
  position: relative;
  line-height: 1.6;
}
.tnl-body :global(ul li::before) {
  content: '·';
  position: absolute;
  left: 0;
  font-family: var(--font-mono);
  color: var(--muted);
  font-size: var(--text-eyebrow);
  top: 3px;
}
.tnl-body :global(blockquote) {
  border-left: 2px solid var(--accent);
  padding: var(--space-5) var(--space-6);
  margin: var(--space-7) 0;
  background: rgba(var(--accent-rgb), .04);
  font-family: var(--font-display);
  font-size: clamp(16px, 1.8vw, 20px);
  font-style: italic;
  color: var(--ink);
  line-height: var(--leading-body);
}
.tnl-body :global(hr) {
  border: none;
  border-top: 1px solid var(--hairline);
  margin-block: var(--space-7);
}
.tnl-body :global(table) {
  width: 100%;
  border-collapse: collapse;
  font-family: var(--font-sans);
  font-size: clamp(13px, 1.2vw, 15px);
  margin-bottom: var(--space-6);
}
.tnl-body :global(th) {
  font-family: var(--font-mono);
  font-size: var(--text-eyebrow);
  letter-spacing: .06em;
  text-transform: uppercase;
  color: var(--muted);
  border-bottom: 1px solid var(--hairline);
  padding: var(--space-3) var(--space-4);
  text-align: left;
}
.tnl-body :global(td) {
  color: var(--ink);
  border-bottom: 1px solid var(--hairline);
  padding: var(--space-3) var(--space-4);
  line-height: var(--leading-body);
}
</style>
