---
/**
 * TechnologiesDetailTemplate · sub-page Technologies (focus stack architecture)
 *
 * Sections (6 fixes + 2 conditionnelles) sémantiquement différenciées de Offres/Solutions :
 *   1. Hero Layer · breadcrumb + badge COUCHE coloré (claude/os/orch) + h1 + lead italique + meta + SVG triangles
 *   2. Positioning Split · "Pourquoi X" — split 50/50 statement éditorial + 3 facts mono kv
 *   3. Capabilities Grid · 3×2 cards (kicker + h3 + p + value signature)
 *   4. Models Comparison Table (CONDITIONNEL showModels) · 5 colonnes (modèle / profil / coût / contexte / usages)
 *   5. When To Use Dual · split "Utiliser quand" / "Considérer autre chose quand"
 *   6. Integration Flow · 5 nœuds horizontaux avec 1 actif
 *   7. Ecosystem Grid (CONDITIONNEL showEcosystem) · 4 cards éditeurs open-source (uniquement layerType=os)
 *   8. CTA dark · "Quelle stack pour votre contexte ?"
 *
 * Briques signature : Positioning Split (prise de position), When To Use Dual (aide décision rare), Integration Flow.
 * Géométrie hero : triangles SVG (Offres=cercles, Solutions=rect-rotated, Technologies=triangles).
 * Source handoff : project/pages/technologies/detail.html (lignes 162-298, dict TECHNOLOGIES).
 *
 * Usage minimal (props) :
 *   <TechnologiesDetailTemplate
 *     layer="COUCHE MODÈLES"
 *     layerLabel="Claude Models"
 *     layerType="claude"
 *     showModels={true}
 *     meta="Anthropic · Claude-first"
 *     title="Claude Models · Waimia"
 *     description="Haiku, Sonnet, Opus, Code — un modèle par profil de tâche."
 *   >
 *     <Fragment slot="title"><i>Claude</i><br/>Models</Fragment>
 *     <Fragment slot="lead">Lead html...</Fragment>
 *     ... etc
 *   </TechnologiesDetailTemplate>
 */
import Base from '../../layouts/Base.astro';
import Callout from '../editorial/Callout.astro';
import KeyMetric from '../editorial/KeyMetric.astro';
import Timeline from '../editorial/Timeline.astro';
import EditorialTable from '../editorial/EditorialTable.astro';
import Dingbat from '../editorial/Dingbat.astro';
import Breadcrumb from '../ui/molecules/Breadcrumb.astro';
import Kicker from '../ui/atoms/Kicker.astro';
import { langFromPath } from '../../lib/i18n';
import { buildService } from '../../lib/seo/schema-builder';
import HeroOfferDetail from '../sections/HeroOfferDetail.astro';
import type { SectionByType } from '../../schemas/sections';

interface Props {
  /** SEO meta · title de la page */
  title: string;
  /** SEO meta · description */
  description: string;
  /** Pas d'index (pages WIP) — forwardé à Base */
  noindex?: boolean;
  /** Badge couche (kicker au-dessus du h1) ex: "COUCHE MODÈLES" */
  layer: string;
  /** Label du breadcrumb second segment ex: "Claude Models" */
  layerLabel: string;
  /** Type de couche — détermine la couleur du badge : claude (orange) / os (vert) / orch (bleu) */
  layerType?: 'claude' | 'os' | 'orch';
  /** Affiche la table de comparaison des modèles (default false, généralement true pour layerType=claude) */
  showModels?: boolean;
  /** Affiche la grille écosystème (default false, généralement true pour layerType=os) */
  showEcosystem?: boolean;
  /** Meta sous le CTA hero ex: "Anthropic · Claude-first" */
  meta?: string;
  /** Href du CTA hero (default /contact) */
  ctaHref?: string;
  /** Label du CTA hero (default "Parler architecture →") */
  ctaLabel?: string;
  capabilitiesData?: Array<{ name_fr: string; name_en: string; description_fr: string; description_en: string; status: 'active' | 'beta' | 'planned' }>;
  modelsData?: Array<{ name: string; version: string; use_case_fr: string; use_case_en: string }>;
  integrationData?: Array<{ num: string; label_fr: string; label_en: string; body_fr: string; body_en: string }>;
  benchmarksData?: Array<{ value: string; label_fr: string; label_en: string }>;
}

const {
  title,
  description,
  noindex = false,
  layer,
  layerLabel,
  layerType = 'claude',
  showModels = false,
  showEcosystem = false,
  meta = '',
  ctaHref = '/contact',
  ctaLabel = 'Parler architecture →',
  capabilitiesData,
  modelsData,
  integrationData,
  benchmarksData,
} = Astro.props;

const lang = langFromPath(Astro.url.pathname);
const pageTransitionId = Astro.url.pathname
  .replace(/^\/(?:en\/)?/, '')
  .replace(/\/$/, '')
  .replace(/[^a-z0-9]+/gi, '-')
  .replace(/^-|-$/g, '') || 'home';
const renderFirstSlot = async (names: string[]) => {
  for (const name of names) {
    if (Astro.slots.has(name)) {
      return (await Astro.slots.render(name)) ?? '';
    }
  }

  return '';
};

const positioningStatementHtml = await renderFirstSlot(['positioning-statement']);
const capabilitiesHtml = await renderFirstSlot(['capabilities-grid', 'capabilities']);
const modelsRowsHtml = await renderFirstSlot(['models-rows']);
const whenUseHtml = await renderFirstSlot(['when-to-use', 'when-use']);
const whenAvoidHtml = await renderFirstSlot(['when-not-to-use', 'when-avoid']);
const integrationHtml = await renderFirstSlot(['integration-flow', 'integration-nodes']);
const ecosystemHtml = await renderFirstSlot(['ecosystem-grid', 'ecosystem']);
const heroTitleHtml = ((await renderFirstSlot(['title'])).trim()) || title;
const heroLeadHtml = ((await renderFirstSlot(['lead'])).trim()) || description;
const heroData = {
  type: 'hero-tech-layer',
  layer_type: layerType,
  layer_label_fr: layer,
  layer_label_en: layer,
  h1_fr: heroTitleHtml,
  h1_en: heroTitleHtml,
  lead_fr: heroLeadHtml,
  lead_en: heroLeadHtml,
  cta: { href: ctaHref, label_fr: ctaLabel, label_en: ctaLabel, variant: 'primary' as const },
  meta_fr: meta || undefined,
  meta_en: meta || undefined,
} satisfies SectionByType<'hero-tech-layer'>;

const stripHtml = (html: string) =>
  html
    .replace(/<br\s*\/?>/gi, ' ')
    .replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const extract = (html: string, selectorClass: string) => {
  const match = html.match(new RegExp(`<[^>]*class=["'][^"']*${selectorClass}[^"']*["'][^>]*>([\\s\\S]*?)<\\/[^>]+>`, 'i'));
  return match ? stripHtml(match[1] ?? '') : '';
};

const extractTag = (html: string, tag: string) => {
  const match = html.match(new RegExp(`<${tag}[^>]*>([\\s\\S]*?)<\\/${tag}>`, 'i'));
  return match ? stripHtml(match[1] ?? '') : '';
};

const splitBlocks = (html: string, selectorClass: string) =>
  html
    .split(new RegExp(`<[^>]*class=["'][^"']*${selectorClass}[^"']*["'][^>]*>`, 'i'))
    .slice(1);

const capabilities =
  capabilitiesData && capabilitiesData.length > 0
    ? capabilitiesData.map((item) => ({
        kicker: item.status,
        title: lang === "fr" ? item.name_fr : item.name_en,
        body: lang === "fr" ? item.description_fr : item.description_en,
        value: item.status,
      }))
    : splitBlocks(capabilitiesHtml, "cap-card")
        .map((block) => ({
          kicker: extract(block, "cap-ck") || extract(block, "kicker"),
          title: extractTag(block, "h3"),
          body: extractTag(block, "p"),
          value: extract(block, "cap-v") || extract(block, "cap-value"),
        }))
        .filter((item) => item.title && item.body);

const modelRows =
  modelsData && modelsData.length > 0
    ? modelsData.map((m) => [
        m.name,
        m.version,
        "",
        "",
        lang === "fr" ? m.use_case_fr : m.use_case_en,
      ])
    : Array.from(modelsRowsHtml.matchAll(/<tr[^>]*>([\s\S]*?)<\/tr>/gi))
        .map((rowMatch) =>
          Array.from(
            (rowMatch[1] ?? "").matchAll(/<td[^>]*>([\s\S]*?)<\/td>/gi),
          ).map((cellMatch) => stripHtml(cellMatch[1] ?? "")),
        )
        .filter((row) => row.length > 0);

const integrationEvents = splitBlocks(integrationHtml, "flow-node")
  .map((block) => ({
    num: extract(block, "flow-layer").split("·")[0]?.trim(),
    meta: extract(block, "flow-layer").split("·").slice(1).join("·").trim(),
    title: extractTag(block, "h3"),
    body: extract(block, "flow-body") || extractTag(block, "p"),
    variant: /flow-node--active/.test(block)
      ? ("highlight" as const)
      : ("default" as const),
  }))
  .filter((event) => event.title && event.body);

const placeholderIntegrationEvents = splitBlocks(integrationHtml, "node")
  .map((block) => ({
    num: extract(block, "node-k"),
    title: extract(block, "node-l"),
    body: "Phase de cadrage architecture Waimia.",
    variant: "default" as const,
  }))
  .filter((event) => event.title);

const timelineEvents =
  integrationData && integrationData.length > 0
    ? integrationData.map((item) => ({
        num: item.num,
        meta: lang === "fr" ? item.label_fr : item.label_en,
        title: lang === "fr" ? item.label_fr : item.label_en,
        body: lang === "fr" ? item.body_fr : item.body_en,
        variant: "default" as const,
      }))
    : integrationEvents.length > 0
      ? integrationEvents
      : placeholderIntegrationEvents;

const serviceLd = buildService({ name: title, description });
---
<Base {title} {description} {noindex} jsonLd={[serviceLd]}>
    <Breadcrumb
      lang={lang}
      items={[
        { label: lang === 'fr' ? 'Accueil' : 'Home', href: lang === 'fr' ? '/' : '/en' },
        { label: lang === 'fr' ? 'Technologies' : 'Technologies', href: lang === 'fr' ? '/technologies' : '/en/technologies' },
        { label: layerLabel },
      ]}
    />
    {/* ────────── 1. HERO LAYER ────────── */}
    <HeroOfferDetail
      data={heroData}
      lang={lang}
      transitionId={pageTransitionId}
      cardTransitionId={pageTransitionId}
      wrapMax="1240px"
      geoReveal={true}
    />

    {/* ────────── 2. POSITIONING SPLIT (signature) ────────── */}
    <section class="tech-sec tech-sec-paper tech-positioning reveal-stagger" data-screen-label="02 Positioning">
      <div class="wrap">
        <div class="tech-pos-split">
          <div class="tech-pos-left">
            <Kicker>Position Waimia</Kicker>
            <h2 class="tech-pos-title"><slot name="positioning-title" /></h2>
            <p class="tech-aside"><slot name="positioning-aside" /></p>
          </div>
          <div class="tech-pos-right">
            <Callout variant="manifesto" size="lg">
              <div class="tech-pos-statement" set:html={positioningStatementHtml} />
            </Callout>
            <div class="tech-pos-facts"><slot name="positioning-facts" /></div>
          </div>
        </div>
      </div>
    </section>

    {/* ────────── 3. CAPABILITIES GRID ────────── */}
    <section class="tech-sec" data-screen-label="03 Capabilities">
      <div class="wrap">
        <div class="tech-sec-hd">
          <div>
            <Kicker>Capacités</Kicker>
            <h2><slot name="capabilities-title"><i>Inventaire</i><br/>technique</slot></h2>
          </div>
          <p class="tech-aside"><slot name="capabilities-aside" /></p>
        </div>
        <div class="tech-cap-table-wrap reveal-stagger">
          {capabilities.length > 0 ? (
            <table class="tt-specs">
              <thead>
                <tr>
                  <th scope="col">Capacité</th>
                  <th scope="col">Description</th>
                  <th scope="col">Statut</th>
                </tr>
              </thead>
              <tbody>
                {capabilities.map((item) => (
                  <tr>
                    <td class="tt-spec-name">{item.title}</td>
                    <td class="tt-spec-desc">{item.body}</td>
                    <td class="tt-spec-status">{item.value || item.kicker}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
            <Fragment set:html={capabilitiesHtml} />
          )}
        </div>
      </div>
    </section>

    {/* ────────── 4. MODELS COMPARISON TABLE (conditionnel) ────────── */}
    {showModels && (
      <section class="tech-sec tech-sec-paper" data-screen-label="04 Models">
        <div class="wrap">
          <div class="tech-sec-hd">
            <div>
              <Kicker>Choisir le bon modèle</Kicker>
              <h2><slot name="models-title"><i>Modèles</i><br/>disponibles</slot></h2>
            </div>
            <p class="tech-aside"><slot name="models-aside" /></p>
          </div>
          <div class="tech-models-table-wrap reveal-stagger">
            {modelRows.length > 0 ? (
              <EditorialTable
                columns={['Modèle', 'Profil', 'Coût', 'Contexte', 'Usages']}
                rows={modelRows}
                caption="Modèles Claude · profil de tâche"
                variant="editorial"
              />
            ) : (
              <table class="tech-models-table">
                <caption>Modèles Claude · profil de tâche</caption>
                <thead>
                  <tr>
                    <th scope="col">Modèle</th>
                    <th scope="col">Profil</th>
                    <th scope="col">Coût</th>
                    <th scope="col">Contexte</th>
                    <th scope="col">Usages</th>
                  </tr>
                </thead>
                <tbody set:html={modelsRowsHtml} />
              </table>
            )}
          </div>
        </div>
      </section>
    )}

    {/* ────────── 5. WHEN TO USE DUAL (signature) ────────── */}
    <section class="tech-sec" data-screen-label="05 When To Use">
      <div class="wrap">
        <div class="tech-sec-hd">
          <div>
            <Kicker>Aide décision</Kicker>
            <h2><slot name="when-title"><i>Quand</i><br/>l'utiliser ?</slot></h2>
          </div>
          <p class="tech-aside"><slot name="when-aside" /></p>
        </div>
        <div class="tech-when-dual reveal-stagger">
          <div class="tech-when-col tech-when-col--use">
            <Kicker class="tech-when-kicker">Utiliser quand</Kicker>
            <ul class="tech-when-list tech-when-list--use">
              <Fragment set:html={whenUseHtml} />
            </ul>
          </div>
          <div class="tech-when-col tech-when-col--avoid">
            <Kicker class="tech-when-kicker">Considérer autre chose quand</Kicker>
            <ul class="tech-when-list tech-when-list--avoid">
              <Fragment set:html={whenAvoidHtml} />
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ────────── 6. INTEGRATION FLOW (signature) ────────── */}
    <section class="tech-sec tech-sec-paper" data-screen-label="06 Integration">
      <div class="wrap">
        <div class="tech-sec-hd">
          <div>
            <Kicker>Position dans la stack</Kicker>
            <h2><slot name="integration-title"><i>Intégration</i></slot></h2>
          </div>
          <p class="tech-aside"><slot name="integration-aside" /></p>
        </div>
        <div class="tech-int-flow reveal-stagger">
          <Dingbat variant="section" size="sm" />
          {timelineEvents.length > 0 ? (
            <Timeline events={timelineEvents} orientation="vertical" numbered={true} />
          ) : (
            <Fragment set:html={integrationHtml} />
          )}
        </div>
      </div>
    </section>

    {/* ────────── 7. ECOSYSTEM GRID (conditionnel layerType=os) ────────── */}
    {showEcosystem && (
      <section class="tech-sec" data-screen-label="07 Ecosystem">
        <div class="wrap">
          <div class="tech-sec-hd">
            <div>
              <Kicker>Écosystème open-source</Kicker>
              <h2><slot name="ecosystem-title"><i>Éditeurs</i><br/>compatibles</slot></h2>
            </div>
            <p class="tech-aside"><slot name="ecosystem-aside" /></p>
          </div>
          <div class="tt-eco-wrap reveal-stagger">
            <div class="tt-eco-inline" set:html={ecosystemHtml} />
          </div>
        </div>
      </section>
    )}

    {/* ────────── 8. RELATED (optionnel) ────────── */}
    <slot name="related" />

    {/* ────────── 9. CTA ARCHITECTURE DARK ────────── */}
    <section class="tech-sec tech-sec-dark" data-screen-label="09 CTA">
      <div class="wrap wrap-tight">
        <div class="tech-cta-final">
          <h2><i><slot name="cta-title">Quelle stack<br/>pour votre<br/>contexte ?</slot></i></h2>
          <div class="tech-cta-body">
            <p><slot name="cta-body">Chaque déploiement Waimia commence par un choix technologique rigoureux : adapté à vos contraintes, pas à nos préférences.</slot></p>
            <div class="tech-cta-btns">
              <a class="btn-accent" href="/contact">Parler architecture →</a>
              <a class="btn-light" href="/technologies">Voir la stack complète</a>
            </div>
          </div>
        </div>
      </div>
    </section>
</Base>

<style>
  /* ───── Sec common ───── */
  .tech-sec { padding: clamp(72px, 8vw, 120px) 0; position: relative; }
  .tech-sec-paper { background: var(--paper-2); }
  .tech-sec-dark { background: var(--ink); color: var(--paper); }
  .tech-sec-dark :global(.kicker) { color: var(--accent); }
  .eyebrow {
    display: block;
    margin-bottom: 10px;
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .tech-sec-hd {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 4vw, 80px);
    margin-bottom: clamp(40px, 5vw, 64px);
    align-items: end;
  }
  .tech-sec-hd h2 {
    font-family: var(--font-sans);
    font-size: clamp(36px, 5vw, 72px);
    line-height: var(--leading-h1);
    letter-spacing: -0.018em;
    font-weight: var(--fw-medium);
    margin: var(--space-2) 0 0;
  }
  .tech-sec-hd :global(i) { font-family: var(--font-display); font-weight: var(--fw-regular); color: var(--accent); font-style: italic; }
  .tech-aside {
    font-family: var(--font-display);
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: var(--leading-body);
    color: var(--muted);
    font-style: italic;
    max-width: 480px;
    margin: 0;
  }

  /* ───── Positioning Split (signature) ───── */
  .tech-pos-split {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .tech-pos-right {
    position: relative;
    padding-left: clamp(24px, 3vw, 48px);
  }
  .tech-pos-right::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: var(--hairline-strong, rgba(var(--ink-rgb), 0.18));
  }
  .tech-pos-right :global(.callout) {
    margin-top: 0;
  }
  .tech-pos-title {
    font-family: var(--font-sans);
    font-size: clamp(36px, 5vw, 64px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    font-weight: var(--fw-medium);
    margin: var(--space-2) 0 var(--space-5);
  }
  .tech-pos-title :global(i) { font-family: var(--font-display); font-weight: var(--fw-regular); color: var(--accent); font-style: italic; }
  .tech-pos-statement {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 32px);
    line-height: 1.32;
    letter-spacing: -0.012em;
    color: var(--ink);
    font-style: italic;
    margin-bottom: 0;
    text-wrap: balance;
  }
  .tech-pos-statement :global(em) { font-family: var(--font-display); font-weight: var(--fw-regular); color: var(--accent); font-style: italic; }
  .tech-pos-facts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid rgba(var(--ink-rgb), 0.1);
  }
  .tech-pos-facts :global(.fact) {
    display: grid;
    grid-template-columns: minmax(140px, 1fr) auto 2fr;
    gap: var(--space-4) var(--space-5);
    padding: 18px 0;
    border-bottom: 1px solid rgba(var(--ink-rgb), 0.1);
    align-items: baseline;
  }
  .tech-pos-facts :global(.fact-k) {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .tech-pos-facts :global(.fact-v) {
    font-family: var(--font-display);
    font-size: clamp(18px, 1.8vw, 22px);
    color: var(--accent);
    line-height: 1;
    font-weight: var(--fw-regular);
    white-space: nowrap;
  }
  .tech-pos-facts :global(.fact-l) {
    font-family: var(--font-display);
    font-size: var(--text-body-sm);
    line-height: 1.45;
    color: var(--ink);
    font-style: italic;
  }

  /* ───── Models Comparison Table ───── */
  .tech-models-table-wrap {
    overflow-x: auto;
    border: 1px solid rgba(var(--ink-rgb), 0.1);
    border-radius: var(--radius-md);
    background: var(--paper);
    padding: clamp(18px, 3vw, 32px);
  }
  .tech-models-table-wrap :global(.ed-table-figure) { margin: 0; min-width: 760px; }
  .tech-models-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-body-sm);
  }
  .tech-models-table thead th {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
    text-align: left;
    padding: 18px 20px;
    border-bottom: 1px solid rgba(var(--ink-rgb), 0.1);
    font-weight: var(--fw-medium);
  }
  .tech-models-table tbody :global(td) {
    padding: 18px 20px;
    border-bottom: 1px solid rgba(var(--ink-rgb), 0.06);
    line-height: var(--leading-body);
    vertical-align: top;
  }
  .tech-models-table tbody :global(tr:last-child td) { border-bottom: none; }
  .tech-models-table tbody :global(.mdl-name) {
    font-family: var(--font-display);
    font-size: var(--text-body-md);
    color: var(--ink);
    font-weight: var(--fw-regular);
    white-space: nowrap;
  }
  .tech-models-table tbody :global(.mdl-badge) {
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    display: inline-block;
    background: rgba(var(--accent-rgb), 0.08);
    color: var(--accent);
    white-space: nowrap;
  }
  .tech-models-table tbody :global(.mdl-badge--speed) { background: rgba(var(--ink-rgb), 0.06); color: var(--ink); }
  .tech-models-table tbody :global(.mdl-badge--balance) { background: rgba(var(--accent-rgb), 0.08); color: var(--accent); }
  .tech-models-table tbody :global(.mdl-badge--power) { background: rgba(var(--accent-rgb), 0.08); color: var(--accent); }
  .tech-models-table tbody :global(.mdl-badge--code) { background: rgba(var(--ink-rgb), 0.06); color: var(--ink); }
  .tech-models-table tbody :global(.mdl-cost),
  .tech-models-table tbody :global(.mdl-ctx) {
    font-family: var(--font-mono);
    font-size: var(--text-ui);
    color: var(--ink);
