---
/**
 * TechnologiesDetailTemplate · sub-page Technologies (focus stack architecture)
 *
 * 100 % COMPOSABLE (lot 5a, fiche 0017) : chaque bloc est rendu par un composant
 * catalogué importé en interne + un data-builder `satisfies SectionByType<'...'>`
 * (même pattern que CaseStudyTemplate). Plus AUCUN markup/CSS de section inline :
 * le markup de chaque section vit dans son composant catalogué (source de vérité),
 * disponible depuis /agence/design-system + /library + DS Studio.
 *
 * Blocs → types catalogués :
 *   1. Masthead breadcrumb ............ masthead-bar        (MastheadBar)
 *   2. Hero Layer .................... hero-tech-layer     (HeroOfferDetail)
 *   3. Positioning Split (signature) . tech-positioning-split (TechPositioningSplit)
 *   4. Capabilities specs table ...... tech-capabilities-specs (TechCapabilitiesSpecs)
 *   5. Models table (cond. showModels) tech-models-table   (EditorialTableBlock)
 *   6. When To Use Dual (signature) .. tech-when-dual      (TechWhenDual)
 *   7. Integration Flow (signature) .. tech-integration-flow (TechIntegrationFlow)
 *   8. CTA architecture (dark) ....... department-cta      (CtaFinal)
 *
 * L'interface Props (slots + props structurées) est INCHANGÉE : les slots reçus
 * (cf src/pages/[...slug].astro) sont parsés en données structurées puis injectés
 * dans les data-builders. Contenu 100 % préservé (déplacement de markup, 0 réécriture).
 */
import Base from '../../layouts/Base.astro';
import MastheadBar from '../sections/MastheadBar.astro';
import HeroOfferDetail from '../sections/HeroOfferDetail.astro';
import TechPositioningSplit from '../sections/TechPositioningSplit.astro';
import TechCapabilitiesSpecs from '../sections/TechCapabilitiesSpecs.astro';
import EditorialTableBlock from '../sections/EditorialTableBlock.astro';
import TechWhenDual from '../sections/TechWhenDual.astro';
import TechIntegrationFlow from '../sections/TechIntegrationFlow.astro';
import CtaFinal from '../sections/CtaFinal.astro';
import { langFromPath } from '../../lib/i18n';
import { buildService } from '../../lib/seo/schema-builder';
import type { SectionByType } from '@waimia/ds-kernel';

interface Props {
  /** SEO meta · title de la page */
  title: string;
  /** SEO meta · description */
  description: string;
  /** Pas d'index (pages WIP), forwardé à Base */
  noindex?: boolean;
  /** Badge couche (kicker au-dessus du h1) ex: "COUCHE MODÈLES" */
  layer: string;
  /** Label du breadcrumb second segment ex: "Claude Models" */
  layerLabel: string;
  /** Type de couche : détermine la couleur du badge : claude (orange) / os (vert) / orch (bleu) */
  layerType?: 'claude' | 'os' | 'orch';
  /** Affiche la table de comparaison des modèles (default false, généralement true pour layerType=claude) */
  showModels?: boolean;
  /** Affiche la grille écosystème (default false), réservé, non rendu (aucune source de données catalogue). */
  showEcosystem?: boolean;
  /** Meta sous le CTA hero ex: "Anthropic · Claude-first" */
  meta?: string;
  /** Href du CTA hero (default /contact) */
  ctaHref?: string;
  /** Label du CTA hero (default "Parler architecture →") */
  ctaLabel?: string;
  capabilitiesData?: Array<{ name_fr: string; name_en: string; description_fr: string; description_en: string; status: 'active' | 'beta' | 'planned' }>;
  modelsData?: Array<{ name: string; version: string; use_case_fr: string; use_case_en: string }>;
  integrationData?: Array<{ num: string; label_fr: string; label_en: string; body_fr: string; body_en: string }>;
  benchmarksData?: Array<{ value: string; label_fr: string; label_en: string }>;
}

const {
  title,
  description,
  noindex = false,
  layer,
  layerLabel,
  layerType = 'claude',
  showModels = false,
  meta = '',
  ctaHref = '/contact',
  ctaLabel = 'Parler architecture →',
  capabilitiesData,
  modelsData,
  integrationData,
} = Astro.props;

const lang = langFromPath(Astro.url.pathname);
const pageTransitionId = Astro.url.pathname
  .replace(/^\/(?:en\/)?/, '')
  .replace(/\/$/, '')
  .replace(/[^a-z0-9]+/gi, '-')
  .replace(/^-|-$/g, '') || 'home';

const renderFirstSlot = async (names: string[]) => {
  for (const name of names) {
    if (Astro.slots.has(name)) {
      return (await Astro.slots.render(name)) ?? '';
    }
  }
  return '';
};

const stripHtml = (html: string) =>
  html
    .replace(/<br\s*\/?>/gi, ' ')
    .replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const extractTag = (html: string, tag: string) => {
  const match = html.match(new RegExp(`<${tag}[^>]*>([\\s\\S]*?)<\\/${tag}>`, 'i'));
  return match ? stripHtml(match[1] ?? '') : '';
};

const extract = (html: string, selectorClass: string) => {
  const match = html.match(new RegExp(`<[^>]*class=["'][^"']*${selectorClass}[^"']*["'][^>]*>([\\s\\S]*?)<\\/[^>]+>`, 'i'));
  return match ? stripHtml(match[1] ?? '') : '';
};

const splitBlocks = (html: string, selectorClass: string) =>
  html
    .split(new RegExp(`<[^>]*class=["'][^"']*${selectorClass}[^"']*["'][^>]*>`, 'i'))
    .slice(1);

/** Toutes les valeurs d'une classe donnée, dans l'ordre du document. */
const extractAll = (html: string, selectorClass: string) =>
  Array.from(
    html.matchAll(new RegExp(`class=["'][^"']*${selectorClass}[^"']*["'][^>]*>([\\s\\S]*?)<\\/`, 'gi')),
  ).map((m) => stripHtml(m[1] ?? ''));

const extractListItems = (html: string) =>
  Array.from(html.matchAll(/<li[^>]*>([\s\S]*?)<\/li>/gi)).map((m) => stripHtml(m[1] ?? ''));

const asStatus = (s: string): 'active' | 'beta' | 'planned' =>
  s === 'active' || s === 'beta' || s === 'planned' ? s : 'planned';

// ── Slots hero (déjà composable via HeroOfferDetail / hero-tech-layer) ──────────
const heroTitleHtml = ((await renderFirstSlot(['title'])).trim()) || title;
const heroLeadHtml = ((await renderFirstSlot(['lead'])).trim()) || description;
const heroData = {
  type: 'hero-tech-layer',
  layer_type: layerType,
  layer_label_fr: layer,
  layer_label_en: layer,
  h1_fr: heroTitleHtml,
  h1_en: heroTitleHtml,
  lead_fr: heroLeadHtml,
  lead_en: heroLeadHtml,
  cta: { href: ctaHref, label_fr: ctaLabel, label_en: ctaLabel, variant: 'primary' as const },
  meta_fr: meta || undefined,
  meta_en: meta || undefined,
} satisfies SectionByType<'hero-tech-layer'>;

// ── 3. Positioning split → tech-positioning-split ──────────────────────────────
const positioningTitleHtml = (await renderFirstSlot(['positioning-title'])).trim();
const positioningAsideHtml = stripHtml(await renderFirstSlot(['positioning-aside']));
const positioningStatementHtml = (await renderFirstSlot(['positioning-statement'])).trim();
const positioningFactsHtml = await renderFirstSlot(['positioning-facts']);
const factKeys = extractAll(positioningFactsHtml, 'fact-k');
const factValues = extractAll(positioningFactsHtml, 'fact-v');
const positioningFacts = factKeys.map((k, i) => ({ k, v_fr: factValues[i] ?? '', v_en: factValues[i] ?? '' }));
const positioningData = {
  type: 'tech-positioning-split',
  kicker_fr: 'Position Waimia',
  kicker_en: 'Position Waimia',
  title_fr: positioningTitleHtml,
  title_en: positioningTitleHtml,
  ...(positioningAsideHtml ? { aside_fr: positioningAsideHtml, aside_en: positioningAsideHtml } : {}),
  statement_fr: positioningStatementHtml,
  statement_en: positioningStatementHtml,
  ...(positioningFacts.length > 0 ? { facts: positioningFacts } : {}),
} satisfies SectionByType<'tech-positioning-split'>;

// ── 4. Capabilities → tech-capabilities-specs ──────────────────────────────────
const capabilitiesTitleHtml = (await renderFirstSlot(['capabilities-title'])).trim() || '<i>Inventaire</i><br/>technique';
const capabilitiesAsideHtml = stripHtml(await renderFirstSlot(['capabilities-aside']));
const capabilitiesSlotHtml = await renderFirstSlot(['capabilities-grid', 'capabilities']);
const capabilities =
  capabilitiesData && capabilitiesData.length > 0
    ? capabilitiesData.map((item) => ({
        name_fr: item.name_fr,
        name_en: item.name_en,
        description_fr: item.description_fr,
        description_en: item.description_en,
        status: item.status,
      }))
    : splitBlocks(capabilitiesSlotHtml, 'cap-card')
        .map((block) => {
          const name = extractTag(block, 'h3');
          const body = extractTag(block, 'p');
          const rawStatus = extract(block, 'cap-v') || extract(block, 'cap-value') || extract(block, 'cap-ck') || extract(block, 'kicker');
          return {
            name_fr: name,
            name_en: name,
            description_fr: body,
            description_en: body,
            status: asStatus(rawStatus),
          };
        })
        .filter((item) => item.name_fr && item.description_fr);
const capabilitiesData_ = {
  type: 'tech-capabilities-specs',
  kicker_fr: 'Capacités',
  kicker_en: 'Capacités',
  title_fr: capabilitiesTitleHtml,
  title_en: capabilitiesTitleHtml,
  ...(capabilitiesAsideHtml ? { aside_fr: capabilitiesAsideHtml, aside_en: capabilitiesAsideHtml } : {}),
  capabilities,
} satisfies SectionByType<'tech-capabilities-specs'>;

// ── 5. Models table (conditionnel) → tech-models-table ─────────────────────────
const modelsTitleHtml = (await renderFirstSlot(['models-title'])).trim() || '<i>Modèles</i><br/>disponibles';
const modelsAsideHtml = stripHtml(await renderFirstSlot(['models-aside']));
const modelsRowsHtml = await renderFirstSlot(['models-rows']);
const models =
  modelsData && modelsData.length > 0
    ? modelsData.map((m) => ({
        name: m.name,
        version: m.version,
        use_case_fr: m.use_case_fr,
        use_case_en: m.use_case_en,
      }))
    : Array.from(modelsRowsHtml.matchAll(/<tr[^>]*>([\s\S]*?)<\/tr>/gi))
        .map((rowMatch) =>
          Array.from((rowMatch[1] ?? '').matchAll(/<td[^>]*>([\s\S]*?)<\/td>/gi)).map((cellMatch) => stripHtml(cellMatch[1] ?? '')),
        )
        .filter((row) => row.length > 0)
        .map((row) => ({
          name: row[0] ?? '',
          version: row[1] ?? '',
          ...(row[2] ? { cost: row[2] } : {}),
          ...(row[3] ? { context: row[3] } : {}),
          use_case_fr: row[4] ?? '',
          use_case_en: row[4] ?? '',
        }));
const modelsTableData =
  models.length > 0
    ? ({
        type: 'tech-models-table',
        kicker_fr: 'Choisir le bon modèle',
        kicker_en: 'Choisir le bon modèle',
        title_fr: modelsTitleHtml,
        title_en: modelsTitleHtml,
        ...(modelsAsideHtml ? { aside_fr: modelsAsideHtml, aside_en: modelsAsideHtml } : {}),
        caption_fr: 'Modèles Claude · profil de tâche',
        caption_en: 'Modèles Claude · profil de tâche',
        models,
      } satisfies SectionByType<'tech-models-table'>)
    : null;

// ── 6. When to use → tech-when-dual ────────────────────────────────────────────
const whenTitleHtml = (await renderFirstSlot(['when-title'])).trim() || "<i>Quand</i><br/>l'utiliser ?";
const whenAsideHtml = stripHtml(await renderFirstSlot(['when-aside']));
const whenUseItems = extractListItems(await renderFirstSlot(['when-to-use', 'when-use']));
const whenAvoidItems = extractListItems(await renderFirstSlot(['when-not-to-use', 'when-avoid']));
const whenData = {
  type: 'tech-when-dual',
  kicker_fr: 'Aide décision',
  kicker_en: 'Aide décision',
  title_fr: whenTitleHtml,
  title_en: whenTitleHtml,
  ...(whenAsideHtml ? { aside_fr: whenAsideHtml, aside_en: whenAsideHtml } : {}),
  use_title_fr: 'Utiliser quand',
  use_title_en: 'Utiliser quand',
  use_items_fr: whenUseItems,
  use_items_en: whenUseItems,
  avoid_title_fr: 'Considérer autre chose quand',
  avoid_title_en: 'Considérer autre chose quand',
  avoid_items_fr: whenAvoidItems,
  avoid_items_en: whenAvoidItems,
} satisfies SectionByType<'tech-when-dual'>;

// ── 7. Integration flow → tech-integration-flow ────────────────────────────────
const integrationTitleHtml = (await renderFirstSlot(['integration-title'])).trim() || '<i>Intégration</i>';
const integrationAsideHtml = stripHtml(await renderFirstSlot(['integration-aside']));
const integrationSlotHtml = await renderFirstSlot(['integration-flow', 'integration-nodes']);
const integrationFlowNodes = splitBlocks(integrationSlotHtml, 'flow-node')
  .map((block) => {
    const label = extractTag(block, 'h3');
    const body = extract(block, 'flow-body') || extractTag(block, 'p');
    const num = extract(block, 'flow-layer').split('·')[0]?.trim() ?? '';
    return { num, label, body };
  })
  .filter((n) => n.label && n.body);
const integrationPlaceholderNodes = splitBlocks(integrationSlotHtml, 'node')
  .map((block) => ({
    num: extract(block, 'node-k'),
    label: extract(block, 'node-l'),
    body: 'Phase de cadrage architecture Waimia.',
  }))
  .filter((n) => n.label);
const integrationSteps =
  integrationData && integrationData.length > 0
    ? integrationData.map((item) => ({
        num: item.num,
        label_fr: item.label_fr,
        label_en: item.label_en,
        body_fr: item.body_fr,
        body_en: item.body_en,
      }))
    : (integrationFlowNodes.length > 0 ? integrationFlowNodes : integrationPlaceholderNodes).map((n, i) => ({
        num: n.num || String(i + 1).padStart(2, '0'),
        label_fr: n.label,
        label_en: n.label,
        body_fr: n.body,
        body_en: n.body,
      }));
const integrationSectionData =
  integrationSteps.length > 0
    ? ({
        type: 'tech-integration-flow',
        kicker_fr: 'Position dans la stack',
        kicker_en: 'Position dans la stack',
        title_fr: integrationTitleHtml,
        title_en: integrationTitleHtml,
        ...(integrationAsideHtml ? { aside_fr: integrationAsideHtml, aside_en: integrationAsideHtml } : {}),
        steps: integrationSteps,
      } satisfies SectionByType<'tech-integration-flow'>)
    : null;

// ── 8. CTA architecture (dark) → department-cta (preset dark de CtaFinal) ───────
const ctaTitleHtml = (await renderFirstSlot(['cta-title'])).trim() || 'Quelle stack<br/>pour votre<br/>contexte ?';
const ctaBodyHtml =
  stripHtml(await renderFirstSlot(['cta-body'])) ||
  'Chaque déploiement Waimia commence par un choix technologique rigoureux : adapté à vos contraintes, pas à nos préférences.';
const ctaData = {
  type: 'department-cta',
  h2_fr: ctaTitleHtml,
  h2_en: ctaTitleHtml,
  body_fr: ctaBodyHtml,
  body_en: ctaBodyHtml,
  primary_label_fr: 'Parler architecture →',
  primary_label_en: 'Parler architecture →',
  primary_href: '/contact',
  secondary_label_fr: 'Voir la stack complète',
  secondary_label_en: 'Voir la stack complète',
  secondary_href: '/technologies',
} satisfies SectionByType<'department-cta'>;

const serviceLd = buildService({ name: title, description });
---
<Base {title} {description} {noindex} jsonLd={[serviceLd]}>
    <MastheadBar
      lang={lang}
      items={[
        { label: lang === 'fr' ? 'Accueil' : 'Home', href: lang === 'fr' ? '/' : '/en' },
        { label: lang === 'fr' ? 'Technologies' : 'Technologies', href: lang === 'fr' ? '/technologies' : '/en/technologies' },
        { label: layerLabel },
      ]}
    />

    {/* 1. HERO LAYER → hero-tech-layer */}
    <HeroOfferDetail
      data={heroData}
      lang={lang}
      transitionId={pageTransitionId}
      cardTransitionId={pageTransitionId}
      wrapMax="1240px"
      geoReveal={true}
    />

    {/* 2. POSITIONING SPLIT → tech-positioning-split */}
    <TechPositioningSplit data={positioningData} lang={lang} />

    {/* 3. CAPABILITIES → tech-capabilities-specs */}
    <TechCapabilitiesSpecs data={capabilitiesData_} lang={lang} />

    {/* 4. MODELS TABLE (conditionnel) → tech-models-table */}
    {showModels && modelsTableData && <EditorialTableBlock data={modelsTableData} lang={lang} />}

    {/* 5. WHEN TO USE DUAL → tech-when-dual */}
    <TechWhenDual data={whenData} lang={lang} />

    {/* 6. INTEGRATION FLOW → tech-integration-flow */}
    {integrationSectionData && <TechIntegrationFlow data={integrationSectionData} lang={lang} />}

    {/* 7. RELATED (optionnel) */}
    <slot name="related" />

    {/* 8. CTA ARCHITECTURE DARK → department-cta */}
    <CtaFinal data={ctaData} lang={lang} />
</Base>
