---
// Template · UtilityTemplate · shell unique pages utilitaires + index/listings
//
// R6 (2026-06-10) · FUSION ListIndexTemplate → UtilityTemplate (`variant`).
// Deux coquilles minces wrappant le même masthead unifié HeroCentered :
//  - variant="utility" (défaut) · contact, careers, about, methode, academy,
//    livres-blancs/index, veille-ia/index · masthead hero-utility-masthead +
//    breadcrumb + slot `body` + CtaFinal optionnel (markup INCHANGÉ).
//  - variant="list" · blog/index, changelog, cookbooks/index, outils/index ·
//    masthead hero-hub-listing (slots headline/lede/filters) + slot `list` +
//    CtaBandSection (markup VERBATIM de l'ancien ListIndexTemplate, sans breadcrumb).
//
// Composé de · HeroCentered (section cataloguée) · CtaFinal / CtaBandSection

import Base from '../../layouts/Base.astro';
import MastheadBar from '../sections/MastheadBar.astro';
import HeroCentered from '../sections/HeroCentered.astro';
import CtaFinal from '../sections/CtaFinal.astro';
import CtaBandSection from '../sections/CtaBandSection.astro';
import type { SectionByType } from '@waimia/ds-kernel';
import { langFromPath, localizeHref } from '../../lib/i18n';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  /** Branche de rendu · `utility` (défaut) ou `list` (ex-ListIndexTemplate) */
  variant?: 'utility' | 'list';
  title: string;
  description: string;
  /** Kicker section (Contact, Careers, Cas clients…) · déjà localisé par la page */
  kicker?: string;
  /** [utility] Masthead · headline (HTML riche : <i> pour l'accent terracotta italique) */
  headlineFr?: string;
  headlineEn?: string;
  /** [utility] Masthead · lede (HTML riche autorisé) */
  ledeFr?: string;
  ledeEn?: string;
  /** [utility] Alignement masthead · `left` (défaut, narrative) ou `centered` (action focus) */
  align?: 'left' | 'centered';
  /** [utility] Afficher le CTA final en fin de page · défaut true */
  showCta?: boolean;
  /** [utility] Breadcrumb items (optionnel) · si absent, deduit du pathname */
  breadcrumb?: Crumb[];
  /** JSON-LD spécifique à la page (forwarded to Base) */
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  /** Exclure la page de l'index (robots noindex) · forwarded to Base */
  noindex?: boolean;
}
const {
  variant = 'utility',
  title, description, kicker,
  headlineFr = '', headlineEn = '', ledeFr = '', ledeEn = '',
  align = 'left', showCta = true, breadcrumb, jsonLd,
  noindex = false,
} = Astro.props as Props;

const lang = langFromPath(Astro.url.pathname);
const isList = variant === 'list';

/* ── Branche LIST (ex-ListIndexTemplate, markup verbatim) ─────────────────── */
// Slot-forwarding : les slots headline/lede (rich text `<i>`) → champs `set:html` du composant.
const listLabel = title.split(' · ')[0];
const hasFilters = Astro.slots.has('filters');
const h1Html = isList ? await Astro.slots.render('headline') : '';
const ledeHtml = isList ? await Astro.slots.render('lede') : '';

const listHeroData = {
  type: 'hero-hub-listing',
  kicker_fr: kicker ?? '',
  kicker_en: kicker ?? '',
  h1_fr: h1Html,
  h1_en: h1Html,
  lede_fr: ledeHtml,
  lede_en: ledeHtml,
  decoration: false,
} satisfies SectionByType<'hero-hub-listing'>;

const listCtaData = {
  type: 'cta-band',
  text_fr: `Après ${listLabel}, passons à votre cas réel et à votre premier livrable utile.`,
  text_en: `After ${listLabel}, let us move to your real use case and your first useful deliverable.`,
  cta: {
    label_fr: 'Réserver un audit →',
    label_en: 'Book an audit →',
    href: localizeHref('/audit-ia-pme', lang),
    variant: 'primary',
  },
  background: 'paper-2',
} satisfies SectionByType<'cta-band'>;

/* ── Branche UTILITY (markup inchangé) ────────────────────────────────────── */
// Masthead · consomme le composant catalogué `hero-utility-masthead` (source
// unique structure + CSS). Contenu par instance via props du template.
// `reveal` préserve la couche d'animation d'origine du masthead (kicker/h1/lede
// avaient la classe `reveal`) ; le défaut du composant — sans reveal — reste
// inchangé pour la preview catalogue. Le `kicker` est déjà localisé par la page,
// donc passé identique en fr/en (l'instance ne sert qu'une langue à la fois).
const heroData = {
  type: 'hero-utility-masthead',
  ...(kicker ? { kicker_fr: kicker, kicker_en: kicker }: {}),
  h1_fr: headlineFr,
  h1_en: headlineEn,
  lede_fr: ledeFr,
  lede_en: ledeEn,
  align,
} satisfies SectionByType<'hero-utility-masthead'>;
const isContactPage = Astro.url.pathname === '/contact' || Astro.url.pathname === '/en/contact';
const utilityLabel = title.split(' · ')[0];
const ctaData: SectionByType<'cta-final'> = isContactPage
  ? {
      type: 'cta-final',
      h2_fr: "Besoin d'un <i>cadre</i> avant de réserver ?",
      h2_en: 'Need a <i>framework</i> before booking?',
      body_fr: 'Commencez par le périmètre, la méthode et les formats d\'intervention. Ensuite seulement, on ouvre un créneau utile.',
      body_en: 'Start with scope, method, and engagement formats. Then, and only then, we open a useful slot.',
      cta_primary: {
        label_fr: 'Voir les offres →',
        label_en: 'See services →',
        href: localizeHref('/services', lang),
        variant: 'primary',
      },
      cta_secondary: {
        label_fr: 'Voir la méthode →',
        label_en: 'See the method →',
        href: localizeHref('/agence/methode', lang),
        variant: 'ghost',
      },
      background: 'paper',
    }
  : {
      type: 'cta-final',
      h2_fr: 'Prêt à passer du <i>texte</i> au terrain ?',
      h2_en: 'Ready to move from <i>text</i> to the field?',
      body_fr: `${utilityLabel} clarifié. Reste à cadrer le chantier, le bon niveau d'engagement et le premier livrable utile.`,
      body_en: `${utilityLabel} clarified. Now it is about framing the engagement, the right level of involvement, and the first useful deliverable.`,
      cta_primary: {
        label_fr: 'Réserver un audit →',
        label_en: 'Book an audit →',
        href: localizeHref('/audit-ia-pme', lang),
        variant: 'primary',
      },
      cta_secondary: {
        label_fr: 'Voir les offres →',
        label_en: 'See services →',
        href: localizeHref('/services', lang),
        variant: 'ghost',
      },
      background: 'paper',
    };

// Auto-deduction breadcrumb si non fourni (segments URL → labels capitalises)
const autoCrumbs: Crumb[] = isList ? [] : breadcrumb ?? (() => {
  const segments = Astro.url.pathname.split('/').filter(s => s && s !== 'en');
  if (segments.length === 0) return [];
  const home: Crumb = { label: lang === 'fr' ? 'Accueil' : 'Home', href: lang === 'fr' ? '/' : '/en' };
  const intermediate = segments.slice(0, -1).map((s, i) => ({
    label: s.charAt(0).toUpperCase() + s.slice(1).replace(/-/g, ' '),
    href: (lang === 'fr' ? '/' : '/en/') + segments.slice(0, i + 1).join('/'),
  }));
  const last: Crumb = { label: title.split(' · ')[0] };
  return [home, ...intermediate, last];
})();
---
{isList ? (
  <Base title={title} description={description} jsonLd={jsonLd} noindex={noindex}>
    {/* MASTHEAD · composant catalogué hero-hub-listing (deltas absorbés par props rétro-compat) */}
    <HeroCentered
      data={listHeroData}
      lang={lang}
      listTopPad="140px"
      ledeMaxFont="32px"
      ledeReveal={false}
      showFilters={hasFilters}
      listBorder={true}
    >
      <slot name="filters" slot="filters" />
    </HeroCentered>

    {/* LIST (slot ouvert) */}
    <section class="list-body">
      <div class="wrap-wide">
        <slot name="list" />
      </div>
    </section>

    <CtaBandSection data={listCtaData} lang={lang} />
  </Base>
) : (
  <Base title={title} description={description} jsonLd={jsonLd} noindex={noindex}>
    {autoCrumbs.length > 0 && (
      <div class="util-crumbs">
        <MastheadBar lang={lang} items={autoCrumbs} />
      </div>
    )}
    {/* MASTHEAD · composant catalogué hero-utility-masthead (contenu via props).
        align (left/centered) piloté par `data.align` → géré nativement par le composant.
        wrapMaxWidth=var(--wrap-wide) préserve la largeur live (1560px) ; le défaut du
        composant : 1200px : reste inchangé pour la preview catalogue.
        reveal préserve la couche d'animation d'origine (kicker/h1/lede en `reveal`). */}
    <HeroCentered data={heroData} lang={lang} wrapMaxWidth="var(--wrap-wide)" reveal={true} />

    {/* BODY · slot libre (form, story, jobs list…) */}
    <section class="util-body reveal">
      <div class="wrap-wide">
        <slot name="body" />
      </div>
    </section>

    {/* CTA optionnel en bas */}
    {showCta && <CtaFinal data={ctaData} lang={lang} />}
  </Base>
)}

<style>
  /* Masthead migré vers le composant catalogué `HeroUtilityMasthead` (sections/).
     Règles `.util-hd/.util-hd-centered/.util-kicker/.util-h1/.util-lede` supprimées
     (structure + CSS désormais portés par le composant — source unique). */
  /* .util-crumbs = simple wrapper : MastheadBar possède sa largeur (wrap-wide interne)
     et compense le header (.masthead-bar padding-top dans global.css). Pas de double. */
  .util-body { padding: var(--section-base) var(--space-6); }
  /* Branche list (ex-ListIndexTemplate) */
  .list-body { padding: var(--section-base) var(--space-6); }
</style>
