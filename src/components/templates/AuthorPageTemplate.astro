---
// Template · AuthorPageTemplate · page auteur (long-form E-E-A-T)
//
// Lot 5b (composabilisation, directive Simon « 100 % composable, pas de bespoke ») :
// converti en composition 100 % sections cataloguees + data-builders `satisfies`, sur le
// modele de CaseStudyTemplate. Chaque bloc bespoke a ete EXTRAIT en module co-localise
// generique (`src/sections/<type>/`) a parite pixel (CSS copie fidelement). Le masthead reste
// `hero-author` (HeroSplit). Le corps « Pourquoi Waimia » (MDX `<Content/>`) est forwarde en
// slot a `prose-aside`. JSON-LD / meta SEO / auto-jointure des contenus signes : PRESERVES.
//
// Composé de (tous catalogues) : hero-author (HeroSplit) · keyword-strip (expertise + social)
//   · prose-aside · bordered-pullquote · signed-writing-list · method-diagram-list
//   · curriculum-timeline · publications-panel · closing-cta-band.
import Base from '../../layouts/Base.astro';
import HeroSplit from '../sections/HeroSplit.astro';
import PortraitSimon from '../svg/sumie/PortraitSimon.astro';
import type { SectionByType } from '@waimia/ds-kernel';
import { langFromPath, localizeHref, t } from '../../lib/i18n';

import KeywordStrip from '../../sections/keyword-strip/Component.astro';
import type { KeywordStripData } from '@waimia/ds-kernel/sections/keyword-strip/schema';
import ProseAside from '../../sections/prose-aside/Component.astro';
import type { ProseAsideData } from '@waimia/ds-kernel/sections/prose-aside/schema';
import BorderedPullquote from '../../sections/bordered-pullquote/Component.astro';
import type { BorderedPullquoteData } from '@waimia/ds-kernel/sections/bordered-pullquote/schema';
import SignedWritingList from '../../sections/signed-writing-list/Component.astro';
import type { SignedWritingListData } from '@waimia/ds-kernel/sections/signed-writing-list/schema';
import MethodDiagramList from '../../sections/method-diagram-list/Component.astro';
import type { MethodDiagramListData } from '@waimia/ds-kernel/sections/method-diagram-list/schema';
import CurriculumTimeline from '../../sections/curriculum-timeline/Component.astro';
import type { CurriculumTimelineData } from '@waimia/ds-kernel/sections/curriculum-timeline/schema';
import PublicationsPanel from '../../sections/publications-panel/Component.astro';
import type { PublicationsPanelData } from '@waimia/ds-kernel/sections/publications-panel/schema';
import ClosingCtaBand from '../../sections/closing-cta-band/Component.astro';
import type { ClosingCtaBandData } from '@waimia/ds-kernel/sections/closing-cta-band/schema';

type AuthorStatus = 'active' | 'alumni' | 'guest';

interface EducationItem {
  year: string;
  institution: string;
  degree_fr: string;
  degree_en: string;
  url?: string;
}

interface ExperienceItem {
  year: string;
  role_fr: string;
  role_en: string;
  company: string;
  companyUrl?: string;
  summary_fr?: string;
  summary_en?: string;
}

interface PublicationItem {
  title: string;
  url: string;
  venue: string;
  year: string;
  type?: string;
}

interface AwardItem {
  year: string;
  label_fr: string;
  label_en: string;
}

interface AuthorSocial {
  x?: string;
  linkedin?: string;
  github?: string;
  website?: string;
  email?: string;
  bluesky?: string;
  mastodon?: string;
}

interface Author {
  title_fr: string;
  title_en: string;
  description_fr: string;
  description_en: string;
  role_fr: string;
  role_en: string;
  bio_fr: string;
  bio_en: string;
  photo?: string;
  photoAlt_fr?: string;
  photoAlt_en?: string;
  education: EducationItem[];
  experience: ExperienceItem[];
  publications: PublicationItem[];
  awards: AwardItem[];
  expertise: string[];
  social: AuthorSocial;
  status: AuthorStatus;
  featured: boolean;
  publishedAt?: Date;
  faq_fr?: Array<{ q: string; a: string }>;
  faq_en?: Array<{ q: string; a: string }>;
}

interface ContentItem {
  id: string;
  collection: string;
  data: {
    title_fr: string;
    title_en: string;
    publishedAt: Date;
    description_fr?: string;
    description_en?: string;
  };
}

interface Props {
  author: Author;
  essays: ContentItem[];
  shortPosts: ContentItem[];
  cookbooks: ContentItem[];
  livresBlancs: ContentItem[];
  veilleIA: ContentItem[];
  /** Post-fusion R1 : entrées blog type 'field-note', servies sous /ressources/field-notes. */
  fieldNotes?: ContentItem[];
}

const { author, essays, shortPosts, cookbooks, livresBlancs, veilleIA, fieldNotes = [] } = Astro.props as Props;
const lang = langFromPath(Astro.url.pathname);
const pageTransitionId = Astro.url.pathname
  .replace(/^\/(?:en\/)?/, '')
  .replace(/\/$/, '')
  .replace(/[^a-z0-9]+/gi, '-')
  .replace(/^-|-$/g, '') || 'home';
const displayName = lang === 'fr' ? author.title_fr : author.title_en;
const role = lang === 'fr' ? author.role_fr : author.role_en;
const description = lang === 'fr' ? author.description_fr : author.description_en;
const teamHref = localizeHref('/equipe', lang);
const contactHref = localizeHref('/contact', lang);
const resourcesHref = localizeHref('/ressources', lang);

const socialUrls = [
  author.social?.linkedin,
  author.social?.x,
  author.social?.github,
  author.social?.website,
  author.social?.bluesky,
  author.social?.mastodon,
].filter((url): url is string => Boolean(url));

// ── JSON-LD (Person / ProfilePage / BreadcrumbList) : PRESERVE a l'identique. ──
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: displayName,
  jobTitle: role,
  description: description,
  image: author.photo ? `https://waimia.com${author.photo}` : undefined,
  sameAs: socialUrls,
  worksFor: {
    '@type': 'Organization',
    name: 'Waimia',
    url: 'https://waimia.com',
  },
};

const profilePageLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: personLd,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t({ fr: 'Accueil', en: 'Home' }, lang),
      item: lang === 'fr' ? 'https://waimia.com/' : 'https://waimia.com/en/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t({ fr: "L'équipe", en: 'The team' }, lang),
      item: `https://waimia.com${teamHref}`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: displayName,
      item: Astro.url.href,
    },
  ],
};

const jsonLd = [personLd, profilePageLd, breadcrumbLd];

// ── MASTHEAD → hero-author (HeroSplit). Data-builder inchange. ──
const accentLastWord = (value: string) => {
  const parts = value.trim().split(/\s+/);
  const accent = parts.pop() ?? value;
  return { lead: parts.join(' '), accent };
};

const nameParts = accentLastWord(displayName);
const ledeFr = (author.bio_fr.trim().split(/\n\s*\n/).filter(Boolean)[0] ?? author.description_fr).replace(/\*\*/g, '');
const ledeEn = (author.bio_en.trim().split(/\n\s*\n/).filter(Boolean)[0] ?? author.description_en).replace(/\*\*/g, '');
const heroData = {
  type: 'hero-author' as const,
  team_label_fr: "L'équipe",
  team_label_en: 'The team',
  team_href: teamHref,
  name: displayName,
  name_lead: nameParts.lead,
  name_accent: nameParts.accent,
  role_fr: author.role_fr,
  role_en: author.role_en,
  lede_fr: ledeFr,
  lede_en: ledeEn,
} satisfies SectionByType<'hero-author'>;

const hrefFor = (base: string, id: string) => localizeHref(`${base}/${id}`, lang);

// ── EXPERTISE → keyword-strip (mots-cles, muted, sous hero). ──
const expertiseData = author.expertise.length > 0
  ? ({
      type: 'keyword-strip',
      tone: 'muted',
      pad: 'tight',
      aria_label_fr: 'Expertise',
      aria_label_en: 'Expertise',
      items: author.expertise.map((label) => ({ label })),
    } satisfies KeywordStripData)
  : null;

// ── POURQUOI WAIMIA → prose-aside (kicker lateral + corps MDX en slot). ──
const whyData = {
  type: 'prose-aside',
  kicker_fr: '§ Pourquoi Waimia',
  kicker_en: '§ Why Waimia',
} satisfies ProseAsideData;

// ── PULLQUOTE MANIFESTE → bordered-pullquote (contenu generique, accent <i>). ──
const pullquoteData = {
  type: 'bordered-pullquote',
  quote_html_fr:
    'L&rsquo;intelligence artificielle n&rsquo;est pas un outil. C&rsquo;est une <i>nouvelle façon de travailler.</i>&nbsp;',
  quote_html_en:
    'Artificial intelligence is not a tool. It&rsquo;s <i>a new way of working.</i>&nbsp;',
  cite_fr: '&mdash;&nbsp;Waimia',
  cite_en: '&mdash;&nbsp;Waimia',
} satisfies BorderedPullquoteData;

// ── ESSAYS → signed-writing-list (auto-jointure : contenus long-form signes). ──
const essaysData = essays.length > 0
  ? ({
      type: 'signed-writing-list',
      kicker_fr: '§ Essays · Long form',
      kicker_en: '§ Essays · Long form',
      title_fr: 'Ce que je publie',
      title_en: 'What I publish',
      items: essays.map((essay) => ({
        date_iso: new Date(essay.data.publishedAt).toISOString(),
        title_fr: essay.data.title_fr,
        title_en: essay.data.title_en,
        href: hrefFor('/blog', essay.id),
        excerpt_fr: essay.data.description_fr,
        excerpt_en: essay.data.description_en ?? essay.data.description_fr,
      })),
    } satisfies SignedWritingListData)
  : null;

// ── METHODE → method-diagram-list (diagramme SVG + phases numerotees). Contenu bilingue
//    transcrit fidelement (ex-tableau `method` localise). ──
const methodSteps = [
  {
    title_fr: 'Cartographie',
    title_en: 'Mapping',
    body_fr: 'On regarde le métier réel, les frictions, les outils, les dépendances et les décisions déjà prises hors système.',
    body_en: 'We inspect the real work, friction, tools, dependencies and decisions already made outside the system.',
  },
  {
    title_fr: 'Priorisation',
    title_en: 'Prioritisation',
    body_fr: 'On classe les workflows par ROI, risque opérationnel, temps de retour et capacité interne à les maintenir.',
    body_en: 'We rank workflows by ROI, operational risk, payback time and internal ability to maintain them.',
  },
  {
    title_fr: 'Câblage',
    title_en: 'Wiring',
    body_fr: "On connecte l'IA aux outils existants : CRM, inbox, tableurs, bases métier, reporting, sans théâtre technique.",
    body_en: 'We connect AI to the existing tools: CRM, inbox, spreadsheets, business data and reporting, without technical theatre.',
  },
  {
    title_fr: 'Mesure',
    title_en: 'Measurement',
    body_fr: 'Chaque workflow a sa métrique avant/après : temps gagné, pipeline reconnecté, coûts évités, qualité produite.',
    body_en: 'Every workflow gets a before/after metric: time saved, pipeline reconnected, costs avoided, quality produced.',
  },
  {
    title_fr: 'Passation',
    title_en: 'Handover',
    body_fr: 'Les équipes reprennent la main avec une documentation courte, des rituels de pilotage et une stack compréhensible.',
    body_en: 'Teams take control with short documentation, management rituals and a stack they can understand.',
  },
];
const methodData = {
  type: 'method-diagram-list',
  kicker_fr: '§ Méthode',
  kicker_en: '§ Method',
  title_fr: 'Comment je travaille',
  title_en: 'How I work',
  steps: methodSteps,
} satisfies MethodDiagramListData;

// ── CURRICULUM → curriculum-timeline (experience + formation + distinctions, fond paper-2). ──
const curriculumEvents = [
  ...author.experience.map((item) => ({
    num: item.year,
    title_fr: item.role_fr,
    title_en: item.role_en,
    meta_fr: item.company,
    meta_en: item.company,
    body_fr: item.summary_fr ?? item.company,
    body_en: item.summary_en ?? item.company,
  })),
  ...author.education.map((item) => ({
    num: item.year,
    title_fr: item.degree_fr,
    title_en: item.degree_en,
    meta_fr: item.institution,
    meta_en: item.institution,
    body_fr: item.institution,
    body_en: item.institution,
  })),
  ...author.awards.map((item) => ({
    num: item.year,
    title_fr: item.label_fr,
    title_en: item.label_en,
    meta_fr: 'Distinction',
    meta_en: 'Award',
    body_fr: item.label_fr,
    body_en: item.label_en,
  })),
];
const curriculumData = curriculumEvents.length > 0
  ? ({
      type: 'curriculum-timeline',
      kicker_fr: '§ Curriculum',
      kicker_en: '§ Curriculum',
      title_fr: 'Curriculum',
      title_en: 'Curriculum',
      emphasis: true,
      events: curriculumEvents,
    } satisfies CurriculumTimelineData)
  : null;

// ── PUBLICATIONS → publications-panel (callout manifeste + publications + index ressources
//    auto-joint, trie/decoupe a 8 + lien « tout voir »). ──
const resourceGroups = [
  { label_fr: 'Notes', label_en: 'Notes', hrefBase: '/blog', items: shortPosts },
  { label_fr: 'Cookbooks', label_en: 'Cookbooks', hrefBase: '/ressources/cookbooks', items: cookbooks },
  { label_fr: 'Livres blancs', label_en: 'White papers', hrefBase: '/ressources/livres-blancs', items: livresBlancs },
  { label_fr: 'Veille IA', label_en: 'AI watch', hrefBase: '/ressources/veille-ia', items: veilleIA },
  { label_fr: 'Field notes', label_en: 'Field notes', hrefBase: '/ressources/field-notes', items: fieldNotes },
].filter((group) => group.items.length > 0);

const resourceRows = resourceGroups
  .flatMap((g) =>
    g.items.map((i) => ({
      date_iso: new Date(i.data.publishedAt).toISOString(),
      publishedAt: i.data.publishedAt,
      title_fr: i.data.title_fr,
      title_en: i.data.title_en,
      href: hrefFor(g.hrefBase, i.id),
      tag_fr: g.label_fr,
      tag_en: g.label_en,
    })),
  )
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime())
  .slice(0, 8)
  .map(({ publishedAt, ...row }) => row);

const publicationsData = {
  type: 'publications-panel',
  kicker_fr: '§ Publications',
  kicker_en: '§ Publications',
  title_fr: 'Articles, notes, manifestes',
  title_en: 'Articles, notes, manifestos',
  manifesto_html_fr:
    'Pas une stack. Un système. Pas un agent isolé. Une équipe d’agents.<br />Pas une démo. Une mise en production.',
  manifesto_html_en:
    'Not a stack. A system. Not a lone agent. A team of agents.<br />Not a demo. A production release.',
  ...(author.publications.length > 0
    ? { publications: author.publications.map((p) => ({ title: p.title, url: p.url, venue: p.venue, year: p.year })) }
    : {}),
  ...(resourceRows.length > 0 ? { resources: resourceRows } : {}),
  all_href: resourcesHref,
  all_label_fr: 'Voir toutes les ressources',
  all_label_en: 'See all resources',
} satisfies PublicationsPanelData;

// ── SUIVRE → keyword-strip (liens contact/sociaux, ink, filet superieur). ──
const socialItems = [
  author.social.linkedin && { label: 'LinkedIn', url: author.social.linkedin, external: true },
  author.social.x && { label: 'X', url: author.social.x, external: true },
  author.social.github && { label: 'GitHub', url: author.social.github, external: true },
  author.social.website && { label: t({ fr: 'Site', en: 'Site' }, lang), url: author.social.website, external: true },
  author.social.email && { label: 'Email', url: `mailto:${author.social.email}`, external: false },
  author.social.bluesky && { label: 'Bluesky', url: author.social.bluesky, external: true },
  author.social.mastodon && { label: 'Mastodon', url: author.social.mastodon, external: true },
].filter((item): item is { label: string; url: string; external: boolean } => Boolean(item));

const socialData = socialItems.length > 0
  ? ({
      type: 'keyword-strip',
      tone: 'ink',
      pad: 'base',
      topRule: true,
      kicker_fr: '§ Suivre',
      kicker_en: '§ Follow',
      items: socialItems.map((item) => ({ label: item.label, href: item.url, external: item.external })),
    } satisfies KeywordStripData)
  : null;

// ── CTA DE CLOTURE → closing-cta-band (ink, accent <em>). ──
const ctaData = {
  type: 'closing-cta-band',
  kicker_fr: '§ Travailler ensemble',
  kicker_en: '§ Work together',
  h2_html_fr: 'Le mardi on câble.<em> Le vendredi on mesure.</em>',
  h2_html_en: 'On Tuesday we wire.<em> On Friday we measure.</em>',
  button_label_fr: 'Câbler mon système →',
  button_label_en: 'Wire my system →',
  button_href: contactHref,
} satisfies ClosingCtaBandData;
---

<Base
  title={`${displayName} · ${role} · Waimia`}
  description={description}
  jsonLd={jsonLd}
>
  <div class="author-page">
    {/* Masthead → archétype HeroSplit, preset hero-author (sections/) */}
    <HeroSplit data={heroData} lang={lang} transitionId={pageTransitionId}>
      <PortraitSimon slot="portrait" size="lg" variant="default" />
    </HeroSplit>

    {expertiseData && <KeywordStrip data={expertiseData} lang={lang} />}

    {/* Pourquoi Waimia : corps MDX (<Content/>) forwarde en slot par défaut à prose-aside. */}
    <ProseAside data={whyData} lang={lang}><slot /></ProseAside>

    <BorderedPullquote data={pullquoteData} lang={lang} />

    {essaysData && <SignedWritingList data={essaysData} lang={lang} />}

    <MethodDiagramList data={methodData} lang={lang} />

    {curriculumData && <CurriculumTimeline data={curriculumData} lang={lang} />}

    <PublicationsPanel data={publicationsData} lang={lang} />

    {socialData && <KeywordStrip data={socialData} lang={lang} />}

    <ClosingCtaBand data={ctaData} lang={lang} />
  </div>
</Base>

<style>
  /* Seul chrome restant au niveau template : la teinte de fond de la page. Tout le reste du
     markup/CSS a migre vers les modules catalogues co-localises (rule 60, parite pixel). */
  .author-page {
    background: var(--paper);
    color: var(--ink);
  }
</style>
