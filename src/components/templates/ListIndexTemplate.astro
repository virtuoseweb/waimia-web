---
// Template · ListIndexTemplate · index/listing d'éléments (cas, articles, knowledge base)
//
// Mapping handoff2 :
//  - cases-index.html        → /ressources/cas
//  - writing-index.html      → /ressources/blog
//  - knowledge-base.html     → /ressources/cookbooks
//  - changelog.html          → /ressources/changelog
//
// Squelette : Masthead catalogué (hero-hub-listing) + Filter row (slot) + List slot + CTA
//
// MIGRATION (14/18) : le masthead consomme désormais le composant catalogué
// `hero-hub-listing` (variant `listing` du masthead unifié HeroCentered) via
// slot-forwarding (`Astro.slots.render('headline'/'lede')` + forward du slot
// `filters`). Les pages consommatrices restent INCHANGÉES. Props rétro-compat
// (listTopPad 140 / ledeMaxFont 32 / ledeReveal false) absorbent les deltas vs
// le rendu catalogue figé → la sweep /preview reste verte.
//
// Le pattern liste/grid est géré par le slot `list` — la page utilisatrice choisit
// EditorialWriteRow (writing-index), EditorialCaseCard grid (cases-index), ou autre.

import Base from '../../layouts/Base.astro';
import HeroCentered from '../sections/HeroCentered.astro';
import CtaBandSection from '../sections/CtaBandSection.astro';
import type { SectionByType } from '../../schemas/sections';
import { langFromPath, localizeHref } from '../../lib/i18n';

interface Props {
  title: string;
  description: string;
  /** Section éditoriale (Cas clients, Notes, Cookbooks…) */
  kicker: string;
}
const { title, description, kicker } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const listLabel = title.split(' · ')[0];
const hasFilters = Astro.slots.has('filters');

// Slot-forwarding : les slots headline/lede (rich text `<i>`) → champs `set:html` du composant.
const h1Html = await Astro.slots.render('headline');
const ledeHtml = await Astro.slots.render('lede');

const heroData = {
  type: 'hero-hub-listing',
  kicker_fr: kicker,
  kicker_en: kicker,
  h1_fr: h1Html,
  h1_en: h1Html,
  lede_fr: ledeHtml,
  lede_en: ledeHtml,
  decoration: false,
} satisfies SectionByType<'hero-hub-listing'>;

const ctaData = {
  type: 'cta-band',
  text_fr: `Après ${listLabel}, passons à votre cas réel et à votre premier livrable utile.`,
  text_en: `After ${listLabel}, let us move to your real use case and your first useful deliverable.`,
  cta: {
    label_fr: 'Réserver un audit →',
    label_en: 'Book an audit →',
    href: localizeHref('/contact', lang),
    variant: 'primary',
  },
  background: 'paper-2',
} satisfies SectionByType<'cta-band'>;
---
<Base title={title} description={description}>
  {/* MASTHEAD · composant catalogué hero-hub-listing (deltas absorbés par props rétro-compat) */}
  <HeroCentered
    data={heroData}
    lang={lang}
    listTopPad="140px"
    ledeMaxFont="32px"
    ledeReveal={false}
    showFilters={hasFilters}
    listBorder={true}
  >
    <slot name="filters" slot="filters" />
  </HeroCentered>

  {/* LIST (slot ouvert) */}
  <section class="list-body">
    <div class="wrap-wide">
      <slot name="list" />
    </div>
  </section>

  <CtaBandSection data={ctaData} lang={lang} />
</Base>

<style>
  .list-body { padding: clamp(60px, 8vw, 100px) var(--space-6); }
</style>
