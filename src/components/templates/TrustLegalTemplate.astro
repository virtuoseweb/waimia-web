---
// Template · TrustLegalTemplate · pages confiance / conformité / docs légales
//
// Mapping handoff2 :
//  - trust-center.html → /agence/trust-center
//  - governance.html   → /agence/governance
//  - docs.html         → /agence/docs
//
// Squelette · masthead minimaliste + TOC sticky gauche + sections H2/H3 empilées
// + footer signataires/dates revision.
//
// Composé de · TrustLegalSection (section cataloguée : masthead + TOC + slot sections) · CtaBandSection (section)
//
// Décision · TOC sticky gauche : pattern visuel récurrent dans handoff2 trust-center.
// Pas extrait en molécule — usage 1× par page (le TOC est généré depuis les sections
// passées en prop). Si un autre template a besoin d'un TOC sticky, on extrait alors.

import Base from '../../layouts/Base.astro';
import MastheadBar from '../sections/MastheadBar.astro';
import CtaBandSection from '../sections/CtaBandSection.astro';
import TrustLegalSection from '../sections/TrustLegalSection.astro';
import type { SectionByType } from '../../schemas/sections';
import { langFromPath, localizeHref } from '../../lib/i18n';

interface Section {
  /** Anchor id (slug) */
  id: string;
  /** Titre de section (h2) — bilingue */
  title_fr: string;
  title_en: string;
}
interface Props {
  title: string;
  description: string;
  /** Kicker section (Trust Center, Governance, Docs) */
  kickerFr: string;
  kickerEn: string;
  /** Date de dernière révision (ISO) */
  revisedAt: string;
  /** Versionnage doc (ex: v2.4.1) */
  version?: string;
  /** Sections affichées dans le TOC sticky */
  sections: Section[];
}
const { title, description, kickerFr, kickerEn, revisedAt, version, sections } = Astro.props as Props;

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: `https://waimia.com${Astro.url.pathname}`,
  dateModified: revisedAt,
  inLanguage: 'fr-FR',
  isPartOf: { '@type': 'WebSite', '@id': 'https://waimia.com/#website' },
};

const lang = langFromPath(Astro.url.pathname);
const isFr = lang === 'fr';

const ctaData = {
  type: 'cta-band',
  text_fr: `${kickerFr} relisible, arbitrable et exploitable côté équipe.`,
  text_en: `${kickerEn} you can review, arbitrate, and operationalize with your team.`,
  cta: {
    label_fr: 'Réserver un audit →',
    label_en: 'Book an audit →',
    href: localizeHref('/contact', lang),
    variant: 'primary',
  },
  background: 'paper-2',
} satisfies SectionByType<'cta-band'>;
---
<Base title={title} description={description} jsonLd={webPageLd}>
  <MastheadBar
    lang={lang}
    items={[
      { label: isFr ? 'Accueil' : 'Home', href: isFr ? '/' : '/en' },
      { label: isFr ? "L'Agence" : 'The Agency', href: isFr ? '/agence' : '/en/agence' },
      { label: isFr ? kickerFr : kickerEn },
    ]}
  />
  {/* MASTHEAD + BODY · délégué à la section cataloguée trust-legal-section */}
  <TrustLegalSection
    lang={lang}
    kickerFr={kickerFr}
    kickerEn={kickerEn}
    revisedAt={revisedAt}
    version={version}
    sections={sections}
  >
    <slot name="headline" slot="headline" />
    <slot name="lede" slot="lede" />
    <slot name="footer-legal" slot="footer-legal" />
    <slot name="sections" slot="sections" />
  </TrustLegalSection>

  <CtaBandSection data={ctaData} lang={lang} />
</Base>
