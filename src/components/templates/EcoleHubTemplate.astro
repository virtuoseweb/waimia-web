---
import type { CollectionEntry } from 'astro:content';
import HeroCentered from '../sections/HeroCentered.astro';
import type { SectionByType } from '../../schemas/sections';

interface Props {
  formations: Array<CollectionEntry<"courses">>;
  parcours: Array<CollectionEntry<"courses">>;
  ateliers: Array<CollectionEntry<"courses">>;
  lang: "fr" | "en";
}

const { formations, parcours, ateliers, lang } = Astro.props;

const heroTitleFr = "Apprendre à câbler l'<i>IA</i>";
const heroTitleEn = "Learn to wire <i>AI</i>";
const heroLedeFr = "Formations courtes, cas réels, zéro bullshit. Pour dirigeants et équipes PME B2B qui veulent des résultats mesurables dans les 30 jours.";
const heroLedeEn = "Short courses, real cases, no fluff. For SMB leaders and teams who want measurable results within 30 days.";
const kickerTextFr = `École Waimia · Catalogue · Inscriptions ouvertes`;
const kickerTextEn = `Waimia School · Catalog · Enrollments open`;
const statsLabelFr = `${formations.length} formation${formations.length > 1 ? 's' : ''} · ${parcours.length} parcours · ${ateliers.length} atelier${ateliers.length > 1 ? 's' : ''}`;
const statsLabelEn = `${formations.length} course${formations.length > 1 ? 's' : ''} · ${parcours.length} program${parcours.length > 1 ? 's' : ''} · ${ateliers.length} workshop${ateliers.length > 1 ? 's' : ''}`;

const heroData = {
  type: 'hero-academy-hub',
  kicker_fr: kickerTextFr,
  kicker_en: kickerTextEn,
  h1_fr: heroTitleFr,
  h1_en: heroTitleEn,
  lede_fr: heroLedeFr,
  lede_en: heroLedeEn,
  stats_label_fr: statsLabelFr,
  stats_label_en: statsLabelEn,
} satisfies SectionByType<'hero-academy-hub'>;

const levelLabels: Record<string, Record<string, string>> = {
  fr: { debutant: 'Débutant', intermediaire: 'Intermédiaire', avance: 'Avancé', expert: 'Expert' },
  en: { debutant: 'Beginner', intermediaire: 'Intermediate', avance: 'Advanced', expert: 'Expert' },
};

const catalogueTitle = lang === 'fr' ? 'Catalogue formations' : 'Course catalog';
const parcoursTitle = lang === 'fr' ? 'Parcours' : 'Learning paths';
const ctaText = lang === 'fr' ? 'Demander un parcours sur mesure' : 'Request a custom learning path';
---

<section class="ecole-hub">
  <!-- HERO -->
  <HeroCentered data={heroData} lang={lang} wrap={false} topPad="48px" />

  <!-- CATALOGUE FORMATIONS -->
  {formations.length > 0 && (
    <div class="catalogue">
      <h2 class="section-title">{catalogueTitle}</h2>
      <div class="catalogue-table">
        <div class="table-header">
          <span class="col-num">#</span>
          <span class="col-titre">{lang === 'fr' ? 'Titre' : 'Title'}</span>
          <span class="col-niveau">{lang === 'fr' ? 'Niveau' : 'Level'}</span>
          <span class="col-duree">{lang === 'fr' ? 'Durée' : 'Duration'}</span>
          <span class="col-prix">{lang === 'fr' ? 'Prix' : 'Price'}</span>
          <span class="col-action"></span>
        </div>
        {formations.map((entry, i) => {
          const d = entry.data as any;
          const title = lang === 'fr' ? d.title_fr : d.title_en;
          const level = levelLabels[lang][d.level] ?? d.level;
          const price = d.pricing?.one_time_eur;
          const priceStr = price === 0
            ? (lang === 'fr' ? 'Gratuit' : 'Free')
            : price != null
              ? `${price} €`
              : '—';
          return (
            <a class="table-row" href={`/ecole/cours/${entry.id}`}>
              <span class="col-num mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="col-titre row-title">{title}</span>
              <span class="col-niveau">
                <span class={`pill pill--${d.level}`}>{level}</span>
              </span>
              <span class="col-duree mono">{d.duration_hours}h</span>
              <span class="col-prix mono">{priceStr}</span>
              <span class="col-action arrow">→</span>
            </a>
          );
        })}
      </div>
    </div>
  )}

  <!-- SECTION PARCOURS -->
  {parcours.length > 0 && (
    <div class="parcours-section">
      <h2 class="section-title">{parcoursTitle}</h2>
      <div class="parcours-list">
        {parcours.map((p) => {
          const title = lang === 'fr' ? p.data.title_fr : p.data.title_en;
          const description = lang === 'fr' ? p.data.description_fr : p.data.description_en;
          return (
            <div class="parcours-item">
              <span class="parcours-title">{title}</span>
              <p class="parcours-desc">{description}</p>
            </div>
          );
        })}
      </div>
    </div>
  )}

  <!-- CTA FINALE -->
  <div class="cta-finale">
    <a href="/contact" class="cta-link">{ctaText} →</a>
  </div>
</section>

<style>
  .ecole-hub {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--space-page-x, 24px);
    background: var(--paper);
  }

  /* Masthead migré vers le composant catalogué `HeroAcademyHub` (sections/).
     Règles `.hero/.kicker/.heading/.lede/.stats-bande/.stats-text`
     supprimées (structure + CSS désormais portés par le composant — source unique). */

  /* CATALOGUE */
  .catalogue {
    padding-top: var(--space-8);
  }

  .section-title {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted, #888);
    margin: 0 0 var(--space-5);
    font-weight: var(--fw-regular);
  }

  .catalogue-table {
    border-top: 1px solid var(--hairline);
  }

  .table-header {
    display: grid;
    grid-template-columns: 40px 1fr 130px 70px 80px 32px;
    gap: 0 var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--hairline);
  }

  .table-header span {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted, #888);
  }

  .table-row {
    display: grid;
    grid-template-columns: 40px 1fr 130px 70px 80px 32px;
    gap: 0 var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--hairline);
    text-decoration: none;
    color: inherit;
    align-items: center;
    transition: background 0.15s;
  }

  .table-row:hover {
    background: color-mix(in srgb, var(--accent) 4%, transparent);
  }

  .col-num {
    font-family: var(--font-mono);
    font-size: var(--text-ui);
    color: var(--text-muted, #888);
  }

  .row-title {
    font-family: var(--font-sans);
    font-size: var(--text-body-lead);
    font-weight: var(--fw-medium);
    color: var(--ink);
  }

  .mono {
    font-family: var(--font-mono);
    font-size: var(--text-ui);
  }

  .pill {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px var(--space-2);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
  }

  .pill--debutant { color: #3a7d44; border-color: #3a7d44; }
  .pill--intermediaire { color: var(--accent); border-color: var(--accent); }
  .pill--avance { color: #7b4ea6; border-color: #7b4ea6; }
  .pill--expert { color: var(--ink); border-color: var(--ink); }

  .arrow {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    color: var(--accent);
    text-align: right;
  }

  /* PARCOURS */
  .parcours-section {
    padding-top: 56px;
    padding-bottom: var(--space-4);
  }

  .parcours-list {
    border-top: 1px solid var(--hairline);
  }

  .parcours-item {
    padding: 20px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .parcours-title {
    font-family: var(--font-sans);
    font-size: var(--text-body-lead);
    font-weight: var(--fw-semibold);
    display: block;
    margin-bottom: 6px;
  }

  .parcours-desc {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--text-secondary, #444);
    margin: 0;
    line-height: var(--leading-body);
  }

  /* CTA FINALE */
  .cta-finale {
    padding: 56px 0 72px;
    border-top: 1px solid var(--hairline);
    margin-top: var(--space-5);
  }

  .cta-link {
    font-family: var(--font-sans);
    font-size: var(--text-body-lead);
    font-weight: var(--fw-medium);
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s;
  }

  .cta-link:hover {
    color: var(--accent);
  }

  @media (max-width: 700px) {
    .table-header {
      display: none;
    }

    .table-row {
      grid-template-columns: 32px 1fr 80px 32px;
      grid-template-rows: auto auto;
    }

    .col-niveau { display: none; }
    .col-duree { display: none; }
  }
</style>
