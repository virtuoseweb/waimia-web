---
// feature-split-media (feature-sections) — feature majeure : texte + mockup, champ reversed.
// Dark natif (data-bg). Texte aligné à gauche dans sa colonne ; reversed inverse l'ordre visuel.
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';
import Button from '../ui/atoms/Button.astro';

interface Props {
  data: SectionByType<'feature-split-media'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const points = data.points ?? [];
const ctaLabel = isFr ? data.cta_label_fr : data.cta_label_en;
const mediaCaption = isFr ? data.media_caption_fr : data.media_caption_en;

// ── Couche atomique (Vague C) : placement par région (header + media + actions + body).
// Résolution raccourci↔placement (0 double source) : valeur effective calculée UNE fois,
// UN seul data-attr posé par région. `placement.header.align` surcharge `contentAlign` ;
// `placement.actions.justify` surcharge `actionsAlign` (spread → between) ;
// `placement.media.order` complète/prime sur mediaSide. Défaut absent = rendu actuel.
const pl = data.placement;
const headerAlign = pl?.header?.align ?? data.contentAlign;
const bodyAlign = pl?.body?.align;
const actionsJustify =
  pl?.actions?.justify ?? (data.actionsAlign === 'spread' ? 'between' : data.actionsAlign);
const mediaOrder = pl?.media?.order;
const headerHide = pl?.header?.hideOn;
const mediaHide = pl?.media?.hideOn;
const actionsHide = pl?.actions?.hideOn;
const bodyHide = pl?.body?.hideOn;
---

<section
  class:list={['feature-split sec-base', { 'feature-split--sticky-media': data.media_sticky }]}
  data-bg={data.background}
  data-reversed={data.reversed ? 'true' : 'false'}
  data-layout={data.layout}
  data-proportion={data.proportion}
  data-media-side={data.mediaSide}
  data-density={data.density}
  data-actions-placed={actionsJustify ? 'true' : undefined}
  data-media-placed={mediaOrder !== undefined ? 'true' : undefined}
>
  <div class="wrap-wide feature-split__grid">
    <div
      class="feature-split__copy"
      data-header-align={headerAlign}
      data-header-hide={headerHide}
    >
      {(isFr ? data.kicker_fr : data.kicker_en) && (
        <Kicker tone="muted">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      )}
      <h2 set:html={isFr ? data.h2_fr : data.h2_en} />
      <p class="feature-split__body" data-body-align={bodyAlign} data-body-hide={bodyHide}>{isFr ? data.body_fr : data.body_en}</p>
      {points.length > 0 && (
        <ul class="feature-split__points">
          {points.map((p: (typeof points)[number]) => (
            <li>{isFr ? p.label_fr : p.label_en}</li>
          ))}
        </ul>
      )}
      {ctaLabel && data.cta_href && (
        <div class="feature-split__cta" data-actions-justify={actionsJustify} data-actions-hide={actionsHide}>
          <Button href={data.cta_href} variant="ghost" size="md">{ctaLabel}</Button>
        </div>
      )}
    </div>

    <figure class="feature-split__media" data-media-order={mediaOrder} data-media-hide={mediaHide}>
      <div class="feature-split__frame">
        {/* media_alt fourni = image de contenu ; vide = decorative assumee (WCAG 1.1.1). */}
        {data.media_src ? (
          <img src={data.media_src} alt={(isFr ? data.media_alt_fr : data.media_alt_en) ?? ''} loading="lazy" />
        ) : (
          <span class="feature-split__placeholder" aria-hidden="true" />
        )}
      </div>
      {mediaCaption && <figcaption>{mediaCaption}</figcaption>}
    </figure>
  </div>
</section>

<style>
  /* Grille : consomme --sec-grid posé par data-layout (layouts.css, presets
     split-1-2 / split-2-1). Absent → ratio symétrique 1fr 1fr (défaut historique). */
  .feature-split__grid {
    display: grid;
    grid-template-columns: var(--sec-grid, 1fr 1fr);
    gap: clamp(var(--space-8), 6vw, var(--space-12));
    align-items: center;
  }
  /* Inversion visuelle locale (cas sans data-layout / ratio symétrique). Pour les
     paires asym, layouts.css gère aussi [data-reversed] sur les enfants directs. */
  .feature-split[data-reversed='true'] .feature-split__copy { order: 2; }
  .feature-split[data-reversed='true'] .feature-split__media { order: 1; }

  /* ── Axe PROPORTION (data-proportion) : ratio des colonnes texte|média. Classe + attribut
     => spécificité supérieure au [data-layout] global de layouts.css (proportion gagne si
     les deux sont présents). Défaut (absent) = --sec-grid hérité de layout ou 1fr 1fr. ── */
  .feature-split[data-proportion='1-1'] .feature-split__grid { grid-template-columns: 1fr 1fr; }
  .feature-split[data-proportion='1-2'] .feature-split__grid { grid-template-columns: 1fr 2fr; }
  .feature-split[data-proportion='2-1'] .feature-split__grid { grid-template-columns: 2fr 1fr; }
  .feature-split[data-proportion='2-3'] .feature-split__grid { grid-template-columns: 2fr 3fr; }
  .feature-split[data-proportion='3-2'] .feature-split__grid { grid-template-columns: 3fr 2fr; }

  /* ── Axe MEDIA-SIDE (data-media-side) : côté du média en desktop, INDÉPENDANT du ratio.
     'left' = média avant le texte ; 'right' = média après (défaut quand absent). ── */
  .feature-split[data-media-side='left'] .feature-split__media { order: 1; }
  .feature-split[data-media-side='left'] .feature-split__copy { order: 2; }
  .feature-split[data-media-side='right'] .feature-split__media { order: 2; }
  .feature-split[data-media-side='right'] .feature-split__copy { order: 1; }

  /* ── Axe DENSITY (data-density) : gap de la grille + padding du bloc texte. Tokens --space-*. ── */
  .feature-split[data-density='compact'] .feature-split__grid { gap: var(--space-6); }
  .feature-split[data-density='compact'] .feature-split__copy { gap: var(--space-3); }
  .feature-split[data-density='base'] .feature-split__grid { gap: var(--space-8); }
  .feature-split[data-density='ample'] .feature-split__grid { gap: var(--space-12); }
  .feature-split[data-density='ample'] .feature-split__copy { gap: var(--space-5); }

  /* ── COUCHE ATOMIQUE (Vague C) · placement par région (header + media + actions + body).
     UN SEUL data-attr par région. `data-header-align` résout `placement.header.align ?? contentAlign`.
     `data-actions-justify` résout `placement.actions.justify ?? actionsAlign`, INDÉPENDANT du header.
     `data-media-order` résout `placement.media.order` (prime sur mediaSide). `data-body-align`
     aligne le paragraphe body seul. Défaut absent = rendu actuel. ── */

  /* Région HEADER : alignement du bloc texte (align-self + text-align). Défaut = start. */
  .feature-split__copy[data-header-align='center'] { align-items: center; text-align: center; }
  .feature-split__copy[data-header-align='center'] :is(h2, .feature-split__body) { max-width: none; margin-inline: auto; }
  .feature-split__copy[data-header-align='end'] { align-items: flex-end; text-align: end; }

  /* Région BODY : alignement du paragraphe body seul (text-align), indépendant du header. */
  .feature-split__body[data-body-align='center'] { text-align: center; max-width: none; margin-inline: auto; }
  .feature-split__body[data-body-align='end'] { text-align: end; margin-inline-start: auto; }

  /* Région ACTIONS : justify-content du cluster CTA, INDÉPENDANT du contenu (cas d'école
     « bouton au centre sans décaler le titre »). between = space-between. */
  .feature-split__cta[data-actions-justify] { display: flex; }
  .feature-split__cta[data-actions-justify='start'] { justify-content: flex-start; }
  .feature-split__cta[data-actions-justify='center'] { justify-content: center; }
  .feature-split__cta[data-actions-justify='end'] { justify-content: flex-end; }
  .feature-split__cta[data-actions-justify='between'] { justify-content: space-between; }

  /* Région MEDIA · ORDER : réordonne média↔texte. Prime sur mediaSide (le sélecteur est
     scopé sous [data-media-placed] → spécificité supérieure aux règles data-media-side, qui
     sont ainsi écrasées). 0 = média avant le texte ; 1 = média après. order = structurel. */
  .feature-split[data-media-placed] .feature-split__media[data-media-order='0'] { order: 0; }
  .feature-split[data-media-placed] .feature-split__copy:has(~ .feature-split__media[data-media-order='0']) { order: 1; }
  .feature-split[data-media-placed] .feature-split__media[data-media-order='1'] { order: 1; }
  .feature-split[data-media-placed] .feature-split__copy:has(~ .feature-split__media[data-media-order='1']) { order: 0; }

  /* Région · HIDE-ON (visibilité responsive). 768px = breakpoint structurel. */
  .feature-split__copy[data-header-hide='desktop'],
  .feature-split__media[data-media-hide='desktop'],
  .feature-split__cta[data-actions-hide='desktop'],
  .feature-split__body[data-body-hide='desktop'] { display: none; }
  @media (max-width: 768px) {
    .feature-split__copy[data-header-hide='mobile'],
    .feature-split__media[data-media-hide='mobile'],
    .feature-split__cta[data-actions-hide='mobile'],
    .feature-split__body[data-body-hide='mobile'] { display: none; }
    .feature-split__copy[data-header-hide='desktop'] { display: flex; }
    .feature-split__media[data-media-hide='desktop'] { display: flex; }
    .feature-split__cta[data-actions-hide='desktop'] { display: flex; }
    .feature-split__body[data-body-hide='desktop'] { display: block; }
  }
  .feature-split__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }
  h2 {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-h2);
    line-height: var(--leading-h3);
    color: var(--ink);
    margin: 0;
    max-width: 18ch;
  }
  .feature-split__body {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--muted);
    line-height: var(--leading-prose);
    max-width: 52ch;
    margin: 0;
  }
  .feature-split__points {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .feature-split__points li {
    position: relative;
    padding-left: var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--ink);
    line-height: var(--leading-body);
  }
  .feature-split__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border: 1px solid var(--accent);
    border-radius: var(--radius-full);
  }
  .feature-split__cta { margin-top: var(--space-3); }
  .feature-split__media {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  /* Variante sticky (opt-in) : le média colle en haut pendant le scroll du texte
     plus long. Bascule l'alignement de la grille sur start pour que sticky ait
     un effet, et fige le média à top var(--space-7). Défaut (absent) = inchangé. */
  .feature-split--sticky-media .feature-split__grid { align-items: start; }
  .feature-split--sticky-media .feature-split__media {
    position: sticky;
    top: var(--space-7);
  }
  @media (max-width: 860px) {
    /* Empilé : pas de sticky (le média précède/suit le texte, plus de colonne). */
    .feature-split--sticky-media .feature-split__media { position: static; }
  }
  .feature-split__frame {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    background: var(--paper-2);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
  }
  .feature-split__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .feature-split__placeholder {
    width: 100%;
    height: 100%;
    background:
      repeating-linear-gradient(
        135deg,
        var(--hairline) 0,
        var(--hairline) 1px,
        transparent 1px,
        transparent 14px
      );
  }
  .feature-split__media figcaption {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    /* Empilé : 1 colonne quel que soit l'axe (proportion a une spécificité supérieure
       => on neutralise explicitement chaque ratio sur le bloc concerné). */
    .feature-split__grid,
    .feature-split[data-proportion='1-1'] .feature-split__grid,
    .feature-split[data-proportion='1-2'] .feature-split__grid,
    .feature-split[data-proportion='2-1'] .feature-split__grid,
    .feature-split[data-proportion='2-3'] .feature-split__grid,
    .feature-split[data-proportion='3-2'] .feature-split__grid { grid-template-columns: 1fr; gap: var(--space-7); }
    /* Ordre de lecture (copy puis média) restauré : on annule reversed, media-side ET
       l'order atomique de la couche placement (le texte ne doit jamais passer sous l'image
       de façon absurde sur mobile). */
    .feature-split[data-reversed='true'] .feature-split__copy,
    .feature-split[data-reversed='true'] .feature-split__media,
    .feature-split[data-media-side] .feature-split__copy,
    .feature-split[data-media-side] .feature-split__media,
    .feature-split__media[data-media-order],
    .feature-split__copy:has(~ .feature-split__media[data-media-order]) { order: 0; }
  }
  /* ── Dark natif (docs/43) · remap scopé aux enfants ── */
  .feature-split[data-bg='paper-2'] { background: var(--paper-2); }
  .feature-split[data-bg='paper-3'] { background: var(--paper-3); }
  .feature-split[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .feature-split[data-bg='ink'] :is(h2) { color: var(--paper); }
  .feature-split[data-bg='ink'] .feature-split__points li { color: var(--paper); }
  .feature-split[data-bg='ink'] .feature-split__frame { background: rgba(var(--paper-rgb), 0.05); }
</style>
