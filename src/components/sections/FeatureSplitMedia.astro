---
// feature-split-media (feature-sections) — feature majeure : texte + mockup, champ reversed.
// Dark natif (data-bg). Texte aligné à gauche dans sa colonne ; reversed inverse l'ordre visuel.
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';
import Button from '../ui/atoms/Button.astro';

interface Props {
  data: SectionByType<'feature-split-media'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const points = data.points ?? [];
const ctaLabel = isFr ? data.cta_label_fr : data.cta_label_en;
const mediaCaption = isFr ? data.media_caption_fr : data.media_caption_en;
---

<section class="feature-split sec-base" data-bg={data.background} data-reversed={data.reversed ? 'true' : 'false'}>
  <div class="wrap-wide feature-split__grid">
    <div class="feature-split__copy">
      {(isFr ? data.kicker_fr : data.kicker_en) && (
        <Kicker tone="muted">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      )}
      <h2 set:html={isFr ? data.h2_fr : data.h2_en} />
      <p class="feature-split__body">{isFr ? data.body_fr : data.body_en}</p>
      {points.length > 0 && (
        <ul class="feature-split__points">
          {points.map((p: (typeof points)[number]) => (
            <li>{isFr ? p.label_fr : p.label_en}</li>
          ))}
        </ul>
      )}
      {ctaLabel && data.cta_href && (
        <div class="feature-split__cta">
          <Button href={data.cta_href} variant="ghost" size="md">{ctaLabel}</Button>
        </div>
      )}
    </div>

    <figure class="feature-split__media">
      <div class="feature-split__frame">
        {data.media_src ? (
          <img src={data.media_src} alt={(isFr ? data.media_alt_fr : data.media_alt_en) ?? ''} loading="lazy" />
        ) : (
          <span class="feature-split__placeholder" aria-hidden="true" />
        )}
      </div>
      {mediaCaption && <figcaption>{mediaCaption}</figcaption>}
    </figure>
  </div>
</section>

<style>
  .feature-split__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(var(--space-8), 6vw, var(--space-12));
    align-items: center;
  }
  .feature-split[data-reversed='true'] .feature-split__copy { order: 2; }
  .feature-split[data-reversed='true'] .feature-split__media { order: 1; }
  .feature-split__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }
  h2 {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-h2);
    line-height: var(--leading-h3);
    color: var(--ink);
    margin: 0;
    max-width: 18ch;
  }
  .feature-split__body {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--muted);
    line-height: var(--leading-prose);
    max-width: 52ch;
    margin: 0;
  }
  .feature-split__points {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .feature-split__points li {
    position: relative;
    padding-left: var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--ink);
    line-height: var(--leading-body);
  }
  .feature-split__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border: 1px solid var(--accent);
    border-radius: var(--radius-full);
  }
  .feature-split__cta { margin-top: var(--space-3); }
  .feature-split__media {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .feature-split__frame {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    background: var(--paper-2);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
  }
  .feature-split__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .feature-split__placeholder {
    width: 100%;
    height: 100%;
    background:
      repeating-linear-gradient(
        135deg,
        var(--hairline) 0,
        var(--hairline) 1px,
        transparent 1px,
        transparent 14px
      );
  }
  .feature-split__media figcaption {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .feature-split__grid { grid-template-columns: 1fr; gap: var(--space-7); }
    .feature-split[data-reversed='true'] .feature-split__copy,
    .feature-split[data-reversed='true'] .feature-split__media { order: 0; }
  }
  /* ── Dark natif (docs/43) · remap scopé aux enfants ── */
  .feature-split[data-bg='paper-2'] { background: var(--paper-2); }
  .feature-split[data-bg='paper-3'] { background: var(--paper-3); }
  .feature-split[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .feature-split[data-bg='ink'] :is(h2) { color: var(--paper); }
  .feature-split[data-bg='ink'] .feature-split__points li { color: var(--paper); }
  .feature-split[data-bg='ink'] .feature-split__frame { background: rgba(var(--paper-rgb), 0.05); }
</style>
