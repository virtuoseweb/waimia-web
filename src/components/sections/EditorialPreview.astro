---
// Section W6 · editorial-preview
// Index de publications en lignes : num · date · tag · titre · flèche.
// Markup + style = copie VERBATIM de `FieldNotes.astro` (Acte VI — Notes de terrain).
import SectionHeader from '../ui/molecules/SectionHeader.astro';
import type { SectionByType } from '../../schemas/sections';

interface Props {
  data: SectionByType<'editorial-preview'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---
<section class="sec" aria-labelledby="notes-h2" data-bg={data.background}>
  <div class="wrap-wide">
    <SectionHeader
      roman={data.roman}
      label={isFr ? data.act_label_fr : data.act_label_en}
      id="notes-h2"
    >
      <Fragment slot="heading" set:html={isFr ? data.h2_fr : data.h2_en} />
      <Fragment slot="aside">
        {isFr ? data.aside_fr : data.aside_en}
      </Fragment>
    </SectionHeader>

    <ul class="notes-index reveal-stagger">
      {data.items.map((note, i) => (
        <li>
          <a class="notes-row" href={note.href}>
            <span class="notes-row-num">{`0${i + 1}`}</span>
            <span class="notes-row-date">{isFr ? note.date_fr : note.date_en}</span>
            <span class="notes-row-tag">{isFr ? note.tag_fr : note.tag_en}</span>
            <span class="notes-row-text">{isFr ? note.label_fr : note.label_en}</span>
            <span class="notes-row-arr" aria-hidden>→</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="notes-foot">
      <a href={data.all_href} class="notes-foot-link">
        {isFr ? data.all_label_fr : data.all_label_en}
      </a>
    </div>
  </div>
</section>

<style>
  /* V6 densification · refactor card grid → index éditorial linéaire (anti-card-fatigue) */
  .sec[aria-labelledby="notes-h2"] {
    padding: var(--section-base) 0;
  }

  .notes-index {
    list-style: none;
    padding: 0;
    margin: clamp(20px, 2.5vw, 32px) 0 0;
    border-top: 1px solid var(--hairline-strong);
  }

  .notes-row {
    display: grid;
    grid-template-columns: 48px 80px 110px 1fr 32px;
    gap: clamp(16px, 1.8vw, 28px);
    padding: clamp(16px, 1.8vw, 24px) 0;
    border-bottom: 1px solid var(--hairline);
    align-items: baseline;
    color: inherit;
    text-decoration: none;
    transition: background var(--dur-trim) var(--ease), padding-left 320ms var(--ease), padding-right 320ms var(--ease);
  }

  .notes-row:hover {
    background: rgba(var(--accent-rgb), 0.04);
    padding-left: 14px;
    padding-right: 14px;
  }

  .notes-row:hover .notes-row-text {
    color: var(--accent);
  }

  .notes-row:hover .notes-row-arr {
    color: var(--accent);
    transform: translateX(4px);
  }

  .notes-row-num {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .notes-row-date {
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .notes-row-tag {
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--ink-2);
  }

  /* H3 row token sémantique · cf tokens.css */
  .notes-row-text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-h3-row);
    line-height: var(--leading-h3);
    letter-spacing: -0.015em;
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease);
    text-wrap: balance;
  }

  .notes-row-arr {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    color: var(--muted);
    text-align: right;
    transition: color 240ms var(--ease), transform 320ms var(--ease);
  }

  .notes-foot {
    margin-top: clamp(20px, 2.5vw, 36px);
    text-align: right;
  }

  .notes-foot-link {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 2px;
  }

  @media (max-width: 900px) {
    .notes-row {
      grid-template-columns: 60px 1fr;
      row-gap: 6px;
    }
    .notes-row-date, .notes-row-tag {
      grid-column: 2;
    }
    .notes-row-text {
      grid-column: 1 / -1;
      font-size: clamp(18px, 4.5vw, 22px);
    }
    .notes-row-arr {
      display: none;
    }
  }

  /* ── Alternance des fonds R4 · defaut paper = rendu inchange ── */
  .sec[aria-labelledby="notes-h2"][data-bg='paper-2'] { background: var(--paper-2); }
  .sec[aria-labelledby="notes-h2"][data-bg='paper-3'] { background: var(--paper-3); }

  /* ── Idiome dark (ink) — fond sombre soigne, contraste AA ── */
  .sec[aria-labelledby="notes-h2"][data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
    --muted: rgba(var(--paper-rgb), 0.64);
    --hairline: rgba(var(--paper-rgb), 0.14);
    --hairline-strong: rgba(var(--paper-rgb), 0.28);
  }
  .sec[aria-labelledby="notes-h2"][data-bg='ink'] :global(.sec-hd h2) { color: var(--paper); }
  .sec[aria-labelledby="notes-h2"][data-bg='ink'] :global(.sec-hd .aside) { color: var(--muted); }
  .sec[aria-labelledby="notes-h2"][data-bg='ink'] .notes-index { border-top-color: var(--hairline-strong); }
  .sec[aria-labelledby="notes-h2"][data-bg='ink'] .notes-row { border-bottom-color: var(--hairline); }
  .sec[aria-labelledby="notes-h2"][data-bg='ink'] .notes-row-text { color: var(--paper); }
  .sec[aria-labelledby="notes-h2"][data-bg='ink'] .notes-row-date,
  .sec[aria-labelledby="notes-h2"][data-bg='ink'] .notes-row-arr { color: var(--muted); }
  .sec[aria-labelledby="notes-h2"][data-bg='ink'] .notes-row-tag { color: rgba(var(--paper-rgb), 0.82); }
  .sec[aria-labelledby="notes-h2"][data-bg='ink'] .notes-row:hover { background: rgba(var(--paper-rgb), 0.05); }
</style>
