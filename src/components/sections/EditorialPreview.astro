---
// Section W6 · editorial-preview
// Index de publications en lignes numérotées : num · date · tag · titre · flèche. Source : FieldNotes.astro.
import type { SectionByType } from '../../schemas/sections';

interface Props {
  data: SectionByType<'editorial-preview'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---

<section class="editorial-preview" aria-labelledby="editorial-preview-h2">
  <div class="wrap-wide">
    {(data.kicker_fr || data.kicker_en) && (
      <p class="editorial-preview__kicker">
        {isFr ? data.kicker_fr : data.kicker_en}
      </p>
    )}
    <h2 id="editorial-preview-h2" class="editorial-preview__h2 reveal">
      {isFr ? data.h2_fr : data.h2_en}
    </h2>

    <div class="editorial-preview__list reveal-stagger" role="list">
      {data.items.map((item) => (
        <a
          href={item.href}
          class="editorial-preview__row"
          role="listitem"
        >
          <span class="editorial-preview__num">{item.num}</span>
          <span class="editorial-preview__date">{isFr ? item.date_fr : item.date_en}</span>
          <span class="editorial-preview__tag">{isFr ? item.tag_fr : item.tag_en}</span>
          <span class="editorial-preview__label">
            <i>{isFr ? item.label_fr : item.label_en}</i>
          </span>
          <span class="editorial-preview__arr" aria-hidden>→</span>
        </a>
      ))}
    </div>

    {data.all_href && (
      <div class="editorial-preview__footer">
        <a href={data.all_href} class="editorial-preview__all">
          {isFr ? (data.all_label_fr ?? 'Tout voir →') : (data.all_label_en ?? 'View all →')}
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .editorial-preview {
    padding: clamp(56px, 7vw, 88px) 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .editorial-preview__kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 14px;
  }
  .editorial-preview__h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2-section);
    line-height: var(--leading-h2);
    letter-spacing: -0.025em;
    font-weight: 400;
    max-width: 760px;
    margin: 0 0 clamp(28px, 3vw, 44px);
    color: var(--ink);
    text-wrap: balance;
  }
  .editorial-preview__list {
    border-top: 1px solid var(--hairline-strong);
  }
  .editorial-preview__row {
    display: grid;
    grid-template-columns: 48px 80px 110px 1fr 32px;
    align-items: baseline;
    gap: 0 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--hairline);
    text-decoration: none;
    color: inherit;
    transition: background 280ms var(--ease);
  }
  .editorial-preview__row:hover {
    background: rgba(201, 79, 46, 0.05);
  }
  .editorial-preview__num {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .editorial-preview__date {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .editorial-preview__tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .editorial-preview__label {
    font-family: var(--font-display);
    font-size: var(--text-h3-row);
    line-height: var(--leading-h3);
    letter-spacing: -0.015em;
    color: var(--ink);
    font-weight: 400;
  }
  .editorial-preview__row:hover .editorial-preview__label {
    color: var(--accent);
  }
  .editorial-preview__arr {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--muted);
    text-align: right;
    transition: transform 280ms var(--ease);
  }
  .editorial-preview__row:hover .editorial-preview__arr {
    transform: translateX(4px);
    color: var(--accent);
  }
  .editorial-preview__footer {
    margin-top: 24px;
    display: flex;
    justify-content: flex-end;
  }
  .editorial-preview__all {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
  }
  .editorial-preview__all:hover {
    text-decoration: underline;
  }
  @media (max-width: 720px) {
    .editorial-preview__row {
      grid-template-columns: 40px 1fr 24px;
      grid-template-rows: auto auto;
    }
    .editorial-preview__date,
    .editorial-preview__tag {
      display: none;
    }
    .editorial-preview__label {
      grid-column: 2;
      grid-row: 1;
    }
    .editorial-preview__arr {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
