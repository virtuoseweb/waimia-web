---
// Section W6 · tech-integration-flow
// Position dans la stack en frise verticale numérotée (Données → Observation).
// Source : TechnologiesDetailTemplate.astro « 6. INTEGRATION FLOW »
//          + CSS .tech-sec-hd / .tech-int-flow (l.440-464, 660-720).
// - Réutilise editorial/Timeline (vertical, numbered) + editorial/Dingbat (section, sm).
// - Mapping legacy : integration_flow[] → { num, meta:label, title:label, body }.
import Kicker from '../ui/atoms/Kicker.astro';
import Timeline from '../editorial/Timeline.astro';
import Dingbat from '../editorial/Dingbat.astro';
import type { SectionByType } from '../../schemas/sections';
interface Props {
  data: SectionByType<'tech-integration-flow'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const events = data.steps.map((s) => ({
  num: s.num,
  meta: isFr ? s.label_fr : s.label_en,
  title: isFr ? s.label_fr : s.label_en,
  body: isFr ? s.body_fr : s.body_en,
  variant: 'default' as const,
}));
---
<section class="tech-sec tech-sec-paper tech-integration" data-bg={data.background} data-screen-label="06 Integration">
  <div class="wrap">
    <div class="tech-sec-hd">
      <div>
        <Kicker>{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
        <h2 set:html={isFr ? data.title_fr : data.title_en} />
      </div>
      {(isFr ? data.aside_fr : data.aside_en) && (
        <p class="tech-aside">{isFr ? data.aside_fr : data.aside_en}</p>
      )}
    </div>
    <div class="tech-int-flow reveal-stagger">
      <Dingbat variant="section" size="sm" />
      <Timeline events={events} orientation="vertical" numbered={true} />
    </div>
  </div>
</section>

<style>
  /* ───── Sec common + header (COPIE VERBATIM TechnologiesDetailTemplate.astro) ───── */
  .tech-sec { padding: var(--section-loose) 0; position: relative; }
  .tech-sec-paper { background: var(--paper-2); }
  .tech-sec-hd {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 4vw, 80px);
    margin-bottom: clamp(40px, 5vw, 64px);
    align-items: end;
  }
  .tech-sec-hd h2 {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 72px);
    line-height: var(--leading-h1);
    letter-spacing: -0.018em;
    font-weight: var(--fw-regular);
    margin: var(--space-2) 0 0;
  }
  .tech-sec-hd :global(i) { color: var(--accent); font-style: italic; }
  .tech-aside {
    font-family: var(--font-display);
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: var(--leading-body);
    color: var(--muted);
    font-style: italic;
    max-width: 480px;
    margin: 0;
  }

  /* ───── Integration Flow (signature) — COPIE VERBATIM ───── */
  .tech-int-flow {
    display: block;
    max-width: 820px;
    position: relative;
    margin: 0 auto;
  }
  .tech-int-flow :global(.dingbat) { margin-top: 0; }
  .tech-int-flow :global(.timeline-vertical) { margin-bottom: 0; }
  .tech-int-flow :global(.timeline-item-highlight .timeline-content) {
    padding: 18px 22px;
    border-top: 1px solid var(--accent);
    background: rgba(var(--accent-rgb), 0.06);
  }

  .wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 48px);
  }

  @media (max-width: 800px) {
    .tech-sec-hd { grid-template-columns: 1fr; }
  }
  /* ── Alternance des fonds R4 · defaut paper-2 (clair) = rendu inchange ── */
  .tech-integration[data-bg='paper'] { background: var(--paper); }
  .tech-integration[data-bg='paper-3'] { background: var(--paper-3); }
  .tech-integration[data-bg='ink'] {
    background: var(--ink);
    --muted: rgba(var(--paper-rgb), 0.64);
    --hairline: rgba(var(--paper-rgb), 0.14);
    --hairline-strong: rgba(var(--paper-rgb), 0.28);
  }
  .tech-integration[data-bg='ink'] .tech-sec-hd h2 { color: var(--paper); }
  .tech-integration[data-bg='ink'] .tech-aside { color: rgba(var(--paper-rgb), 0.64); }
  /* Timeline / Dingbat (enfants editoriaux) lisent --ink / --ink-2 -> remap sur le
     conteneur (descendant), pas la section (sinon background:var(--ink) deviendrait clair). */
  .tech-integration[data-bg='ink'] :is(.tech-int-flow, .tech-sec-hd) {
    --ink: var(--paper);
    --ink-2: rgba(var(--paper-rgb), 0.78);
  }
</style>
