---
// Section catalogue · hero-sector
// COPIE FIDÈLE du `.sol-hero` de `src/components/templates/SolutionsDetailTemplate.astro:248-276`
// Hero secteur/département : dept kicker mono + h1 italic + lede italique + CTA + meta + tags.
// Le visuel SVG secteur (services-b2b/industrie/finance) est optionnel via slot.
import type { SectionByType } from '../../schemas/sections';

interface Props {
  data: SectionByType<'hero-sector'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---
<section class="hero-sector">
  <svg class="hero-sector__geo" viewBox="0 0 1440 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <rect x="980" y="-40" width="420" height="420" fill="none" stroke="currentColor" stroke-width=".6" opacity=".18" transform="rotate(15 1190 170)"/>
    <rect x="1040" y="20" width="280" height="280" fill="none" stroke="var(--accent)" stroke-width=".4" opacity=".25" transform="rotate(15 1180 160)"/>
    <line x1="0" y1="420" x2="1440" y2="300" stroke="currentColor" stroke-width=".4" opacity=".12"/>
  </svg>
  <div class="hero-sector__wrap">
    <div class="hero-sector__copy">
      <div class="hero-sector__dept">{isFr ? data.dept_fr : data.dept_en}</div>
      <h1 class="hero-sector__title reveal-mask-up" set:html={isFr ? data.h1_fr : data.h1_en} />
      <div class="hero-sector__sub">
        <p class="hero-sector__lead" set:html={isFr ? data.lead_fr : data.lead_en} />
        <div class="hero-sector__actions">
          <a class="hero-sector__cta" href={data.cta.href}>
            {isFr ? data.cta.label_fr : data.cta.label_en}
          </a>
          {data.meta_fr && (
            <div class="hero-sector__meta">{isFr ? data.meta_fr : (data.meta_en ?? data.meta_fr)}</div>
          )}
        </div>
      </div>
      {data.tags && data.tags.length > 0 && (
        <div class="hero-sector__tags reveal-stagger">
          {data.tags.map((tag) => (
            <span class="hero-sector__tag">{isFr ? tag.label_fr : tag.label_en}</span>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero-sector {
    position: relative;
    padding-top: clamp(80px, 9vw, 120px);
    padding-bottom: clamp(56px, 6vw, 96px);
    overflow: hidden;
    color: var(--ink);
  }
  .hero-sector__geo {
    position: absolute; inset: 0; width: 100%; height: 100%;
    pointer-events: none;
    opacity: 0.08;
    mix-blend-mode: multiply;
  }
  .hero-sector__wrap {
    position: relative;
    z-index: 1;
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
  }
  .hero-sector__copy { position: relative; z-index: 1; }
  .hero-sector__dept {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
  }
  .hero-sector__title {
    font-family: var(--font-display);
    font-size: clamp(56px, 9vw, 148px);
    line-height: 0.92;
    letter-spacing: -0.028em;
    font-weight: 400;
    margin: 0 0 32px;
    text-wrap: balance;
  }
  .hero-sector__title :global(i) { color: var(--accent); font-style: italic; }
  .hero-sector__sub {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
    max-width: 1100px;
    margin-bottom: clamp(28px, 3vw, 40px);
  }
  .hero-sector__lead {
    font-family: var(--font-sans);
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.4;
    color: var(--ink);
    font-style: italic;
    margin: 0;
  }
  .hero-sector__lead :global(span) { color: var(--accent); display: block; margin-top: 8px; }
  .hero-sector__actions { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .hero-sector__cta {
    display: inline-block;
    padding: 14px 24px;
    background: var(--ink);
    color: var(--paper);
    border-radius: 2px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: -0.005em;
    transition: transform 220ms ease, box-shadow 220ms ease;
  }
  .hero-sector__cta:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.12); }
  .hero-sector__meta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--muted);
    text-transform: uppercase;
  }
  .hero-sector__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }
  .hero-sector__tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    padding: 8px 14px;
    background: rgba(0,0,0,0.04);
    border: 1px solid var(--hairline);
    border-radius: 2px;
    transition: border-color 220ms ease, color 220ms ease;
  }
  .hero-sector__tag:hover { border-color: var(--accent); color: var(--accent); }
  @media (max-width: 768px) {
    .hero-sector__sub { grid-template-columns: 1fr; }
  }
</style>
