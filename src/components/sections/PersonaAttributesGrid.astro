---
// Section catalogue · persona-attributes-grid
// Source fidèle : `src/pages/ressources/personas/[slug].astro` `.persona-detail__grid`.
import type { SectionByType } from '@waimia/ds-kernel';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'persona-attributes-grid'>;
  lang: 'fr' | 'en';
}

const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---

<div class="persona-detail__grid" data-bg={data.background}>
  {data.blocks.map((block) => (
    <section class="persona-detail__block">
      <Kicker as="span" size={10} class="persona-kicker">{isFr ? block.kicker_fr : block.kicker_en}</Kicker>
      <ul>
        {(isFr ? block.items_fr : block.items_en).map((item) => <li>{item}</li>)}
      </ul>
    </section>
  ))}

  <section class="persona-detail__meta">
    {data.meta.map((item) => (
      <div>
        <Kicker as="span" size={10} class="persona-kicker persona-kicker--dark">{isFr ? item.kicker_fr : item.kicker_en}</Kicker>
        <p>{isFr ? item.value_fr : item.value_en}</p>
      </div>
    ))}
  </section>
</div>

<style>
  .persona-detail__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
    max-width: var(--wrap-wide);
    margin-inline: auto;
    padding-inline: var(--gut);
  }
  .persona-detail__block {
    padding: var(--space-5);
    border: 1px solid var(--hairline);
    background: var(--paper-2);
  }
  /* Kicker canonisé (R4) · typo portée par l'atome Kicker (size 10), ici layout seul */
  :global(.persona-kicker) {
    display: block;
    margin-bottom: var(--space-3);
  }
  :global(.persona-kicker--dark) {
    margin-bottom: var(--space-2);
  }
  .persona-detail__block ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .persona-detail__block li {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--ink-2);
    padding-left: var(--space-4);
    position: relative;
  }
  .persona-detail__block li::before {
    content: '▸';
    color: var(--accent-text);
    position: absolute;
    left: 0;
  }
  .persona-detail__meta {
    grid-column: span 2;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    padding: var(--space-5);
    background: var(--ink);
    color: var(--paper);
  }
  .persona-detail__meta p {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    letter-spacing: -0.015em;
    font-size: var(--text-h3);
    line-height: 1.2;
    color: var(--paper);
    margin: 0;
  }
  /* ── Alternance des fonds R4 · defaut (sans data-bg) = rendu clair inchange ── */
  .persona-detail__grid[data-bg='paper-2'] { background: var(--paper-2); }
  .persona-detail__grid[data-bg='paper-3'] { background: var(--paper-3); }
  .persona-detail__grid[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
    --ink-2: rgba(var(--paper-rgb), 0.82);
    padding: var(--space-6);
  }
  /* Blocs : panneaux sombres sureleves (au lieu du paper-2 clair), bord clair. */
  .persona-detail__grid[data-bg='ink'] .persona-detail__block {
    background: rgba(var(--paper-rgb), 0.04);
    border-color: rgba(var(--paper-rgb), 0.12);
  }
  .persona-detail__grid[data-bg='ink'] .persona-detail__block li { color: var(--ink-2); }
  .persona-detail__grid[data-bg='ink'] .persona-detail__block li::before { color: var(--accent-text); }
  /* Meta : deja sombre par design ; bord clair pour la detacher du fond ink. */
  .persona-detail__grid[data-bg='ink'] .persona-detail__meta {
    border: 1px solid rgba(var(--paper-rgb), 0.16);
  }

  @media (max-width: 768px) {
    .persona-detail__grid { grid-template-columns: 1fr; }
    .persona-detail__meta { grid-template-columns: 1fr; grid-column: span 1; }
  }
</style>
