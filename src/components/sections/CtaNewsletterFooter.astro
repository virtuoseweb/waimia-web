---
// cta-newsletter-footer (newsletter-sections) — capture email compacte pré-footer + mention RGPD.
// Dark natif (ink par défaut). Titre à gauche, formulaire à droite, mention RGPD alignée gauche.
import type { SectionByType } from '@waimia/ds-kernel';
import Kicker from '../ui/atoms/Kicker.astro';
import Button from '../ui/atoms/Button.astro';

interface Props {
  data: SectionByType<'cta-newsletter-footer'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const placeholder = isFr ? data.placeholder_fr : data.placeholder_en;
const buttonLabel = isFr ? data.button_label_fr : data.button_label_en;
const consent = isFr ? data.consent_fr : data.consent_en;
---

<section class="cta-newsletter" data-bg={data.background}>
  <div class="wrap-wide cta-newsletter__grid">
    <div class="cta-newsletter__copy">
      {(isFr ? data.kicker_fr : data.kicker_en) && (
        <Kicker tone="muted">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      )}
      <h2 set:html={isFr ? data.h2_fr : data.h2_en} />
      {(isFr ? data.subtitle_fr : data.subtitle_en) && (
        <p class="cta-newsletter__subtitle">{isFr ? data.subtitle_fr : data.subtitle_en}</p>
      )}
    </div>

    <div class="cta-newsletter__form-col">
      <form class="cta-newsletter__form" method="post" action={data.action ?? '#'}>
        <label for="cta-nl-email" class="sr-only">Email</label>
        <input
          id="cta-nl-email"
          class="cta-newsletter__input"
          type="email"
          name="email"
          placeholder={placeholder}
          autocomplete="email"
          required
        />
        <Button as="button" type="submit" variant="accent" size="md">{buttonLabel}</Button>
      </form>
      {consent && <p class="cta-newsletter__consent">{consent}</p>}
    </div>
  </div>
</section>

<style>
  .cta-newsletter {
    padding-block: var(--section-base);
    border-block: 1px solid var(--hairline);
  }
  .cta-newsletter__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(var(--space-6), 5vw, var(--space-10));
    align-items: start;
  }
  .cta-newsletter__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  h2 {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-h2);
    line-height: var(--leading-h3);
    color: var(--ink);
    margin: 0;
    max-width: 22ch;
  }
  .cta-newsletter__subtitle {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--muted);
    line-height: var(--leading-lede);
    max-width: 52ch;
    margin: 0;
  }
  .cta-newsletter__form-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .cta-newsletter__form {
    display: flex;
    gap: var(--space-3);
    align-items: stretch;
    flex-wrap: wrap;
  }
  .cta-newsletter__input {
    flex: 1 1 240px;
    min-width: 0;
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
  }
  .cta-newsletter__input::placeholder { color: var(--muted); }
  .cta-newsletter__input:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
    border-color: var(--accent-text);
  }
  .cta-newsletter__consent {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--muted);
    line-height: var(--leading-body);
    margin: 0;
    max-width: 56ch;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 760px) {
    .cta-newsletter__grid { grid-template-columns: 1fr; gap: var(--space-6); }
  }
  /* ── Dark natif (docs/43) · ink par défaut · remap scopé aux enfants ── */
  .cta-newsletter[data-bg='paper-2'] { background: var(--paper-2); }
  .cta-newsletter[data-bg='paper-3'] { background: var(--paper-3); }
  .cta-newsletter[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .cta-newsletter[data-bg='ink'] :is(h2) { color: var(--paper); }
  .cta-newsletter[data-bg='ink'] .cta-newsletter__input {
    background: rgba(var(--paper-rgb), 0.06);
    color: var(--paper);
  }
</style>
