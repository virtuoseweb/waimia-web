---
// about-story-split (about-sections) — récit fondateur 2 colonnes : narratif gauche, timeline droite.
// Dark natif (data-bg). En-tête et colonnes partagent l'axe gauche du conteneur.
import type { SectionByType } from '@waimia/ds-kernel';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'about-story-split'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const paragraphs = (isFr ? data.paragraphs_fr : data.paragraphs_en) ?? [];
const milestones = data.milestones ?? [];
const asideTitle = isFr ? data.aside_title_fr : data.aside_title_en;
---

<section class="about-story sec-base" data-bg={data.background}>
  <div class="wrap-wide about-story__grid">
    <div class="about-story__narrative u-stack-5">
      {(isFr ? data.kicker_fr : data.kicker_en) && (
        <Kicker tone="muted">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      )}
      <h2 class="sec-base-h2" set:html={isFr ? data.h2_fr : data.h2_en} />
      <div class="about-story__body u-stack-4">
        {paragraphs.map((p: string) => (
          <p>{p}</p>
        ))}
      </div>
    </div>

    <div class="about-story__aside">
      {asideTitle && <span class="about-story__aside-title">{asideTitle}</span>}
      <ol class="about-story__timeline u-list-col">
        {milestones.map((m: (typeof milestones)[number]) => (
          <li class="about-story__milestone">
            <span class="about-story__year">{m.year}</span>
            <span class="about-story__label u-label-sm">{isFr ? m.label_fr : m.label_en}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .about-story__grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(var(--space-8), 6vw, var(--space-12));
    align-items: start;
  } .about-story__body p {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--muted);
    line-height: var(--leading-prose);
    max-width: 60ch;
    margin: 0;
  }
  .about-story__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    border-left: 1px solid var(--hairline);
    padding-left: clamp(var(--space-5), 3vw, var(--space-8));
  }
  .about-story__aside-title {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  } .about-story__milestone {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-4);
    border-top: 1px solid var(--hairline);
  }
  .about-story__milestone:last-child { border-bottom: 1px solid var(--hairline); }
  .about-story__year {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    color: var(--accent-text);
    line-height: 1;
  } @media (max-width: 860px) {
    .about-story__grid { grid-template-columns: 1fr; gap: var(--space-8); }
    .about-story__aside {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--hairline);
      padding-top: var(--space-6);
    }
  }
  /* ── Dark natif (docs/43) · remap scopé aux enfants ── */
  .about-story[data-bg='paper-2'] { background: var(--paper-2); }
  .about-story[data-bg='paper-3'] { background: var(--paper-3); }
  .about-story[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .about-story[data-bg='ink'] :is(h2) { color: var(--paper); }
</style>
