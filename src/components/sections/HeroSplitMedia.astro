---
/**
 * hero-split-media · « Split média » (pilote X2, famille éditoriale)
 * Héro FULL-VIEWPORT en grille 2-col (texte 1fr / média 1.1fr), align center.
 * GAUCHE → kicker mono, titre serif accent, lede court, 2 CTA, badges pills mono.
 * DROITE → carte média line-art (currentColor, lisible paper ET ink). Pas de KPI.
 * Props-driven (data), variante paper/ink via `background`, responsive 1-col ≤768.
 * Source visuelle : src/components/library/hero-explore/HeroX2.astro.
 */
import type { SectionByType } from '@waimia/ds-kernel';
import Button from '../ui/atoms/Button.astro';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'hero-split-media'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';

const kicker = isFr ? data.kicker_fr : (data.kicker_en ?? data.kicker_fr);
const h1 = isFr ? data.h1_fr : data.h1_en;
const subtitle = isFr ? data.subtitle_fr : (data.subtitle_en ?? data.subtitle_fr);
const definitionKicker = isFr ? data.definition_kicker_fr : (data.definition_kicker_en ?? data.definition_kicker_fr);
const lede = isFr ? data.lede_fr : data.lede_en;
const badges = data.badges ?? [];
const mediaAlt = isFr ? data.media_alt_fr : (data.media_alt_en ?? data.media_alt_fr);
const ctaPrimary = data.cta_primary;
const ctaSecondary = data.cta_secondary;
// Habillage editorial (magazine) : quand `illustration` est renseigne, le hero bascule sur
// la mise en page overlap (illustration duotone sur un cote, titre par-dessus) au lieu de la
// grille split media/texte. Preserve tout le contenu. Optionnel → rendu split inchange.
const illustration = data.illustration;
const illusSide = illustration?.side ?? 'right';
// Lede seul (ni question `definition_kicker`, ni `subtitle`) : il porte tout l'appui du
// titre, donc il passe en registre de lecture (cf .hsm-lede--solo).
const soloLede = !definitionKicker && !subtitle;
---
<section class:list={['hsm', illustration && `hsm--illus hsm--illus-${illusSide}`]} data-bg={data.background === 'ink' ? 'ink' : undefined}>
  {illustration ? (
    <div class="wrap-wide hsm-illus-wrap">
      <img
        class="hsm-illus reveal-blur-clip"
        src={illustration.src}
        alt={(isFr ? illustration.alt_fr : illustration.alt_en) ?? ''}
        loading="eager"
        decoding="async"
      />
      <div class="hsm-text hsm-text--illus">
        {kicker && <Kicker as="p" tone="accent" class="hsm-kicker">{kicker}</Kicker>}
        <h1 class="hsm-title hsm-title--illus" set:html={h1} />
        {subtitle && <p class="hsm-subtitle">{subtitle}</p>}
        {definitionKicker && <p class="hsm-def-kicker" set:html={definitionKicker} />}
        <p class:list={['hsm-lede', soloLede && 'hsm-lede--solo']} set:html={lede} />

        <div class="hsm-ctas">
          <Button href={ctaPrimary.href} variant="primary" size="lg">
            {isFr ? ctaPrimary.label_fr : ctaPrimary.label_en}
          </Button>
          {ctaSecondary && (
            <Button href={ctaSecondary.href} variant="ghost" size="lg">
              {isFr ? ctaSecondary.label_fr : ctaSecondary.label_en}
            </Button>
          )}
        </div>

        {badges.length > 0 && (
          <ul class="hsm-badges" aria-label={isFr ? 'Capacités' : 'Capabilities'}>
            {badges.map((b) => <li class="hsm-badge">{isFr ? b.label_fr : b.label_en}</li>)}
          </ul>
        )}
      </div>
    </div>
  ) : (
  <div class="wrap-wide">
    <div class="hsm-grid">
      {/* Texte */}
      <div class="hsm-text">
        {kicker && <Kicker as="p" tone="accent" class="hsm-kicker">{kicker}</Kicker>}
        <h1 class="hsm-title" set:html={h1} />
        {subtitle && <p class="hsm-subtitle">{subtitle}</p>}
        {definitionKicker && <p class="hsm-def-kicker" set:html={definitionKicker} />}
        <p class:list={['hsm-lede', soloLede && 'hsm-lede--solo']} set:html={lede} />

        <div class="hsm-ctas">
          <Button href={ctaPrimary.href} variant="primary" size="lg">
            {isFr ? ctaPrimary.label_fr : ctaPrimary.label_en}
          </Button>
          {ctaSecondary && (
            <Button href={ctaSecondary.href} variant="ghost" size="lg">
              {isFr ? ctaSecondary.label_fr : ctaSecondary.label_en}
            </Button>
          )}
        </div>

        {badges.length > 0 && (
          <ul class="hsm-badges" aria-label={isFr ? 'Capacités' : 'Capabilities'}>
            {badges.map((b) => <li class="hsm-badge">{isFr ? b.label_fr : b.label_en}</li>)}
          </ul>
        )}
      </div>

      {/* Média line-art */}
      {data.media_src && (
        <figure class="hsm-media">
          <img src={data.media_src} alt={mediaAlt ?? ''} loading="eager" decoding="async" />
        </figure>
      )}
    </div>
  </div>
  )}

  <style>
    .hsm {
      background: var(--paper);
      color: var(--ink);
      border-bottom: 1px solid var(--hairline);
      /* Full-viewport sous le header fixe : la masthead dégage déjà le header
         (--header-height neutralisé à 0px par `.masthead-bar + section`), donc le
         hero ne re-compte pas le header. Contenu CENTRÉ ; c'est la densité réduite
         (def-kicker --text-body, média 3/2, paddings resserrés) qui garde les CTA
         above-the-fold même quand le titre passe sur 3 lignes (≠ ancien hero plus
         dense où la 3e ligne poussait les CTA sous le fold sur écrans courts). */
      min-height: 100vh;
      min-height: calc(var(--viewport-h) - var(--hero-chrome-above));
      display: flex;
      flex-direction: column;
      justify-content: center;
      box-sizing: border-box;
      padding-top: calc(var(--header-height) + var(--space-5));
      padding-bottom: var(--space-9);
    }
    .hsm[data-bg='ink'] { background: var(--ink); color: var(--paper); }

    .hsm-grid {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: var(--space-10);
      align-items: center;
    }

    .hsm-kicker {
      margin: 0 0 var(--space-5);
    }
    .hsm-title {
      font-family: var(--font-sans);
      font-size: var(--text-h1);
      line-height: var(--leading-h1);
      letter-spacing: -0.015em;
      font-weight: var(--fw-semibold);
      max-width: 14ch;
      margin: 0 0 var(--space-5);
    }
    .hsm-title :global(.acc) { font-family: var(--font-display); font-weight: var(--fw-regular); letter-spacing: var(--tracking-display); font-style: italic; color: var(--accent-text); }

    /* Tagline · registre intermédiaire entre h1 et lede (rôle h3 = sous-titre/lede, poids medium). */
    .hsm-subtitle {
      font-family: var(--font-sans);
      font-size: var(--text-h3);
      line-height: var(--leading-lede);
      font-weight: var(--fw-medium);
      color: var(--ink);
      max-width: 46ch;
      margin: 0 0 var(--space-6);
      text-wrap: pretty;
    }
    .hsm[data-bg='ink'] .hsm-subtitle { color: var(--paper); }

    /* Question « définition » · sous-titre-question mono muted, PLUS GROS que le lede
       (hiérarchie voulue : la question domine, la réponse est en appui plus discret).
       Casse de phrase, ≠ top-kicker terracotta uppercase. 100 % tokens (0 hardcode). */
    .hsm-def-kicker {
      font-family: var(--font-mono);
      font-size: var(--text-body);
      line-height: var(--leading-lede);
      letter-spacing: var(--tracking-mono-tight);
      text-transform: none;
      color: var(--muted);
      margin: 0 0 var(--space-4);
      text-wrap: balance;
    }

    /* Lede · style de .problem-statement__text (sans + emphase <i> serif italique
       terracotta), couleur muted. Corps de lecture (var(--text-body)), à la taille de la
       question (def-kicker) au-dessus : la phrase qui vend l'offre n'est jamais plus petite
       que son étiquette (elle était à 11 px sous une étiquette de 15 px, audit v5).
       Sans question ni sous-titre, voir .hsm-lede--solo plus bas. */
    .hsm-lede {
      font-family: var(--font-sans);
      font-size: var(--text-body);
      line-height: var(--leading-relaxed);
      letter-spacing: var(--tracking-body);
      font-weight: var(--fw-regular);
      color: var(--muted);
      max-width: 50ch;
      margin: 0 0 var(--space-6);
      text-wrap: pretty;
    }
    .hsm-lede :global(i),
    .hsm-lede :global(em) {
      font-family: var(--font-display);
      font-style: italic;
      font-weight: var(--fw-regular);
      letter-spacing: var(--tracking-display);
      color: var(--accent-text);
    }

    /* Badges · pills mono uppercase, border hairline. Placés SOUS les CTA
       (l'action d'abord) : la marge est portée vers le haut. */
    .hsm-badges {
      list-style: none;
      margin: var(--space-5) 0 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .hsm-badge {
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono-tight);
      text-transform: uppercase;
      color: var(--muted);
      border: 1px solid var(--hairline);
      border-radius: var(--radius-pill);
      padding: var(--space-2) var(--space-4);
      transition: border-color var(--dur-hover) var(--ease), color var(--dur-hover) var(--ease);
    }
    .hsm-badge:hover { border-color: var(--accent-text); color: var(--accent-text); }

    .hsm-ctas { display: flex; gap: var(--space-3); flex-wrap: wrap; }

    /* Carte média · line-art currentColor (inversion gratuite ink/paper) */
    .hsm-media {
      margin: 0;
      border: 1px solid var(--hairline);
      border-radius: var(--radius-lg);
      background: var(--paper-2);
      padding: clamp(var(--space-6), 4vw, var(--space-10));
      aspect-ratio: 3 / 2;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }
    /* Halo accent très léger derrière le schéma */
    .hsm-media::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(60% 60% at 50% 45%, rgba(var(--accent-rgb), 0.07), transparent 70%);
      pointer-events: none;
    }
    .hsm[data-bg='ink'] .hsm-media { background: var(--ink-2); }
    .hsm-media img {
      position: relative;
      width: 100%;
      height: 100%;
      object-fit: contain;
      color: var(--ink);
    }
    .hsm[data-bg='ink'] .hsm-media img { color: var(--paper); }

    /* ── habillage illustration (magazine, overlap titre) ──
       Une illustration duotone devient un panneau split-screen full-bleed (47vw, colle au bord d'ecran, pleine hauteur de section, cover),
       le titre passe PAR-DESSUS en z-index. `mix-blend-mode: multiply` fond le fond
       paper de l'image -paper dans la page (line-art ink seul visible). 100% tokens DS.
       Le titre passe pleine largeur PAR-DESSUS l'illustration (z-index 2, blend multiply garde la lisibilite). */
    /* La section est le referent de l'image full-bleed (bord d'ecran, pleine hauteur). */
    .hsm--illus { position: relative; overflow: hidden; }
    /* Hauteur bornée par la hauteur utile : sans ce plafond, 62vw donnait 847 px à
       1366 de large, plus haut que l'écran (768), et le contenu centré poussait les
       CTA sous la ligne de flottaison. Plafond = fenêtre moins chrome au-dessus et
       paddings de `.hsm` (haut : header + space-5, bas : space-9). */
    .hsm--illus .hsm-illus-wrap {
      min-height: min(
        clamp(560px, 62vw, 880px),
        calc(var(--viewport-h) - var(--hero-chrome-above) - var(--header-height) - var(--space-5) - var(--space-9))
      );
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .hsm-text--illus {
      position: relative;
      z-index: 1;
      max-width: 100%;
    }
    /* Le titre DÉPASSE franchement PAR-DESSUS l'illustration : sa boite est bien plus
       large que la colonne de corps (elle mord sur ~la moitie de l'image), ancree du
       cote texte, z-index 2. Le corps de texte, lui, reste dans la zone claire (~38%)
       et ne passe jamais sous l'image (lisibilite). */
    .hsm-title--illus {
      position: relative;
      z-index: 2;
      max-width: min(66%, 760px);
    }
    .hsm--illus .hsm-subtitle,
    .hsm--illus .hsm-def-kicker,
    .hsm--illus .hsm-lede,
    .hsm--illus .hsm-badges,
    .hsm--illus .hsm-ctas { max-width: clamp(300px, 38%, 460px); }
    .hsm--illus .hsm-kicker { position: relative; z-index: 2; }

    /* ── Typo normalisée du hero illus (directive Simon) ──
       La desc / le lede / les badges quittent la mono machine-a-ecrire pour la
       sans de lecture du site (Inter Tight). Zero nouveau token. Scopé illus. */
    /* Desc (la question) : sans en ITALIQUE, mots relevés en accent serif italique
       via <i class="acc"> (idiome site, cf .u-serif-accent / h1 i). */
    .hsm--illus .hsm-def-kicker {
      font-family: var(--font-sans);
      font-style: italic;
      font-size: var(--text-body);
      line-height: var(--leading-lede);
      letter-spacing: var(--tracking-body);
      text-transform: none;
      font-weight: var(--fw-regular);
      color: var(--ink);
    }
    .hsm--illus[data-bg='ink'] .hsm-def-kicker { color: var(--paper); }
    .hsm--illus .hsm-def-kicker :global(i),
    .hsm--illus .hsm-def-kicker :global(.acc) {
      font-family: var(--font-display);
      font-style: italic;
      font-weight: var(--fw-regular);
      letter-spacing: var(--tracking-display);
      color: var(--accent-text);
    }
    /* Lede seul (aucune question ni sous-titre au-dessus) : c'est le seul texte d'appui
       du titre. Un cran au-dessus du corps (comme le paragraphe de tete
       d'editorial-prose), encre pleine. Specificite (0,2,0) : vaut pour les deux mises
       en page. La largeur
       reste celle de chaque mise en page (50ch, ou la colonne claire de l'illustration). */
    .hsm .hsm-lede--solo {
      font-size: calc(var(--text-body) + 2px);
      line-height: var(--leading-body);
      color: var(--ink-2);
    }
    .hsm[data-bg='ink'] .hsm-lede--solo { color: rgba(var(--paper-rgb), 0.82); }
    /* Badges : sans, text-small, graisse normale, casse de phrase, pill discret. */
    .hsm--illus .hsm-badge {
      font-family: var(--font-sans);
      font-size: var(--text-small);
      font-weight: var(--fw-regular);
      letter-spacing: var(--tracking-body);
      text-transform: none;
    }
    /* Illustration a gauche → on ancre le contenu a droite pour degager l'image. */
    /* `.hsm-kicker` est posée sur <Kicker> (composant enfant, sans data-astro-cid) :
       seule une règle :global() l'atteint. Largeur calée sur le titre (aligné à x du H1). */
    .hsm--illus-left :global(.hsm-kicker),
    .hsm--illus-left .hsm-title--illus,
    .hsm--illus-left .hsm-subtitle,
    .hsm--illus-left .hsm-def-kicker,
    .hsm--illus-left .hsm-lede,
    .hsm--illus-left .hsm-badges,
    .hsm--illus-left .hsm-ctas { margin-left: auto; }
    .hsm--illus-left :global(.hsm-kicker) { max-width: min(66%, 760px); }
    .hsm-illus {
      position: absolute;
      top: 0;
      bottom: 0;
      width: clamp(480px, 58vw, 1280px);
      height: 100%;
      object-fit: cover;
      pointer-events: none;
      user-select: none;
      z-index: 0;
      opacity: 0.95;
      mix-blend-mode: multiply;
    }
    /* Panneau split-screen : l'image colle au bord d'ecran et remplit la hauteur
       de la section (cover, cadrage centre) ; le titre passe par-dessus. */
    .hsm--illus-right .hsm-illus { right: 0; object-position: center; }
    .hsm--illus-left .hsm-illus { left: 0; object-position: center; }
    .hsm--illus-left .hsm-text--illus { margin-left: auto; }
    .hsm[data-bg='ink'] .hsm-illus { mix-blend-mode: screen; }

    @media (max-width: 768px) {
      /* Mobile : image en bloc pleine largeur SOUS le texte (flux naturel). */
      .hsm--illus .hsm-illus-wrap { min-height: 0; }
      .hsm-illus {
        position: static;
        order: 2;
        width: 100%;
        height: auto;
        max-height: 44vh;
        margin-top: var(--space-6);
        opacity: 1;
        object-fit: contain;
      }
      .hsm-text--illus { order: 1; max-width: none; }
      .hsm--illus-left .hsm-text--illus { margin-left: 0; }
      .hsm-title--illus,
      .hsm--illus .hsm-subtitle,
      .hsm--illus .hsm-def-kicker,
      .hsm--illus .hsm-lede,
      .hsm--illus .hsm-badges,
      .hsm--illus .hsm-ctas { max-width: none; }
      .hsm--illus-left :global(.hsm-kicker),
      .hsm--illus-left .hsm-title--illus,
      .hsm--illus-left .hsm-subtitle,
      .hsm--illus-left .hsm-def-kicker,
      .hsm--illus-left .hsm-lede,
      .hsm--illus-left .hsm-badges,
      .hsm--illus-left .hsm-ctas { margin-left: 0; }
      .hsm--illus-left :global(.hsm-kicker) { max-width: none; }
    }
    @media (max-width: 768px) {
      .hsm {
        /* Mobile : contenu ancré en haut (CTA above-the-fold malgré la barre
           cookie), média décoratif renvoyé SOUS le bloc texte (ordre naturel),
           espacements resserrés. */
        min-height: calc(var(--viewport-h) - var(--hero-chrome-above));
        justify-content: flex-start;
        padding-top: calc(var(--header-height) + var(--space-3));
        padding-bottom: var(--space-5);
      }
      .hsm-grid { grid-template-columns: 1fr; gap: var(--space-5); }
      /* Titre : pleine largeur (plus de cap 14ch) + échelle display → il occupe
         l'espace dispo au lieu de rester serré sur 2 lignes étroites. */
      .hsm-kicker { margin-bottom: var(--space-2); }
      .hsm-title { max-width: none; font-size: var(--text-display); margin-bottom: var(--space-2); }
      .hsm-subtitle { max-width: none; margin-bottom: var(--space-3); }
      .hsm-def-kicker { margin-bottom: var(--space-2); }
      .hsm-lede { margin-bottom: var(--space-3); }
      /* Lede seul : corps de lecture sans le cran +2px (ledes jusqu'a ~480 signes,
         CTA a garder au-dessus de la ligne de flottaison a 390x844). */
      .hsm .hsm-lede--solo { font-size: var(--text-body); }
      /* Badges : typo micro + padding resserré → empilent moins haut. */
      .hsm-badges { gap: var(--space-1); margin-top: var(--space-3); }
      .hsm-badge { font-size: var(--text-micro); padding: var(--space-1) var(--space-3); }
      .hsm-ctas { gap: var(--space-2); }
      .hsm-ctas :global(.btn) { flex: 1 1 auto; justify-content: center; }
      /* Média : ordre naturel (sous le texte), bandeau court décoratif. */
      .hsm-media { aspect-ratio: 16 / 9; }
    }
  </style>
</section>
