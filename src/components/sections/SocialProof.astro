---
import type { SectionByType } from '@waimia/ds-kernel';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'social-proof'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---

<section class="social-proof" data-bg={data.background}>
  {(isFr ? data.kicker_fr : data.kicker_en) && (
    <div class="wrap-wide">
      <Kicker tone="muted" class="social-proof__kicker">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
    </div>
  )}
  {data.marquee ? (
    <div class="social-proof__marquee-wrap" aria-hidden="true">
      <ul class="social-proof__marquee">
        {[...data.logos, ...data.logos].map((l: (typeof data.logos)[number]) => (
          <li class="social-proof__logo">{l.name}</li>
        ))}
      </ul>
    </div>
  ) : (
    <div class="wrap-wide">
      <ul class="social-proof__static">
        {data.logos.map((l: (typeof data.logos)[number]) => (
          <li class="social-proof__logo">{l.name}</li>
        ))}
      </ul>
    </div>
  )}
</section>

<style>
  .social-proof {
    padding-block: var(--section-tight);
    border-bottom: 1px solid var(--hairline);
    overflow: hidden;
  }
  .social-proof__kicker { margin-bottom: var(--space-5); }
  .social-proof__logo {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-small);
    color: var(--muted);
    white-space: nowrap;
    list-style: none;
    padding-inline: var(--space-6);
    border-right: 1px solid var(--hairline);
  }
  .social-proof__static {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .social-proof__marquee-wrap { position: relative; }
  .social-proof__marquee {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    animation: marquee 32s linear infinite;
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .social-proof__marquee { animation: none; }
  }
  /* ── Alternance des fonds R4 (docs/37 §2.6) · defaut paper = rendu inchange ── */
  .social-proof[data-bg='paper-2'] { background: var(--paper-2); }
  .social-proof[data-bg='paper-3'] { background: var(--paper-3); }
  .social-proof[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .social-proof[data-bg='ink'] :is(h2, h3, p) { color: var(--paper); }
</style>
