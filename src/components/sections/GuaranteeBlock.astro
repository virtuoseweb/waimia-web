---
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'guarantee-block'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---

<section class="guarantee-block sec-base" data-bg={data.background}>
  <div class="wrap-wide">
  <ul class="guarantee-block__list">
    {data.guarantees.map((g: (typeof data.guarantees)[number], i: number) => (
      <li class="guarantee-block__item">
        <Kicker tone="accent" size={10} class="guarantee-block__num">◉ {String(i + 1).padStart(2, '0')}</Kicker>
        <div class="guarantee-block__content">
          <strong class="guarantee-block__title">{isFr ? g.title_fr : g.title_en}</strong>
          <p>{isFr ? g.body_fr : g.body_en}</p>
        </div>
      </li>
    ))}
  </ul>
  </div>
</section>

<style>
  .guarantee-block__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .guarantee-block__item {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-top: 1px solid var(--hairline);
  }
  .guarantee-block__item:last-child { border-bottom: 1px solid var(--hairline); }
  .guarantee-block__num { padding-top: var(--space-1); }
  .guarantee-block__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .guarantee-block__title {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: var(--fw-medium);
    color: var(--ink);
    line-height: 1.2;
  }
  .guarantee-block__content p {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--muted);
    line-height: var(--leading-relaxed);
    margin: 0;
    max-width: 64ch;
  }
  @media (max-width: 600px) {
    .guarantee-block__item { grid-template-columns: 1fr; }
  }
  /* ── Alternance des fonds R4 (docs/37 §2.6) · defaut paper = rendu inchange ── */
  .guarantee-block[data-bg='paper-2'] { background: var(--paper-2); }
  .guarantee-block[data-bg='paper-3'] { background: var(--paper-3); }
  .guarantee-block[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .guarantee-block[data-bg='ink'] :is(h2, h3, p) { color: var(--paper); }
</style>
