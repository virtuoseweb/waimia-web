---
// Section W6 · problem-statement
// Énoncé macro-typo + stats optionnelles. Sources : `off-problem`, `svc-problem`, `dt-problem`.
import type { SectionByType } from '../../schemas/sections';
import DropCap from '../editorial/DropCap.astro';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'problem-statement'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---

<section class="problem-statement" data-bg={data.background}>
  <div class="wrap-wide">
    <Kicker as="span" tone="accent" class="problem-statement__kicker">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
    <div class:list={['problem-statement__statement', data.dropcap && 'problem-statement__statement--dropcap']}>
      {data.dropcap && <DropCap variant="mono">§</DropCap>}
      <p class="problem-statement__text" set:html={isFr ? data.statement_fr : data.statement_en} />
    </div>

    {data.stats && data.stats.length > 0 && (
      <div class="problem-statement__stats" style={`--problem-statement-cols: ${data.stats.length}`}>
        {data.stats.map((stat) => (
          <div class="problem-statement__stat">
            <div class="problem-statement__value">{stat.value}</div>
            <div class="problem-statement__label">{isFr ? stat.label_fr : stat.label_en}</div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .problem-statement {
    padding-block: var(--problem-statement-pad, var(--section-loose));
  }
  /* Kicker canonisé (R4) · typo portée par l'atome Kicker, ici layout seul */
  :global(.problem-statement__kicker) {
    display: block;
    margin-bottom: var(--space-6);
  }
  .problem-statement__text {
    font-family: var(--font-sans);
    font-size: clamp(var(--text-h2), 4vw, var(--text-h1));
    line-height: var(--leading-h2);
    letter-spacing: -0.015em;
    font-weight: var(--fw-medium);
    color: var(--ink);
    text-wrap: balance;
    max-width: 1100px;
    margin: 0 0 clamp(var(--space-8), 5vw, var(--space-12));
  }
  .problem-statement__statement--dropcap {
    display: flow-root;
  }
  .problem-statement__statement--dropcap :global(.drop-cap) {
    margin-right: 0.16em;
  }
  .problem-statement__text :global(i),
  .problem-statement__text :global(em) {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: var(--fw-regular);
    letter-spacing: var(--tracking-display);
    color: var(--accent-text);
  }
  .problem-statement__stats {
    display: grid;
    grid-template-columns: repeat(var(--problem-statement-cols, 3), 1fr);
    gap: 0;
    margin-top: var(--space-8);
    border-top: 1px solid var(--hairline-strong);
    border-bottom: 1px solid var(--hairline);
  }
  .problem-statement__stat {
    padding: var(--space-6) var(--space-5);
    border-right: 1px solid var(--hairline);
  }
  .problem-statement__stat:last-child {
    border-right: none;
  }
  .problem-statement__value {
    font-family: var(--font-display);
    font-size: clamp(var(--text-h2), 4vw, var(--text-h1));
    color: var(--ink);
    line-height: 1;
    margin-bottom: var(--space-2);
    font-weight: var(--fw-regular);
  }
  .problem-statement__label {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--muted);
    line-height: var(--leading-body);
  }
  @media (max-width: 800px) {
    .problem-statement__stats {
      grid-template-columns: 1fr;
    }
    .problem-statement__stat {
      border-right: none;
      border-bottom: 1px solid var(--hairline);
    }
    .problem-statement__stat:last-child {
      border-bottom: none;
    }
  }

  /* ── Alternance des fonds · defaut paper = rendu inchange ── */
  .problem-statement[data-bg='paper-2'] { background: var(--paper-2); }
  .problem-statement[data-bg='paper-3'] { background: var(--paper-3); }
  .problem-statement[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .problem-statement[data-bg='ink'] :is(h1, h2, h3, h4, p, li, dt, dd, span, strong) { color: var(--paper); }
  /* L'accent italique (statement + value) reste lisible sur ink */
  .problem-statement[data-bg='ink'] .problem-statement__text :is(i, em) { color: var(--accent-text); }
  .problem-statement[data-bg='ink'] .problem-statement__value { color: var(--paper); }
  .problem-statement[data-bg='ink'] .problem-statement__label { color: var(--muted); }
</style>
