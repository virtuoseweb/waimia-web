---
// Section catalogue · hero-academy-hub
// COPIE FIDÈLE du `.hero` de `src/components/templates/EcoleHubTemplate.astro:40-46`
// Hero hub académie : kicker mono + h1 display + lede + bande stats mono.
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'hero-academy-hub'>;
  lang: 'fr' | 'en';
  wrap?: boolean;
  topPad?: string;
}
const { data, lang, wrap = true, topPad } = Astro.props;
const isFr = lang === 'fr';
---
<section class:list={['hero-academy-hub', !wrap && 'hero-academy-hub--unwrapped']} style={topPad ? `--hahub-top-pad: ${topPad}` : undefined}>
  <div class="hero-academy-hub__hero">
    <Kicker as="p" class="hero-academy-hub__kicker">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
    <h1 class="hero-academy-hub__heading" set:html={isFr ? data.h1_fr : data.h1_en} />
    <p class="hero-academy-hub__lede">{isFr ? data.lede_fr : data.lede_en}</p>
  </div>
  {data.stats_label_fr && (
    <div class="hero-academy-hub__stats">
      <span class="hero-academy-hub__stats-text">{isFr ? data.stats_label_fr : (data.stats_label_en ?? data.stats_label_fr)}</span>
    </div>
  )}
</section>

<style>
  .hero-academy-hub {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--space-page-x, 24px);
    background: var(--paper);
  }
  .hero-academy-hub--unwrapped {
    max-width: none;
    margin: 0;
    padding: 0;
    background: transparent;
  }
  .hero-academy-hub__hero {
    padding-top: var(--hahub-top-pad, 72px);
    padding-bottom: 48px;
    border-bottom: 1px solid var(--hairline);
  }
  :global(.hero-academy-hub__kicker) { margin: 0 0 24px; }
  .hero-academy-hub__heading {
    font-size: var(--text-h1-hero);
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.05;
    margin: 0 0 24px;
  }
  .hero-academy-hub__heading :global(i) { font-style: italic; }
  .hero-academy-hub__lede {
    font-size: var(--text-lede);
    font-family: var(--font-sans);
    line-height: 1.5;
    max-width: 640px;
    margin: 0;
    color: var(--muted);
  }
  .hero-academy-hub__stats {
    padding: 20px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .hero-academy-hub__stats-text {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
</style>
