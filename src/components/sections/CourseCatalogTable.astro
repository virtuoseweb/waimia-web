---
// Section W6 · course-catalog-table (famille École / Index)
// Tableau du catalogue formations (# / Titre / Niveau / Durée / Prix + flèche).
// Source : EcoleHubTemplate.astro (markup l.51-88, CSS scoped l.127-219 + responsive l.273-285).
// - markup/CSS = COPIE VERBATIM des styles scoped legacy (tokens var(--*), 0 hex brut sauf pills d'origine).
// - piloté par `data.rows` (data-driven) au lieu de la collection inline du template.
import type { SectionByType } from '../../schemas/sections';
interface Props {
  data: SectionByType<'course-catalog-table'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';

const levelLabels: Record<string, Record<string, string>> = {
  fr: { debutant: 'Débutant', intermediaire: 'Intermédiaire', avance: 'Avancé', expert: 'Expert' },
  en: { debutant: 'Beginner', intermediaire: 'Intermediate', avance: 'Advanced', expert: 'Expert' },
};

const title = isFr ? data.title_fr : data.title_en;
---
<div class="catalogue" data-bg={data.background}>
  <h2 class="section-title">{title}</h2>
  <div class="catalogue-table">
    <div class="table-header">
      <span class="col-num">#</span>
      <span class="col-titre">{isFr ? 'Titre' : 'Title'}</span>
      <span class="col-niveau">{isFr ? 'Niveau' : 'Level'}</span>
      <span class="col-duree">{isFr ? 'Durée' : 'Duration'}</span>
      <span class="col-prix">{isFr ? 'Prix' : 'Price'}</span>
      <span class="col-action"></span>
    </div>
    {data.rows.map((row, i) => {
      const rowTitle = isFr ? row.title_fr : row.title_en;
      const level = levelLabels[lang][row.level] ?? row.level;
      const priceStr = row.price_eur === 0
        ? (isFr ? 'Gratuit' : 'Free')
        : row.price_eur != null
          ? `${row.price_eur} €`
          : '';
      return (
        <a class="table-row" href={row.href}>
          <span class="col-num mono">{row.num ?? String(i + 1).padStart(2, '0')}</span>
          <span class="col-titre row-title">{rowTitle}</span>
          <span class="col-niveau">
            <span class={`pill pill--${row.level}`}>{level}</span>
          </span>
          <span class="col-duree mono">{row.duration_hours}h</span>
          <span class="col-prix mono">{priceStr}</span>
          <span class="col-action arrow">→</span>
        </a>
      );
    })}
  </div>
</div>

<style>
  /* ───── COPIE VERBATIM EcoleHubTemplate l.127-219 ───── */
  /* CATALOGUE */
  .catalogue {
    padding-top: var(--space-8);
  }

  .section-title {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    line-height: 1;
    letter-spacing: var(--tracking-mono-tight);
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 var(--space-5);
    font-weight: var(--fw-regular);
  }

  .catalogue-table {
    border-top: 1px solid var(--hairline);
  }

  .table-header {
    display: grid;
    grid-template-columns: 40px 1fr 130px 70px 80px 32px;
    gap: 0 var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--hairline);
  }

  .table-header span {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .table-row {
    display: grid;
    grid-template-columns: 40px 1fr 130px 70px 80px 32px;
    gap: 0 var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--hairline);
    text-decoration: none;
    color: inherit;
    align-items: center;
    transition: background 0.15s;
  }

  .table-row:hover {
    background: color-mix(in srgb, var(--accent) 4%, transparent);
  }

  .col-num {
    font-family: var(--font-mono);
    font-size: var(--text-ui);
    color: var(--muted);
  }

  .row-title {
    font-family: var(--font-sans);
    font-size: var(--text-body-lead);
    font-weight: var(--fw-medium);
    color: var(--ink);
  }

  .mono {
    font-family: var(--font-mono);
    font-size: var(--text-ui);
  }

  .pill {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px var(--space-2);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xs);
  }

  .pill--debutant { color: var(--muted); border-color: var(--muted); }
  .pill--intermediaire { color: var(--accent); border-color: var(--accent); }
  .pill--avance { color: var(--accent-2); border-color: var(--accent-2); }
  .pill--expert { color: var(--ink); border-color: var(--ink); }

  .arrow {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    color: var(--accent);
    text-align: right;
  }

  /* ───── COPIE VERBATIM EcoleHubTemplate l.273-285 (responsive, règles tableau) ───── */
  @media (max-width: 700px) {
    .table-header {
      display: none;
    }

    .table-row {
      grid-template-columns: 32px 1fr 80px 32px;
      grid-template-rows: auto auto;
    }

    .col-niveau { display: none; }
    .col-duree { display: none; }
  }

  /* ════════ Fonds composables R4 · defaut clair inchange ════════ */
  /* Le bloc .catalogue n'a pas de fond par defaut ; on en pose un + padding-block
     uniquement quand data-bg est present (la mise en page claire reste intacte). */
  .catalogue[data-bg='paper-2'] { background: var(--paper-2); padding-block: var(--section-tight); }
  .catalogue[data-bg='paper-3'] { background: var(--paper-3); padding-block: var(--section-tight); }
  .catalogue[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
    padding-block: var(--section-tight);
  }
  .catalogue[data-bg='ink'] .catalogue-table,
  .catalogue[data-bg='ink'] .table-header,
  .catalogue[data-bg='ink'] .table-row { border-color: rgba(var(--paper-rgb), 0.14); }
  .catalogue[data-bg='ink'] .table-row:hover { background: rgba(var(--accent-rgb), 0.12); }
  .catalogue[data-bg='ink'] .row-title { color: var(--paper); }
  .catalogue[data-bg='ink'] .col-num,
  .catalogue[data-bg='ink'] .mono { color: rgba(var(--paper-rgb), 0.7); }
  /* Pills : conserver l'accent, eclaircir les variantes muted/expert pour le contraste */
  .catalogue[data-bg='ink'] .pill--debutant { color: var(--muted); border-color: rgba(var(--paper-rgb), 0.3); }
  .catalogue[data-bg='ink'] .pill--expert { color: var(--paper); border-color: rgba(var(--paper-rgb), 0.55); }
</style>
