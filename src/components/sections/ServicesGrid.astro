---
// Section W6 · services-grid
// Grille de 6 services (3×2) avec metric, body, connectors. Source : `SixServices.astro` (Acte II).
import type { SectionByType } from '@waimia/ds-kernel';

// Line-art DS inliné au build via ?raw : le SVG vit dans le DOM →
// `stroke="currentColor"` suit le `color` du conteneur. Idiome commun du
// catalogue (HeroMastheadCard). Clé = basename.
const lineArtRaw = import.meta.glob<string>('../../assets/line-art/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const lineArt: Record<string, string> = {};
for (const [path, svg] of Object.entries(lineArtRaw)) {
  lineArt[path.split('/').pop()!] = svg;
}
const inlineLineArt = (src?: string): string | undefined =>
  src ? lineArt[src.split('/').pop()!] : undefined;

interface Props {
  data: SectionByType<'services-grid'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';

// Tuile illustration optionnelle (comble le vide de la 2e rangée → bento complet).
const illus = data.illustration;
const illusSvg = inlineLineArt(illus?.src);
const illusAlt = isFr ? illus?.alt_fr : (illus?.alt_en ?? illus?.alt_fr);
const illusCaption = isFr ? illus?.caption_fr : (illus?.caption_en ?? illus?.caption_fr);
---

<section class="services-grid" data-bg={data.background} aria-labelledby="services-grid-h2">
  <div class="wrap-wide">
    <header class="services-grid__hd">
      <div class="services-grid__chapter">
        <span class="services-grid__dot" aria-hidden></span>
        <span class="services-grid__num">{data.fig_num}</span>
        <span class="services-grid__sep" aria-hidden>·</span>
        <span>{isFr ? data.fig_title_fr : data.fig_title_en}</span>
      </div>
      <span class="services-grid__spec">{isFr ? data.spec_fr : data.spec_en}</span>
    </header>

    <h2 id="services-grid-h2" class="services-grid__h2 reveal u-serif-accent" set:html={isFr ? data.h2_fr : data.h2_en} />

    <div class="services-grid__grid qgrid reveal-stagger" data-bento={data.illustration ? '' : undefined}>
      {data.services.map((s) => (
        <article class="services-grid__cell">
          <header class="services-grid__cell-head">
            <span class="services-grid__cell-fig">FIG {s.fig}</span>
            <span class="services-grid__cell-metric">{isFr ? s.metric_fr : s.metric_en}</span>
          </header>
          <h3 class="services-grid__cell-title">{isFr ? s.label_fr : s.label_en}</h3>
          <span class="services-grid__cell-rule" aria-hidden></span>
          <p class="services-grid__cell-body">{isFr ? s.body_fr : s.body_en}</p>
          <footer class="services-grid__cell-foot">
            <span class="services-grid__cell-foot-key">{isFr ? data.connectors_label_fr : data.connectors_label_en}</span>
            <span class="services-grid__cell-foot-val">{isFr ? s.connectors_fr : s.connectors_en}</span>
            {s.usecase_href && (isFr ? s.usecase_label_fr : s.usecase_label_en) && (
              <a class="services-grid__cell-uc" href={s.usecase_href}>{isFr ? s.usecase_label_fr : s.usecase_label_en}</a>
            )}
          </footer>
          <span class="services-grid__cell-arr" aria-hidden>→</span>
        </article>
      ))}
      {illusSvg && (
        <figure class="services-grid__illus">
          <div class="services-grid__illus-art" role="img" aria-label={illusAlt ?? ''} set:html={illusSvg} />
          {illusCaption && <figcaption class="services-grid__illus-cap">{illusCaption}</figcaption>}
        </figure>
      )}
    </div>
    {data.foot_links && data.foot_links.length > 0 && (
      <footer class="services-grid__foot">
        {data.foot_links.map((l) => (
          <a class="services-grid__foot-link" href={l.href}>{isFr ? l.label_fr : l.label_en}</a>
        ))}
      </footer>
    )}
  </div>
</section>

<style>
  .services-grid {
    padding: var(--section-base) 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    background: var(--paper-2);
  }
  .services-grid__hd {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--hairline);
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .services-grid__chapter {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .services-grid__dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: var(--radius-full);
    display: inline-block;
    transform: translateY(-2px);
  }
  .services-grid__num { color: var(--accent-text); font-weight: var(--fw-medium); }
  .services-grid__sep { color: var(--muted); }
  .services-grid__spec {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--muted);
    letter-spacing: 0.1em;
  }
  .services-grid__h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-display);
    max-width: 980px;
    margin: 0 0 var(--space-7);
    font-weight: var(--fw-medium);
    text-wrap: balance;
    color: var(--ink);
  }
  /* Primitive adaptative .qgrid (grid.css) : colonnes pilotées par le NOMBRE/LARGEUR
     des cells (--card-min borne ~3 colonnes au large). On neutralise le gap pour
     garder le look hairline collé ; le filet entre cells est porté par border-right +
     border-bottom sur CHAQUE cell, le conteneur masquant les bords externes via
     overflow + marges négatives (-1px), schéma indépendant du nombre de colonnes :
     plus de `:nth-child(3n)` figé sur 3 colonnes. */
  .services-grid__grid {
    --card-min: 17rem;
    gap: 0;
    border-top: 1px solid var(--hairline-strong);
    overflow: hidden;
  }
  .services-grid__cell {
    padding: var(--spacing-block) var(--space-6) var(--space-8);
    border-right: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    margin: 0 -1px -1px 0;
    min-height: 300px;
    position: relative;
    display: flex;
    flex-direction: column;
    transition: background var(--dur-hover) var(--ease), border-color var(--dur-hover) var(--ease), translate var(--dur-hover) var(--ease);
  }
  .services-grid__cell:hover {
    background: rgba(var(--accent-rgb), 0.04);
    border-color: var(--accent-text);
    translate: 0 -1px;
  }
  .services-grid__cell-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
  }
  .services-grid__cell-fig {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--ink);
    text-transform: uppercase;
  }
  .services-grid__cell-metric {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono-tight);
    color: var(--accent-text);
    text-transform: uppercase;
    text-align: right;
    white-space: nowrap;
  }
  .services-grid__cell-title {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    letter-spacing: -0.02em;
    margin: var(--space-5) 0 0;
    font-weight: var(--fw-medium);
    text-wrap: balance;
    color: var(--ink);
  }
  .services-grid__cell-rule {
    display: block;
    width: 32px;
    height: 1px;
    background: var(--accent);
    margin: var(--space-4) 0 0;
    transform-origin: left center;
    transition: transform var(--dur-hover) var(--ease);
  }
  .services-grid__cell:hover .services-grid__cell-rule { transform: scaleX(1.875); }
  .services-grid__cell-body {
    margin-top: var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--muted);
    max-width: 380px;
    text-wrap: pretty;
  }
  .services-grid__cell-foot {
    margin-top: auto;
    padding-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    border-top: 1px dashed var(--hairline);
  }
  .services-grid__cell-foot-key {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .services-grid__cell-foot-val {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.04em;
    color: var(--ink);
    line-height: var(--leading-body);
  }
  /* Lien cas d'usage par service · fusion UseCaseIndex (1 grille, 2 niveaux de lecture) */
  .services-grid__cell-uc {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-text);
    text-decoration: none;
    width: fit-content;
  }
  .services-grid__cell-uc:hover { text-decoration: underline; text-underline-offset: 3px; }
  /* Pied de grille · liens index (cas d'usage / secteurs) */
  .services-grid__foot {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--hairline-strong);
  }
  .services-grid__foot-link {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 2px;
    transition: color var(--dur-fast) var(--ease);
  }
  .services-grid__foot-link:hover { color: var(--accent-text); }
  .services-grid__cell-arr {
    position: absolute;
    bottom: 18px;
    right: 22px;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--accent-text);
    transition: transform var(--dur-hover) var(--ease);
  }
  .services-grid__cell:hover .services-grid__cell-arr { transform: translateX(4px); }
  /* Le responsive colonnes est porté par .qgrid (grid.css : recompositions :has()
     puis 1 colonne sous 768px). Le filet hairline (border-right/bottom par cell +
     overflow conteneur) reste correct quelle que soit la disposition, donc plus de
     media-queries de colonnes/bordures locales (elles entraient en conflit). */
  /* ── Alternance des fonds R4 · defaut paper-2 (clair) = rendu inchange ── */
  .services-grid[data-bg='paper'] { background: var(--paper); }
  .services-grid[data-bg='paper-3'] { background: var(--paper-3); }
  .services-grid[data-bg='ink'] {
    background: var(--ink);
  }
  /* Connecteurs / metas mono : utilisent --ink direct -> recolore clair */
  .services-grid[data-bg='ink'] :is(.services-grid__h2, .services-grid__cell-title, .services-grid__cell-fig, .services-grid__cell-foot-val, .services-grid__foot-link) { color: var(--paper); }
  .services-grid[data-bg='ink'] :is(.services-grid__cell-body, .services-grid__cell-foot-key) { color: var(--muted); }
  .services-grid[data-bg='ink'] .services-grid__cell:hover {
    background: rgba(var(--paper-rgb), 0.05);
    border-color: var(--accent-text);
  }
  /* ── Tuile illustration · bento complet ─────────────────────────────────
     Sans illustration : data-bento absent → grille .qgrid inchangée (régression nulle).
     Avec illustration : grille déterministe + la tuile comble le vide de la 2e rangée. */
  @media (min-width: 1024px) {
    .services-grid__grid[data-bento] { grid-template-columns: repeat(5, 1fr); }
    .services-grid__grid[data-bento] > .services-grid__illus { grid-column: 2 / -1; grid-row: 2; }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .services-grid__grid[data-bento] { grid-template-columns: repeat(3, 1fr); }
    .services-grid__grid[data-bento] > .services-grid__illus { grid-column: 1 / -1; }
  }
  .services-grid__illus {
    margin: 0 -1px -1px 0;
    border-right: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--space-3);
    padding: var(--spacing-block) var(--space-6);
    min-height: 300px;
    background: rgba(var(--accent-rgb), 0.03);
  }
  .services-grid__illus-art { width: 100%; max-width: 760px; color: var(--ink-2); }
  .services-grid__illus-art :global(svg) { width: 100%; height: auto; display: block; }
  .services-grid__illus-cap {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: center;
  }
  /* Variante ink : la couche line-art reste lisible (color clair). */
  .services-grid[data-bg='ink'] .services-grid__illus-art { color: var(--paper); }
</style>
