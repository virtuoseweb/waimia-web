---
// Section W6 · tech-capabilities-specs
// Inventaire technique en table spec (capacité · description · statut).
// Source : TechnologiesDetailTemplate.astro « 3. CAPABILITIES GRID » (table .tt-specs)
//          + CSS .tech-sec-hd / .tt-specs* (l.440-464, 722-778, 832-836).
// - CSS = COPIE VERBATIM des règles du template (mêmes tokens/valeurs). status rendu brut.
import Kicker from '../ui/atoms/Kicker.astro';
import type { SectionByType } from '@waimia/ds-kernel';
interface Props {
  data: SectionByType<'tech-capabilities-specs'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---
<section class="tech-sec" data-bg={data.background} data-screen-label="03 Capabilities">
  <div class="wrap">
    <div class="tech-sec-hd u-serif-accent">
      <div>
        <Kicker>{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
        <h2 set:html={isFr ? data.title_fr : data.title_en} />
      </div>
      {(isFr ? data.aside_fr : data.aside_en) && (
        <p class="tech-aside">{isFr ? data.aside_fr : data.aside_en}</p>
      )}
    </div>
    <div class="tech-cap-table-wrap reveal-stagger">
      <table class="tt-specs">
        <thead>
          <tr>
            <th scope="col">Capacité</th>
            <th scope="col">Description</th>
            <th scope="col">Statut</th>
          </tr>
        </thead>
        <tbody>
          {data.capabilities.map((item) => (
            <tr>
              <td class="tt-spec-name">{isFr ? item.name_fr : item.name_en}</td>
              <td class="tt-spec-desc">{isFr ? item.description_fr : item.description_en}</td>
              <td class="tt-spec-status">{item.status}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  /* ───── Sec common + header (COPIE VERBATIM TechnologiesDetailTemplate.astro) ───── */
  .tech-sec { padding: var(--section-loose) 0; position: relative; }
  .tech-sec-hd {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
    margin-bottom: var(--space-9);
    align-items: end;
  }
  .tech-sec-hd h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    letter-spacing: -0.018em;
    font-weight: var(--fw-medium);
    margin: var(--space-2) 0 0;
  }
  .tech-aside {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--muted);
    max-width: 480px;
    margin: 0;
  }

  /* ───── Capabilities Specs Table — COPIE VERBATIM ───── */
  .tech-cap-table-wrap {
    overflow-x: auto;
  }
  .tt-specs {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: var(--text-small);
  }
  .tt-specs thead th {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
    text-align: left;
    padding: 0 var(--space-5) var(--space-4) 0;
    border-bottom: 1px solid var(--hairline, rgba(var(--ink-rgb), 0.12));
    font-weight: var(--fw-regular);
    white-space: nowrap;
  }
  .tt-specs thead th:last-child { padding-right: 0; text-align: right; }
  .tt-specs tbody tr {
    border-bottom: 1px solid var(--hairline, rgba(var(--ink-rgb), 0.08));
    transition: background var(--dur-fast) var(--ease);
  }
  .tt-specs tbody tr:last-child { border-bottom: none; }
  .tt-specs tbody tr:hover { background: rgba(var(--ink-rgb), 0.02); }
  .tt-spec-name {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: var(--fw-medium);
    color: var(--ink);
    padding: var(--space-5) var(--space-5) var(--space-5) 0;
    vertical-align: top;
    white-space: nowrap;
    width: 22%;
  }
  .tt-spec-desc {
    font-size: var(--text-small);
    line-height: 1.55;
    color: var(--ink);
    padding: var(--space-5) var(--space-5) var(--space-5) 0;
    vertical-align: top;
  }
  .tt-spec-status {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono-tight);
    color: var(--accent-text);
    padding: var(--space-5) 0;
    vertical-align: top;
    text-align: right;
    white-space: nowrap;
    width: 10%;
  }

  .wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 var(--gut);
  }

  @media (max-width: 700px) {
    .tt-spec-name { white-space: normal; }
    .tt-spec-status { text-align: left; padding-left: 0; }
    .tt-specs thead th:last-child { text-align: left; }
  }
  @media (max-width: 800px) {
    .tech-sec-hd { grid-template-columns: 1fr; }
  }

  /* ════════ Fonds composables R4 · defaut paper inchange ════════ */
  .tech-sec[data-bg='paper-2'] { background: var(--paper-2); }
  .tech-sec[data-bg='paper-3'] { background: var(--paper-3); }
  .tech-sec[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .tech-sec[data-bg='ink'] h2 { color: var(--paper); }
  .tech-sec[data-bg='ink'] .tech-aside { color: rgba(var(--paper-rgb), 0.7); }
  /* Table specs sur ink : entetes, hairlines, noms/desc clairs, hover subtil */
  .tech-sec[data-bg='ink'] .tt-specs thead th { color: var(--muted); border-bottom-color: rgba(var(--paper-rgb), 0.14); }
  .tech-sec[data-bg='ink'] .tt-specs tbody tr { border-bottom-color: rgba(var(--paper-rgb), 0.1); }
  .tech-sec[data-bg='ink'] .tt-specs tbody tr:hover { background: rgba(var(--paper-rgb), 0.04); }
  .tech-sec[data-bg='ink'] .tt-spec-name { color: var(--paper); }
  .tech-sec[data-bg='ink'] .tt-spec-desc { color: rgba(var(--paper-rgb), 0.82); }
</style>
