---
/**
 * method-stepline · « Méthode · timeline HORIZONTALE sur fond clair »
 * Une ligne hairline continue traverse la rangée à hauteur des nœuds ; 5 nœuds = disques
 * accent répartis régulièrement. Sous chaque nœud : numéro mono accent DÉRIVÉ de l'index
 * (00, 01…), titre serif, sous-label mono majuscule muted.
 * EN-TÊTE → kicker mono à puce accent (idiome ChapterLabel/SystemFlow) à gauche, durée mono
 * discrète à droite, filet hairline sous le bandeau.
 * Modèles : SystemFlow.astro (header, rail, reveal-stagger, responsive) + ChapterLabel (kicker).
 * Responsive : ≤780px empilage en colonne, la ligne devient verticale (aucun débordement page).
 */
import type { SectionByType } from '@waimia/ds-kernel';

interface Props {
  data: SectionByType<'method-stepline'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';

const kicker = isFr ? data.kicker_fr : (data.kicker_en ?? data.kicker_fr);
const duration = isFr ? data.duration_fr : (data.duration_en ?? data.duration_fr);
const h2 = isFr ? data.h2_fr : (data.h2_en ?? data.h2_fr);
const lede = isFr ? data.lede_fr : (data.lede_en ?? data.lede_fr);
const steps = data.steps.map((s) => ({
  title: isFr ? s.title_fr : s.title_en,
  sub: isFr ? s.sub_fr : s.sub_en,
}));
// Numéro DÉRIVÉ de l'index (00, 01…), jamais stocké.
const num = (i: number) => String(i + 1).padStart(2, '0');

// ── Vague C · Batch 5. Résolution raccourci↔placement : UN data-attr effectif par région.
// Défaut absent = rail horizontal actuel. grid-steps lit data-columns ('auto' = count-adaptive).
const msLayout = data.layout;
const msPl = data.placement;
const msHeaderAlign = msPl?.header?.align ?? data.contentAlign;
const msHeaderOrder = msPl?.header?.order;
const msHeaderHide = msPl?.header?.hideOn;
const msBodyOrder = msPl?.body?.order;
const msBodyHide = msPl?.body?.hideOn;
const msGridCols = msLayout === 'grid-steps' ? (data.columns ?? 'auto') : undefined;
---
<section
  class="ms"
  data-bg={data.background ?? 'paper'}
  data-layout={msLayout}
  data-density={data.density}
  data-content-align={data.contentAlign}
  aria-label={kicker}
>
  <div class="wrap-wide ms__inner reveal-stagger">
    <header
      class="ms-hd"
      data-header-align={msHeaderAlign}
      data-header-order={msHeaderOrder}
      data-header-hide={msHeaderHide}
    >
      {kicker && (
        <span class="ms-kicker">
          <span class="ms-kicker__dot" aria-hidden="true"></span>
          {kicker}
        </span>
      )}
      {duration && <span class="ms-duration">{duration}</span>}
    </header>

    {h2 && <h2 class="ms-title" set:html={h2} />}
    {lede && <p class="ms-lede">{lede}</p>}

    <ol class="ms-line" data-columns={msGridCols} data-body-order={msBodyOrder} data-body-hide={msBodyHide}>
      {steps.map((step, i) => (
        <li class="ms-node">
          <span class="ms-node__dot" aria-hidden="true"></span>
          <span class="ms-node__num">{num(i)}</span>
          <h3 class="ms-node__title">{step.title}</h3>
          <span class="ms-node__sub">{step.sub}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .ms {
    padding-block: var(--section-base);
  }

  .ms-hd {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--hairline);
    margin-bottom: var(--space-7);
  }
  /* Kicker mono à puce accent (idiome ChapterLabel/SystemFlow). */
  .ms-kicker {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
    font-weight: var(--fw-medium);
  }
  .ms-kicker__dot {
    width: var(--space-1);
    height: var(--space-1);
    background: var(--accent);
    border-radius: var(--radius-full);
    align-self: center;
  }
  .ms-duration {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }

  .ms-title {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    line-height: var(--leading-h2);
    letter-spacing: -0.015em;
    font-weight: var(--fw-semibold);
    color: var(--ink);
    max-width: 22ch;
    margin: 0 0 var(--space-5);
    text-wrap: balance;
  }
  .ms-title :global(i) { font-family: var(--font-display); font-weight: var(--fw-regular); letter-spacing: var(--tracking-display); font-style: italic; }
  .ms-title :global(i.acc),
  .ms-title :global(.acc) { font-style: italic; color: var(--accent); }

  .ms-lede {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: var(--leading-lede);
    color: var(--muted);
    max-width: 56ch;
    margin: 0 0 var(--space-9);
    text-wrap: pretty;
  }

  /* Rangée horizontale : ligne hairline continue derrière les nœuds. */
  .ms-line {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    position: relative;
  }
  /* La ligne traverse la rangée à hauteur du centre des nœuds (les nœuds font var(--space-3)). */
  .ms-line::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--space-3) / 2);
    height: 1px;
    background: var(--hairline);
  }

  .ms-node {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    position: relative;
  }
  .ms-node__dot {
    width: var(--space-3);
    height: var(--space-3);
    border-radius: var(--radius-full);
    background: var(--accent);
    /* anneau paper pour masquer la ligne sous le disque, comme une perle sur un fil */
    box-shadow: 0 0 0 var(--space-1) var(--paper);
    margin-bottom: var(--space-3);
  }
  .ms-node__num {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--accent-text);
  }
  .ms-node__title {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    font-weight: var(--fw-medium);
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .ms-node__sub {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ≤780px : empilage en colonne, la ligne devient verticale le long du rail des nœuds. */
  @media (max-width: 780px) {
    .ms-line {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-6);
    }
    .ms-line::before {
      top: 0;
      bottom: 0;
      left: calc(var(--space-3) / 2);
      right: auto;
      width: 1px;
      height: auto;
    }
    .ms-node { flex: 1 1 auto; padding-left: var(--space-6); }
    .ms-node__dot {
      position: absolute;
      left: 0;
      top: 0;
      margin-bottom: 0;
    }
  }

  /* ── Vague C · Batch 5 · DENSITY (data-density). Défaut absent = rythme actuel. ── */
  .ms[data-density='compact'] { padding-block: var(--space-8); }
  .ms[data-density='compact'] .ms-line { gap: var(--space-3); }
  .ms[data-density='ample'] { padding-block: var(--space-12); }
  .ms[data-density='ample'] .ms-line { gap: var(--space-6); }

  /* ── CONTENT-ALIGN + header placement. Le header est une rangée space-between ; center/end
     décalent le kicker. Défaut = start (rendu actuel). ── */
  .ms-hd[data-header-align='center'] { justify-content: center; }
  .ms-hd[data-header-align='end'] { justify-content: flex-end; }
  .ms[data-content-align='center'] .ms-title,
  .ms[data-content-align='center'] .ms-lede { margin-inline: auto; text-align: center; }
  .ms[data-content-align='end'] .ms-title,
  .ms[data-content-align='end'] .ms-lede { margin-inline-start: auto; text-align: end; }

  /* order / hideOn structurels. ms__inner est déjà un flux vertical (les enfants s'empilent). */
  .ms-hd[data-header-order='0'] { order: 0; }
  .ms-hd[data-header-order='1'] { order: 1; }
  .ms-line[data-body-order='0'] { order: 0; }
  .ms-line[data-body-order='1'] { order: 1; }
  .ms-hd[data-header-hide='desktop'],
  .ms-line[data-body-hide='desktop'] { display: none; }
  @media (max-width: 768px) {
    .ms-hd[data-header-hide='mobile'],
    .ms-line[data-body-hide='mobile'] { display: none; }
    .ms-hd[data-header-hide='desktop'] { display: flex; }
    .ms-line[data-body-hide='desktop'] { display: flex; }
  }

  /* ── VOCABULAIRE DE LAYOUT (data-layout). Défaut absent = rail horizontal (rendu actuel).
     Tous les modes gardent la numérotation 00..N dérivée et le disque accent aligné. ── */

  /* vertical-stack : la ligne devient verticale (rail à gauche, perles le long du fil) à TOUTES
     les largeurs. Réutilise l'idiome déjà prouvé du breakpoint ≤780px. */
  .ms[data-layout='vertical-stack'] .ms-line {
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-6);
  }
  .ms[data-layout='vertical-stack'] .ms-line::before {
    top: 0; bottom: 0; left: calc(var(--space-3) / 2); right: auto; width: 1px; height: auto;
  }
  .ms[data-layout='vertical-stack'] .ms-node { flex: 1 1 auto; padding-left: var(--space-6); }
  .ms[data-layout='vertical-stack'] .ms-node__dot { position: absolute; left: 0; top: 0; margin-bottom: 0; }

  /* numbered-rows : lignes pleine largeur séparées par hairline, numéro à gauche, titre+sub à
     droite. Pas de rail continu (chaque ligne porte son numéro). */
  .ms[data-layout='numbered-rows'] .ms-line { flex-direction: column; align-items: stretch; gap: 0; }
  .ms[data-layout='numbered-rows'] .ms-line::before { display: none; }
  .ms[data-layout='numbered-rows'] .ms-node {
    flex: 1 1 auto;
    flex-direction: row;
    align-items: baseline;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-top: 1px solid var(--hairline);
  }
  .ms[data-layout='numbered-rows'] .ms-node:last-child { border-bottom: 1px solid var(--hairline); }
  .ms[data-layout='numbered-rows'] .ms-node__dot { align-self: center; margin-bottom: 0; box-shadow: none; }
  .ms[data-layout='numbered-rows'] .ms-node__num { flex: 0 0 auto; }
  .ms[data-layout='numbered-rows'] .ms-node__title { flex: 1 1 auto; }

  /* grid-steps : nœuds en grille de cartes hairline, count-adaptive (auto) ou N colonnes fixes.
     Pas de rail continu. Absorbe 2..N étapes (auto-fit / centrage dernière ligne). */
  .ms[data-layout='grid-steps'] .ms-line {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    justify-content: center;
    align-items: stretch;
  }
  .ms[data-layout='grid-steps'] .ms-line::before { display: none; }
  .ms[data-layout='grid-steps'] .ms-line[data-columns='2'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ms[data-layout='grid-steps'] .ms-line[data-columns='3'] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .ms[data-layout='grid-steps'] .ms-line[data-columns='4'] { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .ms[data-layout='grid-steps'] .ms-node {
    flex: 1 1 auto;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }
  .ms[data-layout='grid-steps'] .ms-node__dot { box-shadow: none; }

  @media (max-width: 780px) {
    .ms[data-layout='grid-steps'] .ms-line,
    .ms[data-layout='grid-steps'] .ms-line[data-columns='2'],
    .ms[data-layout='grid-steps'] .ms-line[data-columns='3'],
    .ms[data-layout='grid-steps'] .ms-line[data-columns='4'] { grid-template-columns: 1fr; }
  }

  /* ── Alternance des fonds (idiome DS data-bg). Défaut absent = transparent (paper) = rendu actuel. ── */
  .ms[data-bg='paper-2'] { background: var(--paper-2); }
  .ms[data-bg='paper-3'] { background: var(--paper-3); }
  .ms[data-bg='ink'] { background: var(--ink); }
  /* L'anneau du nœud masque le fil : il doit suivre le FOND de section (sinon halo clair sur teinte/ink). */
  .ms[data-bg='paper-2'] .ms-node__dot { box-shadow: 0 0 0 var(--space-1) var(--paper-2); }
  .ms[data-bg='paper-3'] .ms-node__dot { box-shadow: 0 0 0 var(--space-1) var(--paper-3); }
  .ms[data-bg='ink'] .ms-node__dot { box-shadow: 0 0 0 var(--space-1) var(--ink); }
  /* Variante ink : titres lisibles (le global [data-bg='ink'] gère déjà kicker/sub/lede/hairline via --muted/--accent-text). */
  .ms[data-bg='ink'] :is(.ms-title, .ms-node__title) { color: var(--paper); }
  .ms[data-bg='ink'] .ms-title :global(i.acc),
  .ms[data-bg='ink'] .ms-title :global(.acc) { color: var(--accent-sur-sombre, var(--accent)); }

  @media (prefers-reduced-motion: reduce) {
    .reveal-stagger > * { transition: none; }
  }
</style>
