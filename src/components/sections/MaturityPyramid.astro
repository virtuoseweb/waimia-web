---
// Section W6 · maturity-pyramid · pyramide 4 tiers (paliers d'engagement)
// Variant 'full' : timeline + SVG paliers + ec-grid cols-4 (rendu historique inchangé)
// Variant 'cards-only' (V-F2, 1 info = 1 représentation) : les 4 cards seules, enrichies
//   stage (sur-titre) + prix d'entrée + jauge de progression I→IV (hairline accent)
// Motion : .scale-in stagger sur cards + .lift hover
// Mémorable : « Quatre paliers, lus comme un escalier vers la souveraineté. »
//
// Composé de · SectionHeader (refactor atomic-components 2026-04-26)

import SectionHeader from '../ui/molecules/SectionHeader.astro';
import type { SectionByType } from '../../schemas/sections';

interface Props {
  data: SectionByType<'maturity-pyramid'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const cardsOnly = data.variant === 'cards-only';
const showFull = !cardsOnly && Boolean(data.steps);
---
<section class="sec sec-paper" data-bg={data.background} aria-labelledby="pyramid-h2">
  <div class="wrap-wide">
    <SectionHeader
      roman={data.roman}
      label={isFr ? data.label_fr : data.label_en}
      id="pyramid-h2"
    >
      <Fragment slot="heading" set:html={isFr ? data.heading_fr : data.heading_en} />
      <Fragment slot="aside">
        {isFr ? data.aside_fr : data.aside_en}
      </Fragment>
    </SectionHeader>

    {/* Timeline maturité V7 · 4 étapes Audit → Workflow → System → Infrastructure · variant full only */}
    {showFull && (
    <ol class="pyramid-timeline reveal reveal-fade" aria-label={isFr ? data.timeline_label_fr : data.timeline_label_en}>
      {(data.steps ?? []).map((step) => (
        <li class="pyramid-step">
          <span class="pyramid-step-roman">{step.roman}</span>
          <span class="pyramid-step-verb">{isFr ? step.verb_fr : step.verb_en}</span>
          <span class="pyramid-step-stage">{isFr ? step.stage_fr : step.stage_en}</span>
        </li>
      ))}
    </ol>
    )}

    {showFull && (
    <div class="pyramid-svg reveal-blur-clip">
      <svg viewBox="0 0 800 160" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="presentation">
        {/* Palier I · accent solide · investment minimal mais signal max */}
        <rect x="0" y="20" width="60" height="120" fill="var(--accent)" fill-opacity="0.22" stroke="var(--accent)" stroke-width="1.2"/>
        <text x="30" y="84" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--accent)" font-style="italic">I</text>
        <text x="30" y="156" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--accent)" letter-spacing="0.14em">{isFr ? data.tiers[0].tag_fr : data.tiers[0].tag_en}</text>

        {/* Palier II · accent tinté */}
        <rect x="64" y="20" width="116" height="120" fill="var(--accent)" fill-opacity="0.10" stroke="var(--accent)" stroke-width="1" stroke-opacity="0.6"/>
        <text x="122" y="84" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)" font-style="italic">II</text>
        <text x="122" y="156" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-2)" letter-spacing="0.14em">{isFr ? data.tiers[1].tag_fr : data.tiers[1].tag_en}</text>

        {/* Palier III · ink-2 */}
        <rect x="184" y="20" width="196" height="120" fill="var(--accent)" fill-opacity="0.05" stroke="var(--ink-2)" stroke-width="1" stroke-opacity="0.6"/>
        <text x="282" y="84" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)" font-style="italic">III</text>
        <text x="282" y="156" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-2)" letter-spacing="0.14em">{isFr ? data.tiers[2].tag_fr : data.tiers[2].tag_en}</text>

        {/* Palier IV · hairline */}
        <rect x="384" y="20" width="416" height="120" fill="transparent" stroke="var(--hairline-strong)" stroke-width="1"/>
        <text x="592" y="84" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)" font-style="italic">IV</text>
        <text x="592" y="156" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-2)" letter-spacing="0.14em">{isFr ? data.tiers[3].tag_fr : data.tiers[3].tag_en}</text>
      </svg>
    </div>
    )}

    <div class:list={['ec-grid', 'cols-4', 'pyramid-asym', 'reveal-stagger', cardsOnly && 'pyramid-cards-only']}>
      {data.tiers.map((tier, idx) => (
        <a class="editorial-cell lift" href={tier.href}>
          {cardsOnly ? (
            (isFr ? tier.stage_fr : tier.stage_en) && (
              <span class="e-stage">{isFr ? tier.stage_fr : tier.stage_en}</span>
            )
          ) : (
            <span class="e-action">{isFr ? tier.action_fr : tier.action_en}</span>
          )}
          <span class="e-num">{tier.n}</span>
          <span class="e-tag">{isFr ? tier.tag_fr : tier.tag_en}</span>
          <h3 class="e-title">{isFr ? tier.label_fr : tier.label_en}</h3>
          <p class="e-body">{isFr ? tier.lead_fr : tier.lead_en}</p>
          <ul class="e-list">
            {(isFr ? tier.items_fr : tier.items_en).map((it) => <li>{it}</li>)}
          </ul>
          {cardsOnly && (isFr ? tier.price_fr : tier.price_en) && (
            <span class="e-price">{isFr ? tier.price_fr : tier.price_en}</span>
          )}
          <span class="e-go">{isFr ? data.tier_cta_fr : data.tier_cta_en}</span>
          {cardsOnly && (
            <span class="e-gauge" aria-hidden="true">
              <span class="e-gauge-fill" style={`width: ${(idx + 1) * 25}%`}></span>
            </span>
          )}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* V6 densification "1 viewport par section majeure" */
  .sec[aria-labelledby="pyramid-h2"] {
    padding: var(--section-base) 0;
  }
  .pyramid-svg {
    margin: var(--space-7) 0 var(--space-7);
    overflow: visible;
  }
  .pyramid-svg svg {
    width: 100%;
    height: auto;
    max-height: 140px;
  }

  .pyramid-asym {
    grid-template-columns: 7fr 5fr 4fr 8fr;
  }

  /* V6 densification · override editorial-cell pour cards plus compactes (Pyramid only) */
  .pyramid-asym .editorial-cell {
    padding: var(--space-5) var(--space-4);
    gap: var(--space-2);
  }
  .pyramid-asym .editorial-cell .e-num {
    font-size: var(--text-h2);
    line-height: 1;
  }
  .pyramid-asym .editorial-cell .e-title {
    font-size: var(--text-h3);
    line-height: 1.05;
    margin-top: var(--space-1);
  }
  .pyramid-asym .editorial-cell .e-body {
    font-size: var(--text-small);
    line-height: 1.45;
  }
  .pyramid-asym .editorial-cell .e-list {
    font-size: var(--text-small);
    gap: 3px;
  }
  .pyramid-asym .editorial-cell .e-list li {
    line-height: var(--leading-lede);
  }

  /* Tier I · primary visual weight · border accent + e-num accent par défaut */
  .pyramid-asym .editorial-cell:first-child {
    border-color: var(--accent-text);
    background: rgba(var(--accent-rgb), 0.025);
  }
  .pyramid-asym .editorial-cell:first-child .e-num {
    color: var(--accent-text);
  }
  .pyramid-asym .editorial-cell:first-child .e-tag {
    color: var(--accent-text);
  }

  .editorial-cell {
    transition: transform var(--dur-fast) var(--ease, var(--ease)), border-color var(--dur-fast) var(--ease, var(--ease)), background var(--dur-fast) var(--ease, var(--ease));
  }

  .editorial-cell:hover {
    border-color: var(--accent-text);
    background: rgba(var(--accent-rgb), 0.04);
  }

  .editorial-cell:hover .e-num {
    color: var(--accent-text);
    transition: color var(--dur-fast) var(--ease, var(--ease));
  }

  @media (max-width: 900px) {
    .pyramid-asym {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .pyramid-asym {
      grid-template-columns: 1fr;
    }
  }

  /* ── Variant cards-only (V-F2) · 4 colonnes égales, la progression passe par la jauge ── */
  .pyramid-cards-only {
    grid-template-columns: repeat(4, 1fr);
  }
  /* Stage en sur-titre de card (info unique reprise de la timeline supprimée) */
  .pyramid-asym .editorial-cell .e-stage {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: var(--space-1);
  }
  /* Prix d'entrée du palier · l'engagement chiffré (source FAQ/offres) */
  .pyramid-asym .editorial-cell .e-price {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono-tight);
    text-transform: uppercase;
    color: var(--accent-text);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px dashed var(--hairline);
  }
  /* Jauge de progression I→IV · hairline accent qui s'étend (remplace le SVG paliers) */
  .pyramid-asym .editorial-cell .e-gauge {
    display: block;
    margin-top: var(--space-3);
    height: 2px;
    background: var(--hairline);
    overflow: hidden;
  }
  .pyramid-asym .editorial-cell .e-gauge-fill {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform var(--dur-reveal) var(--ease) var(--dur-fast);
  }
  .reveal-stagger:is(.in, .is-visible) .e-gauge-fill,
  .pyramid-asym:is(.in, .is-visible) .editorial-cell .e-gauge-fill {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .pyramid-asym .editorial-cell .e-gauge-fill { transform: scaleX(1); transition: none; }
  }
  @media (max-width: 900px) {
    .pyramid-cards-only { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .pyramid-cards-only { grid-template-columns: 1fr; }
  }

  /* V7 · Timeline maturité Audit → Workflow → System → Infrastructure */
  .pyramid-timeline {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-7);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--hairline-strong);
    border-bottom: 1px solid var(--hairline);
    position: relative;
  }

  .pyramid-step {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-5);
    border-right: 1px solid var(--hairline);
    position: relative;
  }
  .pyramid-step:last-child { border-right: none; }

  .pyramid-step::before {
    content: '';
    position: absolute;
    top: -3px;
    left: var(--space-5);
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--accent);
  }

  .pyramid-step-roman {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .pyramid-step-verb {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .pyramid-step-stage {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  /* Action verb override dans les cards */
  .pyramid-asym .editorial-cell .e-action {
    display: block;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-small);
    color: var(--accent-text);
    margin-bottom: var(--space-1);
    letter-spacing: -0.01em;
  }

  @media (max-width: 900px) {
    .pyramid-timeline { grid-template-columns: repeat(2, 1fr); }
    .pyramid-step:nth-child(2n) { border-right: none; }
    .pyramid-step:nth-child(odd) { border-right: 1px solid var(--hairline); }
  }
  @media (max-width: 560px) {
    .pyramid-timeline { grid-template-columns: 1fr; }
    .pyramid-step, .pyramid-step:nth-child(n) { border-right: none; border-bottom: 1px solid var(--hairline); }
    .pyramid-step:last-child { border-bottom: none; }
  }

  /* ── Alternance des fonds · defaut .sec-paper (clair) = rendu inchange ── */
  .sec[data-bg='paper-2'] { background: var(--paper-2); }
  .sec[data-bg='paper-3'] { background: var(--paper-3); }
  .sec[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
    --ink-2: rgba(var(--paper-rgb), 0.74);
  }
  /* Texte principal repasse en paper ; l'accent terracotta reste */
  .sec[data-bg='ink'] :is(h2, h3, p, li, .e-title, .e-body, .pyramid-step-verb) { color: var(--paper); }
  .sec[data-bg='ink'] :is(.e-tag, .e-stage, .e-list, .pyramid-step-roman) { color: var(--muted); }
  .sec[data-bg='ink'] .pyramid-step-stage { color: rgba(var(--paper-rgb), 0.74); }
  .sec[data-bg='ink'] .e-num { color: var(--paper); }
  /* Cartes editorial : fond legerement releve + bord paper-hairline sur ink */
  .sec[data-bg='ink'] :global(.editorial-cell) {
    background: rgba(var(--paper-rgb), 0.04);
    border-color: rgba(var(--paper-rgb), 0.14);
  }
  .sec[data-bg='ink'] .pyramid-asym .editorial-cell:first-child {
    border-color: var(--accent-text);
    background: rgba(var(--accent-rgb), 0.10);
  }
  .sec[data-bg='ink'] :global(.editorial-cell:hover) {
    border-color: var(--accent-text);
    background: rgba(var(--accent-rgb), 0.12);
  }
  /* Jauge / prix : accent conserve, base hairline paper */
  .sec[data-bg='ink'] .pyramid-asym .editorial-cell .e-gauge { background: rgba(var(--paper-rgb), 0.14); }
  .sec[data-bg='ink'] .pyramid-asym .editorial-cell .e-price { border-top-color: rgba(var(--paper-rgb), 0.18); }
  /* SVG paliers : les fills/strokes en --ink/--ink-2 (texte invisible sur ink) repassent paper ;
     l'accent terracotta des paliers I-II reste. Inline fill SVG est ecrase par cette regle CSS. */
  .sec[data-bg='ink'] .pyramid-svg svg text[fill='var(--ink)'] { fill: var(--paper); }
  .sec[data-bg='ink'] .pyramid-svg svg text[fill='var(--ink-2)'] { fill: rgba(var(--paper-rgb), 0.74); }
  .sec[data-bg='ink'] .pyramid-svg svg rect[stroke='var(--ink-2)'] { stroke: rgba(var(--paper-rgb), 0.5); }
  .sec[data-bg='ink'] .pyramid-svg svg rect[stroke='var(--hairline-strong)'] { stroke: rgba(var(--paper-rgb), 0.28); }
</style>
