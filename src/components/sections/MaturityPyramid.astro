---
// Section W6 · maturity-pyramid
// Timeline 4 étapes de maturité + SVG pyramide à 4 paliers + grille 4 cards.
// Source : `Pyramid.astro` (Acte II — Cartographier → Industrialiser).
import type { SectionByType } from '../../schemas/sections';

interface Props {
  data: SectionByType<'maturity-pyramid'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';

const tiers = data.tiers;
const widths = [60, 116, 196, 416];
const offsets = [0, 64, 184, 384];
const numAt = [30, 122, 282, 592];
---

<section class="maturity-pyramid" aria-labelledby="maturity-pyramid-h2">
  <div class="wrap-wide">
    <header class="maturity-pyramid__hd">
      <p class="maturity-pyramid__kicker">
        <span class="maturity-pyramid__roman">{data.roman}</span>
        <span>{isFr ? data.label_fr : data.label_en}</span>
      </p>
      <div>
        <h2 id="maturity-pyramid-h2" class="maturity-pyramid__h2" set:html={isFr ? data.heading_fr : data.heading_en} />
        {data.aside_fr && data.aside_en && (
          <p class="maturity-pyramid__aside">{isFr ? data.aside_fr : data.aside_en}</p>
        )}
      </div>
    </header>

    <ol class="maturity-pyramid__timeline reveal reveal-fade" aria-label={isFr ? data.timeline_label_fr : data.timeline_label_en}>
      {data.steps.map((step) => (
        <li class="maturity-pyramid__step">
          <span class="maturity-pyramid__step-roman">{step.roman}</span>
          <span class="maturity-pyramid__step-verb">{isFr ? step.verb_fr : step.verb_en}</span>
          <span class="maturity-pyramid__step-stage">{isFr ? step.stage_fr : step.stage_en}</span>
        </li>
      ))}
    </ol>

    <div class="maturity-pyramid__svg reveal-blur-clip">
      <svg viewBox="0 0 800 160" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="presentation">
        {tiers.slice(0, 4).map((tier, idx) => {
          const x = offsets[idx];
          const w = widths[idx];
          const cx = numAt[idx];
          const isFirst = idx === 0;
          const isSecond = idx === 1;
          const fillOpacity = isFirst ? 0.22 : isSecond ? 0.10 : idx === 2 ? 0.05 : 0;
          const strokeColor = idx === 3 ? 'var(--hairline-strong)' : 'var(--accent)';
          const strokeOpacity = isFirst ? 1 : isSecond ? 0.6 : idx === 2 ? 0.6 : 1;
          const strokeWidth = isFirst ? 1.2 : 1;
          const numFill = isFirst ? 'var(--accent)' : 'var(--ink)';
          const tagFill = isFirst ? 'var(--accent)' : 'var(--ink-2)';
          return (
            <>
              <rect x={x} y="20" width={w} height="120" fill={idx === 3 ? 'transparent' : 'var(--accent)'} fill-opacity={fillOpacity} stroke={strokeColor} stroke-width={strokeWidth} stroke-opacity={strokeOpacity}/>
              <text x={cx} y="84" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill={numFill} font-style="italic">{tier.n}</text>
              <text x={cx} y="156" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill={tagFill} letter-spacing="0.14em">{isFr ? tier.tag_fr : tier.tag_en}</text>
            </>
          );
        })}
      </svg>
    </div>

    <div class="maturity-pyramid__cards reveal-stagger">
      {tiers.map((tier) => (
        <a class="maturity-pyramid__card" href={tier.href}>
          <span class="maturity-pyramid__card-action">{isFr ? tier.action_fr : tier.action_en}</span>
          <span class="maturity-pyramid__card-num">{tier.n}</span>
          <span class="maturity-pyramid__card-tag">{isFr ? tier.tag_fr : tier.tag_en}</span>
          <h3 class="maturity-pyramid__card-title">{isFr ? tier.label_fr : tier.label_en}</h3>
          <p class="maturity-pyramid__card-body">{isFr ? tier.lead_fr : tier.lead_en}</p>
          <ul class="maturity-pyramid__card-list">
            {(isFr ? tier.items_fr : tier.items_en).map((it) => (<li>{it}</li>))}
          </ul>
          <span class="maturity-pyramid__card-go">{isFr ? data.tier_cta_fr : data.tier_cta_en}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .maturity-pyramid {
    padding: clamp(56px, 7vw, 88px) 0;
    background: var(--paper);
  }
  .maturity-pyramid__hd {
    display: grid;
    grid-template-columns: 1.3fr 2fr;
    gap: clamp(24px, 3vw, 48px);
    align-items: end;
    margin-bottom: clamp(24px, 3vw, 40px);
    padding-bottom: 14px;
    border-bottom: 1px solid var(--hairline);
  }
  .maturity-pyramid__kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .maturity-pyramid__roman {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 28px;
    color: var(--accent);
    line-height: 1;
  }
  .maturity-pyramid__h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h2-section);
    line-height: var(--leading-h2);
    letter-spacing: -0.025em;
    font-weight: 400;
    text-wrap: balance;
    color: var(--ink);
  }
  .maturity-pyramid__h2 :global(i) { font-style: italic; color: var(--accent); }
  .maturity-pyramid__aside {
    margin: 14px 0 0;
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 540px;
  }
  .maturity-pyramid__timeline {
    list-style: none;
    padding: 0;
    margin: 0 0 clamp(28px, 3vw, 44px);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--hairline-strong);
    border-bottom: 1px solid var(--hairline);
  }
  .maturity-pyramid__step {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: clamp(20px, 2.2vw, 28px) clamp(16px, 1.8vw, 24px);
    border-right: 1px solid var(--hairline);
    position: relative;
  }
  .maturity-pyramid__step:last-child { border-right: none; }
  .maturity-pyramid__step::before {
    content: '';
    position: absolute;
    top: -3px;
    left: clamp(16px, 1.8vw, 24px);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .maturity-pyramid__step-roman {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  .maturity-pyramid__step-verb {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-h3-row);
    line-height: var(--leading-h3);
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .maturity-pyramid__step-stage {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .maturity-pyramid__svg {
    margin: 0 0 clamp(28px, 3vw, 44px);
    overflow: visible;
  }
  .maturity-pyramid__svg svg {
    width: 100%;
    height: auto;
    max-height: 140px;
  }
  .maturity-pyramid__cards {
    display: grid;
    grid-template-columns: 7fr 5fr 4fr 8fr;
    gap: 0;
    border-top: 1px solid var(--hairline-strong);
  }
  .maturity-pyramid__card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: clamp(16px, 1.8vw, 24px) clamp(14px, 1.4vw, 20px);
    border-right: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    color: inherit;
    text-decoration: none;
    transition: transform 200ms var(--ease), border-color 200ms var(--ease), background 200ms var(--ease);
  }
  .maturity-pyramid__card:last-child { border-right: none; }
  .maturity-pyramid__card:hover { border-color: var(--accent); background: rgba(201, 79, 46, 0.04); }
  .maturity-pyramid__card:first-child { border-color: var(--accent); background: rgba(201, 79, 46, 0.025); }
  .maturity-pyramid__card:first-child .maturity-pyramid__card-num,
  .maturity-pyramid__card:first-child .maturity-pyramid__card-tag { color: var(--accent); }
  .maturity-pyramid__card:hover .maturity-pyramid__card-num { color: var(--accent); }
  .maturity-pyramid__card-action {
    display: block;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(14px, 1.2vw, 17px);
    color: var(--accent);
    margin-bottom: 4px;
    letter-spacing: -0.01em;
  }
  .maturity-pyramid__card-num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(28px, 3.2vw, 44px);
    line-height: 1;
    color: var(--ink);
    transition: color 200ms var(--ease);
  }
  .maturity-pyramid__card-tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .maturity-pyramid__card-title {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-size: clamp(18px, 1.5vw, 24px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 400;
    color: var(--ink);
    text-wrap: balance;
  }
  .maturity-pyramid__card-body {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--muted);
  }
  .maturity-pyramid__card-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .maturity-pyramid__card-list li::before { content: '· '; color: var(--accent); }
  .maturity-pyramid__card-go {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  @media (max-width: 900px) {
    .maturity-pyramid__hd { grid-template-columns: 1fr; }
    .maturity-pyramid__timeline { grid-template-columns: repeat(2, 1fr); }
    .maturity-pyramid__step:nth-child(2n) { border-right: none; }
    .maturity-pyramid__step:nth-child(odd) { border-right: 1px solid var(--hairline); }
    .maturity-pyramid__cards { grid-template-columns: repeat(2, 1fr); }
    .maturity-pyramid__card:nth-child(2n) { border-right: none; }
  }
  @media (max-width: 560px) {
    .maturity-pyramid__timeline { grid-template-columns: 1fr; }
    .maturity-pyramid__step { border-right: none; border-bottom: 1px solid var(--hairline); }
    .maturity-pyramid__step:last-child { border-bottom: none; }
    .maturity-pyramid__cards { grid-template-columns: 1fr; }
    .maturity-pyramid__card { border-right: none; }
  }
</style>
