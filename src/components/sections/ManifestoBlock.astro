---
// Section catalogue · manifesto-block
// COPIE FIDÈLE de `src/components/ui/organisms/Manifesto.astro`
// Grand bloc display italique sans box, kicker mono, span accent.
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'manifesto-block'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---
<section class="manifesto-block" aria-labelledby="manifesto-block-anchor">
  <div class="wrap-wide">
    <Kicker class="manifesto-block__kicker">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
    <p id="manifesto-block-anchor" class="manifesto-block__text reveal" set:html={isFr ? data.text_fr : data.text_en} />
  </div>
</section>

<style>
  .wrap-wide { max-width: 1200px; margin-inline: auto; padding-inline: clamp(20px, 4vw, 48px); }
  .manifesto-block {
    padding: clamp(140px,18vw,260px) 0;
    background: var(--paper);
    position: relative;
    overflow: hidden;
  }
  :global(.manifesto-block__kicker) { margin-bottom: 24px; }
  .manifesto-block__text {
    font-family: var(--font-display);
    font-size: clamp(36px,6.2vw,96px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    max-width: 1300px;
    font-weight: 400;
    text-wrap: balance;
  }
  .manifesto-block__text :global(.acc) { color: var(--accent); }
  .manifesto-block__text :global(span) { color: var(--accent); }
</style>
