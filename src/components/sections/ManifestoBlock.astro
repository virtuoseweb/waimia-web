---
// Section catalogue · manifesto-block
// COPIE FIDÈLE de `src/components/ui/organisms/Manifesto.astro`
// Grand bloc display italique sans box, kicker mono, span accent.
import type { SectionByType } from '@waimia/ds-kernel';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'manifesto-block'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---
<section class="manifesto-block" data-bg={data.background} aria-labelledby="manifesto-block-anchor">
  <div class="wrap-wide">
    <Kicker class="manifesto-block__kicker">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
    <p id="manifesto-block-anchor" class="manifesto-block__text reveal" set:html={isFr ? data.text_fr : data.text_en} />
  </div>
</section>

<style>
  .wrap-wide { max-width: 1200px; margin-inline: auto; }
  .manifesto-block {
    padding: var(--section-grand) 0;
    position: relative;
    overflow: hidden;
  }
  :global(.manifesto-block__kicker) { margin-bottom: var(--space-5); }
  .manifesto-block__text {
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    line-height: 1.04;
    letter-spacing: -0.02em;
    max-width: 1300px;
    font-weight: var(--fw-medium);
    text-wrap: balance;
  }
  .manifesto-block__text :global(.acc) { font-family: var(--font-display); font-weight: var(--fw-regular); color: var(--accent-text); }
  .manifesto-block__text :global(span) { color: var(--accent-text); }

  /* ── Alternance des fonds · defaut paper (clair) = rendu inchange ── */
  .manifesto-block[data-bg='paper-2'] { background: var(--paper-2); }
  .manifesto-block[data-bg='paper-3'] { background: var(--paper-3); }
  .manifesto-block[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .manifesto-block[data-bg='ink'] :is(.manifesto-block__kicker, .manifesto-block__text) { color: var(--paper); }
  /* L'accent terracotta des span reste lisible sur ink */
  .manifesto-block[data-bg='ink'] .manifesto-block__text :global(.acc),
  .manifesto-block[data-bg='ink'] .manifesto-block__text :global(span) { color: var(--accent-text); }
</style>
