---
// Section W6 · pain-points (famille Solutions)
// Points de friction métier : header (eyebrow mono + h2 display) + aside Callout + Timeline numérotée.
// Source : SolutionsDetailTemplate.astro (markup l.273-296, CSS scoped l.473-556).
// - markup/CSS = COPIE VERBATIM des styles scoped legacy (tokens var(--*), 0 hex brut).
// - mappe items → events Timeline { num, title, body, variant } (1er = highlight).
import Callout from '../editorial/Callout.astro';
import Timeline from '../editorial/Timeline.astro';
import Kicker from '../ui/atoms/Kicker.astro';
import type { SectionByType } from '../../schemas/sections';
interface Props {
  data: SectionByType<'pain-points'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const eyebrow = isFr ? data.eyebrow_fr : data.eyebrow_en;
const h2 = isFr ? data.h2_fr : data.h2_en;
const aside = isFr ? data.aside_fr : data.aside_en;
const events = data.items.map((item, i) => ({
  num: item.num ?? String(i + 1).padStart(2, '0'),
  title: isFr ? item.title_fr : item.title_en,
  body: isFr ? item.body_fr : item.body_en,
  variant: i === 0 ? ('highlight' as const) : ('default' as const),
}));
---
<section class="sol-sec sol-friction reveal-stagger" data-bg={data.background} data-screen-label="02 Pain Points">
  <div class="wrap g12 g12--full">
    <header class="sol-sec-hd section-eyebrow col-prose u-serif-accent">
      <Kicker as="span" tone="accent" class="eyebrow">{eyebrow}</Kicker>
      <h2 set:html={h2} />
    </header>
    <div class="sol-aside col-aside">
      <Callout variant="note" size="sm">
        {aside ? (
          <Fragment set:html={aside} />
        ) : (
          <>Avant d'automatiser, comprendre où le temps se perd. Les frictions récurrentes que nous voyons sur le terrain.</>
        )}
      </Callout>
    </div>
    <div class="sol-pain-grid col-12">
      <Timeline events={events} numbered={true} />
    </div>
  </div>
</section>

<style>
  /* ───── Sec common — COPIE VERBATIM SolutionsDetailTemplate l.473-518 ───── */
  .sol-sec { padding: var(--section-base) 0; position: relative; }
  .sol-friction { margin-top: var(--section-base); }
  .sol-sec-hd {
    margin-bottom: var(--spacing-block);
  }
  /* Kicker canonisé (R4) · typo portée par l'atome Kicker, ici layout seul */
  .section-eyebrow :global(.eyebrow) {
    display: inline-block;
    margin-bottom: var(--space-3);
  }
  .sol-sec-hd h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    letter-spacing: -0.018em;
    font-weight: var(--fw-medium);
    margin: var(--space-2) 0 0;
  }
  .sol-aside {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: var(--leading-body);
    color: var(--muted);
    font-style: italic;
    max-width: 480px;
    margin: 0;
  }
  .sol-aside :global(.callout) {
    margin: 0;
  }

  /* ───── Pain Points — COPIE VERBATIM l.520-556 ───── */
  .sol-pain-grid {
    display: block;
  }
  .sol-pain-grid :global(.pain-card) {
    padding-top: var(--space-6);
    border-top: 1px solid var(--hairline);
  }
  .sol-pain-grid :global(.pn) {
    font-family: var(--font-display);
    font-size: var(--text-numeral);
    line-height: 0.85;
    color: var(--ink);
    margin-bottom: var(--space-4);
    font-weight: var(--fw-regular);
  }
  .sol-pain-grid :global(.pk) {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: var(--space-3);
  }
  .sol-pain-grid :global(.pain-card h3) {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: 1.22;
    margin: 0 0 var(--space-3);
    font-weight: var(--fw-medium);
  }
  .sol-pain-grid :global(.pain-card h3 i),
  .sol-pain-grid :global(.pain-card h3 em) {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: var(--fw-regular);
    color: var(--accent-text);
  }
  .sol-pain-grid :global(.pain-card p) {
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--ink);
    margin: 0;
  }

  /* ── Alternance des fonds · defaut (transparent/paper) = rendu inchange ── */
  .sol-sec[data-bg='paper-2'] { background: var(--paper-2); }
  .sol-sec[data-bg='paper-3'] { background: var(--paper-3); }
  .sol-sec[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .sol-sec[data-bg='ink'] .sol-sec-hd h2 { color: var(--paper); }
  .sol-sec[data-bg='ink'] .sol-sec-hd :global(i) { font-family: var(--font-display); font-weight: var(--fw-regular); color: var(--accent-text); }
  .sol-sec[data-bg='ink'] .sol-aside { color: var(--muted); }
  /* Timeline (molecule editorial, classes reelles .timeline-*) sur ink :
     titre (--ink) + corps (--ink-2) etaient sombres sur sombre -> repassent paper.
     Numero + dot accent conserves. */
  .sol-sec[data-bg='ink'] :global(.timeline-title) { color: var(--paper); }
  .sol-sec[data-bg='ink'] :global(.timeline-body) { color: rgba(var(--paper-rgb), 0.74); }
  .sol-sec[data-bg='ink'] :global(.timeline-meta) { color: var(--muted); }
  .sol-sec[data-bg='ink'] :global(.timeline-num) { color: var(--accent-text); }
  /* Filet vertical de la timeline (hairline) lisible sur ink */
  .sol-sec[data-bg='ink'] :global(.timeline-vertical)::before { background: rgba(var(--paper-rgb), 0.14); }
</style>
