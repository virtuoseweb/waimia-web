---
// Section W6 · use-case-index
// Index éditorial de cas d'usage par département (rows mono numérotées).
// Source : `Departments.astro` (§ 05 — Cas d'usage horizontaux) — COPIE VERBATIM data-driven.
import SectionHeader from '../ui/molecules/SectionHeader.astro';
import type { SectionByType } from '@waimia/ds-kernel';
interface Props {
  data: SectionByType<'use-case-index'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---
<section class="sec" aria-labelledby="dept-h2" data-bg={data.background}>
  <div class="wrap-wide">
    <SectionHeader
      roman={data.roman}
      label={isFr ? data.label_fr : data.label_en}
      id="dept-h2"
    >
      <Fragment slot="heading" set:html={isFr ? data.heading_fr : data.heading_en} />
      <Fragment slot="aside">
        {isFr ? data.aside_fr : data.aside_en}
      </Fragment>
    </SectionHeader>

    <ul class="dept-index reveal-stagger">
      {data.items.map((item, i) => (
        <li>
          <a class="dept-row" href={item.href}>
            <span class="dept-row-num"><span class="dept-row-num-prefix">{isFr ? data.num_prefix_fr : data.num_prefix_en} </span>{`0${i + 1}`}</span>
            <span class="dept-row-label u-serif-accent u-serif-accent-em">{isFr ? item.label_fr : item.label_en}</span>
            <span class="dept-row-tag">{isFr ? item.tag_fr : item.tag_en}</span>
            <span class="dept-row-arr" aria-hidden>→</span>
          </a>
        </li>
      ))}
    </ul>

    <a class="dept-sector lift" href={data.footer_href}>
      <span>{isFr ? data.footer_label_fr : data.footer_label_en}</span>
    </a>
  </div>
</section>

<style>
  /* V6 densification scoped · réduit padding section sans toucher global .sec */
  .sec[aria-labelledby="dept-h2"] {
    padding: var(--section-base) 0;
  }

  .dept-index {
    list-style: none;
    padding: 0;
    margin: 0;
    margin-top: var(--space-6);
    border-top: 1px solid var(--hairline-strong);
  }

  .dept-index li {
    display: contents;
  }

  .dept-row {
    display: grid;
    grid-template-columns: minmax(120px, max-content) 1.4fr 1fr 32px;
    gap: var(--space-6);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--hairline);
    align-items: baseline;
    color: inherit;
    text-decoration: none;
    transition: background var(--dur-trim) var(--ease), translate var(--dur-hover) var(--ease);
  }

  .dept-row:hover {
    background: rgba(var(--accent-rgb), 0.04);
    translate: 12px 0;
  }

  .dept-row:hover .dept-row-label {
    color: var(--accent-text);
  }

  .dept-row:hover .dept-row-arr {
    color: var(--accent-text);
    transform: translateX(4px);
  }

  .dept-row-num {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: .16em;
    color: var(--muted);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* H3 row token sémantique · cf tokens.css */
  .dept-row-label {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-style: normal;
    font-weight: var(--fw-medium);
    line-height: var(--leading-h3);
    letter-spacing: -0.018em;
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease);
  }

  .dept-row-tag {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--ink-2);
    align-self: center;
  }

  .dept-row-arr {
    font-family: var(--font-mono);
    font-size: var(--text-body);
    color: var(--muted);
    text-align: right;
    transition: color var(--dur-trim) var(--ease), transform var(--dur-hover) var(--ease);
    align-self: center;
  }

  @media (max-width: 900px) {
    .dept-row {
      grid-template-columns: 1fr;
      row-gap: 6px;
      padding: var(--space-6) 0;
    }

    .dept-row-num {
      grid-column: 1 / -1;
    }

    .dept-row-label {
      grid-column: 1 / -1;
      font-size: var(--text-h3);
    }

    .dept-row-tag {
      grid-column: 1 / -1;
    }

    .dept-row-arr {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .dept-row-num-prefix {
      display: none;
    }

    .dept-row {
      padding: var(--space-4) 0;
    }
  }

  .dept-sector {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100%, 360px);
    min-height: 96px;
    margin-top: var(--space-7);
    padding: var(--space-5) 28px;
    border: 1px solid var(--hairline-strong);
    color: inherit;
    background: var(--paper);
  }

  .dept-sector span {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  /* ── Alternance des fonds R4 · defaut paper = rendu inchange ── */
  .sec[aria-labelledby="dept-h2"][data-bg='paper-2'] { background: var(--paper-2); }
  .sec[aria-labelledby="dept-h2"][data-bg='paper-3'] { background: var(--paper-3); }

  /* ── Idiome dark (ink) — fond sombre soigne, contraste AA ── */
  .sec[aria-labelledby="dept-h2"][data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .sec[aria-labelledby="dept-h2"][data-bg='ink'] :global(.sec-hd h2) { color: var(--paper); }
  .sec[aria-labelledby="dept-h2"][data-bg='ink'] :global(.sec-hd .aside) { color: var(--muted); }
  .sec[aria-labelledby="dept-h2"][data-bg='ink'] .dept-index { border-top-color: var(--hairline-strong); }
  .sec[aria-labelledby="dept-h2"][data-bg='ink'] .dept-row { border-bottom-color: var(--hairline); }
  .sec[aria-labelledby="dept-h2"][data-bg='ink'] .dept-row-label { color: var(--paper); }
  .sec[aria-labelledby="dept-h2"][data-bg='ink'] .dept-row-num,
  .sec[aria-labelledby="dept-h2"][data-bg='ink'] .dept-row-arr { color: var(--muted); }
  .sec[aria-labelledby="dept-h2"][data-bg='ink'] .dept-row-tag { color: rgba(var(--paper-rgb), 0.82); }
  .sec[aria-labelledby="dept-h2"][data-bg='ink'] .dept-row:hover { background: rgba(var(--paper-rgb), 0.05); }
  .sec[aria-labelledby="dept-h2"][data-bg='ink'] .dept-sector {
    background: var(--ink-2);
    border-color: var(--hairline-strong);
  }
</style>
