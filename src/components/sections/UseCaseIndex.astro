---
// Section W6 · use-case-index
// Index éditorial de cas d'usage par département (rows mono numérotées).
// Source : `Departments.astro` (§ 05 — Cas d'usage horizontaux) — COPIE VERBATIM data-driven.
import SectionHeader from '../ui/molecules/SectionHeader.astro';
import type { SectionByType } from '../../schemas/sections';
interface Props {
  data: SectionByType<'use-case-index'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---
<section class="sec" aria-labelledby="dept-h2">
  <div class="wrap-wide">
    <SectionHeader
      roman={data.roman}
      label={isFr ? data.label_fr : data.label_en}
      id="dept-h2"
    >
      <Fragment slot="heading" set:html={isFr ? data.heading_fr : data.heading_en} />
      <Fragment slot="aside">
        {isFr ? data.aside_fr : data.aside_en}
      </Fragment>
    </SectionHeader>

    <ul class="dept-index reveal-stagger">
      {data.items.map((item, i) => (
        <li>
          <a class="dept-row" href={item.href}>
            <span class="dept-row-num"><span class="dept-row-num-prefix">{isFr ? data.num_prefix_fr : data.num_prefix_en} </span>{`0${i + 1}`}</span>
            <span class="dept-row-label">{isFr ? item.label_fr : item.label_en}</span>
            <span class="dept-row-tag">{isFr ? item.tag_fr : item.tag_en}</span>
            <span class="dept-row-arr" aria-hidden>→</span>
          </a>
        </li>
      ))}
    </ul>

    <a class="dept-sector lift" href={data.footer_href}>
      <span>{isFr ? data.footer_label_fr : data.footer_label_en}</span>
    </a>
  </div>
</section>

<style>
  /* V6 densification scoped · réduit padding section sans toucher global .sec */
  .sec[aria-labelledby="dept-h2"] {
    padding: clamp(56px, 7vw, 88px) 0;
  }

  .dept-index {
    list-style: none;
    padding: 0;
    margin: 0;
    margin-top: clamp(20px, 2.5vw, 32px);
    border-top: 1px solid var(--hairline-strong);
  }

  .dept-index li {
    display: contents;
  }

  .dept-row {
    display: grid;
    grid-template-columns: 70px 1.4fr 1fr 32px;
    gap: clamp(20px, 2vw, 32px);
    padding: clamp(16px, 1.8vw, 24px) 0;
    border-bottom: 1px solid var(--hairline);
    align-items: baseline;
    color: inherit;
    text-decoration: none;
    transition: background 220ms var(--ease, var(--ease)), padding-left 320ms var(--ease, var(--ease)), padding-right 320ms var(--ease, var(--ease));
  }

  .dept-row:hover {
    background: rgba(var(--accent-rgb), 0.04);
    padding-left: 14px;
    padding-right: 14px;
  }

  .dept-row:hover .dept-row-label {
    color: var(--accent);
  }

  .dept-row:hover .dept-row-arr {
    color: var(--accent);
    transform: translateX(4px);
  }

  .dept-row-num {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: .16em;
    color: var(--muted);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* H3 row token sémantique · cf tokens.css */
  .dept-row-label {
    font-family: var(--font-display);
    font-size: var(--text-h3-row);
    font-style: italic;
    font-weight: var(--fw-regular);
    line-height: var(--leading-h3);
    letter-spacing: -0.02em;
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease, var(--ease));
  }

  .dept-row-tag {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-2);
    align-self: center;
  }

  .dept-row-arr {
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--muted);
    text-align: right;
    transition: color 240ms var(--ease, var(--ease)), transform 320ms var(--ease, var(--ease));
    align-self: center;
  }

  @media (max-width: 900px) {
    .dept-row {
      grid-template-columns: 1fr;
      row-gap: 6px;
      padding: clamp(18px, 2vw, 28px) 0;
    }

    .dept-row-num {
      grid-column: 1 / -1;
    }

    .dept-row-label {
      grid-column: 1 / -1;
      font-size: clamp(22px, 5vw, 28px);
    }

    .dept-row-tag {
      grid-column: 1 / -1;
    }

    .dept-row-arr {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .dept-row-num-prefix {
      display: none;
    }

    .dept-row {
      padding: var(--space-4) 0;
    }
  }

  .dept-sector {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100%, 360px);
    min-height: 96px;
    margin-top: clamp(24px, 3vw, 40px);
    padding: var(--space-5) 28px;
    border: 1px solid var(--hairline-strong);
    color: inherit;
    background: var(--paper);
  }

  .dept-sector span {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--accent);
  }
</style>
