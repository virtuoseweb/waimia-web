---
// ARCHÉTYPE R5 · « stats-led » — 1 composant paramétrable → 3 type-ids (presets).
// Héros kicker num + h1 monumental + lede + grille de stats en pied.
// hero-hub-stats + hero-pillar-hub : COPIE FIDÈLE du `.hub-masthead` historique
// (src/components/templates/HubTemplate.astro:123-159, template supprimé R0).
// Absorbe (R5a) : hero-conversion-funnel (preset flagship conversion : pills +
// benefits + proof + 2 CTA + stats). Markup + CSS BYTE-IDENTIQUES par variante ;
// seul ajustement = `.wrap-wide` qualifié `.hero-conversion-funnel .wrap-wide`
// (collision max-width, colocalisation). Résultat visuel inchangé.
import type { SectionByType } from '@waimia/ds-kernel';
import Kicker from '../ui/atoms/Kicker.astro';
import Button from '../ui/atoms/Button.astro';
import DropCap from '../editorial/DropCap.astro';
import KeyMetric from '../editorial/KeyMetric.astro';

// Line-art DS inliné au build via ?raw : le SVG vit dans le DOM →
// `stroke="currentColor"` suit la couleur de texte de la coque média (variant split).
// Un média raster (registre editorial) retombe sur <img> inchangé.
// Pattern identique à FeatureZigzag.astro. Clé = basename.
const lineArtRaw = import.meta.glob<string>('../../assets/line-art/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const lineArt: Record<string, string> = {};
for (const [path, svg] of Object.entries(lineArtRaw)) {
  lineArt[path.split('/').pop()!] = svg;
}
const inlineLineArt = (src?: string): string | undefined =>
  src ? lineArt[src.split('/').pop()!] : undefined;

interface Props {
  data:
    | SectionByType<'hero-hub-stats'>
    | SectionByType<'hero-pillar-hub'>
    | SectionByType<'hero-conversion-funnel'>;
  lang: 'fr' | 'en';
  ledeDropCap?: string;
  /**
   * hero-conversion-funnel : largeur max du conteneur `.wrap-wide`. Optionnel — par
   * défaut le composant conserve sa largeur catalogue (`1200px`, via la règle scopée,
   * inchangée pour la preview). Les templates live peuvent passer la largeur
   * d'origine (ex. `var(--wrap-wide)` = 1560px) pour préserver leur rythme.
   */
  wrapMaxWidth?: string;
  /**
   * hero-conversion-funnel : rendu des stats via l'atome `KeyMetric` (au lieu des
   * `.hero-conversion-funnel__stat` internes). Défaut `false` (rendu catalogue inchangé).
   */
  statsAsKeyMetric?: boolean;
  /**
   * hero-conversion-funnel : ajoute la classe d'animation `reveal` au kicker.
   * Défaut `false` (rendu catalogue inchangé).
   */
  kickerReveal?: boolean;
}
const { data, lang, ledeDropCap, wrapMaxWidth, statsAsKeyMetric = false, kickerReveal = false } = Astro.props;
const isFr = lang === 'fr';
const isPillar = data.type === 'hero-pillar-hub';
const cfWrapStyle = wrapMaxWidth ? `max-width:${wrapMaxWidth}` : undefined;
const cfNumClass = kickerReveal ? 'hero-conversion-funnel__num reveal' : 'hero-conversion-funnel__num';
// Variant de traitement (split | sumie | minimal). `undefined` = rendu catalogue
// d'origine (branche par défaut ci-dessous, byte-identique à avant).
const cfVariant = data.type === 'hero-conversion-funnel' ? data.variant : undefined;
const cfMediaAlt =
  data.type === 'hero-conversion-funnel'
    ? (isFr ? (data.media_alt_fr ?? '') : (data.media_alt_en ?? data.media_alt_fr ?? ''))
    : '';
// Registre média (variant split) : `lineart` = grammaire DS (trait/diagramme posé
// sur fond paper-2, hairline) ; `editorial` = illustration recolorée pleine colonne.
// Absent → `lineart` (défaut comportemental), rétrocompat des usages existants.
const cfMediaRegister =
  data.type === 'hero-conversion-funnel' ? (data.media_register ?? 'lineart') : 'lineart';
---
{data.type === 'hero-conversion-funnel' && cfVariant ? (
<section class:list={['hero-conversion-funnel', `hero-conversion-funnel--${cfVariant}`]} data-bg={data.background} data-variant={cfVariant}>
  <div class="wrap-wide" style={cfWrapStyle}>
    {cfVariant === 'split' ? (
      <div class="hero-cf-split" data-layout="split-text-media" data-media-register={cfMediaRegister}>
        <div class="hero-cf-split__text">
          <Kicker tone="accent" class={cfNumClass}>{data.funnel_num}</Kicker>
          <h1 class="hero-conversion-funnel__h1 reveal-mask-up u-serif-accent" set:html={isFr ? data.h1_fr : data.h1_en} />
          <p class="hero-conversion-funnel__lede reveal" set:html={isFr ? data.lede_fr : data.lede_en} />
          {data.meta_pills && data.meta_pills.length > 0 && (
            <ul class="hero-cf-split__meta reveal" aria-label={isFr ? "Repères de l'offre" : 'Offer markers'}>
              {data.meta_pills.slice(0, 3).map((pill) => (
                <li>{isFr ? pill.label_fr : pill.label_en}</li>
              ))}
            </ul>
          )}
          <div class="hero-conversion-funnel__cta">
            <Button href={data.cta_primary.href} variant="primary" size="lg" mag={0.18}>
              {isFr ? data.cta_primary.label_fr : data.cta_primary.label_en}
            </Button>
            {data.cta_secondary && (
              <Button href={data.cta_secondary.href} variant="ghost" size="lg">
                {isFr ? data.cta_secondary.label_fr : data.cta_secondary.label_en}
              </Button>
            )}
          </div>
        </div>
        {data.media_src && (
          <figure class="hero-cf-split__media reveal-fade reveal">
            {(() => {
              const isSvg = data.media_src?.endsWith('.svg');
              const art = cfMediaRegister === 'lineart' && isSvg ? inlineLineArt(data.media_src) : undefined;
              return art
                ? <div class="hero-cf-split__art" set:html={art} role={cfMediaAlt ? 'img' : undefined} aria-label={cfMediaAlt || undefined} aria-hidden={cfMediaAlt ? undefined : 'true'} />
                : <img src={data.media_src} alt={cfMediaAlt} loading="eager" decoding="async" width="720" height="560" />;
            })()}
          </figure>
        )}
      </div>
    ) : cfVariant === 'minimal' ? (
      <div class="hero-cf-minimal">
        <Kicker tone="accent" class={`${cfNumClass} hero-cf-minimal__num`}>{data.funnel_num}</Kicker>
        <h1 class="hero-conversion-funnel__h1 reveal-mask-up u-serif-accent hero-cf-minimal__h1" set:html={isFr ? data.h1_fr : data.h1_en} />
        <p class="hero-conversion-funnel__lede reveal hero-cf-minimal__lede" set:html={isFr ? data.lede_fr : data.lede_en} />
        {data.stats && data.stats.length > 0 && (
          <div class="hero-cf-minimal__stats reveal-stagger">
            {data.stats.map((s) => (
              <div class="hero-cf-minimal__stat">
                <span class="hero-cf-minimal__stat-value">{s.value}</span>
                <span class="hero-cf-minimal__stat-label">{isFr ? s.label_fr : s.label_en}</span>
              </div>
            ))}
          </div>
        )}
        <div class="hero-conversion-funnel__cta hero-cf-minimal__cta">
          <Button href={data.cta_primary.href} variant="primary" size="lg" mag={0.18}>
            {isFr ? data.cta_primary.label_fr : data.cta_primary.label_en}
          </Button>
          {data.cta_secondary && (
            <Button href={data.cta_secondary.href} variant="ghost" size="lg">
              {isFr ? data.cta_secondary.label_fr : data.cta_secondary.label_en}
            </Button>
          )}
        </div>
      </div>
    ) : (
      <div class="hero-cf-sumie">
        <div class="hero-cf-sumie__bg" aria-hidden="true">
          <svg class="hero-cf-sumie__art draw-on-scroll" viewBox="0 0 480 320" fill="none" style="--draw-len:1400" preserveAspectRatio="xMidYMid meet">
            <g stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="240" cy="160" r="52" />
              <circle cx="240" cy="96" r="9" />
              <circle cx="296" cy="138" r="9" />
              <circle cx="296" cy="190" r="9" />
              <circle cx="240" cy="224" r="9" />
              <circle cx="184" cy="190" r="9" />
              <circle cx="184" cy="138" r="9" />
              <path d="M240 105 L240 134" />
              <path d="M289 143 L258 155" />
              <path d="M289 185 L258 168" />
              <path d="M240 215 L240 186" />
              <path d="M191 185 L222 168" />
              <path d="M191 143 L222 155" />
            </g>
          </svg>
        </div>
        <div class="hero-cf-sumie__inner">
          <Kicker tone="accent" class={cfNumClass}>{data.funnel_num}</Kicker>
          <h1 class="hero-conversion-funnel__h1 reveal-split-letter u-serif-accent" set:html={isFr ? data.h1_fr : data.h1_en} />
          <p class="hero-conversion-funnel__lede reveal" set:html={isFr ? data.lede_fr : data.lede_en} />
          <div class="hero-conversion-funnel__cta">
            <Button href={data.cta_primary.href} variant="primary" size="lg" mag={0.18}>
              {isFr ? data.cta_primary.label_fr : data.cta_primary.label_en}
            </Button>
            {data.cta_secondary && (
              <Button href={data.cta_secondary.href} variant="ghost" size="lg">
                {isFr ? data.cta_secondary.label_fr : data.cta_secondary.label_en}
              </Button>
            )}
          </div>
          {data.stats && data.stats.length > 0 && (
            <div class="hero-conversion-funnel__stats reveal-stagger">
              {data.stats.map((s, idx) => (
                <div class:list={['hero-conversion-funnel__stat', idx === 0 && 'hero-conversion-funnel__stat--lead']}>
                  <div class="hero-conversion-funnel__stat-value">{s.value}</div>
                  <div class="hero-conversion-funnel__stat-label">{isFr ? s.label_fr : s.label_en}</div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    )}
  </div>
</section>
) : data.type === 'hero-conversion-funnel' ? (
<section class="hero-conversion-funnel" data-bg={data.background}>
  <div class="wrap-wide" style={cfWrapStyle}>
    <Kicker tone="accent" class={cfNumClass}>{data.funnel_num}</Kicker>
    <h1 class="hero-conversion-funnel__h1 reveal-mask-up u-serif-accent" set:html={isFr ? data.h1_fr : data.h1_en} />
    <p class="hero-conversion-funnel__lede reveal" set:html={isFr ? data.lede_fr : data.lede_en} />
    {data.meta_pills && data.meta_pills.length > 0 && (
      <div class="hero-conversion-funnel__meta reveal-stagger" aria-label={isFr ? "Repères de l'offre" : 'Offer markers'}>
        {data.meta_pills.map((pill) => (
          <span>{isFr ? pill.label_fr : pill.label_en}</span>
        ))}
      </div>
    )}
    {data.benefits && data.benefits.length > 0 && (
      <div class="hero-conversion-funnel__benefits reveal">
        <ul>
          {data.benefits.map((b) => (
            <li>{isFr ? b.label_fr : b.label_en}</li>
          ))}
        </ul>
      </div>
    )}
    {data.proof_fr && (
      <p class="hero-conversion-funnel__proof reveal">
        {isFr ? data.proof_fr : (data.proof_en ?? data.proof_fr)}
      </p>
    )}
    <div class="hero-conversion-funnel__cta">
      <Button href={data.cta_primary.href} variant="primary" size="lg" mag={0.18}>
        {isFr ? data.cta_primary.label_fr : data.cta_primary.label_en}
      </Button>
      {data.cta_secondary && (
        <Button href={data.cta_secondary.href} variant="ghost" size="lg">
          {isFr ? data.cta_secondary.label_fr : data.cta_secondary.label_en}
        </Button>
      )}
    </div>
    {data.stats && data.stats.length > 0 && (
      <div class="hero-conversion-funnel__stats reveal-stagger">
        {statsAsKeyMetric
          ? data.stats.map((s, idx) => (
              <KeyMetric
                value={s.value}
                label={isFr ? s.label_fr : s.label_en}
                size={idx === 0 ? 'lg' : 'md'}
                variant={idx === 0 ? 'accent' : 'default'}
              />
            ))
          : data.stats.map((s, idx) => (
              <div class:list={['hero-conversion-funnel__stat', idx === 0 && 'hero-conversion-funnel__stat--lead']}>
                <div class="hero-conversion-funnel__stat-value">{s.value}</div>
                <div class="hero-conversion-funnel__stat-label">{isFr ? s.label_fr : s.label_en}</div>
              </div>
            ))}
      </div>
    )}
  </div>
</section>
) : isPillar ? (
<section class="hero-pillar-hub" data-bg={data.background}>
  <div class="wrap-wide">
    <Kicker class="hero-pillar-hub__meta">{isFr ? data.meta_kicker_fr : data.meta_kicker_en}</Kicker>
    <Kicker tone="accent" class="hero-pillar-hub__num">§ {data.hub_num}</Kicker>
    <h1 class="hero-pillar-hub__h1 reveal-mask-up u-serif-accent" set:html={isFr ? data.h1_fr : data.h1_en} />
    <p class="hero-pillar-hub__lede reveal reveal-fade">{isFr ? data.lede_fr : data.lede_en}</p>
    {data.stats && data.stats.length > 0 && (
      <div class="hero-pillar-hub__stats reveal-stagger">
        {data.stats.map((s, index) => (
          <KeyMetric
            value={s.value}
            label={isFr ? s.label_fr : s.label_en}
            size={index === 0 ? 'lg' : 'md'}
            variant={index === 1 ? 'accent' : 'default'}
          />
        ))}
      </div>
    )}
  </div>
</section>
) : (
<section class="hero-hub-stats" data-bg={data.background}>
  <div class="wrap-wide">
    <Kicker class="hero-hub-stats__meta">{isFr ? data.meta_kicker_fr : data.meta_kicker_en}</Kicker>
    <Kicker tone="accent" class="hero-hub-stats__num">§ {data.hub_num}</Kicker>
    <h1 class="hero-hub-stats__h1 reveal-mask-up u-serif-accent" set:html={isFr ? data.h1_fr : data.h1_en} />
    <div class="hero-hub-stats__lede reveal">
      {ledeDropCap
        ? <p><DropCap variant="mono">{ledeDropCap}</DropCap><Fragment set:html={isFr ? data.lede_fr : data.lede_en}/></p>
        : <p set:html={isFr ? data.lede_fr : data.lede_en} />
      }
    </div>
    {data.stats && data.stats.length > 0 && (
      <div class="hero-hub-stats__grid reveal-stagger">
        {data.stats.map((s, idx) => (
          <div class:list={['hero-hub-stats__cell', idx === 0 && 'hero-hub-stats__cell--lead', s.emphasis && 'hero-hub-stats__cell--accent']}>
            <div class="hero-hub-stats__value">{s.value}</div>
            <div class="hero-hub-stats__label">{isFr ? s.label_fr : s.label_en}</div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
)}

<style>
  /* ── hero-hub-stats ─────────────────────────────────────────────────────── */
  .hero-hub-stats {
    min-height: 100vh;
    min-height: calc(var(--viewport-h) - var(--hero-chrome-above));
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    padding-top: calc(var(--header-height) + var(--space-6));
    padding-bottom: var(--space-6);
    padding-left: var(--space-6);
    padding-right: var(--space-6);
  }
  .hero-hub-stats .wrap-wide { max-width: 1200px; margin-inline: auto; }
  :global(.hero-hub-stats__meta) { display: inline-flex; gap: var(--space-2); margin-bottom: var(--space-5); }
  :global(.hero-hub-stats__num) { display: block; margin-bottom: var(--space-5); }
  .hero-hub-stats__h1 {
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    line-height: 0.88;
    letter-spacing: -0.015em;
    text-wrap: balance;
    font-weight: var(--fw-semibold);
    margin: 0;
  }
  .hero-hub-stats__lede {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: 1.3;
    margin-top: var(--space-6);
    max-width: 980px;
    color: var(--muted);
    text-wrap: balance;
  }
  .hero-hub-stats__lede p { margin: 0; }

  .hero-hub-stats__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin-top: var(--space-9);
    border-top: 1px solid var(--hairline-strong);
    border-bottom: 1px solid var(--hairline);
  }
  .hero-hub-stats__cell {
    min-height: 100%;
    min-width: 0;
    padding: var(--space-7) var(--space-5);
    border-right: 1px solid var(--hairline);
    /* La cellule est le conteneur de référence (cqi) de sa valeur : une valeur textuelle
       longue (ex. un nom de ville) se dimensionne sur SA cellule et ne déborde plus sur la voisine. */
    container-type: inline-size;
  }
  .hero-hub-stats__cell:last-child { border-right: none; }
  .hero-hub-stats__value {
    font-family: var(--font-sans);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.015em;
    font-size: var(--text-h2);
    line-height: 1;
    color: var(--ink);
    margin-bottom: var(--space-2);
    /* Jamais de coupure au milieu d'un mot (« Bordeau x » à 390, audit v5) : c'est la
       taille fluide ci-dessous qui fait tenir la valeur dans sa cellule. */
    overflow-wrap: normal;
  }
  /* Taille fluide bornée par des tokens existants, sur TOUTES les cellules (h2 de repli
     sans cqi, puis h3 → h2 selon la largeur de la cellule ; h3 → h1 pour la cellule de
     tête). 0 nouvelle variable. */
  .hero-hub-stats__cell--lead .hero-hub-stats__value { font-size: var(--text-h2); }
  @supports (font-size: 1cqi) {
    .hero-hub-stats__value { font-size: clamp(var(--text-h3), 22cqi, var(--text-h2)); }
    .hero-hub-stats__cell--lead .hero-hub-stats__value { font-size: clamp(var(--text-h3), 22cqi, var(--text-h1)); }
  }
  .hero-hub-stats__cell--accent .hero-hub-stats__value { color: var(--accent-text); }
  .hero-hub-stats__label {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .hero-hub-stats__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero-hub-stats__cell:nth-child(2n) { border-right: none; }
  }

  /* ── hero-hub-stats · fonds optionnels (defaut clair inchange) ────────── */
  .hero-hub-stats[data-bg='paper-2'] { background: var(--paper-2); }
  .hero-hub-stats[data-bg='paper-3'] { background: var(--paper-3); }
  .hero-hub-stats[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .hero-hub-stats[data-bg='ink'] .hero-hub-stats__h1 { color: var(--paper); }
  .hero-hub-stats[data-bg='ink'] .hero-hub-stats__value { color: var(--paper); }
  .hero-hub-stats[data-bg='ink'] .hero-hub-stats__cell--accent .hero-hub-stats__value { color: var(--accent-text); }

  /* ── hero-pillar-hub (copie byte-identique depuis HeroPillarHub.astro) ─── */
  .hero-pillar-hub {
    min-height: 100vh;
    min-height: calc(var(--viewport-h) - var(--hero-chrome-above));
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    padding-top: calc(var(--header-height) + var(--space-6));
    padding-bottom: var(--space-6);
    padding-left: var(--space-6);
    padding-right: var(--space-6);
  }
  :global(.hero-pillar-hub__meta) { display: inline-flex; gap: var(--space-2); margin-bottom: var(--space-5); }
  :global(.hero-pillar-hub__num) { display: block; margin-bottom: var(--space-5); }
  .hero-pillar-hub__h1 {
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    line-height: 0.88;
    letter-spacing: -0.035em;
    text-wrap: balance;
    font-weight: var(--fw-regular);
    color: var(--ink);
    margin: 0;
  }
  .hero-pillar-hub__lede {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: 1.3;
    margin-top: var(--space-6);
    max-width: 980px;
    color: var(--muted);
    text-wrap: balance;
  }
  .hero-pillar-hub__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-top: var(--space-9);
    border-top: 1px solid var(--hairline-strong);
    border-bottom: 1px solid var(--hairline);
  }
  .hero-pillar-hub__stats :global(.key-metric) {
    min-height: 100%;
    padding: var(--space-7) var(--space-5);
    border-right: 1px solid var(--hairline);
  }
  .hero-pillar-hub__stats :global(.key-metric:last-child) { border-right: none; }
  .hero-pillar-hub__stats :global(.key-metric-value) { font-style: normal; }
  @media (max-width: 900px) {
    .hero-pillar-hub__stats { grid-template-columns: repeat(2, 1fr); }
    .hero-pillar-hub__stats :global(.key-metric:nth-child(2n)) { border-right: none; }
  }
  @media (max-width: 640px) {
    .hero-pillar-hub__stats { grid-template-columns: 1fr; }
    .hero-pillar-hub__stats :global(.key-metric) {
      border-right: none;
      border-bottom: 1px solid var(--hairline);
    }
    .hero-pillar-hub__stats :global(.key-metric:last-child) { border-bottom: none; }
  }

  /* ── hero-pillar-hub · fonds optionnels (defaut clair inchange) ───────── */
  .hero-pillar-hub[data-bg='paper-2'] { background: var(--paper-2); }
  .hero-pillar-hub[data-bg='paper-3'] { background: var(--paper-3); }
  .hero-pillar-hub[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .hero-pillar-hub[data-bg='ink'] .hero-pillar-hub__h1 { color: var(--paper); }
  .hero-pillar-hub[data-bg='ink'] :global(.key-metric-value) { color: var(--paper); }
  .hero-pillar-hub[data-bg='ink'] :global(.key-metric-accent .key-metric-value) { color: var(--accent-text); }

  /* ── hero-conversion-funnel ────────────────────────────────────────────
     `.wrap-wide` qualifié par `.hero-conversion-funnel` (collision max-width). */
  .hero-conversion-funnel {
    min-height: 100vh;
    min-height: calc(var(--viewport-h) - var(--hero-chrome-above));
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    padding-top: calc(var(--header-height) + var(--space-6));
    padding-bottom: var(--space-6);
    padding-left: var(--space-6);
    padding-right: var(--space-6);
  }
  .hero-conversion-funnel .wrap-wide { max-width: 1200px; margin-inline: auto; }
  :global(.hero-conversion-funnel__num) { display: block; margin-bottom: 20px; }
  .hero-conversion-funnel__h1 {
