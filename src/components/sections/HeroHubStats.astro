---
// ARCHÉTYPE R5 · « stats-led » — 1 composant paramétrable → 3 type-ids (presets).
// Héros kicker num + h1 monumental + lede + grille de stats en pied.
// hero-hub-stats + hero-pillar-hub : COPIE FIDÈLE du `.hub-masthead` historique
// (src/components/templates/HubTemplate.astro:123-159, template supprimé R0).
// Absorbe (R5a) : hero-conversion-funnel (preset flagship conversion : pills +
// benefits + proof + 2 CTA + stats). Markup + CSS BYTE-IDENTIQUES par variante ;
// seul ajustement = `.wrap-wide` qualifié `.hero-conversion-funnel .wrap-wide`
// (collision max-width, colocalisation). Résultat visuel inchangé.
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';
import Button from '../ui/atoms/Button.astro';
import DropCap from '../editorial/DropCap.astro';
import KeyMetric from '../editorial/KeyMetric.astro';

interface Props {
  data:
    | SectionByType<'hero-hub-stats'>
    | SectionByType<'hero-pillar-hub'>
    | SectionByType<'hero-conversion-funnel'>;
  lang: 'fr' | 'en';
  ledeDropCap?: string;
  /**
   * hero-conversion-funnel : largeur max du conteneur `.wrap-wide`. Optionnel — par
   * défaut le composant conserve sa largeur catalogue (`1200px`, via la règle scopée,
   * inchangée pour la preview). Les templates live peuvent passer la largeur
   * d'origine (ex. `var(--wrap-wide)` = 1560px) pour préserver leur rythme.
   */
  wrapMaxWidth?: string;
  /**
   * hero-conversion-funnel : rendu des stats via l'atome `KeyMetric` (au lieu des
   * `.hero-conversion-funnel__stat` internes). Défaut `false` (rendu catalogue inchangé).
   */
  statsAsKeyMetric?: boolean;
  /**
   * hero-conversion-funnel : ajoute la classe d'animation `reveal` au kicker.
   * Défaut `false` (rendu catalogue inchangé).
   */
  kickerReveal?: boolean;
}
const { data, lang, ledeDropCap, wrapMaxWidth, statsAsKeyMetric = false, kickerReveal = false } = Astro.props;
const isFr = lang === 'fr';
const isPillar = data.type === 'hero-pillar-hub';
const cfWrapStyle = wrapMaxWidth ? `max-width:${wrapMaxWidth}` : undefined;
const cfNumClass = kickerReveal ? 'hero-conversion-funnel__num reveal' : 'hero-conversion-funnel__num';
---
{data.type === 'hero-conversion-funnel' ? (
<section class="hero-conversion-funnel" data-bg={data.background}>
  <div class="wrap-wide" style={cfWrapStyle}>
    <Kicker tone="accent" class={cfNumClass}>§ Flagship {data.funnel_num}</Kicker>
    <h1 class="hero-conversion-funnel__h1 reveal-mask-up" set:html={isFr ? data.h1_fr : data.h1_en} />
    <p class="hero-conversion-funnel__lede reveal" set:html={isFr ? data.lede_fr : data.lede_en} />
    {data.meta_pills && data.meta_pills.length > 0 && (
      <div class="hero-conversion-funnel__meta reveal-stagger" aria-label={isFr ? "Repères de l'offre" : 'Offer markers'}>
        {data.meta_pills.map((pill) => (
          <span>{isFr ? pill.label_fr : pill.label_en}</span>
        ))}
      </div>
    )}
    {data.benefits && data.benefits.length > 0 && (
      <div class="hero-conversion-funnel__benefits reveal">
        <ul>
          {data.benefits.map((b) => (
            <li>{isFr ? b.label_fr : b.label_en}</li>
          ))}
        </ul>
      </div>
    )}
    {data.proof_fr && (
      <p class="hero-conversion-funnel__proof reveal">
        {isFr ? data.proof_fr : (data.proof_en ?? data.proof_fr)}
      </p>
    )}
    <div class="hero-conversion-funnel__cta">
      <Button href={data.cta_primary.href} variant="primary" size="lg" mag={0.18}>
        {isFr ? data.cta_primary.label_fr : data.cta_primary.label_en}
      </Button>
      {data.cta_secondary && (
        <Button href={data.cta_secondary.href} variant="ghost" size="lg">
          {isFr ? data.cta_secondary.label_fr : data.cta_secondary.label_en}
        </Button>
      )}
    </div>
    {data.stats && data.stats.length > 0 && (
      <div class="hero-conversion-funnel__stats reveal-stagger">
        {statsAsKeyMetric
          ? data.stats.map((s, idx) => (
              <KeyMetric
                value={s.value}
                label={isFr ? s.label_fr : s.label_en}
                size={idx === 0 ? 'lg' : 'md'}
                variant={idx === 0 ? 'accent' : 'default'}
              />
            ))
          : data.stats.map((s, idx) => (
              <div class:list={['hero-conversion-funnel__stat', idx === 0 && 'hero-conversion-funnel__stat--lead']}>
                <div class="hero-conversion-funnel__stat-value">{s.value}</div>
                <div class="hero-conversion-funnel__stat-label">{isFr ? s.label_fr : s.label_en}</div>
              </div>
            ))}
      </div>
    )}
  </div>
</section>
) : isPillar ? (
<section class="hero-pillar-hub" data-bg={data.background}>
  <div class="wrap-wide">
    <Kicker class="hero-pillar-hub__meta">{isFr ? data.meta_kicker_fr : data.meta_kicker_en}</Kicker>
    <Kicker tone="accent" class="hero-pillar-hub__num">§ {data.hub_num}</Kicker>
    <h1 class="hero-pillar-hub__h1 reveal-mask-up" set:html={isFr ? data.h1_fr : data.h1_en} />
    <p class="hero-pillar-hub__lede reveal reveal-fade">{isFr ? data.lede_fr : data.lede_en}</p>
    {data.stats && data.stats.length > 0 && (
      <div class="hero-pillar-hub__stats reveal-stagger">
        {data.stats.map((s, index) => (
          <KeyMetric
            value={s.value}
            label={isFr ? s.label_fr : s.label_en}
            size={index === 0 ? 'lg' : 'md'}
            variant={index === 1 ? 'accent' : 'default'}
          />
        ))}
      </div>
    )}
  </div>
</section>
) : (
<section class="hero-hub-stats" data-bg={data.background}>
  <div class="wrap-wide">
    <Kicker class="hero-hub-stats__meta">{isFr ? data.meta_kicker_fr : data.meta_kicker_en}</Kicker>
    <Kicker tone="accent" class="hero-hub-stats__num">§ {data.hub_num}</Kicker>
    <h1 class="hero-hub-stats__h1 reveal-mask-up" set:html={isFr ? data.h1_fr : data.h1_en} />
    <div class="hero-hub-stats__lede reveal">
      {ledeDropCap
        ? <p><DropCap variant="mono">{ledeDropCap}</DropCap><Fragment set:html={isFr ? data.lede_fr : data.lede_en}/></p>
        : <p set:html={isFr ? data.lede_fr : data.lede_en} />
      }
    </div>
    {data.stats && data.stats.length > 0 && (
      <div class="hero-hub-stats__grid reveal-stagger">
        {data.stats.map((s, idx) => (
          <div class:list={['hero-hub-stats__cell', idx === 0 && 'hero-hub-stats__cell--lead', s.emphasis && 'hero-hub-stats__cell--accent']}>
            <div class="hero-hub-stats__value">{s.value}</div>
            <div class="hero-hub-stats__label">{isFr ? s.label_fr : s.label_en}</div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
)}

<style>
  /* ── hero-hub-stats ─────────────────────────────────────────────────────── */
  .hero-hub-stats { padding: 140px var(--space-6) 0; }
  .hero-hub-stats .wrap-wide { max-width: 1200px; margin-inline: auto; }
  :global(.hero-hub-stats__meta) { display: inline-flex; gap: var(--space-2); margin-bottom: var(--space-5); }
  :global(.hero-hub-stats__num) { display: block; margin-bottom: var(--space-5); }
  .hero-hub-stats__h1 {
    font-family: var(--font-display);
    font-size: clamp(64px, 13vw, 200px);
    line-height: 0.88;
    letter-spacing: -0.035em;
    text-wrap: balance;
    font-weight: var(--fw-regular);
    margin: 0;
  }
  .hero-hub-stats__h1 :global(i) { font-family: var(--font-display); font-weight: var(--fw-regular); font-style: italic; color: var(--accent); }
  .hero-hub-stats__lede {
    font-family: var(--font-sans);
    font-size: clamp(20px, 2.4vw, 30px);
    line-height: 1.3;
    margin-top: var(--space-6);
    max-width: 980px;
    color: var(--muted);
    text-wrap: balance;
  }
  .hero-hub-stats__lede p { margin: 0; }

  .hero-hub-stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-top: 70px;
    border-top: 1px solid var(--hairline-strong);
    border-bottom: 1px solid var(--hairline);
  }
  .hero-hub-stats__cell {
    min-height: 100%;
    padding: clamp(24px, 3vw, 36px) clamp(14px, 2vw, 22px);
    border-right: 1px solid var(--hairline);
  }
  .hero-hub-stats__cell:last-child { border-right: none; }
  .hero-hub-stats__value {
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1;
    color: var(--ink);
    margin-bottom: var(--space-2);
  }
  .hero-hub-stats__cell--lead .hero-hub-stats__value { font-size: clamp(40px, 4.5vw, 60px); }
  .hero-hub-stats__cell--accent .hero-hub-stats__value { color: var(--accent); }
  .hero-hub-stats__label {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .hero-hub-stats__grid { grid-template-columns: repeat(2, 1fr); }
    .hero-hub-stats__cell:nth-child(2n) { border-right: none; }
  }

  /* ── hero-hub-stats · fonds optionnels (defaut clair inchange) ────────── */
  .hero-hub-stats[data-bg='paper-2'] { background: var(--paper-2); }
  .hero-hub-stats[data-bg='paper-3'] { background: var(--paper-3); }
  .hero-hub-stats[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .hero-hub-stats[data-bg='ink'] .hero-hub-stats__h1 { color: var(--paper); }
  .hero-hub-stats[data-bg='ink'] .hero-hub-stats__value { color: var(--paper); }
  .hero-hub-stats[data-bg='ink'] .hero-hub-stats__cell--accent .hero-hub-stats__value { color: var(--accent); }

  /* ── hero-pillar-hub (copie byte-identique depuis HeroPillarHub.astro) ─── */
  .hero-pillar-hub { padding: calc(var(--header-height) + 24px) var(--space-6) 0; }
  :global(.hero-pillar-hub__meta) { display: inline-flex; gap: var(--space-2); margin-bottom: var(--space-5); }
  :global(.hero-pillar-hub__num) { display: block; margin-bottom: var(--space-5); }
  .hero-pillar-hub__h1 {
    font-family: var(--font-display);
    font-size: clamp(64px, 13vw, 200px);
    line-height: 0.88;
    letter-spacing: -0.035em;
    text-wrap: balance;
    font-weight: var(--fw-regular);
    color: var(--ink);
    margin: 0;
  }
  .hero-pillar-hub__h1 :global(i) { font-family: var(--font-display); font-weight: var(--fw-regular); font-style: italic; color: var(--accent); }
  .hero-pillar-hub__lede {
    font-family: var(--font-sans);
    font-size: clamp(20px, 2.4vw, 30px);
    line-height: 1.3;
    margin-top: var(--space-6);
    max-width: 980px;
    color: var(--muted);
    text-wrap: balance;
  }
  .hero-pillar-hub__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-top: 70px;
    border-top: 1px solid var(--hairline-strong);
    border-bottom: 1px solid var(--hairline);
  }
  .hero-pillar-hub__stats :global(.key-metric) {
    min-height: 100%;
    padding: clamp(24px, 3vw, 36px) clamp(14px, 2vw, 22px);
    border-right: 1px solid var(--hairline);
  }
  .hero-pillar-hub__stats :global(.key-metric:last-child) { border-right: none; }
  .hero-pillar-hub__stats :global(.key-metric-value) { font-style: normal; }
  @media (max-width: 900px) {
    .hero-pillar-hub { padding-top: calc(var(--header-height) + 8px); }
    .hero-pillar-hub__stats { grid-template-columns: repeat(2, 1fr); }
    .hero-pillar-hub__stats :global(.key-metric:nth-child(2n)) { border-right: none; }
  }
  @media (max-width: 640px) {
    .hero-pillar-hub__stats { grid-template-columns: 1fr; }
    .hero-pillar-hub__stats :global(.key-metric) {
      border-right: none;
      border-bottom: 1px solid var(--hairline);
    }
    .hero-pillar-hub__stats :global(.key-metric:last-child) { border-bottom: none; }
  }

  /* ── hero-pillar-hub · fonds optionnels (defaut clair inchange) ───────── */
  .hero-pillar-hub[data-bg='paper-2'] { background: var(--paper-2); }
  .hero-pillar-hub[data-bg='paper-3'] { background: var(--paper-3); }
  .hero-pillar-hub[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .hero-pillar-hub[data-bg='ink'] .hero-pillar-hub__h1 { color: var(--paper); }
  .hero-pillar-hub[data-bg='ink'] :global(.key-metric-value) { color: var(--paper); }
  .hero-pillar-hub[data-bg='ink'] :global(.key-metric-accent .key-metric-value) { color: var(--accent); }

  /* ── hero-conversion-funnel ────────────────────────────────────────────
     `.wrap-wide` qualifié par `.hero-conversion-funnel` (collision max-width). */
  .hero-conversion-funnel { padding: 140px var(--space-6) clamp(60px, 8vw, 100px); }
  .hero-conversion-funnel .wrap-wide { max-width: 1200px; margin-inline: auto; }
  :global(.hero-conversion-funnel__num) { display: block; margin-bottom: 20px; }
  .hero-conversion-funnel__h1 {
    font-family: var(--font-display);
    font-size: clamp(64px, 12vw, 200px);
    line-height: 0.88;
    letter-spacing: 0;
    text-wrap: balance;
    font-weight: var(--fw-regular);
    margin: 0 0 var(--space-6);
  }
  .hero-conversion-funnel__h1 :global(i) { font-family: var(--font-display); font-weight: var(--fw-regular); font-style: italic; color: var(--accent); }
  .hero-conversion-funnel__lede {
    font-family: var(--font-sans);
    font-size: clamp(20px, 2.4vw, 30px);
    line-height: 1.3;
    margin: 0 0 36px;
    max-width: 980px;
    color: var(--muted);
    text-wrap: balance;
  }
  .hero-conversion-funnel__meta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin: 0 0 var(--space-6);
  }
  .hero-conversion-funnel__meta span {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-pill);
    padding: 7px 11px;
    background: color-mix(in srgb, var(--paper) 86%, transparent);
  }
  .hero-conversion-funnel__cta { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-bottom: 60px; }
  .hero-conversion-funnel__benefits {
    max-width: 920px;
    margin: 0 0 var(--space-5);
  }
  .hero-conversion-funnel__benefits ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px clamp(18px, 3vw, 34px);
  }
  .hero-conversion-funnel__benefits li {
    position: relative;
    padding-left: 18px;
    font-family: var(--font-display);
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.42;
    color: var(--ink);
  }
  .hero-conversion-funnel__benefits li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 7px;
    height: 7px;
    border-top: 1px solid var(--ink-2);
    border-right: 1px solid var(--ink-2);
    transform: rotate(45deg);
  }
  .hero-conversion-funnel__proof {
    margin: 0 0 28px;
    max-width: 760px;
    padding-top: var(--space-4);
    border-top: 1px solid var(--hairline);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: var(--leading-body);
  }
  .hero-conversion-funnel__stats {
    margin-top: 60px;
    display: grid;
    grid-template-columns: 1.25fr repeat(3, 1fr);
    gap: clamp(20px, 4vw, 56px);
    border-top: 1px solid var(--hairline);
    padding-top: 28px;
  }
  .hero-conversion-funnel__stat-value {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1;
    color: var(--ink);
    margin-bottom: var(--space-2);
  }
  .hero-conversion-funnel__stat--lead .hero-conversion-funnel__stat-value { color: var(--accent); font-size: clamp(48px, 6vw, 80px); }
  .hero-conversion-funnel__stat-label {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 768px) {
    .hero-conversion-funnel__stats { grid-template-columns: 1fr 1fr; }
    .hero-conversion-funnel__benefits ul { grid-template-columns: 1fr; }
  }

  /* ── hero-conversion-funnel · fonds optionnels (defaut clair inchange) ── */
  .hero-conversion-funnel[data-bg='paper-2'] { background: var(--paper-2); }
  .hero-conversion-funnel[data-bg='paper-3'] { background: var(--paper-3); }
  .hero-conversion-funnel[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
    --ink-2: rgba(var(--paper-rgb), 0.78);
  }
  .hero-conversion-funnel[data-bg='ink'] .hero-conversion-funnel__h1 { color: var(--paper); }
  .hero-conversion-funnel[data-bg='ink'] .hero-conversion-funnel__benefits li { color: rgba(var(--paper-rgb), 0.86); }
  .hero-conversion-funnel[data-bg='ink'] .hero-conversion-funnel__meta span {
    background: rgba(var(--paper-rgb), 0.06);
    border-color: rgba(var(--paper-rgb), 0.28);
  }
  .hero-conversion-funnel[data-bg='ink'] .hero-conversion-funnel__stat-value { color: var(--paper); }
  .hero-conversion-funnel[data-bg='ink'] .hero-conversion-funnel__stat--lead .hero-conversion-funnel__stat-value { color: var(--accent); }
</style>
