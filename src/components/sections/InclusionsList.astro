---
// Section W6 · inclusions-list
// Liste inline séparée par point médian. Sources : `off-inclusions`, `.ws-inclusions`.
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'inclusions-list'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const items = isFr ? data.items_fr : data.items_en;
---

<section class="inclusions-list" data-bg={data.background}>
  <div class="wrap-wide">
    {((isFr ? data.kicker_fr : data.kicker_en) || (isFr ? data.title_fr : data.title_en)) && (
      <header class="inclusions-list__hd">
        {(isFr ? data.kicker_fr : data.kicker_en) && (
          <Kicker as="span" tone="accent" class="inclusions-list__kicker">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
        )}
        {(isFr ? data.title_fr : data.title_en) && (
          <h2 class="inclusions-list__title" set:html={isFr ? data.title_fr : data.title_en} />
        )}
      </header>
    )}

    <ul class="inclusions-list__items">
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .inclusions-list {
    padding: var(--inclusions-list-pad, var(--section-loose) var(--space-6));
    border-block: 1px solid var(--hairline);
  }
  .inclusions-list__hd {
    margin-bottom: clamp(var(--space-7), 4vw, var(--space-10));
  }
  /* Kicker canonisé (R4) · typo portée par l'atome Kicker, ici layout seul */
  :global(.inclusions-list__kicker) {
    display: block;
    margin-bottom: var(--space-4);
  }
  .inclusions-list__title {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-display);
    font-weight: var(--fw-medium);
    color: var(--ink);
    text-wrap: balance;
    margin: 0;
  }
  .inclusions-list__title :global(i) {
    font-style: italic;
    color: var(--accent-text);
  }
  .inclusions-list__items {
    list-style: none;
    padding: clamp(var(--space-5), 2.5vw, var(--space-7)) 0 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    align-items: center;
    border-top: 1px solid var(--hairline);
  }
  .inclusions-list__items li {
    font-family: var(--font-sans);
    font-size: clamp(var(--text-small), 1.4vw, var(--text-body));
    line-height: var(--leading-body);
    color: var(--ink);
  }
  .inclusions-list__items li + li::before {
    content: '·';
    color: var(--accent-text);
    margin: 0 var(--space-2);
    font-family: var(--font-mono);
  }

  /* ── Alternance des fonds R4 · defaut paper = rendu inchange ── */
  .inclusions-list[data-bg='paper-2'] { background: var(--paper-2); }
  .inclusions-list[data-bg='paper-3'] { background: var(--paper-3); }

  /* ── Idiome dark (ink) — fond sombre soigne, contraste AA ── */
  .inclusions-list[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .inclusions-list[data-bg='ink'] :is(h2, li, span) { color: var(--paper); }
  .inclusions-list[data-bg='ink'] .inclusions-list__items { border-top-color: var(--hairline); }
  .inclusions-list[data-bg='ink'] .inclusions-list__items li { color: var(--paper); }
  .inclusions-list[data-bg='ink'] .inclusions-list__items li + li::before { color: var(--accent-text); }
</style>
