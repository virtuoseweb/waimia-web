---
// Section catalogue · problems-grid
// COPIE FIDÈLE du `.tnl-problems / .tnl-cards / .tnl-card` de `site-web-ia-landing.astro:80+`
// h2 sous-titre + grille auto-fit de 3 cards (num + kicker + h3 + body).
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'problems-grid'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---
<section class="problems-grid wrap-wide reveal-blur-clip">
  <h2 class="problems-grid__h2 reveal" set:html={isFr ? data.h2_fr : data.h2_en} />
  <div class="problems-grid__cards">
    {data.problems.map((p, i) => (
      <div class="problems-grid__card">
        <div class="problems-grid__num">{p.num ?? String(i + 1).padStart(2, '0')}</div>
        <Kicker tone="accent" letterSpacing=".08em" class="problems-grid__kicker">{isFr ? p.kicker_fr : p.kicker_en}</Kicker>
        <h3 set:html={isFr ? p.title_fr : p.title_en} />
        <p>{isFr ? p.body_fr : p.body_en}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .wrap-wide { max-width: 1200px; margin-inline: auto; padding-inline: clamp(20px, 5vw, 80px); }
  .problems-grid { padding-block: var(--section-loose); border-top: 1px solid rgba(var(--ink-rgb), .07); }
  .problems-grid__h2 {
    font-family: var(--font-serif, 'Instrument Serif', Georgia, serif);
    font-size: clamp(24px, 3vw, 40px);
    letter-spacing: -.01em;
    margin-bottom: clamp(32px, 4vw, 56px);
    color: var(--ink);
  }
  .problems-grid__cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1px;
    background: rgba(var(--ink-rgb), .08);
    border: 1px solid rgba(var(--ink-rgb), .08);
    border-radius: var(--radius-xs);
    overflow: hidden;
  }
  .problems-grid__card {
    background: var(--paper);
    padding: clamp(24px, 3vw, 40px);
  }
  .problems-grid__num {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: var(--text-eyebrow);
    color: var(--muted);
    letter-spacing: .08em;
    margin-bottom: var(--space-2);
  }
  /* Kicker canonisé (R4) · typo portée par l'atome (fusion tracking .06em -> .08em, variante documentée) */
  :global(.problems-grid__kicker) {
    margin-bottom: var(--space-3);
  }
  .problems-grid__card h3 {
    font-family: var(--font-serif, 'Instrument Serif', Georgia, serif);
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.25;
    margin-bottom: var(--space-4);
    color: var(--ink);
  }
  .problems-grid__card p {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    line-height: var(--leading-prose);
    color: var(--muted);
  }
</style>
