---
// Section W6 · branded-callout
// Callout de marque fond paper-2 : kicker §, h2 display italic, corps + CTA. Source : `meth-os` (methode.astro).
import type { SectionByType } from '@waimia/ds-kernel';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'branded-callout'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---

<section class="branded-callout" data-bg={data.background} data-variant={data.variant} aria-labelledby="branded-callout-h2">
  <div class="wrap-wide">
    <div class="branded-callout__box reveal">
      <Kicker as="p" tone="accent" class="branded-callout__kicker">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      <h2
        id="branded-callout-h2"
        class="branded-callout__h2"
        set:html={isFr ? data.h2_fr : data.h2_en}
      />
      {data.bodyHtml ? (
        <p class="branded-callout__body1" set:html={isFr ? data.body1_fr : data.body1_en} />
      ) : (
        <p class="branded-callout__body1">{isFr ? data.body1_fr : data.body1_en}</p>
      )}
      {(data.body2_fr || data.body2_en) && (
        data.bodyHtml ? (
          <p class="branded-callout__body2" set:html={isFr ? data.body2_fr : data.body2_en} />
        ) : (
          <p class="branded-callout__body2">{isFr ? data.body2_fr : data.body2_en}</p>
        )
      )}
      {data.cta && (
        <a href={data.cta.href} class={`btn btn--${data.cta.variant ?? 'primary'} branded-callout__cta`}>
          {isFr ? data.cta.label_fr : data.cta.label_en}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .branded-callout {
    padding: var(--section-base) 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .branded-callout__box {
    background: var(--paper-2);
    border: 1px solid var(--hairline);
    padding: var(--space-9);
    max-width: 800px;
  }
  /* Kicker canonisé (R4) · typo portée par l'atome Kicker, ici layout seul */
  :global(.branded-callout__kicker) {
    margin: 0 0 var(--space-4);
  }
  .branded-callout__h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    line-height: 1.12;
    letter-spacing: -0.022em;
    font-weight: var(--fw-medium);
    color: var(--ink);
    margin: 0 0 var(--space-5);
    text-wrap: balance;
  }
  .branded-callout__h2 :global(i) {
    font-style: italic;
    color: var(--accent-text);
  }
  .branded-callout__body1 {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--muted);
    margin: 0 0 var(--space-3);
    max-width: 640px;
  }
  .branded-callout__body2 {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--muted);
    margin: 0;
    max-width: 640px;
  }
  .branded-callout__cta {
    margin-top: var(--space-5);
    display: inline-flex;
  }

  /* ── Alternance des fonds R4 · defaut (sans data-bg) = rendu clair inchange ── */
  .branded-callout[data-bg='paper-2'] { background: var(--paper-2); }
  .branded-callout[data-bg='paper-3'] { background: var(--paper-3); }
  .branded-callout[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  /* Panneau interne : surface sombre surelevee (pas le paper-2 clair) + bord plus net. */
  .branded-callout[data-bg='ink'] .branded-callout__box {
    background: rgba(var(--paper-rgb), 0.04);
    border-color: rgba(var(--paper-rgb), 0.14);
  }
  .branded-callout[data-bg='ink'] .branded-callout__h2 { color: var(--paper); }
  .branded-callout[data-bg='ink'] .branded-callout__h2 :global(i) { font-family: var(--font-display); font-weight: var(--fw-regular); color: var(--accent-text); }
  .branded-callout[data-bg='ink'] :is(.branded-callout__body1, .branded-callout__body2) { color: rgba(var(--paper-rgb), 0.7); }

  /* ── Variante `rail` (opt-in, data-variant) : filet accent a gauche + retrait editorial 64px
     (var(--space-6) + gut). Scope strict [data-variant='rail'] : 0 impact sur les instances
     existantes (sans variant). ── */
  .branded-callout[data-variant='rail'] .branded-callout__box {
    border-left: 3px solid var(--accent);
    margin-inline-start: var(--space-6);
  }
  /* Mobile : le retrait éditorial s'ajoutait au gutter et décentrait l'encadré (48 px à
     gauche, 16 px à droite à 390 px), pour une colonne de texte de 216 px. On supprime le
     retrait : l'encadré reprend le gutter des deux côtés, comme la variante par défaut, et le
     filet accent reste le marqueur de la variante. */
  @media (max-width: 640px) {
    .branded-callout[data-variant='rail'] .branded-callout__box { margin-inline-start: 0; }
  }
  /* Liens internes dans le corps (rendu bodyHtml uniquement) : accent + soulignement.
     Les instances sans bodyHtml n'ont aucun <a> dans le corps -> 0 impact. */
  .branded-callout__body1 :global(a),
  .branded-callout__body2 :global(a) {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
