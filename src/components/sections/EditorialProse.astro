---
// Section W6 · editorial-prose
// Wrapper tokenisé d'une colonne de prose éditoriale lisible. Le contenu vient d'un
// <slot/> (corps MDX `<Content />`) : 0 champ texte → la prose vit dans le MDX, pas
// dupliquée dans le frontmatter (préserve la parité GEO/AIO). Fond alterné via l'idiome
// data-bg partagé (modèle BentoGrid). Typographie reprise du DS (mêmes tokens que
// l'ancien .sector-body de SecteurHubTemplate → parité de rendu).
import type { SectionByType } from '@waimia/ds-kernel';

interface Props {
  data: SectionByType<'editorial-prose'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const width = data.maxWidth ?? 'prose';
const figures = data.figures ?? [];
const html = lang === 'en' ? data.html_en : data.html_fr;
---
<section class="editorial-prose sec-prose-band" data-bg={data.background} data-width={width}>
  <div class="editorial-prose__col">
    {figures.map((fig, i) => (
      <figure class="editorial-prose__figure" data-side={fig.side ?? (i % 2 === 0 ? 'right' : 'left')}>
        <img
          src={fig.src}
          alt={lang === 'en' ? fig.alt_en : fig.alt_fr}
          width="520"
          height="520"
          loading="lazy"
          decoding="async"
        />
      </figure>
    ))}
    {html ? <Fragment set:html={html} /> : <slot />}
  </div>
</section>

<style> .editorial-prose__col {
    max-width: var(--wrap-prose);
    margin: 0 auto;
    counter-reset: prose-section;
  }
  /* Clearfix : la colonne englobe ses figures flottantes (pas de debordement bas). */
  .editorial-prose__col::after {
    content: '';
    display: block;
    clear: both;
  }
  .editorial-prose[data-width='wide'] .editorial-prose__col {
    max-width: var(--wrap-wide);
  }

  /* ── Figures duotone flottantes · desktop = float (le texte coule autour),
        mobile = pleine largeur dans le flux. Rythme editorial de marque. ── */
  .editorial-prose__figure {
    margin: 0 0 var(--space-5);
    width: 100%;
  }
  .editorial-prose__figure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }
  @media (min-width: 700px) {
    .editorial-prose__figure {
      width: clamp(220px, 32%, 300px);
      margin-top: var(--space-2);
      margin-bottom: var(--space-4);
    }
    .editorial-prose__figure[data-side='right'] {
      float: right;
      margin-left: var(--space-7);
    }
    .editorial-prose__figure[data-side='left'] {
      float: left;
      margin-right: var(--space-7);
    }
  }

  /* Typographie de prose · tokens DS uniquement (parité avec l'ancien .sector-body) */
  .editorial-prose__col :global(h2) {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    line-height: var(--leading-h2);
    letter-spacing: -0.018em;
    font-weight: var(--fw-medium);
    counter-increment: prose-section;
    margin: var(--space-9) 0 var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--hairline);
  }
  /* Compteur editorial « § 01 · § 02 » (signature mono de marque, atome Kicker). */
  .editorial-prose__col :global(h2)::before {
    content: '§ ' counter(prose-section, decimal-leading-zero);
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-kicker);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: var(--space-3);
  }
  /* Un seul h2 dans le bloc : rien a compter, pas de « § 01 » (le compteur est
     remis a zero par section ; un numero sans suite serait une sequence inventee).
     Les blocs a plusieurs h2 gardent § 01, § 02… */
  .editorial-prose__col :global(h2:only-of-type)::before {
    content: none;
  }
  /* Premier h2 : ouverture franche, pas de filet detache du haut de section. */
  .editorial-prose__col :global(h2:first-of-type) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  /* Paragraphe de tete (juste apres un h2) : leger accent de lecture (lede). */
  .editorial-prose__col :global(h2 + p) {
    font-size: calc(var(--text-body) + 2px);
    line-height: 1.55;
    color: var(--ink);
  }
  .editorial-prose__col :global(h3) {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: 1.25;
    font-weight: var(--fw-medium);
    margin: var(--space-6) 0 var(--space-3);
  }
  .editorial-prose__col :global(p) {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--ink);
    margin: 0 0 var(--space-4);
  }
  .editorial-prose__col :global(a) {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .editorial-prose__col :global(ul),
  .editorial-prose__col :global(ol) {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
    color: var(--ink);
  }
  .editorial-prose__col :global(li) {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    margin-bottom: var(--space-2);
  }
  .editorial-prose__col :global(li)::marker {
    color: var(--accent-text);
  }
  .editorial-prose__col :global(blockquote) {
    margin: var(--space-6) 0;
    padding-left: var(--space-5);
    border-left: 1px solid var(--hairline-strong);
    color: var(--muted);
  }

  /* ── Alternance des fonds · defaut (sans data-bg) = rendu clair inchange ── */
  .editorial-prose[data-bg='paper-2'] { background: var(--paper-2); }
  .editorial-prose[data-bg='paper-3'] { background: var(--paper-3); }
  .editorial-prose[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .editorial-prose[data-bg='ink'] .editorial-prose__col :global(:is(h2, h3, p, li)) {
    color: var(--paper);
  }
</style>
