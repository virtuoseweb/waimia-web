---
// Section W6 · comparison-duo
// Deux cartes cote a cote : gauche "Sans" (etat negatif, ton muted),
// droite "Avec" (etat positif, accent). Avant/apres, nous-vs-eux.
// Responsive : stack 1 colonne sous 768px.
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'comparison-duo'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';

// ── Vague C · Scale (Batch 4) ──
// layout : 'inline' (côte à côte, défaut/actuel) · 'stacked' (cartes empilées).
const cdLayout = data.layout ?? 'inline';
// Couche atomique : placement.header.align surcharge contentAlign (UN data-attr / région).
const pl = data.placement;
const headerAlign = pl?.header?.align ?? data.contentAlign;
const headerHide = pl?.header?.hideOn;
const bodyHide = pl?.body?.hideOn;
---

<section
  class="comparison-duo sec-base"
  data-bg={data.background}
  data-layout={cdLayout}
  data-proportion={data.proportion}
  data-density={data.density}
  aria-labelledby="comparison-duo-h2"
>
  <div class="wrap-wide">
    <div class="comparison-duo__header reveal" data-header-align={headerAlign} data-header-hide={headerHide}>
      {(isFr ? data.kicker_fr : data.kicker_en) && (
        <Kicker tone="muted">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      )}
      <h2 id="comparison-duo-h2" class="sec-base-h2" set:html={isFr ? data.h2_fr : data.h2_en} />
    </div>

    <div class="comparison-duo__grid reveal-stagger" data-body-hide={bodyHide}>
      {/* Carte gauche : sans (etat negatif) */}
      <div class="comparison-duo__card comparison-duo__card--without">
        <div class="comparison-duo__card-header">
          <span class="comparison-duo__badge comparison-duo__badge--without">
            {isFr ? data.without_label_fr : data.without_label_en}
          </span>
          <p class="comparison-duo__card-title">{isFr ? data.without_title_fr : data.without_title_en}</p>
        </div>
        <ul class="comparison-duo__list">
          {data.without_items.map((item: (typeof data.without_items)[number]) => (
            <li class="comparison-duo__item comparison-duo__item--without">
              <span class="comparison-duo__glyph" aria-hidden="true">◦</span>
              <span>{isFr ? item.text_fr : item.text_en}</span>
            </li>
          ))}
        </ul>
      </div>

      {/* Carte droite : avec (etat positif) */}
      <div class="comparison-duo__card comparison-duo__card--with">
        <div class="comparison-duo__card-header">
          <span class="comparison-duo__badge comparison-duo__badge--with">
            {isFr ? data.with_label_fr : data.with_label_en}
          </span>
          <p class="comparison-duo__card-title comparison-duo__card-title--with">{isFr ? data.with_title_fr : data.with_title_en}</p>
        </div>
        <ul class="comparison-duo__list">
          {data.with_items.map((item: (typeof data.with_items)[number]) => (
            <li class="comparison-duo__item comparison-duo__item--with">
              <span class="comparison-duo__glyph" aria-hidden="true">◉</span>
              <span>{isFr ? item.text_fr : item.text_en}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>

  .comparison-duo__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--spacing-block);
  }

  .comparison-duo__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .comparison-duo__card {
    border: 1px solid var(--hairline);
    padding: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .comparison-duo__card--with {
    border-color: rgba(var(--accent-rgb), 0.3);
    box-shadow: var(--shadow-paper-lift);
  }

  .comparison-duo__card-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .comparison-duo__badge {
    display: inline-flex;
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: var(--space-1) 10px;
    border-radius: var(--radius-sm);
  }

  .comparison-duo__badge--without {
    background: var(--paper-3);
    color: var(--muted);
  }

  .comparison-duo__badge--with {
    background: rgba(var(--accent-rgb), 0.1);
    color: var(--accent-text);
  }

  .comparison-duo__card-title {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    font-weight: var(--fw-medium);
    color: var(--muted);
    margin: 0;
  }

  .comparison-duo__card-title--with {
    color: var(--ink);
  }

  .comparison-duo__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .comparison-duo__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-relaxed);
  }

  .comparison-duo__item--without {
    color: var(--muted);
  }

  .comparison-duo__item--with {
    color: var(--ink);
  }

  .comparison-duo__glyph {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .comparison-duo__item--without .comparison-duo__glyph {
    color: var(--muted);
  }

  .comparison-duo__item--with .comparison-duo__glyph {
    color: var(--accent-text);
  }

  /* ── Vague C · Scale (Batch 4) ── */
  /* Axe PROPORTION (data-proportion) · ratio sans|avec. minmax(0,..) → 0 débordement.
     Défaut absent = 1fr 1fr (rendu actuel). Ignoré par stacked (1 colonne). */
  .comparison-duo[data-proportion='1-2'] .comparison-duo__grid { grid-template-columns: minmax(0,1fr) minmax(0,2fr); }
  .comparison-duo[data-proportion='2-1'] .comparison-duo__grid { grid-template-columns: minmax(0,2fr) minmax(0,1fr); }
  .comparison-duo[data-proportion='1-1'] .comparison-duo__grid { grid-template-columns: minmax(0,1fr) minmax(0,1fr); }

  /* Layout STACKED · cartes empilées (sans au-dessus, avec en dessous), 1 colonne. */
  .comparison-duo[data-layout='stacked'] .comparison-duo__grid { grid-template-columns: 1fr; }

  /* Axe DENSITY (data-density) · gap entre cartes + padding interne. Tokens DS. */
  .comparison-duo[data-density='compact'] .comparison-duo__grid { gap: var(--space-4); }
  .comparison-duo[data-density='compact'] .comparison-duo__card { padding: var(--space-5); }
  .comparison-duo[data-density='ample']   .comparison-duo__grid { gap: var(--space-9); }
  .comparison-duo[data-density='ample']   .comparison-duo__card { padding: var(--space-9); }

  /* Axe CONTENT-ALIGN (data-header-align) · alignement du bloc header. Défaut start = actuel. */
  .comparison-duo__header[data-header-align='center'] { align-items: center; text-align: center; margin-inline: auto; }
  .comparison-duo__header[data-header-align='end']    { align-items: flex-end; text-align: end; margin-inline-start: auto; }

  /* COUCHE ATOMIQUE · hideOn (visibilité responsive). 768px = breakpoint structurel. */
  .comparison-duo__header[data-header-hide='desktop'],
  .comparison-duo__grid[data-body-hide='desktop'] { display: none; }

  @media (max-width: 768px) {
    /* Empilé : 1 colonne quel que soit l'axe (proportion a une spécificité supérieure
       → on neutralise explicitement chaque ratio). Ordre de lecture sans→avec préservé. */
    .comparison-duo__grid,
    .comparison-duo[data-proportion='1-1'] .comparison-duo__grid,
    .comparison-duo[data-proportion='1-2'] .comparison-duo__grid,
    .comparison-duo[data-proportion='2-1'] .comparison-duo__grid {
      grid-template-columns: 1fr;
    }
    .comparison-duo__header[data-header-hide='mobile'],
    .comparison-duo__grid[data-body-hide='mobile'] { display: none; }
    .comparison-duo__header[data-header-hide='desktop'] { display: flex; }
    .comparison-duo__grid[data-body-hide='desktop'] { display: grid; }
  }
  /* ── Alternance des fonds R4 (docs/37 §2.6) · defaut paper = rendu inchange ── */
  .comparison-duo[data-bg='paper-2'] { background: var(--paper-2); }
  .comparison-duo[data-bg='paper-3'] { background: var(--paper-3); }
  .comparison-duo[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .comparison-duo[data-bg='ink'] :is(h2, h3, p) { color: var(--paper); }
  /* Conformite declinaison ink : la colonne AVEC est en var(--ink) direct -> remap clair (le AVANT reste muted = volontairement attenue) */
  .comparison-duo[data-bg='ink'] :is(.comparison-duo__card-title--with, .comparison-duo__item--with) { color: var(--paper); }
</style>
