---
// Section catalogue · hero-lead-magnet
// COPIE FIDÈLE du `.lm-hero` de `src/components/templates/LeadMagnetTemplate.astro:115-142`
// 2-col texte/cover : kicker + h1 italic + lede italique + meta + cover img + download card CTA.
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';
import Button from '../ui/atoms/Button.astro';

interface VTProps {
  transitionId?: string;
  cardTransitionId?: string;
  /** Affiche le placeholder SVG quand pas de cover_url (défaut catalogue = true ; template live passe false pour parité legacy). */
  coverFallback?: boolean;
}
interface Props extends VTProps {
  data: SectionByType<'hero-lead-magnet'>;
  lang: 'fr' | 'en';
}
const { data, lang, transitionId, cardTransitionId, coverFallback = true } = Astro.props as Props;
const isFr = lang === 'fr';
---
<section class="hero-lead-magnet" transition:name={cardTransitionId ? `card-${cardTransitionId}` : undefined}>
  <div class="wrap-wide hero-lead-magnet__grid">
    <div class="hero-lead-magnet__text">
      <Kicker tone="accent" class="hero-lead-magnet__kicker">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      <h1 class="hero-lead-magnet__h1 reveal-mask-up" transition:name={transitionId ? `hero-h1-${transitionId}` : undefined} set:html={isFr ? data.h1_fr : data.h1_en} />
      <p class="hero-lead-magnet__lede reveal" set:html={isFr ? data.lede_fr : data.lede_en} />
      <div class="hero-lead-magnet__meta">
        <span>{isFr ? data.format_fr : data.format_en}</span>
        <span aria-hidden="true">·</span>
        <time datetime={data.published_at}>{data.published_at}</time>
        <span aria-hidden="true">·</span>
        <span>{isFr ? 'Gratuit' : 'Free'}</span>
      </div>
    </div>
    <aside class="hero-lead-magnet__panel reveal-stagger" aria-label={isFr ? 'Résumé du livre blanc' : 'Whitepaper summary'} transition:name={transitionId ? `hero-img-${transitionId}` : undefined}>
      {(data.cover_url || coverFallback) && (
        <div class="hero-lead-magnet__cover" aria-hidden="true">
          {data.cover_url ? (
            <img src={data.cover_url} alt="" loading="eager" />
          ) : (
            <svg viewBox="0 0 180 240" aria-hidden="true">
              <rect x="0" y="0" width="180" height="240" fill="var(--paper-2)" />
              <text x="90" y="120" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--muted)" letter-spacing="0.14em">PDF</text>
              <text x="90" y="140" text-anchor="middle" font-family="var(--font-display)" font-size="18" font-style="italic" fill="var(--ink)">Livre blanc</text>
            </svg>
          )}
        </div>
      )}
      <div class="hero-lead-magnet__download">
        <span class="hero-lead-magnet__download-label">{isFr ? data.download_label_fr : (data.download_label_en ?? data.download_label_fr)}</span>
        <Button href={data.cta_href ?? '#'} variant="primary" size="md">
          {isFr ? data.cta_label_fr : data.cta_label_en}
        </Button>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero-lead-magnet { padding: 140px var(--space-6) clamp(40px, 5vw, 72px); border-bottom: 1px solid var(--hairline); }
  .wrap-wide { max-width: 1200px; margin-inline: auto; }
  .hero-lead-magnet__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(280px, 4fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  :global(.hero-lead-magnet__kicker) { display: block; margin-bottom: 20px; }
  .hero-lead-magnet__h1 {
    font-family: var(--font-display);
    font-size: clamp(48px, 8vw, 120px);
    line-height: 0.94;
    letter-spacing: -0.03em;
    text-wrap: balance;
    font-weight: var(--fw-regular);
    margin: 0 0 var(--space-5);
  }
  .hero-lead-magnet__h1 :global(i) { font-style: italic; color: var(--accent); }
  .hero-lead-magnet__lede {
    font-family: var(--font-sans);
    font-style: italic;
    font-size: clamp(18px, 2vw, 24px);
    color: var(--ink-2);
    margin: 0 0 var(--space-5);
    max-width: 620px;
    line-height: 1.4;
    text-wrap: pretty;
  }
  .hero-lead-magnet__meta {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .hero-lead-magnet__panel {
    display: grid;
    gap: var(--space-4);
    align-self: stretch;
  }
  .hero-lead-magnet__cover {
    aspect-ratio: 3/4;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--paper-2);
  }
  .hero-lead-magnet__cover img,
  .hero-lead-magnet__cover svg { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-lead-magnet__download {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    border-top: 1px solid var(--hairline-strong);
    border-bottom: 1px solid var(--hairline);
    padding: var(--space-4) 0;
  }
  .hero-lead-magnet__download-label {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  @media (max-width: 768px) {
    .hero-lead-magnet__grid { grid-template-columns: 1fr; }
  }
</style>
