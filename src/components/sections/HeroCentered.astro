---
// ARCHÉTYPE R5 · « masthead éditorial » — 1 composant paramétrable → 13 type-ids (presets).
// Héros sans colonne média : kicker/eyebrow + h1 monumental + lede, extras légers
// (specs-bar, metrics-bar, meta auteur, CTA). Branche sur `data.type` ; chaque variante
// conserve markup + CSS BYTE-IDENTIQUES à son composant d'origine (classes distinctes →
// coexistent sans collision). Les seuls ajustements CSS = qualifications de scope
// (`h1`/`p` nus → `.hero-centered …`, `.wrap-wide` → `.hero-X .wrap-wide`) rendues
// nécessaires par la colocalisation — résultat visuel inchangé.
// Absorbe (H4) : hero-hub-masthead, hero-hub-listing, hero-problem-index,
// hero-utility-masthead, hero-academy-hub, hero-course, hero-detail-menu (+ hero-centered, noyau).
// Absorbe (R5a) : hero-essay, hero-case-study, hero-service-detail, hero-service-masthead,
// hero-landing.
import type { SectionByType } from '@waimia/ds-kernel';
import Kicker from '../ui/atoms/Kicker.astro';
import Button from '../ui/atoms/Button.astro';

interface Props {
  data:
    | SectionByType<'hero-centered'>
    | SectionByType<'hero-hub-masthead'>
    | SectionByType<'hero-hub-listing'>
    | SectionByType<'hero-problem-index'>
    | SectionByType<'hero-utility-masthead'>
    | SectionByType<'hero-academy-hub'>
    | SectionByType<'hero-course'>
    | SectionByType<'hero-detail-menu'>
    | SectionByType<'hero-essay'>
    | SectionByType<'hero-case-study'>
    | SectionByType<'hero-service-detail'>
    | SectionByType<'hero-service-masthead'>
    | SectionByType<'hero-landing'>;
  lang: 'fr' | 'en';
  /** hero-academy-hub / hero-course : encapsulation wrapper (défaut true). */
  wrap?: boolean;
  /** hero-academy-hub / hero-course / hero-detail-menu / hero-essay / hero-case-study / hero-service-detail : padding-top custom. */
  topPad?: string;
  /** hero-essay / hero-case-study : VT id du h1 + déco (hero-h1-${id}, hero-img-${id}). */
  transitionId?: string;
  /** hero-essay / hero-case-study : VT id de la carte/section (card-${id}). */
  cardTransitionId?: string;
  /** hero-case-study : override margin-bottom du h1 (espace h1→specs ; parité template live). */
  h1Gap?: string;
  /** hero-utility-masthead / hero-detail-menu / hero-problem-index : largeur max du `.wrap-wide` (défaut = catalogue `1200px`). */
  wrapMaxWidth?: string;
  /** hero-utility-masthead : ajoute la classe d'animation `reveal` (défaut false). */
  reveal?: boolean;
  /** hero-course : CTA primaire désactivé (placeholder). */
  ctaPrimaryDisabled?: boolean;
  /** hero-course : CTA primaire externe (target `_blank`). */
  ctaPrimaryExternal?: boolean;
  /** hero-course : style du lien ghost (`catalog` | `legacy`). */
  ghostStyle?: 'catalog' | 'legacy';
  /** hero-hub-listing : padding-top custom (défaut = catalogue `calc(--header-height + 40px)`). */
  listTopPad?: string;
  /** hero-hub-listing : cap font-size du lede (défaut catalogue `28px`). */
  ledeMaxFont?: string;
  /** hero-hub-listing : ajoute l'animation `reveal reveal-fade` au lede (défaut true = catalogue). */
  ledeReveal?: boolean;
  /** hero-hub-listing : force le rendu du wrapper de filtres (défaut = présence réelle du slot). */
  showFilters?: boolean;
  /** hero-hub-listing : ajoute la hairline border-bottom (défaut false = catalogue). */
  listBorder?: boolean;
}
const {
  data,
  lang,
  wrap = true,
  topPad,
  transitionId,
  cardTransitionId,
  h1Gap,
  wrapMaxWidth,
  reveal = false,
  ctaPrimaryDisabled = false,
  ctaPrimaryExternal = false,
  ghostStyle = 'catalog',
  listTopPad,
  ledeMaxFont,
  ledeReveal = true,
  showFilters,
  listBorder = false,
} = Astro.props;
// hero-hub-listing · overrides data-driven (chemin composable, ex. /blog). La prop
// (chemin template UtilityTemplate) reste prioritaire ; sinon on lit le champ de schéma.
// Défauts = catalogue byte-identique.
const hhlData = data.type === 'hero-hub-listing' ? data : undefined;
const effListTopPad = listTopPad ?? hhlData?.top_pad;
const effLedeReveal = hhlData?.lede_reveal ?? ledeReveal;
const effListBorder = listBorder || (hhlData?.list_border ?? false);
const listStyle = [
  effListTopPad ? `padding-top:${effListTopPad}` : '',
  ledeMaxFont ? `--hhl-lede-max:${ledeMaxFont}` : '',
].filter(Boolean).join(';') || undefined;
const hasFilters = showFilters ?? Astro.slots.has('filters');
const isFr = lang === 'fr';
const rv = reveal ? ' reveal' : '';
const mastScale = data.type === 'hero-hub-masthead' ? (data.scale ?? (data.variant === 'listing' ? 'standard' : 'monumental')) : undefined;
const primaryAttrs = ctaPrimaryExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---
{data.type === 'hero-hub-masthead' ? (
  data.variant === 'listing' ? (
    <section class:list={['hero-hub-listing', mastScale === 'standard' && 'hero-hub-listing--standard']} data-bg={data.background} aria-label="Présentation">
      {data.decoration && (
        <svg class="hero-hub-listing__deco" viewBox="0 0 600 400" aria-hidden="true" focusable="false">
          <circle cx="500" cy="60" r="200" fill="none" stroke="currentColor" stroke-width=".5" opacity=".12" />
          <line x1="0" y1="320" x2="600" y2="220" stroke="var(--accent)" stroke-width=".4" opacity=".18" />
        </svg>
      )}
      <div class="wrap-wide">
        <Kicker class="hero-hub-listing__kicker">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
        <h1 class="hero-hub-listing__h1 reveal-mask-up u-serif-accent" set:html={isFr ? data.h1_fr : data.h1_en} />
        <p class="hero-hub-listing__lede reveal reveal-fade">{isFr ? data.lede_fr : data.lede_en}</p>
      </div>
    </section>
  ) : data.variant === 'detail' ? (
    <section class:list={['hero-utility', `hero-utility--${data.align ?? 'left'}`, mastScale === 'standard' && 'hero-utility--standard']} data-bg={data.background} aria-label="Présentation">
      <div class="wrap-wide" style={wrapMaxWidth ? `max-width:${wrapMaxWidth}` : undefined}>
        {data.kicker_fr && (
          <Kicker class={`hero-utility__kicker${rv}`}>{isFr ? data.kicker_fr : (data.kicker_en ?? data.kicker_fr)}</Kicker>
        )}
        <h1 class={`hero-utility__h1 u-serif-accent${rv}`} set:html={isFr ? data.h1_fr : data.h1_en} />
        {(isFr ? data.role_fr : data.role_en) && <p class={`hero-utility__role${rv}`} set:html={isFr ? data.role_fr : (data.role_en ?? data.role_fr)} />}
        <p class={`hero-utility__lede${rv}`} set:html={isFr ? data.lede_fr : data.lede_en} />
      </div>
    </section>
  ) : (
    <section class:list={['hero-hub-masthead', mastScale === 'standard' && 'hero-hub-masthead--standard']} data-bg={data.background} aria-label="Présentation">
      <div class="wrap-wide">
        <Kicker class="hero-hub-masthead__kicker">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
        <h1 class="hero-hub-masthead__h1 reveal-mask-up u-serif-accent" set:html={isFr ? data.h1_fr : data.h1_en} transition:name={data.transition_id ? `hero-h1-${data.transition_id}` : undefined} />
        <p class="hero-hub-masthead__lede" set:html={isFr ? data.lede_fr : data.lede_en} />
      </div>
    </section>
  )
) : data.type === 'hero-hub-listing' ? (
  <section class:list={['hero-hub-listing', effListBorder && 'hero-hub-listing--bordered']} style={listStyle} data-bg={data.background} aria-label="Présentation">
    {data.decoration && (
      <svg class="hero-hub-listing__deco" viewBox="0 0 600 400" aria-hidden="true" focusable="false">
        <circle cx="500" cy="60" r="200" fill="none" stroke="currentColor" stroke-width=".5" opacity=".12" />
        <line x1="0" y1="320" x2="600" y2="220" stroke="var(--accent)" stroke-width=".4" opacity=".18" />
      </svg>
    )}
    <div class="wrap-wide">
      <Kicker class="hero-hub-listing__kicker">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      <h1 class="hero-hub-listing__h1 reveal-mask-up u-serif-accent" set:html={isFr ? data.h1_fr : data.h1_en} />
      <p class:list={['hero-hub-listing__lede', effLedeReveal && 'reveal reveal-fade']} set:html={isFr ? data.lede_fr : data.lede_en} />
      {hasFilters && (
        <div class="hero-hub-listing__filters">
          <slot name="filters" />
        </div>
      )}
    </div>
  </section>
) : data.type === 'hero-problem-index' ? (
  <section class="hero-problem-index" data-bg={data.background}>
    <svg class="hero-problem-index__geo" viewBox="0 0 1440 560" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <rect x="1060" y="-20" width="360" height="360" fill="none" stroke="currentColor" stroke-width="0.6" transform="rotate(12 1240 160)"/>
      <rect x="1140" y="60" width="220" height="220" fill="none" stroke="currentColor" stroke-width="0.4" transform="rotate(12 1250 170)"/>
      <line x1="0" y1="380" x2="1440" y2="260" stroke="currentColor" stroke-width="0.4"/>
    </svg>
    <div class="wrap-wide" style={wrapMaxWidth ? `max-width:${wrapMaxWidth}` : undefined}>
      <Kicker class="hero-problem-index__kicker">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      <h1 class="hero-problem-index__h1 reveal-mask-up" set:html={isFr ? data.h1_fr : data.h1_en} transition:name={data.transition_id ? `hero-h1-${data.transition_id}` : undefined} />
      {(isFr ? data.lede_fr : data.lede_en) && (
        <p class="hero-problem-index__lede" set:html={isFr ? data.lede_fr : data.lede_en} />
      )}
      {data.canonical_fr && (
        <p class="hero-problem-index__canonical" set:html={isFr ? data.canonical_fr : (data.canonical_en ?? data.canonical_fr)} />
      )}
    </div>
  </section>
) : data.type === 'hero-utility-masthead' ? (
  <section class:list={['hero-utility', `hero-utility--${data.align ?? 'left'}`]} data-bg={data.background}>
    <div class="wrap-wide" style={wrapMaxWidth ? `max-width:${wrapMaxWidth}` : undefined}>
      {data.kicker_fr && (
        <Kicker class={`hero-utility__kicker${rv}`}>{isFr ? data.kicker_fr : (data.kicker_en ?? data.kicker_fr)}</Kicker>
      )}
      <h1 class={`hero-utility__h1 u-serif-accent${rv}`} set:html={isFr ? data.h1_fr : data.h1_en} />
      <p class={`hero-utility__lede${rv}`} set:html={isFr ? data.lede_fr : data.lede_en} />
    </div>
  </section>
) : data.type === 'hero-academy-hub' ? (
  <section class:list={['hero-academy-hub', !wrap && 'hero-academy-hub--unwrapped']} style={topPad ? `--hahub-top-pad: ${topPad}` : undefined} data-bg={data.background}>
    <div class="hero-academy-hub__hero">
      <Kicker as="p" class="hero-academy-hub__kicker">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      <h1 class="hero-academy-hub__heading" set:html={isFr ? data.h1_fr : data.h1_en} />
      <p class="hero-academy-hub__lede">{isFr ? data.lede_fr : data.lede_en}</p>
    </div>
    {data.stats_label_fr && (
      <div class="hero-academy-hub__stats">
        <span class="hero-academy-hub__stats-text">{isFr ? data.stats_label_fr : (data.stats_label_en ?? data.stats_label_fr)}</span>
      </div>
    )}
  </section>
) : data.type === 'hero-course' ? (
  <section class="hero-course" style={topPad ? `--hero-course-top-pad: ${topPad}` : undefined} data-bg={data.background}>
    {wrap ? (
      <div class="wrap-wide">
        <header class:list={['hero-course__hd', ghostStyle === 'legacy' && 'hero-course__hd--legacy-ghost']}>
          <Kicker tone="accent">§ {isFr ? data.type_label_fr : data.type_label_en}</Kicker>
          <h1 class="hero-course__title">{isFr ? data.title_fr : data.title_en}</h1>
          <p class="hero-course__lede">{isFr ? data.lede_fr : data.lede_en}</p>
          <div class="hero-course__pills">
            {data.pills.map((p) => (
              <span class:list={['hero-course__pill', p.variant === 'accent' && 'hero-course__pill--accent', p.variant === 'price' && 'hero-course__pill--price']}>
                {isFr ? p.label_fr : p.label_en}
              </span>
            ))}
          </div>
          <div class="hero-course__cta">
            {ctaPrimaryDisabled ? (
              <span class="hero-course__btn-primary hero-course__btn-primary--disabled">{isFr ? data.cta_primary.label_fr : data.cta_primary.label_en}</span>
            ) : (
              <a class="hero-course__btn-primary" href={data.cta_primary.href} {...primaryAttrs}>{isFr ? data.cta_primary.label_fr : data.cta_primary.label_en}</a>
            )}
            {data.cta_secondary && (
              <a class="hero-course__btn-ghost" href={data.cta_secondary.href}>{isFr ? data.cta_secondary.label_fr : data.cta_secondary.label_en}</a>
            )}
          </div>
        </header>
      </div>
    ) : (
      <header class:list={['hero-course__hd', ghostStyle === 'legacy' && 'hero-course__hd--legacy-ghost']}>
        <Kicker tone="accent">§ {isFr ? data.type_label_fr : data.type_label_en}</Kicker>
        <h1 class="hero-course__title">{isFr ? data.title_fr : data.title_en}</h1>
        <p class="hero-course__lede">{isFr ? data.lede_fr : data.lede_en}</p>
        <div class="hero-course__pills">
          {data.pills.map((p) => (
            <span class:list={['hero-course__pill', p.variant === 'accent' && 'hero-course__pill--accent', p.variant === 'price' && 'hero-course__pill--price']}>
              {isFr ? p.label_fr : p.label_en}
            </span>
          ))}
        </div>
        <div class="hero-course__cta">
          {ctaPrimaryDisabled ? (
            <span class="hero-course__btn-primary hero-course__btn-primary--disabled">{isFr ? data.cta_primary.label_fr : data.cta_primary.label_en}</span>
          ) : (
            <a class="hero-course__btn-primary" href={data.cta_primary.href} {...primaryAttrs}>{isFr ? data.cta_primary.label_fr : data.cta_primary.label_en}</a>
          )}
          {data.cta_secondary && (
            <a class="hero-course__btn-ghost" href={data.cta_secondary.href}>{isFr ? data.cta_secondary.label_fr : data.cta_secondary.label_en}</a>
          )}
        </div>
      </header>
    )}
  </section>
) : data.type === 'hero-detail-menu' ? (
  <section class="hero-detail-menu" style={topPad ? `padding-top:${topPad}` : undefined} data-bg={data.background}>
    <div class="wrap-wide" style={wrapMaxWidth ? `max-width:${wrapMaxWidth}` : undefined}>
      <Kicker class="hero-detail-menu__parent">{isFr ? data.parent_kicker_fr : data.parent_kicker_en}</Kicker>
      <Kicker tone="accent" class="hero-detail-menu__num">§ {data.detail_num}</Kicker>
      <h1 class="hero-detail-menu__h1 u-serif-accent" set:html={isFr ? data.h1_fr : data.h1_en} />
      <p class="hero-detail-menu__lede" set:html={isFr ? data.lede_fr : data.lede_en} />
    </div>
  </section>
) : data.type === 'hero-essay' ? (
  <section class:list={['hero-essay', data.illustration && 'hero-essay--illus']} data-bg={data.background}>
    <header
      class:list={['hero-essay__hd', data.illustration && `hero-essay__hd--illus hero-essay__hd--${data.illustration.side ?? 'right'}`]}
      transition:name={cardTransitionId ? `card-${cardTransitionId}` : undefined}
      style={topPad ? `--he-top-pad: ${topPad}` : undefined}
    >
      {data.illustration && (
        <img
          class="hero-essay__illus reveal-blur-clip"
          src={data.illustration.src}
          alt={(isFr ? data.illustration.alt_fr : data.illustration.alt_en) ?? ''}
          loading="eager"
          decoding="async"
          transition:name={transitionId ? `hero-img-${transitionId}` : undefined}
        />
      )}
      <div class="wrap-wide">
        <Kicker class="hero-essay__kicker">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
        <h1
          class="hero-essay__h1 reveal-mask-up u-serif-accent"
          transition:name={transitionId ? `hero-h1-${transitionId}` : undefined}
          set:html={isFr ? data.h1_fr : data.h1_en}
        />
        <p class="hero-essay__lede reveal reveal-fade" set:html={isFr ? data.lede_fr : data.lede_en} />
        <div class="hero-essay__meta">
          <span>{data.author}</span>
          <span aria-hidden>·</span>
          <time datetime={data.date}>{data.date}</time>
          {(isFr ? data.reading_time_fr : data.reading_time_en) && (<><span aria-hidden>·</span><span>{isFr ? data.reading_time_fr : data.reading_time_en}</span></>)}
        </div>
      </div>
    </header>
    {data.hero_image && (
      <div class="hero-essay__image">
        {/* hero_image_alt fourni = image de contenu ; vide = decorative assumee (WCAG 1.1.1). */}
        <img src={data.hero_image} alt={(isFr ? data.hero_image_alt_fr : data.hero_image_alt_en) ?? ''} loading="lazy" />
      </div>
    )}
  </section>
) : data.type === 'hero-case-study' ? (
  <section class:list={['hero-case-study', data.illustration && 'hero-case-study--illus']} transition:name={cardTransitionId ? `card-${cardTransitionId}` : undefined} data-bg={data.background}>
    <div class:list={['hero-case-study__mast', data.illustration && `hero-case-study__mast--illus hero-case-study__mast--${data.illustration.side ?? 'right'}`]} style={topPad ? `--hcs-top-pad: ${topPad}` : undefined}>
      {data.illustration ? (
        <img
          class="hero-case-study__illus reveal-blur-clip"
          src={data.illustration.src}
          alt={(isFr ? data.illustration.alt_fr : data.illustration.alt_en) ?? ''}
          loading="eager"
          decoding="async"
          transition:name={transitionId ? `hero-img-${transitionId}` : undefined}
        />
      ) : (
        <svg class="hero-case-study__deco reveal-blur-clip" viewBox="0 0 600 500" aria-hidden="true" focusable="false" transition:name={transitionId ? `hero-img-${transitionId}` : undefined}>
          <circle cx="480" cy="80" r="220" fill="none" stroke="currentColor" stroke-width=".5" opacity=".12" />
          <circle cx="460" cy="60" r="140" fill="none" stroke="var(--accent)" stroke-width=".4" opacity=".18" />
          <line x1="0" y1="400" x2="600" y2="280" stroke="currentColor" stroke-width=".4" opacity=".1" />
        </svg>
      )}
      <div class="wrap-wide">
        <span class="hero-case-study__eyebrow">{isFr ? data.eyebrow_fr : data.eyebrow_en}</span>
        <Kicker class="hero-case-study__num">{`§ ${isFr ? data.num_label_fr ?? 'Cas' : data.num_label_en ?? 'Case'} ${data.case_num}`}</Kicker>
        <h1 class="hero-case-study__h1 reveal-mask-up u-serif-accent" style={h1Gap ? `--hcs-h1-gap: ${h1Gap}` : undefined} transition:name={transitionId ? `hero-h1-${transitionId}` : undefined} set:html={isFr ? data.h1_fr : data.h1_en} />
      </div>
    </div>
    {data.specs && data.specs.length > 0 && (
      <div class="hero-case-study__specs">
        <div class="wrap-wide hero-case-study__specs-grid" style={`--spec-cols:${data.specs.length}`}>
          {data.specs.map((s, i) => (
            <div class="hero-case-study__spec" data-last={i === data.specs!.length - 1 ? 'true' : 'false'}>
              <Kicker class="hero-case-study__spec-l">{isFr ? s.label_fr : s.label_en}</Kicker>
              <div class="hero-case-study__spec-v">{s.value}</div>
            </div>
          ))}
        </div>
      </div>
    )}
  </section>
) : data.type === 'hero-service-masthead' ? (
  <section class="hero-service-masthead" data-bg={data.background}>
    <div class="wrap-wide">
      <Kicker class="hero-service-masthead__num">§ Service {data.service_num}</Kicker>
      <h1 class="hero-service-masthead__h1 u-serif-accent" set:html={isFr ? data.h1_fr : data.h1_en} />
      <p class="hero-service-masthead__lede" set:html={isFr ? data.lede_fr : data.lede_en} />
    </div>
  </section>
) : data.type === 'hero-service-detail' ? (
  <section class="hero-service-detail" style={topPad ? `padding-top:${topPad}` : undefined} data-bg={data.background}>
    <div class="wrap-wide">
      <Kicker class="hero-service-detail__num">§ Service {data.service_num}</Kicker>
      <h1 class="hero-service-detail__h1 reveal-mask-up u-serif-accent" set:html={isFr ? data.h1_fr : data.h1_en} />
      <p class="hero-service-detail__lede reveal reveal-fade">{isFr ? data.lede_fr : data.lede_en}</p>
      {data.metrics && data.metrics.length > 0 && (
        <div class="hero-service-detail__metrics reveal-stagger">
          {data.metrics.map((m) => (
            <div class="hero-service-detail__metric">
              <span class="hero-service-detail__metric-v">{m.value}</span>
              <span class="hero-service-detail__metric-l">{isFr ? m.label_fr : m.label_en}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
) : data.type === 'hero-landing' ? (
  <section class="hero-landing wrap-wide" data-bg={data.background}>
    <p class="hero-landing__eyebrow reveal">{isFr ? data.eyebrow_fr : data.eyebrow_en}</p>
    <h1 class="hero-landing__h1 reveal-mask-up u-serif-accent-em" set:html={isFr ? data.h1_fr : data.h1_en} />
    <p class="hero-landing__lede reveal">{isFr ? data.lede_fr : data.lede_en}</p>
    <div class="hero-landing__ctas reveal">
      <a href={data.cta_primary.href} class="hero-landing__btn-primary">
        {isFr ? data.cta_primary.label_fr : data.cta_primary.label_en}
      </a>
      {data.cta_secondary && (
        <a href={data.cta_secondary.href} class="hero-landing__btn-secondary">
          {isFr ? data.cta_secondary.label_fr : data.cta_secondary.label_en}
        </a>
      )}
    </div>
    {data.availability_fr && (
      <p class="hero-landing__avail reveal">{isFr ? data.availability_fr : (data.availability_en ?? data.availability_fr)}</p>
    )}
  </section>
) : (
  <section class="hero-centered" data-bg={data.background} data-layout={data.layout} data-density={data.density}>
    <div class="wrap-wide">
    <div class="hero-centered__inner">
      {(isFr ? data.kicker_fr : data.kicker_en) && (
        <Kicker tone="muted">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      )}
      <h1 class="reveal-mask-up" set:html={isFr ? data.h1_fr : data.h1_en} />
      <p class="reveal reveal-fade">{isFr ? data.lede_fr : data.lede_en}</p>
      <div class="hero-centered__ctas">
        <Button href={data.cta_primary.href} variant={data.cta_primary.variant as any} size="lg" mag={data.cta_primary.mag ?? 0.18}>
          {isFr ? data.cta_primary.label_fr : data.cta_primary.label_en}
        </Button>
        {data.cta_secondary && (
          <Button href={data.cta_secondary.href} variant={data.cta_secondary.variant as any} size="md">
            {isFr ? data.cta_secondary.label_fr : data.cta_secondary.label_en}
          </Button>
        )}
      </div>
    </div>
    </div>
  </section>
)}

