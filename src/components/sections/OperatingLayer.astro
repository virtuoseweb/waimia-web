---
// Section catalogue · operating-layer
// COPIE FIDÈLE de `src/components/ui/organisms/OperatingLayer.astro`
// Section dark + console mockup + 4 attribute strip.
import type { SectionByType } from '../../schemas/sections';
import ChapterLabel from '../ui/atoms/ChapterLabel.astro';
import Button from '../ui/atoms/Button.astro';
import TerminalMockup from '../ui/molecules/TerminalMockup.astro';

interface Props {
  data: SectionByType<'operating-layer'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---
<section class="operating-layer on-dark" aria-labelledby="operating-layer-h2">
  <div class="signature-grid on-dark"></div>
  <div class="wrap-wide" style="position:relative;z-index:1">
    <header class="operating-layer__hd">
      <ChapterLabel num={data.chapter_num} title={isFr ? data.chapter_title_fr : data.chapter_title_en} tone="dim" />
      <span class="operating-layer__spec">{data.spec_label}</span>
    </header>

    <div class="operating-layer__grid">
      <div>
        <h2 id="operating-layer-h2" class="operating-layer__h2 reveal" set:html={isFr ? data.h2_fr : data.h2_en} />
        <p class="operating-layer__lede">{isFr ? data.lede_fr : data.lede_en}</p>
        <div class="operating-layer__ctas">
          <Button href={data.cta_primary.href} variant="accent" size="lg" mag={0.18}>
            {isFr ? data.cta_primary.label_fr : data.cta_primary.label_en}
          </Button>
          {data.cta_secondary && (
            <Button href={data.cta_secondary.href} variant="ghost" size="lg">
              {isFr ? data.cta_secondary.label_fr : data.cta_secondary.label_en}
            </Button>
          )}
        </div>
      </div>

      <TerminalMockup label={data.terminal_label} tone="ink" class="blur-in">
        <div class="operating-layer__console-body">
          {data.console_lines.map((line) => (
            <div class="operating-layer__console-row">
              <span class="operating-layer__console-k">{line.k}</span>
              <span class="operating-layer__console-v" set:html={line.v.replace('◉', '<span style="color:var(--accent)">◉</span>')} />
            </div>
          ))}
        </div>
        <div class="operating-layer__console-cmd">{data.console_cmd}</div>
      </TerminalMockup>
    </div>

    <div class="operating-layer__attrs">
      {data.attrs.map((a) => (
        <div>
          <div class="operating-layer__attr-k">{a.k}</div>
          <div class="operating-layer__attr-v">{isFr ? a.v_fr : a.v_en}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .wrap-wide { max-width: 1200px; margin-inline: auto; padding-inline: clamp(20px, 4vw, 48px); }
  .operating-layer {
    padding: clamp(120px,15vw,200px) 0;
    background: var(--ink);
    color: var(--paper);
    position: relative;
    overflow: hidden;
  }
  .operating-layer__hd {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: clamp(40px,5vw,56px);
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(var(--paper-rgb), .12);
    flex-wrap: wrap;
    gap: 14px;
  }
  .operating-layer__spec {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    color: rgba(var(--paper-rgb), .55);
    letter-spacing: .1em;
  }
  .operating-layer__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(40px,6vw,80px);
    align-items: start;
  }
  .operating-layer__h2 {
    font-family: var(--font-display);
    font-size: clamp(40px,8vw,128px);
    line-height: .94;
    letter-spacing: var(--tracking-display);
    font-weight: var(--fw-regular);
    text-wrap: balance;
  }
  .operating-layer__h2 :global(i) { font-style: italic; color: var(--accent); }
  .operating-layer__lede {
    margin-top: 30px;
    font-size: clamp(15px,1.5vw,18px);
    line-height: 1.55;
    color: rgba(var(--paper-rgb), .68);
    max-width: 520px;
    font-family: var(--font-display);
  }
  .operating-layer__ctas { margin-top: var(--space-7); display: flex; gap: var(--space-3); flex-wrap: wrap; }

  .operating-layer__console-body {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 10px;
    padding: 14px;
    border-radius: var(--radius-md);
    background: rgba(var(--paper-rgb), .03);
  }
  .operating-layer__console-row { display: contents; }
  .operating-layer__console-k { color: rgba(var(--paper-rgb), .4); }
  .operating-layer__console-v { color: rgba(var(--paper-rgb), .85); }
  .operating-layer__console-cmd {
    margin-top: var(--space-3);
    padding: var(--space-3) 0;
    border-top: 1px dashed rgba(var(--paper-rgb), .15);
    color: rgba(var(--paper-rgb), .5);
    font-size: var(--text-eyebrow);
  }
  .operating-layer__attrs {
    margin-top: clamp(60px,7vw,96px);
    display: grid;
    grid-template-columns: repeat(4,1fr);
    border-top: 1px solid rgba(var(--paper-rgb), .15);
    border-bottom: 1px solid rgba(var(--paper-rgb), .15);
  }
  .operating-layer__attrs > div {
    padding: clamp(20px,2.5vw,32px) clamp(16px,2vw,28px);
    border-right: 1px solid rgba(var(--paper-rgb), .12);
  }
  .operating-layer__attrs > div:last-child { border-right: none; }
  .operating-layer__attr-k {
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    letter-spacing: .12em;
    color: rgba(var(--paper-rgb), .5);
    text-transform: uppercase;
  }
  .operating-layer__attr-v {
    font-family: var(--font-display);
    font-size: clamp(20px,2.4vw,30px);
    margin-top: var(--space-2);
  }
  @media (max-width: 900px) {
    .operating-layer__grid { grid-template-columns: 1fr; gap: var(--space-8); }
    .operating-layer__attrs { grid-template-columns: repeat(2,1fr); }
    .operating-layer__attrs > div:nth-child(2) { border-right: none; }
    .operating-layer__attrs > div:nth-child(-n+2) { border-bottom: 1px solid rgba(var(--paper-rgb), .12); }
  }
  @media (max-width: 600px) {
    .operating-layer__attrs { grid-template-columns: 1fr; }
    .operating-layer__attrs > div { border-right: none !important; border-bottom: 1px solid rgba(var(--paper-rgb), .12); }
  }
</style>
