---
// Section catalogue · logo-wall
// Grille statique de logos avec effet grayscale -> couleur au hover.
// DISTINCT de marquee-band (ici grille fixe, pas de défilement animé).
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'logo-wall'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const logos = data.logos ?? [];
---

<section class="logo-wall" data-bg={data.background}>
  <div class="wrap-wide">
    <div class="logo-wall__header reveal">
      {(isFr ? data.kicker_fr : data.kicker_en) && (
        <Kicker tone="muted">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      )}
      <h2 set:html={isFr ? data.h2_fr : data.h2_en} />
    </div>
    <ul class="logo-wall__grid reveal-stagger" aria-label={isFr ? 'Logos partenaires' : 'Partner logos'}>
      {logos.map((logo: (typeof logos)[number]) => (
        <li class="logo-wall__cell">
          {logo.href ? (
            <a
              href={logo.href}
              class="logo-wall__link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={isFr ? logo.name_fr : logo.name_en}
            >
              <img
                src={logo.src}
                alt={isFr ? logo.name_fr : logo.name_en}
                width={logo.width ?? 120}
                height={logo.height ?? 40}
                loading="lazy"
                decoding="async"
                class="logo-wall__img"
              />
            </a>
          ) : (
            <span class="logo-wall__link logo-wall__link--static" aria-label={isFr ? logo.name_fr : logo.name_en}>
              <img
                src={logo.src}
                alt={isFr ? logo.name_fr : logo.name_en}
                width={logo.width ?? 120}
                height={logo.height ?? 40}
                loading="lazy"
                decoding="async"
                class="logo-wall__img"
              />
            </span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .logo-wall {
    padding-block: var(--section-base);
    border-bottom: 1px solid var(--hairline);
  }

  .logo-wall__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--spacing-block);
  }

  h2 {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-h2-section);
    line-height: var(--leading-h3);
    color: var(--ink);
    margin: 0;
  }

  h2 :global(i) { font-family: var(--font-display); font-weight: var(--fw-regular); font-style: italic; }

  .logo-wall__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0;
  }

  .logo-wall__cell {
    border: 1px solid var(--hairline);
    margin: -1px -1px 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 88px;
    padding: var(--space-5);
  }

  .logo-wall__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    text-decoration: none;
    border-radius: var(--radius-xs);
    transition:
      opacity var(--dur-fast) var(--ease),
      filter var(--dur-fast) var(--ease);
    outline-offset: 3px;
  }

  .logo-wall__link:focus-visible {
    outline: 2px solid var(--accent);
  }

  .logo-wall__img {
    display: block;
    max-width: 120px;
    max-height: 48px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.55;
    transition:
      filter var(--dur-fast) var(--ease),
      opacity var(--dur-fast) var(--ease);
  }

  .logo-wall__cell:hover .logo-wall__img,
  .logo-wall__cell:focus-within .logo-wall__img {
    filter: grayscale(0);
    opacity: 1;
  }

  @media (max-width: 768px) {
    .logo-wall__grid {
      grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    }
  }

  @media (max-width: 480px) {
    .logo-wall__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .logo-wall__cell {
      min-height: 72px;
      padding: var(--space-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-wall__img,
    .logo-wall__link {
      transition: none;
    }
  }
  /* ── Alternance des fonds R4 (docs/37 §2.6) · defaut paper = rendu inchange ── */
  .logo-wall[data-bg='paper-2'] { background: var(--paper-2); }
  .logo-wall[data-bg='paper-3'] { background: var(--paper-3); }
  .logo-wall[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
    --muted: rgba(var(--paper-rgb), 0.64);
    --hairline: rgba(var(--paper-rgb), 0.14);
    --hairline-strong: rgba(var(--paper-rgb), 0.28);
  }
  .logo-wall[data-bg='ink'] :is(h2, h3, p) { color: var(--paper); }
</style>
