---
// faq-two-column (faq-sections) — FAQ 2 colonnes statiques (question gras + réponse), sans accordéon.
// Dark natif (data-bg). En-tête + grille partagent l'axe gauche du conteneur.
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'faq-two-column'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const items = data.items ?? [];
---

<section class="faq-two-col" data-bg={data.background}>
  <div class="wrap-wide">
    <div class="faq-two-col__header">
      {(isFr ? data.kicker_fr : data.kicker_en) && (
        <Kicker tone="muted">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      )}
      <h2 set:html={isFr ? data.h2_fr : data.h2_en} />
    </div>

    <dl class="faq-two-col__grid">
      {items.map((it: (typeof items)[number]) => (
        <div class="faq-two-col__item">
          <dt class="faq-two-col__q">{isFr ? it.q_fr : it.q_en}</dt>
          <dd class="faq-two-col__a">{isFr ? it.a_fr : it.a_en}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .faq-two-col {
    padding-block: var(--section-base);
    border-bottom: 1px solid var(--hairline);
  }
  .faq-two-col__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--spacing-block);
  }
  h2 {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-h2-section);
    line-height: var(--leading-h3);
    color: var(--ink);
    margin: 0;
  }
  h2 :global(i) { font-family: var(--font-display); font-weight: var(--fw-regular); font-style: italic; }
  .faq-two-col__grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: clamp(var(--space-8), 5vw, var(--space-12));
    row-gap: var(--space-6);
  }
  .faq-two-col__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-5);
    border-top: 1px solid var(--hairline);
  }
  .faq-two-col__q {
    font-family: var(--font-sans);
    font-size: var(--text-h3-row);
    font-weight: var(--fw-semibold);
    color: var(--ink);
    line-height: 1.3;
    margin: 0;
  }
  .faq-two-col__a {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
    max-width: 52ch;
  }
  @media (max-width: 760px) {
    .faq-two-col__grid { grid-template-columns: 1fr; row-gap: var(--space-5); }
  }
  /* ── Dark natif (docs/43) · remap scopé aux enfants ── */
  .faq-two-col[data-bg='paper-2'] { background: var(--paper-2); }
  .faq-two-col[data-bg='paper-3'] { background: var(--paper-3); }
  .faq-two-col[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
    --muted: rgba(var(--paper-rgb), 0.64);
    --hairline: rgba(var(--paper-rgb), 0.14);
    --hairline-strong: rgba(var(--paper-rgb), 0.28);
  }
  .faq-two-col[data-bg='ink'] :is(h2, .faq-two-col__q) { color: var(--paper); }
</style>
