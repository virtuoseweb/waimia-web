---
// Section catalogue · offer-tier-grid
// Source fidèle : `src/pages/offres/index.astro` `.tier-section.tier-i/ii/iii`.
import type { SectionByType } from '../../schemas/sections';

interface Props {
  data: SectionByType<'offer-tier-grid'>;
  lang: 'fr' | 'en';
}

const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const variant = data.variant ?? 'standard';
const sectionClass = [
  'tier-section',
  variant === 'featured' && 'tier-ii',
  variant === 'transparent' && 'tier-iii',
  data.wrap ? 'wrap-wide' : '',
].filter(Boolean).join(' ');
const gridClass = [
  'tier-grid',
  variant === 'featured' && 'tier-ii-grid',
  variant === 'transparent' && 'tier-iii-grid',
].filter(Boolean).join(' ');
---

<section class={sectionClass} data-bg={data.background}>
  <div class={data.wrap ? undefined : 'wrap-wide'}>
    <p class="tier-eyebrow reveal-snap">{isFr ? data.eyebrow_fr : data.eyebrow_en}</p>
    <h2 class="tier-h2 reveal">{isFr ? data.h2_fr : data.h2_en}</h2>
    <p class="tier-lede reveal" style={`transition-delay:100ms${data.lede_max_width ? `; max-width:${data.lede_max_width}` : ''}`}>
      {isFr ? data.lede_fr : data.lede_en}
    </p>

    {data.featured_card && (
      <a href={data.featured_card.href} class="hero-card reveal">
        <p class="hero-card-eyebrow">{isFr ? data.featured_card.eyebrow_fr : data.featured_card.eyebrow_en}</p>
        <h3 class="hero-card-title">{isFr ? data.featured_card.title_fr : data.featured_card.title_en}</h3>
        <p class="hero-card-sub">{isFr ? data.featured_card.sub_fr : data.featured_card.sub_en}</p>
        <p class="hero-card-lead">{isFr ? data.featured_card.lead_fr : data.featured_card.lead_en}</p>
        <span class="hero-card-cta">{isFr ? data.featured_card.cta_fr : data.featured_card.cta_en}</span>
      </a>
    )}

    <div class={`${gridClass} reveal-stagger`}>
      {data.offers.map((offer) => (
        <a href={offer.href} class={`offer-card ${variant === 'transparent' ? 'offer-card--transparent' : ''}`.trim()}>
          <p class="card-price">{isFr ? offer.price_fr : offer.price_en}</p>
          <h3 class="card-title">{isFr ? offer.title_fr : offer.title_en}</h3>
          <p class="card-lead">{isFr ? offer.lead_fr : offer.lead_en}</p>
          <span class="card-cta">{isFr ? offer.cta_fr : offer.cta_en}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .tier-section {
    padding-top: var(--section-loose);
    padding-bottom: var(--section-loose);
    padding-left: var(--space-6);
    padding-right: var(--space-6);
  }
  .tier-ii {
    background: var(--paper-2);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    padding-left: 0;
    padding-right: 0;
  }
  .tier-ii .wrap-wide {
    padding-left: var(--space-6);
    padding-right: var(--space-6);
  }
  .tier-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin: 0 0 20px;
  }
  .tier-h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h1-hero);
    font-weight: var(--fw-medium);
    line-height: var(--leading-h1);
    letter-spacing: -0.024em;
    margin: 0 0 18px;
  }
  .tier-lede {
    font-family: var(--font-sans);
    font-size: clamp(16px, 1.5vw, 18px);
    color: var(--muted);
    line-height: var(--leading-prose);
    margin: 0 0 clamp(36px, 5vw, 60px);
    max-width: 580px;
  }
  .tier-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2.5vw, 28px);
  }
  .tier-ii-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(20px, 3vw, 32px);
  }
  .tier-iii-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .offer-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(24px, 3.5vw, 44px);
    border: 1px solid var(--hairline);
    background: var(--paper-2);
    color: var(--ink);
    transition: border-color var(--dur-trim) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .offer-card:hover {
    border-color: var(--accent-text);
    transform: translateY(-2px);
  }
  .offer-card--transparent {
    background: transparent;
  }
  .offer-card--transparent:hover {
    background: var(--paper-2);
    border-color: var(--accent-text);
  }
  .card-price {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted-2);
    margin: 0;
  }
  .card-title {
    font-family: var(--font-sans);
    font-size: var(--text-h2-section);
    font-weight: var(--fw-medium);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .card-lead {
    font-family: var(--font-sans);
    font-size: var(--text-body-lead);
    color: var(--muted);
    line-height: var(--leading-relaxed);
    margin: 0;
    flex: 1;
  }
  .card-cta {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.1em;
    color: var(--accent-text);
    margin-top: auto;
  }
  .hero-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(36px, 5vw, 64px);
    background: var(--ink);
    color: var(--paper);
    --accent-text: var(--accent-sur-sombre);
    border: 2px solid var(--accent);
    transition: transform var(--dur-hover) var(--ease);
  }
  .hero-card:hover {
    transform: translateY(-3px);
  }
  .hero-card-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0;
  }
  .hero-card-title {
    font-family: var(--font-display);
    font-size: var(--text-h1-hero);
    font-weight: var(--fw-regular);
    font-style: italic;
    line-height: 0.92;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .hero-card-sub {
    font-family: var(--font-display);
    font-size: var(--text-h3-row);
    font-style: italic;
    color: var(--accent-text);
    line-height: 1.15;
    margin: 0;
  }
  .hero-card-lead {
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: var(--leading-relaxed);
    color: rgba(var(--paper-rgb), 0.78);
    margin: 0;
    max-width: 640px;
  }
  .hero-card-cta {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: 0.1em;
    color: var(--accent-text);
  }
  /* ── Alternance des fonds R4 · defaut (sans data-bg) = rendu clair/variant inchange.
     data-bg='ink' harmonise toute la section en sombre (le hero-card etait deja ink). ── */
  .tier-section[data-bg='paper-2'] { background: var(--paper-2); }
  .tier-section[data-bg='paper-3'] { background: var(--paper-3); }
  .tier-section[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
    --muted-2: rgba(var(--paper-rgb), 0.5);
  }
  .tier-section[data-bg='ink'] .tier-h2 { color: var(--paper); }
  .tier-section[data-bg='ink'] .tier-h2 :global(i) { font-family: var(--font-display); font-weight: var(--fw-regular); color: var(--accent-text); }
  /* Offer-cards : panneaux sombres sureleves (au lieu du paper-2 clair), bord clair. */
  .tier-section[data-bg='ink'] .offer-card {
    background: rgba(var(--paper-rgb), 0.04);
    border-color: rgba(var(--paper-rgb), 0.12);
    color: var(--paper);
  }
  .tier-section[data-bg='ink'] .offer-card--transparent { background: transparent; }
  .tier-section[data-bg='ink'] .offer-card:hover { border-color: var(--accent-text); }
  .tier-section[data-bg='ink'] .offer-card--transparent:hover { background: rgba(var(--paper-rgb), 0.05); }
  .tier-section[data-bg='ink'] .card-title { color: var(--paper); }
  /* card-lead/price restent sur --muted (redefini clair) ; card-cta sur --accent. */

  @media (max-width: 900px) {
    .tier-grid,
    .tier-ii-grid,
    .tier-iii-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
