---
// Section catalogue · hero-author
// COPIE FIDÈLE du `.author-hero` de `src/components/templates/AuthorPageTemplate.astro:294-311`
// 2-col : copy (breadcrumb + role eyebrow + h1 italic em + lede) + portrait optionnel.
// Le portrait SVG concret est remplacé par un placeholder hairline frame pour le catalogue.
import type { SectionByType } from '../../schemas/sections';

interface Props {
  data: SectionByType<'hero-author'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---
<section class="hero-author">
  <div class="hero-author__copy">
    {data.team_label_fr && (
      <nav class="hero-author__bc" aria-label={isFr ? "Fil d'Ariane" : 'Breadcrumb'}>
        <a href={data.team_href ?? '#'}>{isFr ? data.team_label_fr : (data.team_label_en ?? data.team_label_fr)}</a>
        <span aria-hidden="true">/</span>
        <span>{data.name}</span>
      </nav>
    )}
    <span class="hero-author__eyebrow">§ {isFr ? data.role_fr : data.role_en}</span>
    <h1 class="hero-author__h1 reveal-mask-up">
      {data.name_lead}<em>{data.name_accent}</em>
    </h1>
    <p class="hero-author__lede" set:html={isFr ? data.lede_fr : data.lede_en} />
  </div>
  <figure class="hero-author__portrait" aria-label={isFr ? 'Portrait signature' : 'Signature portrait'}>
    <div class="hero-author__portrait-frame" aria-hidden="true" />
    <svg viewBox="0 0 220 280" aria-hidden="true">
      <rect x="20" y="40" width="180" height="220" fill="none" stroke="currentColor" stroke-width="0.6"/>
      <circle cx="110" cy="120" r="44" fill="none" stroke="currentColor" stroke-width="0.5"/>
      <path d="M50 230 Q110 170 170 230" fill="none" stroke="currentColor" stroke-width="0.5"/>
    </svg>
  </figure>
</section>

<style>
  .hero-author {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(280px, 4fr);
    gap: clamp(32px, 5vw, 80px);
    padding-inline: clamp(20px, 4vw, 48px);
    padding-top: clamp(92px, 12vw, 164px);
    padding-bottom: clamp(28px, 5vw, 72px);
    align-items: start;
    max-width: 1320px;
    margin-inline: auto;
  }
  .hero-author__bc {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: var(--space-5, 24px);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hero-author__bc a { color: inherit; text-decoration: none; }
  .hero-author__bc a:hover { color: var(--accent); }
  .hero-author__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
  }
  .hero-author__h1 {
    font-family: var(--font-display);
    font-size: clamp(72px, 9vw, 148px);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.03em;
    margin: 12px 0 32px;
    color: var(--ink);
    text-wrap: balance;
  }
  .hero-author__h1 em { font-style: italic; color: var(--accent); }
  .hero-author__lede {
    font-family: var(--font-display);
    font-size: clamp(21px, 2vw, 30px);
    line-height: 1.45;
    color: var(--ink-2);
    max-width: 540px;
    margin: 0;
  }
  .hero-author__portrait {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    margin: 0;
    padding-top: 40px;
    color: var(--ink);
  }
  .hero-author__portrait-frame {
    position: absolute;
    width: min(70%, 240px);
    aspect-ratio: 3 / 4;
    border: 1px solid var(--hairline);
    transform: translate(18px, 18px);
    pointer-events: none;
  }
  .hero-author__portrait svg {
    position: relative;
    width: min(100%, 220px);
  }
  @media (max-width: 768px) {
    .hero-author { grid-template-columns: 1fr; }
  }
</style>
