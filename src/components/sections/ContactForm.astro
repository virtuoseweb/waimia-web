---
// ContactForm · section CONVERSION · formulaire contact (nom/email/message) + colonne coordonnées
// Action vers /api/contact (le champ message est envoyé comme `brief`, contrat de l'API). Bilingue.
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'contact-form'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';

const kicker = isFr ? data.kicker_fr : data.kicker_en;
const heading = isFr ? data.h2_fr : data.h2_en;
const body = isFr ? data.body_fr : data.body_en;
const nameLabel = isFr ? data.name_label_fr : data.name_label_en;
const emailLabel = isFr ? data.email_label_fr : data.email_label_en;
const messageLabel = isFr ? data.message_label_fr : data.message_label_en;
const submit = isFr ? data.submit_label_fr : data.submit_label_en;
const hint = isFr ? data.hint_fr : data.hint_en;
const action = data.form_action ?? '/api/contact';
const details = data.details ?? [];
---

<section class="contact-form" data-bg={data.background} data-cf-lang={lang}>
  <div class="wrap-wide contact-form__grid">
    <div class="contact-form__intro">
      {kicker && <Kicker tone="accent">{kicker}</Kicker>}
      <h2 set:html={heading} />
      {body && <p class="contact-form__body">{body}</p>}
      {details.length > 0 && (
        <dl class="contact-form__details">
          {details.map((d) => (
            <div class="contact-form__detail">
              <dt>{isFr ? d.label_fr : d.label_en}</dt>
              <dd>
                {d.href ? <a href={d.href}>{d.value}</a> : d.value}
              </dd>
            </div>
          ))}
        </dl>
      )}
    </div>

    <form class="contact-form__form" action={action} method="post" novalidate data-cf-form>
      <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="sr-only" />
      <div class="contact-form__field">
        <label for="cf-name">{nameLabel}</label>
        <input id="cf-name" name="name" type="text" autocomplete="name" required class="contact-form__input" />
      </div>
      <div class="contact-form__field">
        <label for="cf-email">{emailLabel}</label>
        <input id="cf-email" name="email" type="email" autocomplete="email" required class="contact-form__input" aria-describedby="cf-error" />
      </div>
      <div class="contact-form__field">
        <label for="cf-message">{messageLabel}</label>
        <textarea id="cf-message" name="brief" rows="4" required class="contact-form__textarea"></textarea>
      </div>
      <p id="cf-error" class="contact-form__error" aria-live="assertive" hidden data-cf-error></p>
      <button type="submit" class="contact-form__btn" data-mag="0.15">{submit}</button>
      {hint && <p class="contact-form__hint">{hint}</p>}
      <p class="contact-form__confirm" aria-live="polite" hidden data-cf-confirm>
        {isFr ? '✓ Message envoyé. On revient vers vous sous 24h.' : '✓ Message sent. We reply within 24h.'}
      </p>
    </form>
  </div>
</section>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  .contact-form {
    padding-block: var(--section-base);
    border-bottom: 1px solid var(--hairline);
  }
  .contact-form__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-10);
    align-items: start;
  }
  .contact-form__intro { display: flex; flex-direction: column; gap: var(--space-4); }
  h2 {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-h2-section);
    line-height: var(--leading-h3);
    color: var(--ink);
    margin: 0;
  }
  h2 :global(i) { font-family: var(--font-display); font-weight: var(--fw-regular); font-style: italic; }
  .contact-form__body {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    line-height: var(--leading-body);
    color: var(--muted);
    margin: 0;
    max-width: 48ch;
    text-wrap: pretty;
  }
  .contact-form__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: var(--space-5) 0 0;
    border-top: 1px solid var(--hairline);
    padding-top: var(--space-5);
  }
  .contact-form__detail { display: flex; flex-direction: column; gap: 2px; }
  .contact-form__detail dt {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .contact-form__detail dd {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--ink);
  }
  .contact-form__detail dd a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }

  .contact-form__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-base);
    padding: var(--space-7);
    background: var(--paper);
  }
  .contact-form__field { display: flex; flex-direction: column; gap: 6px; }
  .contact-form__field label {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .contact-form__input,
  .contact-form__textarea {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--hairline);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    border-radius: var(--radius-sm);
    transition: border-color var(--dur-trim) var(--ease);
    outline: none;
  }
  .contact-form__textarea { resize: vertical; min-height: 110px; }
  .contact-form__input:focus,
  .contact-form__textarea:focus { border-color: var(--ink); }
  .contact-form__input:focus-visible,
  .contact-form__textarea:focus-visible { border-color: var(--ink); outline: 2px solid var(--ink); outline-offset: 2px; }
  .contact-form__input--error { border-color: var(--accent); }
  .contact-form__error {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    color: var(--accent);
    letter-spacing: 0.06em;
    margin: 0;
  }
  .contact-form__btn {
    align-self: flex-start;
    padding: var(--space-3) var(--space-6);
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: var(--fw-medium);
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: opacity var(--dur-fast) ease;
    white-space: nowrap;
  }
  .contact-form__btn:hover { opacity: 0.82; }
  .contact-form__btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .contact-form__hint {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    color: var(--muted);
    letter-spacing: 0.06em;
    margin: 0;
  }
  .contact-form__confirm {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--ink);
    font-weight: var(--fw-medium);
    margin: 0;
  }

  /* Fonds */
  .contact-form[data-bg='paper-2'] { background: var(--paper-2); }
  .contact-form[data-bg='paper-3'] { background: var(--paper-3); }
  .contact-form[data-bg='ink'] {
    background: var(--ink);
    --muted: rgba(var(--paper-rgb), 0.64);
    --hairline: rgba(var(--paper-rgb), 0.16);
  }
  .contact-form[data-bg='ink'] :is(h2, .contact-form__body, .contact-form__detail dd, .contact-form__detail dd a) { color: var(--paper); }
  .contact-form[data-bg='ink'] .contact-form__form { background: rgba(var(--paper-rgb), 0.04); }
  .contact-form[data-bg='ink'] .contact-form__input,
  .contact-form[data-bg='ink'] .contact-form__textarea { background: rgba(var(--paper-rgb), 0.06); color: var(--paper); }

  @media (max-width: 860px) {
    .contact-form__grid { grid-template-columns: 1fr; gap: var(--space-8); }
  }
</style>

<script is:inline>
(function () {
  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  function bind(form) {
    if (form.dataset.cfBound) return;
    form.dataset.cfBound = '1';
    var section = form.closest('[data-cf-lang]');
    var lang = section ? section.dataset.cfLang : 'fr';
    var name = form.querySelector('input[name="name"]');
    var email = form.querySelector('input[name="email"]');
    var brief = form.querySelector('textarea[name="brief"]');
    var honeypot = form.querySelector('input[name="website"]');
    var errorEl = form.querySelector('[data-cf-error]');
    var btn = form.querySelector('.contact-form__btn');
    function showError(msg, field) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.removeAttribute('hidden');
      if (field) field.classList.add('contact-form__input--error');
    }
    function clearError() {
      if (!errorEl) return;
      errorEl.setAttribute('hidden', '');
      errorEl.textContent = '';
      [name, email, brief].forEach(function (f) { if (f) f.classList.remove('contact-form__input--error'); });
    }
    [name, email, brief].forEach(function (f) { if (f) { f.addEventListener('input', clearError); } });
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      clearError();
      var nameVal = name ? name.value.trim() : '';
      var emailVal = email ? email.value.trim() : '';
      var briefVal = brief ? brief.value.trim() : '';
      if (!nameVal) { showError(lang === 'fr' ? 'Indiquez votre nom.' : 'Enter your name.', name); if (name) name.focus(); return; }
      if (!emailVal || !EMAIL_RE.test(emailVal)) { showError(lang === 'fr' ? 'Adresse email invalide.' : 'Invalid email address.', email); if (email) email.focus(); return; }
      if (!briefVal) { showError(lang === 'fr' ? 'Écrivez un message.' : 'Write a message.', brief); if (brief) brief.focus(); return; }
      if (btn) btn.disabled = true;
      var payload = { name: nameVal, email: emailVal, brief: briefVal, lang: lang, website: honeypot ? honeypot.value : '' };
      try {
        var res = await fetch(form.getAttribute('action') || '/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        var data = await res.json();
        if (data.ok) {
          form.querySelectorAll('input, textarea, button, label, .contact-form__hint').forEach(function (el) { el.style.display = 'none'; });
          var confirm = form.querySelector('[data-cf-confirm]');
          if (confirm) { confirm.style.display = ''; confirm.removeAttribute('hidden'); }
        } else {
          showError(data.error || (lang === 'fr' ? 'Erreur, veuillez réessayer.' : 'Error, please try again.'));
          if (btn) btn.disabled = false;
        }
      } catch (_) {
        showError(lang === 'fr' ? 'Erreur réseau, veuillez réessayer.' : 'Network error, please try again.');
        if (btn) btn.disabled = false;
      }
    });
  }
  document.querySelectorAll('.contact-form [data-cf-form]').forEach(bind);
  document.addEventListener('astro:page-load', function () {
    document.querySelectorAll('.contact-form [data-cf-form]').forEach(function (f) { delete f.dataset.cfBound; bind(f); });
  });
})();
</script>
