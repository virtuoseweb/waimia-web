---
// Section W6 · pull-quote-block
// Wrapper catalogue autour de `PullQuote`. Sources : `hub-closing`, `author-pullquote`.
import type { SectionByType } from '../../schemas/sections';
import PullQuote from '../editorial/PullQuote.astro';

interface Props {
  data: SectionByType<'pull-quote-block'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
// `background` (passe 0 R4) pas encore present sur ce schema → lecture defensive sans toucher au schema.
const background = data.background;
---

<section class="pull-quote-block" data-bg={background}>
  <div class="wrap-wide">
    <PullQuote
      attribution={isFr ? data.cite_fr : data.cite_en}
      variant={data.variant}
    >
      <Fragment set:html={isFr ? data.quote_fr : data.quote_en} />
    </PullQuote>
  </div>
</section>

<style>
  .pull-quote-block {
    padding: var(--pull-quote-block-pad, var(--section-tight) 0 var(--section-loose));
    border-top: 1px solid var(--hairline);
  }
  .pull-quote-block :global(.pull-quote) {
    margin-block: 0;
  }

  /* ── Alternance des fonds R4 · defaut (sans data-bg) = rendu clair inchange ── */
  .pull-quote-block[data-bg='paper-2'] { background: var(--paper-2); }
  .pull-quote-block[data-bg='paper-3'] { background: var(--paper-3); }
  .pull-quote-block[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
    --ink-2: rgba(var(--paper-rgb), 0.82);
  }
  /* PullQuote interne (composant scope distinct) : corps + guillemet + signature sur ink. */
  .pull-quote-block[data-bg='ink'] :global(.pull-quote-body) { color: var(--paper); }
  .pull-quote-block[data-bg='ink'] :global(.pull-quote-mark) { color: rgba(var(--paper-rgb), 0.5); }
  .pull-quote-block[data-bg='ink'] :global(.pull-quote-attr) { color: rgba(var(--paper-rgb), 0.82); }
  .pull-quote-block[data-bg='ink'] :global(.pull-quote-cite) { color: rgba(var(--paper-rgb), 0.6); }
</style>
