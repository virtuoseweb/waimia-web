---
import type { SectionByType } from '@waimia/ds-kernel';

interface Props {
  data: SectionByType<'media-block'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const caption = isFr ? data.caption_fr : data.caption_en;
const alt = isFr ? data.alt_fr : data.alt_en;
---

<figure class="media-block" data-bg={data.background} data-kind={data.media_kind} data-display={data.display}>
  <div class="wrap-wide">
  {/* alt fourni par l'editeur = image de contenu ; vide = decorative assumee (WCAG 1.1.1). */}
  {data.media_kind === 'image' && (
    <img
      src={data.src}
      alt={alt ?? ''}
      width={data.width}
      height={data.height}
      loading="lazy"
      decoding="async"
      class="media-block__img"
    />
  )}
  {data.media_kind === 'video' && (
    <video src={data.src} controls preload="none" class="media-block__video" />
  )}
  {data.media_kind === 'embed' && (
    <iframe src={data.src} class="media-block__embed" loading="lazy" title={alt ?? ''} />
  )}
  {data.media_kind === 'svg' && (
    <div class="media-block__svg-wrap" aria-label={alt ?? ''}>
      <img src={data.src} alt={alt ?? ''} loading="lazy" />
    </div>
  )}
  {caption && <figcaption class="media-block__caption">{caption}</figcaption>}
  </div>
</figure>

<style>
  .media-block {
    margin: 0;
    padding-block: var(--section-base);
    border-bottom: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .media-block__img,
  .media-block__video {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--hairline);
  }
  .media-block__embed {
    width: 100%;
    aspect-ratio: 16/9;
    border: 1px solid var(--hairline);
  }
  .media-block__svg-wrap img {
    width: 100%;
    height: auto;
  }
  .media-block__caption {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-style: italic;
    color: var(--muted);
    line-height: var(--leading-body);
  }
  /* ── Variante inset (illustrations carrées) · média centré sur --wrap-prose ── */
  .media-block[data-display='inset'] :is(.media-block__img, .media-block__video, .media-block__svg-wrap, .media-block__caption) {
    max-width: var(--wrap-prose);
    margin-inline: auto;
  }
  .media-block[data-display='inset'] .media-block__caption { width: 100%; }
  /* ── Alternance des fonds R4 (docs/37 §2.6) · defaut paper = rendu inchange ── */
  .media-block[data-bg='paper-2'] { background: var(--paper-2); }
  .media-block[data-bg='paper-3'] { background: var(--paper-3); }
  .media-block[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .media-block[data-bg='ink'] :is(h2, h3, p) { color: var(--paper); }
</style>
