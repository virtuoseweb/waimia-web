---
// Section catalogue · how-we-ship
// COPIE FIDÈLE de `src/components/ui/organisms/HowWeShip.astro`
// Sticky pin scrub : 4 étapes (numline + stage cards) avec script vanilla pour active state.
import type { SectionByType } from '../../schemas/sections';
import SectionHeader from '../ui/molecules/SectionHeader.astro';

interface Props {
  data: SectionByType<'how-we-ship'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---
<section class="how-we-ship" aria-labelledby="how-we-ship-h2">
  <div class="wrap-wide">
    <SectionHeader
      roman={data.roman}
      label={isFr ? data.section_label_fr : data.section_label_en}
      id="how-we-ship-h2"
    >
      <Fragment slot="heading" set:html={isFr ? data.heading_fr : data.heading_en} />
      <Fragment slot="aside">{isFr ? data.aside_fr : data.aside_en}</Fragment>
    </SectionHeader>

    <div class="how-we-ship__wrap" data-how-we-ship-wrap>
      <div class="how-we-ship__sticky">
        <div class="how-we-ship__numline" aria-hidden="true">
          {data.steps.map((s, i) => (
            <span class="how-we-ship__pip" data-step={i}>{s.n}</span>
          ))}
        </div>
        <div class="how-we-ship__stage">
          {data.steps.map((s, i) => (
            <article class="how-we-ship__card" data-step={i}>
              <div class="how-we-ship__roman">{s.n.toUpperCase()}</div>
              <h3 class="how-we-ship__title">{isFr ? s.label_fr : s.label_en}</h3>
              <p class="how-we-ship__body">{isFr ? s.body_fr : s.body_en}</p>
            </article>
          ))}
        </div>
      </div>
      <div class="how-we-ship__tracks">
        {data.steps.map(() => <div class="how-we-ship__track-segment" />)}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const wrap = document.querySelector('[data-how-we-ship-wrap]');
    if (!wrap) return;
    const segments = wrap.querySelectorAll('.how-we-ship__track-segment');
    const cards = wrap.querySelectorAll('.how-we-ship__card');
    const pips = wrap.querySelectorAll('.how-we-ship__pip');
    const total = segments.length;
    if (total === 0) return;
    function update() {
      const r = wrap.getBoundingClientRect();
      const vh = window.innerHeight;
      const p = Math.max(0, Math.min(1, -r.top / (r.height - vh)));
      const idx = Math.min(total - 1, Math.floor(p * total));
      cards.forEach((c, i) => c.classList.toggle('is-active', i === idx));
      pips.forEach((p, i) => p.classList.toggle('is-active', i === idx));
    }
    window.addEventListener('scroll', update, { passive: true });
    update();
  })();
</script>

<style>
  .wrap-wide { max-width: 1200px; margin-inline: auto; padding-inline: clamp(20px, 4vw, 48px); }
  .how-we-ship { padding-block: clamp(60px, 8vw, 100px); }
  .how-we-ship__wrap { position: relative; height: 380vh; }
  .how-we-ship__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: clamp(20px, 3vw, 48px);
    align-items: center;
    padding: clamp(60px, 8vh, 120px) 0;
  }
  .how-we-ship__numline {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 56px);
    align-items: flex-start;
    border-left: 1px solid var(--hairline-strong);
    padding-left: 18px;
  }
  .how-we-ship__pip {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(22px, 2.4vw, 36px);
    color: var(--muted);
    transition: color 600ms ease;
  }
  .how-we-ship__pip.is-active { color: var(--accent); }
  .how-we-ship__stage { position: relative; min-height: clamp(280px, 40vh, 420px); }
  .how-we-ship__card {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 720ms ease, transform 720ms ease;
    pointer-events: none;
  }
  .how-we-ship__card.is-active { opacity: 1; transform: none; pointer-events: auto; }
  .how-we-ship__roman {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(72px, 10vw, 180px);
    line-height: .9;
    letter-spacing: -0.03em;
    color: var(--accent);
    text-transform: uppercase;
  }
  .how-we-ship__title {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.5vw, 68px);
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: var(--fw-regular);
    margin-top: 18px;
    text-wrap: balance;
  }
  .how-we-ship__body {
    font-size: clamp(14px, 1.4vw, 18px);
    color: var(--muted);
    line-height: 1.55;
    margin-top: 18px;
    max-width: 640px;
    text-wrap: pretty;
  }
  .how-we-ship__tracks { display: none; }

  @media (max-width: var(--wrap-read)) {
    .how-we-ship__wrap { height: auto; }
    .how-we-ship__sticky { position: static; height: auto; grid-template-columns: 1fr; padding: 0; }
    .how-we-ship__stage { position: static; min-height: 0; }
    .how-we-ship__card {
      position: static;
      opacity: 1;
      transform: none;
      padding-bottom: 48px;
      border-bottom: 1px solid var(--hairline);
    }
    .how-we-ship__card:last-child { border-bottom: none; }
    .how-we-ship__numline { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .how-we-ship__card { opacity: 1; transform: none; position: static; padding-bottom: 48px; border-bottom: 1px solid var(--hairline); }
    .how-we-ship__wrap { height: auto; }
    .how-we-ship__sticky { position: static; height: auto; }
  }
</style>
