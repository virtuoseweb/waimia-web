---
// Section W6 · tech-stack-band
// Bande stack : wrapper catalogue autour de `TechPillRow`. Sources : `cf-stack`, `dt-stack`, `case-stack`.
import type { SectionByType } from '@waimia/ds-kernel';
import TechPillRow from '../ui/molecules/TechPillRow.astro';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'tech-stack-band'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const pills = data.pills.map((p) => ({
  label: isFr ? p.label_fr : p.label_en,
  kind: p.kind,
}));
---

<section class="tech-stack-band" data-bg={data.background}>
  <div class="wrap-wide">
    <Kicker as="span" tone="accent" class="tech-stack-band__kicker">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
    {(isFr ? data.lead_fr : data.lead_en) && (
      <p class="tech-stack-band__lead" set:html={isFr ? data.lead_fr : data.lead_en} />
    )}
    <TechPillRow pills={pills} class="tech-stack-band__pills" />
  </div>
</section>

<style>
  .tech-stack-band {
    padding: var(--tech-stack-band-pad, var(--section-loose)) var(--tech-stack-band-inline, var(--space-6));
    background: var(--paper-2);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  /* Kicker canonisé (R4) · typo portée par l'atome Kicker, ici layout seul */
  :global(.tech-stack-band__kicker) {
    display: block;
    margin-bottom: var(--space-4);
  }
  .tech-stack-band__lead {
    font-family: var(--font-display);
    font-size: clamp(var(--text-h3), 2.4vw, var(--text-h2));
    line-height: var(--leading-h3);
    color: var(--muted);
    max-width: 760px;
    text-wrap: balance;
    margin: 0 0 clamp(var(--space-6), 3vw, var(--space-8));
  }
  .tech-stack-band__lead :global(i) {
    font-style: italic;
    color: var(--accent-text);
  }
  /* ── Alternance des fonds R4 · defaut paper-2 (clair) = rendu inchange ── */
  .tech-stack-band[data-bg='paper'] { background: var(--paper); }
  .tech-stack-band[data-bg='paper-3'] { background: var(--paper-3); }
  .tech-stack-band[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .tech-stack-band[data-bg='ink'] .tech-stack-band__lead { color: rgba(var(--paper-rgb), 0.78); }
  /* Pills (molecule TechPillRow) : texte herite -> force clair sur ink */
  .tech-stack-band[data-bg='ink'] :global(.tech-pill) { color: var(--paper); }
</style>
