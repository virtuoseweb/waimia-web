---
// Section W6 · case-card-grid
// Table éditoriale 6 colonnes : index · client · secteur · stack · impact · arrow.
// Markup + style = copie VERBATIM de `Cases.astro` (Acte IV — Les preuves, 4 dossiers).
import ChapterLabel from '../ui/atoms/ChapterLabel.astro';
import type { SectionByType } from '../../schemas/sections';

interface Props {
  data: SectionByType<'case-card-grid'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---
<section id="act-4" class="sec" aria-labelledby="cases-h2">
  <div class="wrap-wide">
    <header class="cases-hd">
      <ChapterLabel
        num={data.fig_num}
        title={isFr ? data.fig_title_fr : data.fig_title_en}
      />
      <span class="cases-spec">
        {isFr ? data.spec_fr : data.spec_en}
      </span>
    </header>

    <h2 id="cases-h2" class="cases-h2 reveal" set:html={isFr ? data.h2_fr : data.h2_en} />

    <div class="cases-tbl row-lines reveal-stagger">
      {data.cases.map((c, i) => (
        <a class="cases-row" href={c.href}>
          <span class="cases-idx">{isFr ? data.case_label_fr : data.case_label_en} 0{i + 1}</span>
          <span class="cases-client">{c.client}</span>
          <span class="cases-col">
            <span class="cases-col-k">{isFr ? data.sector_label_fr : data.sector_label_en}</span>
            <span class="cases-col-v">{isFr ? c.sector_fr : c.sector_en}</span>
          </span>
          <span class="cases-col">
            <span class="cases-col-k">Stack</span>
            <span class="cases-col-v">{c.stack}</span>
          </span>
          <span class="cases-col">
            <span class="cases-col-k">{isFr ? data.impact_label_fr : data.impact_label_en} · {c.duration}</span>
            <span class="cases-col-v cases-impact">{isFr ? c.impact_fr : c.impact_en}</span>
          </span>
          <span class="cases-arr" aria-hidden>↗</span>
        </a>
      ))}
    </div>

    {data.all_href && (
      <div class="cases-foot">
        <a href={data.all_href}>
          {isFr ? data.all_label_fr : data.all_label_en}
        </a>
      </div>
    )}
  </div>
</section>

<style>
  /* V6 densification · "1 viewport par section majeure" */
  #act-4{padding:clamp(56px,7vw,96px) 0}
  .cases-hd{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:clamp(20px,2.5vw,32px);padding-bottom:14px;border-bottom:1px solid var(--hairline);flex-wrap:wrap;gap:10px}
  .cases-spec{font-family:var(--font-mono);font-size:11px;color:var(--muted);letter-spacing:.1em}
  .cases-h2{font-family:var(--font-display);font-size:var(--text-h2-section);line-height:var(--leading-h2);letter-spacing:-0.025em;max-width:1080px;margin-bottom:clamp(24px,3vw,40px);font-weight:400;text-wrap:balance}
  .cases-h2 :global(i){font-style:italic;color:var(--accent)}

  .cases-tbl{}
  .cases-row{display:grid;grid-template-columns:90px 2fr 1.1fr 1.5fr 1.4fr 32px;gap:24px;padding:clamp(28px,3vw,40px) 0;border-top:1px solid var(--hairline);align-items:baseline;color:inherit;transition:background 200ms var(--ease, cubic-bezier(0.22, 1, 0.36, 1)),padding-left 320ms var(--ease)}
  .cases-row:hover{background:var(--paper-2);padding-left:14px;padding-right:14px}
  .cases-row:hover .cases-arr{color:var(--accent);transform:translateX(4px) translateY(-2px)}
  .cases-row:hover .cases-client{color:var(--accent);transition:color 200ms var(--ease)}

  .cases-idx{font-family:var(--font-mono);font-size:11px;letter-spacing:.16em;color:var(--muted);text-transform:uppercase}
  /* Cases client titre · réutilise H2-tight token (entre row et h2 standard) */
  .cases-client{font-family:var(--font-display);font-size:var(--text-h2-tight);line-height:var(--leading-h2);letter-spacing:-0.02em;font-weight:400;font-style:italic}
  .cases-col{display:flex;flex-direction:column;gap:4px}
  .cases-col-k{font-family:var(--font-mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
  .cases-col-v{font-size:13px;color:var(--muted);line-height:1.4}
  .cases-impact{color:var(--ink);font-weight:500;font-size:15px}
  .cases-arr{font-family:var(--font-mono);font-size:18px;color:var(--muted);text-align:right;transition:color 240ms var(--ease),transform 320ms var(--ease)}

  .cases-foot{margin-top:clamp(40px,4vw,56px);text-align:right}
  .cases-foot a{font-family:var(--font-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);border-bottom:1px solid var(--accent);padding-bottom:2px}

  @media (max-width:1100px){
    .cases-row{grid-template-columns:1fr 1fr;row-gap:6px;padding:24px 0}
    .cases-idx{grid-column:1/-1}
    .cases-client{grid-column:1/-1;font-size:32px}
    .cases-arr{display:none}
  }
  @media (max-width:600px){
    .cases-row{grid-template-columns:1fr}
  }
</style>
