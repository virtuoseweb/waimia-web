---
// Section W6 · case-card-grid
// Table éditoriale 6 colonnes : index · client · secteur · stack · impact · arrow.
// Markup + style = copie VERBATIM de `Cases.astro` (Acte IV — Les preuves, 4 dossiers).
import { getCollection } from 'astro:content';
import ChapterLabel from '../ui/atoms/ChapterLabel.astro';
import Kicker from '../ui/atoms/Kicker.astro';
import type { SectionByType } from '../../schemas/sections';

interface Props {
  data: SectionByType<'case-card-grid'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';

// Résolution GLOBAL : si caseRefs présent → résout la collection `cases` filtrée par
// slug (ordre du caseRefs préservé, slugs inconnus ignorés = anti-404) et mappe vers
// la forme `cases` attendue par le markup (stack[] → 'a · b · c') ; sinon fallback
// aux cases inline (rétrocompat, 0 régression).
let resolvedCases = data.cases;
if (data.caseRefs && data.caseRefs.length > 0) {
  const all = await getCollection('cases');
  const bySlug = new Map(all.map((c) => [c.id, c]));
  resolvedCases = data.caseRefs
    .map((slug) => bySlug.get(slug))
    .filter((c): c is NonNullable<typeof c> => Boolean(c))
    .map((c) => ({
      client: c.data.client,
      sector_fr: c.data.sector_fr,
      sector_en: c.data.sector_en,
      duration: c.data.duration,
      stack: c.data.stack.join(' · '),
      impact_fr: c.data.impact_fr,
      impact_en: c.data.impact_en,
      href: `/cas-clients/${c.id}`,
    }));
}

// GAP-B · état vide honnête : < 2 cas (ou 0) → encart « premiers cas en cours de
// rédaction » au lieu d'une table famélique. Porté DANS le composant catalogué pour
// se propager partout (pas en inline dans la route).
const isEmpty = resolvedCases.length < 2;
const emptyKicker = isFr
  ? data.empty_kicker_fr ?? 'Cas de ce secteur'
  : data.empty_kicker_en ?? 'Cases for this industry';
const emptyBody = isFr
  ? data.empty_body_fr ??
    "Nous publions un cas uniquement après mesure du résultat et accord du client. Les premiers cas de ce secteur arrivent. En attendant, parlons de votre projet : nous montrons concrètement comment nous travaillons."
  : data.empty_body_en ??
    'We only publish a case after the result is measured and the client has agreed. The first cases for this industry are coming. In the meantime, let us talk about your project: we show exactly how we work.';

// ── Couche atomique (Batch 2) · placement par région (header + body + actions=lien « tous »).
// Résolution raccourci↔placement : valeur effective UNE fois, UN seul data-attr par région.
// placement.header.align surcharge contentAlign. Défaut absent = rendu actuel.
const pl = data.placement;
const headerAlign = pl?.header?.align ?? data.contentAlign;
const headerOrder = pl?.header?.order;
const headerHide = pl?.header?.hideOn;
const bodyHide = pl?.body?.hideOn;
const actionsJustify =
  pl?.actions?.justify ?? (data.actionsAlign === 'spread' ? 'between' : data.actionsAlign);
const colRatio = data.layout === 'grid-asym' ? (data.colRatio ?? 'equal') : undefined;
---
<section
  id="act-4"
  class="sec"
  data-bg={data.background}
  data-density={data.density}
  data-content-align={data.contentAlign}
  data-layout={data.layout}
  aria-labelledby="cases-h2"
>
  <div class="wrap-wide">
    <header class="cases-hd" data-header-align={headerAlign} data-header-order={headerOrder} data-header-hide={headerHide}>
      <ChapterLabel
        num={data.fig_num}
        title={isFr ? data.fig_title_fr : data.fig_title_en}
      />
      <span class="cases-spec">
        {isFr ? data.spec_fr : data.spec_en}
      </span>
    </header>

    <h2 id="cases-h2" class="cases-h2 reveal u-serif-accent" set:html={isFr ? data.h2_fr : data.h2_en} />

    {isEmpty ? (
      <div class="cases-empty reveal">
        <Kicker tone="accent" class="cases-empty__kicker">§ {emptyKicker}</Kicker>
        <p class="cases-empty__body">{emptyBody}</p>
      </div>
    ) : (
    <div class="cases-tbl row-lines reveal-stagger" data-columns={data.columns} data-col-ratio={colRatio} data-item-height={data.itemHeight} data-body-hide={bodyHide}>
      {resolvedCases.map((c, i) => (
        <a class="cases-row" href={c.href}>
          <span class="cases-idx">{isFr ? data.case_label_fr : data.case_label_en} 0{i + 1}</span>
          <span class="cases-client">{c.client}</span>
          <span class="cases-col">
            <span class="cases-col-k">{isFr ? data.sector_label_fr : data.sector_label_en}</span>
            <span class="cases-col-v">{isFr ? c.sector_fr : c.sector_en}</span>
          </span>
          <span class="cases-col">
            <span class="cases-col-k">Stack</span>
            <span class="cases-col-v">{c.stack}</span>
          </span>
          <span class="cases-col">
            <span class="cases-col-k">{isFr ? data.impact_label_fr : data.impact_label_en} · {c.duration}</span>
            <span class="cases-col-v cases-impact">{isFr ? c.impact_fr : c.impact_en}</span>
          </span>
          <span class="cases-arr" aria-hidden>↗</span>
        </a>
      ))}
    </div>
    )}

    {data.all_href && (
      <div class="cases-foot" data-actions-justify={actionsJustify}>
        <a href={data.all_href}>
          {isFr ? data.all_label_fr : data.all_label_en}
        </a>
      </div>
    )}
  </div>
</section>

<style>
  /* V6 densification · "1 viewport par section majeure" */
  #act-4{padding:var(--section-base) 0}
  .cases-hd{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:var(--space-6);padding-bottom:14px;border-bottom:1px solid var(--hairline);flex-wrap:wrap;gap:10px}
  .cases-spec{font-family:var(--font-mono);font-size:var(--text-small);color:var(--muted);letter-spacing:.1em}
  /* H2 = masse → Instrument Sans medium ; <i> reste relevé serif italic accent */
  .cases-h2{font-family:var(--font-sans);font-size:var(--text-h2);line-height:var(--leading-h2);letter-spacing:-0.015em;max-width:1080px;margin-bottom:var(--space-7);font-weight:var(--fw-medium);text-wrap:balance}

  .cases-tbl{}
  .cases-row{display:grid;grid-template-columns:90px 2fr 1.1fr 1.5fr 1.4fr 32px;gap:var(--space-5);padding:var(--space-7) 0;border-top:1px solid var(--hairline);align-items:baseline;color:inherit;transition:background var(--dur-trim) var(--ease),translate var(--dur-hover) var(--ease)}
  .cases-row:hover{background:var(--paper-2);translate:12px 0}
  .cases-row:hover .cases-arr{color:var(--accent-text);transform:translateX(4px) translateY(-2px)}
  .cases-row:hover .cases-client{color:var(--accent-text);transition:color var(--dur-fast) var(--ease)}

  .cases-idx{font-family:var(--font-mono);font-size:var(--text-small);letter-spacing:.16em;color:var(--muted);text-transform:uppercase}
  /* Cases client titre · réutilise H2-tight token (entre row et h2 standard) */
  .cases-client{font-family:var(--font-sans);font-size:var(--text-h2);line-height:var(--leading-h2);letter-spacing:-0.015em;font-weight:var(--fw-medium);font-style:normal}
  .cases-col{display:flex;flex-direction:column;gap:var(--space-1)}
  .cases-col-k{font-family:var(--font-mono);font-size:var(--text-small);letter-spacing:var(--tracking-mono);text-transform:uppercase;color:var(--muted)}
  .cases-col-v{font-size:var(--text-small);color:var(--muted);line-height:var(--leading-lede)}
  .cases-impact{color:var(--ink);font-weight:var(--fw-medium);font-size:var(--text-body)}
  .cases-arr{font-family:var(--font-mono);font-size:var(--text-glyph);color:var(--muted);text-align:right;transition:color var(--dur-trim) var(--ease),transform var(--dur-hover) var(--ease)}

  .cases-foot{margin-top:var(--space-9);text-align:left}
  .cases-foot a{font-family:var(--font-mono);font-size:var(--text-small);letter-spacing:.14em;text-transform:uppercase;color:var(--accent-text);border-bottom:1px solid var(--accent);padding-bottom:2px}

  /* GAP-B · état vide honnête (< 2 cas) · tokens DS uniquement (parité avec l'ancien
     .sector-cases-empty de SecteurHubTemplate). */
  .cases-empty{border-top:1px solid var(--hairline);padding-top:var(--space-7)}
  :global(.cases-empty__kicker){margin-bottom:var(--space-3)}
  .cases-empty__body{font-size:var(--text-h3);line-height:1.6;color:var(--muted);margin:0;max-width:820px;text-wrap:pretty}

  @media (max-width:1100px){
    .cases-row{grid-template-columns:1fr 1fr;row-gap:6px;padding:var(--space-5) 0}
    .cases-idx{grid-column:1/-1}
    .cases-client{grid-column:1/-1;font-size:var(--text-h2)}
    .cases-arr{display:none}
  }
  @media (max-width:600px){
    .cases-row{grid-template-columns:1fr}
  }

  /* ── Axe DENSITY (data-density) : rythme du header + padding des lignes. Défaut (absent)
     = --section-base / row padding --space-7 (rendu actuel). Tokens --space-* uniquement. ── */
  #act-4[data-density='compact']{padding:var(--space-8) 0}
  #act-4[data-density='compact'] .cases-hd{margin-bottom:var(--space-5)}
  #act-4[data-density='compact'] .cases-h2{margin-bottom:var(--space-5)}
  #act-4[data-density='compact'] .cases-row{padding:var(--space-5) 0}
  #act-4[data-density='base'] .cases-row{padding:var(--space-7) 0}
  #act-4[data-density='ample']{padding:var(--space-12) 0}
  #act-4[data-density='ample'] .cases-hd{margin-bottom:var(--space-9)}
  #act-4[data-density='ample'] .cases-h2{margin-bottom:var(--space-9)}
  #act-4[data-density='ample'] .cases-row{padding:var(--space-9) 0}

  /* ── Axe CONTENT-ALIGN (data-content-align) : alignement du header (fig label + spec + h2).
     Défaut (absent) = start (gauche). center|end recadrent l'en-tête sans toucher la table. ── */
  #act-4[data-content-align='center'] .cases-hd{justify-content:center;text-align:center}
  #act-4[data-content-align='center'] .cases-h2{margin-inline:auto}
  #act-4[data-content-align='end'] .cases-hd{justify-content:flex-end;text-align:end}
  #act-4[data-content-align='end'] .cases-h2{margin-inline-start:auto}

  /* ── COUCHE ATOMIQUE (Batch 2) · placement par région (header + body + actions=lien « tous »).
     data-header-align résout placement.header.align ?? contentAlign. data-actions-justify
     (pied) résout placement.actions.justify ?? actionsAlign, indépendant du header.
     order/hideOn structurels. ── */
  .cases-hd[data-header-align='center']{justify-content:center;text-align:center}
  .cases-hd[data-header-align='end']{justify-content:flex-end;text-align:end}
  /* wrap-wide en flux pour réordonner header ↔ table. */
  #act-4 .wrap-wide{display:flex;flex-direction:column}
  .cases-hd[data-header-order='0']{order:0}
  .cases-hd[data-header-order='1']{order:1}
  .cases-hd[data-header-hide='desktop'],
  .cases-tbl[data-body-hide='desktop']{display:none}
  @media (max-width:768px){
    .cases-hd[data-header-hide='mobile'],
    .cases-tbl[data-body-hide='mobile']{display:none}
    .cases-hd[data-header-hide='desktop']{display:flex}
    .cases-tbl[data-body-hide='desktop']{display:block}
  }
  .cases-foot[data-actions-justify]{display:flex}
  .cases-foot[data-actions-justify='start']{justify-content:flex-start}
  .cases-foot[data-actions-justify='center']{justify-content:center}
  .cases-foot[data-actions-justify='end']{justify-content:flex-end}
  .cases-foot[data-actions-justify='between']{justify-content:space-between}

  /* ── VOCABULAIRE DE LAYOUT (Batch 2) · TABLE de lignes → on NE ment PAS avec bento.
     Défaut (absent) = rendu actuel (rows). list = sans border-top. grid-uniform/grid-asym
     = projettent les cas en CARTES empilées (la grille 6-col interne de chaque ligne se
     replie en stack vertical). 100% tokens DS ; structurel = 768px, aspect-ratio, order. ── */

  /* list : lignes empilées sans la hairline supérieure (rythme par l'espacement seul). */
  #act-4[data-layout='list'] .cases-row{border-top:none}

  /* grid-uniform : cartes en grille N colonnes égales. Chaque ligne devient une carte
     bordée, son contenu se replie en pile verticale lisible. */
  #act-4[data-layout='grid-uniform'] .cases-tbl,
  #act-4[data-layout='grid-asym'] .cases-tbl{
    display:grid;
    gap:var(--space-5);
    align-items:stretch;
  }
  #act-4[data-layout='grid-uniform'] .cases-tbl{grid-template-columns:repeat(3,minmax(0,1fr))}
  #act-4[data-layout='grid-uniform'] .cases-tbl[data-columns='auto']{grid-template-columns:repeat(auto-fit,minmax(min(18rem,100%),1fr));justify-content:center}
  #act-4[data-layout='grid-uniform'] .cases-tbl[data-columns='2']{grid-template-columns:repeat(2,minmax(0,1fr))}
  #act-4[data-layout='grid-uniform'] .cases-tbl[data-columns='3']{grid-template-columns:repeat(3,minmax(0,1fr))}
  #act-4[data-layout='grid-uniform'] .cases-tbl[data-columns='4']{grid-template-columns:repeat(4,minmax(0,1fr))}

  /* grid-asym : cartes en grille de largeurs différentes via colRatio. */
  #act-4[data-layout='grid-asym'] .cases-tbl{grid-template-columns:1fr 1fr}
  #act-4[data-layout='grid-asym'] .cases-tbl[data-col-ratio='equal']{grid-template-columns:1fr 1fr}
  #act-4[data-layout='grid-asym'] .cases-tbl[data-col-ratio='1-2']{grid-template-columns:1fr 2fr}
  #act-4[data-layout='grid-asym'] .cases-tbl[data-col-ratio='2-1']{grid-template-columns:2fr 1fr}
  #act-4[data-layout='grid-asym'] .cases-tbl[data-col-ratio='1-1-2']{grid-template-columns:1fr 1fr 2fr}
  #act-4[data-layout='grid-asym'] .cases-tbl[data-col-ratio='2-3']{grid-template-columns:2fr 3fr}

  /* Carte (mode grille) : la ligne 6-col se replie en pile ; bordure + padding de carte. */
  #act-4:is([data-layout='grid-uniform'],[data-layout='grid-asym']) .cases-row{
    grid-template-columns:1fr;
    gap:var(--space-3);
    padding:var(--space-6);
    border:1px solid var(--hairline);
    border-radius:var(--radius-xs);
    align-content:start;
  }
  #act-4:is([data-layout='grid-uniform'],[data-layout='grid-asym']) .cases-row:hover{translate:0 -2px}
  #act-4:is([data-layout='grid-uniform'],[data-layout='grid-asym']) .cases-arr{display:inline;text-align:left}

  /* itemHeight (mode grille seulement) : harmonisées/contrastées. */
  #act-4:is([data-layout='grid-uniform'],[data-layout='grid-asym']) .cases-tbl[data-item-height='even']{align-items:stretch}
  #act-4:is([data-layout='grid-uniform'],[data-layout='grid-asym']) .cases-tbl[data-item-height='auto']{align-items:start}
  #act-4:is([data-layout='grid-uniform'],[data-layout='grid-asym']) .cases-tbl[data-item-height='square'] .cases-row{aspect-ratio:1;overflow:hidden}
  #act-4:is([data-layout='grid-uniform'],[data-layout='grid-asym']) .cases-tbl[data-item-height='video'] .cases-row{aspect-ratio:16/9;overflow:hidden}

  /* Responsive : les recettes grille convergent en 1 colonne ≤768px ; rows/list restent. */
  @media (max-width:768px){
    #act-4[data-layout='grid-uniform'] .cases-tbl,
    #act-4[data-layout='grid-uniform'] .cases-tbl[data-columns='2'],
    #act-4[data-layout='grid-uniform'] .cases-tbl[data-columns='3'],
    #act-4[data-layout='grid-uniform'] .cases-tbl[data-columns='4'],
    #act-4[data-layout='grid-asym'] .cases-tbl,
    #act-4[data-layout='grid-asym'] .cases-tbl[data-col-ratio='1-2'],
    #act-4[data-layout='grid-asym'] .cases-tbl[data-col-ratio='2-1'],
    #act-4[data-layout='grid-asym'] .cases-tbl[data-col-ratio='1-1-2'],
    #act-4[data-layout='grid-asym'] .cases-tbl[data-col-ratio='2-3']{grid-template-columns:1fr}
    #act-4:is([data-layout='grid-uniform'],[data-layout='grid-asym']) .cases-tbl[data-item-height='square'] .cases-row,
    #act-4:is([data-layout='grid-uniform'],[data-layout='grid-asym']) .cases-tbl[data-item-height='video'] .cases-row{aspect-ratio:auto}
  }

  /* ── Alternance des fonds R4 · defaut (sans data-bg) = rendu clair inchange ── */
  #act-4[data-bg='paper-2']{background:var(--paper-2)}
  #act-4[data-bg='paper-3']{background:var(--paper-3)}
  #act-4[data-bg='ink']{
    background:var(--ink);
    color:var(--paper);
    --muted:rgba(var(--paper-rgb),0.64);
    --hairline:rgba(var(--paper-rgb),0.14);
    --hairline-strong:rgba(var(--paper-rgb),0.28);
  }
  #act-4[data-bg='ink'] :is(.cases-h2,.cases-client){color:var(--paper)}
  #act-4[data-bg='ink'] .cases-h2 :global(i) { font-family: var(--font-display); font-weight: var(--fw-regular); color:var(--accent-text); }
  /* hover : voile clair subtil au lieu du paper-2 clair ; impact en texte clair lisible. */
  #act-4[data-bg='ink'] .cases-row:hover{background:rgba(var(--paper-rgb),0.05)}
  #act-4[data-bg='ink'] .cases-impact{color:var(--paper)}
</style>
