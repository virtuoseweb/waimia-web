---
// Section W6 · case-card-grid
// Table éditoriale 6 colonnes : index · client · secteur · stack · impact · arrow.
// Markup + style = copie VERBATIM de `Cases.astro` (Acte IV — Les preuves, 4 dossiers).
import ChapterLabel from '../ui/atoms/ChapterLabel.astro';
import type { SectionByType } from '../../schemas/sections';

interface Props {
  data: SectionByType<'case-card-grid'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---
<section id="act-4" class="sec" data-bg={data.background} aria-labelledby="cases-h2">
  <div class="wrap-wide">
    <header class="cases-hd">
      <ChapterLabel
        num={data.fig_num}
        title={isFr ? data.fig_title_fr : data.fig_title_en}
      />
      <span class="cases-spec">
        {isFr ? data.spec_fr : data.spec_en}
      </span>
    </header>

    <h2 id="cases-h2" class="cases-h2 reveal u-serif-accent" set:html={isFr ? data.h2_fr : data.h2_en} />

    <div class="cases-tbl row-lines reveal-stagger">
      {data.cases.map((c, i) => (
        <a class="cases-row" href={c.href}>
          <span class="cases-idx">{isFr ? data.case_label_fr : data.case_label_en} 0{i + 1}</span>
          <span class="cases-client">{c.client}</span>
          <span class="cases-col">
            <span class="cases-col-k">{isFr ? data.sector_label_fr : data.sector_label_en}</span>
            <span class="cases-col-v">{isFr ? c.sector_fr : c.sector_en}</span>
          </span>
          <span class="cases-col">
            <span class="cases-col-k">Stack</span>
            <span class="cases-col-v">{c.stack}</span>
          </span>
          <span class="cases-col">
            <span class="cases-col-k">{isFr ? data.impact_label_fr : data.impact_label_en} · {c.duration}</span>
            <span class="cases-col-v cases-impact">{isFr ? c.impact_fr : c.impact_en}</span>
          </span>
          <span class="cases-arr" aria-hidden>↗</span>
        </a>
      ))}
    </div>

    {data.all_href && (
      <div class="cases-foot">
        <a href={data.all_href}>
          {isFr ? data.all_label_fr : data.all_label_en}
        </a>
      </div>
    )}
  </div>
</section>

<style>
  /* V6 densification · "1 viewport par section majeure" */
  #act-4{padding:var(--section-base) 0}
  .cases-hd{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:clamp(20px,2.5vw,32px);padding-bottom:14px;border-bottom:1px solid var(--hairline);flex-wrap:wrap;gap:10px}
  .cases-spec{font-family:var(--font-mono);font-size:var(--text-eyebrow);color:var(--muted);letter-spacing:.1em}
  /* H2 = masse → Instrument Sans medium ; <i> reste relevé serif italic accent */
  .cases-h2{font-family:var(--font-sans);font-size:var(--text-h2-section);line-height:var(--leading-h2);letter-spacing:-0.015em;max-width:1080px;margin-bottom:clamp(24px,3vw,40px);font-weight:var(--fw-medium);text-wrap:balance}

  .cases-tbl{}
  .cases-row{display:grid;grid-template-columns:90px 2fr 1.1fr 1.5fr 1.4fr 32px;gap:var(--space-5);padding:clamp(28px,3vw,40px) 0;border-top:1px solid var(--hairline);align-items:baseline;color:inherit;transition:background var(--dur-trim) var(--ease),transform var(--dur-hover) var(--ease)}
  .cases-row:hover{background:var(--paper-2);transform:translateX(12px)}
  .cases-row:hover .cases-arr{color:var(--accent);transform:translateX(4px) translateY(-2px)}
  .cases-row:hover .cases-client{color:var(--accent);transition:color var(--dur-fast) var(--ease)}

  .cases-idx{font-family:var(--font-mono);font-size:var(--text-eyebrow);letter-spacing:.16em;color:var(--muted);text-transform:uppercase}
  /* Cases client titre · réutilise H2-tight token (entre row et h2 standard) */
  .cases-client{font-family:var(--font-sans);font-size:var(--text-h2-tight);line-height:var(--leading-h2);letter-spacing:-0.015em;font-weight:var(--fw-medium);font-style:normal}
  .cases-col{display:flex;flex-direction:column;gap:var(--space-1)}
  .cases-col-k{font-family:var(--font-mono);font-size:var(--text-mono-xs);letter-spacing:var(--tracking-mono);text-transform:uppercase;color:var(--muted)}
  .cases-col-v{font-size:var(--text-ui);color:var(--muted);line-height:var(--leading-lede)}
  .cases-impact{color:var(--ink);font-weight:var(--fw-medium);font-size:var(--text-body-lead)}
  .cases-arr{font-family:var(--font-mono);font-size:18px;color:var(--muted);text-align:right;transition:color var(--dur-trim) var(--ease),transform var(--dur-hover) var(--ease)}

  .cases-foot{margin-top:clamp(40px,4vw,56px);text-align:right}
  .cases-foot a{font-family:var(--font-mono);font-size:var(--text-eyebrow);letter-spacing:.14em;text-transform:uppercase;color:var(--accent);border-bottom:1px solid var(--accent);padding-bottom:2px}

  @media (max-width:1100px){
    .cases-row{grid-template-columns:1fr 1fr;row-gap:6px;padding:var(--space-5) 0}
    .cases-idx{grid-column:1/-1}
    .cases-client{grid-column:1/-1;font-size:32px}
    .cases-arr{display:none}
  }
  @media (max-width:600px){
    .cases-row{grid-template-columns:1fr}
  }

  /* ── Alternance des fonds R4 · defaut (sans data-bg) = rendu clair inchange ── */
  #act-4[data-bg='paper-2']{background:var(--paper-2)}
  #act-4[data-bg='paper-3']{background:var(--paper-3)}
  #act-4[data-bg='ink']{
    background:var(--ink);
    color:var(--paper);
    --muted:rgba(var(--paper-rgb),0.64);
    --hairline:rgba(var(--paper-rgb),0.14);
    --hairline-strong:rgba(var(--paper-rgb),0.28);
  }
  #act-4[data-bg='ink'] :is(.cases-h2,.cases-client){color:var(--paper)}
  #act-4[data-bg='ink'] .cases-h2 :global(i) { font-family: var(--font-display); font-weight: var(--fw-regular); color:var(--accent); }
  /* hover : voile clair subtil au lieu du paper-2 clair ; impact en texte clair lisible. */
  #act-4[data-bg='ink'] .cases-row:hover{background:rgba(var(--paper-rgb),0.05)}
  #act-4[data-bg='ink'] .cases-impact{color:var(--paper)}
</style>
