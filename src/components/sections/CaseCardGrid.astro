---
// Section W6 · case-card-grid
// Table éditoriale 6 colonnes : index · client · secteur · stack · impact · arrow.
// Source : `Cases.astro` (Acte IV — Les preuves, 4 dossiers).
import type { SectionByType } from '../../schemas/sections';

interface Props {
  data: SectionByType<'case-card-grid'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---

<section class="case-card-grid" aria-labelledby="case-card-grid-h2">
  <div class="wrap-wide">
    <header class="case-card-grid__hd">
      <div class="case-card-grid__chapter">
        <span class="case-card-grid__dot" aria-hidden></span>
        <span class="case-card-grid__num">{data.fig_num}</span>
        <span class="case-card-grid__sep" aria-hidden>·</span>
        <span>{isFr ? data.fig_title_fr : data.fig_title_en}</span>
      </div>
      <span class="case-card-grid__spec">{isFr ? data.spec_fr : data.spec_en}</span>
    </header>

    <h2 id="case-card-grid-h2" class="case-card-grid__h2 reveal" set:html={isFr ? data.h2_fr : data.h2_en} />

    <div class="case-card-grid__tbl reveal-stagger">
      {data.cases.map((c, i) => (
        <a class="case-card-grid__row" href={c.href}>
          <span class="case-card-grid__idx">{isFr ? data.case_label_fr : data.case_label_en} 0{i + 1}</span>
          <span class="case-card-grid__client">{c.client}</span>
          <span class="case-card-grid__col">
            <span class="case-card-grid__col-k">{isFr ? data.sector_label_fr : data.sector_label_en}</span>
            <span class="case-card-grid__col-v">{isFr ? c.sector_fr : c.sector_en}</span>
          </span>
          <span class="case-card-grid__col">
            <span class="case-card-grid__col-k">Stack</span>
            <span class="case-card-grid__col-v">{c.stack}</span>
          </span>
          <span class="case-card-grid__col">
            <span class="case-card-grid__col-k">{isFr ? data.impact_label_fr : data.impact_label_en} · {c.duration}</span>
            <span class="case-card-grid__col-v case-card-grid__impact">{isFr ? c.impact_fr : c.impact_en}</span>
          </span>
          <span class="case-card-grid__arr" aria-hidden>↗</span>
        </a>
      ))}
    </div>

    {data.all_href && (
      <div class="case-card-grid__foot">
        <a href={data.all_href}>{isFr ? data.all_label_fr : data.all_label_en}</a>
      </div>
    )}
  </div>
</section>

<style>
  .case-card-grid {
    padding: clamp(56px, 7vw, 96px) 0;
  }
  .case-card-grid__hd {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: clamp(20px, 2.5vw, 32px);
    padding-bottom: 14px;
    border-bottom: 1px solid var(--hairline);
    flex-wrap: wrap;
    gap: 10px;
  }
  .case-card-grid__chapter {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .case-card-grid__dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    display: inline-block;
    transform: translateY(-2px);
  }
  .case-card-grid__num { color: var(--accent); font-weight: 500; }
  .case-card-grid__sep { color: var(--muted); }
  .case-card-grid__spec {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.1em;
  }
  .case-card-grid__h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2-section);
    line-height: var(--leading-h2);
    letter-spacing: -0.025em;
    max-width: 1080px;
    margin: 0 0 clamp(24px, 3vw, 40px);
    font-weight: 400;
    text-wrap: balance;
    color: var(--ink);
  }
  .case-card-grid__h2 :global(i) { font-style: italic; color: var(--accent); }
  .case-card-grid__row {
    display: grid;
    grid-template-columns: 90px 2fr 1.1fr 1.5fr 1.4fr 32px;
    gap: 24px;
    padding: clamp(28px, 3vw, 40px) 0;
    border-top: 1px solid var(--hairline);
    align-items: baseline;
    color: inherit;
    text-decoration: none;
    transition: background 200ms var(--ease), padding-left 320ms var(--ease), padding-right 320ms var(--ease);
  }
  .case-card-grid__row:hover {
    background: var(--paper-2);
    padding-left: 14px;
    padding-right: 14px;
  }
  .case-card-grid__row:hover .case-card-grid__arr {
    color: var(--accent);
    transform: translateX(4px) translateY(-2px);
  }
  .case-card-grid__row:hover .case-card-grid__client {
    color: var(--accent);
    transition: color 200ms var(--ease);
  }
  .case-card-grid__idx {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--muted);
    text-transform: uppercase;
  }
  .case-card-grid__client {
    font-family: var(--font-display);
    font-size: var(--text-h2-tight);
    line-height: var(--leading-h2);
    letter-spacing: -0.02em;
    font-weight: 400;
    font-style: italic;
    color: var(--ink);
  }
  .case-card-grid__col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .case-card-grid__col-k {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .case-card-grid__col-v {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.4;
  }
  .case-card-grid__impact {
    color: var(--ink);
    font-weight: 500;
    font-size: 15px;
  }
  .case-card-grid__arr {
    font-family: var(--font-mono);
    font-size: 18px;
    color: var(--muted);
    text-align: right;
    transition: color 240ms var(--ease), transform 320ms var(--ease);
  }
  .case-card-grid__foot {
    margin-top: clamp(40px, 4vw, 56px);
    text-align: right;
  }
  .case-card-grid__foot a {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 2px;
    text-decoration: none;
  }
  @media (max-width: 1100px) {
    .case-card-grid__row {
      grid-template-columns: 1fr 1fr;
      row-gap: 6px;
      padding: 24px 0;
    }
    .case-card-grid__idx { grid-column: 1 / -1; }
    .case-card-grid__client {
      grid-column: 1 / -1;
      font-size: 32px;
    }
    .case-card-grid__arr { display: none; }
  }
  @media (max-width: 600px) {
    .case-card-grid__row { grid-template-columns: 1fr; }
  }
</style>
