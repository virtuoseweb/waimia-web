---
// Section W6 · related-cards-band
// Bande de cards connexes : wrapper catalogue autour de `RelatedCards`.
import type { SectionByType } from '@waimia/ds-kernel';
import RelatedCards from '../ui/molecules/RelatedCards.astro';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'related-cards-band'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const cards = data.cards.map((c) => ({
  kicker: isFr ? c.kicker_fr : c.kicker_en,
  title_fr: c.title_fr,
  title_en: c.title_en,
  lead_fr: c.lead_fr,
  lead_en: c.lead_en,
  href: c.href,
}));
---

<section class="related-cards-band" data-bg={data.background} style={data.pad_block ? `--related-cards-band-pad:${data.pad_block}` : undefined}>
  <div class="wrap-wide">
    {(isFr ? data.kicker_fr : data.kicker_en) && (
      <Kicker as="span" class="related-cards-band__kicker">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
    )}
    <RelatedCards cards={cards} class="related-cards-band__grid reveal-stagger" />
  </div>
</section>

<style>
  .related-cards-band {
    /* Inset horizontal porté par le seul .wrap-wide interne (max-width + --gut),
       comme les sections voisines (problems-grid/deliverables-grid) : pas de
       padding-inline sur la section, sinon double inset → grille plus étroite et
       décalée que le reste du flux. Padding vertical conservé. */
    padding-block: var(--related-cards-band-pad, var(--section-loose));
  }
  /* Kicker canonisé (R4) · typo portée par l'atome Kicker, ici layout seul */
  :global(.related-cards-band__kicker) {
    display: block;
    margin-bottom: var(--space-6);
  }
  :global(.related-cards-band__grid .related-card) {
    border-top: 1px solid var(--hairline-strong);
    transition: background var(--dur-trim) var(--ease), transform var(--dur-hover) var(--ease);
  }
  :global(.related-cards-band__grid .related-card:hover) {
    background: var(--paper-2);
    transform: translateY(-2px);
  }

  /* ── Alternance des fonds R4 · defaut paper = rendu inchange ── */
  .related-cards-band[data-bg='paper-2'] { background: var(--paper-2); }
  .related-cards-band[data-bg='paper-3'] { background: var(--paper-3); }

  /* ── Idiome dark (ink) — fond sombre soigne, contraste AA ── */
  .related-cards-band[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .related-cards-band[data-bg='ink'] :global(.related-cards-band__kicker) { color: var(--paper); }
  .related-cards-band[data-bg='ink'] :global(.related-card) { border-top-color: var(--hairline-strong); }
  .related-cards-band[data-bg='ink'] :global(.related-card .related-title) { color: var(--paper); }
  .related-cards-band[data-bg='ink'] :global(.related-card .related-lead) { color: var(--muted); }
  .related-cards-band[data-bg='ink'] :global(.related-card .related-k),
  .related-cards-band[data-bg='ink'] :global(.related-card .related-go) { color: var(--accent-text); }
  .related-cards-band[data-bg='ink'] :global(.related-cards-band__grid .related-card:hover) {
    background: rgba(var(--paper-rgb), 0.05);
  }
</style>
