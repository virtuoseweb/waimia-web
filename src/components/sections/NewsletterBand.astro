---
// Section W6 · newsletter-band
// Bande newsletter fond sombre : titre éditorial (1.2fr) + formulaire email (1fr). Source : `hub-nl` (ressources/index.astro).
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'newsletter-band'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';

const placeholder = isFr ? (data.placeholder_fr ?? 'votre@email.com'): (data.placeholder_en ?? 'your@email.com');
const ctaLabel = isFr ? (data.cta_label_fr ?? "S'abonner →") : (data.cta_label_en ?? 'Subscribe →');
const hint = isFr ? data.hint_fr : data.hint_en;
---

<section class="newsletter-band" data-bg={data.background} aria-labelledby="newsletter-band-h2">
  <div class="newsletter-band__inner wrap-wide">
    <div class="newsletter-band__left reveal">
      {(data.kicker_fr || data.kicker_en) && (
        <Kicker as="p" tone="dim" class="newsletter-band__kicker">
          {isFr ? data.kicker_fr : data.kicker_en}
        </Kicker>
      )}
      <h2
        id="newsletter-band-h2"
        class="newsletter-band__h2"
        set:html={isFr ? data.h2_fr : data.h2_en}
      />
      {(data.lead_fr || data.lead_en) && (
        <p class="newsletter-band__lead">
          {isFr ? data.lead_fr : data.lead_en}
        </p>
      )}
    </div>

    <div class="newsletter-band__right reveal">
      <form
        class="newsletter-band__form"
        method="post"
        action={data.form_action ?? '#'}
      >
        <div class="newsletter-band__field">
          <label for="nl-email" class="sr-only">Email</label>
          <input
            id="nl-email"
            type="email"
            name="email"
            class="newsletter-band__input"
            placeholder={placeholder}
            required
            autocomplete="email"
          />
          <button type="submit" class="newsletter-band__btn">
            {ctaLabel}
          </button>
        </div>
        {hint && (
          <p class="newsletter-band__hint">{hint}</p>
        )}
      </form>
    </div>
  </div>
</section>

<style>
  .newsletter-band {
    background: var(--ink);
    color: var(--paper);
    padding: var(--section-loose) 0;
  }
  .newsletter-band__inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
  }
  /* Kicker canonisé (R4) · typo portée par l'atome (tone="dim" = rgba(paper,.5)) */
  :global(.newsletter-band__kicker) {
    margin: 0 0 var(--space-4);
  }
  .newsletter-band__h2 {
    font-family: var(--font-sans);
    font-size: clamp(36px, 5vw, 72px);
    line-height: 1.06;
    letter-spacing: -0.024em;
    font-weight: var(--fw-medium);
    color: var(--paper);
    margin: 0 0 var(--space-4);
    text-wrap: balance;
  }
  .newsletter-band__h2 :global(i) {
    font-style: italic;
    color: rgba(var(--paper-rgb), 0.7);
  }
  .newsletter-band__lead {
    font-family: var(--font-sans);
    font-size: var(--text-body-base);
    line-height: 1.55;
    color: rgba(var(--paper-rgb), 0.55);
    margin: 0;
    max-width: 400px;
  }
  .newsletter-band__field {
    display: flex;
    gap: 0;
    border: 1px solid rgba(var(--paper-rgb), 0.2);
  }
  .newsletter-band__input {
    flex: 1;
    min-width: 0;
    background: rgba(var(--paper-rgb), 0.08);
    border: none;
    padding: 14px 18px;
    font-family: var(--font-sans);
    font-size: var(--text-body-lead);
    color: var(--paper);
    outline: none;
  }
  .newsletter-band__input::placeholder {
    color: rgba(var(--paper-rgb), 0.35);
  }
  .newsletter-band__input:focus {
    background: rgba(var(--paper-rgb), 0.12);
  }
  .newsletter-band__btn {
    background: var(--accent);
    color: var(--paper);
    border: none;
    padding: 14px 22px;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    transition: background 240ms var(--ease);
  }
  .newsletter-band__btn:hover {
    background: color-mix(in srgb, var(--accent) 85%, black);
  }
  .newsletter-band__hint {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.08em;
    color: rgba(var(--paper-rgb), 0.35);
    margin: 10px 0 0;
  }
  /* ── data-bg R4 · defaut (absent) ET 'ink' = bande sombre inchangee.
     Variantes claires paper/paper-2/paper-3 : on reflechit la palette sur fond clair. ── */
  .newsletter-band[data-bg='paper'] { background: var(--paper); color: var(--ink); }
  .newsletter-band[data-bg='paper-2'] { background: var(--paper-2); color: var(--ink); }
  .newsletter-band[data-bg='paper-3'] { background: var(--paper-3); color: var(--ink); }
  .newsletter-band:is([data-bg='paper'], [data-bg='paper-2'], [data-bg='paper-3']) .newsletter-band__h2 { color: var(--ink); }
  .newsletter-band:is([data-bg='paper'], [data-bg='paper-2'], [data-bg='paper-3']) .newsletter-band__h2 :global(i) { font-family: var(--font-display); font-weight: var(--fw-regular); color: var(--accent); }
  .newsletter-band:is([data-bg='paper'], [data-bg='paper-2'], [data-bg='paper-3']) .newsletter-band__lead { color: var(--muted); }
  .newsletter-band:is([data-bg='paper'], [data-bg='paper-2'], [data-bg='paper-3']) .newsletter-band__field { border-color: var(--hairline-strong); }
  .newsletter-band:is([data-bg='paper'], [data-bg='paper-2'], [data-bg='paper-3']) .newsletter-band__input {
    background: var(--paper);
    color: var(--ink);
  }
  .newsletter-band:is([data-bg='paper'], [data-bg='paper-2'], [data-bg='paper-3']) .newsletter-band__input::placeholder { color: var(--muted); }
  .newsletter-band:is([data-bg='paper'], [data-bg='paper-2'], [data-bg='paper-3']) .newsletter-band__input:focus { background: var(--paper-2); }
  .newsletter-band:is([data-bg='paper'], [data-bg='paper-2'], [data-bg='paper-3']) .newsletter-band__hint { color: var(--muted); }

  @media (max-width: 860px) {
    .newsletter-band__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
