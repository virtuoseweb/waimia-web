---
// Section W6 · tech-positioning-split
// Prise de position éditoriale split 50/50 (statement manifesto + 3 facts mono kv).
// Source : TechnologiesDetailTemplate.astro « 2. POSITIONING SPLIT » + CSS .tech-pos-* (l.466-544).
// - CSS .tech-pos-* = COPIE VERBATIM des règles du template (mêmes tokens/valeurs).
// Réutilise Kicker (atome) + Callout variant=manifesto (editorial).
import Kicker from '../ui/atoms/Kicker.astro';
import Callout from '../editorial/Callout.astro';
import type { SectionByType } from '../../schemas/sections';
interface Props {
  data: SectionByType<'tech-positioning-split'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const facts = data.facts ?? [];
---
<section class="tech-sec tech-sec-paper tech-positioning reveal-stagger" data-bg={data.background} data-screen-label="02 Positioning">
  <div class="wrap">
    <div class="tech-pos-split">
      <div class="tech-pos-left">
        <Kicker>{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
        <h2 class="tech-pos-title u-serif-accent" set:html={isFr ? data.title_fr : data.title_en} />
        {(isFr ? data.aside_fr : data.aside_en) && (
          <p class="tech-aside">{isFr ? data.aside_fr : data.aside_en}</p>
        )}
      </div>
      <div class="tech-pos-right">
        <Callout variant="manifesto" size="lg">
          <div class="tech-pos-statement u-serif-accent-em" set:html={isFr ? data.statement_fr : data.statement_en} />
        </Callout>
        {facts.length > 0 && (
          <div class="tech-pos-facts">
            {facts.map((f) => (
              <div class="fact">
                <span class="fact-k">{f.k}</span>
                <span class="fact-v">{isFr ? f.v_fr : f.v_en}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  /* ───── Sec common (COPIE VERBATIM TechnologiesDetailTemplate.astro) ───── */
  .tech-sec { padding: var(--section-loose) 0; position: relative; }
  .tech-sec-paper { background: var(--paper-2); }
  .tech-aside {
    font-family: var(--font-display);
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: var(--leading-body);
    color: var(--muted);
    font-style: italic;
    max-width: 480px;
    margin: 0;
  }

  /* ───── Positioning Split (signature) — COPIE VERBATIM ───── */
  .tech-pos-split {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .tech-pos-right {
    position: relative;
    padding-left: clamp(24px, 3vw, 48px);
  }
  .tech-pos-right::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: var(--hairline-strong, rgba(var(--ink-rgb), 0.18));
  }
  .tech-pos-right :global(.callout) {
    margin-top: 0;
  }
  .tech-pos-title {
    font-family: var(--font-sans);
    font-size: clamp(36px, 5vw, 64px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    font-weight: var(--fw-medium);
    margin: var(--space-2) 0 var(--space-5);
  }
  .tech-pos-statement {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 32px);
    line-height: 1.32;
    letter-spacing: -0.012em;
    color: var(--ink);
    font-style: italic;
    margin-bottom: 0;
    text-wrap: balance;
  }
  .tech-pos-facts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid rgba(var(--ink-rgb), 0.1);
  }
  .tech-pos-facts .fact {
    display: grid;
    grid-template-columns: minmax(140px, 1fr) auto 2fr;
    gap: var(--space-4) var(--space-5);
    padding: 18px 0;
    border-bottom: 1px solid rgba(var(--ink-rgb), 0.1);
    align-items: baseline;
  }
  .tech-pos-facts .fact-k {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .tech-pos-facts .fact-v {
    font-family: var(--font-display);
    font-size: clamp(18px, 1.8vw, 22px);
    color: var(--accent);
    line-height: 1;
    font-weight: var(--fw-regular);
    white-space: nowrap;
  }

  .wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 48px);
  }

  @media (max-width: 900px) {
    .tech-pos-split { grid-template-columns: 1fr; }
    .tech-pos-right { padding-left: 0; padding-top: 28px; }
    .tech-pos-right::before {
      top: 0;
      bottom: auto;
      width: 100%;
      height: 1px;
    }
  }
  @media (max-width: 800px) {
    .tech-pos-facts .fact {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
  /* ── Alternance des fonds R4 · defaut paper-2 (clair) = rendu inchange ── */
  .tech-positioning[data-bg='paper'] { background: var(--paper); }
  .tech-positioning[data-bg='paper-3'] { background: var(--paper-3); }
  .tech-positioning[data-bg='ink'] {
    background: var(--ink);
  }
  .tech-positioning[data-bg='ink'] :is(.tech-pos-title, .tech-pos-statement) { color: var(--paper); }
  .tech-positioning[data-bg='ink'] .tech-aside { color: rgba(var(--paper-rgb), 0.64); }
  .tech-positioning[data-bg='ink'] .tech-pos-right::before { background: rgba(var(--paper-rgb), 0.28); }
  .tech-positioning[data-bg='ink'] .tech-pos-facts { border-top-color: rgba(var(--paper-rgb), 0.14); }
  .tech-positioning[data-bg='ink'] .tech-pos-facts .fact { border-bottom-color: rgba(var(--paper-rgb), 0.14); }
  .tech-positioning[data-bg='ink'] .tech-pos-facts .fact-k { color: rgba(var(--paper-rgb), 0.64); }
  /* Callout manifesto (enfant editorial) : ses bordures lisent --ink / --ink-2.
     Remap SUR le callout (descendant) -> bordures + corps clairs sans casser le fond section. */
  .tech-positioning[data-bg='ink'] :global(.callout) {
    --ink: var(--paper);
    --ink-2: rgba(var(--paper-rgb), 0.78);
  }
</style>
