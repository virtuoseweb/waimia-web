---
// FaqCtaAside · section CONVERSION · accordéon FAQ (gauche) + panneau CTA sticky (droite)
// Transforme une FAQ passive en capture lead : la réassurance + CTA reste visible
// pendant que l'utilisateur parcourt les réponses. Génère JSON-LD FAQPage (GEO/AIO).
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';
import Button from '../ui/atoms/Button.astro';
import JsonLd from '../seo/JsonLd.astro';
import { faqPage } from '../../lib/seo';

interface Props {
  data: SectionByType<'faq-cta-aside'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';

const items = data.items.map((it) => ({
  q: isFr ? it.q_fr : it.q_en,
  a: isFr ? it.a_fr : it.a_en,
}));
const heading = isFr ? data.h2_fr : data.h2_en;
const kicker = isFr ? data.kicker_fr : data.kicker_en;
const openFirst = data.open_first ?? false;

const asideTitle = isFr ? data.aside_title_fr : data.aside_title_en;
const asideBody = isFr ? data.aside_body_fr : data.aside_body_en;
const asideNote = isFr ? data.aside_note_fr : data.aside_note_en;
const ctaLabel = isFr ? data.aside_cta.label_fr : data.aside_cta.label_en;
---

<section class="faq-cta sec-base" data-bg={data.background}>
  <div class="wrap-wide faq-cta__grid">
    <div class="faq-cta__main">
      <div class="faq-cta__header">
        {kicker && <Kicker tone="muted">{kicker}</Kicker>}
        <h2 class="sec-base-h2" set:html={heading} />
      </div>
      <div class="faq-cta__list">
        {items.map((item, i) => (
          <details class="faq-cta__item" name="faq-cta" open={openFirst && i === 0}>
            <summary class="faq-cta__q">
              <Kicker as="span" tone="accent" size={10} class="faq-cta__q-label">
                Q.{String(i + 1).padStart(2, '0')}
              </Kicker>
              <span>{item.q}</span>
              <span class="faq-cta__arrow" aria-hidden="true">↓</span>
            </summary>
            <div class="faq-cta__a"><p>{item.a}</p></div>
          </details>
        ))}
      </div>
    </div>

    <aside class="faq-cta__aside">
      <div class="faq-cta__card reveal reveal-fade">
        <h3 class="faq-cta__card-title" set:html={asideTitle} />
        {asideBody && <p class="faq-cta__card-body">{asideBody}</p>}
        <Button
          href={data.aside_cta.href}
          variant={data.aside_cta.variant as any}
          size="lg"
          mag={data.aside_cta.mag ?? 0.16}
        >
          {ctaLabel}
        </Button>
        {asideNote && <p class="faq-cta__card-note">{asideNote}</p>}
      </div>
    </aside>
  </div>
</section>

<JsonLd data={faqPage(items)} />

<style>
  .faq-cta__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-10);
    align-items: start;
  }
  .faq-cta__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .faq-cta__item { border-top: 1px solid var(--hairline); }
  .faq-cta__item:last-child { border-bottom: 1px solid var(--hairline); }
  .faq-cta__q {
    list-style: none;
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-4);
    cursor: pointer;
    user-select: none;
  }
  .faq-cta__q::-webkit-details-marker { display: none; }
  .faq-cta__q-label { flex-shrink: 0; padding-top: 2px; line-height: 1; }
  .faq-cta__q span:not(.faq-cta__q-label):not(.faq-cta__arrow) {
    font-family: var(--font-display);
    font-size: var(--text-h3-card);
    color: var(--ink);
    line-height: 1.3;
    flex: 1;
  }
  .faq-cta__arrow {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    color: var(--muted);
    transition: transform 0.2s;
    flex-shrink: 0;
  }
  details[open] .faq-cta__arrow { transform: rotate(180deg); }
  .faq-cta__a { padding: 0 0 var(--space-5) 56px; }
  .faq-cta__a p {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    color: var(--muted);
    line-height: var(--leading-body);
    margin: 0;
    max-width: 56ch;
  }

  .faq-cta__aside { position: sticky; top: var(--space-8); }
  .faq-cta__card {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-base);
    padding: var(--space-7);
    background: var(--paper);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .faq-cta__card-title {
    font-family: var(--font-sans);
    font-style: italic;
    font-size: var(--text-h3-row);
    color: var(--ink);
    line-height: var(--leading-h3);
    margin: 0;
    font-weight: var(--fw-medium);
  }
  .faq-cta__card-body {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--muted);
    line-height: var(--leading-body);
    margin: 0;
    text-wrap: pretty;
  }
  .faq-cta__card-note {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    color: var(--muted);
    letter-spacing: 0.06em;
    margin: 0;
  }

  /* Alternance de fonds */
  .faq-cta[data-bg='paper-2'] { background: var(--paper-2); }
  .faq-cta[data-bg='paper-3'] { background: var(--paper-3); }
  .faq-cta[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .faq-cta[data-bg='ink'] :is(h2, h3, p) { color: var(--paper); }
  .faq-cta[data-bg='ink'] .faq-cta__card { background: rgba(var(--paper-rgb), 0.04); }

  @media (max-width: 900px) {
    .faq-cta__grid { grid-template-columns: 1fr; gap: var(--space-8); }
    .faq-cta__aside { position: static; }
  }
</style>
