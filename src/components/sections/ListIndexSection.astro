---
// Section catalogue · list-index-section
// Extraction du masthead + conteneur liste de ListIndexTemplate.astro.
import type { SectionByType } from '@waimia/ds-kernel';
import { langFromPath } from '../../lib/i18n';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data?: SectionByType<'list-index-section'>;
  lang?: 'fr' | 'en';
  title?: string;
  description?: string;
  kicker?: string;
}

const {
  data,
  lang = langFromPath(Astro.url.pathname),
  title,
  description,
  kicker,
} = Astro.props as Props;

const isFr = lang === 'fr';
const finalTitle = title ?? (isFr ? data?.h1_fr : data?.h1_en) ?? '';
const finalDescription = description ?? (isFr ? data?.lede_fr : data?.lede_en) ?? '';
const finalKicker = kicker ?? (isFr ? data?.kicker_fr : data?.kicker_en) ?? '';
const filtersHtml = isFr ? data?.filters_html_fr : data?.filters_html_en;
const listHtml = isFr ? data?.list_html_fr : data?.list_html_en;
const hasFilters = Astro.slots.has('filters') || Boolean(filtersHtml);
---

<section class="list-hd" data-bg={data?.background}>
  <div class="wrap-wide">
    <Kicker class="list-kicker">{finalKicker}</Kicker>
    <h1 class="list-h1 reveal-mask-up u-serif-accent">
      {Astro.slots.has('headline') ? <slot name="headline" /> : <Fragment set:html={finalTitle} />}
    </h1>
    <p class="list-lede">
      {Astro.slots.has('lede') ? <slot name="lede" /> : <Fragment set:html={finalDescription} />}
    </p>

    {hasFilters && (
      <div class="list-filters">
        {Astro.slots.has('filters') ? <slot name="filters" /> : <Fragment set:html={filtersHtml ?? ''} />}
      </div>
    )}
  </div>
</section>

<section class="list-body">
  <div class="wrap-wide">
    {Astro.slots.has('list') ? <slot name="list" /> : <Fragment set:html={listHtml ?? ''} />}
  </div>
</section>

{(Astro.slots.has('footer') || data?.footer_html_fr || data?.footer_html_en) && (
  <footer class="list-footer">
    {Astro.slots.has('footer') ? <slot name="footer" /> : <Fragment set:html={(isFr ? data?.footer_html_fr : data?.footer_html_en) ?? ''} />}
  </footer>
)}

<style>
  .list-hd {
    padding: calc(var(--header-height) + var(--space-8)) var(--space-6) var(--space-9);
    border-bottom: 1px solid var(--hairline);
  }
  :global(.list-kicker) { display: block; margin-bottom: var(--space-5); }
  .list-h1 {
    font-family: var(--font-sans);
    font-size: var(--text-display);
    line-height: 0.92;
    letter-spacing: -0.015em;
    font-weight: var(--fw-semibold);
    text-wrap: balance;
    margin: 0;
  }
  .list-lede {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    color: var(--ink-2);
    margin: var(--space-6) 0 0;
    max-width: 760px;
    line-height: var(--leading-lede);
    text-wrap: pretty;
  }
  .list-filters {
    margin-top: var(--space-9);
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .list-body { padding: var(--section-loose) var(--space-6); }
  .list-body :global(.demo-list-row) {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--hairline);
  }
  .list-body :global(.demo-list-row span) {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--muted);
    flex: 0 0 auto;
  }
  .list-body :global(.demo-list-row strong) {
    font-weight: var(--fw-medium);
    color: var(--ink);
  }
  .list-body :global(.demo-list-row em) {
    margin-left: auto;
    font-style: italic;
    color: var(--ink-2);
  }
  .list-footer { border-top: 1px solid var(--hairline); }

  /* ── Axe déclinaison #118 : fond du masthead (défaut ABSENT = paper, rendu inchangé).
     paper-2/paper-3 = bande d'en-tête teintée ; ink = masthead sur encre (textes en paper).
     Le corps de liste + footer restent inchangés (l'axe ne cible que la bande d'en-tête). ── */
  .list-hd[data-bg='paper-2'] { background: var(--paper-2); }
  .list-hd[data-bg='paper-3'] { background: var(--paper-3); }
  .list-hd[data-bg='ink'] {
    background: var(--ink);
    border-bottom-color: rgba(var(--paper-rgb), 0.14);
  }
  .list-hd[data-bg='ink'] .list-h1 { color: var(--paper); }
  .list-hd[data-bg='ink'] .list-lede { color: rgba(var(--paper-rgb), 0.72); }
  .list-hd[data-bg='ink'] :global(.list-kicker) { color: rgba(var(--paper-rgb), 0.7); }
</style>
