---
// Section catalogue · why-stalls
// COPIE FIDÈLE de `src/components/ui/organisms/WhyAIStalls.astro`
// Sticky chapter label gauche + 4 FIG rows row-lines droite.
import type { SectionByType } from '../../schemas/sections';
import ChapterLabel from '../ui/atoms/ChapterLabel.astro';

interface Props {
  data: SectionByType<'why-stalls'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---
<section class="why-stalls" aria-labelledby="why-stalls-h2">
  <div class="wrap-wide">
    <div class="why-stalls__grid">
      <aside class="why-stalls__aside">
        <ChapterLabel num={data.chapter_num} title={isFr ? data.chapter_title_fr : data.chapter_title_en} />
        <h2 id="why-stalls-h2" class="why-stalls__h2" set:html={isFr ? data.h2_fr : data.h2_en} />
        <p class="why-stalls__lead">{isFr ? data.aside_lead_fr : data.aside_lead_en}</p>
      </aside>
      <div class="why-stalls__rows row-lines">
        {data.rows.map((r, i) => (
          <article class="why-stalls__row" data-first={i === 0 ? 'true' : 'false'}>
            <span class="why-stalls__fig">{r.fig}</span>
            <p class="why-stalls__row-text">{isFr ? r.text_fr : r.text_en}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .wrap-wide { max-width: 1200px; margin-inline: auto; padding-inline: clamp(20px, 4vw, 48px); }
  .why-stalls { padding: clamp(120px,16vw,200px) 0 clamp(80px,10vw,140px); border-bottom: none; }
  .why-stalls__grid { display: grid; grid-template-columns: 280px 1fr; gap: clamp(40px,6vw,80px); }
  .why-stalls__aside { position: sticky; top: 120px; align-self: start; }
  .why-stalls__h2 {
    font-family: var(--font-display);
    font-size: clamp(36px,4vw,56px);
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: var(--fw-regular);
    margin-top: 22px;
  }
  .why-stalls__h2 :global(i) { font-style: italic; color: var(--accent); }
  .why-stalls__h2 :global(span) { display: block; }
  .why-stalls__lead {
    margin-top: 20px;
    font-size: var(--text-ui);
    color: var(--muted);
    max-width: 240px;
    line-height: var(--leading-body);
  }
  .why-stalls__row {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: clamp(24px,3vw,40px);
    padding: clamp(28px,3vw,40px) 0;
    border-bottom: 1px solid var(--hairline);
  }
  .why-stalls__row[data-first="true"] { border-top: 1px solid var(--ink); }
  .why-stalls__fig {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--ink);
    padding-top: 6px;
  }
  .why-stalls__row-text {
    font-family: var(--font-display);
    font-size: clamp(22px,2.4vw,30px);
    line-height: 1.18;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  @media (max-width: 900px) {
    .why-stalls__grid { grid-template-columns: 1fr; gap: var(--space-8); }
    .why-stalls__aside { position: static; }
    .why-stalls__row { grid-template-columns: 1fr; gap: var(--space-2); padding: var(--space-5) 0; }
  }
</style>
