---
// footer-cta-band (cta-sections) — bande CTA finale pleine largeur, climax avant footer.
// Dark natif (ink par défaut). Contenu aligné à gauche dans wrap-wide, boutons à droite en desktop.
import type { SectionByType } from '@waimia/ds-kernel';
import Kicker from '../ui/atoms/Kicker.astro';
import Button from '../ui/atoms/Button.astro';

interface Props {
  data: SectionByType<'footer-cta-band'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const buttons = data.buttons ?? [];

// Kicker / subtitle : la variante *_html (set:html) prime sur le plaintext quand fournie.
// Absente → rendu plaintext historique inchangé (rétro-compat).
const kickerHtml = isFr ? data.kicker_html_fr : data.kicker_html_en;
const kickerText = isFr ? data.kicker_fr : data.kicker_en;
const subtitleHtml = isFr ? data.subtitle_html_fr : data.subtitle_html_en;
const subtitleText = isFr ? data.subtitle_fr : data.subtitle_en;

// ── Couche atomique (Vague C) : placement par région. Résolution raccourci↔placement
// (0 double source) : la valeur effective est calculée UNE fois, le composant pose UN
// seul data-attr par région. `placement.header.align` surcharge `contentAlign` ;
// `placement.actions.justify` surcharge `actionsAlign`. Défaut absent = rendu actuel.
const pl = data.placement;
const headerAlign = pl?.header?.align ?? data.contentAlign; // start (défaut CSS) si absent
// actionsAlign (raccourci) utilise 'spread' ; placement.actions.justify utilise 'between' :
// on normalise vers le vocabulaire `justify` (between) posé en data-actions-justify.
const actionsJustify =
  pl?.actions?.justify ?? (data.actionsAlign === 'spread' ? 'between' : data.actionsAlign);
const headerOrder = pl?.header?.order;
const actionsOrder = pl?.actions?.order;
const headerHide = pl?.header?.hideOn;
const actionsHide = pl?.actions?.hideOn;
---

<section
  class={`footer-cta${data.rounded ? ' footer-cta--rounded' : ''}`}
  data-bg={data.background}
  data-layout={data.layout}
  data-density={data.density}
  data-texture={data.texture}
  data-actions-placed={actionsJustify ? 'true' : undefined}
>
  {data.texture === 'signature-grid' && (
    <div class:list={['signature-grid', { 'on-dark': data.background === 'ink' }]} aria-hidden="true"></div>
  )}
  <div class="wrap-wide footer-cta__inner">
    <div
      class="footer-cta__copy"
      data-header-align={headerAlign}
      data-header-order={headerOrder}
      data-header-hide={headerHide}
    >
      {kickerHtml
        ? <Kicker tone="muted"><Fragment set:html={kickerHtml} /></Kicker>
        : (kickerText && <Kicker tone="muted">{kickerText}</Kicker>)}
      <h2 class="u-serif-accent" set:html={isFr ? data.h2_fr : data.h2_en} />
      {subtitleHtml
        ? <p class="footer-cta__subtitle" set:html={subtitleHtml} />
        : (subtitleText && <p class="footer-cta__subtitle">{subtitleText}</p>)}
    </div>
    <div
      class="footer-cta__actions"
      data-actions-justify={actionsJustify}
      data-actions-order={actionsOrder}
      data-actions-hide={actionsHide}
    >
      {buttons.map((b: (typeof buttons)[number]) => (
        <Button href={b.href} variant={b.variant} size="lg">
          {isFr ? b.label_fr : b.label_en}
        </Button>
      ))}
    </div>
  </div>
</section>

<style>
  .footer-cta {
    padding-block: var(--section-grand);
    border-block: 1px solid var(--hairline);
  }
  .footer-cta--rounded {
    border-radius: var(--radius-band) var(--radius-band) 0 0;
  }
  /* ── Décor TEXTURE (data-texture='signature-grid') · optionnel · absent = rendu actuel.
     La grille est absolue (inset:0), le contenu passe au-dessus. Scopé à la texture pour
     ne rien changer aux instances sans décor. ── */
  .footer-cta[data-texture='signature-grid'] { position: relative; }
  .footer-cta[data-texture='signature-grid'] > .footer-cta__inner { position: relative; z-index: 1; }
  .footer-cta[data-texture='signature-grid'] > .signature-grid { z-index: 0; }
  .footer-cta__inner {
    display: grid;
    grid-template-columns: 1.5fr auto;
    gap: clamp(var(--space-6), 5vw, var(--space-10));
    align-items: center;
  }
  .footer-cta__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  h2 {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-h1);
    line-height: var(--leading-h2);
    color: var(--ink);
    margin: 0;
    max-width: 22ch;
  }
  .footer-cta__subtitle {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--muted);
    line-height: var(--leading-lede);
    max-width: 52ch;
    margin: 0;
  }
  .footer-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }
  /* ── Axe LAYOUT (data-layout) : 'inline' (CTA à côté du titre, défaut historique
     1.5fr auto) | 'stacked' (CTA sous le bloc copy, 1 colonne). ── */
  .footer-cta[data-layout='stacked'] .footer-cta__inner {
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: start;
  }

  /* ── COUCHE ATOMIQUE (Vague C) · placement par région · UN SEUL data-attr par région.
     `data-header-align` (région header/copy) résout `placement.header.align ?? contentAlign`.
     `data-actions-justify` (région actions) résout `placement.actions.justify ?? actionsAlign`,
     INDÉPENDANT du header (le cas d'école « bouton au centre sans décaler le titre »). ── */

  /* Région HEADER : alignement du bloc copy (align-self + text-align). Défaut = start. */
  .footer-cta__copy[data-header-align='center'] { align-items: center; text-align: center; }
  .footer-cta__copy[data-header-align='center'] :is(h2, .footer-cta__subtitle) { max-width: none; margin-inline: auto; }
  .footer-cta__copy[data-header-align='end'] { align-items: flex-end; text-align: end; }

  /* Région ACTIONS : justify-content du cluster CTA (between = space-between). On élargit la
     cellule actions à 1fr UNIQUEMENT quand l'axe est posé (sinon `auto` = rendu actuel),
     pour que justify-content ait de l'espace. */
  .footer-cta[data-actions-placed] .footer-cta__inner { grid-template-columns: 1.5fr 1fr; }
  .footer-cta[data-layout='stacked'][data-actions-placed] .footer-cta__inner { grid-template-columns: 1fr; }
  .footer-cta__actions[data-actions-justify='start'] { justify-content: flex-start; }
  .footer-cta__actions[data-actions-justify='center'] { justify-content: center; }
  .footer-cta__actions[data-actions-justify='end'] { justify-content: flex-end; }
  .footer-cta__actions[data-actions-justify='between'] { justify-content: space-between; }

  /* Région HEADER/ACTIONS · ORDER (réordonner copy↔actions dans la grille). order = structurel.
     2 régions dans cette section → 0 (en tête) ou 1 (en pied) suffisent pour inverser. */
  .footer-cta__copy[data-header-order='0'] { order: 0; }
  .footer-cta__copy[data-header-order='1'] { order: 1; }
  .footer-cta__actions[data-actions-order='0'] { order: 0; }
  .footer-cta__actions[data-actions-order='1'] { order: 1; }

  /* Région HEADER/ACTIONS · HIDE-ON (visibilité responsive). 768px = breakpoint structurel. */
  .footer-cta__copy[data-header-hide='desktop'],
  .footer-cta__actions[data-actions-hide='desktop'] { display: none; }
  @media (max-width: 768px) {
    .footer-cta__copy[data-header-hide='mobile'],
    .footer-cta__actions[data-actions-hide='mobile'] { display: none; }
    .footer-cta__copy[data-header-hide='desktop'] { display: flex; }
    .footer-cta__actions[data-actions-hide='desktop'] { display: flex; }
  }

  /* ── Axe DENSITY (data-density) : rythme padding-block + gap. Tokens --space-* seulement. ── */
  .footer-cta[data-density='compact'] { padding-block: var(--space-8); }
  .footer-cta[data-density='compact'] .footer-cta__copy { gap: var(--space-3); }
  .footer-cta[data-density='base'] { padding-block: var(--space-10); }
  .footer-cta[data-density='ample'] { padding-block: var(--space-12); }
  .footer-cta[data-density='ample'] .footer-cta__copy { gap: var(--space-5); }

  @media (max-width: 860px) {
    .footer-cta__inner,
    .footer-cta[data-actions-placed] .footer-cta__inner { grid-template-columns: 1fr; gap: var(--space-7); }
    .footer-cta__actions { justify-content: flex-start; }
    /* actions-justify reste honoré en mobile (1 colonne pleine largeur). */
    .footer-cta__actions[data-actions-justify='center'] { justify-content: center; }
    .footer-cta__actions[data-actions-justify='end'] { justify-content: flex-end; }
    .footer-cta__actions[data-actions-justify='between'] { justify-content: space-between; }
    /* Ordre de lecture logique : copy puis actions (on annule un order custom desktop). */
    .footer-cta__copy[data-header-order='1'],
    .footer-cta__actions[data-actions-order='0'] { order: 0; }
  }
  /* ── Dark natif (docs/43) · ink par défaut · remap scopé aux enfants ── */
  .footer-cta[data-bg='paper-2'] { background: var(--paper-2); }
  .footer-cta[data-bg='paper-3'] { background: var(--paper-3); }
  .footer-cta[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
    --muted: rgba(var(--paper-rgb), 0.66);
  }
  .footer-cta[data-bg='ink'] :is(h2) { color: var(--paper); }
</style>
