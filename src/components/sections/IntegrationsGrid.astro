---
// integrations-grid (logo-sections) — grille de logos d'intégrations groupés par catégorie.
// Dark natif (data-bg). Chaque groupe : titre mono + grille de cellules logo alignées à gauche.
import type { SectionByType } from '@waimia/ds-kernel';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'integrations-grid'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const groups = data.groups ?? [];
---

<section class="integrations sec-base" data-bg={data.background}>
  <div class="wrap-wide">
    <div class="integrations__header">
      {(isFr ? data.kicker_fr : data.kicker_en) && (
        <Kicker tone="muted">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      )}
      <h2 class="sec-base-h2" set:html={isFr ? data.h2_fr : data.h2_en} />
      {(isFr ? data.lede_fr : data.lede_en) && (
        <p class="integrations__lede">{isFr ? data.lede_fr : data.lede_en}</p>
      )}
    </div>

    <div class="integrations__groups">
      {groups.map((g: (typeof groups)[number]) => (
        <div class="integrations__group">
          <span class="integrations__group-title">{isFr ? g.group_fr : g.group_en}</span>
          <ul class="integrations__list">
            {g.items.map((it: (typeof g.items)[number]) => (
              <li class="integrations__item">
                {it.href ? (
                  <a class="integrations__cell" href={it.href}>
                    {it.logo_src ? <img src={it.logo_src} alt={it.name} loading="lazy" /> : <span>{it.name}</span>}
                    <span class="integrations__name">{it.name}</span>
                  </a>
                ) : (
                  <span class="integrations__cell">
                    {it.logo_src ? <img src={it.logo_src} alt={it.name} loading="lazy" /> : <span>{it.name}</span>}
                    <span class="integrations__name">{it.name}</span>
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .integrations__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--spacing-block);
  }
  .integrations__lede {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--muted);
    line-height: var(--leading-lede);
    max-width: 60ch;
    margin: 0;
  }
  .integrations__groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .integrations__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .integrations__group-title {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .integrations__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-3);
  }
  .integrations__cell {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xs);
    background: var(--paper);
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
    height: 100%;
  }
  a.integrations__cell:hover {
    border-color: var(--accent-text);
    transform: translateY(-2px);
  }
  .integrations__cell img {
    height: 24px;
    width: auto;
    object-fit: contain;
    display: block;
  }
  .integrations__name {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--ink);
    line-height: 1.2;
  }
  @media (max-width: 600px) {
    .integrations__list { grid-template-columns: 1fr; }
  }
  /* ── Dark natif (docs/43) · remap scopé aux enfants, JAMAIS --ink:var(--paper) sur la racine ── */
  .integrations[data-bg='paper-2'] { background: var(--paper-2); }
  .integrations[data-bg='paper-3'] { background: var(--paper-3); }
  .integrations[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .integrations[data-bg='ink'] :is(h2) { color: var(--paper); }
  .integrations[data-bg='ink'] .integrations__cell {
    background: rgba(var(--paper-rgb), 0.05);
  }
  .integrations[data-bg='ink'] .integrations__name { color: var(--paper); }
</style>
