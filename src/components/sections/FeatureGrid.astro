---
// ARCHÉTYPE R5b · « grille régulière de cards » — 1 composant paramétrable → 5 type-ids (presets).
// Grille N colonnes de cards titre+texte+icône/numéro. Branche sur `data.type` ; chaque
// variante conserve markup + CSS BYTE-IDENTIQUES à son composant d'origine. Seuls
// ajustements CSS = qualifications de scope `:where(.racine)` (spécificité inchangée)
// rendues nécessaires par la colocalisation — résultat visuel inchangé.
// Absorbe (R5b) : problems-grid (cards numérotées auto-fit), deliverables-grid
// (cards counter + tag), commitments-grid (cells bordées), icon-trio (3 colonnes
// centrées glyph). Noyau : feature-grid (data-cols 2/3/4).
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

// Line-art DS (Registre A) inliné au build : le SVG vit dans le DOM de la page →
// `stroke="currentColor"` suit la couleur de texte du contexte (encre sur paper,
// crème sur ink) et `var(--accent)` résout le vrai token DS (un <img> n'hérite
// ni de currentColor ni des custom properties). Source = src/assets/line-art/*.svg
// (copie importable des fichiers public/images/line-art/*.svg). Clé = basename.
const lineArtRaw = import.meta.glob<string>('../../assets/line-art/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const lineArt: Record<string, string> = {};
for (const [path, svg] of Object.entries(lineArtRaw)) {
  lineArt[path.split('/').pop()!] = svg;
}
const inlineLineArt = (src?: string): string | undefined =>
  src ? lineArt[src.split('/').pop()!] : undefined;

interface Props {
  data:
    | SectionByType<'feature-grid'>
    | SectionByType<'problems-grid'>
    | SectionByType<'deliverables-grid'>
    | SectionByType<'commitments-grid'>
    | SectionByType<'icon-trio'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';

// ── feature-grid · WITNESS de la migration sur le moteur de layout v2 ──────────────
// Le composant CONSOMME le moteur (section-layouts.css) : classes .sec-collection /
// .sec-grid / .sec-item + data-attrs (noms canoniques du CSS, source de vérité). Défaut
// (aucune prop de variation) = rendu actuel (grille hairline 3 colonnes). Chaque prop du
// mixin n'est posée en data-attr QUE si elle est définie (sinon rien → défaut moteur).
const fg = data.type === 'feature-grid' ? data : undefined;
const fgCols = fg ? (fg.columns ?? '3') : '3';
// Mode moteur : si une recette `layout` du lexique est demandée, on pilote la grille par
// le moteur (data-layout) ; sinon on garde la grille hairline bespoke (data-cols).
const fgLayout = fg?.layout;
// Raccourci contentAlign (sucre) → justify-content effectif de la grille (1 seul data-attr).
const fgJustify = fg?.justifyContent
  ?? (fg?.contentAlign === 'center' ? 'center' : fg?.contentAlign === 'end' ? 'end' : undefined);
// Heading de carte : h2/h3 (défaut historique = <strong>, conservé si non précisé).
const FgCardTag = (fg?.headingLevel ?? 'strong') as 'h2' | 'h3' | 'strong';

// ── Couche atomique (Batch 2) · deliverables-grid. Résolution raccourci↔placement :
// valeur effective calculée UNE fois, UN seul data-attr par région. `placement.header.align`
// surcharge `contentAlign`. Défaut absent = rendu actuel.
const dgPl = data.type === 'deliverables-grid' ? data.placement : undefined;
const dgHeaderAlign = dgPl?.header?.align ?? (data.type === 'deliverables-grid' ? data.contentAlign : undefined);
const dgHeaderOrder = dgPl?.header?.order;
const dgHeaderHide = dgPl?.header?.hideOn;
const dgBodyOrder = dgPl?.body?.order;
const dgBodyHide = dgPl?.body?.hideOn;
const dgBodyJustify = dgPl?.body?.justify;
// deliverables-grid et problems-grid : la recomposition selon le nombre de cartes
// (anti-orpheline) est désormais portée par du CSS structurel scopé (`:has(> :nth-child)`)
// au lieu d'un calcul JS couplé à `data.*.length`. Voir les blocs `.problems-grid__cards`
// et `.deliverables-grid__grid` ci-dessous. Aucune custom property de colonnes injectée.
---

{data.type === 'problems-grid' ? (
  <section class="problems-grid wrap-wide reveal-blur-clip" data-bg={data.background}>
    <h2 class="problems-grid__h2 reveal" set:html={isFr ? data.h2_fr : data.h2_en} />
    <div class="problems-grid__cards">
      {data.problems.map((p, i) => {
        const art = inlineLineArt(p.illustration_src);
        const alt = isFr ? p.illustration_alt_fr : p.illustration_alt_en;
        return (
        <div class="problems-grid__card">
          {art && (
            <div class="problems-grid__art" set:html={art} role={alt ? 'img' : undefined} aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'} />
          )}
          <div class="problems-grid__num">{p.num ?? String(i + 1).padStart(2, '0')}</div>
          <Kicker tone="accent" letterSpacing=".08em" class="problems-grid__kicker">{isFr ? p.kicker_fr : p.kicker_en}</Kicker>
          <h3 set:html={isFr ? p.title_fr : p.title_en} />
          <p>{isFr ? p.body_fr : p.body_en}</p>
        </div>
        );
      })}
    </div>
  </section>
) : data.type === 'deliverables-grid' ? (
  <section
    class="deliverables-grid"
    data-bg={data.background}
    data-density={data.density}
    data-content-align={data.contentAlign}
    data-layout={data.layout}
  >
    <div class="wrap-wide">
      <header
        class="deliverables-grid__hd"
        data-header-align={dgHeaderAlign}
        data-header-order={dgHeaderOrder}
        data-header-hide={dgHeaderHide}
      >
        <Kicker as="span" tone="accent" class="deliverables-grid__kicker">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
        <h2 class="deliverables-grid__title" set:html={isFr ? data.title_fr : data.title_en} />
        {(isFr ? data.lead_fr : data.lead_en) && (
          <p class="deliverables-grid__lead" set:html={isFr ? data.lead_fr : data.lead_en} />
        )}
      </header>

      <div
        class="deliverables-grid__grid reveal-stagger"
        data-columns={data.columns ?? 'auto'}
        data-col-ratio={data.layout === 'grid-asym' ? (data.colRatio ?? 'equal') : undefined}
        data-item-height={data.itemHeight}
        data-body-order={dgBodyOrder}
        data-body-hide={dgBodyHide}
        data-body-justify={dgBodyJustify}
      >
        {data.items.map((item) => {
          const format = isFr ? item.format_fr : item.format_en;
          const duration = isFr ? item.duration_fr : item.duration_en;
          const tag = [format, duration].filter(Boolean).join(' · ');
          const art = inlineLineArt(item.illustration_src);
          const alt = isFr ? item.illustration_alt_fr : item.illustration_alt_en;

          return (
            <article class="deliverables-grid__card reveal-zoom-in">
              {art && (
                <div class="deliverables-grid__art" set:html={art} role={alt ? 'img' : undefined} aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'} />
              )}
              {tag && <span class="deliverables-grid__tag">{tag}</span>}
              <h3 set:html={isFr ? item.title_fr : item.title_en} />
              <p set:html={isFr ? item.body_fr : item.body_en} />
            </article>
          );
        })}
      </div>
    </div>
  </section>
) : data.type === 'commitments-grid' ? (
  <section class="commitments-grid" data-bg={data.background} aria-labelledby="commitments-grid-h2">
    <div class="wrap-wide">
      {(data.kicker_fr || data.kicker_en) && (
        <Kicker as="p" tone="accent" class="commitments-grid__kicker">
          {isFr ? data.kicker_fr : data.kicker_en}
        </Kicker>
      )}
      <h2 id="commitments-grid-h2" class="commitments-grid__h2 reveal" set:html={isFr ? data.h2_fr : data.h2_en} />
      {(data.body_fr || data.body_en) && (
        <p class="commitments-grid__body">
          {isFr ? data.body_fr : data.body_en}
        </p>
      )}

      <div class="commitments-grid__grid reveal-stagger">
        {data.commitments.map((c) => (
          <div class="commitments-grid__cell">
            <h3 class="commitments-grid__cell-title" set:html={isFr ? c.title_fr : c.title_en} />
            <p class="commitments-grid__cell-body">{isFr ? c.body_fr : c.body_en}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
) : data.type === 'icon-trio' ? (
  <section class="icon-trio sec-base" data-bg={data.background}>
    <div class="wrap-wide">
      {(isFr ? data.kicker_fr : data.kicker_en) && (
        <Kicker tone="muted">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      )}
      {(isFr ? data.h2_fr : data.h2_en) && (
        <h2 set:html={isFr ? data.h2_fr : data.h2_en} />
      )}
      <ul class="icon-trio__cols reveal-stagger">
        {data.items.map((item: (typeof data.items)[number]) => (
          <li class="icon-trio__col">
            {item.glyph && (
              <span class="icon-trio__glyph" aria-hidden="true">{item.glyph}</span>
            )}
            <strong class="icon-trio__title">{isFr ? item.title_fr : item.title_en}</strong>
            <p class="icon-trio__body">{isFr ? item.body_fr : item.body_en}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
) : (
  <section
    class="feature-grid sec-base sec-collection"
    data-bg={fg!.background}
    data-layout={fgLayout}
    data-density={fg!.density}
    data-content-align={fg!.contentAlign}
  >
    <div class="wrap-wide">
    <div class="feature-grid__header">
      {(isFr ? fg!.kicker_fr : fg!.kicker_en) && (
        <Kicker tone="muted">{isFr ? fg!.kicker_fr : fg!.kicker_en}</Kicker>
      )}
      <h2 class="sec-base-h2" set:html={isFr ? fg!.h2_fr : fg!.h2_en} />
    </div>
    <ul
      class="feature-grid__list sec-grid"
      data-cols={fgLayout ? undefined : fgCols}
      data-columns={fg!.columns}
      data-hover={fg!.hover}
      data-justify-content={fgJustify}
      data-align-items={fg!.alignItems}
      data-item-height={fg!.itemHeight}
      data-col-ratio={fgLayout === 'grid-asym' ? fg!.colRatio : undefined}
    >
      {fg!.features.map((f) => {
        const cta = f.cta_href ? { label: isFr ? f.cta_label_fr : f.cta_label_en, href: f.cta_href } : undefined;
        return (
        <li
          class="feature-grid__item sec-item"
          data-cell-bg={f.bg ?? fg!.cellBg}
          data-tone={f.tone ?? fg!.tone}
          data-cell-tone={fg!.cellTone}
          data-cell-x={fg!.cellAlignX}
          data-cell-y={f.cellAlignY ?? fg!.cellAlignY}
          data-cell-pad={fg!.cellPad}
          data-col-span={f.colSpan}
          data-focus-ring={fg!.focusRing}
        >
          {f.icon && (
            <Kicker tone="accent" size={10} class="feature-grid__icon">▸ {f.icon}</Kicker>
          )}
          <FgCardTag class="feature-grid__title sec-item__title" set:html={isFr ? f.title_fr : f.title_en} />
          <p data-clamp={fg!.clamp} data-measure={fg!.measure}>{isFr ? f.body_fr : f.body_en}</p>
          {cta && (
            <div class="feature-grid__cta sec-item__cta">
              <a class="btn btn-ghost" href={cta.href}>{cta.label} <span aria-hidden="true">→</span></a>
            </div>
          )}
        </li>
        );
      })}
    </ul>
    </div>
  </section>
)}

<style>
  .feature-grid__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--spacing-block);
  }
  /* ── MODE PAR DÉFAUT (aucune recette `layout`) = grille hairline 3 colonnes, rendu
     historique INCHANGÉ. La grille (.feature-grid__list[data-cols]) et le look hairline
     (bordure + chevauchement -1px, gap 0) sont SPÉCIFIQUES à ce composant : le moteur ne
     reproduit pas la fusion de bordures, on les garde donc ici, scopés au mode défaut
     (sélecteur `:not([data-layout])` sur la section). Quand une recette `layout` est posée,
     c'est le moteur (.sec-collection[data-layout] .sec-grid) qui porte la grille (gap +
     colonnes) : on ne duplique RIEN. ── */
  .feature-grid:not([data-layout]) .feature-grid__list {
    gap: 0; /* annule le gap du moteur (.sec-grid) : le look hairline repose sur margin -1px */
  }
  .feature-grid__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .feature-grid__list[data-cols="2"] { grid-template-columns: repeat(2, 1fr); }
  .feature-grid__list[data-cols="3"] { grid-template-columns: repeat(3, 1fr); }
  .feature-grid__list[data-cols="4"] { grid-template-columns: repeat(4, 1fr); }
  /* Item du mode hairline : bordure + chevauchement -1px. En mode `layout`, le moteur
     fournit la grille/gap ; la carte garde sa pile flex + son padding (skin du composant). */
  .feature-grid__item {
    padding: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .feature-grid:not([data-layout]) .feature-grid__item {
    border: 1px solid var(--hairline);
    margin: -1px -1px 0 0;
  }
  .feature-grid__icon { margin-bottom: var(--space-1); }
  .feature-grid__title {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: var(--fw-medium);
    color: var(--ink);
    line-height: 1.2;
  }
  .feature-grid__item p {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }
  /* CTA de carte (apparaît si l'item porte cta_href ; sert les états reveal-cta /
     cellAlignY=between). Le moteur gère opacity reveal-cta + focus-within. */
  .feature-grid__cta { margin-top: var(--space-3); }
  /* ── CONTRASTE PAR CELLULE (couche L10bis) : quand une carte porte data-cell-bg, c'est
     le MOTEUR qui fixe la couleur de premier plan sur .sec-item (contraste auto). Le titre
     et le paragraphe doivent alors HÉRITER (sinon le var(--ink)/var(--muted) hardcodé
     casserait le contraste sur fond sombre/accent). En l'absence de data-cell-bg = défaut
     inchangé. ── */
  .feature-grid__item[data-cell-bg]:not([data-cell-bg='none']) .feature-grid__title { color: inherit; }
  .feature-grid__item[data-cell-bg]:not([data-cell-bg='none']) p { color: var(--muted); }
  @media (max-width: 768px) {
    .feature-grid__list[data-cols="3"],
    .feature-grid__list[data-cols="4"] { grid-template-columns: repeat(2, 1fr); }
    .feature-grid__list[data-cols="2"] { grid-template-columns: 1fr; }
  }
  /* ── Alternance des fonds R4 (docs/37 §2.6) · defaut paper = rendu inchange ── */
  .feature-grid[data-bg='paper-2'] { background: var(--paper-2); }
  .feature-grid[data-bg='paper-3'] { background: var(--paper-3); }
  .feature-grid[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  /* Section ink : header + cartes SANS cellBg propre passent en clair. Une carte qui a son
     PROPRE data-cell-bg gère son contraste via le moteur → on ne la force pas (exclusion). */
  .feature-grid[data-bg='ink'] :is(.sec-base-h2, .feature-grid__header :is(h2, h3, p)) { color: var(--paper); }
  .feature-grid[data-bg='ink'] .feature-grid__item:not([data-cell-bg]) :is(h3, strong, h2),
  .feature-grid[data-bg='ink'] .feature-grid__item:not([data-cell-bg]) p { color: var(--paper); }

  /* ───── problems-grid (preset) — CSS VERBATIM ProblemsGrid.astro, `.wrap-wide` scopé
     qualifié `.wrap-wide:where(.problems-grid)` (spécificité inchangée) ───── */
  .problems-grid__cards { max-width: 1200px; }
  .problems-grid { padding-block: var(--section-base); border-top: 1px solid rgba(var(--ink-rgb), .07); }
  .problems-grid__h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    letter-spacing: -.01em;
    margin-bottom: var(--space-9);
    color: var(--ink);
  }
  .problems-grid__cards {
    display: grid;
    /* Content-driven : 3 colonnes par défaut, recomposé par compte exact via :has()
       ci-dessous pour éviter la cellule orpheline (le fond gris de la grille comblait
       la demi-rangée vide). Le look hairline (gap 1px + fond + bordure) est préservé :
       seule la répartition des colonnes change selon le nombre de cartes. */
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(var(--ink-rgb), .08);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xs);
    overflow: hidden;
  }
  @supports selector(:has(*)) {
    /* Exactement 4 cartes → 2×2 net (au lieu de 3 + 1 orpheline). */
    .problems-grid__cards:has(> :nth-child(4):last-child) {
      grid-template-columns: repeat(2, 1fr);
    }
    /* Exactement 5 cartes → 6 sous-colonnes ; chaque carte occupe 2 (3 en haut),
       les 2 dernières sont centrées (2 en bas) pour combler la rangée sans orpheline. */
    .problems-grid__cards:has(> :nth-child(5):last-child) {
      grid-template-columns: repeat(6, 1fr);
    }
    .problems-grid__cards:has(> :nth-child(5):last-child) > * { grid-column: span 2; }
    .problems-grid__cards:has(> :nth-child(5):last-child) > :nth-child(4) { grid-column: 2 / span 2; }
    .problems-grid__cards:has(> :nth-child(5):last-child) > :nth-child(5) { grid-column: 4 / span 2; }
  }
  @media (max-width: 900px) {
    .problems-grid__cards,
    .problems-grid__cards:has(> :nth-child(4):last-child),
    .problems-grid__cards:has(> :nth-child(5):last-child) { grid-template-columns: repeat(2, 1fr); }
    .problems-grid__cards:has(> :nth-child(5):last-child) > *,
    .problems-grid__cards:has(> :nth-child(5):last-child) > :nth-child(4),
    .problems-grid__cards:has(> :nth-child(5):last-child) > :nth-child(5) { grid-column: auto; }
  }
  @media (max-width: 560px) {
    .problems-grid__cards,
    .problems-grid__cards:has(> :nth-child(4):last-child),
    .problems-grid__cards:has(> :nth-child(5):last-child) { grid-template-columns: 1fr; }
  }
  .problems-grid__card {
    background: var(--paper);
    padding: var(--space-7);
  }
  /* Line-art DS en tête de carte. Trait = currentColor (encre du contexte),
     accent terracotta porté par var(--accent) du SVG inliné. Taille bornée. */
  .problems-grid__art {
    color: var(--ink);
    margin-bottom: var(--space-5);
    line-height: 0;
  }
  .problems-grid__art :global(svg) {
    width: var(--space-9);
    height: var(--space-9);
    max-width: 100%;
    display: block;
  }
  .problems-grid[data-bg='ink'] .problems-grid__art { color: var(--paper); }
  .problems-grid__num {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: var(--text-small);
    color: var(--muted);
    letter-spacing: var(--tracking-mono-tight);
    margin-bottom: var(--space-2);
  }
  /* Kicker canonisé (R4) · typo portée par l'atome (fusion tracking .06em -> .08em, variante documentée) */
  :global(.problems-grid__kicker) {
    margin-bottom: var(--space-3);
  }
  .problems-grid__card h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.25;
    margin-bottom: var(--space-4);
    color: var(--ink);
  }
  .problems-grid__card p {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-prose);
    color: var(--muted);
  }
  /* ── Alternance des fonds R4 · defaut clair = rendu inchange ── */
  .problems-grid[data-bg='paper-2'] { background: var(--paper-2); }
  .problems-grid[data-bg='paper-3'] { background: var(--paper-3); }
  .problems-grid[data-bg='ink'] {
    background: var(--ink);
  }
  .problems-grid[data-bg='ink'] .problems-grid__cards {
    background: rgba(var(--paper-rgb), 0.12);
    border-color: rgba(var(--paper-rgb), 0.12);
  }
  .problems-grid[data-bg='ink'] .problems-grid__card {
    background: rgba(var(--paper-rgb), 0.04);
  }
  .problems-grid[data-bg='ink'] :is(.problems-grid__h2, h3) { color: var(--paper); }
  .problems-grid[data-bg='ink'] :is(.problems-grid__num, p) { color: var(--muted); }

  /* ───── deliverables-grid (preset) — CSS VERBATIM DeliverablesGrid.astro ───── */
  .deliverables-grid {
    /* Gutter porté par le `.wrap-wide` interne (markup) → padding-inline = 0 ici,
       sinon double gutter (contenu à 2×--gut, désaligné des autres sections). */
    padding: var(--deliverables-grid-pad, var(--section-loose)) var(--deliverables-grid-inline, 0);
    border-bottom: 1px solid var(--hairline);
  }
  .deliverables-grid__hd {
    margin-bottom: clamp(var(--space-8), 5vw, var(--space-12));
  }
  /* Kicker canonisé (R4) · typo portée par l'atome Kicker, ici layout seul */
  :global(.deliverables-grid__kicker) {
    display: block;
    margin-bottom: var(--space-4);
  }
  .deliverables-grid__title {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-display);
    font-weight: var(--fw-medium);
    color: var(--ink);
    text-wrap: balance;
    margin: 0;
  }
  .deliverables-grid__title :global(i) {
    font-style: italic;
    color: var(--accent-text);
  }
  .deliverables-grid__lead {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--muted);
    max-width: 680px;
    margin: var(--space-5) 0 0;
  }
  .deliverables-grid__grid {
    counter-reset: deliverable-counter;
    display: grid;
    /* Content-driven : 3 colonnes par défaut, recomposé par compte exact via :has()
       ci-dessous pour éviter la cellule orpheline. Le rythme éditorial (gap 0 + border-top
       par carte) est préservé : seule la répartition des colonnes change selon le nombre.
       Axe `columns` (data-columns) : 'auto' (défaut) = count-adaptive :has() ci-dessous ;
       '2'|'3'|'4' = nombre fixe desktop (dégrade en auto-fit sous 900/640px). */
    grid-template-columns: repeat(3, 1fr);
    gap: var(--deliverables-grid-col-gap, 0);
  }
  /* Colonnes fixes (opt-in) : surcharge le count-adaptive. minmax garde la lisibilité. */
  .deliverables-grid__grid[data-columns='2'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .deliverables-grid__grid[data-columns='3'] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .deliverables-grid__grid[data-columns='4'] { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @supports selector(:has(*)) {
    /* Count-adaptive : UNIQUEMENT en mode 'auto' (défaut). Exactement 4 cartes → 2×2. */
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(4):last-child) {
      grid-template-columns: repeat(2, 1fr);
    }
    /* Exactement 5 cartes → 6 sous-colonnes : 3 en haut (span 2), 2 centrées en bas. */
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(5):last-child) {
      grid-template-columns: repeat(6, 1fr);
    }
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(5):last-child) > * { grid-column: span 2; }
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(5):last-child) > :nth-child(4) { grid-column: 2 / span 2; }
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(5):last-child) > :nth-child(5) { grid-column: 4 / span 2; }
  }
  .deliverables-grid__card {
    position: relative;
    counter-increment: deliverable-counter;
    padding: var(--space-7) var(--space-6) var(--space-6) 0;
    border-top: 1px solid var(--hairline-strong);
    background: transparent;
    transition: transform var(--dur-trim) var(--ease), border-top-color var(--dur-trim) var(--ease), background var(--dur-trim) var(--ease);
  }
  .deliverables-grid__card::before {
    content: counter(deliverable-counter, decimal-leading-zero);
    position: absolute;
    top: var(--space-5);
    right: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
    transition: color var(--dur-trim) var(--ease);
  }
  .deliverables-grid__card:hover {
    transform: translateY(-2px);
    border-top-color: var(--accent-text);
    background: var(--paper-2);
  }
  .deliverables-grid__card:hover::before {
    color: var(--accent-text);
  }
  /* Line-art DS en tête de carte livrable. Trait = currentColor, accent = var(--accent). */
  .deliverables-grid__art {
    color: var(--ink);
    margin-bottom: var(--space-4);
    line-height: 0;
  }
  .deliverables-grid__art :global(svg) {
    width: var(--space-9);
    height: var(--space-9);
    max-width: 100%;
    display: block;
  }
  .deliverables-grid[data-bg='ink'] .deliverables-grid__art { color: var(--paper); }
  .deliverables-grid__tag {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: var(--space-2);
    transition: transform var(--dur-trim) var(--ease), color var(--dur-trim) var(--ease);
  }
  .deliverables-grid__card h3 {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-style: italic;
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-display);
    margin: var(--space-3) 0;
    font-weight: var(--fw-medium);
    color: var(--ink);
    text-wrap: balance;
    transition: transform var(--dur-trim) var(--ease);
  }
  .deliverables-grid__card p {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--ink-2);
    margin: 0;
    max-width: 38ch;
    transition: transform var(--dur-trim) var(--ease);
  }
  .deliverables-grid__card:hover h3,
  .deliverables-grid__card:hover p,
  .deliverables-grid__card:hover .deliverables-grid__tag {
    transform: translateX(1px);
  }
  @media (max-width: 900px) {
    .deliverables-grid__grid,
    .deliverables-grid__grid[data-columns='3'],
    .deliverables-grid__grid[data-columns='4'],
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(4):last-child),
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(5):last-child) {
      grid-template-columns: repeat(2, 1fr);
    }
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(5):last-child) > *,
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(5):last-child) > :nth-child(4),
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(5):last-child) > :nth-child(5) { grid-column: auto; }
  }
  @media (max-width: 640px) {
    .deliverables-grid__grid,
    .deliverables-grid__grid[data-columns='2'],
    .deliverables-grid__grid[data-columns='3'],
    .deliverables-grid__grid[data-columns='4'],
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(4):last-child),
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(5):last-child) {
      grid-template-columns: 1fr;
    }
    .deliverables-grid__card {
      padding-right: 0;
    }
  }
  /* ── Axe DENSITY (data-density) : rythme padding section + gap colonnes.
     Défaut (absent) = --section-loose / gap 0 (rendu actuel). Tokens --space-* seulement. ── */
  .deliverables-grid[data-density='compact'] { --deliverables-grid-pad: var(--space-8); --deliverables-grid-col-gap: var(--space-4); }
  .deliverables-grid[data-density='compact'] .deliverables-grid__hd { margin-bottom: var(--space-6); }
  .deliverables-grid[data-density='base'] { --deliverables-grid-pad: var(--space-10); --deliverables-grid-col-gap: var(--space-6); }
  .deliverables-grid[data-density='ample'] { --deliverables-grid-pad: var(--space-12); --deliverables-grid-col-gap: var(--space-8); }
  .deliverables-grid[data-density='ample'] .deliverables-grid__hd { margin-bottom: var(--space-12); }

  /* ── Axe CONTENT-ALIGN (data-content-align) : alignement du header.
     Défaut (absent) = start/gauche (rendu actuel). ── */
  .deliverables-grid[data-content-align='center'] .deliverables-grid__hd { text-align: center; }
  .deliverables-grid[data-content-align='center'] .deliverables-grid__title,
  .deliverables-grid[data-content-align='center'] .deliverables-grid__lead { margin-inline: auto; }
  .deliverables-grid[data-content-align='end'] .deliverables-grid__hd { text-align: end; }
  .deliverables-grid[data-content-align='end'] .deliverables-grid__title,
  .deliverables-grid[data-content-align='end'] .deliverables-grid__lead { margin-inline-start: auto; }

  /* ── COUCHE ATOMIQUE (Batch 2) · placement par région (header + body).
     UN SEUL data-attr par région. data-header-align résout placement.header.align ?? contentAlign.
     order/hideOn structurels (pas de token). ── */
  .deliverables-grid__hd[data-header-align='center'] { text-align: center; }
  .deliverables-grid__hd[data-header-align='center'] .deliverables-grid__title,
  .deliverables-grid__hd[data-header-align='center'] .deliverables-grid__lead { margin-inline: auto; }
  .deliverables-grid__hd[data-header-align='end'] { text-align: end; }
  .deliverables-grid__hd[data-header-align='end'] .deliverables-grid__title,
  .deliverables-grid__hd[data-header-align='end'] .deliverables-grid__lead { margin-inline-start: auto; }
  /* wrap-wide interne en flux : header + grid → order possible. */
  .deliverables-grid .wrap-wide { display: flex; flex-direction: column; }
  .deliverables-grid__hd[data-header-order='0'] { order: 0; }
  .deliverables-grid__hd[data-header-order='1'] { order: 1; }
  .deliverables-grid__grid[data-body-order='0'] { order: 0; }
  .deliverables-grid__grid[data-body-order='1'] { order: 1; }
  .deliverables-grid__hd[data-header-hide='desktop'],
  .deliverables-grid__grid[data-body-hide='desktop'] { display: none; }
  @media (max-width: 768px) {
    .deliverables-grid__hd[data-header-hide='mobile'],
    .deliverables-grid__grid[data-body-hide='mobile'] { display: none; }
    .deliverables-grid__hd[data-header-hide='desktop'] { display: block; }
    .deliverables-grid__grid[data-body-hide='desktop'] { display: grid; }
  }

  /* ── VOCABULAIRE DE LAYOUT (Batch 2) · recettes nommées sur data-layout. Défaut (absent)
     = grille éditoriale count-adaptive border-top (rendu actuel). Chaque recette absorbe
     1..N items sans trou (dense/auto-fit/centrage). 100% tokens DS ; structurel = 768px,
     aspect-ratio, minmax en rem, order/align. ── */

  /* grid-uniform : N colonnes ÉGALES, hauteurs stretch. N piloté par columns. Réintroduit
     gap + bordure pleine par carte (look « cartes » plutôt que rythme border-top éditorial). */
  .deliverables-grid[data-layout='grid-uniform'] .deliverables-grid__grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    align-items: stretch;
  }
  .deliverables-grid[data-layout='grid-uniform'] .deliverables-grid__grid[data-columns='2'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .deliverables-grid[data-layout='grid-uniform'] .deliverables-grid__grid[data-columns='3'] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .deliverables-grid[data-layout='grid-uniform'] .deliverables-grid__grid[data-columns='4'] { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .deliverables-grid[data-layout='grid-uniform'] .deliverables-grid__grid[data-columns='5'] { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .deliverables-grid[data-layout='grid-uniform'] .deliverables-grid__grid[data-columns='6'] { grid-template-columns: repeat(6, minmax(0, 1fr)); }

  /* grid-auto : count-adaptive auto-fit ; s'adapte au nombre ET à la largeur. Dernière ligne
     incomplète centrée. col-min = rem structurel borné. */
  .deliverables-grid[data-layout='grid-auto'] .deliverables-grid__grid {
    grid-template-columns: repeat(auto-fit, minmax(min(var(--col-min, 16rem), 100%), 1fr));
    gap: var(--space-5);
    justify-content: center;
    align-items: stretch;
  }

  /* grid-asym : colonnes de largeurs DIFFÉRENTES via colRatio. Non-uniforme maîtrisé. */
  .deliverables-grid[data-layout='grid-asym'] .deliverables-grid__grid {
    display: grid;
    gap: var(--space-5);
    align-items: stretch;
    grid-template-columns: 1fr 1fr;
  }
  .deliverables-grid[data-layout='grid-asym'] .deliverables-grid__grid[data-col-ratio='equal'] { grid-template-columns: 1fr 1fr; }
  .deliverables-grid[data-layout='grid-asym'] .deliverables-grid__grid[data-col-ratio='1-2'] { grid-template-columns: 1fr 2fr; }
  .deliverables-grid[data-layout='grid-asym'] .deliverables-grid__grid[data-col-ratio='2-1'] { grid-template-columns: 2fr 1fr; }
  .deliverables-grid[data-layout='grid-asym'] .deliverables-grid__grid[data-col-ratio='1-1-2'] { grid-template-columns: 1fr 1fr 2fr; }
  .deliverables-grid[data-layout='grid-asym'] .deliverables-grid__grid[data-col-ratio='2-3'] { grid-template-columns: 2fr 3fr; }

  /* list : 1 par ligne, item horizontal pleine largeur (art à gauche, texte à droite). */
  .deliverables-grid[data-layout='list'] .deliverables-grid__grid {
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  .deliverables-grid[data-layout='list'] .deliverables-grid__card,
  .deliverables-grid[data-layout='rows-divided'] .deliverables-grid__card {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-6);
    align-items: start;
    padding: var(--space-6) 0;
    border-top: none;
  }
  .deliverables-grid[data-layout='list'] .deliverables-grid__art,
  .deliverables-grid[data-layout='rows-divided'] .deliverables-grid__art { grid-row: span 3; margin-bottom: 0; }
  .deliverables-grid[data-layout='list'] .deliverables-grid__card::before,
  .deliverables-grid[data-layout='rows-divided'] .deliverables-grid__card::before { top: var(--space-6); }

  /* rows-divided : list + hairline entre lignes (table éditoriale). */
  .deliverables-grid[data-layout='rows-divided'] .deliverables-grid__grid {
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--hairline);
  }
  .deliverables-grid[data-layout='rows-divided'] .deliverables-grid__card {
    border-bottom: 1px solid var(--hairline);
  }

  /* bento-feature : 1ʳᵉ carte vedette span 2 colonnes + 2 lignes, le reste simple. dense comble. */
  .deliverables-grid[data-layout='bento-feature'] .deliverables-grid__grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: var(--space-5);
    align-items: stretch;
  }
  .deliverables-grid[data-layout='bento-feature'] .deliverables-grid__card:first-child {
    grid-column: span 2;
    grid-row: span 2;
  }

  /* featured-split : 1 gros bloc (1fr) + colonne d'items secondaires empilés (1fr). */
  .deliverables-grid[data-layout='featured-split'] .deliverables-grid__grid {
    grid-template-columns: 1fr 1fr;
    grid-auto-flow: dense;
    gap: var(--space-5);
    align-items: start;
  }
  .deliverables-grid[data-layout='featured-split'] .deliverables-grid__card:first-child {
    grid-row: 1 / -1;
  }

  /* itemHeight : hauteur des cellules. Ces recettes ne s'appliquent QUE quand un layout en
     grille pose une grille (sinon align-items absent). square/video via aspect-ratio. */
  .deliverables-grid[data-layout] .deliverables-grid__grid[data-item-height='even'] { align-items: stretch; }
  .deliverables-grid[data-layout] .deliverables-grid__grid[data-item-height='square'] .deliverables-grid__card { aspect-ratio: 1; overflow: hidden; }
  .deliverables-grid[data-layout] .deliverables-grid__grid[data-item-height='video'] .deliverables-grid__card { aspect-ratio: 16 / 9; overflow: hidden; }

  /* Responsive : toute recette grille converge en 1 colonne ≤768px ; list/rows restent. */
  @media (max-width: 768px) {
    .deliverables-grid[data-layout='grid-uniform'] .deliverables-grid__grid,
    .deliverables-grid[data-layout='grid-uniform'] .deliverables-grid__grid[data-columns='2'],
    .deliverables-grid[data-layout='grid-uniform'] .deliverables-grid__grid[data-columns='3'],
    .deliverables-grid[data-layout='grid-uniform'] .deliverables-grid__grid[data-columns='4'],
    .deliverables-grid[data-layout='grid-uniform'] .deliverables-grid__grid[data-columns='5'],
    .deliverables-grid[data-layout='grid-uniform'] .deliverables-grid__grid[data-columns='6'],
    .deliverables-grid[data-layout='grid-auto'] .deliverables-grid__grid,
    .deliverables-grid[data-layout='grid-asym'] .deliverables-grid__grid,
    .deliverables-grid[data-layout='grid-asym'] .deliverables-grid__grid[data-col-ratio='1-2'],
    .deliverables-grid[data-layout='grid-asym'] .deliverables-grid__grid[data-col-ratio='2-1'],
    .deliverables-grid[data-layout='grid-asym'] .deliverables-grid__grid[data-col-ratio='1-1-2'],
    .deliverables-grid[data-layout='grid-asym'] .deliverables-grid__grid[data-col-ratio='2-3'],
    .deliverables-grid[data-layout='bento-feature'] .deliverables-grid__grid,
    .deliverables-grid[data-layout='featured-split'] .deliverables-grid__grid { grid-template-columns: 1fr; }
    /* feature/featured cards perdent leur span pour ne pas déborder. */
    .deliverables-grid[data-layout='bento-feature'] .deliverables-grid__card:first-child,
    .deliverables-grid[data-layout='featured-split'] .deliverables-grid__card:first-child { grid-column: auto; grid-row: auto; }
    /* square/video relâchés en hauteur naturelle sur mobile (contenu prime). */
    .deliverables-grid[data-layout] .deliverables-grid__grid[data-item-height='square'] .deliverables-grid__card,
    .deliverables-grid[data-layout] .deliverables-grid__grid[data-item-height='video'] .deliverables-grid__card { aspect-ratio: auto; }
  }

  /* ── Alternance des fonds R4 · defaut clair = rendu inchange ── */
  .deliverables-grid[data-bg='paper-2'] { background: var(--paper-2); }
  .deliverables-grid[data-bg='paper-3'] { background: var(--paper-3); }
  .deliverables-grid[data-bg='ink'] {
    background: var(--ink);
  }
  .deliverables-grid[data-bg='ink'] :is(.deliverables-grid__title, .deliverables-grid__card h3) { color: var(--paper); }
  .deliverables-grid[data-bg='ink'] :is(.deliverables-grid__lead, .deliverables-grid__card p) { color: rgba(var(--paper-rgb), 0.72); }
  .deliverables-grid[data-bg='ink'] .deliverables-grid__card:hover {
    background: rgba(var(--paper-rgb), 0.04);
    border-top-color: var(--accent-text);
  }

  /* ───── commitments-grid (preset) — CSS VERBATIM CommitmentsGrid.astro ───── */
  .commitments-grid {
    padding: var(--section-base) 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  /* Kicker canonisé (R4) · typo portée par l'atome Kicker, ici layout seul */
  :global(.commitments-grid__kicker) {
    margin: 0 0 14px;
  }
  .commitments-grid__h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-display);
    font-weight: var(--fw-medium);
    max-width: 760px;
    margin: 0 0 var(--spacing-block);
    color: var(--ink);
    text-wrap: balance;
  }
  .commitments-grid__body {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--muted);
    max-width: 640px;
    margin: 0 0 var(--spacing-block);
  }
  .commitments-grid__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--hairline);
  }
  .commitments-grid__cell {
    padding: var(--spacing-block);
    border-right: 1px solid var(--hairline);
  }
  .commitments-grid__cell:last-child {
    border-right: none;
  }
  .commitments-grid__cell-title {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: 1.25;
    letter-spacing: -0.018em;
    font-weight: var(--fw-medium);
    color: var(--ink);
    margin: 0 0 var(--space-3);
  }
  .commitments-grid__cell-body {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: 1.55;
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 800px) {
    .commitments-grid__grid {
      grid-template-columns: 1fr;
    }
    .commitments-grid__cell {
      border-right: none;
      border-bottom: 1px solid var(--hairline);
    }
    .commitments-grid__cell:last-child {
      border-bottom: none;
    }
  }
  /* ── Alternance des fonds R4 · defaut clair = rendu inchange ── */
  .commitments-grid[data-bg='paper-2'] { background: var(--paper-2); }
  .commitments-grid[data-bg='paper-3'] { background: var(--paper-3); }
  .commitments-grid[data-bg='ink'] {
    background: var(--ink);
  }
  .commitments-grid[data-bg='ink'] :is(.commitments-grid__h2, .commitments-grid__cell-title) { color: var(--paper); }
  .commitments-grid[data-bg='ink'] :is(.commitments-grid__body, .commitments-grid__cell-body) { color: var(--muted); }

  .icon-trio .wrap-wide > :global(.kicker) {
    display: block;
    margin-bottom: var(--space-4);
  }

  :where(.icon-trio) h2 {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-h2);
    line-height: var(--leading-h3);
    color: var(--ink);
    margin: 0 0 var(--spacing-block);
  }

  .icon-trio__cols {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .icon-trio__col {
    padding: var(--space-7);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
  }

  /* Separateurs hairline verticaux sur les 2e et 3e colonnes */
  .icon-trio__col:nth-child(2),
  .icon-trio__col:nth-child(3) {
    border-left: 1px solid var(--hairline);
  }

  .icon-trio__glyph {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-h2);
    line-height: 1;
    color: var(--accent-text);
    font-family: var(--font-display);
  }

  .icon-trio__title {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: var(--fw-medium);
    color: var(--ink);
    line-height: 1.2;
  }

  .icon-trio__body {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Responsive : 1 colonne, separateurs horizontaux */
  @media (max-width: 768px) {
    .icon-trio__cols {
      grid-template-columns: 1fr;
    }

    .icon-trio__col:nth-child(2),
    .icon-trio__col:nth-child(3) {
      border-left: none;
      border-top: 1px solid var(--hairline);
    }
  }
  /* ── Alternance des fonds R4 (docs/37 §2.6) · defaut paper = rendu inchange ── */
  .icon-trio[data-bg='paper-2'] { background: var(--paper-2); }
