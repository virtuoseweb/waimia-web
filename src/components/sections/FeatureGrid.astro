---
// ARCHÉTYPE R5b · « grille régulière de cards » — 1 composant paramétrable → 5 type-ids (presets).
// Grille N colonnes de cards titre+texte+icône/numéro. Branche sur `data.type` ; chaque
// variante conserve markup + CSS BYTE-IDENTIQUES à son composant d'origine. Seuls
// ajustements CSS = qualifications de scope `:where(.racine)` (spécificité inchangée)
// rendues nécessaires par la colocalisation — résultat visuel inchangé.
// Absorbe (R5b) : problems-grid (cards numérotées auto-fit), deliverables-grid
// (cards counter + tag), commitments-grid (cells bordées), icon-trio (3 colonnes
// centrées glyph). Noyau : feature-grid (data-cols 2/3/4).
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

// Line-art DS (Registre A) inliné au build : le SVG vit dans le DOM de la page →
// `stroke="currentColor"` suit la couleur de texte du contexte (encre sur paper,
// crème sur ink) et `var(--accent)` résout le vrai token DS (un <img> n'hérite
// ni de currentColor ni des custom properties). Source = src/assets/line-art/*.svg
// (copie importable des fichiers public/images/line-art/*.svg). Clé = basename.
const lineArtRaw = import.meta.glob<string>('../../assets/line-art/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const lineArt: Record<string, string> = {};
for (const [path, svg] of Object.entries(lineArtRaw)) {
  lineArt[path.split('/').pop()!] = svg;
}
const inlineLineArt = (src?: string): string | undefined =>
  src ? lineArt[src.split('/').pop()!] : undefined;

interface Props {
  data:
    | SectionByType<'feature-grid'>
    | SectionByType<'problems-grid'>
    | SectionByType<'deliverables-grid'>
    | SectionByType<'commitments-grid'>
    | SectionByType<'icon-trio'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const fgCols = data.type === 'feature-grid' ? (data.columns ?? '3') : '3';
// deliverables-grid et problems-grid : la recomposition selon le nombre de cartes
// (anti-orpheline) est désormais portée par du CSS structurel scopé (`:has(> :nth-child)`)
// au lieu d'un calcul JS couplé à `data.*.length`. Voir les blocs `.problems-grid__cards`
// et `.deliverables-grid__grid` ci-dessous. Aucune custom property de colonnes injectée.
---

{data.type === 'problems-grid' ? (
  <section class="problems-grid wrap-wide reveal-blur-clip" data-bg={data.background}>
    <h2 class="problems-grid__h2 reveal" set:html={isFr ? data.h2_fr : data.h2_en} />
    <div class="problems-grid__cards">
      {data.problems.map((p, i) => {
        const art = inlineLineArt(p.illustration_src);
        const alt = isFr ? p.illustration_alt_fr : p.illustration_alt_en;
        return (
        <div class="problems-grid__card">
          {art && (
            <div class="problems-grid__art" set:html={art} role={alt ? 'img' : undefined} aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'} />
          )}
          <div class="problems-grid__num">{p.num ?? String(i + 1).padStart(2, '0')}</div>
          <Kicker tone="accent" letterSpacing=".08em" class="problems-grid__kicker">{isFr ? p.kicker_fr : p.kicker_en}</Kicker>
          <h3 set:html={isFr ? p.title_fr : p.title_en} />
          <p>{isFr ? p.body_fr : p.body_en}</p>
        </div>
        );
      })}
    </div>
  </section>
) : data.type === 'deliverables-grid' ? (
  <section class="deliverables-grid" data-bg={data.background} data-density={data.density} data-content-align={data.contentAlign}>
    <div class="wrap-wide">
      <header class="deliverables-grid__hd">
        <Kicker as="span" tone="accent" class="deliverables-grid__kicker">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
        <h2 class="deliverables-grid__title" set:html={isFr ? data.title_fr : data.title_en} />
        {(isFr ? data.lead_fr : data.lead_en) && (
          <p class="deliverables-grid__lead" set:html={isFr ? data.lead_fr : data.lead_en} />
        )}
      </header>

      <div class="deliverables-grid__grid reveal-stagger" data-columns={data.columns ?? 'auto'}>
        {data.items.map((item) => {
          const format = isFr ? item.format_fr : item.format_en;
          const duration = isFr ? item.duration_fr : item.duration_en;
          const tag = [format, duration].filter(Boolean).join(' · ');
          const art = inlineLineArt(item.illustration_src);
          const alt = isFr ? item.illustration_alt_fr : item.illustration_alt_en;

          return (
            <article class="deliverables-grid__card reveal-zoom-in">
              {art && (
                <div class="deliverables-grid__art" set:html={art} role={alt ? 'img' : undefined} aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'} />
              )}
              {tag && <span class="deliverables-grid__tag">{tag}</span>}
              <h3 set:html={isFr ? item.title_fr : item.title_en} />
              <p set:html={isFr ? item.body_fr : item.body_en} />
            </article>
          );
        })}
      </div>
    </div>
  </section>
) : data.type === 'commitments-grid' ? (
  <section class="commitments-grid" data-bg={data.background} aria-labelledby="commitments-grid-h2">
    <div class="wrap-wide">
      {(data.kicker_fr || data.kicker_en) && (
        <Kicker as="p" tone="accent" class="commitments-grid__kicker">
          {isFr ? data.kicker_fr : data.kicker_en}
        </Kicker>
      )}
      <h2 id="commitments-grid-h2" class="commitments-grid__h2 reveal" set:html={isFr ? data.h2_fr : data.h2_en} />
      {(data.body_fr || data.body_en) && (
        <p class="commitments-grid__body">
          {isFr ? data.body_fr : data.body_en}
        </p>
      )}

      <div class="commitments-grid__grid reveal-stagger">
        {data.commitments.map((c) => (
          <div class="commitments-grid__cell">
            <h3 class="commitments-grid__cell-title" set:html={isFr ? c.title_fr : c.title_en} />
            <p class="commitments-grid__cell-body">{isFr ? c.body_fr : c.body_en}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
) : data.type === 'icon-trio' ? (
  <section class="icon-trio sec-base" data-bg={data.background}>
    <div class="wrap-wide">
      {(isFr ? data.kicker_fr : data.kicker_en) && (
        <Kicker tone="muted">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      )}
      {(isFr ? data.h2_fr : data.h2_en) && (
        <h2 set:html={isFr ? data.h2_fr : data.h2_en} />
      )}
      <ul class="icon-trio__cols reveal-stagger">
        {data.items.map((item: (typeof data.items)[number]) => (
          <li class="icon-trio__col">
            {item.glyph && (
              <span class="icon-trio__glyph" aria-hidden="true">{item.glyph}</span>
            )}
            <strong class="icon-trio__title">{isFr ? item.title_fr : item.title_en}</strong>
            <p class="icon-trio__body">{isFr ? item.body_fr : item.body_en}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
) : (
  <section class="feature-grid sec-base" data-bg={data.background}>
    <div class="wrap-wide">
    <div class="feature-grid__header">
      {(isFr ? data.kicker_fr : data.kicker_en) && (
        <Kicker tone="muted">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      )}
      <h2 class="sec-base-h2" set:html={isFr ? data.h2_fr : data.h2_en} />
    </div>
    <ul class="feature-grid__list" data-cols={fgCols}>
      {data.features.map((f: (typeof data.features)[number]) => (
        <li class="feature-grid__item">
          {f.icon && (
            <Kicker tone="accent" size={10} class="feature-grid__icon">▸ {f.icon}</Kicker>
          )}
          <strong class="feature-grid__title">{isFr ? f.title_fr : f.title_en}</strong>
          <p>{isFr ? f.body_fr : f.body_en}</p>
        </li>
      ))}
    </ul>
    </div>
  </section>
)}

<style>
  .feature-grid__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--spacing-block);
  }
  .feature-grid__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .feature-grid__list[data-cols="2"] { grid-template-columns: repeat(2, 1fr); }
  .feature-grid__list[data-cols="3"] { grid-template-columns: repeat(3, 1fr); }
  .feature-grid__list[data-cols="4"] { grid-template-columns: repeat(4, 1fr); }
  .feature-grid__item {
    padding: var(--space-7);
    border: 1px solid var(--hairline);
    margin: -1px -1px 0 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .feature-grid__icon { margin-bottom: var(--space-1); }
  .feature-grid__title {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: var(--fw-medium);
    color: var(--ink);
    line-height: 1.2;
  }
  .feature-grid__item p {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }
  @media (max-width: 768px) {
    .feature-grid__list[data-cols="3"],
    .feature-grid__list[data-cols="4"] { grid-template-columns: repeat(2, 1fr); }
    .feature-grid__list[data-cols="2"] { grid-template-columns: 1fr; }
  }
  /* ── Alternance des fonds R4 (docs/37 §2.6) · defaut paper = rendu inchange ── */
  .feature-grid[data-bg='paper-2'] { background: var(--paper-2); }
  .feature-grid[data-bg='paper-3'] { background: var(--paper-3); }
  .feature-grid[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .feature-grid[data-bg='ink'] :is(h2, h3, p) { color: var(--paper); }

  /* ───── problems-grid (preset) — CSS VERBATIM ProblemsGrid.astro, `.wrap-wide` scopé
     qualifié `.wrap-wide:where(.problems-grid)` (spécificité inchangée) ───── */
  .problems-grid__cards { max-width: 1200px; }
  .problems-grid { padding-block: var(--section-base); border-top: 1px solid rgba(var(--ink-rgb), .07); }
  .problems-grid__h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    letter-spacing: -.01em;
    margin-bottom: var(--space-9);
    color: var(--ink);
  }
  .problems-grid__cards {
    display: grid;
    /* Content-driven : 3 colonnes par défaut, recomposé par compte exact via :has()
       ci-dessous pour éviter la cellule orpheline (le fond gris de la grille comblait
       la demi-rangée vide). Le look hairline (gap 1px + fond + bordure) est préservé :
       seule la répartition des colonnes change selon le nombre de cartes. */
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(var(--ink-rgb), .08);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xs);
    overflow: hidden;
  }
  @supports selector(:has(*)) {
    /* Exactement 4 cartes → 2×2 net (au lieu de 3 + 1 orpheline). */
    .problems-grid__cards:has(> :nth-child(4):last-child) {
      grid-template-columns: repeat(2, 1fr);
    }
    /* Exactement 5 cartes → 6 sous-colonnes ; chaque carte occupe 2 (3 en haut),
       les 2 dernières sont centrées (2 en bas) pour combler la rangée sans orpheline. */
    .problems-grid__cards:has(> :nth-child(5):last-child) {
      grid-template-columns: repeat(6, 1fr);
    }
    .problems-grid__cards:has(> :nth-child(5):last-child) > * { grid-column: span 2; }
    .problems-grid__cards:has(> :nth-child(5):last-child) > :nth-child(4) { grid-column: 2 / span 2; }
    .problems-grid__cards:has(> :nth-child(5):last-child) > :nth-child(5) { grid-column: 4 / span 2; }
  }
  @media (max-width: 900px) {
    .problems-grid__cards,
    .problems-grid__cards:has(> :nth-child(4):last-child),
    .problems-grid__cards:has(> :nth-child(5):last-child) { grid-template-columns: repeat(2, 1fr); }
    .problems-grid__cards:has(> :nth-child(5):last-child) > *,
    .problems-grid__cards:has(> :nth-child(5):last-child) > :nth-child(4),
    .problems-grid__cards:has(> :nth-child(5):last-child) > :nth-child(5) { grid-column: auto; }
  }
  @media (max-width: 560px) {
    .problems-grid__cards,
    .problems-grid__cards:has(> :nth-child(4):last-child),
    .problems-grid__cards:has(> :nth-child(5):last-child) { grid-template-columns: 1fr; }
  }
  .problems-grid__card {
    background: var(--paper);
    padding: var(--space-7);
  }
  /* Line-art DS en tête de carte. Trait = currentColor (encre du contexte),
     accent terracotta porté par var(--accent) du SVG inliné. Taille bornée. */
  .problems-grid__art {
    color: var(--ink);
    margin-bottom: var(--space-5);
    line-height: 0;
  }
  .problems-grid__art :global(svg) {
    width: var(--space-9);
    height: var(--space-9);
    max-width: 100%;
    display: block;
  }
  .problems-grid[data-bg='ink'] .problems-grid__art { color: var(--paper); }
  .problems-grid__num {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: var(--text-small);
    color: var(--muted);
    letter-spacing: var(--tracking-mono-tight);
    margin-bottom: var(--space-2);
  }
  /* Kicker canonisé (R4) · typo portée par l'atome (fusion tracking .06em -> .08em, variante documentée) */
  :global(.problems-grid__kicker) {
    margin-bottom: var(--space-3);
  }
  .problems-grid__card h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.25;
    margin-bottom: var(--space-4);
    color: var(--ink);
  }
  .problems-grid__card p {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-prose);
    color: var(--muted);
  }
  /* ── Alternance des fonds R4 · defaut clair = rendu inchange ── */
  .problems-grid[data-bg='paper-2'] { background: var(--paper-2); }
  .problems-grid[data-bg='paper-3'] { background: var(--paper-3); }
  .problems-grid[data-bg='ink'] {
    background: var(--ink);
  }
  .problems-grid[data-bg='ink'] .problems-grid__cards {
    background: rgba(var(--paper-rgb), 0.12);
    border-color: rgba(var(--paper-rgb), 0.12);
  }
  .problems-grid[data-bg='ink'] .problems-grid__card {
    background: rgba(var(--paper-rgb), 0.04);
  }
  .problems-grid[data-bg='ink'] :is(.problems-grid__h2, h3) { color: var(--paper); }
  .problems-grid[data-bg='ink'] :is(.problems-grid__num, p) { color: var(--muted); }

  /* ───── deliverables-grid (preset) — CSS VERBATIM DeliverablesGrid.astro ───── */
  .deliverables-grid {
    /* Gutter porté par le `.wrap-wide` interne (markup) → padding-inline = 0 ici,
       sinon double gutter (contenu à 2×--gut, désaligné des autres sections). */
    padding: var(--deliverables-grid-pad, var(--section-loose)) var(--deliverables-grid-inline, 0);
    border-bottom: 1px solid var(--hairline);
  }
  .deliverables-grid__hd {
    margin-bottom: clamp(var(--space-8), 5vw, var(--space-12));
  }
  /* Kicker canonisé (R4) · typo portée par l'atome Kicker, ici layout seul */
  :global(.deliverables-grid__kicker) {
    display: block;
    margin-bottom: var(--space-4);
  }
  .deliverables-grid__title {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-display);
    font-weight: var(--fw-medium);
    color: var(--ink);
    text-wrap: balance;
    margin: 0;
  }
  .deliverables-grid__title :global(i) {
    font-style: italic;
    color: var(--accent-text);
  }
  .deliverables-grid__lead {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--muted);
    max-width: 680px;
    margin: var(--space-5) 0 0;
  }
  .deliverables-grid__grid {
    counter-reset: deliverable-counter;
    display: grid;
    /* Content-driven : 3 colonnes par défaut, recomposé par compte exact via :has()
       ci-dessous pour éviter la cellule orpheline. Le rythme éditorial (gap 0 + border-top
       par carte) est préservé : seule la répartition des colonnes change selon le nombre.
       Axe `columns` (data-columns) : 'auto' (défaut) = count-adaptive :has() ci-dessous ;
       '2'|'3'|'4' = nombre fixe desktop (dégrade en auto-fit sous 900/640px). */
    grid-template-columns: repeat(3, 1fr);
    gap: var(--deliverables-grid-col-gap, 0);
  }
  /* Colonnes fixes (opt-in) : surcharge le count-adaptive. minmax garde la lisibilité. */
  .deliverables-grid__grid[data-columns='2'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .deliverables-grid__grid[data-columns='3'] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .deliverables-grid__grid[data-columns='4'] { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @supports selector(:has(*)) {
    /* Count-adaptive : UNIQUEMENT en mode 'auto' (défaut). Exactement 4 cartes → 2×2. */
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(4):last-child) {
      grid-template-columns: repeat(2, 1fr);
    }
    /* Exactement 5 cartes → 6 sous-colonnes : 3 en haut (span 2), 2 centrées en bas. */
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(5):last-child) {
      grid-template-columns: repeat(6, 1fr);
    }
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(5):last-child) > * { grid-column: span 2; }
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(5):last-child) > :nth-child(4) { grid-column: 2 / span 2; }
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(5):last-child) > :nth-child(5) { grid-column: 4 / span 2; }
  }
  .deliverables-grid__card {
    position: relative;
    counter-increment: deliverable-counter;
    padding: var(--space-7) var(--space-6) var(--space-6) 0;
    border-top: 1px solid var(--hairline-strong);
    background: transparent;
    transition: transform var(--dur-trim) var(--ease), border-top-color var(--dur-trim) var(--ease), background var(--dur-trim) var(--ease);
  }
  .deliverables-grid__card::before {
    content: counter(deliverable-counter, decimal-leading-zero);
    position: absolute;
    top: var(--space-5);
    right: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
    transition: color var(--dur-trim) var(--ease);
  }
  .deliverables-grid__card:hover {
    transform: translateY(-2px);
    border-top-color: var(--accent-text);
    background: var(--paper-2);
  }
  .deliverables-grid__card:hover::before {
    color: var(--accent-text);
  }
  /* Line-art DS en tête de carte livrable. Trait = currentColor, accent = var(--accent). */
  .deliverables-grid__art {
    color: var(--ink);
    margin-bottom: var(--space-4);
    line-height: 0;
  }
  .deliverables-grid__art :global(svg) {
    width: var(--space-9);
    height: var(--space-9);
    max-width: 100%;
    display: block;
  }
  .deliverables-grid[data-bg='ink'] .deliverables-grid__art { color: var(--paper); }
  .deliverables-grid__tag {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: var(--space-2);
    transition: transform var(--dur-trim) var(--ease), color var(--dur-trim) var(--ease);
  }
  .deliverables-grid__card h3 {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-style: italic;
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-display);
    margin: var(--space-3) 0;
    font-weight: var(--fw-medium);
    color: var(--ink);
    text-wrap: balance;
    transition: transform var(--dur-trim) var(--ease);
  }
  .deliverables-grid__card p {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--ink-2);
    margin: 0;
    max-width: 38ch;
    transition: transform var(--dur-trim) var(--ease);
  }
  .deliverables-grid__card:hover h3,
  .deliverables-grid__card:hover p,
  .deliverables-grid__card:hover .deliverables-grid__tag {
    transform: translateX(1px);
  }
  @media (max-width: 900px) {
    .deliverables-grid__grid,
    .deliverables-grid__grid[data-columns='3'],
    .deliverables-grid__grid[data-columns='4'],
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(4):last-child),
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(5):last-child) {
      grid-template-columns: repeat(2, 1fr);
    }
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(5):last-child) > *,
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(5):last-child) > :nth-child(4),
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(5):last-child) > :nth-child(5) { grid-column: auto; }
  }
  @media (max-width: 640px) {
    .deliverables-grid__grid,
    .deliverables-grid__grid[data-columns='2'],
    .deliverables-grid__grid[data-columns='3'],
    .deliverables-grid__grid[data-columns='4'],
    .deliverables-grid__grid[data-columns='auto']:has(> :nth-child(4):last-child),
