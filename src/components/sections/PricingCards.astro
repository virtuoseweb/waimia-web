---
// Section · pricing-cards · 3 tiers côte à côte, carte « Recommandé » mise en avant.
// Composé de · Kicker (atom) · Button (atom). DS figé, tokens uniquement.
import type { SectionByType } from '@waimia/ds-kernel';
import Kicker from '../ui/atoms/Kicker.astro';
import Button from '../ui/atoms/Button.astro';

interface Props {
  data: SectionByType<'pricing-cards'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const kicker = isFr ? data.kicker_fr : data.kicker_en;
const lede = isFr ? data.lede_fr : data.lede_en;
const footnote = isFr ? data.footnote_fr : data.footnote_en;

// ── Couche atomique (Batch 2) · placement par région (header + body + actions).
// Résolution raccourci↔placement : valeur effective UNE fois, UN seul data-attr par région.
// placement.header.align surcharge contentAlign ; placement.actions.justify surcharge
// actionsAlign (spread → between). Défaut absent = rendu actuel.
const pl = data.placement;
const headerAlign = pl?.header?.align ?? data.contentAlign;
const headerOrder = pl?.header?.order;
const headerHide = pl?.header?.hideOn;
const bodyOrder = pl?.body?.order;
const bodyHide = pl?.body?.hideOn;
const actionsJustify =
  pl?.actions?.justify ?? (data.actionsAlign === 'spread' ? 'between' : data.actionsAlign);
const colRatio = data.layout === 'grid-asym' ? (data.colRatio ?? 'equal') : undefined;
---

<section
  class="pricing-cards sec-base sec-collection"
  data-bg={data.background}
  data-density={data.density}
  data-content-align={data.contentAlign}
  data-layout={data.layout}
>
  <div class="wrap-wide">
    <div
      class="pricing-cards__header"
      data-header-align={headerAlign}
      data-header-order={headerOrder}
      data-header-hide={headerHide}
    >
      {kicker && <Kicker tone="muted">{kicker}</Kicker>}
      <h2 class="sec-base-h2" set:html={isFr ? data.h2_fr : data.h2_en} />
      {lede && <p class="pricing-cards__lede">{lede}</p>}
    </div>
    <div
      class="pricing-cards__grid sec-grid"
      data-columns={data.columns}
      data-col-ratio={colRatio}
      data-item-height={data.itemHeight}
      data-body-order={bodyOrder}
      data-body-hide={bodyHide}
      style={`--col-count: ${data.tiers.length}`}
    >
      {data.tiers.map((tier: (typeof data.tiers)[number], i: number) => (
        <article class:list={['pricing-cards__card', 'sec-item', tier.featured && 'is-featured']} data-actions-justify={actionsJustify}>
          {tier.featured && (
            <span class="pricing-cards__badge">{isFr ? 'Recommandé' : 'Recommended'}</span>
          )}
          <header class="pricing-cards__card-hd">
            <span class="pricing-cards__idx">§ {String(i + 1).padStart(2, '0')}</span>
            <strong class="pricing-cards__name">{isFr ? tier.name_fr : tier.name_en}</strong>
          </header>
          <div class="pricing-cards__price">
            <span class="pricing-cards__price-k">{tier.price}</span>
            {(isFr ? tier.period_fr : tier.period_en) && (
              <span class="pricing-cards__period">{isFr ? tier.period_fr : tier.period_en}</span>
            )}
          </div>
          <ul class="pricing-cards__features" data-list="check">
            {(isFr ? tier.features_fr : tier.features_en).map((f: string) => (
              <li><span>{f}</span></li>
            ))}
          </ul>
          <Button
            href={tier.cta.href}
            variant={tier.featured ? 'accent' : (tier.cta.variant as any)}
            size="lg"
            class="pricing-cards__btn"
          >
            {isFr ? tier.cta.label_fr : tier.cta.label_en}
          </Button>
        </article>
      ))}
    </div>
    {footnote && <p class="pricing-cards__footnote">{footnote}</p>}
  </div>
</section>

<style>
  .pricing-cards__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--spacing-block);
    max-width: 64ch;
  }
  .pricing-cards__lede {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--muted);
    line-height: var(--leading-body);
    margin: 0;
    text-wrap: pretty;
  }
  /* La grille délègue colonnes + recettes layout au moteur (.sec-collection .sec-grid +
     data-columns/data-layout, section-layouts.css). Le composant ne garde que le gap et le
     défaut hors-layout/hors-columns. */
  .pricing-cards__grid {
    display: grid;
    gap: var(--pricing-cards-gap, var(--space-5));
    /* R5 · cartes à hauteur égale : la grille étire les items (pas d'escalier à 2 colonnes). */
    align-items: stretch;
  }
  /* R1/R3 · grille adaptative anti-orphelin. La prop columns vaut 'auto' par défaut (schéma),
     donc data-columns est toujours posé : le moteur .sec-grid[data-columns] (section-layouts.css)
     pilote les colonnes. On COMPLÈTE ici le mode 'auto' (le moteur l.92 ne pose ni
     justify-content:center ni les paliers count-adaptive hors data-layout='grid-auto') :
     dernière rangée incomplète centrée, jamais une carte esseulée à gauche.
     Paliers count-adaptive calqués sur section-layouts.css:552-566 (on ne pilote que
     --sec-col-min, le minmax du moteur reste le même). */
  .pricing-cards__grid[data-columns='auto'] {
    justify-content: center;
  }
  .pricing-cards__grid[data-columns='auto']:has(> .sec-item:nth-child(2):last-child) {
    --sec-col-min: 22rem; /* 2 tiers : colonnes larges (évite 2 colonnes étriquées) */
  }
  .pricing-cards__grid[data-columns='auto']:has(> .sec-item:nth-child(4):last-child) {
    --sec-col-min: 18rem; /* 4 tiers : favorise un 2x2 propre plutôt qu'un 1x4 étiré */
  }
  .pricing-cards__grid[data-columns='auto']:has(> .sec-item:nth-child(6):last-child) {
    --sec-col-min: 15rem; /* 6 tiers (théorique) : colonnes plus serrées (3x2 cohérent) */
  }
  /* R1 · fallback défensif si data-columns est absent (instance sans prop columns, schéma
     contourné) : on ne pose JAMAIS 1 colonne par tier sans plafond. On bascule sur l'auto-fit
     anti-orphelin (mêmes pistes minmax(0,1fr) implicites via minmax min(col-min,100%)). */
  .pricing-cards__grid:not([data-columns]) {
    grid-template-columns: repeat(auto-fit, minmax(min(var(--sec-col-min, 16rem), 100%), 1fr));
    justify-content: center;
  }
  .pricing-cards__card {
    position: relative;
    padding: var(--space-7) var(--space-6);
    border: 1px solid var(--hairline-strong);
    border-radius: 14px;
    background: var(--paper);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    /* R4 · le contenu ne déborde jamais sa piste de grille (titre/prix longs). */
    min-width: 0;
    /* R5 · carte à pleine hauteur de cellule : alignement bas même avec un nombre de
       features différent d'une carte à l'autre (CTA en pied de carte, 0 escalier). */
    height: 100%;
    transition: border-color var(--dur-trim) var(--ease), transform var(--dur-hover) var(--ease);
  }
  .pricing-cards__card:hover {
    border-color: var(--accent-text);
    transform: translateY(-3px);
  }
  .pricing-cards__card.is-featured {
    border-color: var(--accent-text);
    background: var(--paper-2);
    box-shadow: 0 24px 60px rgba(var(--accent-rgb), 0.08);
  }
  .pricing-cards__badge {
    position: absolute;
    top: -12px;
    left: var(--space-5);
    /* accent-sur-clair (terracotta foncee) : paper sur accent = 4.02 (sous AA),
       paper sur accent-sur-clair = 5.57 (AA franc), identite accent preservee. */
    background: var(--accent-sur-clair);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 6px var(--space-3);
    border-radius: var(--radius-pill);
  }
  .pricing-cards__card-hd {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .pricing-cards__idx {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--accent-text);
    letter-spacing: 0.14em;
  }
  .pricing-cards__name {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: var(--fw-regular);
    /* R4 · nom de plan de longueur variable : ne casse jamais la piste. */
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  .pricing-cards__card.is-featured .pricing-cards__name { color: var(--accent-text); }
  .pricing-cards__price {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-block: var(--space-4);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .pricing-cards__price-k {
    font-family: var(--font-sans);
    font-weight: var(--fw-semibold);
    font-size: var(--text-h2);
    line-height: 1;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .pricing-cards__period {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--muted);
    letter-spacing: 0.06em;
  }
  .pricing-cards__features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }
  .pricing-cards__features li {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--ink-2);
    /* R4 · feature de longueur variable : ne déborde jamais (mot long / URL). */
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  /* Marqueur de feature (▸) porté par la primitive générique [data-list='check']
     (section-layouts.css) : ::before sur chaque <li>, plus de markup inline. */
  /* Doctrine alignement gauche : la pleine largeur reste pour la zone cliquable,
     mais le libellé est ancré à gauche (et non centré) comme les autres CTA. */
  .pricing-cards__btn { width: 100%; justify-content: flex-start; text-align: left; }
  .pricing-cards__footnote {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--muted);
    letter-spacing: 0.04em;
    margin: var(--spacing-block) 0 0;
  }
  /* ── Axe DENSITY (data-density) : rythme du header + gap de la grille + padding des cartes.
     Défaut (absent) = gap --space-5 (rendu actuel). Tokens --space-* uniquement. ── */
  .pricing-cards[data-density='compact'] { --pricing-cards-gap: var(--space-4); }
  .pricing-cards[data-density='compact'] .pricing-cards__header { margin-bottom: var(--space-6); gap: var(--space-3); }
  .pricing-cards[data-density='compact'] .pricing-cards__card { padding: var(--space-6) var(--space-5); gap: var(--space-4); }
  .pricing-cards[data-density='base'] { --pricing-cards-gap: var(--space-5); }
  .pricing-cards[data-density='ample'] { --pricing-cards-gap: var(--space-8); }
  .pricing-cards[data-density='ample'] .pricing-cards__header { margin-bottom: var(--space-12); gap: var(--space-5); }
  .pricing-cards[data-density='ample'] .pricing-cards__card { padding: var(--space-9) var(--space-7); gap: var(--space-6); }

  /* ── Axe CONTENT-ALIGN (data-content-align) : alignement du header. Défaut = start (gauche). ── */
  .pricing-cards[data-content-align='center'] .pricing-cards__header { text-align: center; margin-inline: auto; }
  .pricing-cards[data-content-align='end'] .pricing-cards__header { text-align: end; margin-inline-start: auto; }

  /* ── COUCHE ATOMIQUE (Batch 2) · placement par région (header + body + actions).
     data-header-align résout placement.header.align ?? contentAlign ; data-actions-justify
     (par carte) résout placement.actions.justify ?? actionsAlign, INDÉPENDANT du header.
     order/hideOn structurels. ── */
  .pricing-cards__header[data-header-align='center'] { text-align: center; margin-inline: auto; }
  .pricing-cards__header[data-header-align='end'] { text-align: end; margin-inline-start: auto; }
  /* wrap-wide en flux pour réordonner header ↔ grille. */
  .pricing-cards .wrap-wide { display: flex; flex-direction: column; }
  .pricing-cards__header[data-header-order='0'] { order: 0; }
  .pricing-cards__header[data-header-order='1'] { order: 1; }
  .pricing-cards__grid[data-body-order='0'] { order: 0; }
  .pricing-cards__grid[data-body-order='1'] { order: 1; }
  .pricing-cards__header[data-header-hide='desktop'],
  .pricing-cards__grid[data-body-hide='desktop'] { display: none; }
  @media (max-width: 768px) {
    .pricing-cards__header[data-header-hide='mobile'],
    .pricing-cards__grid[data-body-hide='mobile'] { display: none; }
    .pricing-cards__header[data-header-hide='desktop'] { display: flex; }
    .pricing-cards__grid[data-body-hide='desktop'] { display: grid; }
  }
  /* Région ACTIONS : justify du CTA dans la carte. Quand posé, le bouton n'est plus
     full-width (sinon justify n'a pas d'effet) → largeur intrinsèque alignée. */
  .pricing-cards__card[data-actions-justify] { align-items: stretch; }
  .pricing-cards__card[data-actions-justify] .pricing-cards__btn { width: auto; }
  .pricing-cards__card[data-actions-justify='start'] .pricing-cards__btn { align-self: flex-start; }
  .pricing-cards__card[data-actions-justify='center'] .pricing-cards__btn { align-self: center; justify-content: center; text-align: center; }
  .pricing-cards__card[data-actions-justify='end'] .pricing-cards__btn { align-self: flex-end; }
  .pricing-cards__card[data-actions-justify='between'] .pricing-cards__btn { align-self: stretch; width: 100%; }

  /* ── VOCABULAIRE DE LAYOUT (Batch 2) · recettes nommées sur data-layout. Défaut (data-layout
     absent) = grille adaptative auto-fit anti-orphelin (columns='auto' par défaut, R1/R3).
     100% tokens DS ; structurel = 768px, aspect-ratio, minmax en rem, order. ── */

  /* grid-uniform / grid-auto / grid-asym : colonnes déléguées au moteur générique
     (.sec-collection .sec-grid + data-layout/data-columns/data-col-ratio, section-layouts.css).
     Le composant n'émet plus de recette grid-template-columns pour ces 3 layouts. */

  /* list : 1 tier par ligne, carte horizontale (header+price ↔ features ↔ CTA). */
  .pricing-cards[data-layout='list'] .pricing-cards__grid { grid-template-columns: 1fr; }
  .pricing-cards[data-layout='list'] .pricing-cards__card,
  .pricing-cards[data-layout='rows-divided'] .pricing-cards__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) auto;
    column-gap: var(--space-6);
    align-items: center;
  }
  .pricing-cards[data-layout='list'] .pricing-cards__price,
  .pricing-cards[data-layout='rows-divided'] .pricing-cards__price { border: none; padding-block: 0; }

  /* rows-divided : list + hairline entre lignes (table tarifaire). */
  .pricing-cards[data-layout='rows-divided'] .pricing-cards__grid { grid-template-columns: 1fr; gap: 0; border-top: 1px solid var(--hairline); }
  .pricing-cards[data-layout='rows-divided'] .pricing-cards__card { border: none; border-bottom: 1px solid var(--hairline); border-radius: 0; }

  /* bento-feature : 1ʳᵉ carte vedette span 2×2 + tiers simples (dense). */
  .pricing-cards[data-layout='bento-feature'] .pricing-cards__grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-flow: dense;
    align-items: stretch;
  }
  .pricing-cards[data-layout='bento-feature'] .pricing-cards__card:first-child { grid-column: span 2; grid-row: span 2; }

  /* featured-split : 1 gros tier (1fr) + colonne de tiers secondaires (1fr). */
  .pricing-cards[data-layout='featured-split'] .pricing-cards__grid {
    grid-template-columns: 1fr 1fr;
    grid-auto-flow: dense;
    align-items: start;
  }
  .pricing-cards[data-layout='featured-split'] .pricing-cards__card:first-child { grid-row: 1 / -1; }

  /* itemHeight : hauteur des cartes en mode grille. Défaut historique = align-items:start. */
  .pricing-cards[data-layout] .pricing-cards__grid[data-item-height='even'] { align-items: stretch; }
  .pricing-cards[data-layout] .pricing-cards__grid[data-item-height='auto'] { align-items: start; }
  .pricing-cards[data-layout] .pricing-cards__grid[data-item-height='square'] .pricing-cards__card { aspect-ratio: 1; overflow: hidden; }
  .pricing-cards[data-layout] .pricing-cards__grid[data-item-height='video'] .pricing-cards__card { aspect-ratio: 16 / 9; overflow: hidden; }

  /* Responsive : toute recette grille converge en 1 colonne ≤768px ; list/rows en 1 col empilée. */
  @media (max-width: 768px) {
    .pricing-cards[data-layout='bento-feature'] .pricing-cards__grid,
    .pricing-cards[data-layout='featured-split'] .pricing-cards__grid { grid-template-columns: 1fr; }
    .pricing-cards[data-layout='bento-feature'] .pricing-cards__card:first-child,
    .pricing-cards[data-layout='featured-split'] .pricing-cards__card:first-child { grid-column: auto; grid-row: auto; }
    /* list/rows : carte repasse en pile verticale (prix sous header, CTA sous features). */
    .pricing-cards[data-layout='list'] .pricing-cards__card,
    .pricing-cards[data-layout='rows-divided'] .pricing-cards__card { grid-template-columns: 1fr; row-gap: var(--space-4); }
    .pricing-cards[data-layout] .pricing-cards__grid[data-item-height='square'] .pricing-cards__card,
    .pricing-cards[data-layout] .pricing-cards__grid[data-item-height='video'] .pricing-cards__card { aspect-ratio: auto; }
    /* R6 · breakpoint 768px standardisé (ex-bespoke 900px supprimé). Mode défaut :
       le moteur (section-layouts.css:457-462) ramène déjà .sec-grid[data-columns='1'..'6']
       à 1 colonne ; data-columns='auto' (défaut) et le fallback :not([data-columns])
       collapsent intrinsèquement via l'auto-fit. Filet pour l'instance sans data-columns. */
    .pricing-cards__grid:not([data-columns]) { grid-template-columns: 1fr; }
  }
  /* Mobile : densification (espacement/typo tokenisee, sans perte d'info) */
  @media (max-width: 480px) {
    .pricing-cards__header { margin-bottom: var(--space-6); gap: var(--space-3); }
    .pricing-cards__grid { gap: var(--space-4); }
    .pricing-cards__card { padding: var(--space-5) var(--space-4); gap: var(--space-4); }
    .pricing-cards__price { padding-block: var(--space-3); }
    .pricing-cards__price-k { font-size: var(--text-h3); }
    .pricing-cards__features { gap: var(--space-2); }
    .pricing-cards__footnote { margin-top: var(--space-6); }
  }
  /* ── Alternance des fonds (docs/37 §2.6) ── */
  .pricing-cards[data-bg='paper-2'] { background: var(--paper-2); }
  .pricing-cards[data-bg='paper-3'] { background: var(--paper-3); }
  .pricing-cards[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
    --ink-2: rgba(var(--paper-rgb), 0.86);
    --hairline-strong: rgba(var(--paper-rgb), 0.22);
  }
  /* Tous les textes/atomes lisibles AA sur fond sombre */
  .pricing-cards[data-bg='ink'] :is(h2, h3, strong, a, dt, dd) { color: var(--paper); }
  .pricing-cards[data-bg='ink'] .pricing-cards__lede,
  .pricing-cards[data-bg='ink'] .pricing-cards__name,
  .pricing-cards[data-bg='ink'] .pricing-cards__period,
  .pricing-cards[data-bg='ink'] .pricing-cards__footnote { color: var(--muted); }
  .pricing-cards[data-bg='ink'] .pricing-cards__price-k { color: var(--paper); }
  .pricing-cards[data-bg='ink'] .pricing-cards__features li { color: rgba(var(--paper-rgb), 0.86); }
  /* Cartes : surfaces sombres élevées, hairlines clairs */
  .pricing-cards[data-bg='ink'] .pricing-cards__card {
    background: rgba(var(--paper-rgb), 0.04);
    border-color: rgba(var(--paper-rgb), 0.14);
  }
  .pricing-cards[data-bg='ink'] .pricing-cards__card.is-featured {
    background: rgba(var(--paper-rgb), 0.07);
    border-color: var(--accent-text);
  }
  /* Accent reste lisible sur sombre (idx, check, name featured, badge) */
  .pricing-cards[data-bg='ink'] .pricing-cards__card.is-featured .pricing-cards__name { color: var(--accent-text); }
</style>
