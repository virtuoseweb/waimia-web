---
// Section catalogue · hero-service-masthead
// COPIE FIDÈLE du `.svc-masthead` de `src/components/templates/ServiceDetailTemplate.astro:131-138`
// Kicker § Service N + h1 display + lede display sobre.
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'hero-service-masthead'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---
<section class="hero-service-masthead">
  <div class="wrap-wide">
    <Kicker class="hero-service-masthead__num">§ Service {data.service_num}</Kicker>
    <h1 class="hero-service-masthead__h1" set:html={isFr ? data.h1_fr : data.h1_en} />
    <p class="hero-service-masthead__lede" set:html={isFr ? data.lede_fr : data.lede_en} />
  </div>
</section>

<style>
  .hero-service-masthead { padding: 140px 32px 0; }
  .wrap-wide { max-width: 1200px; margin-inline: auto; }
  :global(.hero-service-masthead__num) { display: block; margin-bottom: var(--space-5); }
  .hero-service-masthead__h1 {
    font-family: var(--font-display);
    font-size: clamp(56px, 9vw, 156px);
    line-height: 0.92;
    letter-spacing: -0.028em;
    text-wrap: balance;
    font-weight: 400;
    margin: 0 0 32px;
  }
  .hero-service-masthead__h1 :global(i) { font-style: italic; color: var(--accent); }
  .hero-service-masthead__lede {
    font-family: var(--font-display);
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.45;
    max-width: 880px;
    color: var(--muted);
    text-wrap: balance;
    margin: 0;
  }
</style>
