---
import type { SectionByType } from '@waimia/ds-kernel';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'testimonial-block'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---

<section class="testimonial-block sec-base" data-bg={data.background}>
  <div class="wrap-wide">
  <div class="testimonial-block__header">
    {(isFr ? data.kicker_fr : data.kicker_en) && (
      <Kicker tone="muted">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
    )}
    {(isFr ? data.h2_fr : data.h2_en) && (
      <h2 class="sec-base-h2" set:html={isFr ? data.h2_fr : data.h2_en} />
    )}
  </div>
  <ul class="testimonial-block__list" data-layout={data.layout}>
    {data.testimonials.map((t: (typeof data.testimonials)[number]) => (
      <li class="testimonial-block__item">
        <blockquote class="testimonial-block__quote">
          {isFr ? t.quote_fr : t.quote_en}
        </blockquote>
        <footer class="testimonial-block__footer">
          <Kicker tone="muted" size={10} class="testimonial-block__author">{t.author}</Kicker>
          <Kicker tone="muted" size={10}>{isFr ? t.role_fr : t.role_en}{t.company ? ` · ${t.company}` : ''}</Kicker>
        </footer>
      </li>
    ))}
  </ul>
  </div>
</section>

<style>
  .testimonial-block__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--spacing-block);
  }
  .testimonial-block__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .testimonial-block__list[data-layout="grid-2"] { grid-template-columns: repeat(2, 1fr); }
  .testimonial-block__list[data-layout="rows"] { grid-template-columns: 1fr; }
  .testimonial-block__list[data-layout="carousel"] {
    grid-template-columns: repeat(2, 1fr);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }
  .testimonial-block__item {
    padding: var(--space-7);
    border: 1px solid var(--hairline);
    margin: -1px -1px 0 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: relative;
    padding-left: var(--space-7);
    scroll-snap-align: start;
  }
  .testimonial-block__item::before {
    content: '';
    display: block;
    position: absolute;
    left: 0;
    top: var(--space-4);
    bottom: var(--space-4);
    width: 2px;
    background: var(--hairline);
  }
  .testimonial-block__quote {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: var(--leading-lede);
    color: var(--ink);
    margin: 0;
  }
  .testimonial-block__footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .testimonial-block__author { color: var(--accent-text); }
  @media (max-width: 640px) {
    .testimonial-block__list[data-layout="grid-2"],
    .testimonial-block__list[data-layout="carousel"] { grid-template-columns: 1fr; }
  }
  /* ── Alternance des fonds R4 (docs/37 §2.6) · defaut paper = rendu inchange ── */
  .testimonial-block[data-bg='paper-2'] { background: var(--paper-2); }
  .testimonial-block[data-bg='paper-3'] { background: var(--paper-3); }
  .testimonial-block[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .testimonial-block[data-bg='ink'] :is(h2, h3, p) { color: var(--paper); }
</style>
