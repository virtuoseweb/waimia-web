---
// Waimia · SectionsRenderer V2 (2026-05-15)
// Renderer composable data-driven. Consomme `sections[]` validé Zod et délègue aux chargeurs
// paresseux `SECTION_LOADERS` (CSS par page, cf lib/lazy-section.ts).
// Cf docs/15-STRATEGIC-AUDIT.md Tier 2.3 + docs/16-EXECUTION-TRACKER.md T2.3a
//
// Usage minimal :
//   <SectionsRenderer sections={entry.data.sections} lang={lang} />
//
// Le `lang` est propagé à chaque section pour rendu bilingue.

import { resolveSectionRefs } from '../../lib/resolve-section-refs';
import { loadSections } from '../../lib/lazy-section';
import type { SectionData } from '@waimia/ds-kernel';
import type { RelatedLinksData } from '../../lib/internal-mesh';
import RelatedLinks from './RelatedLinks.astro';

interface Props {
  sections: SectionData[];
  lang: 'fr' | 'en';
}

const { sections, lang } = Astro.props;
const resolved = await Promise.all(sections.map((s) => resolveSectionRefs(s, lang)));
// Chargement paresseux des seuls types rendus : leurs styles sont injectés dans le <head>
// de CETTE page (cf lib/lazy-section.ts), au lieu d'une feuille commune aux 221 sections.
const components = await loadSections(resolved.map((s) => s.type));

// Maillage automatique AVANT la bande CTA finale (design.md C11) : quand la dernière section
// est un `footer-cta-band`, le bloc « Sur le même sujet » calculé par Base (lib/internal-mesh)
// est rendu juste avant elle, pour que le CTA soit le dernier bloc avant le pied de page.
// Passage de relais par Astro.locals, même clé dans layouts/Base.astro :
// 1. ici (frontmatter), ce renderer se déclare hôte (le dernier déclaré l'emporte) ;
// 2. Base (frontmatter) délègue seulement si un hôte est déclaré et pas encore rendu ;
// 3. au rendu, l'hôte affiche le maillage seulement si Base l'a délégué.
// Base décide une seule fois et rend lui-même le maillage en fin de <main> s'il ne délègue
// pas : quel que soit l'ordre d'exécution, le bloc sort une fois, jamais deux. Le report
// avant le CTA suppose que ce frontmatter tourne avant celui de Base, ce que fait la
// propagation de head d'Astro pour ce composant « in-tree » (cf lib/lazy-section.ts) ;
// sinon, rendu historique (maillage après le CTA).
type MeshHandoff = { host?: symbol; rendered: symbol[]; mesh?: RelatedLinksData };
const locals = Astro.locals as unknown as Record<string, unknown> | undefined;
const lastIdx = resolved.length - 1;
let handoff: MeshHandoff | null = null;
const hostToken = Symbol('mesh-host');
if (locals && lastIdx >= 0 && resolved[lastIdx].type === 'footer-cta-band') {
  handoff = (locals.__waimiaMeshHandoff ??= { rendered: [] }) as MeshHandoff;
  handoff.host = hostToken;
}
// Fond du maillage : l'inverse de la section qui le précède, pour ne pas accoler deux
// bandes de même fond (paper-2 sinon, comme le rendu historique de Base).
const prevBg = lastIdx > 0 ? (resolved[lastIdx - 1] as unknown as { background?: string }).background : undefined;
const meshBg = prevBg === 'paper-2' ? 'paper' : 'paper-2';
---

{resolved.map((section, i) => {
  const Component = components[section.type];
  if (!Component) {
    console.error(`[SectionsRenderer] Type inconnu: ${section.type}`);
    return null;
  }
  // Ancre optionnelle (cf sectionsArraySchema) : point de scroll `id` injecte AVANT la
  // section, hors-flux visuel (height:0/width:0/overflow:hidden) -> 0 impact mise en page.
  // scroll-margin-top compense le header fixe (.hdr, global scroll-padding-top: 80px).
  const anchor = (section as any).anchor;
  const expand = (section as any).expand === true;
  // Pattern W6 : sections attendent `{ data, lang }` (pas spread props)
  const base = <Component data={section as any} lang={lang} />;
  // Opt-in Container Expansion (cf sectionWithAnchorSchema.expand) : enveloppe le composant
  // dans `.container-expand` qui recoit `--expand` 0->1 au scroll (JS container-expand.ts,
  // CSS scroll-reveal.css:248). Neutralise mobile <=768px + reduced-motion cote CSS, donc
  // 0 effet hors desktop. Absent/false -> rendu identique a aujourd'hui.
  const rendered = expand ? (
    <div class="container-expand" data-expand>{base}</div>
  ) : base;
  const out = !anchor ? (
    rendered
  ) : (
    <>
      <span
        id={anchor}
        aria-hidden="true"
        style="display:block;height:0;width:0;overflow:hidden;scroll-margin-top:clamp(80px, 12vh, 120px);"
      ></span>
      {rendered}
    </>
  );
  // Repère d'atelier DEV-ONLY : chaque section porte sa position `data-atelier-idx` pour
  // que l'atelier (library/builder) puisse la localiser en direct. `display:contents` =
  // 0 boite generee -> aucun impact mise en page en dev. `import.meta.env.DEV` est remplace
  // statiquement par `false` au build de prod : la branche est eliminee -> HTML prod IDENTIQUE.
  // Hôte du maillage : fonction évaluée AU RENDU (après le frontmatter de Base), pas à la
  // construction du template, car c'est là que la délégation est connue. Placée avant
  // l'ancre éventuelle de la bande CTA.
  const meshBefore = () => {
    handoff!.rendered.push(hostToken);
    const mesh = handoff!.host === hostToken ? handoff!.mesh : undefined;
    return mesh ? <RelatedLinks data={{ ...mesh, background: meshBg } as any} lang={lang} /> : null;
  };
  const placed = handoff && i === lastIdx ? [meshBefore, out] : out;
  if (import.meta.env.DEV) {
    return (
      <div data-atelier-idx={i} style="display:contents">
        {placed}
      </div>
    );
  }
  return placed;
})}
{/* Focus d'atelier DEV-ONLY (P4.4-h E2) : la fiche /library/[type] deep-linke une instance via
    `?atelier-focus=<idx>`. Ce script scrolle vers `[data-atelier-idx]`, pose un outline temporaire
    (~2,6 s) puis nettoie le param (history.replaceState). Même garde que `data-atelier-idx` :
    `import.meta.env.DEV` -> `false` au build de prod, la branche + le script sont éliminés
    (`is:inline` = 0 hoist Astro) -> HTML prod IDENTIQUE, aucun `atelier-focus` servi. */}
{import.meta.env.DEV && (
  <script is:inline>
    (function () {
      function run() {
        var u = new URL(window.location.href);
        var idx = u.searchParams.get('atelier-focus');
        if (idx === null) return;
        var wrapper = document.querySelector('[data-atelier-idx="' + (window.CSS && CSS.escape ? CSS.escape(idx) : idx) + '"]');
        u.searchParams.delete('atelier-focus');
        window.history.replaceState({}, '', u.pathname + (u.search ? u.search : '') + u.hash);
        if (!wrapper) return;
        var target = wrapper;
        var kids = wrapper.querySelectorAll('*');
        for (var i = 0; i < kids.length; i++) {
          var r = kids[i].getBoundingClientRect();
          if (r.height > 0 && r.width > 0) { target = kids[i]; break; }
        }
        try { target.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
        catch (e) { target.scrollIntoView(); }
        var prevOutline = target.style.outline;
        var prevOffset = target.style.outlineOffset;
        var prevTransition = target.style.transition;
        target.style.transition = 'outline-color 0.3s ease';
        target.style.outline = '3px solid var(--accent)';
        target.style.outlineOffset = '4px';
        setTimeout(function () {
          target.style.outline = prevOutline;
          target.style.outlineOffset = prevOffset;
          target.style.transition = prevTransition;
        }, 2600);
      }
      if (window.__waAtelierFocusBound) return;
      window.__waAtelierFocusBound = true;
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
      else run();
      document.addEventListener('astro:page-load', run);
    })();
  </script>
)}
