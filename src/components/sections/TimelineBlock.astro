---
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'timeline-block'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---

<section class="timeline-block sec-base" data-bg={data.background}>
  <div class="wrap-wide">
  <h2 set:html={isFr ? data.h2_fr : data.h2_en} />
  <ol class="timeline-block__list">
    {data.events.map((ev: (typeof data.events)[number]) => (
      <li class="timeline-block__event">
        <Kicker tone="muted" size={10} class="timeline-block__date">{ev.date}</Kicker>
        <div class="timeline-block__content">
          <strong class="timeline-block__title">{isFr ? ev.title_fr : ev.title_en}</strong>
          <p>{isFr ? ev.body_fr : ev.body_en}</p>
        </div>
      </li>
    ))}
  </ol>
  </div>
</section>

<style>
  h2 {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-h2-section);
    line-height: var(--leading-h3);
    color: var(--ink);
    margin: 0 0 var(--spacing-block);
  }
  .timeline-block__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline-block__event {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--space-6);
    padding-block: var(--space-5);
    border-top: 1px solid var(--hairline);
  }
  .timeline-block__event:last-child { border-bottom: 1px solid var(--hairline); }
  .timeline-block__date { padding-top: var(--space-1); }
  .timeline-block__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .timeline-block__title {
    font-family: var(--font-sans);
    font-size: clamp(16px, 1.6vw, 22px);
    font-weight: var(--fw-medium);
    color: var(--ink);
    line-height: 1.2;
  }
  .timeline-block__content p {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    color: var(--muted);
    line-height: var(--leading-relaxed);
    margin: 0;
    max-width: 64ch;
  }
  @media (max-width: 600px) {
    .timeline-block__event { grid-template-columns: 1fr; gap: var(--space-2); }
  }
  /* ── Alternance des fonds R4 (docs/37 §2.6) · defaut paper = rendu inchange ── */
  .timeline-block[data-bg='paper-2'] { background: var(--paper-2); }
  .timeline-block[data-bg='paper-3'] { background: var(--paper-3); }
  .timeline-block[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .timeline-block[data-bg='ink'] :is(h2, h3, p) { color: var(--paper); }
</style>
