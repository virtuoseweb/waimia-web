---
// Section W6 · hero-essay
// Masthead d'un essai éditorial : kicker, h1 reveal-mask-up, lede italique,
// meta (auteur · date · temps de lecture), + hero-image optionnelle.
// Source markup : `.essay-hd` (src/components/templates/EssayTemplate.astro).
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'hero-essay'>;
  lang: 'fr' | 'en';
  transitionId?: string;
  cardTransitionId?: string;
  topPad?: string;
}
const { data, lang, transitionId, cardTransitionId, topPad } = Astro.props;
const isFr = lang === 'fr';
const readingTime = isFr ? data.reading_time_fr : data.reading_time_en;
const imageAlt = (isFr ? data.hero_image_alt_fr : data.hero_image_alt_en) ?? '';
---

<section class="hero-essay">
  <header
    class="hero-essay__hd"
    transition:name={cardTransitionId ? `card-${cardTransitionId}` : undefined}
    style={topPad ? `--he-top-pad: ${topPad}` : undefined}
  >
    <div class="wrap-wide">
      <Kicker class="hero-essay__kicker">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      <h1
        class="hero-essay__h1 reveal-mask-up"
        transition:name={transitionId ? `hero-h1-${transitionId}` : undefined}
        set:html={isFr ? data.h1_fr : data.h1_en}
      />
      <p class="hero-essay__lede reveal reveal-fade">{isFr ? data.lede_fr : data.lede_en}</p>
      <div class="hero-essay__meta">
        <span>{data.author}</span>
        <span aria-hidden>·</span>
        <time datetime={data.date}>{data.date}</time>
        {readingTime && (<><span aria-hidden>·</span><span>{readingTime}</span></>)}
      </div>
    </div>
  </header>
  {data.hero_image && (
    <div class="hero-essay__image">
      <img src={data.hero_image} alt={imageAlt} loading="lazy" />
    </div>
  )}
</section>

<style>
  .hero-essay__hd {
    padding: var(--he-top-pad, calc(var(--header-height) + 24px)) 32px clamp(40px, 6vw, 80px);
    border-bottom: 1px solid var(--hairline);
  }
  :global(.hero-essay__kicker) { display: block; margin-bottom: 24px; }
  .hero-essay__h1 {
    font-family: var(--font-display);
    font-size: clamp(48px, 7vw, 96px);
    line-height: 0.96;
    letter-spacing: -0.026em;
    font-weight: 400;
    text-wrap: balance;
    color: var(--ink);
    margin: 0;
    max-width: 1200px;
  }
  .hero-essay__h1 :global(i) { font-style: italic; color: var(--accent); }
  .hero-essay__lede {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(20px, 2.2vw, 28px);
    line-height: 1.4;
    color: var(--muted);
    margin: 24px 0 32px;
    max-width: 760px;
    text-wrap: pretty;
  }
  .hero-essay__meta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--muted);
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    text-transform: uppercase;
  }
  .hero-essay__image {
    aspect-ratio: 16/9;
    margin: clamp(48px, 6vw, 80px) 32px 0;
    overflow: hidden;
  }
  .hero-essay__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
