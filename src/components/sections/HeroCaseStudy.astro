---
// Section W6 · hero-case-study
// Masthead d'une étude de cas : eyebrow + kicker § Case N, h1, SVG déco
// géométrique top-right (cercles/lignes opacity .08), + spec-bar optionnelle.
// Source markup : `.case-masthead` + `.case-specs` (src/components/templates/CaseStudyTemplate.astro).
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'hero-case-study'>;
  lang: 'fr' | 'en';
  /** VT : id du h1 + SVG déco (hero-h1-${id}, hero-img-${id}). */
  transitionId?: string;
  /** VT : id de la carte/section (card-${id}). */
  cardTransitionId?: string;
  /** Override padding-top du masthead (parité template live ; défaut catalogue inchangé). */
  topPad?: string;
  /** Override margin-bottom du h1 (espace h1→specs ; parité template live). */
  h1Gap?: string;
}
const { data, lang, transitionId, cardTransitionId, topPad, h1Gap } = Astro.props;
const isFr = lang === 'fr';
---

<section class="hero-case-study" transition:name={cardTransitionId ? `card-${cardTransitionId}` : undefined}>
  <div class="hero-case-study__mast" style={topPad ? `--hcs-top-pad: ${topPad}` : undefined}>
    <svg class="hero-case-study__deco reveal-blur-clip" viewBox="0 0 600 500" aria-hidden="true" focusable="false" transition:name={transitionId ? `hero-img-${transitionId}` : undefined}>
      <circle cx="480" cy="80" r="220" fill="none" stroke="currentColor" stroke-width=".5" opacity=".12" />
      <circle cx="460" cy="60" r="140" fill="none" stroke="var(--accent)" stroke-width=".4" opacity=".18" />
      <line x1="0" y1="400" x2="600" y2="280" stroke="currentColor" stroke-width=".4" opacity=".1" />
    </svg>
    <div class="wrap-wide">
      <span class="hero-case-study__eyebrow">{isFr ? data.eyebrow_fr : data.eyebrow_en}</span>
      <Kicker class="hero-case-study__num">§ Case {data.case_num}</Kicker>
      <h1 class="hero-case-study__h1 reveal-mask-up" style={h1Gap ? `--hcs-h1-gap: ${h1Gap}` : undefined} transition:name={transitionId ? `hero-h1-${transitionId}` : undefined} set:html={isFr ? data.h1_fr : data.h1_en} />
    </div>
  </div>
  {data.specs && data.specs.length > 0 && (
    <div class="hero-case-study__specs">
      <div class="wrap-wide hero-case-study__specs-grid" style={`--spec-cols:${data.specs.length}`}>
        {data.specs.map((s, i) => (
          <div class="hero-case-study__spec" data-last={i === data.specs!.length - 1 ? 'true' : 'false'}>
            <Kicker class="hero-case-study__spec-l">{isFr ? s.label_fr : s.label_en}</Kicker>
            <div class="hero-case-study__spec-v">{s.value}</div>
          </div>
        ))}
      </div>
    </div>
  )}
</section>

<style>
  .hero-case-study__mast {
    position: relative;
    overflow: hidden;
    padding: var(--hcs-top-pad, calc(var(--header-height) + 8px)) 32px 40px;
  }
  .hero-case-study__mast .wrap-wide { position: relative; z-index: 1; }
  .hero-case-study__deco {
    position: absolute;
    top: 0;
    right: 0;
    width: 500px;
    height: 400px;
    pointer-events: none;
    z-index: 0;
    color: var(--ink);
    opacity: 0.08;
    mix-blend-mode: multiply;
  }
  .hero-case-study__eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--accent);
    margin-bottom: 16px;
  }
  :global(.hero-case-study__num) { display: block; margin-bottom: var(--space-5); }
  .hero-case-study__h1 {
    font-family: var(--font-display);
    font-size: clamp(44px, 8vw, 128px);
    line-height: 0.92;
    letter-spacing: -0.03em;
    text-wrap: balance;
    overflow-wrap: break-word;
    hyphens: auto;
    font-weight: var(--fw-regular);
    color: var(--ink);
    margin: 0 0 var(--hcs-h1-gap, 0);
  }
  .hero-case-study__h1 :global(i) { font-style: italic; color: var(--accent); }
  .hero-case-study__specs { padding: 0 32px 40px; border-bottom: 1px solid var(--hairline); }
  .hero-case-study__specs-grid {
    display: grid;
    grid-template-columns: repeat(var(--spec-cols, 5), 1fr);
    border-top: 1px solid var(--hairline);
  }
  .hero-case-study__spec {
    padding: 22px 20px;
    border-right: 1px solid var(--hairline);
  }
  .hero-case-study__spec[data-last='true'] { border-right: none; }
  :global(.hero-case-study__spec-l) { display: block; margin-bottom: 6px; }
  .hero-case-study__spec-v {
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  @media (max-width: var(--wrap-read)) {
    .hero-case-study__specs-grid { grid-template-columns: repeat(2, 1fr); }
    .hero-case-study__deco { width: 280px; height: 240px; opacity: 0.6; }
  }
</style>
