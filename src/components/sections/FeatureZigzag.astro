---
// Section catalogue · feature-zigzag
// Lignes alternées visuel/texte (gauche-droite / droite-gauche / gauche-droite).
// Chaque ligne = bloc média (line-art inline, image webp, ou illustration fallback) +
// colonne texte (kicker + titre + body + lien). Adaptativité par bloc via
// container-query ; entrée directionnelle au scroll (CSS pur, observer existant) ;
// damier paper/ink opt-in.
import Kicker from '../ui/atoms/Kicker.astro';
import type { SectionByType } from '@waimia/ds-kernel';
import { pickIllustration, illustrationSrc, drawingKey, type Illustration } from '../../lib/illustration-pick';
import illustrationLibrary from '../../data/illustrations.json';

const ILLUSTRATIONS: Illustration[] = (illustrationLibrary as { illustrations: Illustration[] }).illustrations;

// Line-art DS (Registre A) inliné au build via ?raw : le SVG vit dans le DOM →
// `stroke="currentColor"` suit la couleur de texte du contexte et `var(--accent)`
// résout le vrai token DS (un <img> n'hériterait ni de currentColor ni des custom
// properties). Pattern identique à FeatureGrid.astro. Source = assets/line-art/*.svg.
// Clé = basename.
const lineArtRaw = import.meta.glob<string>('../../assets/line-art/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const lineArt: Record<string, string> = {};
for (const [path, svg] of Object.entries(lineArtRaw)) {
  lineArt[path.split('/').pop()!] = svg;
}
const inlineLineArt = (src?: string): string | undefined =>
  src ? lineArt[src.split('/').pop()!] : undefined;

interface Props {
  data: SectionByType<'feature-zigzag'>;
  lang: 'fr' | 'en';
}

const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const alternate = data.alternate_blocks === true;

// ── Vague C · Scale (Batch 4) ──
// layout : 'alternate' (défaut, zigzag) · 'stacked' (média toujours dessus) ·
// 'inline-left' / 'inline-right' (média toujours du même côté, pas d'alternance).
const fzLayout = data.layout ?? 'alternate';
// Côté média de la 1ʳᵉ rangée (mediaSide initial). Défaut 'left' = rendu actuel
// (rangée 0 → visuel à gauche). 'right' décale le départ de l'alternance.
const mediaSide = data.mediaSide ?? 'left';
const startRight = mediaSide === 'right';

// Calcul du reverse PAR RANGÉE selon le layout, posé sur data-reverse (le CSS lit ce flag) :
//   alternate    → alterne i%2, décalé si mediaSide='right'.
//   stacked      → reverse ignoré (empilé, 1 colonne).
//   inline-left  → reverse=false partout (média gauche).
//   inline-right → reverse=true partout (média droite).
const rowReverse = (i: number): boolean => {
  if (fzLayout === 'inline-left') return false;
  if (fzLayout === 'inline-right') return true;
  if (fzLayout === 'stacked') return false;
  // alternate : impair = média gauche (reverse=false) ; pair = média droite (reverse=true).
  const base = i % 2 === 1;
  return startRight ? !base : base;
};

// ── Couche atomique (placement par région) : valeur effective calculée UNE fois,
// UN seul data-attr par région. placement.header.align surcharge contentAlign.
const pl = data.placement;
const headerAlign = pl?.header?.align ?? data.contentAlign;
const headerHide = pl?.header?.hideOn;
const bodyHide = pl?.body?.hideOn;
const mediaHide = pl?.media?.hideOn;
const actionsJustify = pl?.actions?.justify;

// ── Fallback illustration (quand une row n'a pas de média) ──
// Choisie dans la bibliothèque src/data/illustrations.json par correspondance de
// mots-clés (titre + body + kicker de la row + h2 de section), déterministe au build.
// Set de slugs utilisés PAR INSTANCE : 2 rows d'une même section n'ont jamais la même
// image ; les slugs déjà posés explicitement via media_src sont aussi exclus.
const sectionH2 = (isFr ? data.h2_fr : data.h2_en) ?? data.h2_fr ?? '';
const usedSlugs = new Set<string>();
for (const row of data.rows) {
  if (!row.media_src) continue;
  for (const ill of ILLUSTRATIONS) {
    if (row.media_src.includes(ill.slug)) usedSlugs.add(drawingKey(ill));
  }
}
// Damier : le CSS inverse `.fz__row:nth-child(even)` (1-based) → index 0-based impair.
const rowIsInk = (i: number): boolean =>
  data.background === 'ink' || (alternate && i % 2 === 1);
const fallbacks = data.rows.map((row, i) => {
  if (row.media_src) return undefined;
  const text = [
    isFr ? row.h3_fr : (row.h3_en ?? row.h3_fr),
    isFr ? row.body_fr : (row.body_en ?? row.body_fr),
    isFr ? row.kicker_fr : (row.kicker_en ?? row.kicker_fr),
    sectionH2,
  ]
    .filter(Boolean)
    .join(' ');
  const ill = pickIllustration(text, { exclude: usedSlugs, seed: i });
  usedSlugs.add(drawingKey(ill));
  return {
    src: illustrationSrc(ill, rowIsInk(i) ? 'ink' : 'paper'),
    alt: isFr ? ill.alt_fr : ill.alt_en,
    width: ill.width,
    height: ill.height,
  };
});
---

<section
  class="fz sec-base"
  data-bg={data.background}
  data-alternate={alternate ? 'true' : 'false'}
  data-layout={fzLayout}
  data-proportion={data.proportion}
  data-density={data.density}
>
  <div class="wrap-wide">
    <div class="fz__header sec-head reveal" data-header-align={headerAlign} data-header-hide={headerHide}>
      {(isFr ? data.kicker_fr : data.kicker_en) && (
        <Kicker tone="muted">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      )}
      <h2 class="sec-base-h2" set:html={isFr ? data.h2_fr : data.h2_en} />
      {(isFr ? data.lede_fr : data.lede_en) && (
        <p class="fz__lede u-lede-sm">{isFr ? data.lede_fr : data.lede_en}</p>
      )}
    </div>

    <ol class="fz__rows" aria-label={isFr ? 'Fonctionnalités' : 'Features'}>
      {data.rows.map((row, i) => {
        const reverse = rowReverse(i);
        const isSvg = row.media_src?.endsWith('.svg');
        const art = isSvg ? inlineLineArt(row.media_src) : undefined;
        const alt = (isFr ? row.media_alt_fr : row.media_alt_en) ?? '';
        return (
          <li class="fz__row reveal" data-reverse={reverse ? 'true' : 'false'}>
            <div class="fz__cell">
              <div class="fz__visual" data-media-hide={mediaHide}>
                {art ? (
                  <div class="fz__art" set:html={art} role={alt ? 'img' : undefined} aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'} />
                ) : row.media_src ? (
                  <img class="fz__img" src={row.media_src} alt={alt} loading="lazy" decoding="async" width="640" height="360" sizes="(min-width: 64rem) 50vw, 100vw" />
                ) : fallbacks[i] ? (
                  <img class="fz__img" src={fallbacks[i]!.src} alt={fallbacks[i]!.alt} width={fallbacks[i]!.width} height={fallbacks[i]!.height} loading="lazy" decoding="async" sizes="(min-width: 64rem) 50vw, 100vw" />
                ) : null}
              </div>
              <div class="fz__text" data-body-hide={bodyHide}>
                {(isFr ? row.kicker_fr : row.kicker_en) && (
                  <Kicker tone="accent">{isFr ? row.kicker_fr : row.kicker_en}</Kicker>
                )}
                <h3 class="u-serif-accent u-serif-accent-em">{isFr ? row.h3_fr : row.h3_en}</h3>
                <p>{isFr ? row.body_fr : row.body_en}</p>
                {row.points && row.points.length > 0 && (
                  <ul class="fz__points u-list-points">
                    {row.points.map((point) => (
                      <li>{isFr ? point.label_fr : point.label_en}</li>
                    ))}
                  </ul>
                )}
                {(isFr ? row.link_label_fr : row.link_label_en) && row.link_href && (
                  <a class="fz__link u-cta-inline" href={row.link_href} data-actions-justify={actionsJustify}>
                    {isFr ? row.link_label_fr : row.link_label_en}
                    <span aria-hidden="true">&#x2192;</span>
                  </a>
                )}
              </div>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>

  .fz__header { max-width: 640px; }

  .fz__header h2 {
    /* R4 : titre de header → casse un mot trop long, jamais de débordement. */
    overflow-wrap: anywhere;
  }

  .fz__header h2 :global(i) {
    font-style: italic;
  }
 .fz__rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  /* La row porte le container-type ; sa grille interne (.fz__cell) se requête
     elle-même (un élément ne peut pas se requêter, donc on style un descendant). */
  .fz__row {
    container-type: inline-size;
  }

  .fz__cell {
    display: grid;
    /* Mobile-first : 1 colonne. La bascule 2 colonnes se fait par container-query
       sur la LARGEUR DE LA ROW (chaque bloc s'adapte à SA largeur, pas au viewport). */
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: center;
  }

  /* Adaptativité par bloc : 2 colonnes asymétriques quand la row est assez large.
     split média/texte via fractions STRUCTURELLES (pas de token couleur). */
  @container (min-width: 48rem) {
    .fz__cell {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-9);
    }
    /* Impair (0, 2, ...) : visuel gauche, texte droite */
    .fz__row[data-reverse='false'] .fz__visual { order: 0; }
    .fz__row[data-reverse='false'] .fz__text   { order: 1; }
    /* Pair (1, 3, ...) : texte gauche, visuel droite */
    .fz__row[data-reverse='true'] .fz__visual { order: 1; }
    .fz__row[data-reverse='true'] .fz__text   { order: 0; }

    /* ── Axe PROPORTION (data-proportion) · ratio média|texte par rangée. minmax(0,..)
       garantit qu'aucune colonne ne déborde (le contenu peut rétrécir). Posé en container
       (≥48rem) → cohabite avec le passage 1 colonne sous 48rem. data-reverse gère le côté,
       donc la 1ʳᵉ fraction = colonne de GAUCHE (peut être média ou texte selon reverse).
       Pour rester intuitif (proportion = média|texte), on mappe selon reverse. ── */
    .fz[data-proportion='1-2'] .fz__row[data-reverse='false'] .fz__cell { grid-template-columns: minmax(0,1fr) minmax(0,2fr); }
    .fz[data-proportion='1-2'] .fz__row[data-reverse='true']  .fz__cell { grid-template-columns: minmax(0,2fr) minmax(0,1fr); }
    .fz[data-proportion='2-1'] .fz__row[data-reverse='false'] .fz__cell { grid-template-columns: minmax(0,2fr) minmax(0,1fr); }
    .fz[data-proportion='2-1'] .fz__row[data-reverse='true']  .fz__cell { grid-template-columns: minmax(0,1fr) minmax(0,2fr); }
    .fz[data-proportion='2-3'] .fz__row[data-reverse='false'] .fz__cell { grid-template-columns: minmax(0,2fr) minmax(0,3fr); }
    .fz[data-proportion='2-3'] .fz__row[data-reverse='true']  .fz__cell { grid-template-columns: minmax(0,3fr) minmax(0,2fr); }
    .fz[data-proportion='3-2'] .fz__row[data-reverse='false'] .fz__cell { grid-template-columns: minmax(0,3fr) minmax(0,2fr); }
    .fz[data-proportion='3-2'] .fz__row[data-reverse='true']  .fz__cell { grid-template-columns: minmax(0,2fr) minmax(0,3fr); }

    /* ── Layout STACKED · média toujours au-dessus du texte, 1 colonne (pas de split même
       en grande largeur). Le JS pose data-reverse='false' partout → visuel order 0 (dessus). ── */
    .fz[data-layout='stacked'] .fz__cell { grid-template-columns: 1fr; gap: var(--space-6); }
  }

  /* ── Axe DENSITY (data-density) · gap entre rangées + gap interne des cellules. Tokens DS. ── */
  .fz[data-density='compact'] .fz__rows { gap: var(--space-7); }
  .fz[data-density='ample']   .fz__rows { gap: var(--space-12); }
  @container (min-width: 48rem) {
    .fz[data-density='compact'] .fz__cell { gap: var(--space-6); }
    .fz[data-density='ample']   .fz__cell { gap: var(--space-12); }
  }

  /* ── Axe CONTENT-ALIGN (data-header-align) · alignement du bloc header (kicker/h2/lede).
     Résout placement.header.align ?? contentAlign. Défaut start = rendu actuel. ── */
  .fz__header[data-header-align='center'] { align-items: center; text-align: center; margin-inline: auto; }
  .fz__header[data-header-align='end']    { align-items: flex-end; text-align: end; margin-inline-start: auto; }

  /* ── COUCHE ATOMIQUE · placement par région (header/media/body/actions).
     UN data-attr par région. data-actions-justify = alignement du lien CTA dans sa rangée,
     INDÉPENDANT du contenu. data-*-hide = visibilité responsive. order non câblé ici (le
     côté média est déjà piloté par data-reverse calculé en amont). ── */
  .fz__link[data-actions-justify] { display: inline-flex; }
  .fz__text:has(> .fz__link[data-actions-justify='center']) { align-items: center; }
  .fz__text:has(> .fz__link[data-actions-justify='end'])    { align-items: flex-end; }
  .fz__link[data-actions-justify='center'] { align-self: center; }
  .fz__link[data-actions-justify='end']    { align-self: flex-end; }

  /* HIDE-ON (visibilité responsive). 768px = breakpoint structurel. */
  .fz__header[data-header-hide='desktop'],
  .fz__visual[data-media-hide='desktop'],
  .fz__text[data-body-hide='desktop'] { display: none; }
  @media (max-width: 768px) {
    .fz__header[data-header-hide='mobile'],
    .fz__visual[data-media-hide='mobile'],
    .fz__text[data-body-hide='mobile'] { display: none; }
    .fz__header[data-header-hide='desktop'] { display: flex; }
    .fz__visual[data-media-hide='desktop'] { display: block; }
    .fz__text[data-body-hide='desktop'] { display: flex; }
  }

  /* Fallback navigateurs sans container-query : bascule sur media-query viewport. */
  @supports not (container-type: inline-size) {
    @media (min-width: 64rem) {
      .fz__cell {
        grid-template-columns: 1fr 1fr;
        gap: var(--space-9);
      }
      .fz__row[data-reverse='false'] .fz__visual { order: 0; }
      .fz__row[data-reverse='false'] .fz__text   { order: 1; }
      .fz__row[data-reverse='true'] .fz__visual { order: 1; }
      .fz__row[data-reverse='true'] .fz__text   { order: 0; }
    }
  }

  .fz__visual {
    position: relative;
    /* R4 : colonne de grille → min-width:0 (sinon min-content du média peut
       déborder la piste quand on passe de 2 à 1 colonne ou en split asymétrique). */
    min-width: 0;
    border-radius: var(--radius-lg, var(--radius-md, 8px));
    overflow: hidden;
    border: 1px solid var(--hairline);
    background:
      radial-gradient(120% 90% at 80% 16%, rgba(var(--accent-rgb), 0.07), transparent 60%),
      var(--paper-2, var(--paper));
  }
  .fz__visual::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      135deg,
      var(--hairline) 0,
      var(--hairline) 1px,
      transparent 1px,
      transparent 14px
    );
    opacity: 0.4;
    pointer-events: none;
  }

  /* Line-art inline : trait = currentColor du contexte, accent = var(--accent). */
  .fz__art {
    position: relative;
    z-index: 1;
    color: var(--ink);
    line-height: 0;
    padding: clamp(var(--space-4), 3vw, var(--space-7));
  }
  .fz__art :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
  }

  /* Image réelle (webp) : dimensions posées (width/height attrs) → 0 CLS. */
  .fz__img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .fz__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    /* R4 : colonne de grille → min-width:0 pour autoriser le rétrécissement
       (un titre/paragraphe long ne déborde plus la piste ni la page). */
    min-width: 0;
  }

  .fz__text h3 {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: var(--fw-medium);
    color: var(--ink);
    line-height: 1.22;
    margin: 0;
    /* R4 : casse un mot/URL trop long pour qu'il ne déborde jamais la colonne. */
    overflow-wrap: anywhere;
  }

  .fz__text p {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--muted);
    line-height: var(--leading-body);
    margin: 0;
    /* Discipline typo : largeur de colonne confortable pour la lecture. */
    max-width: 52ch;
  }

  /* Touchpoints du bloc : liste à puces discrète (chevron hairline), tokens DS. */ .fz__points li {
    position: relative;
    padding-left: var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--ink);
  }
  .fz__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-top: 1px solid var(--accent);
    border-right: 1px solid var(--accent);
    transform: rotate(45deg);
  }
 .fz__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── Entrée directionnelle au scroll (CSS pur, observer existant scroll-reveal) ──
     État initial : opacity 0 + translateX directionnel (le visuel et le texte
     entrent depuis le côté où ils se posent). Neutralisé quand .is-visible/.in est
     ajouté par l'IntersectionObserver. Reflow-safe : transform/opacity uniquement. */
  .fz__row .fz__visual,
  .fz__row .fz__text {
    opacity: 0;
    transition:
      opacity var(--dur-reveal) var(--ease),
      transform var(--dur-reveal) var(--ease);
    will-change: opacity, transform;
  }
  .fz__row[data-reverse='false'] .fz__visual { transform: translateX(-24px); }
  .fz__row[data-reverse='false'] .fz__text   { transform: translateX(24px); }
  .fz__row[data-reverse='true']  .fz__visual { transform: translateX(24px); }
  .fz__row[data-reverse='true']  .fz__text   { transform: translateX(-24px); }

  .fz__row.is-visible .fz__visual,
  .fz__row.in .fz__visual,
  .fz__row.is-visible .fz__text,
  .fz__row.in .fz__text {
    opacity: 1;
    transform: none;
  }
  /* Micro-stagger : le texte suit le média de peu. */
  .fz__row.is-visible .fz__text,
  .fz__row.in .fz__text {
    transition-delay: 90ms;
  }

  /* ── Mobile + bornage motion (768px) ──
     Sous 768px : ordre de lecture garanti titre→desc→média (le DOM est média-puis-
     texte pour le visuel-first desktop, donc on réordonne le texte AVANT le média à
     l'empilement). On neutralise aussi l'entrée directionnelle (pas de translateX). */
  @media (max-width: 768px) {
    .fz__cell {
      grid-template-columns: 1fr;
    }
    .fz__row .fz__visual,
    .fz__row[data-reverse='true'] .fz__visual,
    .fz__row[data-reverse='false'] .fz__visual { order: 1; }
    .fz__row .fz__text,
    .fz__row[data-reverse='true'] .fz__text,
    .fz__row[data-reverse='false'] .fz__text { order: 0; }

    .fz__row[data-reverse='false'] .fz__visual,
    .fz__row[data-reverse='true']  .fz__visual,
    .fz__row[data-reverse='false'] .fz__text,
    .fz__row[data-reverse='true']  .fz__text {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fz__row .fz__visual,
    .fz__row .fz__text,
    .fz__row[data-reverse='false'] .fz__visual,
    .fz__row[data-reverse='false'] .fz__text,
    .fz__row[data-reverse='true']  .fz__visual,
    .fz__row[data-reverse='true']  .fz__text {
      transform: none;
      transition: none;
      opacity: 1;
    }
  }

  /* ── Alternance des fonds R4 (docs/37 §2.6) · defaut paper = rendu inchange ── */
  .fz[data-bg='paper-2'] { background: var(--paper-2); }
  .fz[data-bg='paper-3'] { background: var(--paper-3); }
  .fz[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .fz[data-bg='ink'] :is(h2, h3, p) { color: var(--paper); }
  .fz[data-bg='ink'] .fz__points li { color: var(--paper); }
  .fz[data-bg='ink'] .fz__art { color: var(--paper); }
  .fz[data-bg='ink'] .fz__visual {
    border-color: rgba(var(--paper-rgb), 0.16);
    background:
      radial-gradient(120% 90% at 80% 16%, rgba(var(--accent-rgb), 0.14), transparent 60%),
      rgba(var(--paper-rgb), 0.04);
  }
  .fz[data-bg='ink'] .fz__visual::before {
    background: repeating-linear-gradient(
      135deg,
      rgba(var(--paper-rgb), 0.1) 0,
      rgba(var(--paper-rgb), 0.1) 1px,
      transparent 1px,
      transparent 14px
    );
  }

  /* ── Damier paper/ink par bloc (opt-in via data-alternate) ──
     1 bloc sur 2 (nth-child even) rend en contraste inverse. On remap les rôles
     locaux (--muted / --hairline) vers leurs équivalents sur ink, modèle du bloc
     [data-bg='ink'] ci-dessus. Le média de ce bloc doit être la variante -ink.webp
     (choix porté par le contenu, manifeste §5.5). Absent/false = rendu inchangé. */
  .fz[data-alternate='true'] .fz__row:nth-child(even) {
    background: var(--ink);
    color: var(--paper);
    --muted: rgba(var(--paper-rgb), 0.64);
    --hairline: rgba(var(--paper-rgb), 0.14);
    border-radius: var(--radius-lg, var(--radius-md, 8px));
    padding: clamp(var(--space-6), 4cqi, var(--space-9));
  }
  .fz[data-alternate='true'] .fz__row:nth-child(even) :is(h3) { color: var(--paper); }
  .fz[data-alternate='true'] .fz__row:nth-child(even) .fz__text p { color: var(--muted); }
