---
/**
 * masthead-bar · « Bande masthead-breadcrumb » (chrome, famille hero)
 * Bande de chrome haut autonome : fil d'Ariane intégré dans le masthead éditorial,
 * posée sous le header fixe, AU-DESSUS du hero. Remplace .breadcrumb-bar par le
 * pattern « couverture de revue » (4 colonnes mono uppercase).
 * Compose MastheadRow (molécule) avec la prop `breadcrumb` (cellule 1 = trail).
 * Props-driven (data), variante paper/ink via `background`. CSS chrome : global.css.
 */
import type { SectionByType } from '../../schemas/sections';
import MastheadRow from '../ui/molecules/MastheadRow.astro';

interface Crumb { label: string; href?: string; }
interface Props {
  data?: SectionByType<'masthead-bar'>;
  items?: Crumb[];
  lang: 'fr' | 'en';
  background?: 'paper' | 'ink';
  locations?: string;
  status?: string;
}
const { data, items, lang, background, locations, status } = Astro.props;
const isFr = lang === 'fr';

const bg = data?.background ?? background;
const tone = bg === 'ink' ? 'ink' : 'paper';

const crumbs = data
  ? data.breadcrumb.map((c) => ({ label: isFr ? c.label_fr : c.label_en, href: c.href }))
  : (items ?? []);

const loc = data ? (isFr ? data.locations_fr : data.locations_en) : locations;
const st = data ? (isFr ? data.status_fr : data.status_en) : status;
---
<div class="masthead-bar" data-bg={tone === 'ink' ? 'ink' : undefined}>
  <div class="wrap-wide">
    <MastheadRow
      tone={tone}
      breadcrumb={crumbs}
      locations={loc ?? undefined}
      status={st ?? undefined}
    />
  </div>
</div>
