---
/**
 * hero-asymmetric-grid · « Grille multi-lignes asymétrique » (X3, famille éditoriale/journal)
 * Héro FULL-VIEWPORT, 3 rangées empilées. R1 → titre serif accent pleine largeur.
 * R2 → 2-col (gauche label + lede + 2 CTA / droite label + bullets ›). R3 → bande
 * 4 KPI, dont la DERNIÈRE cellule inversée ink (relève sur fond paper, dans les 2 modes).
 * Props-driven (data), variante paper/ink via `background`, responsive 1-col/2-col ≤768.
 * Source visuelle : src/components/library/hero-explore/HeroX3.astro.
 */
import type { SectionByType } from '@waimia/ds-kernel';
import Button from '../ui/atoms/Button.astro';

interface Props {
  data: SectionByType<'hero-asymmetric-grid'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';

const h1 = isFr ? data.h1_fr : data.h1_en;
const labelLeft = isFr ? data.label_left_fr : data.label_left_en;
const labelRight = isFr ? data.label_right_fr : data.label_right_en;
const lede = isFr ? data.lede_fr : data.lede_en;
const bullets = data.bullets ?? [];
const kpis = data.kpis;
const ctaPrimary = data.cta_primary;
const ctaSecondary = data.cta_secondary;
---
<section class="hag" data-bg={data.background === 'ink' ? 'ink' : undefined}>
  <div class="wrap-wide">
    {/* R1 · titre pleine largeur */}
    <h1 class="hag-title" set:html={h1} />

    {/* R2 · 2 colonnes asymétriques */}
    <div class="hag-row2">
      <div class="hag-left">
        {labelLeft && <p class="hag-label">{labelLeft}</p>}
        <p class="hag-lede">{lede}</p>
        <div class="hag-ctas">
          <Button href={ctaPrimary.href} variant="primary" size="lg">
            {isFr ? ctaPrimary.label_fr : ctaPrimary.label_en}
          </Button>
          {ctaSecondary && (
            <Button href={ctaSecondary.href} variant="ghost" size="lg">
              {isFr ? ctaSecondary.label_fr : ctaSecondary.label_en}
            </Button>
          )}
        </div>
      </div>
      <div class="hag-right">
        {labelRight && <p class="hag-label">{labelRight}</p>}
        <ul class="hag-bullets">
          {bullets.map((b) => (
            <li class="hag-bullet">
              <span class="hag-arrow" aria-hidden="true">›</span>
              <span>{isFr ? b.text_fr : b.text_en}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* R3 · bande 4 KPI, dernière cellule inversée ink */}
    <ul class="hag-kpis" aria-label={isFr ? 'Indicateurs clés' : 'Key metrics'}>
      {kpis.map((k, i) => (
        <li class="hag-kpi" data-ink={i === kpis.length - 1 ? 'true' : undefined}>
          <span class="hag-kpi-num">{k.num}</span>
          <span class="hag-kpi-cap">{isFr ? k.cap_fr : k.cap_en}</span>
        </li>
      ))}
    </ul>
  </div>

  <style>
    .hag {
      background: var(--paper);
      color: var(--ink);
      border-bottom: 1px solid var(--hairline);
      /* Full-viewport : occupe le 1er écran sans déborder sous le header sticky */
      min-height: 100vh;
      min-height: calc(var(--viewport-h) - var(--hero-chrome-above));
      display: flex;
      flex-direction: column;
      justify-content: center;
      box-sizing: border-box;
      padding-top: calc(var(--header-height) + var(--space-7));
      padding-bottom: var(--space-7);
    }
    .hag[data-bg='ink'] { background: var(--ink); color: var(--paper); }

    /* R1 · titre */
    .hag-title {
      font-family: var(--font-sans);
      font-size: var(--text-h1);
      line-height: var(--leading-h1);
      letter-spacing: -0.015em;
      font-weight: var(--fw-semibold);
      max-width: 20ch;
      margin: 0 0 var(--space-8);
    }
    .hag-title :global(.acc) { font-family: var(--font-display); font-weight: var(--fw-regular); letter-spacing: var(--tracking-display); font-style: italic; color: var(--accent-text); }

    /* R2 · 2 colonnes */
    .hag-row2 {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-9);
      padding-top: var(--space-7);
      border-top: 1px solid var(--hairline);
      margin-bottom: var(--space-8);
    }
    .hag-label {
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono);
      text-transform: uppercase;
      color: var(--accent-text);
      margin: 0 0 var(--space-5);
    }
    .hag-left { display: flex; flex-direction: column; }
    .hag-lede {
      font-family: var(--font-sans);
      font-size: var(--text-body);
      line-height: var(--leading-body);
      color: var(--muted);
      max-width: 48ch;
      margin: 0 0 var(--space-6);
      text-wrap: pretty;
    }
    .hag-ctas { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: auto; }

    /* Bullets · flèche › accent, hairline entre puces */
    .hag-bullets { list-style: none; margin: 0; padding: 0; }
    .hag-bullet {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: var(--space-3);
      align-items: baseline;
      padding: var(--space-3) 0;
      border-bottom: 1px solid var(--hairline);
      font-family: var(--font-sans);
      font-size: var(--text-body);
      line-height: var(--leading-lede);
      color: var(--ink);
    }
    .hag[data-bg='ink'] .hag-bullet { color: var(--paper); }
    .hag-bullet:last-child { border-bottom: none; }
    .hag-arrow { color: var(--accent-text); font-weight: var(--fw-semibold); }

    /* R3 · bande KPI 4-col, hairlines, dernière cellule inversée ink */
    .hag-kpis {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border-top: 1px solid var(--hairline);
    }
    .hag-kpi {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding: var(--space-5) var(--space-5) var(--space-5) 0;
      border-right: 1px solid var(--hairline);
    }
    .hag-kpi:last-child { border-right: none; padding-right: 0; }
    .hag-kpi:not(:first-child) { padding-left: var(--space-5); }
    /* Cellule inversée ink · « relève » sur fond paper ET ink */
    .hag-kpi[data-ink='true'] {
      background: var(--ink);
      color: var(--paper);
      border-radius: var(--radius-md);
      border-right: none;
      padding: var(--space-5);
    }
    .hag-kpi-num {
      font-family: var(--font-display);
      font-size: var(--text-numeral-md);
      line-height: 1;
      letter-spacing: var(--tracking-display);
      color: var(--accent-text);
      font-weight: var(--fw-regular);
    }
    .hag-kpi-cap {
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono-tight);
      text-transform: uppercase;
      color: var(--muted);
    }

    @media (max-width: 768px) {
      .hag {
        padding-top: calc(var(--header-height) + var(--space-5));
        padding-bottom: var(--space-5);
      }
      .hag-row2 { grid-template-columns: 1fr; gap: var(--space-7); }
      .hag-ctas { margin-top: var(--space-5); }
      .hag-kpis { grid-template-columns: 1fr 1fr; }
      .hag-kpi {
        border-bottom: 1px solid var(--hairline);
        padding: var(--space-4) var(--space-4) var(--space-4) 0;
      }
      .hag-kpi:nth-child(2n) { border-right: none; padding-right: 0; }
      .hag-kpi:nth-child(2n+1) { padding-left: 0; }
      .hag-kpi:not(:nth-child(2n+1)) { padding-left: var(--space-4); }
      .hag-kpi:nth-last-child(-n+2) { border-bottom: none; }
      .hag-kpi[data-ink='true'] { padding: var(--space-5); }
    }
  </style>
</section>
