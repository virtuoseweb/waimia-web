---
// Section catalogue · resource-card-grid (catégorie Content Listing Sections)
// Grille de ressources téléchargeables : type (livre blanc, cookbook, outil), titre,
// description, format, badge gated et CTA. Composé de tokens + Kicker atom.
// Typo (directive 2026-06-11) : masses en var(--font-sans), serif italic réservé au relevé <i>.
import Kicker from '../ui/atoms/Kicker.astro';
import type { SectionByType } from '../../schemas/sections';

interface Props {
  data: SectionByType<'resource-card-grid'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const kicker = isFr ? data.kicker_fr : data.kicker_en;
const h2 = isFr ? data.h2_fr : data.h2_en;
const intro = isFr ? data.intro_fr : data.intro_en;
---
<section class="resource-grid" data-bg={data.background}>
  <div class="wrap-wide">
    {(kicker || h2 || intro) && (
      <div class="resource-grid__hd">
        {kicker && <Kicker tone="accent">{kicker}</Kicker>}
        {h2 && <h2 class="resource-grid__h2" set:html={h2} />}
        {intro && <p class="resource-grid__intro">{intro}</p>}
      </div>
    )}
    <div class="resource-grid__list" data-cols={data.columns}>
      {data.resources.map((r) => {
        const desc = isFr ? r.desc_fr : r.desc_en;
        const ctaLabel = (isFr ? r.cta_label_fr : r.cta_label_en) ?? (isFr ? 'Télécharger' : 'Download');
        return (
          <a class="resource-card" href={r.href}>
            <div class="resource-card__top">
              <Kicker as="span" tone="accent" class="resource-card__kind">{isFr ? r.kind_fr : r.kind_en}</Kicker>
              {r.gated && <span class="resource-card__gated">{isFr ? 'Inscription' : 'Sign-up'}</span>}
            </div>
            <h3 class="resource-card__title u-serif-accent">{isFr ? r.title_fr : r.title_en}</h3>
            {desc && <p class="resource-card__desc">{desc}</p>}
            <div class="resource-card__foot">
              {r.format && <span class="resource-card__format">{r.format}</span>}
              <span class="resource-card__cta">{ctaLabel} <span aria-hidden="true">→</span></span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .resource-grid { padding-block: var(--section-base); }

  .resource-grid__hd {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-9);
    max-width: 760px;
  }
  .resource-grid__h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h2-section);
    line-height: var(--leading-h3);
    letter-spacing: -0.02em;
    font-weight: var(--fw-medium);
    text-wrap: balance;
    margin: 0;
  }
  .resource-grid__h2 :global(i),
  .resource-grid__h2 :global(i.acc) { font-family: var(--font-display); font-style: italic; color: var(--accent-text); }
  .resource-grid__intro {
    font-family: var(--font-sans);
    font-size: var(--text-body-base);
    line-height: var(--leading-body);
    color: var(--muted);
    margin: 0;
  }

  .resource-grid__list { display: grid; gap: var(--space-6); }
  .resource-grid__list[data-cols='2'] { grid-template-columns: repeat(2, 1fr); }
  .resource-grid__list[data-cols='3'] { grid-template-columns: repeat(3, 1fr); }

  .resource-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-7);
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-left: 2px solid var(--accent);
    border-radius: var(--radius-card);
    color: inherit;
    text-decoration: none;
    transition: border-color 280ms var(--ease), transform 280ms var(--ease), box-shadow 280ms var(--ease);
  }
  .resource-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
    border-top-color: var(--accent-text);
    border-right-color: var(--accent-text);
    border-bottom-color: var(--accent-text);
  }

  .resource-card__top { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); }
  .resource-card__gated {
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    padding: 2px var(--space-3);
  }

  .resource-card__title {
    font-family: var(--font-sans);
    font-size: var(--text-h3-card);
    line-height: var(--leading-h3);
    letter-spacing: -0.01em;
    font-weight: var(--fw-semibold);
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }

  .resource-card__desc {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    color: var(--muted);
    margin: 0;
  }

  .resource-card__foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--hairline);
  }
  .resource-card__format {
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    letter-spacing: var(--tracking-mono);
    color: var(--muted);
  }
  .resource-card__cta {
    font-family: var(--font-sans);
    font-size: var(--text-ui);
    font-weight: var(--fw-medium);
    color: var(--accent-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .resource-card { transition: none !important; }
    .resource-card:hover { transform: none !important; }
  }

  @media (max-width: 980px) {
    .resource-grid__list[data-cols='3'] { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .resource-grid__list[data-cols='2'],
    .resource-grid__list[data-cols='3'] { grid-template-columns: 1fr; }
  }

  /* ── Alternance des fonds R4 ── */
  .resource-grid[data-bg='paper-2'] { background: var(--paper-2); }
  .resource-grid[data-bg='paper-3'] { background: var(--paper-3); }

  /* ── Idiome dark (ink) — fond sombre soigné, contraste AA ── */
  .resource-grid[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .resource-grid[data-bg='ink'] :is(h2, h3, p, span, strong) { color: var(--paper); }
  .resource-grid[data-bg='ink'] .resource-grid__intro { color: var(--muted); }
  .resource-grid[data-bg='ink'] .resource-card {
    background: var(--ink-2);
    border-color: var(--hairline);
    border-left-color: var(--accent-text);
  }
  .resource-grid[data-bg='ink'] .resource-card__desc { color: var(--muted); }
  .resource-grid[data-bg='ink'] .resource-card__gated {
    color: var(--muted);
    border-color: var(--hairline);
  }
  .resource-grid[data-bg='ink'] .resource-card__foot { border-top-color: var(--hairline); }
  .resource-grid[data-bg='ink'] .resource-card__format { color: var(--muted); }
  .resource-grid[data-bg='ink'] .resource-card__cta { color: var(--accent-text); }
</style>
