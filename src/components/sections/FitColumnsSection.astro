---
// Section W6 · fit-columns
// Qualification fit/no-fit sur fond ink (2 colonnes Yes/No).
// Source : HubTemplate.astro « FIT / NO FIT » (l.144-165 + CSS .hub-fit* l.248-285)
// - CSS .fit-sec* = COPIE VERBATIM des règles .hub-fit* (mêmes tokens/valeurs).
// Réutilise la molécule FitColumns (ui/molecules/FitColumns.astro), Kicker, Bi, Callout.
import Kicker from '../ui/atoms/Kicker.astro';
import Bi from '../ui/atoms/Bi.astro';
import Callout from '../editorial/Callout.astro';
import FitColumns from '../ui/molecules/FitColumns.astro';
import type { SectionByType } from '@waimia/ds-kernel';
interface Props {
  data: SectionByType<'fit-columns'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const hasKicker = !!(data.kicker_fr || data.kicker_en);
const hasIntro = !!(data.intro_fr || data.intro_en);
const yesItems = isFr ? data.yes_items_fr : data.yes_items_en;
const noItems = isFr ? data.no_items_fr : data.no_items_en;
---
<section class="fit-sec" data-bg={data.background}>
  <div class="wrap-wide">
    {hasKicker && (
      <Kicker tone="dim" class="fit-sec-kicker">
        <Bi fr={data.kicker_fr} en={data.kicker_en} />
      </Kicker>
    )}
    <h2 class="fit-sec-h2 u-serif-accent" set:html={isFr ? data.heading_fr : data.heading_en} />
    {hasIntro && (
      <div class="fit-sec-callout reveal">
        <Callout variant="info" size="sm">
          <Bi fr={data.intro_fr} en={data.intro_en} />
        </Callout>
      </div>
    )}
    <FitColumns
      class="fit-sec-cols reveal-stagger"
      yesTitleFr={data.yes_title_fr} yesTitleEn={data.yes_title_en} yesItems={yesItems}
      noTitleFr={data.no_title_fr} noTitleEn={data.no_title_en} noItems={noItems}
    />
  </div>
</section>

<style>
  /* COPIE VERBATIM de HubTemplate.astro .hub-fit* (l.248-285), préfixe .hub-fit → .fit-sec */
  .fit-sec {
    padding: var(--section-loose) var(--space-6);
    background: var(--ink);
    color: var(--paper);
  }
  :global(.fit-sec-kicker) { display: block; margin-bottom: var(--space-6); }
  .fit-sec-h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    line-height: 0.94;
    letter-spacing: -0.028em;
    color: var(--paper);
    margin: 0 0 60px;
    text-wrap: balance;
    font-weight: var(--fw-medium);
  }
  .fit-sec-callout {
    max-width: 760px;
    margin-bottom: var(--space-9);
  }
  .fit-sec-callout :global(.callout) {
    color: rgba(var(--paper-rgb), 0.72);
    border-left-color: rgba(var(--paper-rgb), 0.28);
    margin: 0;
  }
  .fit-sec-callout :global(.callout-body) { font-family: var(--font-sans); }
  :global(.fit-sec-cols) {
    border-top: 1px solid rgba(var(--paper-rgb), 0.18);
  }
  :global(.fit-sec-cols .fit-col) {
    border-top: 1px solid rgba(var(--paper-rgb), 0.18);
    transition: background var(--dur-trim) var(--ease), transform var(--dur-hover) var(--ease);
  }
  :global(.fit-sec-cols .fit-col:hover) {
    background: rgba(var(--paper-rgb), 0.04);
    transform: translateY(-2px);
  }

  /* ════════ Fonds composables R4 ════════
     Defaut (background absent) ET data-bg='ink' = rendu ink intentionnel inchange.
     Les variantes paper basculent la section en clair + reajustent la molecule
     FitColumns (qui est codee en --paper-rgb) vers des hairlines/texte ink-rgb. */
  .fit-sec[data-bg='ink'] { background: var(--ink); color: var(--paper); }

  .fit-sec[data-bg='paper'],
  .fit-sec[data-bg='paper-2'],
  .fit-sec[data-bg='paper-3'] {
    color: var(--ink);
  }
  .fit-sec[data-bg='paper'] { background: var(--paper); }
  .fit-sec[data-bg='paper-2'] { background: var(--paper-2); }
  .fit-sec[data-bg='paper-3'] { background: var(--paper-3); }

  .fit-sec[data-bg^='paper'] .fit-sec-h2 { color: var(--ink); }
  .fit-sec[data-bg^='paper'] .fit-sec-callout :global(.callout) {
    color: rgba(var(--ink-rgb), 0.72);
    border-left-color: rgba(var(--ink-rgb), 0.28);
  }
  .fit-sec[data-bg^='paper'] :global(.fit-sec-cols),
  .fit-sec[data-bg^='paper'] :global(.fit-sec-cols .fit-col) {
    border-color: var(--hairline);
  }
  .fit-sec[data-bg^='paper'] :global(.fit-sec-cols .fit-col:hover) {
    background: rgba(var(--ink-rgb), 0.03);
  }
  .fit-sec[data-bg^='paper'] :global(.fit-col-no) { border-left-color: var(--hairline); }
  .fit-sec[data-bg^='paper'] :global(.fit-k-muted) { color: var(--muted); }
  .fit-sec[data-bg^='paper'] :global(.fit-col li) {
    border-top-color: var(--hairline);
    color: var(--ink);
  }
</style>
