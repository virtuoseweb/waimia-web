---
// Section W6 · architecture-diagram
// Diagramme SVG signature : 6 canaux entrée → système central → 4 sorties.
// Source markup : promotion VERBATIM de `SystemArchitecture.astro` (FIG II · 2.5).
import ChapterLabel from '../ui/atoms/ChapterLabel.astro';
import type { SectionByType } from '@waimia/ds-kernel';

interface Props {
  data: SectionByType<'architecture-diagram'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';

const inputs = isFr ? data.inputs_fr : data.inputs_en;
const outputs = isFr ? data.outputs_fr : data.outputs_en;
// Exemples concrets par canal (absorption du rôle FeatureGrid · tooltip natif SVG)
const inputExamples = (isFr ? data.input_examples_fr : data.input_examples_en) ?? [];

// ── Vague C · Scale (Batch 4) ──
// layout : 'stacked' (header au-dessus, schéma centré pleine largeur, défaut/actuel) ·
// 'split' (header en colonne gauche, diagramme en colonne droite).
const adLayout = data.layout ?? 'stacked';
// Couche atomique : placement.header.align surcharge contentAlign (UN data-attr / région).
const pl = data.placement;
const headerAlign = pl?.header?.align ?? data.contentAlign;
const headerHide = pl?.header?.hideOn;
const mediaHide = pl?.media?.hideOn;
---
<section
  id="system-architecture"
  class="sysarch"
  data-bg={data.background}
  data-layout={adLayout}
  data-proportion={data.proportion}
  data-density={data.density}
  aria-labelledby="sysarch-h2"
>
  <div class="wrap-wide sysarch-wrap">
    <div class="sysarch-head" data-header-align={headerAlign} data-header-hide={headerHide}>
      <header class="sysarch-hd">
        <ChapterLabel
          num={data.fig_num}
          title={isFr ? data.fig_title_fr : data.fig_title_en}
        />
        <span class="sysarch-spec">
          {isFr ? data.spec_fr : data.spec_en}
        </span>
      </header>

      <h2 id="sysarch-h2" class="sysarch-h2 reveal u-serif-accent" set:html={isFr ? data.h2_fr : data.h2_en} />
    </div>

    <figure class="sysarch-fig reveal reveal-fade" data-media-hide={mediaHide}>
      <svg
        class="sysarch-svg"
        viewBox="0 0 880 360"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        focusable="false"
        role="presentation"
      >
        {/* 6 channels (left column) · pills rect + label mono · <title> = exemple concret au hover */}
        {inputs.map((label, i) => {
          // Colonne centrée verticalement sur le centre du système (y=180)
          const inStep = 52;
          const inGroupH = (inputs.length - 1) * inStep + 36;
          const inY0 = 180 - inGroupH / 2;
          const y = inY0 + i * inStep;
          return (
            <>
              <g class="sysarch-node">
                {inputExamples[i] && <title>{inputExamples[i]}</title>}
                <rect x="20" y={y} width="148" height="36" rx="2" fill="transparent" stroke="var(--ink-2)" stroke-width="1" stroke-opacity="0.6"/>
                <text x="94" y={y + 23} text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="var(--ink)" letter-spacing="0.06em" textLength="132" lengthAdjust="spacingAndGlyphs">{label.toUpperCase()}</text>
              </g>
              {/* connector curve channel → bord du cercle (440-84=356) · dessinée au scroll (pathLength normalisé) */}
              <path class="sysarch-flow" pathLength="1" style={`transition-delay: ${120 + i * 90}ms`} d={`M168 ${y + 18} C 260 ${y + 18}, 320 180, 356 180`} stroke="var(--accent)" stroke-width="1" stroke-opacity="0.5" fill="none"/>
              {/* small dot at channel exit */}
              <circle cx="168" cy={y + 18} r="2" fill="var(--accent)"/>
            </>
          );
        })}

        {/* Central system node · large circle accent · double-stroke */}
        <circle cx="440" cy="180" r="84" fill="rgba(var(--accent-rgb), 0.06)" stroke="var(--accent)" stroke-width="1.4"/>
        <circle cx="440" cy="180" r="92" fill="transparent" stroke="var(--accent)" stroke-width="0.6" stroke-opacity="0.4" stroke-dasharray="2 4"/>
        <text x="440" y="172" text-anchor="middle" font-family="var(--font-display)" font-size="20" fill="var(--accent)" font-style="italic">{data.system_label}</text>
        <text x="440" y="192" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--ink)" letter-spacing="0.1em">{data.system_kicker}</text>
        <text x="440" y="206" text-anchor="middle" font-family="var(--font-mono)" font-size="7.5" fill="var(--ink-2)" letter-spacing="0.04em" textLength="150" lengthAdjust="spacingAndGlyphs">{data.system_subtitle}</text>

        {/* 4 outputs (right column) · pills + label */}
        {outputs.map((label, i) => {
          // Colonne centrée verticalement sur le centre du système (y=180)
          const outStep = 62;
          const outGroupH = (outputs.length - 1) * outStep + 36;
          const outY0 = 180 - outGroupH / 2;
          const y = outY0 + i * outStep;
          return (
            <>
              {/* connector curve bord du cercle (440+84=524) → output · dessinée après les entrées */}
              <path class="sysarch-flow" pathLength="1" style={`transition-delay: ${760 + i * 90}ms`} d={`M524 180 C 624 180, 660 ${y + 18}, 716 ${y + 18}`} stroke="var(--accent)" stroke-width="1" stroke-opacity="0.6" fill="none"/>
              <circle cx="716" cy={y + 18} r="2" fill="var(--accent)"/>
              <rect x="716" y={y} width="148" height="36" rx="2" fill="rgba(var(--accent-rgb), 0.04)" stroke="var(--accent)" stroke-width="1" stroke-opacity="0.7"/>
              <text x="790" y={y + 23} text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="var(--ink)" letter-spacing="0.06em" textLength="132" lengthAdjust="spacingAndGlyphs">{label.toUpperCase()}</text>
            </>
          );
        })}

        {/* Feedback loop arc · output → system → channel (cycle d'amélioration continue) */}
        {data.show_loop && (
          <>
            <path class="sysarch-loop" d="M790 332 C 600 350, 280 350, 94 332" stroke="var(--ink-2)" stroke-width="0.8" stroke-opacity="0.35" fill="none" stroke-dasharray="4 4"/>
            <text x="440" y="346" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--ink-2)" letter-spacing="0.18em">{isFr ? data.loop_label_fr : data.loop_label_en}</text>
          </>
        )}
      </svg>

      <figcaption class="sysarch-cap u-serif-accent" set:html={isFr ? data.caption_fr : data.caption_en} />
    </figure>
  </div>
</section>

<style>
  .sysarch {
    padding: var(--section-base) 0;
    border-bottom: 1px solid var(--hairline);
    background: var(--paper);
  }

  .sysarch-hd {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--hairline);
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .sysarch-spec {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--muted);
    letter-spacing: 0.1em;
  }

  /* H2 token sémantique unifié · cf tokens.css */
  .sysarch-h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-display);
    max-width: 880px;
    margin: 0 0 var(--space-7);
    font-weight: var(--fw-medium);
    text-wrap: balance;
    color: var(--ink);
  }

  .sysarch-fig {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    transition-delay: var(--dur-fast);
  }

  .sysarch-svg {
    width: 100%;
    max-width: 860px;
    height: auto;
    max-height: 320px;
    display: block;
  }

  .sysarch-cap {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-h3);
    line-height: 1.35;
    color: var(--ink);
    max-width: var(--wrap-prose);
    text-align: center;
    text-wrap: balance;
    margin: 0;
  }

  /* Flux dessinés au scroll · pathLength=1 normalisé · le .in vient du scroll-reveal (.reveal-fade) */
  .sysarch-flow {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset var(--dur-reveal) var(--ease);
  }
  .sysarch-fig:is(.in, .is-visible) .sysarch-flow { stroke-dashoffset: 0; }

  /* Boucle d'amélioration continue · le pointillé circule (raconte la réinjection) */
  @keyframes sysarch-loop-flow {
    to { stroke-dashoffset: -16; }
  }
  .sysarch-fig:is(.in, .is-visible) .sysarch-loop {
    animation: sysarch-loop-flow 2.4s linear infinite;
  }

  /* Hover nœud d'entrée · le canal s'affirme (tooltip <title> porte l'exemple concret) */
  .sysarch-node { cursor: help; }
  .sysarch-node rect { transition: stroke var(--dur-fast) var(--ease), stroke-opacity var(--dur-fast) var(--ease); }
  .sysarch-node:hover rect { stroke: var(--accent); stroke-opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .sysarch-flow { stroke-dashoffset: 0; transition: none; }
    .sysarch-fig:is(.in, .is-visible) .sysarch-loop { animation: none; }
  }

  /* ── Vague C · Scale (Batch 4) ── */
  /* Layout SPLIT · header (label+spec+titre) en colonne gauche, diagramme en colonne droite.
     Défaut absent = 'stacked' (block flow, rendu actuel inchangé). En split, le titre perd sa
     marge basse (la colonne gère l'espacement), et le SVG se cale en haut de sa colonne. */
  .sysarch[data-layout='split'] .sysarch-wrap {
    display: grid;
    grid-template-columns: minmax(0,2fr) minmax(0,3fr);
    gap: clamp(var(--space-8), 5vw, var(--space-12));
    align-items: center;
  }
  .sysarch[data-layout='split'] .sysarch-head { align-self: center; }
  .sysarch[data-layout='split'] .sysarch-h2 { margin-bottom: 0; }
  .sysarch[data-layout='split'] .sysarch-fig { align-self: center; }

  /* Axe PROPORTION (data-proportion) · ratio header|diagramme, SPLIT uniquement. minmax(0,..). */
  .sysarch[data-layout='split'][data-proportion='1-1'] .sysarch-wrap { grid-template-columns: minmax(0,1fr) minmax(0,1fr); }
  .sysarch[data-layout='split'][data-proportion='1-2'] .sysarch-wrap { grid-template-columns: minmax(0,1fr) minmax(0,2fr); }
  .sysarch[data-layout='split'][data-proportion='2-1'] .sysarch-wrap { grid-template-columns: minmax(0,2fr) minmax(0,1fr); }
  .sysarch[data-layout='split'][data-proportion='2-3'] .sysarch-wrap { grid-template-columns: minmax(0,2fr) minmax(0,3fr); }
  .sysarch[data-layout='split'][data-proportion='3-2'] .sysarch-wrap { grid-template-columns: minmax(0,3fr) minmax(0,2fr); }

  /* Axe DENSITY (data-density) · marge sous le titre (stacked) + gap des colonnes (split). */
  .sysarch[data-density='compact'] .sysarch-h2 { margin-bottom: var(--space-5); }
  .sysarch[data-density='ample']   .sysarch-h2 { margin-bottom: var(--space-9); }
  .sysarch[data-layout='split'][data-density='compact'] .sysarch-wrap { gap: var(--space-7); }
  .sysarch[data-layout='split'][data-density='ample']   .sysarch-wrap { gap: var(--space-12); }

  /* Axe CONTENT-ALIGN (data-header-align) · alignement du bloc header. Défaut start = actuel. */
  .sysarch-head[data-header-align='center'] { text-align: center; }
  .sysarch-head[data-header-align='center'] .sysarch-hd { justify-content: center; }
  .sysarch-head[data-header-align='end'] { text-align: end; }
  .sysarch-head[data-header-align='end'] .sysarch-hd { justify-content: flex-end; }

  /* COUCHE ATOMIQUE · hideOn (visibilité responsive). 768px = breakpoint structurel. */
  .sysarch-head[data-header-hide='desktop'],
  .sysarch-fig[data-media-hide='desktop'] { display: none; }
  @media (max-width: 768px) {
    /* Split → empilé sous 768px (header dessus, diagramme dessous : ordre de lecture logique). */
    .sysarch[data-layout='split'] .sysarch-wrap { grid-template-columns: 1fr; gap: var(--space-7); }
    .sysarch[data-layout='split'] .sysarch-h2 { margin-bottom: var(--space-6); }
    .sysarch-head[data-header-hide='mobile'],
    .sysarch-fig[data-media-hide='mobile'] { display: none; }
    .sysarch-head[data-header-hide='desktop'] { display: block; }
    .sysarch-fig[data-media-hide='desktop'] { display: flex; }
  }

  /* Mobile : SVG plus petit, H2 réduit */
  @media (max-width: 700px) {
    .sysarch-h2 { font-size: var(--text-h2); }
    .sysarch-svg { max-height: 240px; }
  }
  /* ── Alternance des fonds R4 · defaut paper (clair) = rendu inchange ──
     Le SVG lit --ink / --ink-2 via fill/stroke inline : les remapper suffit
     a basculer textes + traits sur fond sombre (accent inchange, deja lisible). */
  .sysarch[data-bg='paper-2'] { background: var(--paper-2); }
  .sysarch[data-bg='paper-3'] { background: var(--paper-3); }
  .sysarch[data-bg='ink'] {
    background: var(--ink);
  }
  .sysarch[data-bg='ink'] :is(.sysarch-h2, .sysarch-cap) { color: var(--paper); }
  .sysarch[data-bg='ink'] .sysarch-spec { color: var(--muted); }
  /* SVG : remap --ink / --ink-2 SUR le svg (pas la section, sinon background:var(--ink)
     deviendrait clair). Les fill/stroke inline pointent ces vars -> deviennent clairs. */
  .sysarch[data-bg='ink'] .sysarch-svg {
    --ink: var(--paper);
    --ink-2: rgba(var(--paper-rgb), 0.7);
  }
</style>
