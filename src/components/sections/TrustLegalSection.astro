---
// Section catalogue · trust-legal-section
// Extraction du masthead + TOC sticky de TrustLegalTemplate.astro.
import type { SectionByType } from '@waimia/ds-kernel';
import { langFromPath } from '../../lib/i18n';
import Bi from '../ui/atoms/Bi.astro';
import Kicker from '../ui/atoms/Kicker.astro';

interface TrustSection {
  id: string;
  title_fr: string;
  title_en: string;
}

interface Props {
  data?: SectionByType<'trust-legal-section'>;
  lang?: 'fr' | 'en';
  title?: string;
  description?: string;
  kickerFr?: string;
  kickerEn?: string;
  revisedAt?: string;
  version?: string;
  sections?: TrustSection[];
  legalFooterFr?: string;
  legalFooterEn?: string;
}

const {
  data,
  lang = langFromPath(Astro.url.pathname),
  title,
  description,
  kickerFr,
  kickerEn,
  revisedAt,
  version,
  sections,
  legalFooterFr,
  legalFooterEn,
} = Astro.props as Props;

const isFr = lang === 'fr';
const finalTitle = title ?? (isFr ? data?.h1_fr : data?.h1_en) ?? '';
const finalDescription = description ?? (isFr ? data?.lede_fr : data?.lede_en) ?? '';
const finalKickerFr = kickerFr ?? data?.kicker_fr ?? '';
const finalKickerEn = kickerEn ?? data?.kicker_en ?? finalKickerFr;
const finalRevisedAt = revisedAt ?? data?.revised_at ?? '';
const finalVersion = version ?? data?.version;
const tocSections = sections ?? data?.sections ?? [];
const finalLegalFooterFr = legalFooterFr ?? data?.legal_footer_fr ?? 'Document interne';
const finalLegalFooterEn = legalFooterEn ?? data?.legal_footer_en ?? 'Internal document';

const revisedLabel = finalRevisedAt
  ? new Date(finalRevisedAt).toLocaleDateString(isFr ? 'fr-FR' : 'en-GB', { month: 'long', year: 'numeric' })
  : null;
---

<section class="trust-hd" data-bg={data?.background}>
  <div class="wrap-wide">
    <Kicker class="trust-kicker"><Bi fr={finalKickerFr} en={finalKickerEn} /></Kicker>
    <h1 class="trust-h1 reveal u-serif-accent">
      {Astro.slots.has('headline') ? <slot name="headline" /> : <Fragment set:html={finalTitle} />}
    </h1>
    <p class="trust-lede reveal">
      {Astro.slots.has('lede') ? <slot name="lede" /> : <Fragment set:html={finalDescription} />}
    </p>
    {revisedLabel && (
      <div class="trust-meta">
        <Bi fr="Dernière révision" en="Last revised" /> ·
        <time datetime={finalRevisedAt}>{revisedLabel}</time>
        {finalVersion && <><span aria-hidden> · </span><span>{finalVersion}</span></>}
      </div>
    )}
    <footer class="trust-legal-footer">
      {finalVersion
        ? <><Bi fr={finalLegalFooterFr} en={finalLegalFooterEn} /> <span class="trust-footer-version">{finalVersion}</span></>
        : <><slot name="footer-legal"><Bi fr={finalLegalFooterFr} en={finalLegalFooterEn} /></slot></>
      }
    </footer>
  </div>
</section>

<div class="trust-body">
  <div class="wrap-wide trust-grid">
    <aside class="trust-toc reveal-stagger" aria-label={isFr ? 'Sommaire' : 'Table of contents'}>
      <Kicker class="trust-toc-k"><Bi fr="Sommaire" en="Contents" /></Kicker>
      <ol>
        {tocSections.map((s, i) => (
          <li>
            <a href={`#${s.id}`}>
              <span class="trust-toc-num u-meta-mono">{String(i + 1).padStart(2, '0')}</span>
              <span><Bi fr={s.title_fr} en={s.title_en} /></span>
            </a>
          </li>
        ))}
      </ol>
    </aside>

    <article class="trust-sections reveal-stagger">
      {Astro.slots.has('sections')
        ? <slot name="sections" />
        : <Fragment set:html={(isFr ? data?.body_html_fr : data?.body_html_en) ?? ''} />}
    </article>
  </div>
</div>

<style>
  .trust-hd {
    padding: calc(var(--header-height) + var(--space-8)) var(--space-6) var(--space-10);
    border-bottom: 1px solid var(--hairline);
  }
  :global(.trust-kicker) { display: block; margin-bottom: var(--space-5); }
  .trust-h1 {
    font-family: var(--font-sans);
    font-size: var(--text-display);
    line-height: 0.94;
    letter-spacing: -0.028em;
    text-wrap: balance;
    font-weight: var(--fw-semibold);
    margin: 0;
  }
  .trust-lede {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: var(--fw-medium);
    color: var(--ink-2);
    margin: var(--space-6) 0 var(--space-5);
    max-width: 760px;
    line-height: var(--leading-lede);
    text-wrap: pretty;
  }
  .trust-meta {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.1em;
    color: var(--muted);
    text-transform: uppercase;
  }
  .trust-legal-footer {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--muted);
    margin-top: var(--space-8);
    padding-top: 20px;
    border-top: 1px solid var(--hairline);
    letter-spacing: var(--tracking-mono-tight);
  }
  .trust-footer-version { color: var(--muted); }

  .trust-body { padding: var(--section-loose) var(--space-6); }
  .trust-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-10);
  }
  .trust-toc {
    position: sticky;
    top: 100px;
    align-self: start;
  }
  :global(.trust-toc-k) { display: block; margin-bottom: var(--space-4); }
  .trust-toc ol {
    list-style: none;
    padding: 14px 0 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-lede);
    border-top: 1px solid var(--hairline);
  }
  .trust-toc a {
    color: var(--ink-2);
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: var(--space-2);
    align-items: baseline;
    transition: color var(--dur-trim) var(--ease);
  }
  .trust-toc a:hover { color: var(--accent-text); } .trust-sections {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-prose);
    color: var(--ink-2);
    max-width: 780px;
  }
  .trust-sections :global(section) {
    padding: var(--space-10) 0;
    border-top: 1px solid var(--hairline);
  }
  .trust-sections :global(section):first-child {
    border-top: none;
    padding-top: 0;
  }
  .trust-sections :global(h2) {
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    line-height: var(--leading-h2);
    letter-spacing: -0.02em;
    font-weight: var(--fw-medium);
    margin: 0 0 36px;
    text-wrap: balance;
  }
  .trust-sections :global(h2 i) { font-family: var(--font-display); font-style: italic; font-weight: var(--fw-regular); color: var(--accent-text); }
  .trust-sections :global(h3) {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: 1.22;
    font-weight: var(--fw-medium);
    margin: var(--space-7) 0 var(--space-3);
    color: var(--ink);
  }
  .trust-sections :global(h3 i), .trust-sections :global(h3 em) { font-family: var(--font-display); font-style: italic; font-weight: var(--fw-regular); color: var(--accent-text); }
  .trust-sections :global(p) { margin: 0 0 1.2em; }
  .trust-sections :global(ul) { margin: 0 0 1.4em 1.5em; }
  .trust-sections :global(li) { margin-bottom: 0.5em; }
  .trust-sections :global(a) {
    color: var(--accent-text);
    border-bottom: 1px solid currentColor;
  }

  @media (max-width: 900px) {
    .trust-grid { grid-template-columns: 1fr; }
    .trust-toc {
      position: static;
      padding-bottom: var(--space-5);
      border-bottom: 1px solid var(--hairline);
    }
  }

  /* ── Axe déclinaison #118 : fond du masthead (défaut ABSENT = paper, rendu inchangé).
     paper-2/paper-3 = bande d'en-tête teintée ; ink = masthead sur encre (textes en paper).
     Le corps + TOC restent inchangés (l'axe ne cible que la bande d'en-tête). ── */
  .trust-hd[data-bg='paper-2'] { background: var(--paper-2); }
  .trust-hd[data-bg='paper-3'] { background: var(--paper-3); }
  .trust-hd[data-bg='ink'] {
    background: var(--ink);
    border-bottom-color: rgba(var(--paper-rgb), 0.14);
  }
  .trust-hd[data-bg='ink'] .trust-h1 { color: var(--paper); }
  .trust-hd[data-bg='ink'] .trust-lede { color: rgba(var(--paper-rgb), 0.72); }
  .trust-hd[data-bg='ink'] .trust-meta,
  .trust-hd[data-bg='ink'] .trust-legal-footer,
  .trust-hd[data-bg='ink'] .trust-footer-version { color: rgba(var(--paper-rgb), 0.55); }
  .trust-hd[data-bg='ink'] .trust-legal-footer { border-top-color: rgba(var(--paper-rgb), 0.14); }
  .trust-hd[data-bg='ink'] :global(.trust-kicker) { color: rgba(var(--paper-rgb), 0.7); }
</style>
