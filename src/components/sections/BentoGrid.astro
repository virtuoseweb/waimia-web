---
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'bento-grid'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';

const cells = data.cells ?? [];
---

<section class="bento-grid">
  <div class="wrap-wide">
    <div class="bento-grid__header">
      {(isFr ? data.kicker_fr : data.kicker_en) && (
        <Kicker tone="muted">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      )}
      <h2 set:html={isFr ? data.h2_fr : data.h2_en} />
    </div>

    <ul class="bento-grid__mosaic">
      {cells.map((cell: (typeof cells)[number], i: number) => (
        <li class={`bento-grid__cell bento-grid__cell--${i + 1}`}>
          {cell.glyph && (
            <span class="bento-grid__glyph" aria-hidden="true">{cell.glyph}</span>
          )}
          <strong class="bento-grid__title">{isFr ? cell.title_fr : cell.title_en}</strong>
          <p class="bento-grid__body">{isFr ? cell.body_fr : cell.body_en}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .bento-grid {
    padding-block: var(--spacing-section);
    border-bottom: 1px solid var(--hairline);
  }

  .bento-grid__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--spacing-block);
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2-section);
    line-height: var(--leading-h3);
    color: var(--ink);
    margin: 0;
  }
  h2 :global(i) { font-style: italic; }

  /* Grille bento : 5 cellules en 3 colonnes x 2 lignes
     Cellule 1 : grande, occupe col 1-2 / row 1-2 (2x2)
     Cellules 2-5 : petites 1x1 */
  .bento-grid__mosaic {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto;
    gap: var(--space-4);
  }

  .bento-grid__cell {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    padding: clamp(24px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--paper);
    transition:
      transform 280ms var(--ease),
      box-shadow 280ms var(--ease);
  }

  /* Cellule grande : 2 colonnes x 2 lignes */
  .bento-grid__cell--1 {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
    gap: var(--space-5);
    padding: clamp(32px, 4vw, 56px);
  }

  /* Cellules petites : positionnement explicite col 3 */
  .bento-grid__cell--2 { grid-column: 3; grid-row: 1; }
  .bento-grid__cell--3 { grid-column: 3; grid-row: 2; }

  /* 4e et 5e cellules : rangee basse (row 3), 3 colonnes */
  .bento-grid__cell--4 {
    grid-column: 1;
    grid-row: 3;
  }
  .bento-grid__cell--5 {
    grid-column: 2 / 4;
    grid-row: 3;
  }

  /* Hover lift subtil */
  .bento-grid__cell:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }

  .bento-grid__glyph {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    color: var(--accent);
    line-height: 1;
    margin-bottom: var(--space-1);
  }

  .bento-grid__title {
    font-family: var(--font-display);
    font-size: clamp(16px, 1.4vw, 22px);
    font-weight: var(--fw-regular);
    color: var(--ink);
    line-height: 1.2;
  }

  /* Titre plus grand dans la cellule principale */
  .bento-grid__cell--1 .bento-grid__title {
    font-size: clamp(20px, 2vw, 30px);
  }

  .bento-grid__body {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Responsive : 1 colonne empilee sous 760px */
  @media (max-width: 760px) {
    .bento-grid__mosaic {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: var(--space-3);
    }

    .bento-grid__cell--1,
    .bento-grid__cell--2,
    .bento-grid__cell--3,
    .bento-grid__cell--4,
    .bento-grid__cell--5 {
      grid-column: 1;
      grid-row: auto;
    }
  }

  /* Tablette : 2 colonnes, cellule 1 sur toute la largeur */
  @media (min-width: 761px) and (max-width: 1023px) {
    .bento-grid__mosaic {
      grid-template-columns: repeat(2, 1fr);
    }

    .bento-grid__cell--1 {
      grid-column: 1 / 3;
      grid-row: 1;
    }

    .bento-grid__cell--2 { grid-column: 1; grid-row: 2; }
    .bento-grid__cell--3 { grid-column: 2; grid-row: 2; }
    .bento-grid__cell--4 { grid-column: 1; grid-row: 3; }
    .bento-grid__cell--5 { grid-column: 2; grid-row: 3; }
  }
</style>
