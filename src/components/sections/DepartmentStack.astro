---
// Section W6 · department-stack (famille Solutions)
// Stack outils en table éditoriale : header (eyebrow + h2) + aside Callout + EditorialTable.
// Source : SolutionsDetailTemplate.astro (markup l.410-434, CSS scoped l.473-518 + l.855-858).
// - markup/CSS = COPIE VERBATIM des styles scoped legacy token-only (0 hex brut).
// - n'inclut PAS les règles .stack-card (chemin mort : legacy rend toujours EditorialTable).
import Callout from '../editorial/Callout.astro';
import EditorialTable from '../editorial/EditorialTable.astro';
import Kicker from '../ui/atoms/Kicker.astro';
import type { SectionByType } from '../../schemas/sections';
interface Props {
  data: SectionByType<'department-stack'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const eyebrow = isFr ? data.eyebrow_fr : data.eyebrow_en;
const h2 = isFr ? data.h2_fr : data.h2_en;
const aside = isFr ? data.aside_fr : data.aside_en;
const caption = isFr ? data.caption_fr : data.caption_en;
const columns = isFr ? data.columns_fr : data.columns_en;
const rows = data.rows.map((r) => [
  isFr ? r.category_fr : r.category_en,
  r.tool,
  isFr ? r.role_fr : r.role_en,
]);
---
<section class="sol-sec sol-sec-paper sol-tools reveal" data-screen-label="06 Stack">
  <div class="wrap g12 g12--full">
    <header class="sol-sec-hd section-eyebrow col-prose">
      <Kicker as="span" tone="accent" class="eyebrow">{eyebrow}</Kicker>
      <h2 set:html={h2} />
    </header>
    <aside class="sol-aside col-aside">
      <Callout variant="note" size="sm">
        {aside ? (
          <Fragment set:html={aside} />
        ) : (
          <>Le triptyque Anthropic primary + intégrations métier secondary + open source pour l'orchestration.</>
        )}
      </Callout>
    </aside>
    <div class="sol-stack-grid col-12">
      <EditorialTable
        caption={caption}
        columns={columns}
        rows={rows}
        variant="editorial"
      />
    </div>
  </div>
</section>

<style>
  /* ───── Sec common — COPIE VERBATIM SolutionsDetailTemplate l.473-518 ───── */
  .sol-sec { padding: var(--section-base) 0; position: relative; }
  .sol-tools { margin-top: var(--section-base); }
  .sol-sec-paper {
    padding-block: var(--section-base);
    background: var(--paper-2);
    border-block: 1px solid var(--hairline);
  }
  .sol-sec-hd {
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  /* Kicker canonisé (R4) · typo portée par l'atome Kicker, ici layout seul */
  .section-eyebrow :global(.eyebrow) {
    display: inline-block;
    margin-bottom: var(--space-3);
  }
  .sol-sec-hd h2 {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 72px);
    line-height: var(--leading-h1);
    letter-spacing: -0.018em;
    font-weight: var(--fw-regular);
    margin: var(--space-2) 0 0;
  }
  .sol-sec-hd :global(i) { color: var(--accent); font-style: italic; }
  .sol-aside {
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: var(--leading-body);
    color: var(--muted);
    font-style: italic;
    max-width: 480px;
    margin: 0;
  }
  .sol-aside :global(.callout) {
    margin: 0;
  }

  /* ───── Department Stack — COPIE VERBATIM l.855-858 (EditorialTable porte son propre style) ───── */
  .sol-stack-grid {
    display: block;
    border-top: 1px solid var(--hairline);
  }
</style>
