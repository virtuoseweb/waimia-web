---
// Section catalogue · hero-atlas
// Source fidèle : `src/pages/atlas.astro` `.hero-atlas`.
import type { SectionByType } from '../../schemas/sections';

interface Props {
  data: SectionByType<'hero-atlas'>;
  lang: 'fr' | 'en';
}

const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---

<section class="hero-atlas">
  <div class="signature-grid"></div>
  <div class="hero-atlas-inner">
    <div class="hero-atlas-body">
      <div class="kick">
        <span class="kick-dot" aria-hidden="true"></span>
        <span>{isFr ? data.kicker_fr : data.kicker_en}</span>
      </div>
      <h1 class="hero-atlas-title reveal-mask-up" set:html={isFr ? data.h1_fr : data.h1_en} />
      <p class="hero-atlas-subhead" set:html={isFr ? data.subhead_fr : data.subhead_en} />
      <p class="hero-atlas-lead" set:html={isFr ? data.lead_fr : data.lead_en} />
      <div class="hero-atlas-ctas">
        <a href={data.cta_primary.href} class="btn btn-primary btn-lg" data-mag="0.18">
          {isFr ? data.cta_primary.label_fr : data.cta_primary.label_en} <span aria-hidden>→</span>
        </a>
        {data.cta_secondary && (
          <a href={data.cta_secondary.href} class="btn btn-ghost btn-lg">
            {isFr ? data.cta_secondary.label_fr : data.cta_secondary.label_en}
          </a>
        )}
      </div>
    </div>

    <aside class="atlas-mini-map" aria-label={isFr ? data.map_aria_label_fr : data.map_aria_label_en}>
      <div class="amm-kicker">
        <span class="amm-dot" aria-hidden="true"></span>
        {isFr ? data.map_kicker_fr : data.map_kicker_en}
      </div>
      <ul class="amm-list">
        {data.pillars.map((pillar) => (
          <li class="amm-item">
            <span class="amm-num">{pillar.num}</span>
            <div class="amm-content">
              <span class="amm-label">{isFr ? pillar.label_fr : pillar.label_en}</span>
              <span class="amm-desc">{isFr ? pillar.desc_fr : pillar.desc_en}</span>
              <span class="amm-deliverable">{isFr ? pillar.deliverable_fr : pillar.deliverable_en}</span>
            </div>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</section>

<style>
  .hero-atlas {
    position: relative;
    padding: clamp(72px,7vw,108px) var(--gut) clamp(48px,5vw,72px);
    overflow: hidden;
    border-bottom: 1px solid var(--hairline);
  }
  .hero-atlas .signature-grid { z-index: 0 }
  .hero-atlas > *:not(.signature-grid) { position: relative; z-index: 1 }
  .signature-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--hairline) 1px, transparent 1px),
      linear-gradient(to bottom, var(--hairline) 1px, transparent 1px);
    background-size: 64px 64px;
    opacity: .22;
    mask-image: radial-gradient(circle at 70% 25%, black 0, transparent 62%);
  }
  .hero-atlas-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(48px,5vw,80px);
    align-items: start;
    max-width: 1500px;
    margin: 0 auto;
  }
  .kick {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-5);
  }
  .kick-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--accent);
    flex-shrink: 0;
  }
  .hero-atlas-title {
    font-family: var(--font-display);
    font-size: clamp(40px,6.5vw,96px);
    line-height: 0.94;
    letter-spacing: -0.03em;
    font-weight: var(--fw-regular);
    text-wrap: balance;
    max-width: var(--wrap-read);
  }
  .hero-atlas-title :global(i) { font-style: italic; color: var(--accent) }
  .hero-atlas-lead {
    font-family: var(--font-sans);
    font-size: var(--text-lede);
    color: var(--ink-2);
    margin-top: var(--space-5);
    max-width: 640px;
    line-height: 1.45;
    text-wrap: pretty;
  }
  .hero-atlas-subhead {
    font-family: var(--font-display);
    font-size: clamp(20px, 2vw, 28px);
    line-height: 1.3;
    color: var(--ink);
    margin-top: var(--space-4);
    max-width: var(--wrap-prose);
    text-wrap: balance;
    font-weight: var(--fw-regular);
  }
  .hero-atlas-subhead :global(i) {
    font-style: italic;
    color: var(--accent);
  }
  .hero-atlas-ctas {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-7);
    flex-wrap: wrap;
    align-items: center;
  }
  .atlas-mini-map {
    border-left: 1px solid var(--hairline);
    padding-left: clamp(24px,3vw,40px);
    padding-top: var(--space-1);
  }
  .amm-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 28px;
    line-height: 1;
  }
  .amm-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--accent);
    flex-shrink: 0;
  }
  .amm-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .amm-item {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding: clamp(14px,1.8vw,20px) 0;
    border-top: 1px solid var(--hairline);
  }
  .amm-item:last-child { border-bottom: 1px solid var(--hairline) }
  .amm-num {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: .08em;
    color: var(--accent);
    flex-shrink: 0;
    padding-top: 2px;
    line-height: 1;
  }
  .amm-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .amm-label {
    font-family: var(--font-display);
    font-size: clamp(15px,1.4vw,18px);
    font-weight: var(--fw-regular);
    letter-spacing: -0.01em;
    color: var(--ink);
    line-height: var(--leading-h3);
  }
  .amm-desc {
    font-family: var(--font-sans);
    font-size: clamp(12px,1vw,13px);
    color: var(--ink-2);
    line-height: var(--leading-lede);
  }
  .amm-deliverable {
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent);
    line-height: 1;
    margin-top: var(--space-2);
  }
  @media (max-width: 860px) {
    .hero-atlas-inner {
      grid-template-columns: 1fr;
    }
    .atlas-mini-map {
      border-left: none;
      border-top: 1px solid var(--hairline);
      padding-left: 0;
      padding-top: clamp(24px,4vw,36px);
      margin-top: clamp(24px,4vw,36px);
    }
    .amm-list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }
    .amm-item:nth-child(odd) { border-right: 1px solid var(--hairline); padding-right: var(--space-4) }
    .amm-item:nth-child(even) { padding-left: var(--space-4) }
    .amm-item:last-child { border-bottom: none }
  }
  @media (max-width: 520px) {
    .amm-list { grid-template-columns: 1fr }
    .amm-item:nth-child(odd) { border-right: none; padding-right: 0 }
    .amm-item:nth-child(even) { padding-left: 0 }
    .amm-item:last-child { border-bottom: 1px solid var(--hairline) }
  }
</style>
