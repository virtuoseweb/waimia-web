---
// Section catalogue · hero-atlas
// Source fidèle : `src/pages/atlas.astro` `.hero-atlas`.
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'hero-atlas'>;
  lang: 'fr' | 'en';
}

const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---

<section class="hero-atlas" data-bg={data.background}>
  <div class="signature-grid"></div>
  <div class="hero-atlas-inner">
    <div class="hero-atlas-body">
      <Kicker letterSpacing=".16em" class="kick">
        <span class="kick-dot" aria-hidden="true"></span>
        <span>{isFr ? data.kicker_fr : data.kicker_en}</span>
      </Kicker>
      <h1 class="hero-atlas-title reveal-mask-up u-serif-accent" set:html={isFr ? data.h1_fr : data.h1_en} />
      <p class="hero-atlas-subhead" set:html={isFr ? data.subhead_fr : data.subhead_en} />
      <p class="hero-atlas-lead" set:html={isFr ? data.lead_fr : data.lead_en} />
      <div class="hero-atlas-ctas">
        <a href={data.cta_primary.href} class="btn btn-primary btn-lg" data-mag="0.18">
          {isFr ? data.cta_primary.label_fr : data.cta_primary.label_en} <span aria-hidden>→</span>
        </a>
        {data.cta_secondary && (
          <a href={data.cta_secondary.href} class="btn btn-ghost btn-lg">
            {isFr ? data.cta_secondary.label_fr : data.cta_secondary.label_en}
          </a>
        )}
      </div>
    </div>

    <aside class="atlas-mini-map" aria-label={isFr ? data.map_aria_label_fr : data.map_aria_label_en}>
      <Kicker size={10} letterSpacing=".16em" class="amm-kicker">
        <span class="amm-dot" aria-hidden="true"></span>
        {isFr ? data.map_kicker_fr : data.map_kicker_en}
      </Kicker>
      <ul class="amm-list">
        {data.pillars.map((pillar) => (
          <li class="amm-item">
            <span class="amm-num">{pillar.num}</span>
            <div class="amm-content">
              <span class="amm-label">{isFr ? pillar.label_fr : pillar.label_en}</span>
              <span class="amm-desc">{isFr ? pillar.desc_fr : pillar.desc_en}</span>
              <span class="amm-deliverable">{isFr ? pillar.deliverable_fr : pillar.deliverable_en}</span>
            </div>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</section>

<style>
  .hero-atlas {
    position: relative;
    padding: var(--section-base) var(--gut) var(--space-9);
    overflow: hidden;
    border-bottom: 1px solid var(--hairline);
  }
  .hero-atlas[data-bg='paper-2'] { background: var(--paper-2); }
  .hero-atlas[data-bg='paper-3'] { background: var(--paper-3); }
  /* Variante dark `ink` · signature préservée en négatif : la signature-grid trace ses
     lignes via var(--hairline) → remapper --hairline vers rgba(var(--paper-rgb),…)
     inverse la grille (lignes claires sur ink) sans toucher au mask radial. */
  .hero-atlas[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
    --hairline: rgba(var(--paper-rgb), 0.16);
  }
  /* Remap des tokens couleur scopé aux ENFANTS (jamais sur le root, sinon
     `background: var(--ink)` ci-dessus utiliserait la valeur remappée). */
  .hero-atlas[data-bg='ink'] > * {
    --ink: rgba(var(--paper-rgb), 0.92);
    --ink-2: rgba(var(--paper-rgb), 0.72);
    --muted: rgba(var(--paper-rgb), 0.64);
    --hairline: rgba(var(--paper-rgb), 0.16);
  }
  .hero-atlas[data-bg='ink'] :is(h1, h2, h3) { color: var(--paper); }
  .hero-atlas[data-bg='ink'] .signature-grid { opacity: .3; }
  .hero-atlas .signature-grid { z-index: 0 }
  .hero-atlas > *:not(.signature-grid) { position: relative; z-index: 1 }
  .signature-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--hairline) 1px, transparent 1px),
      linear-gradient(to bottom, var(--hairline) 1px, transparent 1px);
    background-size: 64px 64px;
    opacity: .22;
    mask-image: radial-gradient(circle at 70% 25%, black 0, transparent 62%);
  }
  .hero-atlas-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-10);
    align-items: start;
    max-width: 1500px;
    margin: 0 auto;
  }
  /* Kicker canonisé (R4) · typo portée par l'atome Kicker, ici layout seul */
  :global(.hero-atlas .kick) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .kick-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--accent);
    flex-shrink: 0;
  }
  .hero-atlas-title {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    line-height: 0.94;
    letter-spacing: -0.03em;
    font-weight: var(--fw-regular);
    text-wrap: balance;
    max-width: var(--wrap-read);
  }
  .hero-atlas-lead {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    color: var(--ink-2);
    margin-top: var(--space-5);
    max-width: 640px;
    line-height: 1.45;
    text-wrap: pretty;
  }
  .hero-atlas-subhead {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.3;
    color: var(--ink);
    margin-top: var(--space-4);
    max-width: var(--wrap-prose);
    text-wrap: balance;
    font-weight: var(--fw-regular);
  }
  .hero-atlas-subhead :global(i) {
    font-style: italic;
    color: var(--accent-text);
  }
  .hero-atlas-ctas {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-7);
    flex-wrap: wrap;
    align-items: center;
  }
  .atlas-mini-map {
    border-left: 1px solid var(--hairline);
    padding-left: var(--space-7);
    padding-top: var(--space-1);
  }
  /* Kicker canonisé (R4) · typo portée par l'atome (fusion tracking .18em -> .16em) */
  :global(.hero-atlas .amm-kicker) {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 28px;
    line-height: 1;
  }
  .amm-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--accent);
    flex-shrink: 0;
  }
  .amm-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .amm-item {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--hairline);
  }
  .amm-item:last-child { border-bottom: 1px solid var(--hairline) }
  .amm-num {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono-tight);
    color: var(--accent-text);
    flex-shrink: 0;
    padding-top: 2px;
    line-height: 1;
  }
  .amm-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .amm-label {
    font-family: var(--font-display);
    font-size: var(--text-small);
    font-weight: var(--fw-regular);
    letter-spacing: -0.01em;
    color: var(--ink);
    line-height: var(--leading-h3);
  }
  .amm-desc {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--ink-2);
    line-height: var(--leading-lede);
  }
  .amm-deliverable {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
    line-height: 1;
    margin-top: var(--space-2);
  }
  @media (max-width: 860px) {
    .hero-atlas-inner {
      grid-template-columns: 1fr;
    }
    .atlas-mini-map {
      border-left: none;
      border-top: 1px solid var(--hairline);
      padding-left: 0;
      padding-top: var(--space-6);
      margin-top: var(--space-6);
    }
    .amm-list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }
    .amm-item:nth-child(odd) { border-right: 1px solid var(--hairline); padding-right: var(--space-4) }
    .amm-item:nth-child(even) { padding-left: var(--space-4) }
    .amm-item:last-child { border-bottom: none }
  }
  @media (max-width: 520px) {
    .amm-list { grid-template-columns: 1fr }
    .amm-item:nth-child(odd) { border-right: none; padding-right: 0 }
    .amm-item:nth-child(even) { padding-left: 0 }
    .amm-item:last-child { border-bottom: 1px solid var(--hairline) }
  }
</style>
