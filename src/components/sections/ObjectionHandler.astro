---
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'objection-handler'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const labelA = isFr ? 'Ce que vous pensez' : 'What you think';
const labelB = isFr ? 'Notre réponse' : 'Our answer';
---

<section class="objection-handler sec-base" data-bg={data.background}>
  <div class="wrap-wide">
  <h2 set:html={isFr ? data.h2_fr : data.h2_en} />
  <div class="objection-handler__table-head">
    <Kicker tone="muted" size={10}>{labelA}</Kicker>
    <Kicker tone="muted" size={10}>{labelB}</Kicker>
  </div>
  <ul class="objection-handler__list">
    {data.objections.map((obj: (typeof data.objections)[number]) => (
      <li class="objection-handler__row">
        <div class="objection-handler__objection">
          <p>{isFr ? obj.objection_fr : obj.objection_en}</p>
        </div>
        <div class="objection-handler__response">
          <p>{isFr ? obj.response_fr : obj.response_en}</p>
        </div>
      </li>
    ))}
  </ul>
  </div>
</section>

<style>
  h2 {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-h2-section);
    line-height: var(--leading-h3);
    color: var(--ink);
    margin: 0 0 var(--spacing-block);
  }
  .objection-handler__table-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    border-bottom: 1px solid var(--hairline);
    padding-bottom: var(--space-3);
  }
  .objection-handler__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .objection-handler__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    border-bottom: 1px solid var(--hairline);
    padding-block: var(--space-5);
  }
  .objection-handler__objection p {
    font-family: var(--font-display);
    font-size: var(--text-h3-card);
    color: var(--muted);
    font-style: italic;
    line-height: var(--leading-body);
    margin: 0;
  }
  .objection-handler__response p {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    color: var(--ink);
    line-height: var(--leading-relaxed);
    margin: 0;
  }
  @media (max-width: 640px) {
    .objection-handler__table-head,
    .objection-handler__row { grid-template-columns: 1fr; }
  }
  /* ── Alternance des fonds R4 (docs/37 §2.6) · defaut paper = rendu inchange ── */
  .objection-handler[data-bg='paper-2'] { background: var(--paper-2); }
  .objection-handler[data-bg='paper-3'] { background: var(--paper-3); }
  .objection-handler[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .objection-handler[data-bg='ink'] :is(h2, h3, p) { color: var(--paper); }
</style>
