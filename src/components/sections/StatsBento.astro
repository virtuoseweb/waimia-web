---
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'stats-bento'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';

const stats = data.stats ?? [];
// Span content-driven : 1ʳᵉ stat = tuile vedette (lg, chiffre géant invert),
// les autres = unité (sm). S'adapte à 2..6 stats via .bento-fluid sans trou.
const spanClass = (i: number): string => (i === 0 ? 'span-lg' : 'span-sm');
---

<section class="stats-bento sec-base" data-bg={data.background}>
  <div class="wrap-wide">
    <div class="stats-bento__header reveal">
      {(isFr ? data.kicker_fr : data.kicker_en) && (
        <Kicker tone="muted">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
      )}
      <h2 class="sec-base-h2" set:html={isFr ? data.h2_fr : data.h2_en} />
    </div>

    <ul class="stats-bento__grid bento-fluid reveal-stagger" aria-label={isFr ? 'Indicateurs clés' : 'Key metrics'}>
      {stats.map((stat: (typeof stats)[number], i: number) => (
        <li class={`stats-bento__cell ${spanClass(i)}`}>
          <span class="stats-bento__number" aria-label={isFr ? stat.label_fr : stat.label_en}>
            {stat.value}
          </span>
          {stat.delta && (
            <span class="stats-bento__delta" aria-hidden="true">{stat.delta}</span>
          )}
          <span class="stats-bento__label">{isFr ? stat.label_fr : stat.label_en}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Scroll-reveal : IntersectionObserver bascule .is-visible
  const targets = document.querySelectorAll<HTMLElement>('.reveal, .reveal-stagger');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );
    targets.forEach((el) => io.observe(el));
  } else {
    // Fallback : tout visible si pas d'IO
    targets.forEach((el) => el.classList.add('is-visible'));
  }
</script>

<style>

  .stats-bento__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--spacing-block);
  }

  /* ─── Grille bento content-driven (2..6 KPI) ───────────────────
     .bento-fluid (grid.css) place les tuiles via auto-fill + auto-flow:dense ;
     la 1ʳᵉ stat reçoit span-lg (vedette, chiffre géant invert), les autres
     span-sm. Aucune position figée → 0 trou quel que soit le nombre de stats.
  ─────────────────────────────────────────────────────────────── */
  .stats-bento__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    --tile-min: 14rem;
  }

  .stats-bento__cell {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xs);
    padding: var(--space-7);
    background: var(--paper);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition:
      transform var(--dur-hover) var(--ease),
      box-shadow var(--dur-hover) var(--ease);
  }

  .stats-bento__cell:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }

  /* Tuile vedette (span-lg) : fond ink, chiffre géant invert, ancrée en bas. */
  .stats-bento__cell.span-lg {
    padding: var(--space-9);
    gap: var(--space-3);
    justify-content: flex-end;
    background: var(--ink);
  }

  .stats-bento__cell.span-lg .stats-bento__number {
    font-size: var(--text-h1);
    color: var(--paper);
    line-height: var(--leading-h2);
  }

  .stats-bento__cell.span-lg .stats-bento__delta {
    color: var(--accent-text);
  }

  .stats-bento__cell.span-lg .stats-bento__label {
    color: var(--paper);
    opacity: 0.65;
    font-size: var(--text-body);
  }

  /* ─── Typo commune ─── */
  .stats-bento__number {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: var(--fw-regular);
    color: var(--ink);
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-display);
    margin: 0;
  }

  .stats-bento__delta {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--accent-text);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }

  .stats-bento__label {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--muted);
    line-height: var(--leading-body);
    margin: 0;
  }

  /* ─── Responsive ───
     Géré par .bento-fluid (grid.css) : auto-fill descend les pistes selon la
     largeur, et < 768px tout s'empile en 1 colonne (spans neutralisés). Aucune
     media query par cran à maintenir ici. */

  /* ── Alternance des fonds R4 (docs/37 §2.6) · defaut paper = rendu inchange ── */
  .stats-bento[data-bg='paper-2'] { background: var(--paper-2); }
  .stats-bento[data-bg='paper-3'] { background: var(--paper-3); }

  /* ── Declinaison dark `ink` (idiome DS, modele BentoGrid) ──────────
     Section ink : cartes secondaires sombres (--ink-2), hero le plus sombre (--ink), texte paper.
     Aligne sur l'idiome BentoGrid (le remap global --muted base-paper sert le texte clair sur fond sombre). */
  .stats-bento[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .stats-bento[data-bg='ink'] :is(h2, h3, p) { color: var(--paper); }

  /* Cellules secondaires : cartes sombres sur fond sombre (alignees sur l'idiome BentoGrid). */
  .stats-bento[data-bg='ink'] .stats-bento__cell {
    background: var(--ink-2);
  }
  /* Cartes secondaires sombres : le `__number` (base --ink) doit passer paper pour rester lisible.
     Le `__label` (var(--muted)) est deja remappe paper par le global ink → lisible sur fond sombre. */
  .stats-bento[data-bg='ink'] .stats-bento__cell .stats-bento__number {
    color: var(--paper);
  }
  /* Tuile vedette : la plus sombre, distincte des secondaires --ink-2 */
  .stats-bento[data-bg='ink'] .stats-bento__cell.span-lg {
    background: var(--ink);
  }
</style>
