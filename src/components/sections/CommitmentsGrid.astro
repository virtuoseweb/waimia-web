---
// Section W6 · commitments-grid
// Grille de garanties/engagements (2–6 colonnes hairline). Source : `meth-garanties-grid` (methode.astro).
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'commitments-grid'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---

<section class="commitments-grid" aria-labelledby="commitments-grid-h2">
  <div class="wrap-wide">
    {(data.kicker_fr || data.kicker_en) && (
      <Kicker as="p" tone="accent" class="commitments-grid__kicker">
        {isFr ? data.kicker_fr : data.kicker_en}
      </Kicker>
    )}
    <h2 id="commitments-grid-h2" class="commitments-grid__h2 reveal">
      {isFr ? data.h2_fr : data.h2_en}
    </h2>
    {(data.body_fr || data.body_en) && (
      <p class="commitments-grid__body">
        {isFr ? data.body_fr : data.body_en}
      </p>
    )}

    <div class="commitments-grid__grid reveal-stagger">
      {data.commitments.map((c) => (
        <div class="commitments-grid__cell">
          <h3 class="commitments-grid__cell-title">{isFr ? c.title_fr : c.title_en}</h3>
          <p class="commitments-grid__cell-body">{isFr ? c.body_fr : c.body_en}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .commitments-grid {
    padding: var(--section-base) 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  /* Kicker canonisé (R4) · typo portée par l'atome Kicker, ici layout seul */
  :global(.commitments-grid__kicker) {
    margin: 0 0 14px;
  }
  .commitments-grid__h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2-section);
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-display);
    font-weight: var(--fw-regular);
    max-width: 760px;
    margin: 0 0 clamp(28px, 3vw, 44px);
    color: var(--ink);
    text-wrap: balance;
  }
  .commitments-grid__body {
    font-family: var(--font-sans);
    font-size: var(--text-body-base);
    line-height: 1.55;
    color: var(--muted);
    max-width: 640px;
    margin: 0 0 clamp(28px, 3vw, 44px);
  }
  .commitments-grid__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--hairline);
  }
  .commitments-grid__cell {
    padding: clamp(28px, 3.5vw, 48px);
    border-right: 1px solid var(--hairline);
  }
  .commitments-grid__cell:last-child {
    border-right: none;
  }
  .commitments-grid__cell-title {
    font-family: var(--font-display);
    font-size: clamp(17px, 1.6vw, 22px);
    line-height: 1.25;
    letter-spacing: -0.018em;
    font-weight: var(--fw-regular);
    color: var(--ink);
    margin: 0 0 var(--space-3);
  }
  .commitments-grid__cell-body {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    line-height: 1.55;
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 800px) {
    .commitments-grid__grid {
      grid-template-columns: 1fr;
    }
    .commitments-grid__cell {
      border-right: none;
      border-bottom: 1px solid var(--hairline);
    }
    .commitments-grid__cell:last-child {
      border-bottom: none;
    }
  }
</style>
