---
import type { SectionByType } from '../../schemas/sections';

interface Props {
  data: SectionByType<'tunnel-step-hero'>;
  lang: 'fr' | 'en';
}

const { data, lang } = Astro.props;
const {
  offre_label,
  step,
  progress_total,
  h1_fr,
  h1_en,
  lede_fr,
  lede_en,
} = data;

const h1      = lang === 'fr' ? h1_fr   : h1_en;
const lede    = lang === 'fr' ? lede_fr  : lede_en;
const kicker  = lang === 'fr'
  ? `Tunnel · ${offre_label} · Étape ${step}/${progress_total}`
  : `Funnel · ${offre_label} · Step ${step}/${progress_total}`;

const padStep = (n: number) => String(n).padStart(2, '0');
---

<section class="tunnel-step-hero wrap-wide">
  <p class="tunnel-step-hero__kicker">{kicker}</p>
  <div
    class="tunnel-step-hero__progress"
    aria-label={lang === 'fr'
      ? `Progression : étape ${step} sur ${progress_total}`
      : `Progress: step ${step} of ${progress_total}`}
  >
    {Array.from({ length: progress_total }, (_, i) => {
      const n = i + 1;
      const active = n === step;
      return (
        <span
          class:list={['tunnel-step-hero__progress-step', active && 'is-active']}
          aria-current={active ? 'step' : undefined}
        >
          [{padStep(n)}]
        </span>
      );
    })}
  </div>
  <h1
    class:list={[
      'tunnel-step-hero__h1 reveal-mask-up',
      step === 1 ? 'tunnel-step-hero__h1--hero' : 'tunnel-step-hero__h1--section',
    ]}
    set:html={h1}
  />
  <p class="tunnel-step-hero__lede">{lede}</p>
</section>

<style>
/* ── Layout ── */
.wrap-wide {
  max-width: 1200px;
  margin-inline: auto;
  padding-inline: var(--gut);
}

/* ── Kicker ── */
.tunnel-step-hero__kicker {
  font-family: var(--font-mono);
  font-size: clamp(10px, 1.1vw, 12px);
  line-height: 1;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: var(--space-6);
  padding-top: clamp(48px, 8vw, 96px);
}

/* ── Progress bar ── */
.tunnel-step-hero__progress {
  display: flex;
  align-items: center;
  gap: 0;
  margin-bottom: var(--space-7);
}
.tunnel-step-hero__progress-step {
  font-family: var(--font-mono);
  font-size: var(--text-eyebrow);
  line-height: 1;
  letter-spacing: .06em;
  color: var(--muted);
  padding-inline: 10px;
  border-right: 1px solid var(--hairline);
}
.tunnel-step-hero__progress-step:first-child { padding-left: 0; }
.tunnel-step-hero__progress-step:last-child  { border-right: none; }
.tunnel-step-hero__progress-step.is-active   { color: var(--accent); }

/* ── H1 ── */
.tunnel-step-hero__h1 {
  font-family: var(--font-display);
  letter-spacing: -.02em;
  line-height: 1.05;
  color: var(--ink);
  margin-bottom: clamp(24px, 3vw, 40px);
  max-width: 18ch;
}
.tunnel-step-hero__h1--hero    { font-size: var(--text-h1-hero); }
.tunnel-step-hero__h1--section { font-size: var(--text-h2-grand); }
.tunnel-step-hero__h1 :global(i),
.tunnel-step-hero__h1 :global(em) {
  font-style: italic;
  color: var(--accent);
}

/* ── Lede ── */
.tunnel-step-hero__lede {
  font-family: var(--font-sans);
  font-size: var(--text-lede);
  line-height: 1.6;
  color: var(--ink);
  max-width: 62ch;
  margin-bottom: clamp(48px, 7vw, 96px);
}

/* ── Section wrapper ── */
.tunnel-step-hero {
  padding-bottom: clamp(48px, 6vw, 80px);
}

/* ── Responsive ── */
@media (max-width: 700px) {
  .tunnel-step-hero__progress {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
  }
  .tunnel-step-hero__progress-step {
    border-right: none;
    border-bottom: 1px solid var(--hairline);
    padding: var(--space-1) 0;
    width: 100%;
  }
  .tunnel-step-hero__progress-step:last-child { border-bottom: none; }
}
</style>
