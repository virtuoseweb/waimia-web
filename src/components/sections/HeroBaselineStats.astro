---
/**
 * hero-baseline-stats · « Mega titre + KPI en baseline » (catalogue X6, famille hero)
 * Héro FULL-VIEWPORT, impact typographique : kicker mono + titre serif géant (text-display)
 * + lede court en tête, rangée de 4 KPI poussée en bas (margin-top:auto) séparée par une
 * hairline forte. Pas de média. CTA optionnel. Distinct de hero-hub-stats (stats sous le lede,
 * pas en baseline poussée d'un stack flex).
 * Props-driven (data), variante paper/ink via `background`, responsive (KPI 2-col ≤768).
 * Source visuelle : src/components/library/hero-explore/HeroX6.astro.
 */
import type { SectionByType } from '@waimia/ds-kernel';
import Button from '../ui/atoms/Button.astro';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'hero-baseline-stats'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';

const kicker = isFr ? data.kicker_fr : (data.kicker_en ?? data.kicker_fr);
const h1 = isFr ? data.h1_fr : data.h1_en;
const lede = isFr ? data.lede_fr : data.lede_en;
const kpis = data.kpis ?? [];
const ctaPrimary = data.cta_primary;
const ctaSecondary = data.cta_secondary;
---
<section class="hbs" data-bg={data.background === 'ink' ? 'ink' : undefined}>
  <div class="wrap-wide hbs-stack">
    <div class="hbs-head">
      {kicker && <Kicker as="p" tone="accent" class="hbs-kicker">{kicker}</Kicker>}
      <h1 class="hbs-title" set:html={h1} />
      <p class="hbs-lede">{lede}</p>
      {ctaPrimary && (
        <div class="hbs-ctas">
          <Button href={ctaPrimary.href} variant="primary" size="lg">
            {isFr ? ctaPrimary.label_fr : ctaPrimary.label_en}
          </Button>
          {ctaSecondary && (
            <Button href={ctaSecondary.href} variant="ghost" size="lg">
              {isFr ? ctaSecondary.label_fr : ctaSecondary.label_en}
            </Button>
          )}
        </div>
      )}
    </div>

    {kpis.length > 0 && (
      <ul class="hbs-kpis" aria-label={isFr ? 'Indicateurs clés' : 'Key indicators'}>
        {kpis.map((k) => (
          <li class="hbs-kpi">
            <span class="hbs-kpi-num">{k.num}</span>
            <span class="hbs-kpi-cap">{isFr ? k.cap_fr : k.cap_en}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  <style>
    .hbs {
      background: var(--paper);
      color: var(--ink);
      border-bottom: 1px solid var(--hairline);
      /* Hauteur naturelle (plancher 70vh via .hbs-stack) : le titre display + les KPI
         baseline ne sont jamais rognes sous le fold, meme quand le contenu depasse 100vh. */
      display: flex;
      flex-direction: column;
      box-sizing: border-box;
      padding-top: calc(var(--header-height) + var(--space-7));
      padding-bottom: var(--space-7);
    }
    .hbs[data-bg='ink'] { background: var(--ink); color: var(--paper); }

    /* Le stack interne s'étire pour pousser les KPI en baseline (margin-top:auto). */
    .hbs-stack {
      display: flex;
      flex-direction: column;
      min-height: 70vh;
    }
    .hbs-head { max-width: none; }

    :global(.hbs-kicker) {
      margin: 0 0 var(--space-5);
    }
    .hbs-title {
      font-family: var(--font-sans);
      font-size: var(--text-display);
      line-height: var(--leading-h1);
      letter-spacing: -0.015em;
      font-weight: var(--fw-semibold);
      max-width: 20ch;
      margin: 0 0 var(--space-5);
    }
    .hbs-title :global(.acc) { font-family: var(--font-display); font-weight: var(--fw-regular); letter-spacing: var(--tracking-display); font-style: italic; color: var(--accent-text); }
    .hbs-lede {
      font-family: var(--font-sans);
      font-size: var(--text-body);
      line-height: var(--leading-body);
      color: var(--muted);
      max-width: 48ch;
      text-wrap: pretty;
      margin: 0;
    }
    .hbs-ctas { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-7); }

    /* Rangée KPI pleine largeur, poussée en bas de la section */
    .hbs-kpis {
      list-style: none;
      margin: 0;
      margin-top: auto;
      padding: var(--space-6) 0 0;
      border-top: 1px solid var(--hairline-strong);
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-6);
    }
    .hbs-kpi {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    .hbs-kpi-num {
      font-family: var(--font-display);
      font-size: var(--text-numeral-md);
      line-height: 1;
      letter-spacing: var(--tracking-display);
      color: var(--accent-text);
      font-weight: var(--fw-regular);
    }
    .hbs-kpi-cap {
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono-tight);
      text-transform: uppercase;
      line-height: var(--leading-lede);
      color: var(--muted);
    }

    @media (max-width: 768px) {
      .hbs {
        padding-top: calc(var(--header-height) + var(--space-5));
        padding-bottom: var(--space-5);
      }
      .hbs-title { max-width: 100%; margin-bottom: var(--space-4); }
      .hbs-kicker { margin-bottom: var(--space-3); }
      .hbs-ctas { margin-top: var(--space-5); }
      /* Sur mobile, on resserre : les KPI suivent le contenu (gap fixe) au lieu d'être
         poussés tout en bas, pour rester près de la ligne de flottaison. */
      .hbs-kpis {
        margin-top: var(--space-7);
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-5) var(--space-4);
      }
    }
  </style>
</section>
