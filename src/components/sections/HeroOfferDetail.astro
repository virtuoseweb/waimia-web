---
// Section catalogue · hero-offer-detail | hero-sector | hero-tech-layer
// Composant canonique géométrie SVG : 3 type-ids, 1 fichier, byte-identique.
import type { SectionByType } from '../../schemas/sections';
import HeroSumie from '../svg/sumie/HeroSumie.astro';
import { resolveHeroSumie } from '../../lib/hero-sumie';

interface Props {
  data: SectionByType<'hero-offer-detail'> | SectionByType<'hero-sector'> | SectionByType<'hero-tech-layer'>;
  lang: 'fr' | 'en';
  transitionId?: string;
  cardTransitionId?: string;
  wrapMax?: string;
  geoReveal?: boolean;
  breadcrumbCurrent?: string;
}
const { data, lang, transitionId, cardTransitionId, wrapMax, geoReveal, breadcrumbCurrent } = Astro.props;
const isFr = lang === 'fr';
const layerType = data.type === 'hero-tech-layer' ? (data.layer_type ?? 'claude') : 'claude';
const offerSumie =
  data.type === 'hero-offer-detail'
    ? resolveHeroSumie(`${data.tier_fr ?? ''} ${data.h1_fr ?? ''}`)
    : data.type === 'hero-sector'
      ? resolveHeroSumie(`${data.dept_fr} ${data.h1_fr}`)
    : 'growth';
---
{data.type === 'hero-sector' ? (
<section class="hero-sector reveal" transition:name={cardTransitionId ? `card-${cardTransitionId}` : undefined}>
  <svg class:list={['hero-sector__geo', geoReveal && 'reveal-blur-clip']} viewBox="0 0 1440 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <rect x="980" y="-40" width="420" height="420" fill="none" stroke="currentColor" stroke-width=".6" opacity=".18" transform="rotate(15 1190 170)"/>
    <rect x="1040" y="20" width="280" height="280" fill="none" stroke="var(--accent)" stroke-width=".4" opacity=".25" transform="rotate(15 1180 160)"/>
    <line x1="0" y1="420" x2="1440" y2="300" stroke="currentColor" stroke-width=".4" opacity=".12"/>
  </svg>
  <div class="hero-sector__wrap">
    <div class="hero-sector__copy">
      <div class="hero-sector__dept">{isFr ? data.dept_fr : data.dept_en}</div>
      <h1 class="hero-sector__title reveal-mask-up" transition:name={transitionId ? `hero-h1-${transitionId}` : undefined} set:html={isFr ? data.h1_fr : data.h1_en} />
      <div class="hero-sector__sub">
        <div class="hero-sector__col">
          <p class="hero-sector__lead reveal reveal-fade" set:html={isFr ? data.lead_fr : data.lead_en} />
          {data.scope && data.scope.length > 0 && (
            <ul class="hero-sector__minimap reveal reveal-fade" aria-label={isFr ? 'Périmètre opérationnel' : 'Operational scope'}>
              {data.scope.map((cell) => (
                <li class="hero-sector__mm-item">
                  <span class="hero-sector__mm-label">{isFr ? cell.label_fr : cell.label_en}</span>
                  <span class="hero-sector__mm-items">{isFr ? cell.items_fr : cell.items_en}</span>
                </li>
              ))}
            </ul>
          )}
          <div class="hero-sector__actions reveal reveal-snap">
            <a class="btn btn-primary" href={data.cta.href}>
              {isFr ? data.cta.label_fr : data.cta.label_en}
            </a>
          </div>
          {data.meta_fr && (
            <p class="hero-sector__caption">{isFr ? data.meta_fr : (data.meta_en ?? data.meta_fr)}</p>
          )}
        </div>
        <div class="hero-sector__col">
          <div class="hero-sector__results-label">{isFr ? (data.results_label_fr ?? '§ Résultats') : (data.results_label_en ?? '§ Results')}</div>
          {data.stats && data.stats.length > 0 ? (
            <ul class="hero-sector__proofs reveal reveal-fade" aria-label={isFr ? 'Preuves de résultats' : 'Result proofs'}>
              {data.stats.map((stat) => (
                <li class="hero-sector__proof">
                  <span class="hero-sector__proof-num">{stat.value}</span>
                  <span class="hero-sector__proof-label">{isFr ? stat.label_fr : stat.label_en}</span>
                </li>
              ))}
            </ul>
          ) : (
            <span class="hero-offer-detail__sumie reveal-zoom-in" aria-hidden="true" transition:name={transitionId ? `hero-img-${transitionId}` : undefined}>
              <HeroSumie name={offerSumie} size="lg" />
            </span>
          )}
        </div>
      </div>
      {data.tags && data.tags.length > 0 && (
        <div class="hero-sector__tags reveal-stagger">
          {data.tags.map((tag) => (
            <span class="hero-sector__tag">{isFr ? tag.label_fr : tag.label_en}</span>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
) : data.type === 'hero-tech-layer' ? (
<section class:list={['hero-tech-layer', `hero-tech-layer--${layerType}`]} transition:name={cardTransitionId ? `card-${cardTransitionId}` : undefined}>
  <svg class:list={['hero-tech-layer__geo', geoReveal && 'reveal-blur-clip']} viewBox="0 0 1440 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true" transition:name={transitionId ? `hero-img-${transitionId}` : undefined}>
    <polygon points="1100,80 1340,80 1220,300" fill="none" stroke="currentColor" stroke-width=".6" opacity=".18"/>
    <polygon points="1160,140 1320,140 1240,280" fill="none" stroke="var(--accent)" stroke-width=".4" opacity=".25"/>
    <polygon points="60,420 280,420 170,580" fill="none" stroke="currentColor" stroke-width=".4" opacity=".12"/>
    <line x1="0" y1="500" x2="1440" y2="380" stroke="currentColor" stroke-width=".3" opacity=".1"/>
  </svg>
  <div class="hero-tech-layer__wrap" style={wrapMax ? `--htl-wrap: ${wrapMax}` : undefined}>
    <div class:list={['hero-tech-layer__layer', `hero-tech-layer__layer--${layerType}`]}>
      {isFr ? data.layer_label_fr : data.layer_label_en}
    </div>
    <h1 class="hero-tech-layer__title reveal-mask-up" transition:name={transitionId ? `hero-h1-${transitionId}` : undefined} set:html={isFr ? data.h1_fr : data.h1_en} />
    <div class="hero-tech-layer__sub">
      <p class="hero-tech-layer__lead reveal" set:html={isFr ? data.lead_fr : data.lead_en} />
      <div class="hero-tech-layer__actions">
        <a class="hero-tech-layer__cta" href={data.cta.href}>{isFr ? data.cta.label_fr : data.cta.label_en}</a>
        {data.meta_fr && (
          <div class="hero-tech-layer__meta">{isFr ? data.meta_fr : (data.meta_en ?? data.meta_fr)}</div>
        )}
      </div>
    </div>
  </div>
</section>
) : (
<section class="hero-offer-detail reveal" transition:name={cardTransitionId ? `card-${cardTransitionId}` : undefined}>
  <svg class:list={['hero-offer-detail__geo', geoReveal && 'reveal-blur-clip']} viewBox="0 0 1440 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true" transition:name={transitionId ? `hero-img-${transitionId}` : undefined}>
    <line x1="0" y1="280" x2="1440" y2="280" stroke="currentColor" stroke-width=".4" opacity=".05"/>
    <line x1="0" y1="440" x2="1440" y2="440" stroke="currentColor" stroke-width=".3" opacity=".03"/>
    <line x1="720" y1="0" x2="720" y2="700" stroke="currentColor" stroke-width=".3" opacity=".04"/>
    <line x1="960" y1="0" x2="960" y2="700" stroke="currentColor" stroke-width=".25" opacity=".03"/>
    <circle cx="1200" cy="120" r="340" fill="none" stroke="currentColor" stroke-width=".5" opacity=".09"/>
    <circle cx="1200" cy="120" r="220" fill="none" stroke="var(--accent)" stroke-width=".35" opacity=".16"/>
    <circle cx="1200" cy="120" r="110" fill="none" stroke="var(--accent)" stroke-width=".25" opacity=".10"/>
    <line x1="0" y1="420" x2="880" y2="170" stroke="currentColor" stroke-width=".3" opacity=".07"/>
    <line x1="1196" y1="118" x2="1204" y2="118" stroke="currentColor" stroke-width=".7" opacity=".22"/>
    <line x1="1200" y1="114" x2="1200" y2="122" stroke="currentColor" stroke-width=".7" opacity=".22"/>
  </svg>
  <div class="hero-offer-detail__wrap" style={wrapMax ? `--hod-wrap: ${wrapMax}` : undefined}>
    {data.breadcrumb_label_fr && (
      <nav class="hero-offer-detail__bc" aria-label={isFr ? "Fil d'Ariane" : 'Breadcrumb'}>
        <a href={data.breadcrumb_href ?? '#'}>{isFr ? data.breadcrumb_label_fr : (data.breadcrumb_label_en ?? data.breadcrumb_label_fr)}</a>
        <span aria-hidden="true">/</span>
        <span>{breadcrumbCurrent ?? (isFr ? data.tier_fr : data.tier_en)}</span>
      </nav>
    )}
    <div class="hero-offer-detail__tier">{isFr ? data.tier_fr : data.tier_en}</div>
    <h1 class="hero-offer-detail__title reveal-mask-up" transition:name={transitionId ? `hero-h1-${transitionId}` : undefined} set:html={isFr ? data.h1_fr : data.h1_en} />
    <div class="hero-offer-detail__sub">
      <div class="hero-offer-detail__col">
        <p class="hero-offer-detail__lead reveal reveal-fade" set:html={isFr ? data.lead_fr : data.lead_en} />
        {data.scope && data.scope.length > 0 && (
          <ul class="hero-offer-detail__minimap reveal reveal-fade" aria-label={isFr ? 'Périmètre opérationnel' : 'Operational scope'}>
            {data.scope.map((cell) => (
              <li class="hero-offer-detail__mm-item">
                <span class="hero-offer-detail__mm-label">{isFr ? cell.label_fr : cell.label_en}</span>
                <span class="hero-offer-detail__mm-items">{isFr ? cell.items_fr : cell.items_en}</span>
              </li>
            ))}
          </ul>
        )}
        <div class="hero-offer-detail__actions reveal reveal-snap">
          <a class="hero-offer-detail__cta" href={data.cta.href}>{isFr ? data.cta.label_fr : data.cta.label_en}</a>
        </div>
        {data.meta_fr && (
          <p class="hero-offer-detail__caption">{isFr ? data.meta_fr : (data.meta_en ?? data.meta_fr)}</p>
        )}
      </div>
      <div class="hero-offer-detail__col">
        <div class="hero-offer-detail__results-label">{isFr ? (data.results_label_fr ?? '§ Résultats') : (data.results_label_en ?? '§ Results')}</div>
        {data.stats && data.stats.length > 0 ? (
          <ul class="hero-offer-detail__proofs reveal reveal-fade" aria-label={isFr ? 'Preuves de résultats' : 'Result proofs'}>
            {data.stats.map((stat) => (
              <li class="hero-offer-detail__proof">
                <span class="hero-offer-detail__proof-num">{stat.value}</span>
                <span class="hero-offer-detail__proof-label">{isFr ? stat.label_fr : stat.label_en}</span>
              </li>
            ))}
          </ul>
        ) : (
          <span class="hero-offer-detail__sumie reveal-zoom-in" aria-hidden="true">
            <HeroSumie name={offerSumie} size="lg" />
          </span>
        )}
      </div>
    </div>
  </div>
</section>
)}

<style>
  /* ── hero-offer-detail ── */
  .hero-offer-detail {
    position: relative;
    padding: clamp(72px, 8vw, 112px) 0 clamp(48px, 5.5vw, 88px);
    overflow: hidden;
    color: var(--ink);
  }
  .hero-offer-detail__geo {
    position: absolute; inset: 0; width: 100%; height: 100%;
    pointer-events: none;
  }
  .hero-offer-detail__sumie {
    width: min(100%, 520px);
    color: var(--ink-2);
    pointer-events: none;
  }
  .hero-offer-detail__sumie :global(svg) { width: 100%; height: auto; }
  .hero-offer-detail__wrap {
    position: relative;
    z-index: 1;
    max-width: var(--hod-wrap, var(--wrap-wide));
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
  }
  .hero-offer-detail__bc {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
    display: flex; gap: var(--space-2); align-items: center;
    margin-bottom: var(--space-5);
  }
  .hero-offer-detail__bc a { color: var(--muted); transition: color 220ms ease; text-decoration: none; }
  .hero-offer-detail__bc a:hover { color: var(--accent); }
  .hero-offer-detail__tier {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
  }
  .hero-offer-detail__title {
    font-family: var(--font-display);
    font-size: clamp(56px, 9vw, 148px);
    line-height: 0.92;
    letter-spacing: -0.028em;
    font-weight: var(--fw-regular);
    margin: 0 0 var(--space-6);
    text-wrap: balance;
  }
  .hero-offer-detail__title :global(i) { color: var(--accent); font-style: italic; }
  /* ── Sub 2 colonnes (calque .hero-sub de la home : hairlines + stretch) ── */
  .hero-offer-detail__sub,
  .hero-sector__sub {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(40px, 5vw, 80px);
    margin-top: var(--space-7);
    padding: var(--space-7) 0 var(--space-7);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    align-items: stretch;
  }
  .hero-offer-detail__col,
  .hero-sector__col {
    display: flex;
    flex-direction: column;
  }
  .hero-offer-detail__lead,
  .hero-sector__lead {
    font-family: var(--font-sans);
    font-size: clamp(20px, 2vw, 26px);
    line-height: var(--leading-lede);
    color: var(--ink);
    font-style: italic;
    margin: 0;
    text-wrap: pretty;
    transition-delay: var(--dur-fast);
  }
  .hero-offer-detail__lead :global(span),
  .hero-sector__lead :global(span) { color: var(--accent); display: block; margin-top: var(--space-2); }

  /* ── Minimap scope (calque .hero-minimap home : grid 3 col, hairlines) ── */
  .hero-offer-detail__minimap,
  .hero-sector__minimap {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--hairline);
    transition-delay: 280ms;
  }
  .hero-offer-detail__mm-item,
  .hero-sector__mm-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-3) var(--space-3) 0;
    border-bottom: 1px solid var(--hairline);
    border-right: 1px solid var(--hairline);
  }
  .hero-offer-detail__mm-item:nth-child(3n),
  .hero-sector__mm-item:nth-child(3n) { border-right: none; }
  .hero-offer-detail__mm-item:nth-last-child(-n+3),
  .hero-sector__mm-item:nth-last-child(-n+3) { border-bottom: none; }
  .hero-offer-detail__mm-item:not(:nth-child(3n+1)),
  .hero-sector__mm-item:not(:nth-child(3n+1)) { padding-left: var(--space-3); }
  .hero-offer-detail__mm-label,
  .hero-sector__mm-label {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .hero-offer-detail__mm-items,
  .hero-sector__mm-items {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    line-height: var(--leading-lede);
    color: var(--ink-2);
  }
  @media (max-width: 700px) {
    .hero-offer-detail__minimap,
    .hero-sector__minimap { grid-template-columns: repeat(2, 1fr); }
    .hero-offer-detail__mm-item:nth-child(3n),
    .hero-sector__mm-item:nth-child(3n) { border-right: 1px solid var(--hairline); }
    .hero-offer-detail__mm-item:nth-child(2n),
    .hero-sector__mm-item:nth-child(2n) { border-right: none; }
    .hero-offer-detail__mm-item:nth-last-child(-n+2),
    .hero-sector__mm-item:nth-last-child(-n+2) { border-bottom: none; }
    .hero-offer-detail__mm-item:nth-last-child(-n+3):not(:nth-last-child(-n+2)),
    .hero-sector__mm-item:nth-last-child(-n+3):not(:nth-last-child(-n+2)) { border-bottom: 1px solid var(--hairline); }
    .hero-offer-detail__mm-item:not(:nth-child(2n+1)),
    .hero-sector__mm-item:not(:nth-child(2n+1)) { padding-left: var(--space-3); }
    .hero-offer-detail__mm-item:nth-child(2n+1),
    .hero-sector__mm-item:nth-child(2n+1) { padding-left: 0; }
  }
  @media (max-width: 440px) {
    .hero-offer-detail__minimap,
    .hero-sector__minimap { grid-template-columns: 1fr; }
    .hero-offer-detail__mm-item, .hero-offer-detail__mm-item:nth-child(n),
    .hero-sector__mm-item, .hero-sector__mm-item:nth-child(n) { border-right: none; padding-left: 0; }
    .hero-offer-detail__mm-item:not(:last-child),
    .hero-sector__mm-item:not(:last-child) { border-bottom: 1px solid var(--hairline); }
    .hero-offer-detail__mm-item:last-child,
    .hero-sector__mm-item:last-child { border-bottom: none; }
  }

  /* ── Actions CTA (calque .hero-ctas home : margin-top, snap delay) ── */
  .hero-offer-detail__actions,
  .hero-sector__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-6);
    align-items: flex-start;
    transition-delay: 400ms;
  }
  .hero-offer-detail__cta {
    display: inline-block;
    padding: 14px var(--space-5);
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-sm);
    font-size: var(--text-body-sm);
    font-weight: var(--fw-medium);
    text-decoration: none;
    letter-spacing: var(--tracking-body);
    border: 1.5px solid var(--ink);
    transition: background 240ms ease, color 240ms ease, transform var(--dur-fast) ease;
  }
  .hero-offer-detail__cta:hover { background: transparent; color: var(--ink); transform: translateY(-1px); }

  /* ── Caption meta (calque .hero-cta-sub home : margin-top auto → push bas) ── */
  .hero-offer-detail__caption,
  .hero-sector__caption {
    margin-top: auto;
    padding-top: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    line-height: var(--leading-body);
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition-delay: 520ms;
  }

  /* ── Results rail (calque .hero-proofs home : flex column space-between) ── */
  .hero-offer-detail__results-label,
  .hero-sector__results-label {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-4);
  }
  .hero-offer-detail__proofs,
  .hero-sector__proofs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    transition-delay: 320ms;
  }
  .hero-offer-detail__proof,
  .hero-sector__proof {
    display: grid;
    grid-template-columns: minmax(110px, 0.4fr) 1fr;
    gap: clamp(16px, 1.8vw, 28px);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--hairline);
  }
  .hero-offer-detail__proof:first-child,
  .hero-sector__proof:first-child { padding-top: 0; }
  .hero-offer-detail__proof:last-child,
  .hero-sector__proof:last-child { border-bottom: 0; }
  .hero-offer-detail__proof-num,
  .hero-sector__proof-num {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.6vw, 64px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--accent);
    font-weight: var(--fw-regular);
  }
  .hero-offer-detail__proof-label,
  .hero-sector__proof-label {
    font-family: var(--font-sans);
    font-size: clamp(14px, 1.05vw, 16px);
    line-height: var(--leading-lede);
    color: var(--ink);
    text-wrap: balance;
  }

  @media (max-width: 768px) {
    .hero-offer-detail__sub,
    .hero-sector__sub { grid-template-columns: 1fr; gap: var(--space-9); }
    .hero-offer-detail__proof,
    .hero-sector__proof { grid-template-columns: 90px 1fr; gap: var(--space-4); }
  }
  @media (max-width: 560px) {
    .hero-offer-detail__proof,
    .hero-sector__proof { grid-template-columns: 1fr; gap: var(--space-1); padding: var(--space-3) 0; }
  }
  /* ── hero-sector ── */
  .hero-sector {
    position: relative;
    padding-top: clamp(80px, 9vw, 120px);
    padding-bottom: clamp(56px, 6vw, 96px);
    overflow: hidden;
    color: var(--ink);
  }
  .hero-sector__geo {
    position: absolute; inset: 0; width: 100%; height: 100%;
    pointer-events: none;
    opacity: 0.08;
    mix-blend-mode: multiply;
  }
  .hero-sector__wrap {
    position: relative;
    z-index: 1;
    max-width: var(--wrap-wide);
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
  }
  .hero-sector__copy { position: relative; z-index: 1; }
  .hero-sector__dept {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
  }
  .hero-sector__title {
    font-family: var(--font-display);
    font-size: clamp(46px, 6.4vw, 108px);
    line-height: var(--leading-h1);
    letter-spacing: -0.028em;
    font-weight: var(--fw-regular);
    margin: 0 0 var(--space-5);
    text-wrap: balance;
  }
  .hero-sector__title :global(i) { color: var(--accent); font-style: italic; }
  .hero-sector__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }
  .hero-sector__tag {
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    padding: var(--space-2) 14px;
    background: rgba(var(--ink-rgb), 0.04);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    transition: border-color 220ms ease, color 220ms ease;
  }
  .hero-sector__tag:hover { border-color: var(--accent); color: var(--accent); }
  /* ── hero-tech-layer ── */
  .hero-tech-layer {
    position: relative;
