---
// Section catalogue · hero-hub-masthead
// COPIE FIDÈLE du `.hub-mast` partagé par offres/cas/secteurs/technologies index
// (réf. src/pages/offres/index.astro:52-64). Padding éditorial + kicker + h1 italic display + lede.
import type { SectionByType } from '../../schemas/sections';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'hero-hub-masthead'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
---
<section class="hero-hub-masthead">
  <div class="wrap-wide">
    <Kicker class="hero-hub-masthead__kicker">{isFr ? data.kicker_fr : data.kicker_en}</Kicker>
    <h1 class="hero-hub-masthead__h1 reveal-mask-up" set:html={isFr ? data.h1_fr : data.h1_en} />
    <p class="hero-hub-masthead__lede" set:html={isFr ? data.lede_fr : data.lede_en} />
  </div>
</section>

<style>
  .hero-hub-masthead { padding: 140px 32px clamp(48px, 6vw, 88px); }
  .wrap-wide { max-width: 1200px; margin-inline: auto; }
  :global(.hero-hub-masthead__kicker) { display: block; margin-bottom: 24px; }
  .hero-hub-masthead__h1 {
    font-family: var(--font-display);
    font-size: clamp(60px, 11vw, 180px);
    font-style: italic;
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .hero-hub-masthead__h1 :global(i) { color: var(--accent); font-style: italic; }
  .hero-hub-masthead__lede {
    font-family: var(--font-sans);
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.65;
    color: var(--muted);
    margin: 32px 0 0;
    max-width: 580px;
  }
</style>
