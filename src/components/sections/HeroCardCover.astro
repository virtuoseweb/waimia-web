---
/**
 * hero-card-cover · « Carte média ink + pills » (pilote X8, famille carte/cover)
 * Héro FULL-VIEWPORT en grille 2-col (texte 1fr / carte 1fr), align center.
 * GAUCHE → kicker mono, titre serif accent, lede court, badges pills mono, 2 CTA.
 * DROITE → une CARTE INK (sombre même en mode paper, via data-bg='ink' interne) qui
 * « relève » sur le fond : média line-art (currentColor) + mini-rangée de 2 KPI.
 * Props-driven (data), variante paper/ink via `background`, responsive 1-col ≤900.
 * Source visuelle : src/components/library/hero-explore/HeroX8.astro.
 */
import type { SectionByType } from '../../schemas/sections';
import Button from '../ui/atoms/Button.astro';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'hero-card-cover'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';

const kicker = isFr ? data.kicker_fr : (data.kicker_en ?? data.kicker_fr);
const h1 = isFr ? data.h1_fr : data.h1_en;
const lede = isFr ? data.lede_fr : data.lede_en;
const badges = data.badges ?? [];
const kpis = data.kpis ?? [];
const mediaAlt = isFr ? data.media_alt_fr : (data.media_alt_en ?? data.media_alt_fr);
const ctaPrimary = data.cta_primary;
const ctaSecondary = data.cta_secondary;
---
<section class="hcc" data-bg={data.background === 'ink' ? 'ink' : undefined}>
  <div class="wrap-wide">
    <div class="hcc-grid">
      {/* Discours éditorial */}
      <div class="hcc-discourse">
        {kicker && <Kicker as="p" tone="accent" class="hcc-kicker">{kicker}</Kicker>}
        <h1 class="hcc-title" set:html={h1} />
        <p class="hcc-lede">{lede}</p>

        {badges.length > 0 && (
          <ul class="hcc-badges" aria-label={isFr ? 'Capacités' : 'Capabilities'}>
            {badges.map((b) => <li class="hcc-badge">{isFr ? b.label_fr : b.label_en}</li>)}
          </ul>
        )}

        <div class="hcc-ctas">
          <Button href={ctaPrimary.href} variant="primary" size="lg">
            {isFr ? ctaPrimary.label_fr : ctaPrimary.label_en}
          </Button>
          {ctaSecondary && (
            <Button href={ctaSecondary.href} variant="ghost" size="lg">
              {isFr ? ctaSecondary.label_fr : ctaSecondary.label_en}
            </Button>
          )}
        </div>
      </div>

      {/* Carte INK : sombre dans les deux modes (paper ET ink) */}
      <div class="hcc-col">
        <div class="hcc-card" data-bg="ink">
          {data.media_src && (
            <figure class="hcc-card-media">
              <img src={data.media_src} alt={mediaAlt ?? ''} loading="eager" decoding="async" />
            </figure>
          )}
          {kpis.length > 0 && (
            <ul class="hcc-card-kpis" aria-label={isFr ? 'Repères clés' : 'Key figures'}>
              {kpis.map((k) => (
                <li class="hcc-kpi">
                  <span class="hcc-kpi-num">{k.num}</span>
                  <span class="hcc-kpi-cap">{isFr ? k.cap_fr : k.cap_en}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </div>
  </div>

  <style>
    .hcc {
      background: var(--paper);
      color: var(--ink);
      border-bottom: 1px solid var(--hairline);
      /* Full-viewport : occupe le 1er écran sans déborder sous le header sticky */
      min-height: 100vh;
      min-height: calc(var(--viewport-h) - var(--hero-chrome-above));
      display: flex;
      flex-direction: column;
      justify-content: center;
      box-sizing: border-box;
      padding-top: calc(var(--header-height) + var(--space-7));
      padding-bottom: var(--space-7);
    }
    .hcc[data-bg='ink'] { background: var(--ink); color: var(--paper); }

    .hcc-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-9);
      align-items: center;
    }
    .hcc-col { min-width: 0; }

    :global(.hcc-kicker) {
      margin: 0 0 var(--space-5);
    }
    .hcc-title {
      margin: 0 0 var(--space-5);
      font-family: var(--font-display);
      font-size: var(--text-display);
      line-height: var(--leading-h1);
      letter-spacing: var(--tracking-display);
      font-weight: var(--fw-regular);
      text-wrap: balance;
    }
    .hcc-title :global(.acc) { font-style: italic; color: var(--accent-text); }
    .hcc-lede {
      margin: 0 0 var(--space-6);
      max-width: 48ch;
      font-family: var(--font-sans);
      font-size: var(--text-body);
      line-height: var(--leading-body);
      color: var(--muted);
      text-wrap: pretty;
    }

    /* Badges · pills mono uppercase, border hairline */
    .hcc-badges {
      list-style: none;
      margin: 0 0 var(--space-7);
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .hcc-badge {
      padding: var(--space-2) var(--space-4);
      border: 1px solid var(--hairline);
      border-radius: var(--radius-pill);
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono-tight);
      text-transform: uppercase;
      color: var(--muted);
      transition: border-color var(--dur-hover) var(--ease), color var(--dur-hover) var(--ease);
    }
    .hcc-badge:hover { border-color: var(--accent-text); color: var(--accent-text); }

    .hcc-ctas { display: flex; flex-wrap: wrap; gap: var(--space-3); }

    /* Carte INK : « relève » sur le fond. data-bg='ink' remap muted/hairline/accent-text. */
    .hcc-card {
      background: var(--ink);
      color: var(--paper);
      border-radius: var(--radius-lg);
      padding: var(--space-7);
      box-shadow: var(--shadow-lift);
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }
    .hcc-card-media {
      margin: 0;
      border: 1px solid var(--hairline);
      border-radius: var(--radius-md);
      padding: clamp(var(--space-6), 4vw, var(--space-10));
      background: rgba(var(--paper-rgb), 0.04);
    }
    .hcc-card-media img {
      display: block;
      width: 100%;
      height: auto;
      max-height: 320px;
      object-fit: contain;
      color: var(--paper);
    }
    .hcc-card-kpis {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }
    .hcc-kpi {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      padding-left: var(--space-4);
      border-left: 1px solid var(--hairline);
    }
    .hcc-kpi-num {
      font-family: var(--font-display);
      font-size: var(--text-numeral-sm);
      line-height: 1;
      color: var(--accent-text);
      font-weight: var(--fw-regular);
    }
    .hcc-kpi-cap {
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono);
      text-transform: uppercase;
      color: var(--muted);
    }

    @media (max-width: 900px) {
      .hcc {
        padding-top: calc(var(--header-height) + var(--space-5));
        padding-bottom: var(--space-5);
      }
      .hcc-grid { grid-template-columns: 1fr; gap: var(--space-5); }
      /* Carte média en bandeau plus court : ne mange plus le 1er écran. */
      .hcc-col { order: -1; }
      .hcc-card { padding: var(--space-6); gap: var(--space-5); }
      .hcc-card-media img { max-height: 30svh; }
      .hcc-title { font-size: var(--text-h1); margin-bottom: var(--space-4); }
      :global(.hcc-kicker) { margin-bottom: var(--space-3); }
      .hcc-lede { margin-bottom: var(--space-5); }
      .hcc-badges { margin-bottom: var(--space-5); }
      .hcc-ctas :global(.btn) { flex: 1 1 auto; justify-content: center; }
    }
    @media (max-width: 480px) {
      .hcc-card-kpis { grid-template-columns: 1fr; gap: var(--space-4); }
    }
  </style>
</section>
