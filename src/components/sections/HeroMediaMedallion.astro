---
/**
 * hero-media-medallion · « Médaillon média + KPI verticaux » (catalogue X5, famille hero)
 * Héro FULL-VIEWPORT en grille 2-col (texte 1.05fr / aside 0.95fr), align center.
 * GAUCHE → kicker mono, titre serif accent, lede court, 2 CTA.
 * DROITE → médaillon média (carte radius-lg, line-art currentColor) empilé sur des KPI
 *          verticaux hairline. Distinct de hero-split-media (média seul, pas de KPI).
 * Props-driven (data), variante paper/ink via `background`, responsive 1-col ≤900.
 * Source visuelle : src/components/library/hero-explore/HeroX5.astro.
 */
import type { SectionByType } from '../../schemas/sections';
import Button from '../ui/atoms/Button.astro';
import Kicker from '../ui/atoms/Kicker.astro';

interface Props {
  data: SectionByType<'hero-media-medallion'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';

const kicker = isFr ? data.kicker_fr : (data.kicker_en ?? data.kicker_fr);
const h1 = isFr ? data.h1_fr : data.h1_en;
const lede = isFr ? data.lede_fr : data.lede_en;
const mediaAlt = isFr ? data.media_alt_fr : (data.media_alt_en ?? data.media_alt_fr);
const kpis = data.kpis ?? [];
const ctaPrimary = data.cta_primary;
const ctaSecondary = data.cta_secondary;
---
<section class="hmm" data-bg={data.background === 'ink' ? 'ink' : undefined}>
  <div class="wrap-wide hmm-grid">
    {/* Texte */}
    <div class="hmm-lead">
      {kicker && <Kicker as="p" tone="accent" class="hmm-kicker">{kicker}</Kicker>}
      <h1 class="hmm-title" set:html={h1} />
      <p class="hmm-lede">{lede}</p>
      <div class="hmm-ctas">
        <Button href={ctaPrimary.href} variant="primary" size="lg">
          {isFr ? ctaPrimary.label_fr : ctaPrimary.label_en}
        </Button>
        {ctaSecondary && (
          <Button href={ctaSecondary.href} variant="ghost" size="lg">
            {isFr ? ctaSecondary.label_fr : ctaSecondary.label_en}
          </Button>
        )}
      </div>
    </div>

    {/* Médaillon média + KPI verticaux */}
    <div class="hmm-aside">
      {data.media_src && (
        <figure class="hmm-medallion">
          <img src={data.media_src} alt={mediaAlt ?? ''} loading="eager" decoding="async" />
        </figure>
      )}
      {kpis.length > 0 && (
        <ul class="hmm-kpis" aria-label={isFr ? 'Indicateurs clés' : 'Key indicators'}>
          {kpis.map((k) => (
            <li class="hmm-kpi">
              <span class="hmm-kpi-num">{k.num}</span>
              <span class="hmm-kpi-cap">{isFr ? k.cap_fr : k.cap_en}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>

  <style>
    .hmm {
      background: var(--paper);
      color: var(--ink);
      border-bottom: 1px solid var(--hairline);
      /* Full-viewport : occupe le 1er écran sans déborder sous le header sticky */
      min-height: 100vh;
      min-height: calc(var(--viewport-h) - var(--hero-chrome-above));
      display: flex;
      flex-direction: column;
      justify-content: center;
      box-sizing: border-box;
      padding-top: calc(var(--header-height) + var(--space-7));
      padding-bottom: var(--space-7);
    }
    .hmm[data-bg='ink'] { background: var(--ink); color: var(--paper); }

    .hmm-grid {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: var(--space-10);
      align-items: center;
    }

    /* ── Colonne gauche ── */
    .hmm-lead { display: flex; flex-direction: column; }
    :global(.hmm-kicker) {
      margin: 0 0 var(--space-5);
    }
    .hmm-title {
      font-family: var(--font-display);
      font-size: var(--text-h1);
      line-height: var(--leading-h1);
      letter-spacing: var(--tracking-display);
      font-weight: var(--fw-regular);
      max-width: 14ch;
      margin: 0 0 var(--space-5);
    }
    .hmm-title :global(.acc) { font-style: italic; color: var(--accent-text); }
    .hmm-lede {
      font-family: var(--font-sans);
      font-size: var(--text-body);
      line-height: var(--leading-body);
      color: var(--muted);
      max-width: 50ch;
      text-wrap: pretty;
      margin: 0 0 var(--space-7);
    }
    .hmm-ctas { display: flex; gap: var(--space-3); flex-wrap: wrap; }

    /* ── Colonne droite : médaillon + KPI ── */
    .hmm-aside { display: flex; flex-direction: column; gap: var(--space-6); }
    .hmm-medallion {
      margin: 0;
      border: 1px solid var(--hairline);
      border-radius: var(--radius-lg);
      background: var(--paper-2);
      padding: var(--space-8);
      color: var(--accent-text);
      box-shadow: var(--shadow-card-rest);
    }
    .hmm[data-bg='ink'] .hmm-medallion { background: var(--ink-2); }
    .hmm-medallion img {
      display: block;
      width: 100%;
      height: auto;
      max-height: var(--space-15);
      object-fit: contain;
      color: var(--ink);
    }
    .hmm[data-bg='ink'] .hmm-medallion img { color: var(--paper); }

    .hmm-kpis { list-style: none; margin: 0; padding: 0; }
    .hmm-kpi {
      display: grid;
      grid-template-columns: minmax(120px, max-content) 1fr;
      gap: var(--space-5);
      align-items: baseline;
      padding: var(--space-4) 0;
      border-top: 1px solid var(--hairline);
    }
    .hmm-kpi:last-child { border-bottom: 1px solid var(--hairline); }
    .hmm-kpi-num {
      font-family: var(--font-display);
      font-size: var(--text-numeral-md);
      line-height: 1;
      letter-spacing: var(--tracking-display);
      color: var(--accent-text);
      font-weight: var(--fw-regular);
    }
    .hmm-kpi-cap {
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono-tight);
      text-transform: uppercase;
      line-height: var(--leading-lede);
      color: var(--muted);
    }

    @media (max-width: 900px) {
      .hmm-grid { grid-template-columns: 1fr; gap: var(--space-8); }
    }
    @media (max-width: 768px) {
      .hmm {
        padding-top: calc(var(--header-height) + var(--space-5));
        padding-bottom: var(--space-5);
      }
      .hmm-grid { gap: var(--space-5); }
      .hmm-aside { gap: var(--space-5); }
      /* Médaillon en bandeau court : il ne mange plus le 1er écran. */
      .hmm-medallion { padding: var(--space-6); }
      .hmm-medallion img { max-height: 30svh; }
      :global(.hmm-kicker) { margin-bottom: var(--space-3); }
      .hmm-title { margin-bottom: var(--space-4); }
      .hmm-lede { margin-bottom: var(--space-5); }
      .hmm-kpi { grid-template-columns: minmax(80px, 0.45fr) 1fr; gap: var(--space-4); }
      .hmm-ctas { gap: var(--space-2); }
      .hmm-ctas :global(.btn) { flex: 1 1 auto; justify-content: center; }
    }
  </style>
</section>
