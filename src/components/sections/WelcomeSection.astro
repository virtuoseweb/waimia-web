---
// Section catalogue · welcome-section
// Extraction du pattern de confirmation post-conversion de WelcomeTemplate.astro.
import type { SectionByType } from '../../schemas/sections';
import { langFromPath } from '../../lib/i18n';
import Kicker from '../ui/atoms/Kicker.astro';
import Bi from '../ui/atoms/Bi.astro';

interface NextStep {
  num: string;
  title_fr: string;
  title_en: string;
  body_fr: string;
  body_en: string;
  ctaLabel?: string;
  ctaHref?: string;
}

interface Props {
  data?: SectionByType<'welcome-section'>;
  lang?: 'fr' | 'en';
  title?: string;
  description?: string;
  kicker?: string;
  nextSteps?: NextStep[];
}

const {
  data,
  lang = langFromPath(Astro.url.pathname),
  title,
  description,
  kicker,
  nextSteps,
} = Astro.props as Props;

const isFr = lang === 'fr';
const finalTitle = title ?? (isFr ? data?.h1_fr : data?.h1_en) ?? '';
const finalDescription = description ?? (isFr ? data?.lede_fr : data?.lede_en) ?? '';
const finalKicker = kicker ?? (isFr ? data?.kicker_fr : data?.kicker_en) ?? '';
const steps = nextSteps ?? data?.next_steps ?? [];
const backHref = data?.back_href ?? (isFr ? '/' : '/en');
const backLabel = isFr ? (data?.back_label_fr ?? "← Retour à l'accueil") : (data?.back_label_en ?? '← Back to home');
---

<section class="welcome">
  <div class="wrap-wide welcome-wrap">
    <div class="welcome-mark" aria-hidden="true">
      <svg viewBox="0 0 64 64" width="64" height="64">
        <circle cx="32" cy="32" r="30" fill="none" stroke="var(--accent)" stroke-width="1.5"/>
        <path d="M 18 32 L 28 42 L 46 22" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <Kicker tone="accent" class="welcome-kicker">{finalKicker}</Kicker>

    <h1 class="welcome-h1 u-serif-accent">
      {Astro.slots.has('headline') ? <slot name="headline" /> : <Fragment set:html={finalTitle} />}
    </h1>
    <p class="welcome-lede">
      {Astro.slots.has('lede') ? <slot name="lede" /> : <Fragment set:html={finalDescription} />}
    </p>

    <ol class="welcome-steps">
      {steps.map((s) => (
        <li class="welcome-step">
          <span class="welcome-step-num">{s.num}</span>
          <div class="welcome-step-body">
            <h2 class="welcome-step-title"><Bi fr={s.title_fr} en={s.title_en} /></h2>
            <p class="welcome-step-text"><Bi fr={s.body_fr} en={s.body_en} /></p>
            {s.ctaLabel && s.ctaHref && (
              <a href={s.ctaHref} class="welcome-step-cta">{s.ctaLabel} →</a>
            )}
          </div>
        </li>
      ))}
    </ol>

    <div class="welcome-foot">
      <slot name="foot">
        <a href={backHref} class="welcome-back">{backLabel}</a>
      </slot>
    </div>
  </div>
</section>

<style>
  .welcome {
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding: var(--section-loose) var(--space-6);
  }
  .welcome-wrap {
    max-width: var(--wrap-prose);
    margin: 0 auto;
    text-align: center;
  }
  .welcome-mark {
    margin: 0 auto var(--space-5);
    width: 64px;
    height: 64px;
  }
  :global(.welcome-kicker) { display: inline-block; margin-bottom: var(--space-4); }
  .welcome-h1 {
    font-family: var(--font-display);
    font-size: var(--text-h2-grand);
    line-height: var(--leading-h1);
    letter-spacing: -0.028em;
    font-weight: var(--fw-regular);
    text-wrap: balance;
    margin: 0 0 20px;
  }
  .welcome-lede {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lede);
    color: var(--ink-2);
    margin: 0 auto 60px;
    max-width: 600px;
    line-height: var(--leading-body);
    text-wrap: pretty;
  }

  .welcome-steps {
    list-style: none;
    padding: 0;
    margin: 0 0 60px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .welcome-step {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 18px;
    padding: var(--space-5);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--paper-2);
    transition: border-color var(--dur-trim) var(--ease);
  }
  .welcome-step:hover { border-color: var(--accent-text); }
  .welcome-step-num {
    font-family: var(--font-display);
    font-size: var(--text-h2-section);
    line-height: 1;
    color: var(--accent-text);
    font-style: italic;
  }
  .welcome-step-title {
    font-family: var(--font-sans);
    font-size: var(--text-h3-row);
    line-height: var(--leading-h3);
    letter-spacing: -0.018em;
    font-weight: var(--fw-medium);
    margin: 0 0 10px;
  }
  .welcome-step-text {
    font-size: var(--text-body-sm);
    color: var(--muted);
    line-height: 1.55;
    margin: 0 0 var(--space-3);
    text-wrap: pretty;
  }
  .welcome-step-cta {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--accent-text);
    letter-spacing: 0.04em;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    transition: color var(--dur-fast) var(--ease);
  }
  .welcome-step-cta:hover { color: var(--accent-sur-clair, var(--accent)); }

  .welcome-foot {
    border-top: 1px solid var(--hairline);
    padding-top: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--muted);
  }
  .welcome-back {
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }
  .welcome-back:hover { color: var(--accent-text); }

  @media (max-width: 600px) {
    .welcome-step { grid-template-columns: 1fr; gap: var(--space-2); }
  }
</style>
