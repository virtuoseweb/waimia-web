---
/**
 * hero-editorial-masthead · « Masthead + KPI 2×2 » (X1, famille éditoriale/journal)
 * Héro FULL-VIEWPORT, pas de média. Bande masthead mono 4-col (col 1 = fil d'Ariane,
 * cellules meta), hairline ; grand titre serif accent ; rangée 2-col → GAUCHE lede +
 * 2 CTA, DROITE 4 KPI en micro-grille 2×2.
 * Props-driven (data), variante paper/ink via `background`, responsive 1-col ≤768.
 * Source visuelle : src/components/library/hero-explore/HeroX1.astro.
 */
import type { SectionByType } from '@waimia/ds-kernel';
import Button from '../ui/atoms/Button.astro';

interface Props {
  data: SectionByType<'hero-editorial-masthead'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';

const h1 = isFr ? data.h1_fr : data.h1_en;
const lede = isFr ? data.lede_fr : data.lede_en;
const breadcrumb = data.breadcrumb ?? [];
const meta = data.meta ?? [];
const kpis = data.kpis;
const ctaPrimary = data.cta_primary;
const ctaSecondary = data.cta_secondary;
---
<section class="hem" data-bg={data.background === 'ink' ? 'ink' : undefined}>
  <div class="wrap-wide">
    {/* Bande masthead · col 1 = fil d'Ariane, cellules meta mono */}
    <div class="hem-masthead">
      <nav class="hem-crumb" aria-label={isFr ? "Fil d'Ariane" : 'Breadcrumb'}>
        {breadcrumb.map((b, i) => {
          const label = isFr ? b.label_fr : b.label_en;
          const isLast = i === breadcrumb.length - 1;
          return (
            <>
              {i > 0 && <span class="hem-sep"> / </span>}
              {isLast || !b.href
                ? <span class="hem-here">{label}</span>
                : <a href={b.href}>{label}</a>}
            </>
          );
        })}
      </nav>
      {meta.map((m, i) => (
        <span class={`hem-meta${i === meta.length - 1 ? ' hem-meta--end' : ''}`}>
          {isFr ? m.label_fr : m.label_en}
        </span>
      ))}
    </div>

    {/* Grand titre serif · accent rendu via set:html */}
    <h1 class="hem-title" set:html={h1} />

    {/* Rangée 2-col · lede + CTA / KPI 2×2 */}
    <div class="hem-row">
      <div class="hem-lede-col">
        <p class="hem-lede">{lede}</p>
        <div class="hem-ctas">
          <Button href={ctaPrimary.href} variant="primary" size="lg">
            {isFr ? ctaPrimary.label_fr : ctaPrimary.label_en}
          </Button>
          {ctaSecondary && (
            <Button href={ctaSecondary.href} variant="ghost" size="lg">
              {isFr ? ctaSecondary.label_fr : ctaSecondary.label_en}
            </Button>
          )}
        </div>
      </div>

      <ul class="hem-kpis" aria-label={isFr ? 'Indicateurs clés' : 'Key metrics'}>
        {kpis.map((k) => (
          <li class="hem-kpi">
            <span class="hem-kpi-num">{k.num}</span>
            <span class="hem-kpi-cap">{isFr ? k.cap_fr : k.cap_en}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <style>
    .hem {
      background: var(--paper);
      color: var(--ink);
      border-bottom: 1px solid var(--hairline);
      /* Full-viewport : occupe le 1er écran sans déborder sous le header sticky */
      min-height: 100vh;
      min-height: calc(var(--viewport-h) - var(--hero-chrome-above));
      display: flex;
      flex-direction: column;
      justify-content: center;
      box-sizing: border-box;
      padding-top: calc(var(--header-height) + var(--space-7));
      padding-bottom: var(--space-7);
    }
    .hem[data-bg='ink'] { background: var(--ink); color: var(--paper); }

    /* Bande masthead · 4 colonnes mono, hairline en bas */
    .hem-masthead {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: var(--space-6);
      align-items: baseline;
      padding-bottom: var(--space-3);
      border-bottom: 1px solid var(--hairline);
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono);
      text-transform: uppercase;
      line-height: 1;
      color: var(--muted);
    }
    .hem-crumb a {
      color: var(--muted);
      text-decoration: none;
      transition: color var(--dur-hover) var(--ease);
    }
    .hem-crumb a:hover { color: var(--accent-text); }
    .hem-sep { color: var(--muted); opacity: 0.6; }
    .hem-here { color: var(--ink); }
    .hem[data-bg='ink'] .hem-here { color: var(--paper); }
    .hem-meta--end { text-align: right; }

    /* Titre serif · accent terracotta */
    .hem-title {
      font-family: var(--font-sans);
      font-size: var(--text-h1);
      line-height: var(--leading-h1);
      letter-spacing: -0.015em;
      font-weight: var(--fw-semibold);
      max-width: 16ch;
      margin: var(--space-7) 0 var(--space-7);
    }
    .hem-title :global(.acc) { font-family: var(--font-display); font-weight: var(--fw-regular); letter-spacing: var(--tracking-display); font-style: italic; color: var(--accent-text); }

    /* Rangée 2 colonnes · lede+CTA / KPI · hairline top */
    .hem-row {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-9);
      padding-top: var(--space-7);
      border-top: 1px solid var(--hairline);
      align-items: start;
    }
    .hem-lede-col { display: flex; flex-direction: column; gap: var(--space-6); }
    .hem-lede {
      font-family: var(--font-sans);
      font-size: var(--text-body);
      line-height: var(--leading-body);
      color: var(--muted);
      max-width: 50ch;
      margin: 0;
      text-wrap: pretty;
    }
    .hem-ctas { display: flex; gap: var(--space-3); flex-wrap: wrap; }

    /* KPI · micro-grille 2×2, cellules séparées par hairlines */
    .hem-kpis {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .hem-kpi {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      padding: var(--space-3) var(--space-5) var(--space-5) 0;
      border-bottom: 1px solid var(--hairline);
      border-right: 1px solid var(--hairline);
    }
    .hem-kpi:nth-child(2n) { border-right: none; padding-right: 0; }
    .hem-kpi:nth-child(2n+1) { padding-left: 0; }
    .hem-kpi:not(:nth-child(2n+1)) { padding-left: var(--space-5); }
    .hem-kpi:nth-last-child(-n+2) { border-bottom: none; padding-bottom: 0; }
    .hem-kpi-num {
      font-family: var(--font-display);
      font-size: var(--text-numeral-md);
      line-height: 1;
      letter-spacing: var(--tracking-display);
      color: var(--accent-text);
      font-weight: var(--fw-regular);
    }
    .hem-kpi-cap {
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono-tight);
      text-transform: uppercase;
      color: var(--muted);
    }

    @media (max-width: 768px) {
      .hem {
        padding-top: calc(var(--header-height) + var(--space-5));
        padding-bottom: var(--space-5);
      }
      .hem-masthead {
        grid-template-columns: 1fr;
        gap: var(--space-3);
      }
      .hem-meta--end { text-align: left; }
      .hem-title { margin: var(--space-6) 0; }
      .hem-row { grid-template-columns: 1fr; gap: var(--space-7); }
    }
  </style>
</section>
