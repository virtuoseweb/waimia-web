---
// Section W6 · roi-band (famille Solutions · BRIQUE SIGNATURE)
// Bande ROI dark : header (eyebrow + h2) + grille de KeyMetric placés en asymétrie 6/5.
// Source : SolutionsDetailTemplate.astro (markup l.328-355, placements l.174-181, CSS scoped l.473-772).
// - markup/CSS = COPIE VERBATIM des styles scoped legacy (tokens var(--*), 0 hex brut).
import KeyMetric from '../editorial/KeyMetric.astro';
import Kicker from '../ui/atoms/Kicker.astro';
import type { SectionByType } from '@waimia/ds-kernel';
interface Props {
  data: SectionByType<'roi-band'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const eyebrow = isFr ? data.eyebrow_fr : data.eyebrow_en;
const h2 = isFr ? data.h2_fr : data.h2_en;
const placements = [
  { class: 'col-6 start-1', size: 'lg' as const, variant: 'default' as const },
  { class: 'col-5 start-8', size: 'lg' as const, variant: 'accent' as const },
  { class: 'col-6 start-1', size: 'md' as const, variant: 'default' as const },
  { class: 'col-5 start-8', size: 'md' as const, variant: 'default' as const },
  { class: 'col-6 start-1', size: 'md' as const, variant: 'default' as const },
  { class: 'col-5 start-8', size: 'md' as const, variant: 'default' as const },
];
---
<section class="sol-sec sec-band-rel sol-sec-dark sol-proof reveal-stagger" data-screen-label="04 ROI Band" data-bg={data.background}>
  <div class="wrap g12 g12--full">
    <header class="sol-roi-hd section-eyebrow col-12">
      <Kicker as="span" tone="accent" class="eyebrow">{eyebrow}</Kicker>
      <h2 class="u-serif-accent" set:html={h2} />
    </header>
    <div class="sol-roi-grid col-12 g12">
      {data.metrics.map((m, i) => {
        const placement = placements[i % placements.length];
        return (
          <div class={placement.class}>
            <KeyMetric
              value={m.value}
              label={(isFr ? m.label_fr : m.label_en).replace(/\n/g, ' ')}
              size={placement.size}
              align="left"
              variant={placement.variant}
            />
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* ───── Sec common — COPIE VERBATIM SolutionsDetailTemplate l.473-518 ───── */ .sol-proof { margin-top: var(--space-10); }
  .sol-sec-dark { background: var(--ink); color: var(--paper); }
  /* Kicker canonisé (R4) · typo portée par l'atome Kicker, ici layout seul */
  .section-eyebrow :global(.eyebrow) {
    display: inline-block;
    margin-bottom: var(--space-3);
  }

  /* ───── ROI Band Dark (BRIQUE SIGNATURE) — COPIE VERBATIM l.727-772 ───── */
  .sol-proof { padding: var(--section-base) 0; }
  .sol-roi-hd { margin-bottom: var(--space-8); }
  .sol-roi-hd .kicker { color: var(--accent-text); }
  .sol-roi-hd h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    letter-spacing: -0.018em;
    font-weight: var(--fw-medium);
    margin: var(--space-2) 0 0;
    color: var(--paper);
  }
  .sol-roi-grid {
    gap: var(--spacing-block);
  }
  .sol-roi-grid :global(.key-metric-value) {
    color: var(--paper);
  }
  .sol-roi-grid :global(.key-metric-accent .key-metric-value) {
    color: var(--accent-text);
  }
  .sol-roi-grid :global(.key-metric-label) {
    color: rgba(var(--paper-rgb), 0.7);
  }
  .sol-roi-grid :global(.roi-cell) {
    padding-top: var(--space-6);
    border-top: 1px solid rgba(var(--paper-rgb), 0.12);
  }
  .sol-roi-grid :global(.roi-v) {
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    line-height: 0.9;
    color: var(--accent-text);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }
  .sol-roi-grid :global(.roi-l) {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(var(--paper-rgb), 0.7);
    line-height: var(--leading-lede);
  }

  .start-9 { grid-column-start: 9; }
  .start-10 { grid-column-start: 10; }

  /* ── Axe déclinaison #118 : fonds clairs (défaut ABSENT = ink signature, rendu inchangé).
     paper/paper-2/paper-3 basculent la bande ROI sur fond clair + textes en encre. ── */
  .sol-sec-dark[data-bg='paper'],
  .sol-sec-dark[data-bg='paper-2'],
  .sol-sec-dark[data-bg='paper-3'] { color: var(--ink); }
  .sol-sec-dark[data-bg='paper'] { background: var(--paper); }
  .sol-sec-dark[data-bg='paper-2'] { background: var(--paper-2); }
  .sol-sec-dark[data-bg='paper-3'] { background: var(--paper-3); }
  .sol-sec-dark[data-bg^='paper'] .sol-roi-hd h2 { color: var(--ink); }
  .sol-sec-dark[data-bg^='paper'] .sol-roi-grid :global(.key-metric-value) { color: var(--ink); }
  .sol-sec-dark[data-bg^='paper'] .sol-roi-grid :global(.key-metric-accent .key-metric-value) { color: var(--accent-text); }
  .sol-sec-dark[data-bg^='paper'] .sol-roi-grid :global(.key-metric-label) { color: var(--ink-2); }
  .sol-sec-dark[data-bg^='paper'] .sol-roi-grid :global(.roi-cell) { border-top-color: var(--hairline); }
  .sol-sec-dark[data-bg^='paper'] .sol-roi-grid :global(.roi-v) { color: var(--accent-text); }
  .sol-sec-dark[data-bg^='paper'] .sol-roi-grid :global(.roi-l) { color: var(--muted); }
</style>
