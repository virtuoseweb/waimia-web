---
// Section catalogue · code-showcase (catégorie Terminal Sections)
// Vitrine de code annoté pour devtools/SaaS technique : copy explicative + bloc code mono
// avec numéros de ligne et commentaires bilingues alignés, label fichier/langage, tone ink|paper.
// Composé de tokens + Kicker atom.
// Typo (directive 2026-06-11) : masses en var(--font-sans), serif italic réservé au relevé <i>.
import Kicker from '../ui/atoms/Kicker.astro';
import type { SectionByType } from '@waimia/ds-kernel';

interface Props {
  data: SectionByType<'code-showcase'>;
  lang: 'fr' | 'en';
}
const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const kicker = isFr ? data.kicker_fr : data.kicker_en;
const h2 = isFr ? data.h2_fr : data.h2_en;
const intro = isFr ? data.intro_fr : data.intro_en;
---
<section class="code-showcase" data-bg={data.background}>
  <div class="wrap-wide">
    <div class="code-showcase__grid">
      {(kicker || h2 || intro) && (
        <div class="code-showcase__copy u-stack-4">
          {kicker && <Kicker tone="accent">{kicker}</Kicker>}
          {h2 && <h2 class="code-showcase__h2 u-h2-balance" set:html={h2} />}
          {intro && <p class="code-showcase__intro u-body-muted">{intro}</p>}
        </div>
      )}
      <figure class="code-showcase__frame" data-tone={data.tone}>
        <div class="code-showcase__bar">
          <span class="code-showcase__dots" aria-hidden="true"></span>
          {data.label && <span class="code-showcase__file">{data.label}</span>}
          {data.lang_label && <span class="code-showcase__lang">{data.lang_label}</span>}
        </div>
        <div class="code-showcase__code">
          <pre><code>{data.lines.map((line, i) => {
            const comment = isFr ? line.comment_fr : line.comment_en;
            return (
              <span class="code-showcase__line">
                {data.show_line_numbers && <span class="code-showcase__ln" aria-hidden="true">{String(i + 1).padStart(2, ' ')}</span>}
                <span class="code-showcase__text">{line.text || ' '}</span>
                {comment && <span class="code-showcase__cmt"># {comment}</span>}
              </span>
            );
          })}</code></pre>
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  .code-showcase { padding-block: var(--section-base); }

  .code-showcase__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-9);
    align-items: center;
  }
 .code-showcase__h2 :global(i),
  .code-showcase__h2 :global(i.acc) { font-family: var(--font-display); font-style: italic; color: var(--accent-text); } .code-showcase__frame {
    border-radius: var(--radius-card);
    border: 1px solid var(--hairline-strong);
    overflow: hidden;
    background: var(--paper);
  }
  .code-showcase__frame[data-tone='ink'] {
    background: var(--ink);
    border-color: rgba(var(--ink-rgb), 0.9);
  }

  .code-showcase__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--hairline);
  }
  .code-showcase__frame[data-tone='ink'] .code-showcase__bar { border-bottom-color: rgba(var(--paper-rgb), 0.12); }
  .code-showcase__dots {
    width: 44px;
    height: 10px;
    border-radius: var(--radius-pill);
    background: var(--hairline-strong);
    flex-shrink: 0;
  }
  .code-showcase__file {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--muted);
  }
  .code-showcase__lang {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .code-showcase__frame[data-tone='ink'] .code-showcase__file { color: rgba(var(--paper-rgb), 0.6); }

  .code-showcase__code { padding: var(--space-5) var(--space-4); overflow-x: auto; }
  .code-showcase__code pre { margin: 0; }
  .code-showcase__code code {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    line-height: var(--leading-relaxed);
  }
  .code-showcase__line { display: block; white-space: pre; }
  .code-showcase__ln {
    display: inline-block;
    width: 2.4ch;
    margin-right: var(--space-4);
    text-align: end;
    color: var(--muted);
    user-select: none;
  }
  .code-showcase__text { color: var(--ink); }
  .code-showcase__cmt { color: var(--muted); }
  .code-showcase__frame[data-tone='ink'] .code-showcase__text { color: var(--paper); }
  .code-showcase__frame[data-tone='ink'] .code-showcase__ln { color: rgba(var(--paper-rgb), 0.4); }
  .code-showcase__frame[data-tone='ink'] .code-showcase__cmt { color: rgba(var(--paper-rgb), 0.5); }

  @media (max-width: 880px) {
    .code-showcase__grid { grid-template-columns: 1fr; gap: var(--space-7); }
  }

  /* ── Alternance des fonds R4 ── */
  .code-showcase[data-bg='paper-2'] { background: var(--paper-2); }
  .code-showcase[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .code-showcase[data-bg='ink'] .code-showcase__h2 { color: var(--paper); }
</style>
