---
// Section catalogue · tier-pyramid-svg
// Source fidèle : `src/pages/offres/index.astro` `.pyramid-wrap`.
import type { SectionByType } from '@waimia/ds-kernel';

interface Props {
  data: SectionByType<'tier-pyramid-svg'>;
  lang: 'fr' | 'en';
}

const { data, lang } = Astro.props;
const isFr = lang === 'fr';
const tiers = [
  { yRoman: 98, yLabel: 124, roman: data.tiers[2]?.roman, label: isFr ? data.tiers[2]?.label_fr : data.tiers[2]?.label_en },
  { yRoman: 224, yLabel: 250, roman: data.tiers[1]?.roman, label: isFr ? data.tiers[1]?.label_fr : data.tiers[1]?.label_en },
  { yRoman: 338, yLabel: 364, roman: data.tiers[0]?.roman, label: isFr ? data.tiers[0]?.label_fr : data.tiers[0]?.label_en },
];
---

<div class="pyramid-wrap reveal" data-bg={data.background}>
  <svg
    viewBox="0 0 800 408"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={isFr ? data.aria_label_fr : data.aria_label_en}
  >
    {/* Paliers remplis bas→haut : gradation paper neutre, sommet mis en avant en accent */}
    <polygon class="tier-fill tier-fill--base" points="173,295 627,295 720,400 80,400" fill="var(--paper-2)" />
    <polygon class="tier-fill tier-fill--mid" points="280,175 520,175 627,295 173,295" fill="var(--paper-3)" />
    <polygon class="tier-fill tier-fill--top" points="400,40 280,175 520,175" fill="rgba(var(--accent-rgb), 0.12)" />

    {/* Contour + arêtes de séparation (lisibles : stroke-width 1.5) */}
    <polygon
      points="400,40 80,400 720,400"
      fill="none"
      stroke="var(--ink)"
      stroke-width="1.5"
    />
    <line x1="280" y1="175" x2="520" y2="175" stroke="var(--ink)" stroke-width="1.5" />
    <line x1="173" y1="295" x2="627" y2="295" stroke="var(--ink)" stroke-width="1.5" />

    {tiers.map((tier) => (
      <>
        <text x="400" y={tier.yRoman} text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="16" fill="var(--muted)" letter-spacing="0.16em">{tier.roman}</text>
        <text x="400" y={tier.yLabel} text-anchor="middle" font-family="Inter Tight, sans-serif" font-size="17" font-weight="500" fill="var(--ink)" letter-spacing="-0.01em">{tier.label}</text>
      </>
    ))}
  </svg>
</div>

<style>
  .pyramid-wrap {
    display: flex;
    justify-content: center;
    padding: var(--section-base) var(--space-6) var(--space-7);
  }
  .pyramid-wrap svg {
    width: 100%;
    max-width: 640px;
    height: auto;
  }

  /* ── Alternance des fonds · defaut (transparent/paper) = rendu inchange ── */
  .pyramid-wrap[data-bg='paper-2'] { background: var(--paper-2); }
  .pyramid-wrap[data-bg='paper-3'] { background: var(--paper-3); }
  .pyramid-wrap[data-bg='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  /* Traits du triangle (stroke=--ink invisible sur ink) repassent paper attenue ;
     labels muted repassent en paper attenue. Inline SVG attrs ecrases par CSS. */
  .pyramid-wrap[data-bg='ink'] svg polygon[stroke='var(--ink)'],
  .pyramid-wrap[data-bg='ink'] svg line[stroke='var(--ink)'] { stroke: rgba(var(--paper-rgb), 0.5); }
  .pyramid-wrap[data-bg='ink'] svg text[fill='var(--muted)'] { fill: rgba(var(--paper-rgb), 0.78); }
  .pyramid-wrap[data-bg='ink'] svg text[fill='var(--ink)'] { fill: var(--paper); }
  /* Paliers sur fond ink : paper translucide gradue bas→haut, sommet accent conserve */
  .pyramid-wrap[data-bg='ink'] svg .tier-fill--base { fill: rgba(var(--paper-rgb), 0.06); }
  .pyramid-wrap[data-bg='ink'] svg .tier-fill--mid { fill: rgba(var(--paper-rgb), 0.12); }
  .pyramid-wrap[data-bg='ink'] svg .tier-fill--top { fill: rgba(var(--accent-rgb), 0.22); }
</style>
