---
// Labo R2 · Z9 · « Magazine 70/30 · colonne sommaire »
// Sigil V·9 (haut-droite) + grille 2.3fr 1fr (~70/30).
// GAUCHE : §01 + h1 serif accent + lede + CTA dual + cta-sub.
// DROITE (rail) : sommaire typographique vertical = 3 entrées § A / § B / § C
// (label mono accent + titre serif court + sous-ligne), séparées par hairlines.
// Pur typographique, zéro média. Effet « ours de revue ».
// ADN home réutilisé : MastheadRow + signature-grid (lignes) + sigil V·9 + titre serif accent.
import MastheadRow from '../../ui/molecules/MastheadRow.astro';
import Kicker from '../../ui/atoms/Kicker.astro';
import Button from '../../ui/atoms/Button.astro';

interface Props {
  bg?: 'paper' | 'ink';
}
const { bg = 'paper' } = Astro.props;
const isInk = bg === 'ink';

const sommaire = [
  { tag: '§ A · Méthode', title: 'Diagnostic, intégration, run', sub: 'Trois temps, un cadre clair.' },
  { tag: '§ B · Délai', title: 'Premier flux en 5 jours', sub: 'De l’atelier à la production.' },
  { tag: '§ C · Garantie', title: 'Souveraineté des données', sub: '100 % chez vous, rien chez un tiers.' },
];
---
<section class="z9" data-bg={isInk ? 'ink' : undefined}>
  <div class:list={['signature-grid', { 'on-dark': isInk }]}></div>

  <div class="z9__sig-mark" aria-hidden="true">
    <svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="60" cy="60" r="58" stroke="currentColor" stroke-width="0.5"/>
      <text x="60" y="67" text-anchor="middle" font-family="var(--font-mono)" font-size="13" fill="currentColor" letter-spacing="0.14em">V · 9</text>
    </svg>
  </div>

  <div class="wrap-wide z9__inner">
    <MastheadRow tone={isInk ? 'ink' : 'paper'} />

    <div class="z9__grid">
      <div class="z9__main">
        <Kicker tone="accent" class="z9__fig">§ 01 · Service</Kicker>
        <h1 class="z9__title" set:html={`L'IA <i class="acc">intégrée</i> à vos<br />opérations, <i>sans friction</i>.`} />
        <p class="z9__lede">
          On installe Claude Code dans vos outils, vos données et vos flux.
          Vos équipes gardent la main, <i>l'IA fait le reste</i>.
        </p>
        <div class="z9__ctas">
          <Button href="/contact" variant="primary" size="lg">Démarrer un diagnostic</Button>
          <Button href="#methode" variant="ghost" size="lg">Voir la méthode</Button>
        </div>
        <p class="z9__cta-sub">Réponse sous 48 h. <i>Sans engagement.</i></p>
      </div>

      <aside class="z9__rail">
        <Kicker tone="accent" class="z9__fig">§ 02 · Sommaire</Kicker>
        <ol class="z9__toc" aria-label="Sommaire">
          {sommaire.map((s) => (
            <li class="z9__toc-item">
              <span class="z9__toc-tag">{s.tag}</span>
              <span class="z9__toc-title">{s.title}</span>
              <span class="z9__toc-sub">{s.sub}</span>
            </li>
          ))}
        </ol>
      </aside>
    </div>
  </div>
</section>

<style>
  .z9 {
    position: relative;
    background: var(--paper);
    color: var(--ink);
    border-bottom: 1px solid var(--hairline);
    overflow: hidden;
    min-height: 100vh;
    min-height: calc(var(--viewport-h) - var(--hero-chrome-above));
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    padding-top: calc(var(--header-height) + var(--space-7));
    padding-bottom: var(--space-7);
  }
  .z9[data-bg='ink'] { background: var(--ink); color: var(--paper); }
  .z9 > *:not(.signature-grid):not(.z9__sig-mark) { position: relative; z-index: 1; }
  .z9 .signature-grid { z-index: 0; }

  .z9__sig-mark {
    position: absolute;
    right: calc(var(--gut) * 2);
    top: calc(var(--header-height) + var(--space-7));
    width: 88px;
    height: 88px;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    color: var(--ink);
    opacity: 0.18;
  }
  .z9[data-bg='ink'] .z9__sig-mark { color: var(--paper); }
  .z9__sig-mark svg { width: 100%; height: 100%; display: block; }

  .z9__grid {
    display: grid;
    grid-template-columns: 2.3fr 1fr;
    gap: var(--space-10);
    align-items: center;
    margin-top: var(--space-7);
  }
  .z9__main { display: flex; flex-direction: column; }
  :global(.z9__fig) { margin-bottom: var(--space-4); }

  .z9__title {
    font-family: var(--font-sans);
    font-weight: var(--fw-semibold);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    letter-spacing: -0.015em;
    max-width: 16ch;
    margin: 0 0 var(--space-5);
  }
  .z9__title :global(i) { font-style: italic; }
  .z9__title :global(i.acc) { color: var(--accent-text); }

  .z9__lede {
    font-family: var(--font-sans);
    font-size: var(--text-lede, clamp(20px, 1.7vw, 24px));
    line-height: var(--leading-lede);
    color: var(--ink-2);
    max-width: 52ch;
    margin: 0 0 var(--space-6);
    text-wrap: pretty;
  }
  .z9[data-bg='ink'] .z9__lede { color: var(--paper-2); }
  .z9__lede :global(i) { font-style: italic; color: var(--accent-text); }

  .z9__ctas { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .z9__cta-sub {
    margin: var(--space-5) 0 0;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--ink-2);
  }
  .z9[data-bg='ink'] .z9__cta-sub { color: var(--paper-2); }
  .z9__cta-sub :global(i) { font-style: italic; color: var(--accent-text); }

  /* Rail droit léger : sommaire typographique, zéro média */
  .z9__rail { display: flex; flex-direction: column; }
  .z9__toc {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
  }
  .z9__toc-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--hairline);
  }
  .z9__toc-item:last-child { border-bottom: none; }
  .z9__toc-tag {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .z9__toc-title {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-lede, clamp(20px, 1.7vw, 24px));
    line-height: var(--leading-lede);
    color: var(--ink);
    text-wrap: balance;
  }
  .z9[data-bg='ink'] .z9__toc-title { color: var(--paper); }
  .z9__toc-sub {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--ink-2);
  }
  .z9[data-bg='ink'] .z9__toc-sub { color: var(--paper-2); }

  @media (max-width: 768px) {
    .z9 {
      padding-top: calc(var(--header-height) + var(--space-5));
      padding-bottom: var(--space-5);
    }
    .z9__sig-mark { display: none; }
    .z9__grid { grid-template-columns: 1fr; gap: var(--space-6); margin-top: var(--space-5); }
    .z9__rail { order: 1; }
    .z9__title { margin-bottom: var(--space-4); }
    .z9__lede { margin-bottom: var(--space-5); }
    .z9__ctas { gap: var(--space-2); }
    .z9__ctas :global(.btn) { flex: 1 1 auto; justify-content: center; }
  }
</style>
