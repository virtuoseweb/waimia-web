---
/**
 * Hero-explore · X4 · « Centré + bande capacités ink » (famille éditoriale / journal)
 * Layout : bloc héro CENTRÉ (kicker mono, grand titre serif accent, lede court, 2 CTA),
 * puis DESSOUS une bande de capacités INK pleine largeur (div data-bg='ink') → 4 cellules
 * (label mono accent + desc courte) séparées par hairlines. « Fond paper avec des cases
 * ink qui relèvent. » Rend paper (défaut) + ink. Contrat : /tmp/hero-explore/SPEC.md §0.
 */
import Button from '../../ui/atoms/Button.astro';

interface Props { bg?: 'paper' | 'ink'; }
const { bg = 'paper' } = Astro.props;

const caps = [
  { label: 'IA branchée', desc: 'Web app pilotée par Claude et GPT via skills' },
  { label: 'Vos données', desc: 'Search Console + Analytics lus en continu' },
  { label: 'Temps réel', desc: 'Alertes et qualification jusqu\'au CRM' },
  { label: 'Quiz routeur', desc: 'Vers la page qui convertit le mieux' },
];
---
<section class="hx hx4" data-bg={bg === 'ink' ? 'ink' : undefined}>
  <div class="wrap-wide">
    {/* Bloc héro centré */}
    <div class="hx4-hero">
      <p class="hx4-kicker">§ Site web intelligent</p>
      <h1 class="hx4-title">Un site web <i class="acc">intelligent</i>.</h1>
      <p class="hx4-lede">Pas une vitrine. Une web app pilotée par l'IA, branchée à vos données, qui transforme chaque visite en client.</p>
      <div class="hx4-ctas">
        <Button href="#" variant="primary" size="lg">Réserver un diagnostic (45 min) →</Button>
        <Button href="#" variant="ghost" size="lg">Voir la méthode</Button>
      </div>
    </div>

    {/* Bande capacités INK · pleine largeur du wrap */}
    <div class="hx4-band" data-bg="ink">
      <ul class="hx4-caps" aria-label="Capacités">
        {caps.map((c) => (
          <li class="hx4-cap">
            <span class="hx4-cap-label">{c.label}</span>
            <span class="hx4-cap-desc">{c.desc}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <style>
    .hx4 {
      background: var(--paper);
      color: var(--ink);
      padding-top: calc(var(--header-height) + var(--space-7));
      padding-bottom: var(--space-9);
      border-bottom: 1px solid var(--hairline);
    }
    .hx4[data-bg='ink'] { background: var(--ink); color: var(--paper); }

    /* Bloc héro centré */
    .hx4-hero {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-bottom: var(--space-9);
    }
    .hx4-kicker {
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono);
      text-transform: uppercase;
      color: var(--accent-text);
      margin: 0 0 var(--space-5);
    }
    .hx4-title {
      font-family: var(--font-display);
      font-size: var(--text-h1);
      line-height: var(--leading-h1);
      letter-spacing: var(--tracking-display);
      font-weight: var(--fw-regular);
      max-width: 18ch;
      margin: 0 auto var(--space-5);
    }
    .hx4-title .acc { font-style: italic; color: var(--accent-text); }
    .hx4-lede {
      font-family: var(--font-sans);
      font-size: var(--text-body);
      line-height: var(--leading-body);
      color: var(--muted);
      max-width: 52ch;
      margin: 0 auto var(--space-6);
      text-wrap: pretty;
    }
    .hx4-ctas { display: flex; gap: var(--space-3); flex-wrap: wrap; justify-content: center; }

    /* Bande capacités ink · remap tokens auto via data-bg='ink' */
    .hx4-band {
      background: var(--ink);
      color: var(--paper);
      border-radius: var(--radius-lg);
      padding: var(--space-7);
    }
    .hx4-caps {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
    }
    .hx4-cap {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding: 0 var(--space-5);
      border-right: 1px solid var(--hairline);
    }
    .hx4-cap:first-child { padding-left: 0; }
    .hx4-cap:last-child { border-right: none; padding-right: 0; }
    .hx4-cap-label {
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono);
      text-transform: uppercase;
      color: var(--accent-text);
    }
    .hx4-cap-desc {
      font-family: var(--font-sans);
      font-size: var(--text-body);
      line-height: var(--leading-lede);
      color: var(--paper);
    }

    @media (max-width: 768px) {
      .hx4-caps { grid-template-columns: 1fr 1fr; gap: var(--space-5); }
      .hx4-cap {
        padding: 0 var(--space-4);
        border-right: none;
        border-bottom: 1px solid var(--hairline);
        padding-bottom: var(--space-4);
      }
      .hx4-cap:first-child { padding-left: var(--space-4); }
      .hx4-cap:nth-child(2n) { padding-right: 0; }
      .hx4-cap:nth-child(2n+1) { padding-left: 0; }
      .hx4-cap:nth-last-child(-n+2) { border-bottom: none; padding-bottom: 0; }
    }
  </style>
</section>
