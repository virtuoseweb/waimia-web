---
/**
 * Hero-explore · X1 · « Masthead pleine page » (famille éditoriale / journal)
 * Layout : bande masthead mono 4-col (col 1 = fil d'Ariane, démonstration « la bande
 * VOL.03 qui devient le fil d'Ariane »), hairline ; grand titre serif accent ;
 * hairline ; rangée 2-col → GAUCHE lede court + 2 CTA, DROITE 4 KPI en micro-grille 2×2.
 * Pas d'image. Rend paper (défaut) + ink (data-bg='ink' → remap tokens global).
 * Contrat : cf /tmp/hero-explore/SPEC.md §0. Phase de test, standalone.
 */
import Button from '../../ui/atoms/Button.astro';

interface Props { bg?: 'paper' | 'ink'; }
const { bg = 'paper' } = Astro.props;
---
<section class="hx hx1" data-bg={bg === 'ink' ? 'ink' : undefined}>
  <div class="wrap-wide">
    {/* Bande masthead · col 1 = fil d'Ariane (la bande éditoriale devient breadcrumb) */}
    <div class="hx1-masthead">
      <nav class="hx1-crumb" aria-label="Fil d'Ariane">
        <a href="#">Accueil</a><span class="hx1-sep"> / </span><a href="#">Services</a><span class="hx1-sep"> / </span><span class="hx1-here">Site web intelligent</span>
      </nav>
      <span class="hx1-meta">Montpellier · FR</span>
      <span class="hx1-meta">Édition française</span>
      <span class="hx1-meta hx1-meta--end"><span class="hx1-dot">◉</span> Disponible · T3 2026</span>
    </div>

    {/* Grand titre serif · mot accent « intelligent » */}
    <h1 class="hx1-title">Un site web <i class="acc">intelligent</i>.</h1>

    {/* Rangée 2-col · lede + CTA / KPI 2×2 */}
    <div class="hx1-row">
      <div class="hx1-lede-col">
        <p class="hx1-lede">Pas une vitrine. Une web app pilotée par l'IA, branchée à vos données, qui transforme chaque visite en client.</p>
        <div class="hx1-ctas">
          <Button href="#" variant="primary" size="lg">Réserver un diagnostic (45 min) →</Button>
          <Button href="#" variant="ghost" size="lg">Voir la méthode</Button>
        </div>
      </div>

      <ul class="hx1-kpis" aria-label="Indicateurs clés">
        <li class="hx1-kpi">
          <span class="hx1-kpi-num">2–10 k€</span>
          <span class="hx1-kpi-cap">budget HT indicatif</span>
        </li>
        <li class="hx1-kpi">
          <span class="hx1-kpi-num">4–8 sem.</span>
          <span class="hx1-kpi-cap">site exploitable livré</span>
        </li>
        <li class="hx1-kpi">
          <span class="hx1-kpi-num">Temps réel</span>
          <span class="hx1-kpi-cap">KPI lus, SEO, alertes</span>
        </li>
        <li class="hx1-kpi">
          <span class="hx1-kpi-num">100/100</span>
          <span class="hx1-kpi-cap">PageSpeed SSG, base GEO</span>
        </li>
      </ul>
    </div>
  </div>

  <style>
    .hx1 {
      background: var(--paper);
      color: var(--ink);
      padding-top: calc(var(--header-height) + var(--space-7));
      padding-bottom: var(--space-9);
      border-bottom: 1px solid var(--hairline);
    }
    .hx1[data-bg='ink'] { background: var(--ink); color: var(--paper); }

    /* Bande masthead · 4 colonnes mono, hairline en bas */
    .hx1-masthead {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: var(--space-6);
      align-items: baseline;
      padding-bottom: var(--space-3);
      border-bottom: 1px solid var(--hairline);
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono);
      text-transform: uppercase;
      line-height: 1;
      color: var(--muted);
    }
    .hx1-crumb a {
      color: var(--muted);
      text-decoration: none;
      transition: color var(--dur-hover) var(--ease);
    }
    .hx1-crumb a:hover { color: var(--accent-text); }
    .hx1-sep { color: var(--muted); opacity: 0.6; }
    .hx1-here { color: var(--ink); }
    .hx1[data-bg='ink'] .hx1-here { color: var(--paper); }
    .hx1-meta--end { text-align: right; }
    .hx1-dot { color: var(--accent-text); }

    /* Titre serif · accent terracotta sur « intelligent » */
    .hx1-title {
      font-family: var(--font-display);
      font-size: var(--text-h1);
      line-height: var(--leading-h1);
      letter-spacing: var(--tracking-display);
      font-weight: var(--fw-regular);
      max-width: 16ch;
      margin: var(--space-7) 0 var(--space-7);
    }
    .hx1-title .acc { font-style: italic; color: var(--accent-text); }

    /* Rangée 2 colonnes · lede+CTA / KPI · hairline top */
    .hx1-row {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-9);
      padding-top: var(--space-7);
      border-top: 1px solid var(--hairline);
      align-items: start;
    }
    .hx1-lede-col { display: flex; flex-direction: column; gap: var(--space-6); }
    .hx1-lede {
      font-family: var(--font-sans);
      font-size: var(--text-body);
      line-height: var(--leading-body);
      color: var(--muted);
      max-width: 50ch;
      margin: 0;
      text-wrap: pretty;
    }
    .hx1-ctas { display: flex; gap: var(--space-3); flex-wrap: wrap; }

    /* KPI · micro-grille 2×2, cellules séparées par hairlines */
    .hx1-kpis {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .hx1-kpi {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      padding: var(--space-3) var(--space-5) var(--space-5) 0;
      border-bottom: 1px solid var(--hairline);
      border-right: 1px solid var(--hairline);
    }
    .hx1-kpi:nth-child(2n) { border-right: none; padding-right: 0; }
    .hx1-kpi:nth-child(2n+1) { padding-left: 0; }
    .hx1-kpi:not(:nth-child(2n+1)) { padding-left: var(--space-5); }
    .hx1-kpi:nth-last-child(-n+2) { border-bottom: none; padding-bottom: 0; }
    .hx1-kpi-num {
      font-family: var(--font-display);
      font-size: var(--text-numeral-md);
      line-height: 1;
      letter-spacing: var(--tracking-display);
      color: var(--accent-text);
      font-weight: var(--fw-regular);
    }
    .hx1-kpi-cap {
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono-tight);
      text-transform: uppercase;
      color: var(--muted);
    }

    @media (max-width: 768px) {
      .hx1-masthead {
        grid-template-columns: 1fr 1fr;
        gap: var(--space-4);
        row-gap: var(--space-3);
      }
      .hx1-meta--end { text-align: left; }
      .hx1-row { grid-template-columns: 1fr; gap: var(--space-7); }
    }
  </style>
</section>
