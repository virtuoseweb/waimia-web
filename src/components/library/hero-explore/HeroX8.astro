---
// HeroX8 · famille CARTE/COVER · « Paper avec carte média ink + pills »
// Layout : 2 colonnes 1fr/1fr. Gauche = discours éditorial (kicker mono, titre serif accent,
// lede court, 3-4 badges en pills hairline mono). Droite = une CARTE INK (data-bg='ink' interne)
// qui « relève » sur le fond paper : SVG line-art dispositif-flow (currentColor=paper) + mini-rangée
// de 2 KPI sous le SVG. Distinct de X2 (carte paper-2) : ici la carte est sombre même en mode paper.
// Tous les styles scopés, préfixés hx8. 0 hardcode → var(--token). 0 tiret cadratin U+2014.
interface Props { bg?: 'paper' | 'ink'; }
const { bg = 'paper' } = Astro.props;

const badges = [
  'Connectée à l’IA (Claude, GPT)',
  'Branchée à vos données',
  'Alertes temps réel',
  'Quiz qui route vers ce qui convertit',
];
const kpis = [
  { num: '4–8 sem.', cap: 'site exploitable livré' },
  { num: '100/100', cap: 'PageSpeed SSG, base GEO' },
];
---
<section class={`hx hx8`} data-bg={bg === 'ink' ? 'ink' : undefined}>
  <div class="wrap-wide hx8-grid">
    <div class="hx8-col hx8-discourse">
      <p class="hx8-kicker">§ Site web intelligent</p>
      <h1 class="hx8-title">Un site web <i class="acc">intelligent</i>.</h1>
      <p class="hx8-lede">
        Pas une vitrine. Une web app pilotée par l’IA, branchée à vos données, qui transforme
        chaque visite en client.
      </p>
      <ul class="hx8-badges" aria-label="Capacités">
        {badges.map((b) => <li class="hx8-badge">{b}</li>)}
      </ul>
      <div class="hx8-ctas">
        <a class="btn btn-primary btn-lg" href="#">Réserver un diagnostic (45 min) →</a>
        <a class="btn btn-ghost btn-lg" href="#">Voir la méthode</a>
      </div>
    </div>

    <div class="hx8-col">
      <div class="hx8-card" data-bg="ink">
        <div class="hx8-card-media">
          <img
            src="/images/line-art/dispositif-flow.svg"
            alt="Schéma line-art du dispositif Waimia : données, IA et conversion reliées"
            loading="lazy"
            decoding="async"
          />
        </div>
        <ul class="hx8-card-kpis" aria-label="Repères clés">
          {kpis.map((k) => (
            <li class="hx8-kpi">
              <span class="hx8-kpi-num">{k.num}</span>
              <span class="hx8-kpi-cap">{k.cap}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <style>
    .hx8 {
      background: var(--paper);
      color: var(--ink);
      padding-top: calc(var(--header-height) + var(--space-7));
      padding-bottom: var(--space-9);
      border-bottom: 1px solid var(--hairline);
    }
    .hx8[data-bg='ink'] { background: var(--ink); color: var(--paper); }

    .hx8-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-9);
      align-items: center;
    }
    .hx8-col { min-width: 0; }

    .hx8-kicker {
      margin: 0 0 var(--space-5);
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono);
      text-transform: uppercase;
      color: var(--accent-text);
    }
    .hx8-title {
      margin: 0 0 var(--space-5);
      font-family: var(--font-display);
      font-size: var(--text-display);
      line-height: var(--leading-h1);
      letter-spacing: var(--tracking-display);
      font-weight: var(--fw-regular);
      text-wrap: balance;
    }
    .hx8-title i.acc { font-style: italic; color: var(--accent-text); }
    .hx8-lede {
      margin: 0 0 var(--space-6);
      max-width: 48ch;
      font-family: var(--font-sans);
      font-size: var(--text-body);
      line-height: var(--leading-body);
      color: var(--muted);
    }

    .hx8-badges {
      list-style: none;
      margin: 0 0 var(--space-7);
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .hx8-badge {
      padding: var(--space-2) var(--space-4);
      border: 1px solid var(--hairline);
      border-radius: var(--radius-pill);
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono-tight);
      text-transform: uppercase;
      color: var(--muted);
      transition: border-color var(--dur-trim) var(--ease), color var(--dur-trim) var(--ease);
    }
    .hx8-badge:hover { border-color: var(--accent-text); color: var(--accent-text); }

    .hx8-ctas {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
    }

    /* Carte INK : « relève » sur le fond paper. data-bg='ink' remap muted/hairline/accent-text. */
    .hx8-card {
      background: var(--ink);
      color: var(--paper);
      border-radius: var(--radius-lg);
      padding: var(--space-7);
      box-shadow: var(--shadow-lift);
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }
    .hx8-card-media {
      border: 1px solid var(--hairline);
      border-radius: var(--radius-md);
      padding: clamp(var(--space-6), 4vw, var(--space-10));
      background: rgba(var(--paper-rgb), 0.04);
    }
    .hx8-card-media img {
      display: block;
      width: 100%;
      height: auto;
      max-height: 320px;
      object-fit: contain;
      color: var(--paper);
    }
    .hx8-card-kpis {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }
    .hx8-kpi {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      padding-left: var(--space-4);
      border-left: 1px solid var(--hairline);
    }
    .hx8-kpi-num {
      font-family: var(--font-display);
      font-size: var(--text-numeral-sm);
      line-height: 1;
      color: var(--accent-text);
      font-weight: var(--fw-regular);
    }
    .hx8-kpi-cap {
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono);
      text-transform: uppercase;
      color: var(--muted);
    }

    @media (max-width: 900px) {
      .hx8-grid { grid-template-columns: 1fr; gap: var(--space-7); }
      .hx8-title { font-size: var(--text-h1); }
    }
    @media (max-width: 480px) {
      .hx8-card-kpis { grid-template-columns: 1fr; gap: var(--space-4); }
    }
  </style>
</section>
