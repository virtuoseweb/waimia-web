---
/**
 * Hero-explore · X3 · « Grille multi-lignes asymétrique » (famille éditoriale / journal)
 * Layout : 3 rangées empilées. R1 → titre serif accent pleine largeur. R2 → 2-col
 * (gauche label § 01 + lede + 2 CTA / droite label § 02 + 4 bullets ›). R3 → bande
 * 4 KPI, dont UNE cellule inversée en ink (data-bg='ink' interne) pour relever l'œil.
 * Rend paper (défaut) + ink. Contrat : /tmp/hero-explore/SPEC.md §0.
 */
import Button from '../../ui/atoms/Button.astro';

interface Props { bg?: 'paper' | 'ink'; }
const { bg = 'paper' } = Astro.props;

const bullets = [
  'Web app connectée à un LLM via skills et routines précises',
  'Search Console + Analytics : KPI lus, SEO optimisé en continu',
  'Alertes temps réel, qualification de chaque visiteur jusqu\'au CRM',
  'Lead magnet et quiz qui routent vers la page qui convertit le mieux',
];

const kpis = [
  { num: '2–10 k€', cap: 'budget HT indicatif' },
  { num: '4–8 sem.', cap: 'site exploitable livré' },
  { num: 'Temps réel', cap: 'KPI lus, SEO, alertes' },
  { num: '100/100', cap: 'PageSpeed SSG, base GEO' },
];
---
<section class="hx hx3" data-bg={bg === 'ink' ? 'ink' : undefined}>
  <div class="wrap-wide">
    {/* R1 · titre pleine largeur */}
    <h1 class="hx3-title">Un site web <i class="acc">intelligent</i>.</h1>

    {/* R2 · 2 colonnes asymétriques */}
    <div class="hx3-row2">
      <div class="hx3-left">
        <p class="hx3-label">§ 01 · Le service</p>
        <p class="hx3-lede">Pas une vitrine. Une web app pilotée par l'IA, branchée à vos données, qui transforme chaque visite en client.</p>
        <div class="hx3-ctas">
          <Button href="#" variant="primary" size="lg">Réserver un diagnostic (45 min) →</Button>
          <Button href="#" variant="ghost" size="lg">Voir la méthode</Button>
        </div>
      </div>
      <div class="hx3-right">
        <p class="hx3-label">§ 02 · Ce que ça fait</p>
        <ul class="hx3-bullets">
          {bullets.map((b) => (
            <li class="hx3-bullet"><span class="hx3-arrow" aria-hidden="true">›</span><span>{b}</span></li>
          ))}
        </ul>
      </div>
    </div>

    {/* R3 · bande 4 KPI, dernière cellule inversée ink */}
    <ul class="hx3-kpis" aria-label="Indicateurs clés">
      {kpis.map((k, i) => (
        <li class="hx3-kpi" data-bg={i === kpis.length - 1 ? 'ink' : undefined}>
          <span class="hx3-kpi-num">{k.num}</span>
          <span class="hx3-kpi-cap">{k.cap}</span>
        </li>
      ))}
    </ul>
  </div>

  <style>
    .hx3 {
      background: var(--paper);
      color: var(--ink);
      padding-top: calc(var(--header-height) + var(--space-7));
      padding-bottom: var(--space-9);
      border-bottom: 1px solid var(--hairline);
    }
    .hx3[data-bg='ink'] { background: var(--ink); color: var(--paper); }

    /* R1 · titre */
    .hx3-title {
      font-family: var(--font-sans);
      font-weight: var(--fw-semibold);
      font-size: var(--text-h1);
      line-height: var(--leading-h1);
      letter-spacing: -0.015em;
      max-width: 20ch;
      margin: 0 0 var(--space-8);
    }
    .hx3-title .acc { font-style: italic; color: var(--accent-text); }

    /* R2 · 2 colonnes */
    .hx3-row2 {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-9);
      padding-top: var(--space-7);
      border-top: 1px solid var(--hairline);
      margin-bottom: var(--space-8);
    }
    .hx3-label {
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono);
      text-transform: uppercase;
      color: var(--accent-text);
      margin: 0 0 var(--space-5);
    }
    .hx3-left { display: flex; flex-direction: column; }
    .hx3-lede {
      font-family: var(--font-sans);
      font-size: var(--text-body);
      line-height: var(--leading-body);
      color: var(--muted);
      max-width: 48ch;
      margin: 0 0 var(--space-6);
      text-wrap: pretty;
    }
    .hx3-ctas { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: auto; }

    /* Bullets · flèche › accent, hairline entre puces */
    .hx3-bullets { list-style: none; margin: 0; padding: 0; }
    .hx3-bullet {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: var(--space-3);
      align-items: baseline;
      padding: var(--space-3) 0;
      border-bottom: 1px solid var(--hairline);
      font-family: var(--font-sans);
      font-size: var(--text-body);
      line-height: var(--leading-lede);
      color: var(--ink);
    }
    .hx3[data-bg='ink'] .hx3-bullet { color: var(--paper); }
    .hx3-bullet:last-child { border-bottom: none; }
    .hx3-arrow { color: var(--accent-text); font-weight: var(--fw-semibold); }

    /* R3 · bande KPI 4-col, hairlines, dernière cellule inversée ink */
    .hx3-kpis {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border-top: 1px solid var(--hairline);
    }
    .hx3-kpi {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding: var(--space-5) var(--space-5) var(--space-5) 0;
      border-right: 1px solid var(--hairline);
    }
    .hx3-kpi:last-child { border-right: none; padding-right: 0; }
    .hx3-kpi:not(:first-child) { padding-left: var(--space-5); }
    /* Cellule inversée ink · « relève » sur fond paper */
    .hx3-kpi[data-bg='ink'] {
      background: var(--ink);
      color: var(--paper);
      border-radius: var(--radius-md);
      border-right: none;
      padding: var(--space-5);
    }
    .hx3-kpi-num {
      font-family: var(--font-display);
      font-size: var(--text-numeral-md);
      line-height: 1;
      letter-spacing: var(--tracking-display);
      color: var(--accent-text);
      font-weight: var(--fw-regular);
    }
    .hx3-kpi-cap {
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono-tight);
      text-transform: uppercase;
      color: var(--muted);
    }

    @media (max-width: 768px) {
      .hx3-row2 { grid-template-columns: 1fr; gap: var(--space-7); }
      .hx3-ctas { margin-top: var(--space-5); }
      .hx3-kpis { grid-template-columns: 1fr 1fr; }
      .hx3-kpi {
        border-bottom: 1px solid var(--hairline);
        padding: var(--space-4) var(--space-4) var(--space-4) 0;
      }
      .hx3-kpi:nth-child(2n) { border-right: none; padding-right: 0; }
      .hx3-kpi:nth-child(2n+1) { padding-left: 0; }
      .hx3-kpi:not(:nth-child(2n+1)) { padding-left: var(--space-4); }
      .hx3-kpi:nth-last-child(-n+2) { border-bottom: none; }
      .hx3-kpi[data-bg='ink'] { padding: var(--space-5); }
    }
  </style>
</section>
