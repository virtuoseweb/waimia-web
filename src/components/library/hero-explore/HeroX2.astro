---
/**
 * Hero-explore · X2 · « Split média, dominant ink » (famille éditoriale / journal)
 * Layout : grille 2-col (texte 1fr / média 1.1fr), align center. GAUCHE → kicker mono,
 * titre serif accent, lede court, 4 badges en pills mono, 2 CTA. DROITE → carte média
 * line-art (dispositif-flow.svg, currentColor, lisible paper ET ink). Pas de KPI.
 * Conçu pour ressortir surtout en INK. Contrat : /tmp/hero-explore/SPEC.md §0.
 */
import Button from '../../ui/atoms/Button.astro';

interface Props { bg?: 'paper' | 'ink'; }
const { bg = 'paper' } = Astro.props;

const badges = [
  'Connectée à l\'IA (Claude, GPT)',
  'Branchée à vos données',
  'Alertes temps réel',
  'Quiz qui route vers ce qui convertit',
];
---
<section class="hx hx2" data-bg={bg === 'ink' ? 'ink' : undefined}>
  <div class="wrap-wide">
    <div class="hx2-grid">
      {/* Texte */}
      <div class="hx2-text">
        <p class="hx2-kicker">§ Site web intelligent</p>
        <h1 class="hx2-title">Un site web <i class="acc">intelligent</i>.</h1>
        <p class="hx2-lede">Pas une vitrine. Une web app pilotée par l'IA, branchée à vos données, qui transforme chaque visite en client.</p>

        <ul class="hx2-badges" aria-label="Capacités">
          {badges.map((b) => <li class="hx2-badge">{b}</li>)}
        </ul>

        <div class="hx2-ctas">
          <Button href="#" variant="primary" size="lg">Réserver un diagnostic (45 min) →</Button>
          <Button href="#" variant="ghost" size="lg">Voir la méthode</Button>
        </div>
      </div>

      {/* Média line-art */}
      <figure class="hx2-media">
        <img src="/images/line-art/dispositif-flow.svg" alt="Schéma du dispositif : outils dispersés reliés par un nœud d'orchestration IA vers un résultat mesuré." loading="eager" decoding="async" />
      </figure>
    </div>
  </div>

  <style>
    .hx2 {
      background: var(--paper);
      color: var(--ink);
      padding-top: calc(var(--header-height) + var(--space-7));
      padding-bottom: var(--space-9);
      border-bottom: 1px solid var(--hairline);
    }
    .hx2[data-bg='ink'] { background: var(--ink); color: var(--paper); }

    .hx2-grid {
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      gap: var(--space-10);
      align-items: center;
    }

    .hx2-kicker {
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono);
      text-transform: uppercase;
      color: var(--accent-text);
      margin: 0 0 var(--space-5);
    }
    .hx2-title {
      font-family: var(--font-sans);
      font-weight: var(--fw-semibold);
      font-size: var(--text-h1);
      line-height: var(--leading-h1);
      letter-spacing: -0.015em;
      max-width: 14ch;
      margin: 0 0 var(--space-5);
    }
    .hx2-title .acc { font-style: italic; color: var(--accent-text); }
    .hx2-lede {
      font-family: var(--font-sans);
      font-size: var(--text-body);
      line-height: var(--leading-body);
      color: var(--muted);
      max-width: 50ch;
      margin: 0 0 var(--space-6);
      text-wrap: pretty;
    }

    /* Badges · pills mono uppercase, border hairline */
    .hx2-badges {
      list-style: none;
      margin: 0 0 var(--space-7);
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .hx2-badge {
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono-tight);
      text-transform: uppercase;
      color: var(--muted);
      border: 1px solid var(--hairline);
      border-radius: var(--radius-pill);
      padding: var(--space-2) var(--space-4);
      transition: border-color var(--dur-hover) var(--ease), color var(--dur-hover) var(--ease);
    }
    .hx2-badge:hover { border-color: var(--accent-text); color: var(--accent-text); }

    .hx2-ctas { display: flex; gap: var(--space-3); flex-wrap: wrap; }

    /* Carte média · line-art currentColor (inversion gratuite ink/paper) */
    .hx2-media {
      margin: 0;
      border: 1px solid var(--hairline);
      border-radius: var(--radius-lg);
      background: var(--paper-2);
      padding: clamp(var(--space-6), 4vw, var(--space-10));
      aspect-ratio: 9 / 7;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }
    /* Halo accent très léger derrière le schéma */
    .hx2-media::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(60% 60% at 50% 45%, rgba(var(--accent-rgb), 0.07), transparent 70%);
      pointer-events: none;
    }
    .hx2[data-bg='ink'] .hx2-media { background: var(--ink-2); }
    .hx2-media img {
      position: relative;
      width: 100%;
      height: 100%;
      object-fit: contain;
      color: var(--ink);
    }
    .hx2[data-bg='ink'] .hx2-media img { color: var(--paper); }

    @media (max-width: 768px) {
      .hx2-grid { grid-template-columns: 1fr; gap: var(--space-7); }
      .hx2-media { order: -1; aspect-ratio: 16 / 10; }
    }
  </style>
</section>
