---
/**
 * hero-explore · X6 : « Full-bleed mega, baseline KPI » (paper/ink, pensé pour ink)
 * Impact typographique maximal : kicker mono + titre serif géant + lede court en haut,
 * rangée de 4 KPI poussée en bas (margin-top:auto) séparée par une hairline. Pas d'image.
 * Standalone · 0 hardcode · paper+ink via tokens de rôle (remap global [data-bg='ink']).
 */
interface Props { bg?: 'paper' | 'ink'; }
const { bg = 'paper' } = Astro.props;

const kpis = [
  { num: '2–10 k€', cap: 'budget HT indicatif' },
  { num: '4–8 sem.', cap: 'site exploitable livré' },
  { num: 'Temps réel', cap: 'KPI lus, SEO, alertes' },
  { num: '100/100', cap: 'PageSpeed SSG, base GEO' },
];
---
<section class="hx hx6" data-bg={bg === 'ink' ? 'ink' : undefined}>
  <div class="wrap-wide hx6-stack">
    <div class="hx6-head">
      <p class="hx6-kicker">§ Site web intelligent</p>
      <h1 class="hx6-title">Un site web enfin <i class="acc">intelligent</i>.</h1>
      <p class="hx6-lede">Pas une vitrine. Une web app pilotée par l'IA, branchée à vos données, qui transforme chaque visite en client.</p>
    </div>

    <ul class="hx6-kpis">
      {kpis.map((k) => (
        <li class="hx6-kpi">
          <span class="hx6-kpi-num">{k.num}</span>
          <span class="hx6-kpi-cap">{k.cap}</span>
        </li>
      ))}
    </ul>
  </div>

  <style>
    .hx6 {
      background: var(--paper);
      color: var(--ink);
      padding-top: calc(var(--header-height) + var(--space-7));
      padding-bottom: var(--space-9);
      border-bottom: 1px solid var(--hairline);
    }
    .hx6[data-bg='ink'] { background: var(--ink); color: var(--paper); }

    .hx6-stack {
      display: flex;
      flex-direction: column;
      min-height: 70vh;
    }
    .hx6-head { max-width: 22ch; }

    .hx6-kicker {
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono);
      text-transform: uppercase;
      color: var(--muted);
      margin: 0 0 var(--space-5);
    }
    .hx6-title {
      font-family: var(--font-display);
      font-size: var(--text-display);
      line-height: var(--leading-h1);
      letter-spacing: var(--tracking-display);
      font-weight: var(--fw-regular);
      max-width: 14ch;
      margin: 0 0 var(--space-5);
    }
    .hx6-title i { font-style: italic; }
    .hx6-title i.acc { color: var(--accent-text); }
    .hx6-lede {
      font-family: var(--font-sans);
      font-size: var(--text-body);
      line-height: var(--leading-body);
      color: var(--muted);
      max-width: 48ch;
      text-wrap: pretty;
      margin: 0;
    }

    /* Rangée KPI pleine largeur, poussée en bas de la section */
    .hx6-kpis {
      list-style: none;
      margin: var(--space-9) 0 0;
      margin-top: auto;
      padding-top: var(--space-6);
      border-top: 1px solid var(--hairline-strong);
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-6);
    }
    .hx6-kpi {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    .hx6-kpi-num {
      font-family: var(--font-display);
      font-size: var(--text-numeral-md);
      line-height: 1;
      letter-spacing: var(--tracking-display);
      color: var(--accent-text);
      font-weight: var(--fw-regular);
    }
    .hx6-kpi-cap {
      font-family: var(--font-mono);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-mono-tight);
      text-transform: uppercase;
      line-height: var(--leading-lede);
      color: var(--muted);
    }

    @media (max-width: 768px) {
      .hx6-stack { min-height: 0; }
      .hx6-title { max-width: 100%; }
      .hx6-kpis { grid-template-columns: repeat(2, 1fr); gap: var(--space-5) var(--space-4); }
    }
  </style>
</section>
