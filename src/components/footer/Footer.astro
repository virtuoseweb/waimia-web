---
// Footer · 5 colonnes éditoriales · pur Astro (pas d'interactivité)
import { FOOTER_LEAN, TRUST_BADGES } from '../../data/sitemap';
import { langFromPath, t } from '../../lib/i18n';
import NewsletterSignup from '../ui/molecules/NewsletterSignup.astro';
import { SITE } from '../../site.config';

const lang = langFromPath(Astro.url.pathname);
// `year` est résolu au build (SSG). En cas de site non rebuilt en début d'année,
// le copyright reste figé. Atténuation : Vercel cron annuel ou simplement push
// d'un commit start-of-year. À défaut, accepter le glissement (faible criticité).
const year = new Date().getFullYear();
---
<footer class="ft" aria-labelledby="ft-heading">
  <h2 id="ft-heading" class="sr-only">
    {lang === 'fr' ? 'Pied de page' : 'Footer'}
  </h2>

  {/* Top — wordmark vibration · hover anime le dot pour ressentir l'identité */}
  <div class="wrap" style="padding-top:var(--space-12);padding-bottom:var(--space-10)">
    <div class="ft-brand" style="display:flex;align-items:center;gap:var(--space-4);font-size:var(--text-display)">
      <img src="/favicon-128.png" alt="" aria-hidden="true" class="ft-mark" style="height:0.72em;width:auto;display:block;flex:0 0 auto" />
      <div class="ft-wordmark" style="font-family:var(--font-display);font-size:var(--text-display);line-height:.88;letter-spacing:-0.03em;font-weight:var(--fw-regular);color:var(--ink)">
        Waim<i>i</i>a<span class="dot">.</span>
      </div>
    </div>
    <p style="font-family:var(--font-sans);font-weight:var(--fw-medium);font-size:var(--text-h3);color:var(--muted);max-width:640px;margin-top:var(--space-6);line-height:var(--leading-lede);text-wrap:balance">
      {lang === 'fr'
        ? "Studio de développement IA et cabinet d'automatisation des processus pour PME et ETI. Bordeaux, missions à distance."
        : 'AI development studio and process automation practice for SMEs. Bordeaux, remote engagements.'}
    </p>
  </div>

  {/* Trust badges row */}
  <div class="wrap" style="padding-bottom:var(--space-9)">
    <div class="trust-row">
      {TRUST_BADGES.map((b) => (
        b.href ? (
          <a class={`trust-pill ${b.kind}`} href={b.href} target="_blank" rel="noopener">
            <span class="dot"></span>
            {t(b.label, lang)}
          </a>
        ) : (
          <span class={`trust-pill ${b.kind}`}>
            <span class="dot"></span>
            {t(b.label, lang)}
          </span>
        )
      ))}
    </div>
  </div>

  {/* Newsletter section */}
  <div class="wrap hline" style="padding-top:var(--space-9);padding-bottom:var(--space-9)">
    <div class="ft-nl-grid">
      <div class="ft-nl-lead reveal-fade">
        <p style="font-family:var(--font-mono);font-size:var(--text-small);letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin:0 0 16px">
          {lang === 'fr' ? 'Restez informé' : 'Stay informed'}
        </p>
        <p style="font-family:var(--font-sans);font-size:var(--text-h3);color:var(--ink-2);max-width:320px;line-height:var(--leading-lede);text-wrap:balance;margin:0;font-weight:var(--fw-medium)">
          {lang === 'fr'
            ? "Automatisation et IA en PME : les notes de terrain du studio, quand il y a quelque chose à dire."
            : "Automation and AI in SMEs: field notes from the studio, when there is something to say."}
        </p>
      </div>
      <NewsletterSignup lang={lang} variant="inline" />
    </div>
  </div>

  {/* Tier 1 : colonnes pérennes pilotées par FOOTER_LEAN (3 ; hubs et pages prioritaires, O12). */}
  <div class="wrap hline" style="padding-top:var(--space-9);padding-bottom:var(--space-11)">
    <div class="ft-tier1-grid" style={`display:grid;grid-template-columns:repeat(${FOOTER_LEAN.length},1fr);gap:var(--space-8)`}>
      {FOOTER_LEAN.map((col) => (
        <div>
          <h3 style="font-family:var(--font-mono);font-size:var(--text-small);letter-spacing:.16em;text-transform:uppercase;color:var(--accent-text);margin-bottom:18px;font-weight:var(--fw-medium)">
            {t(col.heading, lang)}
          </h3>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:10px">
            {col.items.map((it) => (
              <li>
                <a href={it.href} style="font-size:var(--text-small);color:var(--ink-2);transition:color var(--dur-trim) var(--ease);display:inline-block;line-height:var(--leading-lede)" class="ft-link">
                  {t(it.label, lang)}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  {/* Bas de page : copyright, liens légaux, LinkedIn (seul profil social réel). Site FR
      monolingue : pas de sélecteur de langue. */}
  <div class="wrap hline ft-bottom">
    <div class="ft-bottom-left">
      <span>© {year} {SITE.name} · {lang === 'fr' ? 'Studio de développement IA' : 'AI development studio'}</span>
      <a href="/mentions-legales" class="ft-link">
        {lang === 'fr' ? 'Mentions légales' : 'Legal notice'}
      </a>
      <a href="/cgv" class="ft-link">{lang === 'fr' ? 'CGV' : 'Terms'}</a>
      <a href="/politique-confidentialite" class="ft-link">
        {lang === 'fr' ? 'Confidentialité' : 'Privacy'}
      </a>
    </div>
    <div class="ft-bottom-right">
      <a href="/sitemap-index.xml" class="ft-link">Sitemap (XML)</a>
      <a href={SITE.linkedin} target="_blank" rel="noopener" class="ft-link">LinkedIn</a>
    </div>
  </div>
</footer>

<style>
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

  /* Liens · hover terracotta + petit slide à droite */
  .ft-link{transition:color var(--dur-trim) var(--ease),padding-left 320ms var(--ease)}
  .ft-link:hover{color:var(--accent-text)}

  /* Wordmark · hover anime le dot terracotta (identité vivante) */
  .ft-wordmark i,
  .ft-wordmark .dot{
    color:var(--accent-text);
    display:inline-block;
    transition:transform 480ms var(--ease);
  }
  .ft-wordmark i{font-style:italic}
  .ft-wordmark:hover i{transform:translateY(-6px) rotate(-4deg)}
  .ft-wordmark:hover .dot{transform:scale(1.4)}

  /* Trust pills · hover border accent */
  .trust-pill{transition:border-color 240ms var(--ease),background 240ms var(--ease)}
  .trust-pill:hover{border-color:var(--accent-text)}

  @media (max-width:900px){
    .ft-tier1-grid{grid-template-columns:repeat(2,1fr)!important}
  }
  @media (max-width:640px){
    .ft-tier1-grid{grid-template-columns:1fr!important;gap:var(--space-6)!important}
  }

  /* Newsletter grid */
  .ft-nl-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:var(--space-10);
    align-items:center;
  }
  @media(max-width:768px){
    .ft-nl-grid{grid-template-columns:1fr}
  }

  /* Bottom row */
  .ft-bottom{
    padding-block:var(--space-5);
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
    gap:var(--space-4);
    font-family:var(--font-mono);
    font-size:var(--text-small);
    letter-spacing:var(--tracking-mono-tight);
    color:var(--muted);
  }
  .ft-bottom-left{display:flex;align-items:center;gap:20px;flex-wrap:wrap}
  .ft-bottom-right{display:flex;align-items:center;gap:18px;flex-wrap:wrap}
  @media(max-width:640px){
    .ft-bottom{flex-direction:column;align-items:flex-start}
  }
</style>
