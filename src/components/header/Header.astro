---
// Header · pure Astro + <script> interne pour state
// Refonte v3 (refactor/clean-architecture) :
//   — Tout le HTML (nav, mega-panels, mobile sheet) est rendu par Astro côté serveur
//   — Indexable LLM : tous les liens et labels sont dans le HTML servi
//   — Le <script> en bas (~50 LoC) gère l'état : openKey, scrolled, mobileOpen
//   — Plus de React island = ~6 KB JS économisés vs Header.tsx legacy
//
// Cf docs/07-component-patterns.md · Pattern 2 (Astro + <script> interne)

import { MEGA_MENU, type MegaMenuCategory } from '../../data/mega-menu';
import { langFromPath, alternateHref, t, hasBilingualMirror, localizeHref } from '../../lib/i18n';
import { SITE } from '../../site.config';

const lang = langFromPath(Astro.url.pathname);
const altHref = alternateHref(Astro.url.pathname, lang);
// P0.2-I · lancement FR monolingue : le miroir /en n'est plus généré.
// On force enMirror=false pour que le switcher FR/EN ne s'affiche jamais
// (sinon il pointerait vers un /en/* en 404). Infra i18n conservée :
// restaurer `hasBilingualMirror(Astro.url.pathname)` pour réactiver l'EN.
const enMirror = false;
// Prise de rendez-vous : URL unique (décision Simon 2026-10), la page contact porte le calendrier.
const ctaHref = '/contact?offer=audit-ia-pme&intent=audit';

// i18n · tous les liens de panel passent par la localisation (R3 fix) :
// en EN, `/solutions/x` → `/en/solutions/x`. `localizeHref` ne préfixe que les
// chemins commençant par `/`. GARDE-FOU 404 : certaines cibles sont FR-only
// (pas de miroir EN : /secteurs, /ressources/livres-blancs/ai-act-readiness…).
// Les localiser produirait un /en/* en 404. On ne préfixe donc une cible que si
// elle a un miroir bilingue (hasBilingualMirror) ; sinon on conserve le chemin
// FR canonique (qui répond 200). On ignore le fragment d'ancre pour le test.
const lh = (href: string) => {
  if (!href.startsWith('/') || lang === 'fr') return localizeHref(href, lang);
  const pathOnly = href.split('#')[0];
  return hasBilingualMirror(pathOnly) ? localizeHref(href, lang) : href;
};

// A11y · WCAG 4.1.2 — signale la branche de nav active (item top-level dont
// le hub `parentHref` contient la page courante). Compare le pathname FR
// normalisé (préfixe `/en` retiré, slash final ignoré).
const currentPath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const normalize = (p: string) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);
const here = normalize(currentPath);
const matchesHub = (hub: string) => here === hub || here.startsWith(`${hub}/`);
// `matchPrefixes` : sections absorbant d'autres racines d'URL (Solutions ↔ /offres
// depuis la fusion R3) marquent l'état actif aussi sur ces préfixes.
const isCurrentSection = (parentHref?: string, matchPrefixes?: string[]) => {
  if (parentHref && matchesHub(normalize(parentHref))) return true;
  return (matchPrefixes ?? []).some((p) => matchesHub(normalize(p)));
};
---
<header class="hdr" data-open="" id="hdr">
  <div class="hdr-inner">
    {/* Logo */}
    <a href={lang === 'fr' ? '/' : '/en'} class="wm" aria-label={SITE.name}>
      {/* Wordmark stylisé = actif de marque (l'italique médian est un choix de design) : un fork le remplace comme un logo, cf FORK.md « Limites connues ». */}
      Waim<i>i</i>a<span class="dot">.</span>
    </a>

    {/* Nav · 5 boutons (4 mega + 1 simple) */}
    <nav class="hdr-nav" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
      {MEGA_MENU.map((item) => (
        <div class="hdr-nav-item" data-nav-item={item.parent}>
          <button
            class="hdr-nav-trigger"
            data-mega-trigger={item.parent}
            id={`mega-trigger-${item.parent}`}
            type="button"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls={`mega-${item.parent}`}
            aria-current={isCurrentSection(item.parentHref, item.matchPrefixes) ? 'page' : undefined}
          >
            <span>{t(item.label, lang)}</span>
            <span class="caret" aria-hidden="true">▾</span>
          </button>
        </div>
      ))}
    </nav>

    {/* Lang toggle + CTA + burger (mobile) */}
    <div class="hdr-end">
      {/* P0.2-I · lancement FR monolingue : switcher FR/EN retiré (le miroir /en
          n'est plus généré). Réactiver le bloc ci-dessous + enMirror pour l'EN. */}
      {enMirror && (
        <a href={altHref} class="lang-toggle" aria-label={lang === 'fr' ? 'Switch to English' : 'Passer en français'}>
          <span class={lang === 'fr' ? 'on' : ''}>FR</span>
          <span class="sep">·</span>
          <span class={lang === 'en' ? 'on' : ''}>EN</span>
        </a>
      )}
      <a href={ctaHref} class="cta" data-mag="0.18">
        {lang === 'fr' ? 'Réserver un audit' : 'Book an audit'}
        <span aria-hidden>→</span>
      </a>
      <button class="burger" data-burger type="button" aria-label={lang === 'fr' ? 'Ouvrir le menu principal' : 'Open main menu'} aria-expanded="false" aria-controls="m-sheet">
        <i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>
      </button>
    </div>
  </div>
</header>

{/* Mega panels · un par mega-menu · cachés par défaut, révélés par data-open du header */}
{MEGA_MENU.map((item) => {
  const cols = item.columns.length === 2 ? '2' : item.columns.length === 4 ? '4' : '3';
  // Refonte V8.3 2026-07-16 : la col 3 (détail) est pilotée par le MODULE survolé
  // (col 2) ; la col 4 (featured) est STATIQUE PAR SYSTÈME (basculée par le
  // sélecteur col 1). On aplatit ici la liste des modules du sélecteur `systems`
  // (ordre système → ordre module ; sous-groupes `groups` aplatis), chaque module
  // portant sa clé stable (= href canonique) et son détail. Défaut col 3 = 1er
  // module du 1er système sélectionnable.
  const isSelectableSys = (s: MegaMenuCategory) =>
    !s.soon &&
    Boolean(s.key) &&
    Boolean((s.links && s.links.length) || (s.groups && s.groups.length));
  const sysColData = item.columns.find((c) => c.systems);
  const selectableSystems = (sysColData?.systems ?? []).filter(isSelectableSys);
  const modulesFlat = selectableSystems.flatMap((sys) => {
    const mods = sys.groups && sys.groups.length
      ? sys.groups.flatMap((g) => g.links)
      : (sys.links ?? []);
    return mods.map((link) => ({ key: link.href, link }));
  });
  const defaultModuleKey = modulesFlat[0]?.key;
  // Cartes featured à stacker (une par SYSTÈME, refonte V8.3) : le `featured` du
  // système. Une seule visible, basculée par le sélecteur (col 1). Défaut = 1er
  // système. Si aucune carte système (sections hors Solutions) → fallback sur le
  // `featured` de section statique.
  const defaultSysKey = selectableSystems[0]?.key ?? '';
  const sysFeatured = selectableSystems
    .map((sys) => ({ key: sys.key ?? '', card: sys.featured }))
    .filter((s) => Boolean(s.card));
  return (
    <div
      class="mega"
      data-mega-panel={item.parent}
      id={`mega-${item.parent}`}
      role="region"
      aria-hidden="true"
      aria-labelledby={`mega-trigger-${item.parent}`}
    >
      <div class="mega-inner" data-cols={cols}>
        {item.columns.map((col) => {
          // ── Colonne PANNEAU DYNAMIQUE (systemsPanel, directive Simon 2026-07-13) :
          //    rend TOUS les groupes de modules côté serveur (indexable SEO/LLM) ;
          //    le sélecteur jumeau bascule la visibilité (data-*, aucun fetch). Un
          //    seul visible, défaut = 1er système sélectionnable. Pas d'en-tête/
          //    footer propres (l'en-tête vit dans chaque groupe). ──────────────
          if (col.systemsPanel) {
            const sysCol = item.columns.find((c) => c.systems);
            const sysList = (sysCol?.systems ?? []).filter(
              (s) =>
                s.key &&
                ((s.links && s.links.length > 0) || (s.groups && s.groups.length > 0)),
            );
            return (
              /* data-need : hérite de l'idiome flèche/hairline existant des .mega-link. */
              <div class="mega-col mega-col--panel" data-need>
                <div class="mega-sys-panel" data-sys-panel>
                  {sysList.map((sys, i) => {
                    // Modules à plat OU sous-groupes titrés (Inbound/Outbound) :
                    // on unifie en « blocs » (intertitre optionnel + liens).
                    const blocks = sys.groups && sys.groups.length
                      ? sys.groups
                      : [{ label: undefined, links: sys.links ?? [] }];
                    return (
                    <div
                      class:list={['mega-sys-group', { 'is-active': i === 0 }]}
                      data-sys-group={sys.key}
                      id={`sys-panel-${item.parent}-${sys.key}`}
                      aria-label={t(sys.label, lang)}
                    >
                      <div class="mega-sys-hd">
                        <span class="t">{t(sys.label, lang)}</span>
                        {sys.description && <span class="d">{t(sys.description, lang)}</span>}
                      </div>
                      {blocks.map((block) => (
                        <div class="mega-sys-block">
                          {block.label && <div class="mega-sys-k">{t(block.label, lang)}</div>}
                          <ul>
                            {block.links.map((sub) => (
                              <li>
                                {sub.soon ? (
                                  <span class="mega-link is-soon">
                                    <span class="arr" aria-hidden="true">→</span>
                                    <span class="t">{t(sub.label, lang)}</span>
                                    {sub.badge && <span class="flag">{t(sub.badge, lang)}</span>}
                                  </span>
                                ) : (
                                  /* Le survol/focus d'un module (data-module-key) pilote les
                                     cols 3-4 (détail + featured). Défaut actif = 1er module. */
                                  <a
                                    class:list={['mega-link mega-link--module', { 'is-active': sub.href === defaultModuleKey }]}
                                    href={lh(sub.href)}
                                    data-module-key={sub.href}
                                  >
                                    <span class="arr" aria-hidden="true">→</span>
                                    <span class="t">{t(sub.label, lang)}</span>
                                    {sub.badge && <span class="flag">{t(sub.badge, lang)}</span>}
                                  </a>
                                )}
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                      {sys.href && (
                        <a class="mega-sys-cta" href={lh(sys.href)}>
                          {sys.hubLabel ? t(sys.hubLabel, lang) : (lang === 'fr' ? 'Voir le système →' : 'See the system →')}
                        </a>
                      )}
                    </div>
                    );
                  })}
                </div>
              </div>
            );
          }

          // ── Colonne SÉLECTEUR « Nos systèmes » (systems) : chaque système est
          //    une entrée focusable. Sélectionnable (avec key + links) → <a> si
          //    href (le clic suit le lien, le survol bascule le panneau) sinon
          //    <button>. « À venir » → <span> muted non-interactif. ────────────
          if (col.systems) {
            const isSelectable = (s: MegaMenuCategory) =>
              !s.soon &&
              Boolean(s.key) &&
              Boolean((s.links && s.links.length) || (s.groups && s.groups.length));
            const defaultKey = col.systems.find(isSelectable)?.key;
            return (
              <div class="mega-col mega-col--systems">
                <div class="mega-col-hd">
                  <div class="t">{t(col.title, lang)}</div>
                </div>
                <div class="mega-sys-list">
                  {col.systems.map((sys) => {
                    if (!isSelectable(sys)) {
                      return (
                        <span class="mega-sys-opt is-soon">
                          <span class="t">{t(sys.label, lang)}</span>
                          {sys.badge && <span class="flag">{t(sys.badge, lang)}</span>}
                        </span>
                      );
                    }
                    const groupId = `sys-panel-${item.parent}-${sys.key}`;
                    const isActive = sys.key === defaultKey;
                    return sys.href ? (
                      <a
                        class:list={['mega-sys-opt', { 'is-active': isActive }]}
                        href={lh(sys.href)}
                        data-sys-key={sys.key}
                        aria-controls={groupId}
                        aria-current={isActive ? 'true' : undefined}
                      >
                        <span class="t">{t(sys.label, lang)}</span>
                        {sys.badge && <span class="flag">{t(sys.badge, lang)}</span>}
                        <span class="ind" aria-hidden="true">›</span>
                      </a>
                    ) : (
                      <button
                        class:list={['mega-sys-opt', { 'is-active': isActive }]}
                        type="button"
                        data-sys-key={sys.key}
                        aria-controls={groupId}
                        aria-current={isActive ? 'true' : undefined}
                      >
                        <span class="t">{t(sys.label, lang)}</span>
                        {sys.badge && <span class="flag">{t(sys.badge, lang)}</span>}
                        <span class="ind" aria-hidden="true">›</span>
                      </button>
                    );
                  })}
                </div>
              </div>
            );
          }

          // ── Colonne « Le module en détail » CONDITIONNELLE (moduleDetail,
          //    refonte V8.2 2026-07-14, granularité MODULE) : rend le panneau
          //    `detail` de CHAQUE module côté serveur (indexable), un seul visible ;
          //    le survol/focus d'un module (col 2) bascule (délai d'intention).
          //    En-tête commun. Défaut = 1er module du système par défaut. Réutilise
          //    l'idiome grille superposée `.mega-sys-panel`/`.mega-sys-group`. ─────
          if (col.moduleDetail) {
            const detailModules = modulesFlat.filter((m) => m.link.detail && m.link.detail.length);
            return (
              <div class="mega-col mega-col--detail" data-need>
                <div class="mega-col-hd">
                  <div class="t">{t(col.title, lang)}</div>
                </div>
                <div class="mega-sys-panel">
                  {detailModules.map((m) => (
                    <div
                      class:list={['mega-sys-group', { 'is-active': m.key === defaultModuleKey }]}
                      data-module-detail={m.key}
                      aria-label={t(m.link.label, lang)}
                    >
                      {(m.link.detail ?? []).map((block) => (
                        <div class="mega-sys-block">
                          <div class="mega-sys-k">{t(block.label, lang)}</div>
                          <ul>
                            {block.links.map((sub) => (
                              <li>
                                {sub.soon ? (
                                  <span class="mega-link is-soon">
                                    <span class="arr" aria-hidden="true">→</span>
                                    <span class="t">{t(sub.label, lang)}</span>
                                    {sub.badge && <span class="flag">{t(sub.badge, lang)}</span>}
                                  </span>
                                ) : (
                                  <a class="mega-link" href={lh(sub.href)}>
                                    <span class="arr" aria-hidden="true">→</span>
                                    <span class="t">{t(sub.label, lang)}</span>
                                    {sub.badge && <span class="flag">{t(sub.badge, lang)}</span>}
                                  </a>
                                )}
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            );
          }

          // ── Colonnes classiques (links / data-need « par besoin ») — inchangé. ──
          const isNeed = Boolean(col.goal || col.quote);
          return (
          <div class="mega-col" data-need={isNeed ? '' : undefined}>
            <div class="mega-col-hd">
              {/* Kicker de colonne retiré du rendu : il répétait le titre `.t`
                  (« SITE WEB INTELLIGENT » ≡ « Site web intelligent »). Le titre
                  suffit (correction Simon 2026-06). `col.kicker` reste en data. */}
              <div class="t">{t(col.title, lang)}</div>
              {col.goal && <div class="goal">{t(col.goal, lang)}</div>}
            </div>
            {col.quote && <p class="mega-quote">{t(col.quote, lang)}</p>}
            <ul>
              {col.links.map((sub) => (
                <li>
                  {sub.soon ? (
                    <span class="mega-link is-soon">
                      {isNeed && <span class="arr" aria-hidden="true">→</span>}
                      <span class="t">{t(sub.label, lang)}</span>
                      {sub.badge && <span class="flag">{t(sub.badge, lang)}</span>}
                      {!isNeed && sub.description && <span class="sub">{t(sub.description, lang)}</span>}
                    </span>
                  ) : (
                    <a class="mega-link" href={lh(sub.href)}>
                      {isNeed && <span class="arr" aria-hidden="true">→</span>}
                      <span class="t">{t(sub.label, lang)}</span>
                      {sub.badge && <span class="flag">{t(sub.badge, lang)}</span>}
                      {!isNeed && sub.description && <span class="sub">{t(sub.description, lang)}</span>}
                    </a>
                  )}
                </li>
              ))}
            </ul>
            {col.footer && (
              col.footer.soon ? (
                <span class="mega-col-footer is-soon">{t(col.footer.label, lang)}</span>
              ) : (
                <a class="mega-col-footer" href={lh(col.footer.href)}>{t(col.footer.label, lang)}</a>
              )
            )}
          </div>
          );
        })}
        {sysFeatured.length > 0 ? (
          /* Stack featured par SYSTÈME (refonte V8.3 2026-07-16) : grille superposée
             dans le slot featured, une seule carte visible, basculée par le survol
             du sélecteur système (data-sys-featured). Défaut = 1er système.
             Statique tant qu'on reste sur le même système (inchangé au survol module). */
          <div class="mega-featured-stack">
            {sysFeatured.map((m) => m.card && (
              <div
                class:list={['mega-featured', { 'is-active': m.key === defaultSysKey }]}
                data-sys-featured={m.key}
              >
                <div class="badge">{t(m.card.kicker, lang)}</div>
                <div class="ttl">{t(m.card.label, lang)}</div>
                <div class="bd">{t(m.card.body, lang)}</div>
                {m.card.image && (
                  <a class="img lift" href={lh(m.card.href)} aria-hidden="true" tabindex="-1">
                    <img src={m.card.image} alt="" width="1536" height="1024" loading="lazy" decoding="async" />
                  </a>
                )}
                <a class="cta btn btn-primary" href={lh(m.card.href)}>
                  {t(m.card.cta, lang)}
                </a>
              </div>
            ))}
          </div>
        ) : item.featured && (
          <div class="mega-featured">
            <div class="badge">{t(item.featured.kicker, lang)}</div>
            <div class="ttl">{t(item.featured.label, lang)}</div>
            <div class="bd">{t(item.featured.body, lang)}</div>
            {item.featured.image && (
              <a class="img lift" href={lh(item.featured.href)} aria-hidden="true" tabindex="-1">
                <img src={item.featured.image} alt="" width="1536" height="1024" loading="lazy" decoding="async" />
              </a>
            )}
            <a class="cta btn btn-primary" href={lh(item.featured.href)}>
              {t(item.featured.cta, lang)}
            </a>
          </div>
        )}
      </div>
      {item.problemBand && (
        /* Bande « Résoudre un problème » horizontale (refonte V8.2 2026-07-14) :
           remplace l'ancienne colonne problèmes. Intitulé + liens inline (cas-usages),
           compacts, une ligne (wrap autorisé). */
        <div class="mega-problem-band">
          <span class="mega-problem-band-k">{t(item.problemBand.label, lang)}</span>
          <div class="mega-problem-band-links">
            {item.problemBand.links.map((sub) => (
              sub.soon ? (
                <span class="is-soon">{t(sub.label, lang)}</span>
              ) : (
                <a href={lh(sub.href)}>{t(sub.label, lang)}</a>
              )
            ))}
          </div>
        </div>
      )}
      <div class="mega-bottom">
        {item.lead && <span>{t(item.lead, lang)}</span>}
        {item.parentHref && (
          <a href={lh(item.parentHref)}>
            {lang === 'fr' ? `Tout voir : ${t(item.label, lang)} →` : `See all: ${t(item.label, lang)} →`}
          </a>
        )}
      </div>
    </div>
  );
})}

{/* Scrim overlay derrière les mega panels */}
<div class="mega-scrim" data-mega-scrim aria-hidden="true"></div>

{/* Mobile sheet · accordéon des mega-menus */}
<div
  class="m-sheet"
  id="m-sheet"
  data-mobile-sheet
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="m-sheet-title"
>
  <div class="m-sheet-top">
    <span class="wm" id="m-sheet-title">Waim<i>i</i>a<span class="dot">.</span></span>
    <button class="m-sheet-close" data-mobile-close type="button" aria-label={lang === 'fr' ? 'Fermer le menu' : 'Close menu'}>×</button>
  </div>
  <nav class="m-sheet-body" aria-label={lang === 'fr' ? 'Navigation mobile principale' : 'Main mobile navigation'}>
    {MEGA_MENU.map((item, idx) => (
      <div class="m-sheet-acc" data-acc={item.parent}>
        <button class="m-sheet-acc-head" data-acc-trigger={item.parent} type="button" aria-expanded="false" aria-controls={`m-acc-body-${item.parent}`}>
          <span class="num">0{idx + 1}</span>
          <span class="ttl">{t(item.label, lang)}</span>
          <span class="plus" aria-hidden="true">+</span>
        </button>
        <div class="m-sheet-acc-body" id={`m-acc-body-${item.parent}`}>
          <div class="m-sheet-acc-inner">
            {item.columns.map((col) => {
              // Colonne PANNEAU : ses modules vivent déjà dans les sous-accordéons
              // du sélecteur (col `systems`) → rien à rendre côté mobile.
              if (col.systemsPanel) return null;
              // Col « le module en détail » : le détail vit dans chaque toggle
              // module du sélecteur (col `systems`) → rien à rendre séparément
              // en mobile (refonte V8.2 2026-07-14).
              if (col.moduleDetail) return null;
              return (
              <div class="m-sheet-acc-col" data-need={col.goal || col.quote ? '' : undefined}>
                {/* Kicker de colonne retiré (répétait le titre), cf desktop. */}
                <div class="t">{t(col.title, lang)}</div>
                {col.goal && <div class="g">{t(col.goal, lang)}</div>}
                {col.quote && <p class="q">{t(col.quote, lang)}</p>}
                {col.systems ? (
                  /* Sous-niveau mobile (directive Simon 2026-07-13) : chaque système
                     = une ligne à chevron qui déplie ses modules (sous-accordéon
                     indépendant, ouvrable/refermable, l'accordéon parent continue de
                     fonctionner). Sous-groupes = simples intertitres. « À venir » =
                     ligne muette non dépliable. */
                  col.systems.map((sys) => {
                    const selectable =
                      !sys.soon &&
                      Boolean(sys.key) &&
                      Boolean((sys.links && sys.links.length) || (sys.groups && sys.groups.length));
                    if (!selectable) {
                      return (
                        <span class="m-sys-soon">
                          {t(sys.label, lang)}
                          {sys.badge && <span class="flag">{t(sys.badge, lang)}</span>}
                        </span>
                      );
                    }
                    const blocks = sys.groups && sys.groups.length
                      ? sys.groups
                      : [{ label: undefined, links: sys.links ?? [] }];
                    const bodyId = `m-sys-body-${item.parent}-${sys.key}`;
                    return (
                      <div class="m-sys" data-sys-acc={sys.key}>
                        <button class="m-sys-head" type="button" data-sys-acc-trigger={sys.key} aria-expanded="false" aria-controls={bodyId}>
                          <span class="l">{t(sys.label, lang)}</span>
                          {sys.badge && <span class="flag">{t(sys.badge, lang)}</span>}
                          <span class="chev" aria-hidden="true">+</span>
                        </button>
                        <div class="m-sys-body" id={bodyId}>
                          <div class="m-sys-body-inner">
                            {blocks.map((block) => (
                              <Fragment>
                                {block.label && <div class="m-sys-k">{t(block.label, lang)}</div>}
                                {block.links.map((sub) => {
                                  // Sous-niveau MODULE (refonte V8.2 2026-07-14) : un module
                                  // avec `detail` devient un toggle qui déplie « le module en
                                  // détail » (lien vers la page module en tête + liens detail).
                                  // Toggle indépendant, imbriqué dans le sous-accordéon système.
                                  if (sub.soon) {
                                    return (
                                      <span class="is-soon m-cat-link">
                                        {t(sub.label, lang)}
                                        {sub.badge && <span class="flag">{t(sub.badge, lang)}</span>}
                                      </span>
                                    );
                                  }
                                  if (!sub.detail || !sub.detail.length) {
                                    return (
                                      <a class="m-cat-link" href={lh(sub.href)}>
                                        {t(sub.label, lang)}
                                        {sub.badge && <span class="flag">{t(sub.badge, lang)}</span>}
                                      </a>
                                    );
                                  }
                                  const modBodyId = `m-mod-body-${item.parent}-${sub.href.replace(/[^a-z0-9]+/gi, '-')}`;
                                  return (
                                    <div class="m-mod" data-mod-acc={sub.href}>
                                      <button class="m-mod-head" type="button" data-mod-acc-trigger={sub.href} aria-expanded="false" aria-controls={modBodyId}>
                                        <span class="l">{t(sub.label, lang)}</span>
                                        {sub.badge && <span class="flag">{t(sub.badge, lang)}</span>}
                                        <span class="chev" aria-hidden="true">+</span>
                                      </button>
                                      <div class="m-mod-body" id={modBodyId}>
                                        <div class="m-mod-body-inner">
                                          <a class="m-mod-page" href={lh(sub.href)}>
                                            {lang === 'fr' ? 'Voir la page →' : 'See the page →'}
                                          </a>
                                          {(sub.detail ?? []).map((dblock) => (
                                            <Fragment>
                                              <div class="m-sys-k">{t(dblock.label, lang)}</div>
                                              {dblock.links.map((dl) => (
                                                dl.soon ? (
                                                  <span class="is-soon m-cat-link">{t(dl.label, lang)}</span>
                                                ) : (
                                                  <a class="m-cat-link" href={lh(dl.href)}>{t(dl.label, lang)}</a>
                                                )
                                              ))}
                                            </Fragment>
                                          ))}
                                        </div>
                                      </div>
                                    </div>
                                  );
                                })}
                              </Fragment>
                            ))}
                            {sys.href && (
                              <a class="m-sys-hub" href={lh(sys.href)}>
                                {sys.hubLabel ? t(sys.hubLabel, lang) : (lang === 'fr' ? 'Voir le système →' : 'See the system →')}
                              </a>
                            )}
                          </div>
                        </div>
                      </div>
                    );
                  })
                ) : (
                  col.links.map((sub) => (
                    sub.soon ? (
                      <span class="is-soon">
                        {t(sub.label, lang)}
                        {sub.badge && <span class="flag">{t(sub.badge, lang)}</span>}
                      </span>
                    ) : (
                      <a href={lh(sub.href)}>
                        {t(sub.label, lang)}
                        {sub.badge && <span class="flag">{t(sub.badge, lang)}</span>}
                      </a>
                    )
                  ))
                )}
                {col.footer && (col.footer.soon
                  ? <span class="is-soon">{t(col.footer.label, lang)}</span>
                  : <a href={lh(col.footer.href)}>{t(col.footer.label, lang)}</a>)}
              </div>
              );
            })}
            {item.problemBand && (
              /* Bande « Résoudre un problème » en mobile (refonte V8.2 2026-07-14) :
                 rendue comme une colonne d'accordéon, liens cas-usages empilés. */
              <div class="m-sheet-acc-col">
                <div class="t">{lang === 'fr' ? 'Résoudre un problème' : 'Solve a problem'}</div>
                <div class="g">{t(item.problemBand.label, lang)}</div>
                {item.problemBand.links.map((sub) => (
                  <a href={lh(sub.href)}>{t(sub.label, lang)}</a>
                ))}
              </div>
            )}
            {/* « Tout voir » mobile (2026-10-06, menus allégés) : jumeau du lien de pied du
                mega panel desktop, pour que chaque rubrique renvoie aussi à son hub en mobile. */}
            {item.parentHref && (
              <div class="m-sheet-acc-col">
                <a href={lh(item.parentHref)}>
                  {lang === 'fr' ? `Tout voir : ${t(item.label, lang)} →` : `See all: ${t(item.label, lang)} →`}
                </a>
              </div>
            )}
          </div>
        </div>
      </div>
    ))}
  </nav>
  <div class="m-sheet-end">
    {/* P0.2-I · lancement FR monolingue : lien English retiré du menu mobile. */}
    {enMirror && (
      <a href={altHref} class="btn btn-ghost">
        {lang === 'fr' ? 'English →' : 'Français →'}
      </a>
    )}
    <a href={ctaHref} class="btn btn-primary">
      {lang === 'fr' ? 'Réserver un audit →' : 'Book an audit →'}
    </a>
  </div>
</div>

{/* Logique state · `is:inline` pour bypass le bug Astro 6 + adapter Vercel
   en dev (script bundlé via virtual path Vite retourne 500). En prod, c'est
   inlined direct dans le HTML SSR : slightly bigger HTML mais aucun fetch
   supplémentaire et fonctionne en local + prod identique.
   A11y · WCAG 2.4.5 (Multiple Ways) + 2.1.1 (Keyboard) + 4.1.2 (Name, Role, Value) */}
<script is:inline>
  // Encapsule toute la logique dans initHeader() pour pouvoir la re-executer
  // a chaque navigation ClientRouter (astro:page-load fire au load initial
  // ET a chaque transition). Sans ca, les event listeners sont attaches aux
  // refs DOM remplacees par la navigation → mega-menu casse apres clic.
  function initHeader() {
  // ─── 1. Refs · groupées en une passe DOM ───────────────────────────────
  const hdrEl = document.getElementById('hdr');
  if (hdrEl) {
    const hdr = hdrEl;
    if (hdr.dataset.headerBound === '1') return;
    hdr.dataset.headerBound = '1';
    const triggers = Array.from(document.querySelectorAll('[data-mega-trigger]'));
    const panels   = Array.from(document.querySelectorAll('[data-mega-panel]'));
    const navItems = Array.from(document.querySelectorAll('[data-nav-item]'));
    const scrim      = document.querySelector('[data-mega-scrim]');
    const burger     = document.querySelector('[data-burger]');
    const sheet      = document.querySelector('[data-mobile-sheet]');
    const closeSheet = document.querySelector('[data-mobile-close]');
    const navRoot    = document.querySelector('.hdr-nav');
    const bodySiblings = Array.from(document.body.children).filter((el) => el !== sheet);

    // ─── 2. State ────────────────────────────────────────────────────────
    let closeTimer = null;
    let openKey = '';
    let lastSheetTrigger = null;

    const triggerByKey = new Map(triggers.map((t) => [t.getAttribute('data-mega-trigger') || '', t]));
    const panelByKey   = new Map(panels.map((p) => [p.getAttribute('data-mega-panel') || '', p]));
    const navItemByKey = new Map(navItems.map((n) => [n.getAttribute('data-nav-item') || '', n]));
    const moveTriggerFocus = (currentKey, delta) => {
      const keys = triggers.map((trigger) => trigger.getAttribute('data-mega-trigger') || '').filter(Boolean);
      const currentIndex = keys.indexOf(currentKey);
      if (currentIndex === -1 || keys.length === 0) return;
      const nextIndex = (currentIndex + delta + keys.length) % keys.length;
      const nextTrigger = triggerByKey.get(keys[nextIndex]);
      if (nextTrigger instanceof HTMLElement) nextTrigger.focus();
    };
    const focusPanelLink = (key, strategy) => {
      const panel = panelByKey.get(key);
      const links = panel ? Array.from(panel.querySelectorAll('a[href]')) : [];
      if (links.length === 0) return;
      const target = strategy === 'last' ? links[links.length - 1] : links[0];
      if (target instanceof HTMLElement) target.focus();
    };

    function clearCloseTimer() {
      if (closeTimer !== null) {
        window.clearTimeout(closeTimer);
        closeTimer = null;
      }
    }

    // ─── 3. Open / close mega panel ──────────────────────────────────────
    function setPanelState(panel, isOpen) {
      panel.classList.toggle('is-open', isOpen);
      panel.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
      if (isOpen) {
        panel.removeAttribute('inert');
      } else {
        panel.setAttribute('inert', '');
      }
    }

    function setOpen(nextKey) {
      clearCloseTimer();
      if (nextKey === openKey) return;

      if (openKey) {
        const t = triggerByKey.get(openKey); if (t) t.setAttribute('aria-expanded', 'false');
        const p = panelByKey.get(openKey); if (p) setPanelState(p, false);
        const n = navItemByKey.get(openKey); if (n) n.classList.remove('is-open');
      }
      if (nextKey) {
        const t = triggerByKey.get(nextKey); if (t) t.setAttribute('aria-expanded', 'true');
        const p = panelByKey.get(nextKey); if (p) setPanelState(p, true);
        const n = navItemByKey.get(nextKey); if (n) n.classList.add('is-open');
      }

      openKey = nextKey;
      hdr.setAttribute('data-open', nextKey);
      if (scrim) scrim.classList.toggle('is-open', Boolean(nextKey));
    }

    for (const panel of panels) {
      setPanelState(panel, false);
    }

    function scheduleClose() {
      clearCloseTimer();
      closeTimer = window.setTimeout(() => setOpen(''), 180);
    }

    // ─── 4. Mega trigger interactions (mouse + keyboard) ────────────────
    for (const trigger of triggers) {
      const key = trigger.getAttribute('data-mega-trigger') || '';
      const item = trigger.closest('[data-nav-item]');
      if (!item) continue;

      item.addEventListener('mouseenter', () => setOpen(key));
      item.addEventListener('focusin', () => setOpen(key));

      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        clearCloseTimer();
        setOpen(openKey === key ? '' : key);
      });

      trigger.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          setOpen(key);
          requestAnimationFrame(() => focusPanelLink(key, 'first'));
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          setOpen(key);
          requestAnimationFrame(() => focusPanelLink(key, 'last'));
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          moveTriggerFocus(key, 1);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          moveTriggerFocus(key, -1);
        } else if (e.key === 'Home') {
          e.preventDefault();
          const firstTrigger = triggers[0];
          if (firstTrigger instanceof HTMLElement) firstTrigger.focus();
        } else if (e.key === 'End') {
          e.preventDefault();
          const lastTrigger = triggers[triggers.length - 1];
          if (lastTrigger instanceof HTMLElement) lastTrigger.focus();
        }
      });
    }

    if (navRoot) navRoot.addEventListener('mouseleave', scheduleClose);

    for (const panel of panels) {
      panel.addEventListener('mouseenter', () => {
        const key = panel.getAttribute('data-mega-panel');
        if (key) setOpen(key);
      });
      panel.addEventListener('mouseleave', scheduleClose);
      panel.addEventListener('keydown', (e) => {
        const key = panel.getAttribute('data-mega-panel') || '';
        // Exclut les liens des groupes systèmes masqués (visibility:hidden,
        // panneau dynamique) : la nav flèches ne doit parcourir que le visible.
        const links = Array.from(panel.querySelectorAll('a[href]')).filter(
          (l) => getComputedStyle(l).visibility !== 'hidden',
        );
        const activeIndex = e.target instanceof HTMLAnchorElement ? links.indexOf(e.target) : -1;
        if (e.key === 'Escape') {
          setOpen('');
          const t = triggerByKey.get(key); if (t) t.focus();
        } else if ((e.key === 'ArrowUp' || e.key === 'ArrowLeft') && activeIndex === 0) {
          e.preventDefault();
          const t = triggerByKey.get(key); if (t) t.focus();
        } else if (activeIndex >= 0 && (e.key === 'ArrowDown' || e.key === 'ArrowRight')) {
          const nextLink = links[activeIndex + 1];
          if (nextLink instanceof HTMLElement) {
            e.preventDefault();
            nextLink.focus();
          }
        } else if (activeIndex > 0 && (e.key === 'ArrowUp' || e.key === 'ArrowLeft')) {
          const prevLink = links[activeIndex - 1];
          if (prevLink instanceof HTMLElement) {
            e.preventDefault();
            prevLink.focus();
          }
        }
      });
    }

    // ─── 4bis. Sélecteur systèmes → modules → détail (panneau Solutions) ──
    // Refonte V8.3 2026-07-16. Deux niveaux de bascule, tous en visibilité CSS
    // (aucun fetch), scopés au mega panel courant :
    //   · SYSTÈME (col 1, [data-sys-key]) → bascule le groupe modules (col 2,
    //     [data-sys-group]) ET le featured (col 4, [data-sys-featured], STATIQUE
    //     par système) ET remet le module actif = 1er module du système.
    //   · MODULE (col 2, [data-module-key]) → bascule le détail (col 3,
    //     [data-module-detail]) seul, avec un léger délai d'intention au survol
    //     (anti-clignotement en traversée diagonale) ; le focus clavier bascule
    //     immédiatement. Le featured col 4 ne bouge PAS au survol module.
    // Idempotent (toute la fonction est gardée par headerBound).
    for (const sysPanel of document.querySelectorAll('[data-sys-panel]')) {
      const scope = sysPanel.closest('[data-mega-panel]') || document;
      const groups = Array.from(sysPanel.querySelectorAll('[data-sys-group]'));
      const sysOpts = Array.from(scope.querySelectorAll('[data-sys-key]'));
      const moduleLinks = Array.from(scope.querySelectorAll('[data-module-key]'));
      const details = Array.from(scope.querySelectorAll('[data-module-detail]'));
      const featured = Array.from(scope.querySelectorAll('[data-sys-featured]'));
      // Modules (dans l'ordre DOM) par système, pour retrouver le 1er module
      // d'un système quand on le survole.
      const modulesBySys = new Map();
      for (const g of groups) {
        const sysKey = g.getAttribute('data-sys-group') || '';
        const keys = Array.from(g.querySelectorAll('[data-module-key]'))
          .map((a) => a.getAttribute('data-module-key') || '');
        modulesBySys.set(sysKey, keys);
      }
      let hoverTimer = null;
      const clearHover = () => {
        if (hoverTimer !== null) { window.clearTimeout(hoverTimer); hoverTimer = null; }
      };
      const activateModule = (key) => {
        if (!key) return;
        for (const d of details) {
          d.classList.toggle('is-active', d.getAttribute('data-module-detail') === key);
        }
        for (const l of moduleLinks) {
          l.classList.toggle('is-active', l.getAttribute('data-module-key') === key);
        }
      };
      const activateSys = (key) => {
        if (!key) return;
        for (const g of groups) {
          g.classList.toggle('is-active', g.getAttribute('data-sys-group') === key);
        }
        // Col 4 featured STATIQUE par système : bascule ici (col 1), pas au survol module.
        for (const f of featured) {
          f.classList.toggle('is-active', f.getAttribute('data-sys-featured') === key);
        }
        for (const o of sysOpts) {
          const on = o.getAttribute('data-sys-key') === key;
          o.classList.toggle('is-active', on);
          if (on) o.setAttribute('aria-current', 'true');
          else o.removeAttribute('aria-current');
        }
        // Changer de système remet le module actif au 1er module de ce système.
        clearHover();
        const first = (modulesBySys.get(key) || [])[0];
        activateModule(first);
      };
      for (const o of sysOpts) {
        const key = o.getAttribute('data-sys-key') || '';
        o.addEventListener('pointerenter', () => activateSys(key));
        o.addEventListener('focus', () => activateSys(key));
        o.addEventListener('click', () => activateSys(key));
      }
      for (const l of moduleLinks) {
        const key = l.getAttribute('data-module-key') || '';
        l.addEventListener('pointerenter', () => {
          clearHover();
          hoverTimer = window.setTimeout(() => activateModule(key), 90);
        });
        l.addEventListener('pointerleave', clearHover);
        // Focus clavier = bascule immédiate (pas de délai d'intention).
        l.addEventListener('focus', () => { clearHover(); activateModule(key); });
      }
    }

    // ─── 5. Scrim + global keyboard ─────────────────────────────────────
    if (scrim) scrim.addEventListener('click', () => setOpen(''));
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && openKey) setOpen('');
    });

    // ─── 6. Scroll-state for shrink ─────────────────────────────────────
    const onScroll = () => hdr.classList.toggle('is-scrolled', window.scrollY > 24);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // ─── 7. Mobile sheet ────────────────────────────────────────────────
    function setOutsideSheetInert(isOpen) {
      for (const el of bodySiblings) {
        if (isOpen) {
          el.setAttribute('inert', '');
        } else {
          el.removeAttribute('inert');
        }
      }
    }

    function setSheetOpen(open) {
      setOpen('');
      if (sheet) {
        sheet.classList.toggle('is-open', open);
        sheet.setAttribute('aria-hidden', open ? 'false' : 'true');
        if (open) {
          sheet.removeAttribute('inert');
        } else {
          sheet.setAttribute('inert', '');
        }
      }
      setOutsideSheetInert(open);
      if (burger) { burger.classList.toggle('is-open', open); burger.setAttribute('aria-expanded', open ? 'true' : 'false'); }
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) {
        lastSheetTrigger = document.activeElement instanceof HTMLElement ? document.activeElement : burger;
        requestAnimationFrame(() => {
          const firstFocusable = sheet && sheet.querySelector('button, a[href]');
          if (firstFocusable instanceof HTMLElement) firstFocusable.focus();
        });
      } else if (lastSheetTrigger instanceof HTMLElement) {
        requestAnimationFrame(() => lastSheetTrigger.focus());
      }
    }
    if (sheet) sheet.setAttribute('inert', '');
    if (burger) burger.addEventListener('click', () => {
      setSheetOpen(!(sheet && sheet.classList.contains('is-open')));
    });
    if (closeSheet) closeSheet.addEventListener('click', () => setSheetOpen(false));
    if (sheet) {
      sheet.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          e.preventDefault();
          setSheetOpen(false);
          return;
        }
        if (e.key !== 'Tab' || !sheet.classList.contains('is-open')) return;
        const focusables = Array.from(sheet.querySelectorAll('button:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])')).filter(
          (el) => el instanceof HTMLElement && !el.hasAttribute('inert'),
        );
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (!(first instanceof HTMLElement) || !(last instanceof HTMLElement)) return;
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });
    }

    window.addEventListener('pagehide', () => {
      document.body.style.overflow = '';
      setOutsideSheetInert(false);
    });

    for (const tr of document.querySelectorAll('[data-acc-trigger]')) {
      tr.addEventListener('click', () => {
        const key = tr.getAttribute('data-acc-trigger') || '';
        const acc = document.querySelector(`[data-acc="${key}"]`);
        const isOpen = acc ? acc.classList.toggle('is-open') : false;
        tr.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    }

    // Sous-accordéon mobile « système » (sous-niveau, directive Simon 2026-07-13) :
    // chaque système se déplie/replie indépendamment ; l'accordéon parent reste
    // pleinement fonctionnel. Scopé via closest (robuste aux clés dupliquées).
    for (const tr of document.querySelectorAll('[data-sys-acc-trigger]')) {
      tr.addEventListener('click', () => {
        const acc = tr.closest('[data-sys-acc]');
        const isOpen = acc ? acc.classList.toggle('is-open') : false;
        tr.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    }

    // Sous-niveau MODULE mobile (refonte V8.2 2026-07-14) : chaque module à
    // détail se déplie/replie indépendamment (« le module en détail »), imbriqué
    // dans le sous-accordéon système, sans casser les toggles parents.
    for (const tr of document.querySelectorAll('[data-mod-acc-trigger]')) {
      tr.addEventListener('click', () => {
        const acc = tr.closest('[data-mod-acc]');
        const isOpen = acc ? acc.classList.toggle('is-open') : false;
        tr.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    }

    if (sheet) for (const link of sheet.querySelectorAll('a')) {
      link.addEventListener('click', () => setSheetOpen(false));
    }
  }
  }

  // Re-init a chaque navigation ClientRouter ET au load initial.
  // astro:page-load fire dans les deux cas (Astro 6 + ViewTransitions).
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }
  document.addEventListener('astro:page-load', initHeader);
</script>

{/* Styles `.mega` et `.mega.is-open` sont déjà dans src/styles/global.css.
   Pas de <style> ici pour éviter le bug de scoping Astro qui ferait perdre
   l'override sur la classe React-added au runtime. */}
<style is:global>
  .hdr .wm:focus-visible,
  .hdr-nav-trigger:focus-visible,
  .lang-toggle:focus-visible,
  .hdr .cta:focus-visible,
  .burger:focus-visible,
  .mega-link:focus-visible,
  .mega-bottom a:focus-visible,
  .m-sheet-close:focus-visible,
  .m-sheet-acc-head:focus-visible,
  .m-sheet-acc-col a:focus-visible,
  .m-sheet-end .btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .hdr-nav-trigger:focus-visible,
  .lang-toggle:focus-visible,
  .burger:focus-visible,
  .m-sheet-close:focus-visible,
  .m-sheet-acc-head:focus-visible,
  .m-sheet-end .btn:focus-visible {
    background: var(--paper-2);
  }

  .mega-link:focus-visible,
  .mega-bottom a:focus-visible,
  .m-sheet-acc-col a:focus-visible {
    color: var(--ink);
    border-color: var(--accent-text);
  }

  .lang-toggle-disabled { opacity: .5; cursor: default; pointer-events: none; }

  /* Liens « à venir » (soon) : rendus en <span> non-cliquable (pas de href),
     grisés. 0 lien mort / 0 crawl vers 404 (strategy/11 §8). */
  .mega-link.is-soon, .m-sheet-acc-col .is-soon { cursor: default; opacity: 0.55; }
  .mega-link.is-soon:hover, .m-sheet-acc-col .is-soon:hover { opacity: 0.55; }
  /* V7-FOLD : footer de colonne « à venir » (ex. Voir tous les problèmes) non-cliquable. */
  .mega-col-footer.is-soon { cursor: default; opacity: 0.55; border-bottom-color: transparent; }

  /* ─ Mega menu « systèmes → modules » (directive Simon 2026-07-13) ─────────
     Col 1 = sélecteur d'entrées système ; col 2 = panneau dynamique (tous les
     groupes rendus SSR, un seul visible : switch data-* piloté par le script).
     100% tokens DS existants, 0 nouvelle variable. */

  /* Sélecteur · entrées système (a / button / span « à venir »). */
  .mega-sys-list {
