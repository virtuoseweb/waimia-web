---
/**
 * Prop02 · « Index éditorial » (data-bg paper-2)
 * Sommaire de revue : 4 grandes rangées séparées par filets horizontaux.
 * Chaque rangée : grand numéro mono « 01 »…« 04 », titre serif, puis liste de liens
 * inline serrée à droite. 01 L'auteur · 02 Repères · 03 Secteurs · 04 Ressources & services.
 * Très typographique, vertical. Tous les href du pack = vrais <a> (maillage interne).
 * Contenu : EEAT_PACK (source unique, 0 prop, 0 hardcode contenu).
 */
import { EEAT_PACK } from '../../../data/eeat-proposals';
const P = EEAT_PACK;
// Numéros DÉRIVÉS de l'index (01…04), jamais stockés.
const num = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="ep2" data-bg="paper-2" aria-labelledby="ep2-h2">
  <div class="wrap-wide ep2__in reveal-stagger">
    <header class="ep2-hd">
      <span class="ep2-kicker">
        <span class="ep2-kicker__dot" aria-hidden="true"></span>
        Index éditorial
      </span>
      <span class="ep2-meta">Auteur · repères · secteurs · ressources</span>
    </header>

    <h2 id="ep2-h2" class="ep2-title">
      Qui écrit, ce qu'il a fait, <i class="acc">ce qu'il publie</i>
    </h2>

    <ol class="ep2-rows">
      <li class="ep2-row">
        <span class="ep2-num">{num(0)}</span>
        <div class="ep2-rowmain">
          <h3 class="ep2-rowtitle">L'auteur</h3>
          <div class="ep2-rowbody">
            <p class="ep2-line"><span class="ep2-strong">{P.author.name}</span> · {P.author.role}</p>
            <p class="ep2-line ep2-line--muted">{P.author.location}</p>
            <a class="ep2-inline ep2-inline--cta" href={P.author.profileHref}>
              Voir le profil <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </li>

      <li class="ep2-row">
        <span class="ep2-num">{num(1)}</span>
        <div class="ep2-rowmain">
          <h3 class="ep2-rowtitle">Repères</h3>
          <ul class="ep2-rowbody ep2-inlist">
            {P.milestones.map((m) => (
              <li class="ep2-mitem">
                <span class="ep2-myear">{m.year}</span>
                <span class="ep2-mlabel">{m.label}</span>
              </li>
            ))}
          </ul>
        </div>
      </li>

      <li class="ep2-row">
        <span class="ep2-num">{num(2)}</span>
        <div class="ep2-rowmain">
          <h3 class="ep2-rowtitle">Secteurs</h3>
          <ul class="ep2-rowbody ep2-tags">
            {P.sectors.map((s) => (
              <li><a class="ep2-tag" href={s.href}>{s.label}</a></li>
            ))}
          </ul>
        </div>
      </li>

      <li class="ep2-row">
        <span class="ep2-num">{num(3)}</span>
        <div class="ep2-rowmain">
          <h3 class="ep2-rowtitle">Ressources & services</h3>
          <ul class="ep2-rowbody ep2-tags">
            {P.articles.map((a) => (
              <li><a class="ep2-tag" href={a.href}><span class="ep2-tag__k">{a.kicker}</span>{a.label}</a></li>
            ))}
            {P.tools.map((t) => (
              <li><a class="ep2-tag" href={t.href}><span class="ep2-tag__k">{t.kicker}</span>{t.label}</a></li>
            ))}
            {P.services.map((s) => (
              <li><a class="ep2-tag" href={s.href}><span class="ep2-tag__k">{s.kicker}</span>{s.label}</a></li>
            ))}
          </ul>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .ep2 { padding-block: var(--section-base); }
  .ep2[data-bg='paper-2'] { background: var(--paper-2); }

  .ep2-hd {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--hairline);
    margin-bottom: var(--space-7);
  }
  .ep2-kicker {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
    font-weight: var(--fw-medium);
  }
  .ep2-kicker__dot {
    width: var(--space-1);
    height: var(--space-1);
    background: var(--accent);
    border-radius: var(--radius-full);
    align-self: center;
  }
  .ep2-meta {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }

  .ep2-title {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-display);
    font-weight: var(--fw-regular);
    color: var(--ink);
    max-width: 24ch;
    margin: 0 0 var(--space-9);
    text-wrap: balance;
  }
  .ep2-title :global(i.acc), .ep2-title .acc { font-style: italic; color: var(--accent); }

  .ep2-rows { list-style: none; margin: 0; padding: 0; }
  .ep2-row {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
    padding: var(--space-7) 0;
    border-top: 1px solid var(--hairline);
  }
  .ep2-row:last-child { border-bottom: 1px solid var(--hairline); }

  .ep2-num {
    font-family: var(--font-mono);
    font-size: var(--text-numeral-sm);
    line-height: 1;
    letter-spacing: var(--tracking-mono);
    color: var(--accent-text);
  }

  .ep2-rowmain {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    gap: var(--space-7);
    align-items: baseline;
  }
  .ep2-rowtitle {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    font-weight: var(--fw-regular);
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .ep2-rowbody { margin: 0; }

  .ep2-line {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--ink);
    margin: 0 0 var(--space-2);
  }
  .ep2-line--muted { color: var(--muted); font-family: var(--font-mono); font-size: var(--text-small); letter-spacing: var(--tracking-mono); }
  .ep2-strong { color: var(--ink); }
  .ep2-inline--cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono-tight);
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: var(--space-1);
    transition: gap var(--dur-trim) var(--ease), color var(--dur-trim) var(--ease);
  }
  .ep2-inline--cta:hover { gap: var(--space-3); color: var(--accent-text); }

  .ep2-inlist { list-style: none; padding: 0; }
  .ep2-mitem {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--hairline);
  }
  .ep2-mitem:first-child { border-top: 0; padding-top: 0; }
  .ep2-myear {
    flex: 0 0 4.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--accent-text);
  }
  .ep2-mlabel {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--ink);
  }

  /* Liens inline serrés : pills à filet. */
  .ep2-tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .ep2-tag {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur-trim) var(--ease), color var(--dur-trim) var(--ease);
  }
  .ep2-tag:hover { border-color: var(--accent); color: var(--accent-text); }
  .ep2-tag__k {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .ep2-row { grid-template-columns: 1fr; gap: var(--space-4); }
    .ep2-num { font-size: var(--text-numeral-sm); }
    .ep2-rowmain { grid-template-columns: 1fr; gap: var(--space-4); }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-stagger > * { transition: none; }
    .ep2-tag, .ep2-inline--cta { transition: none; }
  }
</style>
