---
/**
 * Prop03 · « Carte praticien + grille » (data-bg paper)
 * Gauche : carte de visite bordée (hairline, radius-lg) : badge initiales (disque accent),
 * nom, rôle, localisation, tags expertise (puces mono), CTA profil.
 * Droite : grille 2×3 de cellules-liens à filets, regroupées par rôle (secteurs phares,
 * tous les secteurs, article, service, outil). Tous les href = vrais <a> (maillage interne).
 * Contenu : EEAT_PACK (source unique, 0 prop, 0 hardcode contenu).
 */
import { EEAT_PACK } from '../../../data/eeat-proposals';
const P = EEAT_PACK;
// 6 cellules de la grille droite, composées depuis le pack (liens réels, variés).
const cells = [
  { kicker: P.sectors[0].kicker, label: P.sectors[0].label, href: P.sectors[0].href },
  { kicker: P.sectors[3].kicker, label: P.sectors[3].label, href: P.sectors[3].href },
  { kicker: 'Tous secteurs', label: 'Voir les 6 secteurs', href: P.sectors[0].href },
  { kicker: P.articles[0].kicker, label: P.articles[0].label, href: P.articles[0].href },
  { kicker: P.tools[0].kicker, label: P.tools[0].label, href: P.tools[0].href },
  { kicker: P.services[2].kicker, label: P.services[2].label, href: P.services[2].href },
];
---
<section class="ep3" data-bg="paper" aria-labelledby="ep3-h2">
  <div class="wrap-wide ep3__in reveal-stagger">
    <header class="ep3-hd">
      <span class="ep3-kicker">
        <span class="ep3-kicker__dot" aria-hidden="true"></span>
        Praticien & ressources
      </span>
      <span class="ep3-meta">E-E-A-T · Waimia</span>
    </header>

    <div class="ep3-split">
      <article class="ep3-card">
        <span class="ep3-badge" aria-hidden="true">{P.author.initials}</span>
        <h2 id="ep3-h2" class="ep3-name">{P.author.name}</h2>
        <p class="ep3-role">{P.author.role}</p>
        <p class="ep3-loc">{P.author.location}</p>
        <ul class="ep3-tags">
          {P.expertise.map((e) => (
            <li class="ep3-tag">
              <span class="ep3-tag__dot" aria-hidden="true"></span>
              {e}
            </li>
          ))}
        </ul>
        <a class="ep3-cta" href={P.author.profileHref}>
          Voir le profil <span class="ep3-cta__glyph" aria-hidden="true">→</span>
        </a>
      </article>

      <div class="ep3-grid">
        {cells.map((c) => (
          <a class="ep3-cell" href={c.href}>
            <span class="ep3-cell__kicker">{c.kicker}</span>
            <span class="ep3-cell__label">{c.label}</span>
            <span class="ep3-cell__glyph" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .ep3 { padding-block: var(--section-base); }
  .ep3[data-bg='paper'] { background: var(--paper); }

  .ep3-hd {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--hairline);
    margin-bottom: var(--space-8);
  }
  .ep3-kicker {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
    font-weight: var(--fw-medium);
  }
  .ep3-kicker__dot {
    width: var(--space-1);
    height: var(--space-1);
    background: var(--accent);
    border-radius: var(--radius-full);
    align-self: center;
  }
  .ep3-meta {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }

  .ep3-split {
    display: grid;
    grid-template-columns: 22rem minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }

  /* Carte de visite bordée. */
  .ep3-card {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    padding: var(--space-7);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .ep3-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-9);
    height: var(--space-9);
    border-radius: var(--radius-full);
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: var(--text-h3);
    letter-spacing: var(--tracking-mono-tight);
    margin-bottom: var(--space-5);
  }
  .ep3-name {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-display);
    font-weight: var(--fw-regular);
    color: var(--ink);
    margin: 0 0 var(--space-2);
    text-wrap: balance;
  }
  .ep3-role {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0 0 var(--space-2);
  }
  .ep3-loc {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--muted);
    margin: 0 0 var(--space-6);
  }
  .ep3-tags {
    list-style: none;
    margin: 0 0 var(--space-7);
    padding: var(--space-5) 0 0;
    border-top: 1px solid var(--hairline);
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .ep3-tag {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--ink);
  }
  .ep3-tag__dot {
    flex: 0 0 auto;
    width: var(--space-1);
    height: var(--space-1);
    border-radius: var(--radius-full);
    background: var(--accent);
    align-self: center;
  }
  .ep3-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono-tight);
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: var(--space-1);
    transition: gap var(--dur-trim) var(--ease), color var(--dur-trim) var(--ease);
  }
  .ep3-cta:hover { gap: var(--space-3); color: var(--accent-text); }
  .ep3-cta__glyph { font-size: var(--text-glyph); line-height: 1; }

  /* Grille 2×3 de cellules-liens à filets (bordures partagées via gap hairline). */
  .ep3-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .ep3-cell {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-7);
    background: var(--paper);
    text-decoration: none;
    min-height: 9rem;
    transition: background var(--dur-trim) var(--ease);
  }
  .ep3-cell:hover { background: var(--paper-2); }
  .ep3-cell__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }
  .ep3-cell__label {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    color: var(--ink);
    text-wrap: balance;
  }
  .ep3-cell__glyph {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: var(--text-glyph);
    line-height: 1;
    color: var(--accent-text);
    transition: transform var(--dur-trim) var(--ease);
  }
  .ep3-cell:hover .ep3-cell__glyph { transform: translateX(var(--space-1)); }

  @media (max-width: 760px) {
    .ep3-split { grid-template-columns: 1fr; gap: var(--space-7); }
    .ep3-card { width: 100%; }
    .ep3-grid { grid-template-columns: 1fr; }
    .ep3-cell { min-height: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-stagger > * { transition: none; }
    .ep3-cta, .ep3-cell, .ep3-cell__glyph { transition: none; }
  }
</style>
