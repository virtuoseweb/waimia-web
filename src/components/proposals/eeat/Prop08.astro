---
/**
 * Prop08 · « Triptyque autorité » (data-bg ink)
 * Proposition E-E-A-T autonome (NON cataloguée) · 3 colonnes ÉGALES séparées par filets
 * verticaux sur ink. En-tête plein largeur (kicker + titre serif clair). Col 1 « Qui » : auteur
 * + parcours. Col 2 « Où » : secteurs. Col 3 « Quoi lire » : articles + outil + services.
 * Sous ~760px : 3 rangées à filets horizontaux. Classique éditorial équilibré.
 * Grammaire PARTAGÉE (kicker à puce, serif + .acc, filets, reveal-stagger).
 * 0 prop · importe EEAT_PACK. Contenu = source unique.
 * Sur ink : --muted/--hairline/--accent-text remappés clair par global.css [data-bg='ink'].
 */
import { EEAT_PACK } from '../../../data/eeat-proposals';
const P = EEAT_PACK;
---
<section class="ep8" data-bg="ink" aria-labelledby="ep8-h2">
  <div class="wrap-wide ep8__in reveal-stagger">
    <header class="ep8-hd">
      <span class="ep8-kicker">
        <span class="ep8-kicker__dot" aria-hidden="true"></span>
        Autorité, en trois temps
      </span>
      <span class="ep8-meta">{P.author.location}</span>
    </header>

    <h2 id="ep8-h2" class="ep8-title">
      Qui, où, et <i class="acc">quoi lire</i>
    </h2>

    <div class="ep8-tri">
      <!-- Col 1 · Qui -->
      <div class="ep8-col">
        <span class="ep8-col__label">Qui</span>
        <p class="ep8-name">{P.author.name}</p>
        <p class="ep8-role">{P.author.role}</p>
        <p class="ep8-bio">{P.author.bio}</p>
        <ol class="ep8-mile">
          {P.milestones.map((m) => (
            <li class="ep8-mile__row">
              <span class="ep8-mile__year">{m.year}</span>
              <span class="ep8-mile__label">{m.label}</span>
            </li>
          ))}
        </ol>
        <a class="ep8-profile" href={P.author.profileHref}>
          Profil complet <span class="ep8-profile__glyph" aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Col 2 · Où -->
      <div class="ep8-col">
        <span class="ep8-col__label">Où</span>
        <ul class="ep8-links">
          {P.sectors.map((s) => (
            <li><a class="ep8-link" href={s.href}>{s.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Col 3 · Quoi lire -->
      <div class="ep8-col">
        <span class="ep8-col__label">Quoi lire</span>
        <ul class="ep8-links">
          {P.articles.map((a) => (
            <li>
              <a class="ep8-link ep8-link--lead" href={a.href}>
                <span class="ep8-link__k">{a.kicker}</span>
                <span class="ep8-link__t">{a.label}</span>
              </a>
            </li>
          ))}
          {P.tools.map((t) => (
            <li>
              <a class="ep8-link ep8-link--lead" href={t.href}>
                <span class="ep8-link__k">{t.kicker}</span>
                <span class="ep8-link__t">{t.label}</span>
              </a>
            </li>
          ))}
          {P.services.map((s) => (
            <li><a class="ep8-link" href={s.href}>{s.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .ep8 {
    background: var(--ink);
    color: var(--paper);
    padding-block: var(--section-base);
  }

  .ep8-hd {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--hairline);
    margin-bottom: var(--space-7);
  }
  .ep8-kicker {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
    font-weight: var(--fw-medium);
  }
  .ep8-kicker__dot {
    width: var(--space-1);
    height: var(--space-1);
    background: var(--accent);
    border-radius: var(--radius-full);
    align-self: center;
  }
  .ep8-meta {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--muted);
  }

  .ep8-title {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-h2);
    line-height: var(--leading-h2);
    letter-spacing: -0.015em;
    color: var(--paper);
    max-width: 24ch;
    margin: 0 0 var(--space-9);
    text-wrap: balance;
  }
  .ep8-title .acc { font-style: italic; color: var(--accent-sur-sombre); }

  /* Triptyque : 3 colonnes égales, filets verticaux entre elles. */
  .ep8-tri {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-7);
  }
  .ep8-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-left: var(--space-7);
    border-left: 1px solid rgba(var(--paper-rgb), 0.14);
  }
  .ep8-col:first-child { padding-left: 0; border-left: 0; }

  .ep8-col__label {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--hairline);
    margin-bottom: var(--space-2);
  }

  .ep8-name {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    color: var(--paper);
    margin: 0;
  }
  .ep8-role {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }
  .ep8-bio {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: rgba(var(--paper-rgb), 0.66);
    margin: var(--space-2) 0 0;
    text-wrap: pretty;
  }

  .ep8-mile { list-style: none; margin: var(--space-3) 0 0; padding: 0; }
  .ep8-mile__row {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--hairline);
  }
  .ep8-mile__row:last-child { border-bottom: 0; }
  .ep8-mile__year {
    flex: 0 0 4.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--accent-text);
  }
  .ep8-mile__label {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: rgba(var(--paper-rgb), 0.78);
  }

  .ep8-links { list-style: none; margin: 0; padding: 0; }
  .ep8-links > li { border-bottom: 1px solid var(--hairline); }
  .ep8-links > li:last-child { border-bottom: 0; }
  .ep8-link {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--paper);
    text-decoration: none;
    padding: var(--space-3) 0;
    transition: color var(--dur-trim) var(--ease);
  }
  .ep8-link:hover { color: var(--accent-sur-sombre); }
  .ep8-link--lead { display: flex; flex-direction: column; gap: var(--space-1); }
  .ep8-link__k {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }
  .ep8-link__t { line-height: var(--leading-h3); text-wrap: pretty; }

  .ep8-profile {
    margin-top: var(--space-3);
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
    text-decoration: none;
    transition: gap var(--dur-trim) var(--ease);
  }
  .ep8-profile:hover { gap: var(--space-3); }
  .ep8-profile__glyph { font-size: var(--text-glyph); line-height: 1; }

  /* Responsive : sous ~760px, 3 rangées à filets horizontaux. */
  @media (max-width: 760px) {
    .ep8-tri { grid-template-columns: 1fr; gap: 0; }
    .ep8-col {
      padding-left: 0;
      border-left: 0;
      padding-top: var(--space-7);
      border-top: 1px solid rgba(var(--paper-rgb), 0.14);
    }
    .ep8-col:first-child { padding-top: 0; border-top: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-stagger > * { transition: none; }
  }
</style>
