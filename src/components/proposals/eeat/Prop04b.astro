---
/**
 * Prop04b · « Colonnes accent » (data-bg ink)
 * Variation en COLONNES verticales rythmées : une bande image (momentum) traverse la tête de
 * section, puis 4 colonnes (Qui+repères / Secteurs / À lire+services / Engagements). Certaines
 * colonnes portent un en-tête ou une case pleine ACCENT (var(--accent), texte var(--accent-ink))
 * en alternance avec des colonnes hairline. L'accent rythme visuellement la lecture.
 * Avis = commitments + honestyNote (honnête, pas de témoignage). Contenu : EEAT_PACK (0 prop).
 */
import { EEAT_PACK, EEAT_IMAGES } from '../../../data/eeat-proposals';
const P = EEAT_PACK;
const IMG = EEAT_IMAGES;
const img = (id: string) => IMG.find((i) => i.id === id)!;
---
<section class="ep4b" data-bg="ink" aria-labelledby="ep4b-h2">
  <div class="wrap-wide ep4b__in reveal-stagger">
    <header class="ep4b-hd">
      <span class="ep4b-kicker">
        <span class="ep4b-kicker__dot" aria-hidden="true"></span>
        Colonnes E-E-A-T
      </span>
      <span class="ep4b-meta">Expérience · expertise · autorité · confiance</span>
    </header>

    <figure class="ep4b-band">
      <img class="ep4b-band__img" src={img('momentum').src} alt={img('momentum').alt} loading="lazy" />
      <figcaption class="ep4b-band__cap">Élan & croissance · trajectoire des PME accompagnées</figcaption>
    </figure>

    <div class="ep4b-cols">
      <!-- Colonne 1 : Qui + repères (en-tête accent) -->
      <article class="ep4b-col">
        <header class="ep4b-colhd ep4b-colhd--accent">
          <span class="ep4b-collabel ep4b-collabel--ink">Qui</span>
          <h2 id="ep4b-h2" class="ep4b-name ep4b-name--ink">{P.author.name}</h2>
          <p class="ep4b-role ep4b-role--ink">{P.author.role}</p>
        </header>
        <div class="ep4b-colbody">
          <p class="ep4b-bio">{P.author.bio}</p>
          <ul class="ep4b-mlist">
            {P.milestones.map((m) => (
              <li class="ep4b-mrow">
                <span class="ep4b-myear">{m.year}</span>
                <span class="ep4b-mlabel">{m.label}</span>
              </li>
            ))}
          </ul>
          <a class="ep4b-cta" href={P.author.profileHref}>
            Voir le profil <span class="ep4b-cta__glyph" aria-hidden="true">→</span>
          </a>
        </div>
      </article>

      <!-- Colonne 2 : Secteurs (hairline) -->
      <article class="ep4b-col">
        <header class="ep4b-colhd">
          <span class="ep4b-collabel">Secteurs</span>
        </header>
        <div class="ep4b-colbody">
          <ul class="ep4b-chips">
            {P.sectors.map((s) => (
              <li><a class="ep4b-chip" href={s.href}>{s.label}</a></li>
            ))}
          </ul>
          <ul class="ep4b-exp">
            {P.expertise.map((e) => (
              <li class="ep4b-exp__item">{e}</li>
            ))}
          </ul>
        </div>
      </article>

      <!-- Colonne 3 : À lire + services (hairline) -->
      <article class="ep4b-col">
        <header class="ep4b-colhd">
          <span class="ep4b-collabel">À lire & services</span>
        </header>
        <div class="ep4b-colbody">
          <ul class="ep4b-links">
            {P.articles.map((a) => (
              <li>
                <a class="ep4b-link" href={a.href}>
                  <span class="ep4b-link__kicker">{a.kicker}</span>
                  <span class="ep4b-link__label">{a.label}</span>
                </a>
              </li>
            ))}
            {P.services.map((s) => (
              <li><a class="ep4b-link ep4b-link--flat" href={s.href}>{s.label}</a></li>
            ))}
            {P.tools.map((t) => (
              <li>
                <a class="ep4b-link" href={t.href}>
                  <span class="ep4b-link__kicker">{t.kicker}</span>
                  <span class="ep4b-link__label">{t.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </article>

      <!-- Colonne 4 : Engagements (colonne pleine accent) -->
      <article class="ep4b-col ep4b-col--accent">
        <header class="ep4b-colhd">
          <span class="ep4b-collabel ep4b-collabel--ink">Engagements</span>
        </header>
        <div class="ep4b-colbody">
          <ul class="ep4b-commits">
            {P.commitments.map((c) => (
              <li class="ep4b-commit">
                <span class="ep4b-commit__label">{c.label}</span>
                <span class="ep4b-commit__detail">{c.detail}</span>
              </li>
            ))}
          </ul>
          <p class="ep4b-honesty">{P.honestyNote}</p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .ep4b {
    padding-block: var(--section-base);
    background: var(--ink);
    color: var(--paper);
  }

  .ep4b-hd {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid rgba(var(--paper-rgb), 0.14);
    margin-bottom: var(--space-6);
  }
  .ep4b-kicker {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-sur-sombre);
    font-weight: var(--fw-medium);
  }
  .ep4b-kicker__dot {
    width: var(--space-1);
    height: var(--space-1);
    background: var(--accent-sur-sombre);
    border-radius: var(--radius-full);
    align-self: center;
  }
  .ep4b-meta {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: rgba(var(--paper-rgb), 0.55);
  }

  /* Bande image en tête */
  .ep4b-band {
    position: relative;
    margin: 0 0 var(--space-6);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(var(--paper-rgb), 0.14);
  }
  .ep4b-band__img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 18rem;
    object-fit: cover;
  }
  .ep4b-band__cap {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    margin: 0;
    padding: var(--space-1) var(--space-3);
    background: color-mix(in srgb, var(--ink) 70%, transparent);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: rgba(var(--paper-rgb), 0.82);
    border-radius: var(--radius-pill);
  }

  /* 4 colonnes verticales rythmées */
  .ep4b-cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(var(--paper-rgb), 0.14);
    border: 1px solid rgba(var(--paper-rgb), 0.14);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .ep4b-col {
    background: var(--ink);
    display: flex;
    flex-direction: column;
  }
  .ep4b-col--accent { background: var(--accent); color: var(--accent-ink); }

  .ep4b-colhd {
    padding: var(--space-6) var(--space-6) var(--space-5);
    border-bottom: 1px solid rgba(var(--paper-rgb), 0.14);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .ep4b-colhd--accent {
    background: var(--accent);
    color: var(--accent-ink);
    border-bottom: 0;
  }
  .ep4b-col--accent .ep4b-colhd { border-bottom-color: rgba(var(--paper-rgb), 0.22); }

  .ep4b-collabel {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: rgba(var(--paper-rgb), 0.55);
  }
  .ep4b-collabel--ink { color: var(--accent-ink); opacity: 0.78; }

  .ep4b-colbody {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    flex: 1;
  }

  .ep4b-name {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-display);
    font-weight: var(--fw-regular);
    color: var(--paper);
    margin: 0;
    text-wrap: balance;
  }
  .ep4b-name--ink { color: var(--accent-ink); }
  .ep4b-role {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-sur-sombre);
    margin: 0;
  }
  .ep4b-role--ink { color: var(--accent-ink); opacity: 0.88; }

  .ep4b-bio {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: rgba(var(--paper-rgb), 0.72);
    margin: 0;
    text-wrap: pretty;
  }

  .ep4b-mlist { list-style: none; margin: 0; padding: 0; }
  .ep4b-mrow {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-top: 1px solid rgba(var(--paper-rgb), 0.14);
  }
  .ep4b-mrow:first-child { border-top: 0; padding-top: 0; }
  .ep4b-myear {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    color: var(--accent-sur-sombre);
  }
  .ep4b-mlabel {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-relaxed);
    color: var(--paper);
  }

  .ep4b-cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono-tight);
    text-transform: uppercase;
    color: var(--paper);
    text-decoration: none;
    border-bottom: 1px solid var(--accent-sur-sombre);
    padding-bottom: var(--space-1);
    transition: gap var(--dur-trim) var(--ease), color var(--dur-trim) var(--ease);
  }
  .ep4b-cta:hover { gap: var(--space-3); color: var(--accent-sur-sombre); }
  .ep4b-cta__glyph { font-size: var(--text-glyph); line-height: 1; }

  .ep4b-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .ep4b-chip {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    border: 1px solid rgba(var(--paper-rgb), 0.18);
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--paper);
    text-decoration: none;
    transition: border-color var(--dur-trim) var(--ease), color var(--dur-trim) var(--ease);
  }
  .ep4b-chip:hover { border-color: var(--accent-sur-sombre); color: var(--accent-sur-sombre); }

  .ep4b-exp { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .ep4b-exp__item {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: rgba(var(--paper-rgb), 0.6);
    padding-left: var(--space-4);
    position: relative;
  }
  .ep4b-exp__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: var(--space-1);
    height: var(--space-1);
    background: var(--accent-sur-sombre);
    border-radius: var(--radius-full);
  }

  .ep4b-links { list-style: none; margin: 0; padding: 0; }
  .ep4b-links > li { border-top: 1px solid rgba(var(--paper-rgb), 0.14); }
  .ep4b-links > li:first-child { border-top: 0; }
  .ep4b-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) 0;
    text-decoration: none;
    transition: padding-left var(--dur-trim) var(--ease);
  }
  .ep4b-link:hover { padding-left: var(--space-2); }
  .ep4b-link--flat { display: block; }
  .ep4b-link__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: rgba(var(--paper-rgb), 0.55);
  }
  .ep4b-link__label,
  .ep4b-link--flat {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-relaxed);
    color: var(--paper);
    text-wrap: pretty;
  }
  .ep4b-link:hover .ep4b-link__label,
  .ep4b-link--flat:hover { color: var(--accent-sur-sombre); }

  /* Engagements en colonne accent (texte sur accent) */
  .ep4b-commits { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-4); }
  .ep4b-commit {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-top: var(--space-4);
    border-top: 1px solid rgba(var(--paper-rgb), 0.22);
  }
  .ep4b-commit:first-child { border-top: 0; padding-top: 0; }
  .ep4b-commit__label {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    color: var(--accent-ink);
  }
  .ep4b-commit__detail {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-relaxed);
    color: var(--accent-ink);
    opacity: 0.86;
  }
  .ep4b-honesty {
    margin: var(--space-2) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    color: var(--accent-ink);
    opacity: 0.78;
    text-wrap: pretty;
  }

  @media (max-width: 980px) {
    .ep4b-cols { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .ep4b-cols { grid-template-columns: 1fr; }
    .ep4b-band__img { max-height: 14rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-stagger > * { transition: none; }
    .ep4b-cta, .ep4b-chip, .ep4b-link { transition: none; }
  }
</style>
