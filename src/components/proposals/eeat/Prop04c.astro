---
/**
 * Prop04c · « Form light » (data-bg paper) = DÉCLINAISON LIGHT du dashboard E-E-A-T.
 * Exactement la grille bento de Prop04, mais en thème CLAIR : fond var(--paper), filets
 * var(--hairline), titres var(--ink), accent var(--accent). Mêmes cellules (auteur, repères,
 * secteurs, à lire, engagements, services) + 2 cellules MÉDIA (augmented-self, audience)
 * + une case pleine ACCENT (CTA profil). Preuve que la section a sa variante claire.
 * Avis = commitments + honestyNote (honnête). Contenu : EEAT_PACK (0 prop, 0 hardcode).
 */
import { EEAT_PACK, EEAT_IMAGES } from '../../../data/eeat-proposals';
const P = EEAT_PACK;
const IMG = EEAT_IMAGES;
const img = (id: string) => IMG.find((i) => i.id === id)!;
---
<section class="ep4c" data-bg="paper" aria-labelledby="ep4c-h2">
  <div class="wrap-wide ep4c__in reveal-stagger">
    <header class="ep4c-hd">
      <span class="ep4c-kicker">
        <span class="ep4c-kicker__dot" aria-hidden="true"></span>
        Tableau de bord · variante claire
      </span>
      <span class="ep4c-meta">Expérience · expertise · autorité · confiance</span>
    </header>

    <div class="ep4c-grid">
      <article class="ep4c-cell ep4c-cell--author">
        <span class="ep4c-celllabel">Auteur</span>
        <h2 id="ep4c-h2" class="ep4c-name">{P.author.name}</h2>
        <p class="ep4c-role">{P.author.role}</p>
        <p class="ep4c-bio">{P.author.bio}</p>
      </article>

      <figure class="ep4c-cell ep4c-cell--media ep4c-cell--media-a">
        <img class="ep4c-img" src={img('augmented-self').src} alt={img('augmented-self').alt} loading="lazy" />
        <figcaption class="ep4c-cap">Travail augmenté par l'IA</figcaption>
      </figure>

      <a class="ep4c-cell ep4c-cell--cta" href={P.author.profileHref}>
        <span class="ep4c-celllabel ep4c-celllabel--ink">Profil complet</span>
        <span class="ep4c-cta__title">Voir le parcours</span>
        <span class="ep4c-cta__glyph" aria-hidden="true">→</span>
      </a>

      <article class="ep4c-cell ep4c-cell--reperes">
        <span class="ep4c-celllabel">Repères</span>
        <ul class="ep4c-mlist">
          {P.milestones.map((m) => (
            <li class="ep4c-mrow">
              <span class="ep4c-myear">{m.year}</span>
              <span class="ep4c-mlabel">{m.label}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="ep4c-cell ep4c-cell--sectors">
        <span class="ep4c-celllabel">Secteurs</span>
        <ul class="ep4c-chips">
          {P.sectors.map((s) => (
            <li><a class="ep4c-chip" href={s.href}>{s.label}</a></li>
          ))}
        </ul>
      </article>

      <figure class="ep4c-cell ep4c-cell--media ep4c-cell--media-b">
        <img class="ep4c-img" src={img('audience').src} alt={img('audience').alt} loading="lazy" />
        <figcaption class="ep4c-cap">Capter l'attention de votre audience</figcaption>
      </figure>

      <article class="ep4c-cell ep4c-cell--read">
        <span class="ep4c-celllabel">À lire</span>
        <ul class="ep4c-links">
          {P.articles.map((a) => (
            <li>
              <a class="ep4c-link" href={a.href}>
                <span class="ep4c-link__kicker">{a.kicker}</span>
                <span class="ep4c-link__label">{a.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </article>

      <article class="ep4c-cell ep4c-cell--commit">
        <span class="ep4c-celllabel">Engagements</span>
        <ul class="ep4c-commits">
          {P.commitments.map((c) => (
            <li class="ep4c-commit">
              <span class="ep4c-commit__label">{c.label}</span>
              <span class="ep4c-commit__detail">{c.detail}</span>
            </li>
          ))}
        </ul>
        <p class="ep4c-honesty">{P.honestyNote}</p>
      </article>

      <article class="ep4c-cell ep4c-cell--services">
        <span class="ep4c-celllabel">Services & outil</span>
        <ul class="ep4c-links">
          {P.services.map((s) => (
            <li><a class="ep4c-link ep4c-link--flat" href={s.href}>{s.label}</a></li>
          ))}
          {P.tools.map((t) => (
            <li>
              <a class="ep4c-link" href={t.href}>
                <span class="ep4c-link__kicker">{t.kicker}</span>
                <span class="ep4c-link__label">{t.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .ep4c {
    padding-block: var(--section-base);
    background: var(--paper);
    color: var(--ink);
  }

  .ep4c-hd {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--hairline);
    margin-bottom: var(--space-8);
  }
  .ep4c-kicker {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
    font-weight: var(--fw-medium);
  }
  .ep4c-kicker__dot {
    width: var(--space-1);
    height: var(--space-1);
    background: var(--accent);
    border-radius: var(--radius-full);
    align-self: center;
  }
  .ep4c-meta {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Bento clair : 6 colonnes, cellules de données + 2 cellules image + 1 case accent. */
  .ep4c-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: minmax(0, auto);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .ep4c-cell {
    background: var(--paper);
    padding: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .ep4c-cell--author   { grid-column: span 3; }
  .ep4c-cell--media-a  { grid-column: span 2; }
  .ep4c-cell--cta      { grid-column: span 1; }
  .ep4c-cell--reperes  { grid-column: span 2; }
  .ep4c-cell--sectors  { grid-column: span 2; }
  .ep4c-cell--media-b  { grid-column: span 2; }
  .ep4c-cell--read     { grid-column: span 2; }
  .ep4c-cell--commit   { grid-column: span 2; }
  .ep4c-cell--services { grid-column: span 2; }

  .ep4c-celllabel {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }

  /* MÉDIA */
  .ep4c-cell--media { padding: 0; gap: 0; position: relative; min-height: 0; }
  .ep4c-img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 12rem;
    object-fit: cover;
  }
  .ep4c-cap {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    margin: 0;
    padding: var(--space-1) var(--space-3);
    background: color-mix(in srgb, var(--ink) 72%, transparent);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: rgba(var(--paper-rgb), 0.92);
    border-radius: var(--radius-pill);
  }

  /* CTA case accent */
  .ep4c-cell--cta {
    background: var(--accent);
    color: var(--accent-ink);
    text-decoration: none;
    justify-content: space-between;
    transition: background var(--dur-trim) var(--ease);
  }
  .ep4c-cell--cta:hover { background: var(--accent-sur-clair); }
  .ep4c-celllabel--ink { color: var(--accent-ink); opacity: 0.72; }
  .ep4c-cta__title {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    color: var(--accent-ink);
    margin-top: auto;
  }
  .ep4c-cta__glyph {
    font-size: var(--text-glyph);
    line-height: 1;
    color: var(--accent-ink);
  }

  .ep4c-name {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-h2);
    line-height: var(--leading-h2);
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .ep4c-role {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0;
  }
  .ep4c-bio {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--ink);
    margin: 0;
    text-wrap: pretty;
  }

  .ep4c-mlist { list-style: none; margin: 0; padding: 0; }
  .ep4c-mrow {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--space-3);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--hairline);
  }
  .ep4c-mrow:first-child { border-top: 0; padding-top: 0; }
  .ep4c-myear {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--accent-text);
  }
  .ep4c-mlabel {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--ink);
  }

  .ep4c-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .ep4c-chip {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur-trim) var(--ease), color var(--dur-trim) var(--ease);
  }
  .ep4c-chip:hover { border-color: var(--accent); color: var(--accent-text); }

  .ep4c-links { list-style: none; margin: 0; padding: 0; }
  .ep4c-links > li { border-top: 1px solid var(--hairline); }
  .ep4c-links > li:first-child { border-top: 0; }
  .ep4c-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) 0;
    text-decoration: none;
    transition: padding-left var(--dur-trim) var(--ease);
  }
  .ep4c-link:hover { padding-left: var(--space-2); }
  .ep4c-link--flat { display: block; }
  .ep4c-link__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }
  .ep4c-link__label,
  .ep4c-link--flat {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--ink);
    text-wrap: pretty;
  }
  .ep4c-link:hover .ep4c-link__label,
  .ep4c-link--flat:hover { color: var(--accent-text); }

  .ep4c-commits { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-4); }
  .ep4c-commit {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-top: var(--space-4);
    border-top: 1px solid var(--hairline);
  }
  .ep4c-commit:first-child { border-top: 0; padding-top: 0; }
  .ep4c-commit__label {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    color: var(--ink);
  }
  .ep4c-commit__detail {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }
  .ep4c-honesty {
    margin: var(--space-2) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    color: var(--muted);
    text-wrap: pretty;
  }

  @media (max-width: 980px) {
    .ep4c-cell--author   { grid-column: span 3; }
    .ep4c-cell--media-a  { grid-column: span 3; }
    .ep4c-cell--cta      { grid-column: span 3; }
    .ep4c-cell--reperes  { grid-column: span 3; }
    .ep4c-cell--sectors  { grid-column: span 3; }
    .ep4c-cell--media-b  { grid-column: span 3; }
    .ep4c-cell--read     { grid-column: span 3; }
    .ep4c-cell--commit   { grid-column: span 3; }
    .ep4c-cell--services { grid-column: span 3; }
  }

  @media (max-width: 760px) {
    .ep4c-grid { grid-template-columns: 1fr; }
    .ep4c-cell--author, .ep4c-cell--media-a, .ep4c-cell--cta, .ep4c-cell--reperes,
    .ep4c-cell--sectors, .ep4c-cell--media-b, .ep4c-cell--read, .ep4c-cell--commit,
    .ep4c-cell--services { grid-column: span 1; }
    .ep4c-img { min-height: 14rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-stagger > * { transition: none; }
    .ep4c-cta, .ep4c-chip, .ep4c-link, .ep4c-cell--cta { transition: none; }
  }
</style>
