---
/**
 * Prop06 · « Fiche praticien » (data-bg paper)
 * Proposition E-E-A-T autonome (NON cataloguée) · allure fiche/CV structurée, 2 colonnes.
 * Gauche : identité (badge initiales, nom serif, rôle, localisation), « Expertise » en rangées
 * à filet, « Parcours » en mini-timeline. Droite (sidebar bordée) : « Repères », puis listes de
 * liens catégorisées (Secteurs, À lire, Services + Outil). Libellés de champ en mono majuscule.
 * Grammaire de design PARTAGÉE avec les autres propositions (kicker à puce, serif + .acc,
 * filets hairline, reveal-stagger). 0 prop · importe EEAT_PACK. Contenu = source unique.
 */
import { EEAT_PACK } from '../../../data/eeat-proposals';
const P = EEAT_PACK;
---
<section class="ep6" data-bg="paper" aria-labelledby="ep6-h2">
  <div class="wrap-wide ep6__in reveal-stagger">
    <header class="ep6-hd">
      <span class="ep6-kicker">
        <span class="ep6-kicker__dot" aria-hidden="true"></span>
        Fiche praticien
      </span>
      <span class="ep6-meta">{P.author.location}</span>
    </header>

    <h2 id="ep6-h2" class="ep6-title">
      Qui tient <i class="acc">la mission</i>
    </h2>

    <div class="ep6-grid">
      <!-- Colonne gauche : identité + expertise + parcours -->
      <div class="ep6-main">
        <div class="ep6-id">
          <span class="ep6-badge" aria-hidden="true">{P.author.initials}</span>
          <div class="ep6-id__txt">
            <p class="ep6-name">{P.author.name}</p>
            <p class="ep6-role">{P.author.role}</p>
          </div>
        </div>

        <p class="ep6-bio">{P.author.bio}</p>

        <div class="ep6-field">
          <span class="ep6-field__label">Expertise</span>
          <ul class="ep6-rows">
            {P.expertise.map((e) => (
              <li class="ep6-row">{e}</li>
            ))}
          </ul>
        </div>

        <div class="ep6-field">
          <span class="ep6-field__label">Parcours</span>
          <ol class="ep6-timeline">
            {P.milestones.map((m) => (
              <li class="ep6-mile">
                <span class="ep6-mile__year">{m.year}</span>
                <span class="ep6-mile__label">{m.label}</span>
              </li>
            ))}
          </ol>
        </div>

        <a class="ep6-profile" href={P.author.profileHref}>
          Voir le profil complet <span class="ep6-profile__glyph" aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Colonne droite : sidebar bordée, listes de liens catégorisées -->
      <aside class="ep6-side">
        <div class="ep6-side__field">
          <span class="ep6-field__label">Secteurs</span>
          <ul class="ep6-links">
            {P.sectors.map((s) => (
              <li><a class="ep6-link" href={s.href}>{s.label}</a></li>
            ))}
          </ul>
        </div>

        <div class="ep6-side__field">
          <span class="ep6-field__label">À lire</span>
          <ul class="ep6-links">
            {P.articles.map((a) => (
              <li>
                <a class="ep6-link ep6-link--lead" href={a.href}>
                  <span class="ep6-link__k">{a.kicker}</span>
                  <span class="ep6-link__t">{a.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="ep6-side__field">
          <span class="ep6-field__label">Services</span>
          <ul class="ep6-links">
            {P.services.map((s) => (
              <li><a class="ep6-link" href={s.href}>{s.label}</a></li>
            ))}
            {P.tools.map((t) => (
              <li><a class="ep6-link" href={t.href}>{t.label}</a></li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .ep6 {
    background: var(--paper);
    color: var(--ink);
    padding-block: var(--section-base);
  }

  /* En-tête : kicker à puce + méta mono, filet sous le bandeau. */
  .ep6-hd {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--hairline);
    margin-bottom: var(--space-7);
  }
  .ep6-kicker {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
    font-weight: var(--fw-medium);
  }
  .ep6-kicker__dot {
    width: var(--space-1);
    height: var(--space-1);
    background: var(--accent);
    border-radius: var(--radius-full);
    align-self: center;
  }
  .ep6-meta {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--muted);
  }

  .ep6-title {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-h2);
    line-height: var(--leading-h2);
    letter-spacing: -0.015em;
    color: var(--ink);
    max-width: 22ch;
    margin: 0 0 var(--space-9);
    text-wrap: balance;
  }
  .ep6-title .acc { font-style: italic; color: var(--accent); }

  .ep6-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-8);
  }

  /* Identité */
  .ep6-id {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .ep6-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-9);
    height: var(--space-9);
    flex: 0 0 auto;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--text-h3);
    letter-spacing: var(--tracking-mono);
    color: var(--accent-text);
  }
  .ep6-name {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    color: var(--ink);
    margin: 0;
  }
  .ep6-role {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
    margin: var(--space-1) 0 0;
  }
  .ep6-bio {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--muted);
    margin: 0 0 var(--space-7);
    max-width: 52ch;
    text-wrap: pretty;
  }

  /* Champs de fiche : label mono majuscule + contenu */
  .ep6-field { margin-bottom: var(--space-7); }
  .ep6-field__label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-2);
    border-bottom: 1px solid var(--hairline);
  }

  /* Expertise : rangées à filet */
  .ep6-rows { list-style: none; margin: 0; padding: 0; }
  .ep6-row {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--ink);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--hairline);
  }
  .ep6-row:last-child { border-bottom: 0; }

  /* Parcours : mini-timeline year + label */
  .ep6-timeline { list-style: none; margin: 0; padding: 0; }
  .ep6-mile {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--hairline);
  }
  .ep6-mile:last-child { border-bottom: 0; }
  .ep6-mile__year {
    flex: 0 0 5rem;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--accent-text);
  }
  .ep6-mile__label {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--ink);
  }

  .ep6-profile {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
    text-decoration: none;
    transition: gap var(--dur-trim) var(--ease);
  }
  .ep6-profile:hover { gap: var(--space-3); }
  .ep6-profile__glyph { font-size: var(--text-glyph); line-height: 1; }

  /* Sidebar bordée */
  .ep6-side {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    align-self: start;
  }
  .ep6-side__field { margin-bottom: var(--space-6); }
  .ep6-side__field:last-child { margin-bottom: 0; }

  .ep6-links { list-style: none; margin: 0; padding: 0; }
  .ep6-links > li { border-bottom: 1px solid var(--hairline); }
  .ep6-links > li:last-child { border-bottom: 0; }

  .ep6-link {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--ink);
    text-decoration: none;
    padding: var(--space-3) 0;
    transition: color var(--dur-trim) var(--ease);
  }
  .ep6-link:hover { color: var(--accent-text); }
  .ep6-link--lead { display: flex; flex-direction: column; gap: var(--space-1); }
  .ep6-link__k {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }
  .ep6-link__t { line-height: var(--leading-h3); text-wrap: pretty; }

  /* Responsive : 1 colonne sous ~760px, aucun débordement. */
  @media (max-width: 760px) {
    .ep6-grid { grid-template-columns: 1fr; gap: var(--space-7); }
    .ep6-mile__year { flex: 0 0 4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-stagger > * { transition: none; }
  }
</style>
