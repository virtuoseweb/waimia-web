---
/**
 * Prop04 · « Tableau de bord E-E-A-T » (data-bg ink)
 * Bento control panel sur fond sombre, cellules de tailles variées à filets paper/0.14.
 * (a) AUTEUR (nom+rôle+bio+CTA) · (b) REPÈRES · (c) SECTEURS (6 puces-liens) ·
 * (d) À LIRE (articles) · (e) ENGAGEMENTS = commitments + honestyNote (bloc « avis » HONNÊTE :
 * pas de témoignage client, ce sont des garanties d'offre) · (f) SERVICES & OUTIL.
 * Tous les href du pack = vrais <a> (maillage interne). Titres paper, accents accent-sur-sombre.
 * Contenu : EEAT_PACK (source unique, 0 prop, 0 hardcode contenu).
 */
import { EEAT_PACK } from '../../../data/eeat-proposals';
const P = EEAT_PACK;
---
<section class="ep4" data-bg="ink" aria-labelledby="ep4-h2">
  <div class="wrap-wide ep4__in reveal-stagger">
    <header class="ep4-hd">
      <span class="ep4-kicker">
        <span class="ep4-kicker__dot" aria-hidden="true"></span>
        Tableau de bord
      </span>
      <span class="ep4-meta">Expérience · expertise · autorité · confiance</span>
    </header>

    <div class="ep4-grid">
      <article class="ep4-cell ep4-cell--author">
        <span class="ep4-celllabel">Auteur</span>
        <h2 id="ep4-h2" class="ep4-name">{P.author.name}</h2>
        <p class="ep4-role">{P.author.role}</p>
        <p class="ep4-bio">{P.author.bio}</p>
        <a class="ep4-cta" href={P.author.profileHref}>
          Voir le profil <span class="ep4-cta__glyph" aria-hidden="true">→</span>
        </a>
      </article>

      <article class="ep4-cell ep4-cell--reperes">
        <span class="ep4-celllabel">Repères</span>
        <ul class="ep4-mlist">
          {P.milestones.map((m) => (
            <li class="ep4-mrow">
              <span class="ep4-myear">{m.year}</span>
              <span class="ep4-mlabel">{m.label}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="ep4-cell ep4-cell--sectors">
        <span class="ep4-celllabel">Secteurs</span>
        <ul class="ep4-chips">
          {P.sectors.map((s) => (
            <li><a class="ep4-chip" href={s.href}>{s.label}</a></li>
          ))}
        </ul>
      </article>

      <article class="ep4-cell ep4-cell--read">
        <span class="ep4-celllabel">À lire</span>
        <ul class="ep4-links">
          {P.articles.map((a) => (
            <li>
              <a class="ep4-link" href={a.href}>
                <span class="ep4-link__kicker">{a.kicker}</span>
                <span class="ep4-link__label">{a.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </article>

      <article class="ep4-cell ep4-cell--commit">
        <span class="ep4-celllabel">Engagements</span>
        <ul class="ep4-commits">
          {P.commitments.map((c) => (
            <li class="ep4-commit">
              <span class="ep4-commit__label">{c.label}</span>
              <span class="ep4-commit__detail">{c.detail}</span>
            </li>
          ))}
        </ul>
        <p class="ep4-honesty">{P.honestyNote}</p>
      </article>

      <article class="ep4-cell ep4-cell--services">
        <span class="ep4-celllabel">Services & outil</span>
        <ul class="ep4-links">
          {P.services.map((s) => (
            <li><a class="ep4-link ep4-link--flat" href={s.href}>{s.label}</a></li>
          ))}
          {P.tools.map((t) => (
            <li>
              <a class="ep4-link" href={t.href}>
                <span class="ep4-link__kicker">{t.kicker}</span>
                <span class="ep4-link__label">{t.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .ep4 {
    padding-block: var(--section-base);
    background: var(--ink);
    color: var(--paper);
  }

  .ep4-hd {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid rgba(var(--paper-rgb), 0.14);
    margin-bottom: var(--space-8);
  }
  .ep4-kicker {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-sur-sombre);
    font-weight: var(--fw-medium);
  }
  .ep4-kicker__dot {
    width: var(--space-1);
    height: var(--space-1);
    background: var(--accent-sur-sombre);
    border-radius: var(--radius-full);
    align-self: center;
  }
  .ep4-meta {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: rgba(var(--paper-rgb), 0.55);
  }

  /* Bento : 6 colonnes de base, cellules d'empans variés. */
  .ep4-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1px;
    background: rgba(var(--paper-rgb), 0.14);
    border: 1px solid rgba(var(--paper-rgb), 0.14);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .ep4-cell {
    background: var(--ink);
    padding: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .ep4-cell--author   { grid-column: span 3; }
  .ep4-cell--reperes  { grid-column: span 3; }
  .ep4-cell--sectors  { grid-column: span 2; }
  .ep4-cell--read     { grid-column: span 2; }
  .ep4-cell--commit   { grid-column: span 2; }
  .ep4-cell--services { grid-column: span 3; }

  .ep4-celllabel {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: rgba(var(--paper-rgb), 0.55);
  }

  .ep4-name {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-h2);
    line-height: var(--leading-h2);
    letter-spacing: -0.015em;
    color: var(--paper);
    margin: 0;
    text-wrap: balance;
  }
  .ep4-role {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-sur-sombre);
    margin: 0;
  }
  .ep4-bio {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: rgba(var(--paper-rgb), 0.72);
    margin: 0;
    text-wrap: pretty;
  }
  .ep4-cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono-tight);
    text-transform: uppercase;
    color: var(--paper);
    text-decoration: none;
    border-bottom: 1px solid var(--accent-sur-sombre);
    padding-bottom: var(--space-1);
    transition: gap var(--dur-trim) var(--ease), color var(--dur-trim) var(--ease);
  }
  .ep4-cta:hover { gap: var(--space-3); color: var(--accent-sur-sombre); }
  .ep4-cta__glyph { font-size: var(--text-glyph); line-height: 1; }

  .ep4-mlist { list-style: none; margin: 0; padding: 0; }
  .ep4-mrow {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid rgba(var(--paper-rgb), 0.14);
  }
  .ep4-mrow:first-child { border-top: 0; padding-top: 0; }
  .ep4-myear {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--accent-sur-sombre);
  }
  .ep4-mlabel {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--paper);
  }

  .ep4-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .ep4-chip {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border: 1px solid rgba(var(--paper-rgb), 0.18);
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--paper);
    text-decoration: none;
    transition: border-color var(--dur-trim) var(--ease), color var(--dur-trim) var(--ease);
  }
  .ep4-chip:hover { border-color: var(--accent-sur-sombre); color: var(--accent-sur-sombre); }

  .ep4-links { list-style: none; margin: 0; padding: 0; }
  .ep4-links > li { border-top: 1px solid rgba(var(--paper-rgb), 0.14); }
  .ep4-links > li:first-child { border-top: 0; }
  .ep4-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) 0;
    text-decoration: none;
    transition: padding-left var(--dur-trim) var(--ease);
  }
  .ep4-link:hover { padding-left: var(--space-2); }
  .ep4-link--flat { display: block; }
  .ep4-link__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: rgba(var(--paper-rgb), 0.55);
  }
  .ep4-link__label,
  .ep4-link--flat {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--paper);
    text-wrap: pretty;
  }
  .ep4-link:hover .ep4-link__label,
  .ep4-link--flat:hover { color: var(--accent-sur-sombre); }

  /* Engagements = bloc « avis » HONNÊTE (garanties, pas de témoignage). */
  .ep4-commits { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-4); }
  .ep4-commit {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-top: var(--space-4);
    border-top: 1px solid rgba(var(--paper-rgb), 0.14);
  }
  .ep4-commit:first-child { border-top: 0; padding-top: 0; }
  .ep4-commit__label {
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    color: var(--paper);
  }
  .ep4-commit__detail {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-relaxed);
    color: rgba(var(--paper-rgb), 0.66);
  }
  .ep4-honesty {
    margin: var(--space-2) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    color: rgba(var(--paper-rgb), 0.55);
    text-wrap: pretty;
  }

  @media (max-width: 760px) {
    .ep4-grid { grid-template-columns: 1fr; }
    .ep4-cell--author, .ep4-cell--reperes, .ep4-cell--sectors,
    .ep4-cell--read, .ep4-cell--commit, .ep4-cell--services { grid-column: span 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-stagger > * { transition: none; }
    .ep4-cta, .ep4-chip, .ep4-link { transition: none; }
  }
</style>
