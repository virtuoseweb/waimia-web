---
import FormGuard from '../atoms/FormGuard.astro';
import Kicker from '../atoms/Kicker.astro';
import Button from '../atoms/Button.astro';
import Bi from '../atoms/Bi.astro';
import SiloFilter from '../molecules/SiloFilter.astro';
import ListIndexSection from '../../sections/ListIndexSection.astro';
import ArticleGrid from '../../sections/ArticleGrid.astro';
import CtaFinal from '../../sections/CtaFinal.astro';
import ManifestoStatement from '../../sections/ManifestoStatement.astro';
import MastheadBar from '../../sections/MastheadBar.astro';
import type { SectionByType } from '@waimia/ds-kernel';
import { getEntry } from 'astro:content';
import { langFromPath } from '../../../lib/i18n';
import type { ResourceItem } from '../../../lib/resources-hub';
import {
  indexHeadData,
  manifestoData,
  ctaData,
  RESOURCE_KINDS,
  RESOURCE_VIEWS,
  type ResourceKind,
} from '../../../data/ressources-hub-sections';

// Organism · ResourcesHub · corps du hub Ressources (en-tête + pastilles + liste + newsletter
// + CTA), partagé par /ressources, /ressources/outils, /ressources/comparatifs et
// /ressources/guides.
//   • `items` = liste complète (src/lib/resources-hub.ts) : même source pour les trois pages.
//   • `activeKind` absent = index de tous les types ; sinon vue filtrée côté serveur (seules
//     les cartes du type sont dans le HTML). Les pastilles sont de vrais liens.
// Le fil d'Ariane (MastheadBar) n'est rendu que sur les vues filtrées.
interface Props {
  items: ResourceItem[];
  activeKind?: Extract<ResourceKind, 'outils' | 'comparatifs' | 'guides'>;
}
const { items, activeKind } = Astro.props as Props;
const lang = langFromPath(Astro.url.pathname);
const isFr = lang === 'fr';

const kindOf = (k: ResourceKind) => RESOURCE_KINDS.find((r) => r.key === k)!;
const count = (k: ResourceKind) => items.filter((i) => i.kind === k).length;
const shown = activeKind ? items.filter((i) => i.kind === activeKind) : items;
const fmtDate = (d: Date) =>
  `${String(d.getDate()).padStart(2, '0')}.${String(d.getMonth() + 1).padStart(2, '0')}.${d.getFullYear()}`;

// ── Tête éditoriale de la vue ──
let head: SectionByType<'list-index-section'> = indexHeadData;
if (activeKind) {
  const v = RESOURCE_VIEWS[activeKind];
  const n = shown.length;
  const label = isFr ? v.label_fr : v.label_en;
  const kicker = isFr
    ? `§ ${label} · ${n} disponible${n > 1 ? 's' : ''}`
    : `§ ${label} · ${n} available`;
  head = {
    ...indexHeadData,
    kicker_fr: kicker,
    kicker_en: kicker,
    h1_fr: v.h1_fr ?? '',
    h1_en: v.h1_en ?? '',
    lede_fr: v.lede_fr ?? '',
    lede_en: v.lede_en ?? '',
  };
  if (activeKind === 'outils') {
    // H1 et chapô des outils : entrée `outils-hub` de la collection `legal` (source conservée).
    const hubCopy = await getEntry('legal', 'outils-hub');
    if (!hubCopy) throw new Error('Collection "legal" · entrée "outils-hub" introuvable.');
    head = {
      ...head,
      h1_fr: hubCopy.data.headlineHtml ?? '',
      h1_en: hubCopy.data.headlineHtml ?? '',
      lede_fr: hubCopy.data.ledeHtml ?? '',
      lede_en: hubCopy.data.ledeHtml ?? '',
    };
  }
}

// Grilles successives de 12 cartes (borne du schéma article-grid), ordre chronologique conservé.
const GRID_MAX = 12;
const grids: SectionByType<'article-grid'>[] = [];
for (let i = 0; i < shown.length; i += GRID_MAX) {
  grids.push({
    type: 'article-grid',
    background: 'paper',
    columns: '3',
    articles: shown.slice(i, i + GRID_MAX).map((it) => ({
      tag_fr: kindOf(it.kind).tag_fr,
      tag_en: kindOf(it.kind).tag_en,
      title_fr: it.title_fr,
      title_en: it.title_en,
      excerpt_fr: it.excerpt_fr,
      excerpt_en: it.excerpt_en,
      date: fmtDate(it.date),
      read_time_fr: it.read_time,
      read_time_en: it.read_time,
      href: it.href,
      silo: it.silo,
      image: it.image,
      tint: it.tint,
    })),
  });
}

// ── Pastilles : de vrais liens, une URL par vue ; « Articles » mène au hub des articles, /blog. ──
const chips = [
  { key: 'all', label: isFr ? 'Toutes les ressources' : 'All resources', n: items.length, href: '/ressources', current: !activeKind },
  { key: 'comparatifs', label: isFr ? 'Comparatifs' : 'Comparisons', n: count('comparatifs'), href: '/ressources/comparatifs', current: activeKind === 'comparatifs' },
  { key: 'outils', label: isFr ? 'Outils' : 'Tools', n: count('outils'), href: '/ressources/outils', current: activeKind === 'outils' },
  { key: 'guides', label: isFr ? 'Guides' : 'Guides', n: count('guides'), href: '/ressources/guides', current: activeKind === 'guides' },
  { key: 'articles', label: isFr ? 'Articles' : 'Articles', n: count('articles'), href: '/blog', current: false },
].filter((c) => c.n > 0);

const crumbs = [
  { label: isFr ? 'Accueil' : 'Home', href: isFr ? '/' : '/en' },
  { label: isFr ? 'Ressources' : 'Resources', href: isFr ? '/ressources' : '/en/ressources' },
  { label: activeKind ? (isFr ? RESOURCE_VIEWS[activeKind].label_fr : RESOURCE_VIEWS[activeKind].label_en) ?? '' : '' },
];
const listTitle = activeKind
  ? (isFr ? `${RESOURCE_VIEWS[activeKind].label_fr}, de la plus récente à la plus ancienne` : `${RESOURCE_VIEWS[activeKind].label_en}, newest first`)
  : (isFr ? 'Toutes les ressources, de la plus récente à la plus ancienne' : 'All resources, newest first');
---
{activeKind && <MastheadBar lang={lang} items={crumbs} />}
<div class:list={['res-index', { 'res-index--view': activeKind }]}>
  <ListIndexSection data={head} lang={lang}>
    <Fragment slot="filters">
      <div class="res-filters-stack">
      {/* Recherche dans TOUTES les ressources, quelle que soit la vue. Masquée sans JS (le
          script retire `hidden`) : sans JS, la page reste la liste des cartes. */}
      <div class="res-search" data-res-search data-lang={lang} data-index="/ressources/search-index.json" hidden>
        <label for="res-q" class="sr-only">{isFr ? 'Rechercher dans toutes les ressources' : 'Search all resources'}</label>
        <div class="res-search__field">
          <svg class="res-search__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8" />
            <path d="M15.5 15.5 21 21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          <input
            id="res-q"
            class="res-search__input"
            type="search"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="res-q-list"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            enterkeyhint="search"
            placeholder={isFr ? 'Rechercher une ressource' : 'Search resources'}
          />
        </div>
        <p class="res-search__status" role="status" data-res-status></p>
        <div class="res-search__panel" data-res-panel hidden>
          <p class="res-search__empty" data-res-empty hidden></p>
          <div id="res-q-list" class="res-search__list" role="listbox" aria-label={isFr ? 'Résultats de la recherche' : 'Search results'} data-res-list></div>
        </div>
      </div>
      {/* Deux niveaux de filtre : le TYPE (une URL par vue, contrôle segmenté) puis le THÈME
          (puces discrètes, sur les cartes de la vue). Une rangée défilante chacun en mobile. */}
      <div class="res-facets">
        <div class="res-facet">
          <span class="res-facet__label" aria-hidden="true">Type</span>
          <nav class="res-filters" aria-label={isFr ? 'Type de ressource' : 'Resource type'}>
            {chips.map((c) => (
              <a class="res-chip" href={c.href} aria-current={c.current ? 'page' : undefined}>
                {c.label} <span class="res-chip-n">{c.n}</span>
              </a>
            ))}
          </nav>
        </div>
        <div class="res-facet res-facet--theme">
          <span class="res-facet__label" aria-hidden="true">{isFr ? 'Thème' : 'Topic'}</span>
          <SiloFilter
            silos={shown.map((i) => i.silo)}
            lang={lang}
            class="res-silos"
            allLabel={isFr ? 'Tous les thèmes' : 'All topics'}
          />
        </div>
      </div>
      </div>
    </Fragment>
    <Fragment slot="list">
      <h2 class="sr-only">{listTitle}</h2>
      <div class="res-list">
        {grids.map((g) => <ArticleGrid data={g} lang={lang} />)}
      </div>
    </Fragment>
  </ListIndexSection>
</div>

  {/* MANIFESTO · « La promesse », conservé du hub guides (ink, source unique en donnée) */}
  <ManifestoStatement data={manifestoData} lang={lang} />

  {/* NEWSLETTER BAND · ink (ancre #newsletter liée depuis /blog) */}
  <section id="newsletter" class="hub-nl">
    <div class="wrap-wide hub-nl-wrap">
      <div>
        <Kicker tone="accent" class="hub-nl-k">§ Newsletter · une fois par mois</Kicker>
        <h2 class="hub-nl-h2">Un essai par mois. Jamais de promotion.</h2>
        <p class="hub-nl-lead">
          Notes longues, cas concrets, recettes pratiques. Désabonnement en 1 clic, RGPD-compliant.
        </p>
      </div>
      <form class="hub-nl-form" method="POST" action="/api/newsletter" data-newsletter-form novalidate>
        <FormGuard />
        <input type="hidden" name="lang" value={lang} />
        <label for="nl-email" class="sr-only">Email professionnel</label>
        <input id="nl-email" name="email" type="email" required placeholder="prénom@entreprise.com" autocomplete="email" aria-describedby="nl-hint" />
        <Button as="button" type="submit" variant="primary" size="md">S'abonner →</Button>
        <p class="form-error-global" role="alert" aria-live="assertive" hidden data-newsletter-error></p>
      </form>
      <p class="nl-hint" id="nl-hint">
        <Bi fr="Sans spam · Désinscription en 1 clic" en="No spam · Unsubscribe anytime" />
        {' · '}
        <a href="/politique-confidentialite">
          <Bi fr="Politique de confidentialité" en="Privacy policy" />
        </a>
      </p>
    </div>
  </section>

  <CtaFinal data={ctaData} lang={lang} />

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  /* En-tête et corps de liste : ListIndexSection ajoute un padding latéral en plus du
     gabarit .wrap-wide ; on le retire pour aligner kicker, titre et pastilles sur le fil
     d'Ariane, le logo et la grille de cartes (même x, 3 vues). */
  .res-index :global(.list-hd),
  .res-index :global(.list-body) { padding-inline: 0; }
  /* Vue filtrée : le fil d'Ariane (MastheadBar) occupe déjà le haut sous l'en-tête fixe. */
  .res-index--view :global(.list-hd) { padding-top: var(--space-9); }

  /* Pastilles de type puis pastilles de thème : EMPILÉES (le conteneur .list-filters de
     ListIndexSection est une rangée flex qui les mettait côte à côte). */
  .res-filters-stack { display: flex; flex-direction: column; align-items: flex-start; width: 100%; }

  /* ── Filtres à deux niveaux (tokens DS existants, aucun token neuf) ──
     Niveau 1, TYPE : contrôle segmenté dans un cadre, segment actif en encre (une URL par vue).
     Niveau 2, THÈME : puces sans cadre, soulignées quand actives, plus discrètes. Chaque
     niveau porte son libellé dans une colonne fixe : la hiérarchie se lit sans les compteurs. */
  .res-facets { display: flex; flex-direction: column; gap: var(--space-4); width: 100%; }
  .res-facet {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    /* Libellé aligné sur la PREMIÈRE ligne de puces (les thèmes passent sur deux lignes). */
    align-items: baseline;
    column-gap: var(--space-4);
  }
  .res-facet__label {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--muted);
  }
  /* Thème : masqué sans JS (SiloFilter reste `hidden`) ou quand la vue n'a qu'un thème. */
  :global(.res-facet--theme:not(:has(.silo-filter:not([hidden])))) { display: none; }

  .res-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    justify-self: start;
    max-width: 100%;
    padding: var(--space-1);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-pill);
  }
  .res-chip {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .res-chip:hover { background: var(--paper-2); }
  .res-chip:focus-visible { outline: 2px solid var(--accent-text); outline-offset: -2px; }
  .res-chip-n { font-family: var(--font-mono); color: var(--muted); }
  /* Segment actif : la vue courante (aria-current="page"). */
  .res-chip[aria-current='page'] { background: var(--ink); color: var(--paper); }
  .res-chip[aria-current='page'] .res-chip-n { color: inherit; }

  .res-index :global(.res-silos) { margin: 0; gap: var(--space-1) var(--space-2); }
  .res-index :global(.res-silos .silo-chip) {
    padding: var(--space-1) var(--space-2);
    background: transparent;
    border: 0;
    border-radius: var(--radius-xs);
    color: var(--ink-2);
    white-space: nowrap;
  }
  /* Indicateur sous la puce (libellé ET compteur), comme un onglet. */
  .res-index :global(.res-silos .silo-chip:hover) { color: var(--ink); box-shadow: inset 0 -2px 0 var(--hairline-strong); }
  .res-index :global(.res-silos .silo-chip:focus-visible) { outline-offset: -2px; }
  .res-index :global(.res-silos .silo-chip[aria-pressed='true']) {
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--accent-text);
  }
  .res-index :global(.res-silos .silo-chip[aria-pressed='true'] .silo-chip-n) { color: var(--muted); }

  @media (max-width: 640px) {
    /* Une rangée défilante par niveau : le bloc de filtres garde deux lignes de haut. */
    .res-facet { grid-template-columns: 3.5rem minmax(0, 1fr); column-gap: var(--space-3); }
    .res-filters,
    .res-index :global(.res-silos) {
      flex-wrap: nowrap;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
    }
    .res-filters::-webkit-scrollbar,
    .res-index :global(.res-silos::-webkit-scrollbar) { display: none; }
    .res-chip,
    .res-index :global(.res-silos .silo-chip) {
      flex: none;
      align-items: center;
      min-height: 2.75rem;
      scroll-snap-align: start;
    }
    /* Fondu à droite : il reste des thèmes à faire défiler. */
    .res-index :global(.res-silos) {
      -webkit-mask-image: linear-gradient(to right, black calc(100% - var(--space-6)), transparent);
      mask-image: linear-gradient(to right, black calc(100% - var(--space-6)), transparent);
    }
    /* En-tête resserré : des cartes visibles au-dessus de la ligne de flottaison. */
    .res-index :global(.list-filters) { margin-top: var(--space-6); }
    .res-index :global(.list-hd) { padding-bottom: var(--space-6); }
  }

  /* ── Recherche (tokens DS existants, aucun token neuf) ──
     Les résultats s'ouvrent en flux sous le champ et REMPLACENT pastilles, thèmes et grille
     tant que la requête est non vide : une seule liste à lire, et aucune pastille active
     (« Outils ») ne laisse croire que la recherche, globale, est filtrée. */
  .res-search { width: 100%; max-width: var(--wrap-read); margin-bottom: var(--space-6); }
  .res-search[hidden] { display: none; }
  .res-search__field { position: relative; }
  .res-search__icon {
    position: absolute;
    left: var(--space-4);
    top: 50%;
    width: 1.25em;
    height: 1.25em;
    transform: translateY(-50%);
    color: var(--muted);
    pointer-events: none;
  }
  .res-search__input {
    box-sizing: border-box;
    width: 100%;
    min-height: calc(var(--space-6) + var(--space-4));
    padding: var(--space-3) var(--space-4) var(--space-3) calc(var(--space-4) * 2 + 1.25em);
    background: var(--paper);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-xs);
    color: var(--ink);
    font-family: var(--font-sans);
    /* 16 px au moins : en dessous, iOS zoome la page au focus. */
    font-size: max(16px, var(--text-body));
    -webkit-appearance: none;
    appearance: none;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .res-search__input::placeholder { color: var(--muted); opacity: 1; }
  /* Croix native (bleue sous WebKit) retirée : Échap vide le champ. */
  .res-search__input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; display: none; }
  .res-search__input:hover { border-color: var(--ink); }
  .res-search__input:focus { outline: none; border-color: var(--ink); }
  .res-search__input:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 2px; }
  .res-search__status {
    margin: var(--space-3) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono-tight);
    color: var(--muted);
  }
  .res-search__status:empty { display: none; }
  .res-search__panel { margin-top: var(--space-4); border-top: 1px solid var(--hairline); }
  .res-search__panel[hidden] { display: none; }
  .res-search__empty {
    margin: 0;
    padding: var(--space-5) 0 var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--ink-2);
  }
  .res-search__empty[hidden] { display: none; }
  .res-search__empty :global(strong) { color: var(--ink); font-weight: var(--fw-semibold); }

  /* Un résultat : vignette (image de la carte) puis type et date, titre surligné, extrait. */
  .res-search :global(.res-hit) {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: var(--space-5);
    align-items: start;
    padding: var(--space-4) var(--space-3);
    border-bottom: 1px solid var(--hairline);
    color: inherit;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease);
  }
  .res-search :global(.res-hit:hover),
  .res-search :global(.res-hit[aria-selected='true']) { background: var(--paper-2); }
  .res-search :global(.res-hit[aria-selected='true']) { box-shadow: inset 2px 0 0 var(--accent-text); }
  .res-search :global(.res-hit__media) {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--paper-3);
    border-radius: var(--radius-xs);
    overflow: hidden;
  }
  .res-search :global(.res-hit__media img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .res-search :global(.res-hit__body) { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .res-search :global(.res-hit__meta) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-kicker);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--muted);
  }
  .res-search :global(.res-hit__tag) { color: var(--accent-text); }
  .res-search :global(.res-hit__title) {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-h3);
    font-weight: var(--fw-semibold);
    color: var(--ink);
    text-wrap: balance;
  }
  .res-search :global(.res-hit[aria-selected='true'] .res-hit__title),
  .res-search :global(.res-hit:hover .res-hit__title) { color: var(--accent-text); }
  .res-search :global(.res-hit__title mark) {
    background: rgba(var(--accent-rgb), 0.14);
    color: inherit;
    border-radius: var(--radius-xs);
    box-shadow: inset 0 -2px 0 var(--accent-text);
  }
  .res-search :global(.res-hit__excerpt) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--muted);
  }
  .res-search :global(.res-search__hint) {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--text-small);
    color: var(--muted);
  }

  /* Requête en cours : la recherche remplace les deux niveaux de filtre et la grille. */
  .res-index[data-searching] .res-facets,
  .res-index[data-searching] :global(.list-body) { display: none; }

  @media (max-width: 640px) {
    .res-search { max-width: none; }
    .res-search :global(.res-hit) { grid-template-columns: 5.5rem 1fr; gap: var(--space-4); padding-inline: 0; }
    .res-search :global(.res-hit[aria-selected='true']) { box-shadow: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .res-search__input,
    .res-search :global(.res-hit) { transition: none; }
  }

  /* Grilles successives fondues en UNE grille : les sections article-grid (12 cartes au plus
     chacune) et leurs conteneurs passent en `display: contents`, les cartes deviennent les
     enfants directs de .res-list. Un filtre ne laisse donc pas de trous entre les grilles.
     Mêmes colonnes et points de rupture que le composant (3 / 2 / 1). */
  .res-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-top: calc(-1 * var(--space-7));
  }
  .res-list :global(.article-grid),
  .res-list :global(.article-grid > .wrap-wide),
  .res-list :global(.article-grid__list) { display: contents; }
  @media (max-width: 980px) { .res-list { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 768px) { .res-list { margin-top: calc(-1 * var(--space-5)); } }
