---
import FormGuard from '../atoms/FormGuard.astro';
import Kicker from '../atoms/Kicker.astro';
import Button from '../atoms/Button.astro';
import Bi from '../atoms/Bi.astro';
import SiloFilter from '../molecules/SiloFilter.astro';
import ListIndexSection from '../../sections/ListIndexSection.astro';
import ArticleGrid from '../../sections/ArticleGrid.astro';
import CtaFinal from '../../sections/CtaFinal.astro';
import CtaBandSection from '../../sections/CtaBandSection.astro';
import ManifestoStatement from '../../sections/ManifestoStatement.astro';
import MastheadBar from '../../sections/MastheadBar.astro';
import type { SectionByType } from '@waimia/ds-kernel';
import { langFromPath } from '../../../lib/i18n';
import type { ResourceItem } from '../../../lib/resources-hub';
import {
  indexHeadData,
  manifestoData,
  ctaData,
  RESOURCE_KINDS,
  RESOURCE_VIEWS,
  type ResourceKind,
} from '../../../data/ressources-hub-sections';
import { auditCtaBand } from '../../../data/conversion';

// Organism · ResourcesHub · corps du hub Ressources (en-tête + pastilles + liste + newsletter
// + CTA), partagé par /ressources, /ressources/outils, /ressources/comparatifs et
// /ressources/guides.
//   • `items` = liste complète (src/lib/resources-hub.ts) : même source pour les trois pages.
//   • `activeKind` absent = index de tous les types ; sinon vue filtrée côté serveur (seules
//     les cartes du type sont dans le HTML). Les pastilles sont de vrais liens.
//   • Les vues guides, comparatifs et outils ont chacune leur tête éditoriale (H1, introduction)
//     et leur fil d'Ariane (MastheadBar), dès que RESOURCE_VIEWS leur donne un H1 (2026-10-26).
interface Props {
  items: ResourceItem[];
  activeKind?: ResourceKind;
}
const { items, activeKind } = Astro.props as Props;
const lang = langFromPath(Astro.url.pathname);
const isFr = lang === 'fr';

const kindOf = (k: ResourceKind) => RESOURCE_KINDS.find((r) => r.key === k)!;
const count = (k: ResourceKind) => items.filter((i) => i.kind === k).length;
const shown = activeKind ? items.filter((i) => i.kind === activeKind) : items;
const fmtDate = (d: Date) =>
  `${String(d.getDate()).padStart(2, '0')}.${String(d.getMonth() + 1).padStart(2, '0')}.${d.getFullYear()}`;

// ── Tête éditoriale de la vue ──
let head: SectionByType<'list-index-section'> = indexHeadData;
const ownHead = activeKind !== undefined && Boolean(RESOURCE_VIEWS[activeKind].h1_fr);
if (activeKind && ownHead) {
  const v = RESOURCE_VIEWS[activeKind];
  const n = shown.length;
  const label = isFr ? v.label_fr : v.label_en;
  const kicker = isFr
    ? `§ ${label} · ${n} disponible${n > 1 ? 's' : ''}`
    : `§ ${label} · ${n} available`;
  head = {
    ...indexHeadData,
    kicker_fr: kicker,
    kicker_en: kicker,
    h1_fr: v.h1_fr ?? '',
    h1_en: v.h1_en ?? '',
    lede_fr: v.lede_fr ?? '',
    lede_en: v.lede_en ?? '',
  };
}

// Grilles successives de 12 cartes (borne du schéma article-grid), ordre chronologique conservé.
const GRID_MAX = 12;
const grids: SectionByType<'article-grid'>[] = [];
for (let i = 0; i < shown.length; i += GRID_MAX) {
  grids.push({
    type: 'article-grid',
    background: 'paper',
    columns: '3',
    articles: shown.slice(i, i + GRID_MAX).map((it) => ({
      tag_fr: it.tag_fr ?? kindOf(it.kind).tag_fr,
      tag_en: it.tag_en ?? kindOf(it.kind).tag_en,
      title_fr: it.title_fr,
      title_en: it.title_en,
      excerpt_fr: it.excerpt_fr,
      excerpt_en: it.excerpt_en,
      date: it.dateLabel ?? fmtDate(it.date),
      author: it.author,
      read_time_fr: it.read_time,
      read_time_en: it.read_time,
      href: it.href,
      silo: it.silo,
      image: it.image,
      tint: it.tint,
    })),
  });
}

// ── Pastilles : de vrais liens, une URL par vue ; « Articles » mène au hub des articles, /blog. ──
const chips = [
  { key: 'all', label: isFr ? 'Toutes les ressources' : 'All resources', n: items.length, href: '/ressources', current: !activeKind },
  { key: 'comparatifs', label: isFr ? 'Comparatifs' : 'Comparisons', n: count('comparatifs'), href: '/ressources/comparatifs', current: activeKind === 'comparatifs' },
  { key: 'outils', label: isFr ? 'Outils' : 'Tools', n: count('outils'), href: '/ressources/outils', current: activeKind === 'outils' },
  { key: 'guides', label: isFr ? 'Guides' : 'Guides', n: count('guides'), href: '/ressources/guides', current: activeKind === 'guides' },
  { key: 'articles', label: isFr ? 'Articles' : 'Articles', n: count('articles'), href: '/blog', current: activeKind === 'articles' },
  { key: 'actualites', label: isFr ? 'Actualités' : 'News', n: count('actualites'), href: '/actualites', current: activeKind === 'actualites' },
].filter((c) => c.n > 0);

const crumbs = [
  { label: isFr ? 'Accueil' : 'Home', href: isFr ? '/' : '/en' },
  { label: isFr ? 'Ressources' : 'Resources', href: isFr ? '/ressources' : '/en/ressources' },
  { label: activeKind ? (isFr ? RESOURCE_VIEWS[activeKind].label_fr : RESOURCE_VIEWS[activeKind].label_en) ?? '' : '' },
];
const listTitle = activeKind
  ? (isFr ? `${RESOURCE_VIEWS[activeKind].label_fr}, de la plus récente à la plus ancienne` : `${RESOURCE_VIEWS[activeKind].label_en}, newest first`)
  : (isFr ? 'Toutes les ressources, de la plus récente à la plus ancienne' : 'All resources, newest first');
---
{ownHead && <MastheadBar lang={lang} items={crumbs} />}
<div class:list={['res-index', { 'res-index--view': ownHead }]}>
  <ListIndexSection data={head} lang={lang}>
    <Fragment slot="filters">
      <div class="res-filters-stack">
      {/* Recherche dans TOUTES les ressources, quelle que soit la vue. Masquée sans JS (le
          script retire `hidden`) : sans JS, la page reste la liste des cartes. */}
      <div class="res-search" data-res-search data-lang={lang} data-index="/ressources/search-index.json" hidden>
        <label for="res-q" class="sr-only">{isFr ? 'Rechercher dans toutes les ressources' : 'Search all resources'}</label>
        <div class="res-search__row">
        <div class="res-search__field">
          <svg class="res-search__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8" />
            <path d="M15.5 15.5 21 21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          <input
            id="res-q"
            class="res-search__input"
            type="search"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="res-q-list"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            enterkeyhint="search"
            placeholder={isFr ? 'Rechercher une ressource' : 'Search resources'}
          />
        </div>
        {/* Mobile (< 768 px) : ouvre le panneau des filtres. Masqué sans JS et en desktop, où
            les deux niveaux restent à plat sous la recherche. */}
        <button
          type="button"
          class="res-filter-btn"
          aria-expanded="false"
          aria-controls="res-facets-panel"
          data-res-filter-btn
          hidden
        >
          <svg class="res-filter-btn__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 7h16M7 12h10M10 17h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          <span>{isFr ? 'Filtrer' : 'Filter'}</span>
          <span class="res-filter-btn__n" data-res-filter-n hidden></span>
        </button>
        </div>
        {/* Annonce lecteurs d'écran : zone live TOUJOURS présente et masquée visuellement (une zone
            display:none ou vide au chargement n'est pas annoncée de façon fiable). Le compte
            visible juste dessous est aria-hidden : pas de doublon vocal. */}
        <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-res-live></p>
        <p class="res-search__status" aria-hidden="true" data-res-status></p>
        <div class="res-search__panel" data-res-panel hidden>
          <p class="res-search__empty" data-res-empty hidden></p>
          <div id="res-q-list" class="res-search__list" role="listbox" aria-label={isFr ? 'Résultats de la recherche' : 'Search results'} data-res-list></div>
        </div>
      </div>
      {/* Deux niveaux de filtre, UN SEUL bloc pour toutes les largeurs : le TYPE (vrais liens,
          une URL par vue) puis le THÈME (filtre client sur les cartes de la vue).
            • Desktop : deux rangées à plat, retour à la ligne, aucune option cachée.
            • Mobile avec JS : le bloc se replie derrière « Filtrer » (dépliant en flux, pas de
              feuille modale : ni piège de focus, ni verrou de défilement) ; une ligne d'état
              montre les filtres actifs en pastilles retirables, ou l'étendue du choix.
            • Sans JS : le bloc reste déplié, les liens de type sont atteignables. */}
      <div class="res-facets" data-res-facets data-lang={lang} data-types={chips.length - 1}>
        <div class="res-active" data-res-active hidden></div>
        <div id="res-facets-panel" class="res-facets__panel" role="region" aria-labelledby="res-facets-title">
          <h2 id="res-facets-title" class="res-facets__title" tabindex="-1">{isFr ? 'Filtrer les ressources' : 'Filter resources'}</h2>
          <div class="res-facet">
            <span class="res-facet__label" aria-hidden="true">Type<span class="res-facet__more">{isFr ? ' de ressource' : ' of resource'}</span></span>
            <nav class="res-filters" aria-label={isFr ? 'Type de ressource' : 'Resource type'}>
              {chips.map((c) => (
                <a class="res-chip" href={c.href} data-type-key={c.key} aria-current={c.current ? 'page' : undefined}>
                  <span class="res-chip__label">{c.label}</span> <span class="res-chip-n">{c.n}</span>
                </a>
              ))}
            </nav>
          </div>
          <div class="res-facet res-facet--theme">
            <span class="res-facet__label" aria-hidden="true">{isFr ? 'Thème' : 'Topic'}</span>
            <SiloFilter
              silos={shown.map((i) => i.silo)}
              lang={lang}
              class="res-silos"
              allLabel={isFr ? 'Tous les thèmes' : 'All topics'}
              cards=".res-list .article-card"
            />
          </div>
          <div class="res-facets__actions">
            <Button as="button" variant="ghost" class="res-facets__reset" data-res-reset>{isFr ? 'Réinitialiser' : 'Reset'}</Button>
            <Button as="button" variant="primary" class="res-facets__apply" data-res-apply>{isFr ? 'Voir les résultats' : 'Show results'}</Button>
          </div>
        </div>
      </div>
      {/* Marque le bloc comme piloté par le script AVANT la première peinture : en mobile, il
          naît replié (pas de saut). Idempotent, rejoué sans risque après une navigation. */}
      <script is:inline>document.querySelectorAll('[data-res-facets]').forEach(function (f) { f.setAttribute('data-ready', ''); });</script>
      </div>
    </Fragment>
    <Fragment slot="list">
      <h2 class="sr-only">{listTitle}</h2>
      <div class="res-list">
        {/* CTA de page après la 12e carte (fin de la première grille) : sans elle, le premier
            CTA de page arrivait à 29 373 px sur 32 530 en mobile (audit v5, point 4). Ligne
            pleine largeur de la grille fondue, jamais comptée comme une carte. */}
        {grids.map((g, i) => (
          <Fragment>
            <ArticleGrid data={g} lang={lang} />
            {i === 0 && grids.length > 1 && (
              <div class="res-list__cta"><CtaBandSection data={auditCtaBand()} lang={lang} /></div>
            )}
          </Fragment>
        ))}
      </div>
    </Fragment>
  </ListIndexSection>
</div>

  {/* Contenu propre à la page hôte (ex. maillage interne du blog), avant la promesse. */}
  <slot name="after-list" />

  {/* MANIFESTO · « La promesse », conservé du hub guides (ink, source unique en donnée) */}
  <ManifestoStatement data={manifestoData} lang={lang} />

  {/* NEWSLETTER BAND · ink (ancre #newsletter liée depuis /blog) */}
  <section id="newsletter" class="hub-nl on-dark">
    <div class="wrap-wide hub-nl-wrap">
      <div>
        <Kicker tone="accent" class="hub-nl-k">§ Newsletter · une fois par mois</Kicker>
        <h2 class="hub-nl-h2">Un essai par mois. Jamais de promotion.</h2>
        <p class="hub-nl-lead">
          Notes longues, cas concrets, recettes pratiques. Désabonnement en 1 clic, RGPD-compliant.
        </p>
      </div>
      <form class="hub-nl-form" method="POST" action="/api/newsletter" data-newsletter-form novalidate>
        <FormGuard />
        <input type="hidden" name="lang" value={lang} />
        <label for="nl-email" class="sr-only">Email professionnel</label>
        <input id="nl-email" name="email" type="email" required placeholder="prénom@entreprise.com" autocomplete="email" aria-describedby="nl-hint" />
        <Button as="button" type="submit" variant="primary" size="md">S'abonner →</Button>
        <p class="form-error-global" role="alert" aria-live="assertive" hidden data-newsletter-error></p>
      </form>
      <p class="nl-hint" id="nl-hint">
        <Bi fr="Sans spam · Désinscription en 1 clic" en="No spam · Unsubscribe anytime" />
        {' · '}
        <a href="/politique-confidentialite">
          <Bi fr="Politique de confidentialité" en="Privacy policy" />
        </a>
      </p>
    </div>
  </section>

  <CtaFinal data={ctaData} lang={lang} />

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  /* En-tête et corps de liste : ListIndexSection ajoute un padding latéral en plus du
     gabarit .wrap-wide ; on le retire pour aligner kicker, titre et pastilles sur le fil
     d'Ariane, le logo et la grille de cartes (même x, 3 vues). */
  .res-index :global(.list-hd),
  .res-index :global(.list-body) { padding-inline: 0; }
  /* Vue filtrée : le fil d'Ariane (MastheadBar) occupe déjà le haut sous l'en-tête fixe. */
  .res-index--view :global(.list-hd) { padding-top: var(--space-9); }
  /* Lien d'appel dans l'introduction d'une vue (newsletter, flux RSS, actualités) : le lede est
     rendu par ListIndexSection via set:html, donc hors du scope de ce composant. */
  :global(.hub-inline-cta) {
    color: var(--accent-text);
    font-weight: var(--fw-medium);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    white-space: nowrap;
  }
  :global(.hub-inline-cta:hover) { opacity: 0.72; }

  /* Pastilles de type puis pastilles de thème : EMPILÉES (le conteneur .list-filters de
     ListIndexSection est une rangée flex qui les mettait côte à côte). */
  .res-filters-stack { display: flex; flex-direction: column; align-items: flex-start; width: 100%; }

  /* ── Filtres à deux niveaux (tokens DS existants, aucun token neuf) ──
     Niveau 1, TYPE : pastilles-liens, une URL par vue, la vue courante en encre.
     Niveau 2, THÈME : puces sans cadre, soulignées quand actives, plus discrètes.
     Aucune rangée défilante : toutes les options sont toujours visibles (retour à la ligne
     en desktop, grille dans le panneau mobile). */
  .res-facets { width: 100%; }
  .res-facets__title {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
  .res-facets__title:focus { outline: none; }
  .res-facets__actions,
  .res-active { display: none; }
  .res-facet__label {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    color: var(--muted);
  }
  .res-facet__more { display: none; }
  /* Thème : masqué sans JS (SiloFilter reste `hidden`) ou quand la vue n'a qu'un thème. */
  :global(.res-facet--theme:not(:has(.silo-filter:not([hidden])))) { display: none; }

  .res-chip {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border: 1px solid var(--hairline-strong);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--ink);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .res-chip:hover { border-color: var(--ink); }
  .res-chip:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 2px; }
  .res-chip-n { font-family: var(--font-mono); color: var(--muted); }
  /* Vue courante (aria-current="page") : pastille pleine en encre. */
  .res-chip[aria-current='page'] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .res-chip[aria-current='page'] .res-chip-n { color: inherit; }

  .res-index :global(.res-silos:not([hidden])) { margin: 0; }
  .res-index :global(.res-silos .silo-chip) {
    box-sizing: border-box;
    align-items: center;
    background: transparent;
    color: var(--ink-2);
  }
  .res-index :global(.res-silos .silo-chip:focus-visible) { outline-offset: -2px; }
  .res-index :global(.res-silos .silo-chip[aria-pressed='true']) { background: transparent; color: var(--ink); }
  .res-index :global(.res-silos .silo-chip[aria-pressed='true'] .silo-chip-n) { color: var(--accent-text); }

  /* Bouton « Filtrer » : à côté de la recherche, même hauteur que le champ. */
  .res-search__row { display: flex; gap: var(--space-2); align-items: stretch; }
  .res-search__field { flex: 1 1 auto; min-width: 0; }
  .res-filter-btn {
    box-sizing: border-box;
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--space-2);
    min-height: calc(var(--space-6) + var(--space-4));
    padding: 0 var(--space-3);
    background: var(--paper);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-xs);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: var(--fw-medium);
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }
  .res-filter-btn[hidden] { display: none; }
  .res-filter-btn:hover,
  .res-filter-btn[aria-expanded='true'] { border-color: var(--ink); }
  .res-filter-btn[aria-expanded='true'] { background: var(--paper-2); }
  .res-filter-btn:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 2px; }
  .res-filter-btn__icon { width: 1.25em; height: 1.25em; }
  /* Filtres actifs : le compteur suffit, l'icône cède sa place au champ de recherche. */
  .res-filter-btn:has(.res-filter-btn__n:not([hidden])) .res-filter-btn__icon { display: none; }
  .res-filter-btn__n {
    min-width: 1.5em;
    padding: 0 var(--space-1);
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    text-align: center;
  }
  .res-filter-btn__n[hidden] { display: none; }
  /* Requête en cours : la recherche, globale, n'est pas filtrée. */
  .res-index[data-searching] .res-filter-btn { display: none; }

  /* ── Desktop (768 px et plus) : deux rangées à plat sous la recherche ── */
  @media (min-width: 768px) {
    .res-filter-btn { display: none; }
    .res-facets__panel { display: flex; flex-direction: column; gap: var(--space-4); }
    .res-facet {
      display: grid;
      grid-template-columns: 4.5rem minmax(0, 1fr);
      /* Libellé aligné sur la PREMIÈRE ligne de puces (les thèmes passent sur deux lignes). */
      align-items: baseline;
      column-gap: var(--space-4);
    }
    .res-filters { display: flex; flex-wrap: wrap; gap: var(--space-2); }
    .res-chip {
      min-height: 2.5rem;
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius-pill);
      white-space: nowrap;
    }
    .res-index :global(.res-silos:not([hidden])) { gap: var(--space-1) var(--space-2); }
    .res-index :global(.res-silos .silo-chip) {
      padding: var(--space-1) var(--space-2);
      border: 0;
      border-radius: var(--radius-xs);
      white-space: nowrap;
    }
    /* Indicateur sous la puce (libellé ET compteur), comme un onglet. */
    .res-index :global(.res-silos .silo-chip:hover) { color: var(--ink); box-shadow: inset 0 -2px 0 var(--hairline-strong); }
    .res-index :global(.res-silos .silo-chip[aria-pressed='true']) { box-shadow: inset 0 -2px 0 var(--accent-text); }
    .res-index :global(.res-silos .silo-chip[aria-pressed='true'] .silo-chip-n) { color: var(--muted); }
  }

  /* ── Mobile (moins de 768 px) : un bouton « Filtrer », un dépliant, une ligne d'état ── */
  @media (max-width: 767px) {
    /* Spécificité relevée : la règle de base de .res-search est déclarée plus bas. */
    .res-index .res-search { margin-bottom: var(--space-3); }
    .res-index :global(.list-filters) { margin-top: var(--space-6); }
    .res-index :global(.list-hd) { padding-bottom: var(--space-6); }

    /* Piloté par le script : replié tant que « Filtrer » n'est pas ouvert. */
    .res-facets[data-ready]:not([data-open]) .res-facets__panel { display: none; }
    .res-facets[data-ready][data-open] .res-facets__panel {
      padding: var(--space-5) var(--space-4) var(--space-4);
      background: var(--paper-2);
      border-radius: var(--radius-md);
    }
    .res-facets[data-ready] .res-facets__title {
      position: static; width: auto; height: auto; margin: 0 0 var(--space-5);
      overflow: visible; clip: auto; white-space: normal;
      font-family: var(--font-sans);
      font-size: var(--text-body);
      font-weight: var(--fw-semibold);
      line-height: var(--leading-body);
      color: var(--ink);
    }

    /* Ligne d'état, panneau fermé : filtres actifs en pastilles retirables, sinon l'étendue
       du choix (« 87 ressources, 4 types, 11 thèmes »). Le panneau ouvert la remplace :
       l'état ne s'affiche jamais deux fois. */
    .res-facets[data-ready] .res-active:not([hidden]) {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2);
    }
