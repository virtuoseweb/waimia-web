<script is:inline>
(function () {
  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function bindForm(form) {
    if (form.dataset.nlBound) return;
    form.dataset.nlBound = '1';

    var langInput = form.querySelector('input[name="lang"]');
    var lang = langInput ? langInput.value : 'fr';
    var emailInput = form.querySelector('input[name="email"]');
    var errorEl = form.querySelector('[data-newsletter-error]');
    var btn = form.querySelector('button[type="submit"]');

    function showError(msg) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.removeAttribute('hidden');
    }
    function clearError() {
      if (!errorEl) return;
      errorEl.setAttribute('hidden', '');
      errorEl.textContent = '';
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      clearError();

      var email = emailInput ? emailInput.value.trim() : '';
      if (!email || !EMAIL_RE.test(email)) {
        showError(lang === 'fr' ? 'Adresse email invalide.' : 'Invalid email address.');
        if (emailInput) emailInput.focus();
        return;
      }

      if (btn) btn.disabled = true;

      var payload = Object.fromEntries(new FormData(form).entries());
      payload.source = window.wmLeadSource ? window.wmLeadSource() : undefined;

      try {
        var res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        var data = await res.json();
        if (data.ok) {
          document.cookie = 'waimia_newsletter_signed=true; path=/; max-age=31536000; SameSite=Lax';
          if (data.redirect) {
            window.location.href = data.redirect;
          }
        } else {
          showError(data.error || (lang === 'fr' ? 'Erreur, veuillez réessayer.' : 'Error, please try again.'));
          if (btn) btn.disabled = false;
        }
      } catch (_) {
        showError(lang === 'fr' ? 'Erreur réseau, veuillez réessayer.' : 'Network error, please try again.');
        if (btn) btn.disabled = false;
      }
    });
  }

  document.querySelectorAll('form[data-newsletter-form]').forEach(bindForm);
  // Après une navigation ClientRouter : on ne branche que les formulaires neufs (le drapeau
  // nlBound évite un second écouteur, donc un second POST, sur le formulaire déjà branché).
  document.addEventListener('astro:page-load', function () {
    document.querySelectorAll('form[data-newsletter-form]').forEach(bindForm);
  });
})();
</script>

<script is:inline>
// Recherche du hub Ressources : index statique (/ressources/search-index.json) chargé au
// premier focus ou à la première frappe, puis recherche locale. Normalisation sans accents
// ni casse, ET entre les mots (repli sur les correspondances partielles), préfixes, une
// faute de frappe tolérée sur les mots de 5 lettres et plus, titre > mots-clés > extrait,
// récence en départage. Combobox ARIA 1.2 : les options sont de vrais liens.
(function () {
  var MAX = 8;
  var W_TITLE = 10, W_TERMS = 6, W_EXCERPT = 2;
  var STOP = {};
  ('le la les l de des du d un une et ou en au aux a pour par sur avec dans ce ces cet cette '
    + 'son sa ses vos votre nos notre est qui que quoi comment quel quelle quels quelles '
    + 'the of and or to for in on an is with how what').split(' ').forEach(function (w) { STOP[w] = 1; });
  var TAGS = {
    fr: { guides: 'Guide', comparatifs: 'Comparatif', outils: 'Outil', articles: 'Article', actualites: 'Actualité' },
    en: { guides: 'Guide', comparatifs: 'Comparison', outils: 'Tool', articles: 'Article', actualites: 'News' },
  };
  var T = {
    fr: {
      count: function (n) { return n + (n > 1 ? ' résultats' : ' résultat') + ' dans toutes les ressources'; },
      best: function (n) { return ', ' + MAX + ' affichés'; },
      partial: function (n) { return 'Aucune ressource ne contient tous les mots. ' + n + (n > 1 ? ' résultats partiels' : ' résultat partiel'); },
      none: function (q) { return 'Aucun résultat pour « ' + q + ' ».'; },
      noneHint: 'Essayez un autre mot (n8n, Claude, RGPD) ou parcourez les ressources les plus récentes :',
      noneStatus: function (q) { return 'Aucun résultat pour « ' + q + ' ». 3 ressources récentes proposées.'; },
      loading: 'Chargement de la recherche…',
      error: 'La recherche est indisponible pour le moment. Les ressources restent listées ci-dessous.',
    },
    en: {
      count: function (n) { return n + (n > 1 ? ' results' : ' result') + ' across all resources'; },
      best: function (n) { return ', ' + MAX + ' shown'; },
      partial: function (n) { return 'No resource contains every word. ' + n + (n > 1 ? ' partial results' : ' partial result'); },
      none: function (q) { return 'No results for “' + q + '”.'; },
      noneHint: 'Try another word (n8n, Claude, GDPR) or browse the latest resources:',
      noneStatus: function (q) { return 'No results for “' + q + '”. 3 recent resources suggested.'; },
      loading: 'Loading search…',
      error: 'Search is unavailable right now. Resources are still listed below.',
    },
  };

  // Minuscules sans accents, caractère par caractère : `map[i]` = indice du caractère
  // d'origine, pour surligner le titre affiché aux bons endroits.
  function normMap(s) {
    var out = '', map = [];
    for (var i = 0; i < s.length; i++) {
      var c = s[i].normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
      if (c === 'œ') c = 'oe'; else if (c === 'æ') c = 'ae';
      for (var j = 0; j < c.length; j++) { out += c[j]; map.push(i); }
    }
    return { s: out, map: map };
  }
  function norm(s) { return normMap(s || '').s; }
  function words(s) { return norm(s).split(/[^a-z0-9]+/).filter(Boolean); }

  function queryTokens(q) {
    var all = words(q);
    var kept = all.filter(function (w) { return !STOP[w] && (w.length > 1 || /\d/.test(w)); });
    return kept.length ? kept : all;
  }

  // Distance d'édition ≤ 1 (substitution, insertion, suppression ou deux lettres inversées).
  function within1(a, b) {
    if (a === b) return true;
    var la = a.length, lb = b.length;
    if (Math.abs(la - lb) > 1) return false;
    var i = 0;
    while (i < la && i < lb && a[i] === b[i]) i++;
    if (la === lb) {
      if (a.slice(i + 1) === b.slice(i + 1)) return true;
      return a[i] === b[i + 1] && a[i + 1] === b[i] && a.slice(i + 2) === b.slice(i + 2);
    }
    return la > lb ? a.slice(i + 1) === b.slice(i) : a.slice(i) === b.slice(i + 1);
  }
  function fuzzy(tok, w) {
    if (within1(tok, w)) return true;
    for (var L = tok.length - 1; L <= tok.length + 1; L++) {
      if (L < w.length && within1(tok, w.slice(0, L))) return true;
    }
    return false;
  }

  // Qualité de la correspondance d'un mot de la requête dans une liste de mots :
  // exact 1, préfixe 0,8, dans le mot 0,45 (3 lettres et plus), faute de frappe 0,55.
  function quality(tok, list, allowFuzzy) {
    var best = 0;
    for (var i = 0; i < list.length; i++) {
      var w = list[i];
      if (w === tok) return 1;
      if (w.indexOf(tok) === 0) best = Math.max(best, 0.8);
      else if (tok.length >= 3 && w.indexOf(tok) > 0) best = Math.max(best, 0.45);
    }
    if (best || !allowFuzzy) return best;
    for (var k = 0; k < list.length; k++) if (fuzzy(tok, list[k])) return 0.55;
    return 0;
  }
  // Mot connu de l'index tel quel (exact ou préfixe) : la faute de frappe n'est alors pas
  // tentée pour lui, ce qui évite qu'un mot juste ramène ses voisins (« claude » / « clause »).
  function known(tok, items) {
    for (var i = 0; i < items.length; i++) {
      var lists = [items[i]._t, items[i]._k, items[i]._e];
      for (var l = 0; l < 3; l++) {
        for (var j = 0; j < lists[l].length; j++) if (lists[l][j].indexOf(tok) === 0) return true;
      }
    }
    return false;
  }

  function search(items, toks) {
    var fuzzyOk = toks.map(function (t) { return t.length >= 5 && !known(t, items); });
    var minT = Infinity, maxT = -Infinity;
    items.forEach(function (it) { minT = Math.min(minT, it._time); maxT = Math.max(maxT, it._time); });
    var span = maxT - minT || 1;
    var phrase = toks.join(' ');
    var hits = [];
    items.forEach(function (it) {
      var matched = 0, score = 0, how = [];
      toks.forEach(function (tok, n) {
        var q = Math.max(
          W_TITLE * quality(tok, it._t, fuzzyOk[n]),
          W_TERMS * quality(tok, it._k, fuzzyOk[n]),
          W_EXCERPT * quality(tok, it._e, fuzzyOk[n])
        );
        if (q > 0) { matched++; score += q; }
      });
      if (!matched) return;
      if (toks.length > 1 && it._tl.indexOf(phrase) !== -1) score += 5;
      // Titre qui COMMENCE par la requête : c'est son sujet principal (« n8n c'est quoi »).
      if (it._tl.indexOf(phrase) === 0) score += 2;
      // Récence : bonus léger (au plus 0,5), sous l'écart entre deux qualités de titre.
      score += 0.5 * (it._time - minT) / span;
      hits.push({ it: it, matched: matched, score: score });
    });
    var all = hits.filter(function (h) { return h.matched === toks.length; });
    var partial = !all.length && hits.length > 0;
    var list = partial ? hits : all;
    list.sort(function (a, b) {
      return b.matched - a.matched || b.score - a.score || b.it._time - a.it._time;
    });
    return { list: list, partial: partial };
  }

  // Titre surligné : nœuds texte et <mark>, jamais innerHTML.
  function highlight(el, title, toks, fuzzyToks) {
    var nm = normMap(title), s = nm.s, marks = new Array(s.length);
    var re = /[a-z0-9]+/g, m;
    while ((m = re.exec(s))) {
      var w = m[0], start = m.index;
      toks.forEach(function (tok) {
        var from = -1, len = 0;
        if (w.indexOf(tok) === 0) { from = start; len = tok.length; }
        else if (tok.length >= 3 && w.indexOf(tok) > 0) { from = start + w.indexOf(tok); len = tok.length; }
        else if (fuzzyToks.indexOf(tok) !== -1 && tok.length >= 5 && fuzzy(tok, w)) { from = start; len = Math.min(w.length, tok.length + 1); }
        for (var k = from; k >= 0 && k < from + len; k++) marks[k] = true;
      });
    }
    // Passage aux indices du titre d'origine.
    var on = new Array(title.length);
    for (var i = 0; i < s.length; i++) if (marks[i]) on[nm.map[i]] = true;
    var buf = '', cur = false;
    function flush() {
      if (!buf) return;
      if (cur) { var mk = document.createElement('mark'); mk.textContent = buf; el.appendChild(mk); }
      else el.appendChild(document.createTextNode(buf));
      buf = '';
    }
    for (var c = 0; c < title.length; c++) {
      var flag = !!on[c];
      if (flag !== cur) { flush(); cur = flag; }
      buf += title[c];
    }
    flush();
  }

  function fmtDate(iso) {
    var p = iso.split('-');
    return p[2] + '.' + p[1] + '.' + p[0];
  }

  function bind(root) {
    if (root.dataset.resBound) return;
    root.dataset.resBound = '1';
    var lang = root.dataset.lang === 'en' ? 'en' : 'fr';
    var t = T[lang];
    var input = root.querySelector('input[type="search"]');
    var status = root.querySelector('[data-res-status]');
    var live = root.querySelector('[data-res-live]');
    var panel = root.querySelector('[data-res-panel]');
    var empty = root.querySelector('[data-res-empty]');
    var listbox = root.querySelector('[data-res-list]');
    var hub = root.closest('.res-index');
    var items = null, failed = false, active = -1, statusTimer = 0;

    root.hidden = false;

    // Le JSON brut est gardé sur window : une seule requête par visite, même après une
    // navigation ClientRouter vers une autre vue du hub.
    function load() {
      if (!window.__waimiaResIndex) {
        window.__waimiaResIndex = fetch(root.dataset.index)
          .then(function (r) { if (!r.ok) throw new Error(String(r.status)); return r.json(); })
          .catch(function (e) { window.__waimiaResIndex = null; throw e; });
      }
      return window.__waimiaResIndex.then(function (data) {
        return data.map(function (d) {
          var title = d['title_' + lang] || d.title_fr;
          var excerpt = d['excerpt_' + lang] || d.excerpt_fr;
          return Object.assign({}, d, {
            _title: title,
            _excerpt: excerpt,
            _t: words(title),
            _tl: words(title).join(' '),
            _k: (d.terms || '').split(' ').filter(Boolean),
            _e: words(excerpt),
            _time: Date.parse(d.date) || 0,
          });
        });
      });
    }

    function say(text, immediate) {
      clearTimeout(statusTimer);
      // Annonce différée : un lecteur d'écran n'énonce pas chaque frappe.
      function write() { status.textContent = text; live.textContent = text; }
      if (immediate) write();
      else statusTimer = setTimeout(write, 250);
    }

    function setActive(i) {
      var opts = listbox.querySelectorAll('[role="option"]');
      if (!opts.length) { active = -1; input.removeAttribute('aria-activedescendant'); return; }
      active = (i + opts.length) % opts.length;
      opts.forEach(function (o, k) { o.setAttribute('aria-selected', k === active ? 'true' : 'false'); });
      input.setAttribute('aria-activedescendant', opts[active].id);
      opts[active].scrollIntoView({ block: 'nearest' });
    }

    function option(it, i, toks, fuzzyToks) {
      var a = document.createElement('a');
      a.className = 'res-hit';
      a.href = it.href;
      a.id = 'res-q-opt-' + i;
      a.setAttribute('role', 'option');
      a.setAttribute('aria-selected', 'false');
      a.tabIndex = -1;
      var media = document.createElement('span');
      media.className = 'res-hit__media';
      if (it.image) {
        var img = document.createElement('img');
        img.src = it.image;
        img.alt = '';
        img.loading = 'lazy';
        img.decoding = 'async';
        if (it.tint != null) img.style.filter = 'hue-rotate(' + it.tint + 'deg)';
        media.appendChild(img);
      }
      var body = document.createElement('span');
      body.className = 'res-hit__body';
      var meta = document.createElement('span');
      meta.className = 'res-hit__meta';
      var tag = document.createElement('span');
      tag.className = 'res-hit__tag';
      tag.textContent = TAGS[lang][it.kind] || it.kind;
      var date = document.createElement('span');
      date.textContent = fmtDate(it.date);
      meta.appendChild(tag);
      meta.appendChild(date);
      var title = document.createElement('span');
      title.className = 'res-hit__title';
      highlight(title, it._title, toks, fuzzyToks);
      var ex = document.createElement('span');
      ex.className = 'res-hit__excerpt';
      ex.textContent = it._excerpt || '';
      body.appendChild(meta);
      body.appendChild(title);
      body.appendChild(ex);
      a.appendChild(media);
      a.appendChild(body);
      return a;
    }

    function close() {
      status.classList.remove('sr-only');
      panel.hidden = true;
      listbox.textContent = '';
      empty.hidden = true;
      active = -1;
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      if (hub) hub.removeAttribute('data-searching');
    }

    function render() {
      var raw = input.value.trim();
      if (!raw) { close(); say('', true); return; }
      if (failed) return;
      if (!items) { say(t.loading, true); return; }
      var toks = queryTokens(raw);
      if (!toks.length) { close(); say('', true); return; }
      var res = search(items, toks);
      var fuzzyToks = toks.filter(function (tok) { return tok.length >= 5 && !known(tok, items); });
      listbox.textContent = '';
      active = -1;
      input.removeAttribute('aria-activedescendant');
      var shown;
      // État vide : le message visible est dans le panneau ; le statut reste pour les
      // lecteurs d'écran seulement (pas de doublon à l'écran).
      status.classList.toggle('sr-only', !res.list.length);
      if (res.list.length) {
        empty.hidden = true;
        shown = res.list.slice(0, MAX).map(function (h) { return h.it; });
        var n = res.list.length;
        say(res.partial ? t.partial(n) : t.count(n) + (n > MAX ? t.best(n) : ''));
      } else {
        // État vide : la requête rappelée, une piste, et les 3 ressources les plus récentes.
        empty.textContent = '';
        var strong = document.createElement('strong');
        strong.textContent = t.none(raw);
        var hint = document.createElement('span');
        hint.className = 'res-search__hint';
        hint.textContent = t.noneHint;
        empty.appendChild(strong);
        empty.appendChild(hint);
        empty.hidden = false;
        shown = items.slice().sort(function (a, b) { return b._time - a._time; }).slice(0, 3);
        say(t.noneStatus(raw));
      }
      shown.forEach(function (it, i) { listbox.appendChild(option(it, i, res.list.length ? toks : [], fuzzyToks)); });
      panel.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      if (hub) hub.setAttribute('data-searching', '');
    }

    function ensure() {
      if (items || failed) return;
      load().then(function (data) { items = data; render(); }, function () {
        failed = true;
        close();
        say(t.error, true);
      });
    }

    input.addEventListener('focus', ensure);
    input.addEventListener('input', function () { ensure(); render(); });
    input.addEventListener('keydown', function (e) {
      var opts = listbox.querySelectorAll('[role="option"]');
      if (e.key === 'ArrowDown' && opts.length) { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp' && opts.length) { e.preventDefault(); setActive(active < 0 ? -1 : active - 1); }
      else if (e.key === 'Enter' && opts.length) {
        e.preventDefault();
        (opts[active >= 0 ? active : 0]).click();
      } else if (e.key === 'Escape') {
        // Motif combobox : un premier appui ferme la liste (la saisie reste), un second vide le champ.
        e.preventDefault();
        if (!panel.hidden) {
          close();
          say('', true);
        } else {
          input.value = '';
          close();
          say('', true);
        }
      }
    });
  }

  function bindAll() {
    document.querySelectorAll('[data-res-search]').forEach(bind);
  }
  bindAll();
  // Navigation ClientRouter entre les vues : le drapeau resBound évite un double branchement.
  document.addEventListener('astro:page-load', bindAll);
})();
</script>

<script is:inline>
// Filtres du hub Ressources en mobile (< 768 px) : bouton « Filtrer » (compte des filtres
// actifs), dépliant en flux avec les deux groupes, ligne d'état en pastilles retirables.
// Source unique de l'état : aria-current des liens de type et aria-pressed des thèmes
// (SiloFilter). Rien n'est recopié : pastilles, compteurs et « Voir N résultats » sont
// recalculés depuis le DOM à chaque changement.
(function () {
  var MQ = '(max-width: 767px)';
  var T = {
    fr: {
      btn: function (n) { return n ? 'Filtrer, ' + n + (n > 1 ? ' filtres actifs' : ' filtre actif') : 'Filtrer'; },
      see: function (n) { return n === 0 ? 'Aucun résultat' : 'Voir ' + n + (n > 1 ? ' résultats' : ' résultat'); },
      results: function (n) { return n + (n > 1 ? ' résultats' : ' résultat'); },
      scope: function (n, types, themes) {
        var s = n + (n > 1 ? ' ressources' : ' ressource');
        if (types > 1) s += ', ' + types + ' types';
        if (themes > 1) s += ', ' + themes + ' thèmes';
        return s;
      },
      remove: function (l) { return 'Retirer le filtre ' + l; },
    },
    en: {
      btn: function (n) { return n ? 'Filter, ' + n + ' active' : 'Filter'; },
      see: function (n) { return n === 0 ? 'No results' : 'Show ' + n + (n > 1 ? ' results' : ' result'); },
      results: function (n) { return n + (n > 1 ? ' results' : ' result'); },
      scope: function (n, types, themes) {
        var s = n + (n > 1 ? ' resources' : ' resource');
        if (types > 1) s += ', ' + types + ' types';
        if (themes > 1) s += ', ' + themes + ' topics';
        return s;
      },
      remove: function (l) { return 'Remove filter ' + l; },
    },
  };

  // Libellé d'une option sans son compteur.
  function labelOf(el) {
    var c = el.cloneNode(true);
    c.querySelectorAll('.res-chip-n, .silo-chip-n').forEach(function (n) { n.remove(); });
    return c.textContent.replace(/\s+/g, ' ').trim();
  }

  function bind(root) {
    if (root.dataset.facetsBound) return;
    var hub = root.closest('.res-index');
    var btn = hub && hub.querySelector('[data-res-filter-btn]');
    var panel = root.querySelector('#res-facets-panel');
    if (!btn || !panel) return;
    root.dataset.facetsBound = '1';
    root.setAttribute('data-ready', '');

    var t = T[root.dataset.lang === 'en' ? 'en' : 'fr'];
    var badge = btn.querySelector('[data-res-filter-n]');
    var title = panel.querySelector('.res-facets__title');
    var active = root.querySelector('[data-res-active]');
    var applyBtn = root.querySelector('[data-res-apply]');
    var applyLabel = applyBtn.querySelector('.btn-label') || applyBtn;
    var resetBtn = root.querySelector('[data-res-reset]');
    var live = hub.querySelector('[data-res-live]');
    var allType = panel.querySelector('[data-type-key="all"]');
    var mq = window.matchMedia(MQ);
    var types = Number(root.dataset.types) || 0;

    btn.hidden = false;

    function silo() { return root.querySelector('[data-silo-filter]:not([hidden])'); }
    function typeActive() {
      var a = panel.querySelector('.res-filters [aria-current="page"]');
      return a && a.getAttribute('data-type-key') !== 'all' ? a : null;
    }
    function themeActive() {
      var s = silo();
      return s ? s.querySelector('[data-silo-key][aria-pressed="true"]:not([data-silo-key=""])') : null;
    }
    function shownCount() {
      var n = 0;
      hub.querySelectorAll('.res-list .article-card').forEach(function (c) { if (!c.hidden) n++; });
      return n;
    }
    function resetTheme() {
      var s = silo();
      var all = s && s.querySelector('[data-silo-key=""]');
      if (all && all.getAttribute('aria-pressed') !== 'true') all.click();
    }

    function pill(tag, label) {
      var el = document.createElement(tag);
      el.className = 'res-pill';
      el.setAttribute('aria-label', t.remove(label));
      var txt = document.createElement('span');
      txt.textContent = label;
      var x = document.createElement('span');
      x.className = 'res-pill__x';
      x.setAttribute('aria-hidden', 'true');
      x.textContent = '×';
      el.appendChild(txt);
      el.appendChild(x);
      return el;
    }

    function sync() {
      var ty = typeActive(), th = themeActive();
      var count = (ty ? 1 : 0) + (th ? 1 : 0);
      var n = shownCount();
      badge.textContent = String(count);
      badge.hidden = !count;
      btn.setAttribute('aria-label', t.btn(count));
      applyLabel.textContent = t.see(n);
      resetBtn.disabled = !count;

      active.textContent = '';
      if (ty && allType) {
        // Retirer le type = revenir à la vue de toutes les ressources (vrai lien).
        var a = pill('a', labelOf(ty));
        a.href = allType.getAttribute('href');
        active.appendChild(a);
      }
      if (th) {
        var b = pill('button', labelOf(th));
        b.type = 'button';
        b.addEventListener('click', function () { resetTheme(); btn.focus(); });
        active.appendChild(b);
      }
      var sum = document.createElement('p');
      sum.className = 'res-active__sum';
      var s = silo();
      var themes = s ? s.querySelectorAll('[data-silo-key]:not([data-silo-key=""])').length : 0;
      sum.textContent = count ? t.results(n) : t.scope(n, types, themes);
      active.appendChild(sum);
      active.hidden = false;
    }

    function open() {
      root.setAttribute('data-open', '');
      btn.setAttribute('aria-expanded', 'true');
      sync();
      title.focus();
    }
    function close(giveFocusBack) {
      if (!root.hasAttribute('data-open')) return;
      root.removeAttribute('data-open');
      btn.setAttribute('aria-expanded', 'false');
      if (giveFocusBack) btn.focus();
    }

    btn.addEventListener('click', function () {
      if (root.hasAttribute('data-open')) close(true); else open();
    });
    applyBtn.addEventListener('click', function () { close(true); });
    resetBtn.addEventListener('click', function () {
      if (typeActive() && allType) { allType.click(); return; }
      resetTheme();
    });
    function onEsc(e) {
      if (e.key !== 'Escape' || !root.hasAttribute('data-open')) return;
      e.preventDefault();
      close(true);
    }
    panel.addEventListener('keydown', onEsc);
    btn.addEventListener('keydown', onEsc);
    // SiloFilter annonce chaque changement de thème (y compris ?silo= au chargement).
    root.addEventListener('silo-filter:change', function () {
      sync();
      if (live && mq.matches) live.textContent = t.results(shownCount());
    });
    // Passage en desktop : le bloc redevient à plat, le panneau n'a plus lieu d'être ouvert.
    var onMq = function () { if (!mq.matches) close(false); };
    if (mq.addEventListener) mq.addEventListener('change', onMq); else mq.addListener(onMq);

    sync();
    // SiloFilter se révèle au DOMContentLoaded (après ce script) : recompter les thèmes.
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', sync);
  }

  function bindAll() { document.querySelectorAll('[data-res-facets]').forEach(bind); }
  bindAll();
  if (!window.__resFacetsBound) {
    window.__resFacetsBound = true;
    document.addEventListener('astro:page-load', bindAll);
  }
})();
</script>
