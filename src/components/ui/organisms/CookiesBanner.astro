---
import { langFromPath } from '../../../lib/i18n';

interface Props {
  lang?: 'fr' | 'en';
}
const { lang: propLang } = Astro.props;
const lang = propLang ?? langFromPath(Astro.url.pathname);
---

<div
  id="cookies-banner"
  class="cb"
  role="region"
  aria-label={lang === 'fr' ? 'Gestion des cookies' : 'Cookie consent'}
  hidden
>
  <div class="cb-inner wrap">
    <p class="cb-text">
      <span class="cb-text-long">
        {lang === 'fr'
          ? "Ce site utilise uniquement des cookies essentiels à son fonctionnement et à vos préférences. Aucune donnée personnelle identifiable n'est collectée."
          : 'This site only uses cookies essential to its operation and to your preferences. No personally identifiable data is collected.'}
      </span>
      <span class="cb-text-short">{lang === 'fr' ? 'Cookies essentiels uniquement.' : 'Essential cookies only.'}</span>
    </p>
    <div class="cb-actions">
      <button id="cb-accept" class="cb-btn cb-btn--primary">
        {lang === 'fr' ? 'Accepter' : 'Accept'}
      </button>
      <button id="cb-reject" class="cb-btn cb-btn--secondary">
        {lang === 'fr' ? 'Refuser' : 'Decline'}
      </button>
    </div>
  </div>
</div>

<style>
  .cb {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 80;
    background: var(--paper-2);
    border-top: 1px solid var(--hairline);
    padding: var(--space-3) 0;
  }
  .cb-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .cb-text {
    font-size: var(--text-small);
    color: var(--ink-2);
    line-height: var(--leading-relaxed);
    max-width: 680px;
    margin: 0;
    text-wrap: pretty;
  }
  .cb-actions {
    display: flex;
    gap: var(--space-2);
    flex-shrink: 0;
    flex-wrap: wrap;
  }
  .cb-btn {
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    border-radius: var(--radius-xs);
    cursor: pointer;
    border: 1px solid var(--hairline-strong);
    transition: color var(--dur-fast) ease, border-color var(--dur-fast) ease, background var(--dur-fast) ease;
    font-weight: var(--fw-medium);
    background: transparent;
    color: var(--ink-2);
  }
  .cb-btn--primary {
    border-color: var(--ink);
    color: var(--ink);
  }
  .cb-btn--primary:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .cb-btn--secondary:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .cb-text-short { display: none; }
  /* Mobile · barre compacte sur une rangée : texte court à gauche, boutons à
     droite. Couleurs, polices, bordure et casse d'origine ; seules la densité et
     la longueur du texte changent (le texte complet reste au-delà de 600 px). */
  @media (max-width: 600px) {
    .cb { padding: var(--space-2) 0; }
    .cb-inner { flex-wrap: nowrap; gap: var(--space-3); }
    .cb-text { line-height: var(--leading-body); }
    .cb-text-long { display: none; }
    .cb-text-short { display: inline; }
    .cb-actions { flex-wrap: nowrap; }
    .cb-btn { flex: none; padding: var(--space-2) var(--space-3); text-align: center; }
  }
</style>

<script is:inline>
(function () {
  var KEY = 'waimia_cookies_consent';

  // Pilote --cookie-banner-height via data-attribute sur <html> · cf tokens.css
  // → permet aux sections (hero, CTA final) de réserver l'espace bas dynamiquement.
  // Bannière visible : la hauteur RÉELLE mesurée surcharge la valeur forfaitaire
  // des tokens (78/124 px) et suit ses changements (largeur, polices chargées) ;
  // fermée : la propriété est retirée et l'observateur déconnecté.
  var observer = null;
  var last = null;

  function isVisible(banner) {
    return !!banner && !banner.hidden &&
      document.documentElement.hasAttribute('data-cookie-visible');
  }

  function measure() {
    var banner = document.getElementById('cookies-banner');
    if (!isVisible(banner)) return;
    var h = Math.round(banner.getBoundingClientRect().height);
    if (!h || h === last) return;
    last = h;
    document.documentElement.style.setProperty('--cookie-banner-height', h + 'px');
  }

  function setVisible(visible) {
    var root = document.documentElement;
    var banner = document.getElementById('cookies-banner');
    if (observer) observer.disconnect();
    if (visible && banner) {
      root.setAttribute('data-cookie-visible', 'true');
      last = null;
      measure();
      if ('ResizeObserver' in window) {
        if (!observer) observer = new ResizeObserver(measure);
        observer.observe(banner);
      }
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
    } else {
      root.removeAttribute('data-cookie-visible');
      root.style.removeProperty('--cookie-banner-height');
      last = null;
    }
  }

  function initBanner() {
    var stored = localStorage.getItem(KEY);
    var banner = document.getElementById('cookies-banner');
    if (!stored && banner) {
      banner.removeAttribute('hidden');
      setVisible(true);
    } else {
      setVisible(false);
    }

    var btnAccept = document.getElementById('cb-accept');
    var btnReject = document.getElementById('cb-reject');

    if (btnAccept && !btnAccept.dataset.cbBound) {
      btnAccept.dataset.cbBound = '1';
      btnAccept.addEventListener('click', function () {
        localStorage.setItem(KEY, 'accepted');
        var b = document.getElementById('cookies-banner');
        if (b) b.setAttribute('hidden', '');
        setVisible(false);
      });
    }
    if (btnReject && !btnReject.dataset.cbBound) {
      btnReject.dataset.cbBound = '1';
      btnReject.addEventListener('click', function () {
        localStorage.setItem(KEY, 'rejected');
        var b = document.getElementById('cookies-banner');
        if (b) b.setAttribute('hidden', '');
        setVisible(false);
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBanner);
  } else {
    initBanner();
  }
  document.addEventListener('astro:page-load', initBanner);
})();
</script>
