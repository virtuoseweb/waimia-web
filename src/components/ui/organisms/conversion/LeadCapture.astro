---
import FormGuard from '../../atoms/FormGuard.astro';
// Organism · LeadCapture · capture d'e-mail d'une ressource (hors catalogue).
//
// Deux modes. Par défaut (diagnostic, calculateur, grille) : le résultat de la page reste visible
// sans e-mail ; ce bloc en envoie la version à garder (récapitulatif, lien de retour).
// `required` (checklist, charte, PDF verrouillés) : e-mail OBLIGATOIRE pour obtenir le fichier,
// livré en pièce jointe et jamais par un lien public. POST JSON vers /api/lead-magnet
// { email, slug, summary?, headline? }.
//
// `bare` : formulaire seul (ni cadre, ni titre, ni description), bouton primaire et mention
// RGPD courte. Utilisé par la section catalogue `lead-capture-band`, qui porte le titre, la
// liste de ce que l'e-mail apporte et l'aperçu ; `describedBy` pointe vers son accroche.
//
// Récupération des résultats de la page : avant l'envoi, le composant émet l'événement
// `cv:collect` (bubbles) avec `detail = { slug, summary: [], headline: '' }`. L'outil de
// la page (diagnostic, calculateur, grille) remplit `detail.summary` (lignes
// { label, value }) et `detail.headline`. Aucun couplage direct entre composants.
//
// États : vide · erreur de saisie (message sous le champ) · envoi (bouton désactivé) ·
// succès (le formulaire est remplacé par la confirmation, focus déplacé) · échec serveur
// (dont 503 `email_not_configured` : on affiche que l'envoi est indisponible, jamais un
// faux succès).
import './form.css';
import type { LeadMagnetSlug } from '../../../../data/conversion';
import { SITE } from '../../../../site.config';

interface Props {
  slug: LeadMagnetSlug;
  /** Titre court du bloc. */
  title?: string;
  /** Ce que contient l'e-mail, en une phrase. */
  description?: string;
  buttonLabel?: string;
  /** Rend le bloc masqué (attribut hidden) : la page l'affiche quand un résultat existe. */
  initiallyHidden?: boolean;
  /** Rend le bloc dans sa propre bande pleine largeur (pages outil). */
  band?: boolean;
  /** Fichier verrouillé : e-mail obligatoire, livraison en pièce jointe (retire « facultatif »). */
  required?: boolean;
  /** Id d'ancre de la bande (lien « Recevoir le PDF » depuis le document). */
  anchorId?: string;
  /** Formulaire seul, sans cadre ni texte d'en-tête (section `lead-capture-band`). */
  bare?: boolean;
  /** Id de l'élément qui décrit le formulaire quand `bare` (accroche de la section). */
  describedBy?: string;
}
const {
  slug,
  title = 'Recevoir une copie par e-mail',
  description = '',
  buttonLabel = 'Envoyer la copie',
  initiallyHidden = false,
  band = false,
  required = false,
  anchorId,
  bare = false,
  describedBy,
} = Astro.props as Props;
const fid = `lc-${slug}`;
const descId = bare ? describedBy : `${fid}-desc`;
---
<div id={anchorId} class:list={[band && 'lc-band']}><div class:list={[band && 'wrap-wide']}>
<div class:list={['lc', bare && 'lc--bare']} data-lead-capture data-slug={slug} data-required={required ? '1' : undefined} hidden={initiallyHidden}>
  <form class="lc-form" method="POST" action="/api/lead-magnet" novalidate data-lead-form>
    {!bare && (
      <div class="lc-text">
        <p class="lc-title">{title}</p>
        <p class="cv-note" id={`${fid}-desc`}>{description}</p>
      </div>
    )}
    <div class="lc-row">
      <FormGuard />
      <input type="hidden" name="slug" value={slug} />
      <div class="cv-field lc-field">
        <label class="cv-label" for={`${fid}-email`}>Votre e-mail</label>
        <input class="cv-input" id={`${fid}-email`} name="email" type="email" autocomplete="email" inputmode="email" required placeholder="prenom@entreprise.fr" aria-describedby={[descId, `${fid}-err`].filter(Boolean).join(' ')} />
      </div>
      <button class:list={['btn', bare ? 'btn-primary' : 'btn-ghost', 'cv-btn', 'lc-btn']} type="submit" data-label={buttonLabel} data-label-busy="Envoi en cours…">{buttonLabel}</button>
    </div>
    <p class="cv-error" id={`${fid}-err`} data-lead-error hidden></p>
    <label class="lc-optin">
      <input type="checkbox" name="newsletter" />
      <span>Recevoir aussi la lettre mensuelle de Waimia (un envoi par mois, désinscription en un clic).</span>
    </label>
    {bare ? (
      <p class="cv-note lc-legal">Sans cette case : un seul e-mail, aucune liste. Responsable : Waimia (VirtuoseWeb). <a href="/politique-confidentialite">Confidentialité</a>.</p>
    ) : (
      <p class="cv-note lc-legal">{required ? "Le fichier est envoyé en pièce jointe, uniquement par e-mail : il n'existe pas de lien de téléchargement public. " : ''}Sans cette case, vous recevez un seul e-mail et votre adresse n'est ajoutée à aucune liste. Responsable du traitement : Waimia (VirtuoseWeb), pour vous envoyer ce que vous demandez. <a href="/politique-confidentialite">Confidentialité</a>.</p>
    )}
  </form>
  <p class="cv-status" data-kind="success" data-lead-success tabindex="-1" hidden></p>
</div>
</div></div>

<script is:inline define:vars={{ fallbackEmail: SITE.email }}>
(function () {
  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function bind(root) {
    if (root.dataset.bound) return;
    root.dataset.bound = '1';
    var form = root.querySelector('[data-lead-form]');
    var input = form.querySelector('input[name="email"]');
    var err = root.querySelector('[data-lead-error]');
    var ok = root.querySelector('[data-lead-success]');
    var btn = form.querySelector('button[type="submit"]');

    function fail(msg) {
      err.innerHTML = msg;
      err.hidden = false;
      input.setAttribute('aria-invalid', 'true');
    }
    function clear() {
      err.hidden = true;
      input.setAttribute('aria-invalid', 'false');
    }
    function busy(on) {
      btn.disabled = on;
      btn.textContent = on ? btn.dataset.labelBusy : btn.dataset.label;
    }
    input.addEventListener('input', function () { if (!err.hidden) clear(); });

    // Succès d'un outil : rapport PDF envoyé par e-mail ET téléchargeable tout de suite
    // (octets renvoyés en base64 par l'API, aucun stockage côté serveur).
    function showReport(email, data) {
      var pdf = data.pdf;
      ok.textContent = pdf
        ? 'Votre rapport complet est envoyé à ' + email + ', en pièce jointe. Vous pouvez aussi le télécharger tout de suite. Si l\'e-mail n\'arrive pas d\'ici quelques minutes, regardez dans les indésirables.'
        : 'Votre résultat est envoyé à ' + email + '. Le rapport PDF n\'a pas pu être généré cette fois : nous vous l\'envoyons à la main dans la journée.';
      ok.hidden = false;
      if (pdf && pdf.base64) {
        var wrap = document.createElement('p');
        wrap.className = 'lc-pdf';
        var dl = document.createElement('button');
        dl.type = 'button';
        dl.className = 'btn btn-primary cv-btn';
        dl.setAttribute('data-lead-pdf', '');
        dl.textContent = 'Télécharger mon rapport (PDF)';
        dl.addEventListener('click', function () {
          var bin = atob(pdf.base64);
          var bytes = new Uint8Array(bin.length);
          for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
          var url = URL.createObjectURL(new Blob([bytes], { type: 'application/pdf' }));
          var a = document.createElement('a');
          a.href = url;
          a.download = pdf.filename || 'rapport-waimia.pdf';
          document.body.appendChild(a);
          a.click();
          a.remove();
          setTimeout(function () { URL.revokeObjectURL(url); }, 4000);
        });
        wrap.appendChild(dl);
        ok.insertAdjacentElement('afterend', wrap);
      }
      ok.focus();
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      clear();
      var email = input.value.trim();
      if (!email) { fail(root.dataset.required ? 'Saisissez votre adresse e-mail : le fichier n\'est envoyé que par e-mail.' : 'Saisissez votre adresse e-mail pour recevoir votre résultat.'); input.focus(); return; }
      if (!EMAIL_RE.test(email)) { fail('Cette adresse e-mail n\'est pas valide. Exemple : prenom@entreprise.fr'); input.focus(); return; }

      // L'outil de la page remplit `summary`, `headline` et, pour le diagnostic et le calculateur,
      // `result` (réponses BRUTES, recalculées par le serveur pour le rapport PDF). Il peut aussi
      // poser `error` (saisie hors limites) : rien n'est envoyé.
      var detail = { slug: root.dataset.slug, summary: [], headline: '', result: undefined, error: '' };
      root.dispatchEvent(new CustomEvent('cv:collect', { bubbles: true, detail: detail }));
      if (detail.error) { fail(detail.error); return; }

      busy(true);
      var mail = '<a href="mailto:' + fallbackEmail + '">' + fallbackEmail + '</a>';
      try {
        var res = await fetch('/api/lead-magnet', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: email,
            slug: detail.slug,
            summary: detail.summary.slice(0, 40),
            headline: detail.headline || undefined,
            newsletter: form.elements.newsletter.checked,
            website: form.elements.website.value,
            _t: form.elements._t ? form.elements._t.value : '',
            lang: 'fr',
            result: detail.result,
          }),
        });
        var data = await res.json().catch(function () { return {}; });
        if (res.ok && data.ok) {
          form.hidden = true;
          if (detail.result) { showReport(email, data); return; }
          ok.textContent = root.dataset.required
            ? 'C\'est parti : le fichier arrive en pièce jointe à ' + email + '. Pensez à vérifier vos courriers indésirables si rien n\'arrive d\'ici quelques minutes.'
            : 'C\'est envoyé à ' + email + '. Si rien n\'arrive d\'ici quelques minutes, regardez dans les indésirables.';
          ok.hidden = false;
          ok.focus();
          return;
        }
        if (data.code === 'invalid_result' || data.code === 'result_mismatch') fail('Vos réponses n\'ont pas pu être prises en compte (une valeur manque ou sort des limites). Vérifiez le formulaire, puis réessayez.');
        else if (data.code === 'invalid_email') fail('Cette adresse e-mail n\'est pas valide. Exemple : prenom@entreprise.fr');
        else if (res.status === 429) fail('Trop de demandes en peu de temps. Réessayez dans quelques minutes.');
        else if (data.code === 'resource_unavailable') fail('Ce fichier est momentanément indisponible. Écrivez à ' + mail + ', nous vous l\'envoyons.');
        else if (data.code === 'email_not_configured') fail(root.dataset.required
          ? 'L\'envoi par e-mail est indisponible pour le moment : rien n\'a été envoyé. Écrivez à ' + mail + ', nous vous envoyons le fichier.'
          : 'L\'envoi par e-mail est indisponible pour le moment : rien n\'a été envoyé. Votre résultat reste affiché sur cette page, ou écrivez à ' + mail + '.');
        else fail('L\'e-mail n\'est pas parti (erreur ' + res.status + '). Réessayez, ou écrivez à ' + mail + '.');
        busy(false);
      } catch (_) {
        fail('Connexion interrompue : rien n\'a été envoyé. Réessayez.');
        busy(false);
      }
    });
  }
  function boot() { document.querySelectorAll('[data-lead-capture]').forEach(bind); }
  boot();
  document.addEventListener('astro:page-load', boot);
})();
</script>

<style>
  .lc {
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-sm);
    padding: var(--space-5);
    background: var(--paper);
  }
  .lc[hidden] { display: none; }
  .lc-band { padding: var(--space-8) 0; }
  .lc--bare { border: 0; border-radius: 0; padding: 0; background: transparent; }
  .lc--bare .lc-form { grid-template-columns: minmax(0, 1fr); gap: var(--space-3); }
  .lc-form { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: var(--space-4) var(--space-6); align-items: end; }
  .lc-form[hidden] { display: none; }
  .lc-title { margin: 0 0 var(--space-1); font-size: var(--text-body); font-weight: var(--fw-semibold); }
  .lc-row { display: flex; gap: var(--space-3); align-items: flex-end; position: relative; }
  .lc-field { flex: 1; }
  .lc-btn { white-space: nowrap; padding-top: 13px; padding-bottom: 13px; }
  .lc .cv-error, .lc-legal, .lc-optin { grid-column: 1 / -1; }
  .lc-optin { display: flex; align-items: flex-start; gap: var(--space-2); font-size: var(--text-small); line-height: var(--leading-body); color: var(--ink); cursor: pointer; }
  .lc-optin input { margin: 3px 0 0; accent-color: var(--ink); width: 15px; height: 15px; flex-shrink: 0; }
  /* Bouton de téléchargement du rapport : créé par le script après l'envoi, donc :global. */
  :global(.lc-pdf) { margin: var(--space-4) 0 0; }
  .lc-optin input:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 2px; }
  @media (max-width: 760px) {
    .lc-form { grid-template-columns: 1fr; }
    .lc-row { flex-direction: column; align-items: stretch; }
    .lc-btn { justify-content: center; }
  }
</style>
