---
/**
 * @home-only
 * Section · Hero · business-first PME/ETI · FR/EN
 *
 * ⚠️ ORGANISM RÉSERVÉ HOME : NE PAS utiliser hors `/` et `/en/`.
 * Pour autres pages, préférer les sections W6 :
 * - HeroSplit (défaut Tier 1 canonique · grille 58/42)
 * - HeroCentered (Tier 2 standalone centré)
 * - HeroFullBleed (Tier 2 signature impact)
 * Source : docs/34-AMBIGUS-VERDICTS-OPUS.md§5 + docs/28-DESIGN-SYSTEM-CONTRACT.md§1
 *
 * M4 recadre la home : promesse lisible en 5 secondes, CTA vers l'audit IA PME
 * et le calculateur de ROI, engagements factuels (aucun nombre sans source).
 */

import { langFromPath, localizeHref } from '../../../lib/i18n';
import { AUDIT_BOOKING_HREF, AUDIT_PAGE_HREF, AUDIT_PROMISE } from '../../../data/conversion';

import MastheadRow from '../molecules/MastheadRow.astro';
import Kicker from '../atoms/Kicker.astro';
import Button from '../atoms/Button.astro';

const lang = langFromPath(Astro.url.pathname);
// Prise de rendez-vous : URL unique (la page contact porte le calendrier). /audit-ia-pme présente l'audit.
const ctaHref = AUDIT_BOOKING_HREF;
const auditHref = localizeHref(AUDIT_PAGE_HREF, lang);
// Promesse canonique de l'audit (source unique : data/conversion.ts, décision du 14 octobre 2026).
const auditPromise = AUDIT_PROMISE.general.short[lang === 'fr' ? 'fr' : 'en'];
const fr = lang === 'fr';
// L'offre dans son ordre : (1) automatisation et agents IA, (2) applications métier, (3) conseil et formation.
// Les sites web sont un métier du studio (décision du 14 octobre 2026) : ligne `.hero-support`.
const offers = [
  {
    name: fr ? 'Automatisation et agents IA' : 'Automation and AI agents',
    desc: fr ? 'Workflows n8n et Make, agents sur Claude et OpenAI, branchés à vos outils.' : 'n8n and Make workflows, agents on Claude and OpenAI, connected to your tools.',
    href: localizeHref('/services/systemes-operationnels-ia', lang),
  },
  {
    name: fr ? 'Applications métier' : 'Business applications',
    desc: fr ? "L'outil sur mesure que le tableur ne remplace plus. Vous gardez le code." : 'The custom tool the spreadsheet no longer replaces. You keep the code.',
    href: localizeHref('/services/applications-internes', lang),
  },
  {
    name: fr ? 'Conseil et formation' : 'Advisory and training',
    desc: fr ? 'Audit, feuille de route, formation des équipes à l\'IA et à l\'automatisation.' : 'Audit, roadmap, team training in AI and automation.',
    href: localizeHref('/services/consultant-ia-claude', lang),
  },
];
const facts = [
  { label: fr ? 'Pour qui' : 'For whom', items: fr ? 'PME et ETI · 10 à 250 pers.' : 'SMEs · 10 to 250 people' },
  { label: fr ? 'Méthode' : 'Method', items: fr ? 'Audit · pilote · mesure · transfert' : 'Audit · pilot · measure · handover' },
  { label: fr ? 'Propriété' : 'Ownership', items: fr ? 'Code et workflows transférés' : 'Code and workflows handed over' },
  { label: fr ? 'Contrôle' : 'Control', items: fr ? 'Validation humaine des actions sensibles' : 'Human validation of sensitive actions' },
  { label: fr ? 'Conformité' : 'Compliance', items: fr ? 'RGPD et AI Act dès la conception' : 'GDPR and AI Act by design' },
  { label: fr ? 'Studio solo' : 'Solo studio', items: fr ? 'Simon Beros · Bordeaux, à distance' : 'Simon Beros · Bordeaux, remote' },
];
const offerHref = localizeHref('/ressources/outils/calculateur-roi-ia', lang);
const pageTransitionId = Astro.url.pathname
  .replace(/^\/(?:en\/)?/, '')
  .replace(/\/$/, '')
  .replace(/[^a-z0-9]+/gi, '-')
  .replace(/^-|-$/g, '') || 'home';

// V7 · MetricStrip extrait dans nouveau organism ProofBar dédié (entre Hero et CapabilityStrip)
---
<section class="hero-a home-hero" aria-labelledby="hero-heading">
  <div class="signature-grid" transition:name={`hero-img-${pageTransitionId}`}></div>

  <div class="wrap-wide">
    {/* Masthead newspaper · atome MastheadRow · margin compactée V6 (24px vs 48px) */}
    <div class="par hero-masthead" data-par="-0.04">
      <MastheadRow breadcrumb={[{ label: lang === 'fr' ? 'Accueil' : 'Home' }]} />
    </div>

    {/* Headline · dit le métier en une phrase (refonte positionnement 2026-10) · signature
        typographique conservée : serif display, italiques, un accent terracotta. */}
    <h1 id="hero-heading" class="hero-headline reveal-mask-up" transition:name={`hero-h1-${pageTransitionId}`}>
      {lang === 'fr' ? (
        <>
          Studio de développement <i>IA</i><br />
          et cabinet d'<i class="acc">automatisation</i> pour PME.
        </>
      ) : (
        <>
          AI development studio<br />
          and <i class="acc">automation</i> practice for SMEs.
        </>
      )}
    </h1>

    {/* Sub-block · 2 colonnes · promesse + l'offre dans son ordre */}
    <div class="hero-sub">
      <div>
        <Kicker class="hero-fig">§ 01 · {lang === 'fr' ? 'Le métier' : 'What we do'}</Kicker>
        <p class="hero-lede reveal reveal-fade">
          {lang === 'fr' ? (
            <>Waimia, agence IA, audite vos processus, puis construit et met en production les automatisations, agents IA et applications métier qui les font tourner. Un ingénieur travaille avec vos équipes, sur vos outils.</>
          ) : (
            <>Waimia, an AI agency, audits your processes, then builds and ships to production the automations, AI agents and business applications that run them. One engineer works with your teams, on your tools.</>
          )}
        </p>

        {/* Mini-map · 6 faits d'engagement (cartographie 3×2). Chaque cellule est vérifiable. */}
        <ul class="hero-minimap reveal reveal-fade" aria-label={lang === 'fr' ? 'Cadre de travail' : 'How we work'}>
          {facts.map((f) => (
            <li class="hero-mm-item">
              <span class="hero-mm-label">{f.label}</span>
              <span class="hero-mm-items">{f.items}</span>
            </li>
          ))}
        </ul>

        <div class="hero-ctas reveal reveal-snap">
          <Button href={ctaHref} variant="primary" size="lg" mag={0.18}>
            {lang === 'fr' ? 'Réserver un audit →' : 'Book an audit →'}
          </Button>
          <Button href={offerHref} variant="ghost" size="lg">
            {lang === 'fr' ? 'Calculer mon ROI' : 'Calculate my ROI'}
          </Button>
        </div>
        <p class="hero-cta-sub">
          {lang === 'fr'
            ? <>{auditPromise}{' '}<a href={auditHref}>En savoir plus sur l'audit</a></>
            : <>{auditPromise}{' '}<a href={auditHref}>More about the audit</a></>}
        </p>
      </div>

      <div>
        <Kicker class="hero-fig">§ 02 · {lang === 'fr' ? "Ce qu'on construit" : 'What we build'}</Kicker>

        {/* L'offre dans son ordre (pas une séquence : aucun numéro). Trois lignes cœur, puis
            les sites web et les outils commerciaux sur une ligne discrète. */}
        <ul class="hero-offers reveal reveal-fade">
          {offers.map((o) => (
            <li class="hero-offer">
              <a href={o.href} class="hero-offer-link">
                <span class="hero-offer-name">{o.name}</span>
                <span class="hero-offer-desc">{o.desc}</span>
                <span class="hero-offer-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="hero-support">
          {lang === 'fr' ? 'Le studio fait aussi des ' : 'The studio also builds '}
          <a href={localizeHref('/services/site-web-ia', lang)}>{lang === 'fr' ? 'sites web' : 'websites'}</a>{lang === 'fr' ? ' et des ' : ' and '}<a href={localizeHref('/services/systeme-commercial', lang)}>{lang === 'fr' ? 'outils commerciaux' : 'sales tools'}</a>.
        </p>
      </div>
    </div>
  </div>
</section>

{/* V7 · MetricStrip retiré du Hero · les metrics vivent désormais dans
   <ProofBar /> dédié monté juste après dans index.astro */}

<style>
  .hero-a {
    position: relative;
    /* Sticky-aware · header fixed 79px + respiration éditoriale densifiée
       (V6 brief Simon : faire passer plus de contenu dans la section) */
    /* Le header fixed mesure ~79px au top : le padding DOIT l'inclure sinon le
       masthead (Accueil · FR) passe sous la barre (rogné mobile, vu 2026-07-13) */
    padding: calc(var(--header-height) + var(--space-6)) 0 0;
    border-bottom: 1px solid var(--hairline);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .hero-a > *:not(.signature-grid):not(.hero-sig-mark) { position: relative; z-index: 1; }
  .hero-a .signature-grid { z-index: 0; }

  /* Wrapper hero · max-width hard cap pour grands écrans · contrainte de
     lisibilité éditoriale (V6 : éviter casse design sur ultra-wide) */
  .hero-a .wrap-wide {
    max-width: var(--wrap-wide);
    margin-inline: auto;
  }

  /* SVG signature v9 · wrapper div (scope Astro propre) · overlay décoratif */
  .hero-sig-mark {
    position: absolute;
    right: calc(var(--gut) * 2);
    top: calc(var(--section-loose) * 0.55);
    width: 88px;
    height: 88px;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    color: var(--ink);
    opacity: 0.18;
  }
  .hero-sig-mark svg { width: 100%; height: 100%; display: block; }

  /* H1 · token sémantique unifié --text-h1-hero · cf tokens.css */
  .hero-headline {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    line-height: var(--leading-h1, .96);
    letter-spacing: var(--tracking-display, -0.025em);
    font-weight: var(--fw-regular);
    max-width: 1240px;
    margin: 0 0 var(--space-5);
  }
  .hero-headline i { font-style: italic; }
  .hero-headline i.acc { color: var(--accent-text); }

  /* V7 Swiss grid · espace symétrique masthead/H1/sub-block (resserré 32/32/32 pour above-fold) */
  .hero-masthead { margin-bottom: var(--space-6); }

  .hero-sub {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: var(--space-10);
    margin-top: var(--space-6);
    padding: var(--space-6) 0 var(--space-6);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    align-items: stretch;
  }
  /* V7 · les 2 cols hero-sub deviennent flex column pour égaliser leur hauteur
     et permettre l'alignement top/bottom mathématique du contenu interne */
  .hero-sub > div {
    display: flex;
    flex-direction: column;
  }
  .hero-fig { margin-bottom: var(--space-4); }

  /* Lede · Inter Tight (pas Serif) · reveal-fade delay var(--dur-fast) */
  .hero-lede {
    font-family: var(--font-sans);
    font-size: var(--text-lede, clamp(20px, 1.7vw, 24px));
    line-height: var(--leading-body, 1.5);
    color: var(--ink-2);
    max-width: 520px;
    text-wrap: pretty;
    transition-delay: var(--dur-fast);
  }

  /* V7 §12 · Mini-map scope · cartographie 3×2 éditoriale (vs strip linéaire)
     · 6 territoires en grid 3 colonnes desktop · 2 cols tablet · stack mobile
     · chaque territoire : label mono caps + items inline serif italic petit */
  .hero-minimap {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--hairline);
    transition-delay: var(--dur-hover);
  }
  .hero-mm-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-3) var(--space-3) 0;
    border-bottom: 1px solid var(--hairline);
    border-right: 1px solid var(--hairline);
  }
  .hero-mm-item:nth-child(3n) { border-right: none; }
  .hero-mm-item:nth-last-child(-n+3) { border-bottom: none; }
  .hero-mm-item:not(:nth-child(3n+1)) { padding-left: var(--space-3); }

  .hero-mm-label {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .hero-mm-items {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-lede);
    color: var(--ink-2);
  }

  @media (max-width: 700px) {
    /* Mobile : la mini-map des 6 territoires est masquée (demande Simon 2026-07-13,
       le hero mobile va droit à la promesse puis aux proofs) */
    .hero-minimap { display: none; }
  }

  /* CTAs · mobile : pleine largeur empilés (vs wrap bancal des 2 boutons lg) */
  @media (max-width: 560px) {
    .hero-ctas { flex-direction: column; align-items: stretch; gap: var(--space-3); }
    .hero-ctas :global(.btn) { width: 100%; justify-content: center; }
  }

  /* CTAs · reveal-snap delay 400ms */
  .hero-ctas {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-5);
    transition-delay: var(--dur-base);
  }

  /* Sub-CTA · Swiss grid · margin-top auto via flex parent pour push en bas
     du col gauche · padding-top space-5 garantit espace min entre CTAs et sub-CTA
     · résultat : col gauche et col droite finissent au même Y (mathématique) */
  .hero-cta-sub {
    margin-top: auto;
    padding-top: var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--ink-2);
    letter-spacing: 0.005em;
    transition-delay: var(--dur-panel);
  }

  /* Colonne droite · l'offre en trois lignes (titre serif + descriptif), hairline entre.
     Pas de numéro : ce n'est pas une séquence. Toute la ligne est le lien. */
  .hero-offers {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    flex: 1;
    transition-delay: var(--dur-hover);
  }
  .hero-offer { border-bottom: 1px solid var(--hairline); flex: 1; display: flex; }
  .hero-offer:first-child { border-top: 1px solid var(--hairline); }
  .hero-offer-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-5);
    row-gap: var(--space-1);
    align-content: center;
    width: 100%;
    padding: var(--space-4) 0;
    color: inherit;
    text-decoration: none;
  }
  .hero-offer-name {
    font-family: var(--font-display);
    font-size: var(--text-title-lg);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-display);
    color: var(--ink);
    transition: color var(--dur-trim) var(--ease);
  }
  .hero-offer-desc {
    grid-column: 1;
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-lede);
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .hero-offer-arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    font-size: var(--text-glyph);
    color: var(--muted);
    transition: color var(--dur-trim) var(--ease), transform var(--dur-trim) var(--ease);
  }
  .hero-offer-link:hover .hero-offer-name,
  .hero-offer-link:focus-visible .hero-offer-name { color: var(--accent-text); }
  .hero-offer-link:hover .hero-offer-arrow,
  .hero-offer-link:focus-visible .hero-offer-arrow { color: var(--accent-text); transform: translateX(4px); }
  .hero-support {
    margin: var(--space-4) 0 0;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--muted);
  }
  .hero-support a,
  .hero-cta-sub a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--hairline-strong);
    text-underline-offset: 0.25em;
  }
  .hero-support a:hover,
  .hero-cta-sub a:hover { color: var(--accent-text); }

  /* Trust bar retirée du Hero v6-densify · les 4 piliers vivront dans
     une zone "principles" dédiée plus tard (cf BookSession ou nouveau organism) */

  /* Metrics wrapper · préserve le layout MetricStrip */
  .metrics-reveal { display: block; }

  @media (max-width: 900px) {
    .hero-sub { grid-template-columns: 1fr; gap: var(--space-9); }
    .hero-sig-mark { display: none; }
    /* P1-5 (docs/39) · mobile only : CTA + microcopy remontent juste après la promesse,
       la mini-map des 6 territoires descend dessous → CTA principal dans le fold 390×844.
       0 changement desktop (>900px : order par défaut). */
    .hero-minimap { order: 1; }
  }
  @media (max-width: 560px) {
    .hero-offer-name { font-size: var(--text-numeral-sm); }
  }
  /* Viewport-fit desktop · 1280×720 → 1440×920 avec cookie banner visible
     → on resserre les rythmes verticaux pour faire tenir le hero above-the-fold
     sans toucher à l'identité typographique (breakpoint élargi 850→920px pour
     couvrir 1440×900 avec marge de sécurité) */
  @media (max-height: 920px) and (min-width: 900px) {
    .hero-sub { margin-top: var(--space-5); padding: var(--space-4) 0 var(--space-7); }
    .hero-headline { font-size: var(--text-h1); }
  }
</style>
