---
/**
 * @home-only
 * Section · Hero · business-first PME/ETI · FR/EN
 *
 * ⚠️ ORGANISM RÉSERVÉ HOME : NE PAS utiliser hors `/` et `/en/`.
 * Pour autres pages, préférer les sections W6 :
 * - HeroSplit (défaut Tier 1 canonique · grille 58/42)
 * - HeroCentered (Tier 2 standalone centré)
 * - HeroFullBleed (Tier 2 signature impact)
 * Source : docs/34-AMBIGUS-VERDICTS-OPUS.md§5 + docs/28-DESIGN-SYSTEM-CONTRACT.md§1
 *
 * M4 recadre la home : promesse lisible en 5 secondes, CTA vers contact
 * et offre Growth System IA, métriques de ROI conservées.
 */

import { langFromPath, localizeHref } from '../../../lib/i18n';

import MastheadRow from '../molecules/MastheadRow.astro';
import Kicker from '../atoms/Kicker.astro';
import Button from '../atoms/Button.astro';

const lang = langFromPath(Astro.url.pathname);
const ctaHref = localizeHref('/contact', lang);
const offerHref = localizeHref('/services', lang);
const pageTransitionId = Astro.url.pathname
  .replace(/^\/(?:en\/)?/, '')
  .replace(/\/$/, '')
  .replace(/[^a-z0-9]+/gi, '-')
  .replace(/^-|-$/g, '') || 'home';

// V7 · MetricStrip extrait dans nouveau organism ProofBar dédié (entre Hero et CapabilityStrip)
---
<section class="hero-a home-hero" aria-labelledby="hero-heading">
  <div class="signature-grid" transition:name={`hero-img-${pageTransitionId}`}></div>

  {/* SVG signature géométrique · overlay v9 · wrapper div pour scope CSS Astro propre */}
  <div class="hero-sig-mark" aria-hidden="true">
    <svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="60" cy="60" r="58" stroke="currentColor" stroke-width="0.5"/>
      <text x="60" y="67" text-anchor="middle" font-family="var(--font-mono)" font-size="13" fill="currentColor" letter-spacing="0.14em">V · 9</text>
    </svg>
  </div>

  <div class="wrap-wide">
    {/* Masthead newspaper · atome MastheadRow · margin compactée V6 (24px vs 48px) */}
    <div class="par hero-masthead" data-par="-0.04">
      <MastheadRow breadcrumb={[{ label: lang === 'fr' ? 'Accueil' : 'Home' }]} />
    </div>

    {/* Headline · mask-up reveal · Instrument Serif · 2 lignes orienté résultat */}
    <h1 id="hero-heading" class="hero-headline reveal-mask-up" transition:name={`hero-h1-${pageTransitionId}`}>
      {lang === 'fr' ? (
        <>
          Le studio qui fait tourner<br />
          votre <i class="acc">PME</i> à l'<i>IA</i>.
        </>
      ) : (
        <>
          The studio that runs your<br />
          <i class="acc">SMB</i> on <i>AI</i>.
        </>
      )}
    </h1>

    {/* Sub-block · 2 colonnes · promesse + contexte */}
    <div class="hero-sub">
      <div>
        <Kicker class="hero-fig">§ 01 · {lang === 'fr' ? 'Promesse' : 'Promise'}</Kicker>
        <p class="hero-lede reveal reveal-fade">
          {lang === 'fr' ? (
            <>On <i>conseille</i>, on <i>intègre</i> et on <i>connecte</i> l'<i>IA</i> dans vos outils marketing, sales, contenu et web, puis on la met <i>en production</i> : site intelligent, acquisition, CRM, analytics, marque, <i>sans changer</i> vos process.</>
          ) : (
            <>We <i>advise</i>, <i>integrate</i> and <i>connect</i> <i>AI</i> across your marketing, sales, content and web stack, then ship it <i>to production</i> : smart site, acquisition, CRM, analytics, brand, <i>without changing</i> your process.</>
          )}
        </p>

        {/* V7 §12 · Mini-map scope · 6 territoires Waimia en cartographie 3×2
            (vs strip linéaire) · chaque territoire = label + items éditoriaux */}
        <ul class="hero-minimap reveal reveal-fade" aria-label={lang === 'fr' ? 'Périmètre opérationnel · 6 territoires' : 'Operational scope · 6 territories'}>
          <li class="hero-mm-item">
            <span class="hero-mm-label">{lang === 'fr' ? 'Acquisition' : 'Acquisition'}</span>
            <span class="hero-mm-items">{lang === 'fr' ? 'Ads · Landing · Pipeline' : 'Ads · Landing · Pipeline'}</span>
          </li>
          <li class="hero-mm-item">
            <span class="hero-mm-label">{lang === 'fr' ? 'Contenu' : 'Content'}</span>
            <span class="hero-mm-items">{lang === 'fr' ? 'SEO/GEO · Articles · Posts' : 'SEO/GEO · Articles · Posts'}</span>
          </li>
          <li class="hero-mm-item">
            <span class="hero-mm-label">{lang === 'fr' ? 'Web' : 'Web'}</span>
            <span class="hero-mm-items">{lang === 'fr' ? 'Site IA-first · CMS · Pages' : 'AI-first · CMS · Pages'}</span>
          </li>
          <li class="hero-mm-item">
            <span class="hero-mm-label">{lang === 'fr' ? 'Sales' : 'Sales'}</span>
            <span class="hero-mm-items">{lang === 'fr' ? 'CRM · Relances · Scoring' : 'CRM · Follow-ups · Scoring'}</span>
          </li>
          <li class="hero-mm-item">
            <span class="hero-mm-label">{lang === 'fr' ? 'Data' : 'Data'}</span>
            <span class="hero-mm-items">{lang === 'fr' ? 'GA4 · Search Console · Insights' : 'GA4 · Search Console · Insights'}</span>
          </li>
          <li class="hero-mm-item">
            <span class="hero-mm-label">{lang === 'fr' ? 'Marque' : 'Brand'}</span>
            <span class="hero-mm-items">{lang === 'fr' ? 'Design system · Decks · PDF' : 'Design system · Decks · PDF'}</span>
          </li>
        </ul>

        <div class="hero-ctas reveal reveal-snap">
          <Button href={ctaHref} variant="primary" size="lg" mag={0.18}>
            {lang === 'fr' ? 'Réserver un audit →' : 'Book an audit →'}
          </Button>
          <Button href={offerHref} variant="ghost" size="lg">
            {lang === 'fr' ? 'Voir Growth System IA' : 'See AI Growth System'}
          </Button>
        </div>
        <p class="hero-cta-sub">
          {lang === 'fr'
            ? <>Audit IA opérationnel · 30 min · on identifie <i>3 automatisations rentables</i>.</>
            : <>AI operational audit · 30 min · we identify <i>3 high-ROI automations</i>.</>}
        </p>
      </div>

      <div>
        <Kicker class="hero-fig">§ 02 · {lang === 'fr' ? 'Résultats concrets' : 'Concrete results'}</Kicker>

        {/* 3 preuves verticales · format "n · label" éditorial · hairline 1px entre */}
        <ul class="hero-proofs reveal reveal-fade" aria-label={lang === 'fr' ? 'Preuves de résultats' : 'Result proofs'}>
          <li class="hero-proof">
            <span class="hero-proof-num">+12h</span>
            <span class="hero-proof-label">
              {lang === 'fr'
                ? <>économisées <i>par équipe</i> · semaine</>
                : <>saved <i>per team</i> · week</>}
            </span>
          </li>
          <li class="hero-proof">
            <span class="hero-proof-num">{lang === 'fr' ? '5 j' : '5 d'}</span>
            <span class="hero-proof-label">
              {lang === 'fr'
                ? <>jusqu'au <i>premier système</i> livré</>
                : <>to the <i>first system</i> shipped</>}
            </span>
          </li>
          <li class="hero-proof">
            <span class="hero-proof-num">100%</span>
            <span class="hero-proof-label">
              {lang === 'fr'
                ? <>intégré · <i>sans changer</i> vos outils</>
                : <>integrated · <i>no migration</i></>}
            </span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

{/* V7 · MetricStrip retiré du Hero · les metrics vivent désormais dans
   <ProofBar /> dédié monté juste après dans index.astro */}

<style>
  .hero-a {
    position: relative;
    /* Sticky-aware · header fixed 79px + respiration éditoriale densifiée
       (V6 brief Simon : faire passer plus de contenu dans la section) */
    /* Le header fixed mesure ~79px au top : le padding DOIT l'inclure sinon le
       masthead (Accueil · FR) passe sous la barre (rogné mobile, vu 2026-07-13) */
    padding: calc(var(--header-height) + var(--space-6)) 0 0;
    border-bottom: 1px solid var(--hairline);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .hero-a > *:not(.signature-grid):not(.hero-sig-mark) { position: relative; z-index: 1; }
  .hero-a .signature-grid { z-index: 0; }

  /* Wrapper hero · max-width hard cap pour grands écrans · contrainte de
     lisibilité éditoriale (V6 : éviter casse design sur ultra-wide) */
  .hero-a .wrap-wide {
    max-width: var(--wrap-wide);
    margin-inline: auto;
  }

  /* SVG signature v9 · wrapper div (scope Astro propre) · overlay décoratif */
  .hero-sig-mark {
    position: absolute;
    right: calc(var(--gut) * 2);
    top: calc(var(--section-loose) * 0.55);
    width: 88px;
    height: 88px;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    color: var(--ink);
    opacity: 0.18;
  }
  .hero-sig-mark svg { width: 100%; height: 100%; display: block; }

  /* H1 · token sémantique unifié --text-h1-hero · cf tokens.css */
  .hero-headline {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    line-height: var(--leading-h1, .96);
    letter-spacing: var(--tracking-display, -0.025em);
    font-weight: var(--fw-regular);
    max-width: 980px;
    margin: 0 0 var(--space-5);
  }
  .hero-headline i { font-style: italic; }
  .hero-headline i.acc { color: var(--accent-text); }

  /* V7 Swiss grid · espace symétrique masthead/H1/sub-block (resserré 32/32/32 pour above-fold) */
  .hero-masthead { margin-bottom: var(--space-6); }

  .hero-sub {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: var(--space-10);
    margin-top: var(--space-6);
    padding: var(--space-6) 0 var(--space-6);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    align-items: stretch;
  }
  /* V7 · les 2 cols hero-sub deviennent flex column pour égaliser leur hauteur
     et permettre l'alignement top/bottom mathématique du contenu interne */
  .hero-sub > div {
    display: flex;
    flex-direction: column;
  }
  .hero-fig { margin-bottom: var(--space-4); }

  /* Lede · Inter Tight (pas Serif) · reveal-fade delay var(--dur-fast) */
  .hero-lede {
    font-family: var(--font-sans);
    font-size: var(--text-lede, clamp(20px, 1.7vw, 24px));
    line-height: var(--leading-body, 1.5);
    color: var(--ink-2);
    max-width: 520px;
    text-wrap: pretty;
    transition-delay: var(--dur-fast);
  }
  .hero-lede i { font-style: italic; color: var(--accent-text); }

  /* V7 §12 · Mini-map scope · cartographie 3×2 éditoriale (vs strip linéaire)
     · 6 territoires en grid 3 colonnes desktop · 2 cols tablet · stack mobile
     · chaque territoire : label mono caps + items inline serif italic petit */
  .hero-minimap {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--hairline);
    transition-delay: var(--dur-hover);
  }
  .hero-mm-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-3) var(--space-3) 0;
    border-bottom: 1px solid var(--hairline);
    border-right: 1px solid var(--hairline);
  }
  .hero-mm-item:nth-child(3n) { border-right: none; }
  .hero-mm-item:nth-last-child(-n+3) { border-bottom: none; }
  .hero-mm-item:not(:nth-child(3n+1)) { padding-left: var(--space-3); }

  .hero-mm-label {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .hero-mm-items {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-lede);
    color: var(--ink-2);
  }

  @media (max-width: 700px) {
    /* Mobile : la mini-map des 6 territoires est masquée (demande Simon 2026-07-13,
       le hero mobile va droit à la promesse puis aux proofs) */
    .hero-minimap { display: none; }
  }

  /* CTAs · mobile : pleine largeur empilés (vs wrap bancal des 2 boutons lg) */
  @media (max-width: 560px) {
    .hero-ctas { flex-direction: column; align-items: stretch; gap: var(--space-3); }
    .hero-ctas :global(.btn) { width: 100%; justify-content: center; }
  }

  /* CTAs · reveal-snap delay 400ms */
  .hero-ctas {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-5);
    transition-delay: var(--dur-base);
  }

  /* Sub-CTA · Swiss grid · margin-top auto via flex parent pour push en bas
     du col gauche · padding-top space-5 garantit espace min entre CTAs et sub-CTA
     · résultat : col gauche et col droite finissent au même Y (mathématique) */
  .hero-cta-sub {
    margin-top: auto;
    padding-top: var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--ink-2);
    letter-spacing: 0.005em;
    transition-delay: var(--dur-panel);
  }
  .hero-cta-sub i { font-style: italic; color: var(--accent-text); }

  /* Right rail · preuves verticales · V7 Swiss grid · justify-content space-between
     pour étirer les 3 proofs sur toute la hauteur de col (égalise col gauche/droite) */
  .hero-proofs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-5);
    flex: 1;
    transition-delay: var(--dur-hover);
  }
  .hero-proof {
    display: grid;
    grid-template-columns: minmax(110px, 0.4fr) 1fr;
    gap: var(--space-5);
    align-items: baseline;
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--hairline);
  }
  .hero-proof:last-child { border-bottom: 0; padding-bottom: 0; }
  .hero-proof-num {
    font-family: var(--font-display);
    font-size: var(--text-numeral-md);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--accent-text);
    font-weight: var(--fw-regular);
  }
  .hero-proof-label {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-lede);
    color: var(--ink);
    text-wrap: balance;
  }
  .hero-proof-label i { font-style: italic; color: var(--ink-2); }

  /* Trust bar retirée du Hero v6-densify · les 4 piliers vivront dans
     une zone "principles" dédiée plus tard (cf BookSession ou nouveau organism) */

  /* Metrics wrapper · préserve le layout MetricStrip */
  .metrics-reveal { display: block; }

  @media (max-width: 900px) {
    .hero-sub { grid-template-columns: 1fr; gap: var(--space-9); }
    .hero-sig-mark { display: none; }
    .hero-a .signature-grid { display: none; }
    .hero-proof { grid-template-columns: 90px 1fr; gap: var(--space-4); }
    /* P1-5 (docs/39) · mobile only : CTA + microcopy remontent juste après la promesse,
       la mini-map des 6 territoires descend dessous → CTA principal dans le fold 390×844.
       0 changement desktop (>900px : order par défaut). */
    .hero-minimap { order: 1; }
  }
  @media (max-width: 560px) {
    .hero-proof { grid-template-columns: 1fr; gap: var(--space-1); padding: var(--space-3) 0; justify-items: center; text-align: center; }
  }
  /* Viewport-fit desktop · 1280×720 → 1440×920 avec cookie banner visible
     → on resserre les rythmes verticaux pour faire tenir le hero above-the-fold
     sans toucher à l'identité typographique (breakpoint élargi 850→920px pour
     couvrir 1440×900 avec marge de sécurité) */
  @media (max-height: 920px) and (min-width: 900px) {
    .hero-sub { margin-top: var(--space-5); padding: var(--space-4) 0 var(--space-7); }
    .hero-headline { font-size: var(--text-h1); }
  }
</style>
