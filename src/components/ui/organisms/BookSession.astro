---
/**
 * Section · CTA diagnostic
 *
 * M4 remplace le ton « working session » par un cadrage business-first :
 * diagnostic de 45 minutes, plan d'action concret, sans engagement.
 */

import ChapterLabel from '../atoms/ChapterLabel.astro';
import Button from '../atoms/Button.astro';
import { langFromPath, localizeHref } from '../../../lib/i18n';

const lang = langFromPath(Astro.url.pathname);
const ctaHref = localizeHref('/contact', lang);
const email = lang === 'fr' ? 'bonjour@waimia.fr' : 'hello@waimia.fr';
---
<section id="act-5" class="book-session scale-in on-dark" aria-labelledby="book-h2">
  <div class="wrap-wide book-inner">
    <div class="book-chapter">
      <ChapterLabel
        num="FIG V · 5.0"
        title={lang === 'fr' ? "Acte V : Passer à l'action" : 'Act V: Act'}
      />
    </div>

    <h2 id="book-h2" class="book-h2 reveal-mask-up u-serif-accent">
      {lang === 'fr' ? (
        <>Stop le <i>théâtre</i>. <br />Câbler.</>
      ) : (
        <>Stop the <i>theatre</i>. <br />Wire it.</>
      )}
    </h2>

    <p class="book-lede u-serif">
      {lang === 'fr'
        ? "45 minutes. On regarde. On audite. On chiffre. Si on n'a rien à vous proposer, on le dit. On ne relance pas."
        : "45 minutes. We look. We audit. We price. If we have nothing to offer, we say so. No follow-up."}
    </p>

    <p class="book-avail">
      {lang === 'fr'
        ? '● DISPONIBLE · T3 2026 · RÉPONSE SOUS 24H'
        : '● AVAILABLE · Q3 2026 · RESPONSE IN 24H'}
    </p>

    <div class="book-ctas reveal-snap">
      <Button href={ctaHref} variant="primary" size="lg" mag={0.22}>
        {lang === 'fr' ? 'Câbler →' : 'Wire it →'}
      </Button>
      <Button href={`mailto:${email}`} variant="ghost" size="lg">
        {email}
      </Button>
    </div>

    <p class="book-sub">
      {lang === 'fr'
        ? <>Diagnostic <i>gratuit</i> · réversibilité <i>documentée</i> · pas de relance.</>
        : <>Free <i>diagnostic</i> · documented <i>reversibility</i> · no follow-up.</>}
    </p>
  </div>
</section>

<style>
  /* V6 densification · padding réduit drastiquement (clamp 140-260 → 72-128) */
  /* V-F2 · climax INK (docs/39 P1-8 + audit home 12) : le moment le plus chaud sur le fond le plus fort */
  .book-session{padding:clamp(72px,9vw,128px) 0 clamp(56px,7vw,96px);background:var(--ink);color:var(--paper);border-top:1px solid var(--hairline);border-radius:0;transition:border-radius var(--dur-reveal) var(--ease)}
  .book-session.in{border-radius:32px 32px 0 0}
  .book-session{--muted:rgba(var(--paper-rgb),0.64);--hairline:rgba(var(--paper-rgb),0.14)}
  .book-h2{color:var(--paper)}

  /* Inner wrap · centrage propre sans inline style */
  .book-inner{text-align:center;position:relative;z-index:1}
  .book-chapter{display:flex;justify-content:center}

  /* H2 token sémantique · variant grand (BookSession climax final) · cf tokens.css */
  /* H2 climax = masse → Instrument Sans medium ; <i> reste relevé serif italic accent */
  .book-h2{font-family:var(--font-sans);font-style:normal;font-size:var(--text-h2-grand);line-height:var(--leading-h1);letter-spacing:-0.015em;margin:20px 0 20px;text-wrap:balance;font-weight:var(--fw-medium)}
  .book-lede{font-size:clamp(16px,1.8vw,19px);color:var(--muted);max-width:620px;margin:0 auto 36px;font-family:var(--font-sans);line-height:1.45}
  .book-avail{font-family:var(--font-mono);font-size:var(--text-eyebrow);font-style:normal;letter-spacing:var(--tracking-mono);text-transform:uppercase;color:var(--muted);margin:0 0 var(--space-6);line-height:1}
  .book-ctas{display:inline-flex;gap:var(--space-3);flex-wrap:wrap;justify-content:center}

  /* Sub-CTA · réassurance · serif italique terracotta sur les mots clés */
  .book-sub{margin:var(--space-5) auto 0;font-family:var(--font-sans);font-size:clamp(13px,1.05vw,15px);line-height:var(--leading-body);color:var(--muted);max-width:560px}
  .book-sub i{font-style:italic;color:var(--accent-text)}
</style>
