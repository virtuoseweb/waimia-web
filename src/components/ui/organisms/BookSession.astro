---
/**
 * Section · CTA diagnostic
 *
 * M4 remplace le ton « working session » par un cadrage business-first :
 * diagnostic de 45 minutes, plan d'action concret, sans engagement.
 */

import { AUDIT_BOOKING_HREF } from '../../../data/conversion';
import ChapterLabel from '../atoms/ChapterLabel.astro';
import Button from '../atoms/Button.astro';
import { langFromPath, localizeHref } from '../../../lib/i18n';

const lang = langFromPath(Astro.url.pathname);
// Prise de rendez-vous : URL unique (la page contact porte le calendrier). /audit-ia-pme présente l'audit.
const ctaHref = AUDIT_BOOKING_HREF;
const auditHref = localizeHref('/audit-ia-pme', lang);
---
<section id="act-5" class="book-session scale-in on-dark" aria-labelledby="book-h2">
  <div class="wrap-wide book-inner">
    <div class="book-chapter">
      <ChapterLabel
        num="§"
        title={lang === 'fr' ? 'Première étape' : 'First step'}
      />
    </div>

    <h2 id="book-h2" class="book-h2 reveal-mask-up u-serif-accent">
      {lang === 'fr' ? (
        <>Quarante-cinq minutes pour savoir <br />quoi <i>automatiser</i>.</>
      ) : (
        <>Forty-five minutes to know <br />what to <i>automate</i>.</>
      )}
    </h2>

    <p class="book-lede u-serif">
      {lang === 'fr'
        ? "Un audit gratuit, en visio, avec l'ingénieur qui fera le travail. On passe vos processus en revue et on repère trois automatisations rentables. Si rien ne vaut le coup, on vous le dit, et on ne relance pas."
        : "A free audit, on a call, with the engineer who will do the work. We review your processes and spot three profitable automations. If nothing is worth it, we tell you, and we don't follow up."}
    </p>

    <div class="book-ctas reveal-snap">
      <Button href={ctaHref} variant="primary" size="lg" mag={0.22}>
        {lang === 'fr' ? 'Réserver un audit →' : 'Book an audit →'}
      </Button>
    </div>

    <p class="book-sub">
      {lang === 'fr'
        ? <>Audit <i>gratuit</i> · 45 min · sans engagement. <a href={auditHref}>En savoir plus sur l'audit</a></>
        : <>Free <i>audit</i> · 45 min · no commitment. <a href={auditHref}>More about the audit</a></>}
    </p>
  </div>
</section>

<style>
  /* V6 densification · padding réduit drastiquement (clamp 140-260 → 72-128) */
  /* V-F2 · climax INK (docs/39 P1-8 + audit home 12) : le moment le plus chaud sur le fond le plus fort */
  .book-session{padding:var(--section-loose) 0 var(--section-base);background:var(--ink);color:var(--paper);border-top:1px solid var(--hairline);border-radius:0;transition:border-radius var(--dur-reveal) var(--ease)}
  .book-session.in{border-radius:32px 32px 0 0}
  .book-session{--muted:rgba(var(--paper-rgb),0.64);--hairline:rgba(var(--paper-rgb),0.14)}
  .book-h2{color:var(--paper)}

  /* Inner wrap · centrage propre sans inline style */
  .book-inner{text-align:center;position:relative;z-index:1}
  .book-chapter{display:flex;justify-content:center}

  /* H2 token sémantique · variant grand (BookSession climax final) · cf tokens.css */
  /* H2 climax = masse → Instrument Sans medium ; <i> reste relevé serif italic accent */
  .book-h2{font-family:var(--font-sans);font-style:normal;font-size:var(--text-h1);line-height:var(--leading-h1);letter-spacing:-0.015em;margin:20px 0 20px;text-wrap:balance;font-weight:var(--fw-medium)}
  .book-lede{font-size:var(--text-h3);color:var(--muted);max-width:620px;margin:0 auto var(--space-7);font-family:var(--font-sans);line-height:1.45}
  .book-ctas{display:inline-flex;gap:var(--space-3);flex-wrap:wrap;justify-content:center}

  .book-sub a{color:var(--paper);text-decoration:underline;text-decoration-color:var(--hairline);text-underline-offset:.25em}
  .book-sub a:hover{color:var(--accent-text)}
  /* Sub-CTA · réassurance · serif italique terracotta sur les mots clés */
  .book-sub{margin:var(--space-5) auto 0;font-family:var(--font-sans);font-size:var(--text-small);line-height:var(--leading-body);color:var(--muted);max-width:560px}
  .book-sub i{font-style:italic;color:var(--accent-text)}
</style>
