---
// Organism · ToolWidget · calculateur/score interactif data-driven (hors catalogue).
//
// Rend un formulaire piloté par les `inputs` du frontmatter d'un outil
// (`src/content/outils/*.mdx`) et affiche les `outputs` calculés côté client
// (vanilla JS, aucune île React, site SSG). Un seul composant sert les 2 outils
// (calculateur ROI + score maturité) : tout vient des données, pas de recette
// par outil. Le calcul se met à jour à chaque saisie.
//
// Placement : rendu en tête du slot body d'EssayTemplate (après le hero, avant la
// prose). Le composant est défensif face aux styles :global de `.essay-prose`
// (neutralise le gradient de lien sur le CTA, n'utilise ni <p>/<h2>/<ul> nus).
//
// Comportement : le <script> de calcul vit dans la page hôte
// (`src/pages/ressources/outils/[...slug].astro`), pas ici. Raison : EssayTemplate
// capture le slot body via `Astro.slots.render()` puis le réinjecte en set:html,
// ce qui rend inerte tout <script> porté par un composant du slot (script inséré
// via innerHTML = non exécuté). Le script page cible `[data-tool-widget]` de façon
// générique (data-driven), le composant reste réutilisable. Styles scopés : OK
// (bundlés via l'import du composant, indépendamment du slot).

interface InputOption {
  value: string;
  label_fr: string;
  label_en: string;
}
interface InputDef {
  key: string;
  label_fr: string;
  label_en: string;
  type: 'number' | 'text' | 'select' | 'currency';
  unit?: string;
  defaultValue?: number | string;
  min?: number;
  max?: number;
  options?: InputOption[];
}
interface OutputDef {
  key: string;
  formula: string;
  label_fr: string;
  label_en: string;
  unit?: string;
  format?: 'integer' | 'decimal2' | 'currency-eur' | 'percent';
}
interface Props {
  inputs: InputDef[];
  outputs: OutputDef[];
  lang?: 'fr' | 'en';
  ctaHref?: string;
  ctaLabel_fr?: string;
  ctaLabel_en?: string;
}

const {
  inputs = [],
  outputs = [],
  lang = 'fr',
  ctaHref = 'https://cal.com/simonberos/audit',
  ctaLabel_fr,
  ctaLabel_en,
} = Astro.props as Props;

const isEn = lang === 'en';
const pick = (fr: string, en: string) => (isEn ? en : fr);
const active = inputs.length > 0 && outputs.length > 0;

const eyebrow = pick('Estimation instantanée', 'Instant estimate');
const hint = pick('Le résultat se met à jour à chaque saisie, sans email.', 'The result updates as you type, no email.');
const ctaText = pick(ctaLabel_fr ?? 'Réserver un audit gratuit →', ctaLabel_en ?? 'Book a free audit →');
---
{active && (
  <section class="tool-widget" data-tool-widget aria-label={eyebrow}>
    <span class="tw-eyebrow">{eyebrow}</span>

    <div class="tw-grid">
      {inputs.map((inp) => (
        <div class="tw-field">
          <label class="tw-field__label" for={`tw-${inp.key}`}>{pick(inp.label_fr, inp.label_en)}</label>
          {inp.type === 'select' ? (
            <select id={`tw-${inp.key}`} class="tw-select" data-key={inp.key}>
              {inp.options?.map((o) => (
                <option value={o.value} selected={String(inp.defaultValue) === o.value}>
                  {pick(o.label_fr, o.label_en)}
                </option>
              ))}
            </select>
          ) : (
            <div class="tw-input-wrap">
              <input
                id={`tw-${inp.key}`}
                class="tw-input"
                type="number"
                data-key={inp.key}
                value={inp.defaultValue as number | string | undefined}
                min={inp.min}
                max={inp.max}
                inputmode="decimal"
              />
              {inp.unit && <span class="tw-input__unit">{inp.unit}</span>}
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="tw-results">
      {outputs.map((o) => (
        <div
          class="tw-result"
          data-output
          data-formula={o.formula}
          data-format={o.format ?? 'integer'}
          data-unit={o.unit ?? ''}
          data-lang={lang}
        >
          <span class="tw-result__label">{pick(o.label_fr, o.label_en)}</span>
          <span class="tw-result__value" data-result-value>…</span>
        </div>
      ))}
    </div>

    <div class="tw-cta-row">
      <span class="tw-hint">{hint}</span>
      <a class="btn btn-primary tw-cta" href={ctaHref}>{ctaText}</a>
    </div>
  </section>
)}

<style>
  .tool-widget {
    margin: 0 0 var(--space-9);
    padding: var(--space-6);
    background: var(--paper-2);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-lg);
    font-family: var(--font-sans);
  }

  .tw-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--accent-text);
    margin-bottom: var(--space-5);
  }

  .tw-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .tw-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }
  .tw-field__label {
    font-size: var(--text-body);
    font-weight: var(--fw-medium);
    color: var(--ink);
    line-height: 1.3;
  }

  .tw-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .tw-input,
  .tw-select {
    width: 100%;
    padding: 12px var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-sm);
    transition: border-color var(--dur-trim) var(--ease);
  }
  .tw-input__unit {
    position: absolute;
    right: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--muted);
    pointer-events: none;
  }
  .tw-input {
    padding-right: calc(var(--space-4) * 3);
    -webkit-appearance: none;
    -moz-appearance: textfield;
    appearance: none;
  }
  .tw-input::-webkit-outer-spin-button,
  .tw-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .tw-input:focus-visible,
  .tw-select:focus-visible {
    outline: none;
    border-color: var(--accent-text);
  }

  .tw-results {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .tw-result {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-6);
    background: var(--paper);
    border: 1px solid var(--complementary);
    border-radius: var(--radius-md);
    box-shadow: inset 4px 0 0 var(--complementary);
  }
  .tw-result__label {
    font-size: var(--text-body);
    color: var(--ink-2);
    max-width: 60%;
    line-height: 1.35;
  }
  .tw-result__value {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: var(--fw-medium);
    line-height: 1;
    color: var(--complementary);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .tw-cta-row {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .tw-hint {
    font-size: var(--text-small);
    color: var(--muted);
    max-width: 42ch;
    line-height: 1.4;
  }

  /* CTA : neutralise le gradient de lien hérité de .essay-prose :global(a)
     (spécificité 0,1,1) via .tool-widget .tw-cta (0,2,0). */
  .tool-widget .tw-cta,
  .tool-widget .tw-cta:hover {
    background-image: none;
    text-decoration: none;
    padding: 14px 24px;
    color: var(--paper);
  }
  .tool-widget .tw-cta:hover {
    color: #fff;
  }

  @media (max-width: 640px) {
    .tw-grid {
      grid-template-columns: 1fr;
    }
    .tool-widget {
      padding: var(--space-5);
    }
    .tw-result__label {
      max-width: 100%;
    }
  }
</style>
