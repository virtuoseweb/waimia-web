---
// Section · Manifeste Accent · full-bleed terracotta · viscéral
// Variant : fond terracotta + Instrument Serif italic XL · « On refuse / We refuse »
// Motion : .reveal (fade-up 1400ms) + signature grid translucide
// Mémorable : « Le moment où la page hurle ce qu'elle déteste — terracotta sang sur paper. »
//
// Source: virtuoseweb/waimia DirectionB.tsx · lines 199-210 (Manifesto accent · Viewport 01)
//
// Composé de · Kicker (refactor atomic-components)

import Kicker from '../atoms/Kicker.astro';
import { langFromPath } from '../../../lib/i18n';

const lang = langFromPath(Astro.url.pathname);
---
<section class="manifesto-accent" aria-labelledby="manifesto-accent-anchor">
  {/* Signature grid en plus saturée pour rester lisible sur fond terracotta */}
  <div class="manifesto-accent-grid" aria-hidden></div>

  <div class="wrap-wide" style="position:relative;z-index:1">
    <Kicker class="manifesto-accent-kicker">
      § {lang === 'fr' ? 'Manifeste · Viewport 02' : 'Manifesto · Viewport 02'}
    </Kicker>

    <p id="manifesto-accent-anchor" class="manifesto-accent-text reveal u-serif">
      {lang === 'fr' ? (
        <>
          On refuse l'uniforme <i>purple-glass</i>. On refuse le cerveau-circuits. On refuse la voix AI-startup. On garde le métier, les reçus, et les règles typographiques françaises.
        </>
      ) : (
        <>
          We refuse the <i>purple-glass</i> uniform. We refuse the brain-on-circuits. We refuse the AI-startup voice. We keep the craft, the receipts, and the French typographic rules.
        </>
      )}
    </p>
  </div>
</section>

<style>
  .manifesto-accent{
    padding:var(--section-grand) 0;
    background:var(--accent);color:var(--paper);
    position:relative;overflow:hidden;
    border-top:1px solid rgba(var(--paper-rgb), .18);
    border-bottom:1px solid rgba(var(--paper-rgb), .18);
  }
  /* Grid translucide cream qui rappelle le signature-grid mais lisible sur terracotta */
  .manifesto-accent-grid{
    position:absolute;inset:0;pointer-events:none;
    background-image:
      linear-gradient(to right, rgba(var(--paper-rgb), 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(var(--paper-rgb), 0.08) 1px, transparent 1px);
    background-size:48px 48px;
    mask-image:radial-gradient(ellipse at 30% 70%, black 0%, transparent 80%);
    -webkit-mask-image:radial-gradient(ellipse at 30% 70%, black 0%, transparent 80%);
  }
  /* Override Kicker atom · couleur cream sur fond terracotta (cas marginal · 1 occurrence)
     Le `!important` est nécessaire car Kicker pose un style inline pour color. */
  :global(.manifesto-accent-kicker){
    color:rgba(var(--paper-rgb), .78) !important;
    margin-bottom:var(--spacing-block);
  }
  /* Directive typo : masse du statement en Instrument Sans medium (contraste par la
     graisse). Les fragments <i> (« purple-glass », « règles typographiques françaises »)
     restent relevés en Instrument Serif italic = emphase. */
  .manifesto-accent-text{
    font-family:var(--font-sans);
    font-size:var(--text-display);
    line-height:.98;
    letter-spacing:-0.02em;
    color:var(--paper);
    max-width:1500px;
    text-wrap:balance;
    font-weight:var(--fw-medium);
  }
</style>
