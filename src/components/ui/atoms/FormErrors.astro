---
interface Props {
  errors?: Record<string, string[]>;
  id?: string;
  className?: string;
}
const { errors, id, className } = Astro.props as Props;
const hasErrors = errors && Object.keys(errors).length > 0;
---
{hasErrors && (
  <div role="alert" aria-live="polite" aria-atomic="true" id={id} class:list={['form-errors', className]}>
    <ul>
      {Object.entries(errors).map(([field, msgs]) => (
        <li><strong>{field}</strong>{' : '}{msgs.join(', ')}</li>
      ))}
    </ul>
  </div>
)}

<style>
  .form-errors {
    margin: var(--space-3) 0;
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    color: var(--ink);
  }
  .form-errors ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-1); }
  .form-errors strong { font-family: var(--font-mono); font-size: var(--text-eyebrow); text-transform: uppercase; letter-spacing: var(--tracking-mono-tight); color: var(--accent); margin-right: 6px; }
</style>
