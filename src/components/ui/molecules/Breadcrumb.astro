---
import { SITE } from '../../../site.config';

interface Crumb {
  label: string;
  href?: string;
  current?: boolean;
}
interface Props {
  items: Crumb[];
  lang?: 'fr' | 'en';
  noJsonLd?: boolean;
}
const { items, lang = 'fr', noJsonLd = false } = Astro.props;
---
<div class="breadcrumb-bar">
  <nav class="breadcrumb wrap-wide" aria-label={lang === 'fr' ? "Fil d'Ariane" : 'Breadcrumb'}>
    <ol>
      {items.map((c, i) => {
        const isCurrent = i === items.length - 1;
        return (
        <li>
          {isCurrent ? <span aria-current="page">{c.label}</span> : c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
          {i < items.length - 1 && <span class="sep" aria-hidden>/</span>}
        </li>
        );
      })}
    </ol>
  </nav>
  {!noJsonLd && <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      ...(c.href ? { item: `${SITE.url}${c.href}` } : {}),
    })),
  })} />}
</div>

<style>
  /* Barre de fil d'Ariane dédiée · dégage le header fixe (.hdr position:fixed,
     hauteur réelle ~79px > token 72px) en réservant calc(--header-height + --space-5)
     de padding-top. Reste DANS LE FLUX : la 1re section qui suit (hero) voit alors
     --header-height neutralisé (cf global.css) pour éviter le double-espacement.
     Robuste à tous les contextes d'insertion (enfant direct de main, ou dans
     <article>/<section> de template). */
  .breadcrumb-bar {
    padding-top: calc(var(--header-height) + var(--space-5));
    padding-bottom: var(--space-4);
  }
  .breadcrumb {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono-tight);
    text-transform: uppercase;
    color: var(--muted);
  }
  .breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  .breadcrumb a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .breadcrumb a:hover {
    color: var(--accent-text);
    border-bottom-color: var(--accent-text);
  }
  .breadcrumb a:focus-visible {
    color: var(--ink);
    border-bottom-color: var(--accent-text);
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: var(--radius-xs);
  }
  .breadcrumb [aria-current="page"] {
    color: var(--ink);
  }
  .breadcrumb .sep {
    color: var(--hairline-strong);
  }
  /* Mobile : 1 seule ligne, jamais de wrap ; le crumb courant tronque en ellipsis */
  @media (max-width: 768px) {
    .breadcrumb { overflow: hidden; }
    .breadcrumb ol { flex-wrap: nowrap; min-width: 0; }
    .breadcrumb li { flex: 0 0 auto; white-space: nowrap; }
    .breadcrumb li:last-child { flex: 0 1 auto; min-width: 0; overflow: hidden; }
    .breadcrumb li:last-child [aria-current="page"] {
      display: inline-block;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      vertical-align: bottom;
    }
    .breadcrumb .sep { flex: none; }
  }
</style>
