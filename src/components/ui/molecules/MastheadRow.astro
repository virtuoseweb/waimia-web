---
// Molécule · MastheadRow · « couverture de revue » · 100% DS-driven (0 style inline)
// 4 cellules mono uppercase tokenisées, séparées par un hairline · paper/ink via data-tone.
// Cellule 1 = volume OU fil d'Ariane (prop breadcrumb). Tout le style vit dans <style> (tokens DS).
//
// Usage :
//   <MastheadRow tone="paper" />
//   <MastheadRow tone="ink" volume="02" status="Q3 2026" />
//   <MastheadRow breadcrumb={[{label:'Accueil',href:'/'},{label:'Services'}]} />

import { langFromPath } from '../../../lib/i18n';

interface Crumb {
  /** Libellé déjà résolu par langue */
  label: string;
  /** Lien optionnel ; le dernier crumb (current) est sans lien */
  href?: string;
}
interface Props {
  /** Volume éditorial · ex: "Vol. 03 · № 01" (cellule 1 par défaut) */
  volume?: string;
  /** Fil d'Ariane · si présent non vide, remplace `volume` en cellule 1 */
  breadcrumb?: Crumb[];
  /** Lieux · ex: "FR" */
  locations?: string;
  /** Status booking · texte après le ◉ */
  status?: string;
  /** Fond · `paper` (clair) ou `ink` (dark) */
  tone?: 'paper' | 'ink';
}

const lang = langFromPath(Astro.url.pathname);

const {
  volume = 'Vol. 03 · № 01',
  breadcrumb,
  locations = 'FR',
  status = lang === 'fr' ? 'Disponible · T3 2026' : 'Available · Q3 2026',
  tone = 'paper',
} = Astro.props;

const hasCrumbs = Array.isArray(breadcrumb) && breadcrumb.length > 0;
const lang_label = lang === 'fr' ? 'Édition française' : 'French edition';
---
<div class="u-masthead-row" data-tone={tone === 'ink' ? 'ink' : undefined}>
  {hasCrumbs ? (
    <span class="u-masthead-cell u-masthead-crumbs">
      {breadcrumb!.map((c, i) => {
        const isCurrent = i === breadcrumb!.length - 1;
        return (
          <>
            {isCurrent
              ? <span aria-current="page">{c.label}</span>
              : c.href
                ? <a href={c.href}>{c.label}</a>
                : <span>{c.label}</span>}
            {!isCurrent && <span class="sep" aria-hidden="true">/</span>}
          </>
        );
      })}
    </span>
  ) : (
    <span class="u-masthead-cell">{volume}</span>
  )}
  <span class="u-masthead-cell u-masthead-loc">{locations}</span>
  <span class="u-masthead-cell u-masthead-edition">{lang_label}</span>
  <span class="u-masthead-cell u-masthead-status"><span class="u-masthead-dot">◉</span> {status}</span>
</div>
{hasCrumbs && (
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumb!.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      ...(c.href ? { item: `https://waimia.com${c.href}` } : {}),
    })),
  })} />
)}

<style>
  .u-masthead-row{
    display:grid;
    grid-template-columns:repeat(4,auto);
    justify-content:space-between;
    align-items:center;
    gap:var(--space-6);
    border-bottom:1px solid var(--hairline);
    padding:var(--space-3) 0 var(--space-2);
    line-height:1;
  }
  .u-masthead-row[data-tone="ink"]{ border-bottom-color:rgba(var(--paper-rgb),.12); }

  .u-masthead-cell{
    font-family:var(--font-mono);
    font-size:var(--text-micro);
    letter-spacing:var(--tracking-mono-tight);
    text-transform:uppercase;
    color:var(--muted);
  }
  .u-masthead-row[data-tone="ink"] .u-masthead-cell{ color:rgba(var(--paper-rgb),.5); }

  /* Fil d'Ariane · 1 seule ligne, jamais de wrap */
  .u-masthead-crumbs{
    display:inline-flex;
    flex-wrap:nowrap;
    align-items:center;
    gap:var(--space-2);
    line-height:1;
    white-space:nowrap;
    min-width:0;
  }
  .u-masthead-crumbs a{
    color:inherit;
    text-decoration:none;
    border-bottom:1px solid transparent;
    transition:color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .u-masthead-crumbs a:hover{ color:var(--accent-text); border-bottom-color:var(--accent-text); }
  .u-masthead-crumbs a:focus-visible{ outline:2px solid var(--accent); outline-offset:3px; border-radius:var(--radius-xs); }
  /* le crumb courant tronque en « … » plutôt que wrapper (titres d'articles longs) */
  .u-masthead-crumbs [aria-current="page"]{ color:var(--accent-text); min-width:0; overflow:hidden; text-overflow:ellipsis; }
  .u-masthead-crumbs .sep{ color:var(--hairline-strong); flex:none; }

  .u-masthead-dot{ color:var(--accent-text); }
  .u-masthead-status{ text-align:right; }

  /* Mobile · garder le fil d'Ariane (1 ligne, typo réduite tokenisée) + « FR » à droite */
  @media (max-width:768px){
    .u-masthead-row{
      grid-template-columns:minmax(0,1fr) auto;
      justify-content:stretch;
      gap:var(--space-6);
    }
    .u-masthead-edition, .u-masthead-status{ display:none; }
    .u-masthead-loc{ text-align:right; white-space:nowrap; }
    .u-masthead-cell{ font-size:var(--text-micro); letter-spacing:var(--tracking-mono); }
  }
</style>
