---
// RelatedByCluster · data-loader par cluster · délègue le rendu à RelatedCards
// Logique : getCollection(blog + cookbooks + livresBlancs) filtré par cluster,
// tri par date desc, slice(limit), puis mappage vers RelatedCards.Card.
import { getCollection } from 'astro:content';
import { getLiveCollection } from '../../../lib/live-collection';
import RelatedCards from './RelatedCards.astro';
import { blogEntryHref } from '../../../lib/blog-routing';

interface Props {
  cluster?: string;
  excludeId?: string;
  limit?: number;
}

interface RelatedData {
  cluster?: string;
  publishedAt: Date | string;
  title_fr: string;
}

interface Item {
  id: string;
  type: string;
  data: RelatedData;
  href: string;
}

const { cluster, excludeId, limit = 3 } = Astro.props;

if (!cluster) return null;

// SEO état final : cookbooks + livres-blancs supprimés. Cluster = blog in-silo uniquement.
const [blog] = await Promise.all([
  getLiveCollection('blog'),
]);

const all: Item[] = [
  ...blog
    .filter((entry) => entry.data.cluster === cluster && entry.id !== excludeId)
    .map((entry) => ({
      id: entry.id,
      type: 'blog',
      data: entry.data,
      href: blogEntryHref(entry),
    })),
]
  .sort(
    (a, b) =>
      new Date(b.data.publishedAt).getTime() -
      new Date(a.data.publishedAt).getTime(),
  )
  .slice(0, limit);

if (all.length === 0) return null;

const cards = all.map((it) => ({
  kicker: it.type.toUpperCase(),
  title_fr: it.data.title_fr,
  title_en: it.data.title_fr,
  lead_fr: '',
  lead_en: '',
  href: it.href,
}));
---

<div class="rel-cluster-wrap">
  <p class="rel-cluster-label">§ Continuer dans ce cluster</p>
  <RelatedCards {cards} />
  <a href="/blog" class="rel-cluster-cta">Voir tout le blog →</a>
</div>

<style>
  .rel-cluster-wrap { margin: var(--space-8) 0; }
  .rel-cluster-label {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0 0 var(--space-4);
  }
  .rel-cluster-cta {
    display: inline-block;
    margin-top: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: .1em;
    color: var(--accent-text);
    text-decoration: none;
  }
  .rel-cluster-cta:hover { text-decoration: underline; }
</style>
