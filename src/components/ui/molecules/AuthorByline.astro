---
/**
 * AuthorByline · top d'article — photo + nom + date + reading time + lien profil
 *
 * Usage :
 *   <AuthorByline authorSlug="simon-beros" date={publishedAt} readingTime="7 min" />
 *
 * Auto-fetch l'auteur depuis collection authors. Robust : si slug undefined ou
 * auteur introuvable, rend un fallback minimal sans casser la page.
 */
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { langFromPath } from '../../../lib/i18n';
import { formatNewsDateTime, parisIso } from '../../../lib/news';

interface Props {
  authorSlug?: string;
  date?: Date | string;
  readingTime?: string;
  /** Date de mise à jour : affichée seulement si postérieure à `date`. */
  updatedAt?: Date | string;
  /** Actualité : date ET heure (Paris) ; « Mis à jour » dès une minute d'écart. */
  showTime?: boolean;
}

const { authorSlug, date, readingTime, updatedAt, showTime = false } = Astro.props;
const lang = langFromPath(Astro.url.pathname);

let author: CollectionEntry<'authors'> | undefined;
if (authorSlug) {
  try {
    author = await getEntry('authors', authorSlug);
  } catch {
    // Fallback gracieux : la page garde date / reading time si disponibles.
  }
}

const toDate = (v?: Date | string) => (v ? new Date(v) : null);
const published = toDate(date);
const modified = toDate(updatedAt);
const fmt = (d: Date) =>
  showTime ? formatNewsDateTime(d, lang === 'fr' ? 'fr' : 'en') : d.toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const iso = (d: Date) => (Number.isNaN(d.getTime()) ? '' : showTime ? parisIso(d) : d.toISOString().slice(0, 10));
const dateFormatted = published ? fmt(published) : null;
const showUpdated = Boolean(
  published && modified && !Number.isNaN(modified.getTime()) &&
    (showTime ? modified.getTime() - published.getTime() >= 60_000 : iso(modified) > iso(published)),
);
const updatedLabel = lang === 'fr' ? 'Mis à jour le' : 'Updated';
---

{author && (
  <div class="byline">
    {author.data.photo && (
      <a href={`/equipe/${author.id}`} class="byline-photo-link">
        <img src={author.data.photo} alt={author.data.photoAlt_fr ?? author.data.title_fr} class="byline-photo" loading="lazy" decoding="async" width="36" height="36" />
      </a>
    )}
    <div class="byline-meta">
      <a href={`/equipe/${author.id}`} class="byline-name">{author.data.title_fr}</a>
      <div class="byline-info">
        {published && dateFormatted && <span><time datetime={iso(published)}>{dateFormatted}</time></span>}
        {showUpdated && modified && <><span aria-hidden> · </span><span>{updatedLabel} <time datetime={iso(modified)}>{fmt(modified)}</time></span></>}
        {dateFormatted && readingTime && <span aria-hidden> · </span>}
        {readingTime && <span>{readingTime}</span>}
      </div>
    </div>
  </div>
)}

{!author && (dateFormatted || readingTime) && (
  <div class="byline byline-anon">
    {published && dateFormatted && <span><time datetime={iso(published)}>{dateFormatted}</time></span>}
    {showUpdated && modified && <><span aria-hidden> · </span><span>{updatedLabel} <time datetime={iso(modified)}>{fmt(modified)}</time></span></>}
    {dateFormatted && readingTime && <span aria-hidden> · </span>}
    {readingTime && <span>{readingTime}</span>}
  </div>
)}

<style>
  .byline {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: var(--space-5) 0 var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--muted);
  }
  .byline-photo-link { line-height: 0; }
  .byline-photo {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    object-fit: cover;
  }
  .byline-meta { display: flex; flex-direction: column; gap: 2px; }
  .byline-name {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--fw-medium);
    color: var(--ink);
    text-decoration: none;
  }
  .byline-name:hover { color: var(--accent-text); }
  .byline-info {
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono-tight);
    text-transform: uppercase;
    color: var(--muted);
  }
  .byline-anon { font-style: italic; }
</style>
