---
interface Props {
  currentStep: 1 | 2 | 3 | 4;
  lang?: 'fr' | 'en';
}
const { currentStep, lang = 'fr' } = Astro.props;
// Les routes du tunnel growth-system-ia sont servies par `/offres/[offre]/tunnel/[step]`
// (cf src/pages/offres/[offre]/tunnel/[step].astro) → offre_slug `growth-system-ia`,
// step 1-4. L'ancien pattern `/offres/site-web-ia-tunnel(/mecanique…)` n'a jamais
// existé en route (404 site-wide, SR-42 §3).
const steps = [
  { n: 1, label_fr: 'Constat', label_en: 'Problem', href: '/offres/growth-system-ia/tunnel/1' },
  { n: 2, label_fr: 'Mécanique', label_en: 'How it works', href: '/offres/growth-system-ia/tunnel/2' },
  { n: 3, label_fr: 'Preuves', label_en: 'Proof', href: '/offres/growth-system-ia/tunnel/3' },
  { n: 4, label_fr: 'Décision', label_en: 'Decision', href: '/offres/growth-system-ia/tunnel/4' },
];
---
<nav class="tunnel-nav" aria-label={lang === 'fr' ? 'Étapes du tunnel' : 'Tunnel steps'}>
  <div class="tunnel-nav__inner wrap-wide">
    {steps.map((s) => (
      <a
        href={s.href}
        class:list={['tunnel-nav__step', { 'is-active': s.n === currentStep, 'is-done': s.n < currentStep }]}
        aria-current={s.n === currentStep ? 'step' : undefined}
      >
        <span class="tunnel-nav__num">{s.n}/4</span>
        <span class="tunnel-nav__label">{lang === 'fr' ? s.label_fr : s.label_en}</span>
      </a>
    ))}
    <div class="tunnel-nav__bar">
      <div class="tunnel-nav__fill" style={`width:${((currentStep - 1) / 3) * 100}%`}></div>
    </div>
  </div>
</nav>
<style>
.tunnel-nav {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--paper);
  border-bottom: 1px solid var(--hairline);
  padding: var(--space-3) 0;
}
.tunnel-nav__inner {
  display: flex;
  align-items: center;
  gap: 0;
  position: relative;
}
.tunnel-nav__step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: var(--space-1) var(--space-4);
  text-decoration: none;
  flex: 1;
  border-right: 1px solid rgba(var(--ink-rgb), .06);
  transition: opacity var(--dur-fast);
}
.tunnel-nav__step:last-child { border-right: none; }
.tunnel-nav__num {
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
  font-size: var(--text-small);
  color: var(--muted);
  letter-spacing: .06em;
  text-transform: uppercase;
}
.tunnel-nav__label {
  font-family: var(--font-sans);
  font-size: var(--text-small);
  color: var(--ink);
}
.tunnel-nav__step.is-active .tunnel-nav__num,
.tunnel-nav__step.is-active .tunnel-nav__label { color: var(--accent-text); font-weight: var(--fw-semibold); }
.tunnel-nav__step.is-done { opacity: .5; }
.tunnel-nav__bar {
  position: absolute;
  bottom: -12px;
  left: 0;
  right: 0;
  height: 2px;
  background: rgba(var(--ink-rgb), .07);
}
.tunnel-nav__fill {
  height: 100%;
  background: var(--accent);
  transition: width var(--dur-base) var(--ease);
}
@media (max-width: 640px) {
  .tunnel-nav__label { display: none; }
  .tunnel-nav__num { font-size: var(--text-small); }
}
</style>
