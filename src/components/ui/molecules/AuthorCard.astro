---
/**
 * AuthorCard · carte auteur — photo + nom + role + bio courte + social links
 *
 * Usage :
 *   <AuthorCard authorSlug="simon-beros" variant="full" />
 *   <AuthorCard authorSlug="simon-beros" variant="mini" />
 */
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  authorSlug?: string;
  variant?: 'mini' | 'full';
}

const { authorSlug, variant = 'full' } = Astro.props;

let author: CollectionEntry<'authors'> | undefined;
if (authorSlug) {
  try {
    author = await getEntry('authors', authorSlug);
  } catch {
    // Fallback gracieux : ne rien rendre si l'auteur n'est pas disponible.
  }
}

// Monogramme (initiales) dérivé du nom : habille le panneau signature de la variante full.
const initials = author
  ? author.data.title_fr
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((w) => w[0]?.toUpperCase() ?? '')
      .join('')
  : '';
---

{author && variant === 'mini' && (
  <a href={`/equipe/${author.id}`} class="acard-mini">
    {author.data.photo && (
      <img src={author.data.photo} alt={author.data.photoAlt_fr ?? author.data.title_fr} class="acard-mini-photo" loading="lazy" decoding="async" width="32" height="32" />
    )}
    <div>
      <div class="acard-mini-name">{author.data.title_fr}</div>
      <div class="acard-mini-role">{author.data.role_fr}</div>
    </div>
  </a>
)}

{author && variant === 'full' && (
  <aside class="acard-full">
    <div class="acard-full-main">
      <div class="acard-full-header">
        {author.data.photo && (
          <a href={`/equipe/${author.id}`} class="acard-full-photo-link">
            <img src={author.data.photo} alt={author.data.photoAlt_fr ?? author.data.title_fr} class="acard-full-photo" loading="lazy" decoding="async" width="80" height="80" />
          </a>
        )}
        <div>
          <div class="acard-full-kicker">§ Écrit par</div>
          <a href={`/equipe/${author.id}`} class="acard-full-name">{author.data.title_fr}</a>
          <div class="acard-full-role">{author.data.role_fr}</div>
        </div>
      </div>
      <p class="acard-full-bio">{author.data.description_fr}</p>
      <div class="acard-full-social">
        {author.data.social?.linkedin && <a href={author.data.social.linkedin}>LinkedIn →</a>}
        {author.data.social?.x && <a href={author.data.social.x}>X →</a>}
        {author.data.social?.github && <a href={author.data.social.github}>GitHub →</a>}
        <a href={`/equipe/${author.id}`} class="acard-full-cta">Voir le profil →</a>
      </div>
    </div>
    <div class="acard-full-sig" aria-hidden="true">
      <div class="signature-grid"></div>
      {initials && <span class="acard-full-mono">{initials}</span>}
    </div>
  </aside>
)}

<style>
  /* Mini variant */
  .acard-mini {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--ink);
  }
  .acard-mini-photo {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    object-fit: cover;
  }
  .acard-mini-name { font-family: var(--font-sans); font-weight: var(--fw-medium); font-size: var(--text-small); }
  .acard-mini-role { font-family: var(--font-mono); font-size: var(--text-small); color: var(--muted); letter-spacing: var(--tracking-mono-tight); text-transform: uppercase; }

  /* Full variant : carte signature 2 colonnes qui remplit la bande (habillage du
     vide actif à droite de la carte, directive §H.7). Panneau signature-grid +
     monogramme fantôme à droite. Utilisée uniquement sur les pages cas clients. */
  .acard-full {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(200px, 300px);
    gap: var(--space-6);
    align-items: stretch;
    background: var(--paper-2);
    border: 1px solid rgba(var(--ink-rgb), .08);
    border-radius: 16px;
    padding: var(--space-6);
    margin: var(--space-8) 0;
    overflow: hidden;
  }
  .acard-full-main { min-width: 0; max-width: var(--wrap-prose); }
  /* Panneau signature : grille millimétrique DS + monogramme fantôme serif. */
  .acard-full-sig {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--paper-3);
    border: 1px solid var(--hairline);
    display: grid;
    place-items: center;
    min-height: 180px;
  }
  .acard-full-mono {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-stat);
    line-height: 1;
    letter-spacing: -0.02em;
    color: rgba(var(--ink-rgb), .12);
  }
  .acard-full-header { display: flex; gap: var(--space-5); align-items: center; margin-bottom: var(--space-5); }
  .acard-full-photo {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-full);
    object-fit: cover;
  }
  .acard-full-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: 6px;
  }
  .acard-full-name {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: var(--fw-medium);
    color: var(--ink);
    text-decoration: none;
    line-height: 1.2;
    display: block;
  }
  .acard-full-role {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: var(--space-1);
  }
  .acard-full-bio {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--ink);
    margin: 0 0 var(--space-4);
  }
  .acard-full-social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-small);
  }
  .acard-full-social a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(var(--ink-rgb), .2);
    padding-bottom: 1px;
  }
  .acard-full-social a:hover { color: var(--accent-text); border-bottom-color: var(--accent-text); }
  .acard-full-cta { color: var(--accent-text); border-bottom-color: var(--accent-text); }

  /* Mobile : la carte signature passe en 1 colonne, le panneau devient une bande
     compacte au-dessus du contenu (repensé, pas rétréci). */
  @media (max-width: 700px) {
    .acard-full { grid-template-columns: 1fr; gap: var(--space-5); }
    .acard-full-sig { order: -1; min-height: 96px; }
  }
</style>
