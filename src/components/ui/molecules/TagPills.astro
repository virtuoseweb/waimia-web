---
interface Props {
  tags?: string[];
  cluster?: string;
  clusterLabel?: string;
  lang?: 'fr' | 'en';
}

const { tags = [], cluster, clusterLabel } = Astro.props;

if (!cluster && tags.length === 0) return Astro.redirect('');
---

<div class="tag-pills">
  {cluster && (
    <a href={`/ressources/silo/${cluster}`} class="tag-pill tag-pill--cluster">
      {clusterLabel ?? cluster}
    </a>
  )}
  {tags.map((tag) => (
    <a href={`/ressources/tag/${tag}`} class="tag-pill">#{tag}</a>
  ))}
</div>

<style>
  .tag-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0;
  }
  .tag-pill {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-mono-tight);
    color: var(--muted);
    background: rgba(var(--ink-rgb), 0.04);
    border: 1px solid rgba(var(--ink-rgb), 0.08);
    border-radius: var(--radius-pill);
    padding: 6px var(--space-3);
    text-decoration: none;
    transition: border-color var(--dur-trim), color var(--dur-trim);
  }
  .tag-pill:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .tag-pill--cluster {
    background: var(--accent);
    color: var(--paper);
    border-color: var(--accent);
  }
  .tag-pill--cluster:hover {
    background: transparent;
    color: var(--accent);
  }
</style>
