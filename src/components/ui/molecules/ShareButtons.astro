---
interface Props {
  url: string;
  title: string;
  lang?: 'fr' | 'en';
}

const { url, title, lang = 'fr' } = Astro.props;
const twitterHref = `https://x.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
const linkedinHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
const copyLabel = lang === 'en' ? 'Copy link' : 'Copier le lien';
const shareLabel = lang === 'en' ? 'Share' : 'Partager';
const twitterLabel = lang === 'en' ? 'Share on Twitter' : 'Partager sur Twitter';
const linkedinLabel = lang === 'en' ? 'Share on LinkedIn' : 'Partager sur LinkedIn';
---

<div class="share-wrap">
  <span class="share-label">{shareLabel}</span>
  <a
    href={twitterHref}
    class="share-link"
    target="_blank"
    rel="noopener noreferrer"
    aria-label={twitterLabel}
  >Twitter</a>
  <a
    href={linkedinHref}
    class="share-link"
    target="_blank"
    rel="noopener noreferrer"
    aria-label={linkedinLabel}
  >LinkedIn</a>
  <button
    class="share-copy"
    data-url={url}
    type="button"
    aria-label={copyLabel}
  >{copyLabel}</button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.share-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const shareUrl = btn.dataset.url ?? location.href;
      try {
        await navigator.clipboard.writeText(shareUrl);
      } catch {
        const input = document.createElement('input');
        input.value = shareUrl;
        document.body.appendChild(input);
        input.select();
        document.execCommand('copy');
        document.body.removeChild(input);
      }
      btn.classList.add('share-copy--copied');
      const prev = btn.textContent ?? '';
      btn.textContent = 'Copié !';
      setTimeout(() => {
        btn.classList.remove('share-copy--copied');
        btn.textContent = prev;
      }, 1800);
    });
  });
</script>

<style>
  .share-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .share-label {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--muted);
    margin-right: var(--space-1);
  }
  .share-link,
  .share-copy {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-mono-tight);
    text-transform: uppercase;
    color: var(--muted);
    background: none;
    border: 1px solid var(--hairline);
    padding: 6px 14px;
    text-decoration: none;
    cursor: pointer;
    transition: color var(--dur-fast), border-color var(--dur-fast);
    line-height: 1;
  }
  .share-link:hover,
  .share-copy:hover,
  .share-copy--copied {
    color: var(--accent-text);
    border-color: var(--accent-text);
  }
</style>
