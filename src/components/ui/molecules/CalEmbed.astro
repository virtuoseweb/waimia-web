---
// Molécule · CalEmbed · Cal.com booking widget (SaaS via @calcom/embed-react)
//
// Bascule 2026-05-08 :
//   AVANT · script vanilla pointant sur cal.waimia.com (self-host)
//   APRÈS · island React via @calcom/embed-react, calendrier cal.com SaaS
//
// Calendrier source : https://cal.com/simonberos/audit
// Documentation : https://cal.com/docs/embed
//
// Réutilisable sur :
//  - /contact (inline) · plein widget de booking
//  - toute page nécessitant un embed direct Cal.com
//
// L'app self-host `apps/cal` (cal.waimia.com) reste déployée pour back-up,
// mais le site (waimia.com) pointe désormais sur cal.com SaaS pour réduire
// la dépendance opérationnelle (pas de runtime à maintenir côté Waimia).

import CalEmbedReact from './CalEmbedReact.tsx';
import { SITE } from '../../../site.config';

interface Props {
  /** Slug Cal.com (default: SITE.cal.username) */
  username?: string;
  /** Event type slug (default: SITE.cal.event) */
  eventType?: string;
  /** Theme · auto/light/dark */
  theme?: 'auto' | 'light' | 'dark';
  /** Layout · seul `inline` est supporté avec @calcom/embed-react ici */
  layout?: 'inline';
  /** ID élément container (default 'cal-embed') · conservé pour compat ascendante */
  id?: string;
}

// Valeurs constantes (= snippet officiel Cal.com app.cal.com/event-types), dérivées
// de SITE.cal (fondation forkabilité, fiche 0027 D4) plutôt que hardcodées ici.
// Historique : avant le 2026-06-12 ces valeurs venaient des env vars Vercel
// PUBLIC_CAL_USERNAME/EVENT_TYPE. Ces env vars contenaient un LITTÉRAL `\n`
// (backslash+n saisi dans l'UI) → calLink baké `simonberos\n/audit\n` → le parser
// d'URL convertit `\`→`/` → `simonberos/n/audit/n/embed` = 404. L'indirection env
// var était une sur-ingénierie inutile (valeurs constantes) qui a créé le bug.
// SITE.cal reste un module TS versionné (0 env var) → 0 surface de corruption.
const {
  username = SITE.cal.username,
  eventType = SITE.cal.event,
  theme = 'light',
  id = 'cal-embed',
} = Astro.props as Props;

// Sanitize défensif (ceinture+bretelles si un jour un prop arrive sali) : retire
// toute séquence backslash-escape (`\.`) puis le whitespace.
const calLink = `${username}/${eventType}`.replace(/\\./g, '').replace(/\s+/g, '');
---
{/* Resource hints · Cal.com SaaS (app.cal.com sert embed.js + l'iframe de réservation).
   Source de vérité = ce composant (rendu uniquement sur les pages qui embarquent Cal),
   donc le hint n'apparaît que là où il sert, pas de duplication par page.
   preconnect ouvre TCP+TLS en avance ; dns-prefetch = fallback navigateurs anciens. */}
<link rel="preconnect" href="https://app.cal.com" crossorigin />
<link rel="dns-prefetch" href="https://app.cal.com" />
<div id={id} class="cal-inline" data-cal-embed>
  {/* Skeleton DS · peint la bande immédiatement (HTML statique) tant que l'iframe
     Cal.com n'est pas rendue (React `client:only` + embed.js + chunks app.cal.com
     prennent plusieurs secondes). Retiré par le script dès que l'iframe est peinte.
     Évite le « trou » vide constaté sur prod (bande transparente ~7 s). */}
  <div class="cal-skeleton" data-cal-skeleton aria-hidden="true">
    <span class="cal-skeleton-label">Chargement du calendrier…</span>
  </div>
  {/* Fallback · si l'embed échoue ou timeout (~6 s), la zone ne reste JAMAIS vide :
     lien direct vers le calendrier Cal.com (même destination que le CTA aside). */}
  <div class="cal-fallback" data-cal-fallback hidden>
    <p class="cal-fallback-lead">Le calendrier met du temps à charger.</p>
    <a class="btn btn-primary btn-lg" href={`https://cal.com/${calLink}`} rel="noopener" target="_blank">Réserver sur Cal.com ↗</a>
  </div>
  <CalEmbedReact
    client:only="react"
    calLink={calLink}
    theme={theme}
  />
</div>

<script is:inline>
  (function () {
    function initCal(root) {
      if (!root || root.dataset.calBound) return;
      root.dataset.calBound = '1';
      var skeleton = root.querySelector('[data-cal-skeleton]');
      var fallback = root.querySelector('[data-cal-fallback]');
      var settled = false;
      function hideSkeleton() { if (skeleton) skeleton.hidden = true; }
      function painted() {
        var f = root.querySelector('iframe');
        return f && f.offsetHeight > 100;
      }
      function settle(showFallback) {
        if (settled) return;
        settled = true;
        if (obs) obs.disconnect();
        hideSkeleton();
        if (showFallback && fallback) fallback.hidden = false;
      }
      var obs = new MutationObserver(function () {
        if (painted()) settle(false);
      });
      obs.observe(root, { childList: true, subtree: true });
      if (painted()) settle(false);
      // Fallback si l'iframe n'est pas peinte après 6 s (échec réseau / cal.com down).
      setTimeout(function () { if (!painted()) settle(true); }, 6000);
    }
    function boot() {
      document.querySelectorAll('[data-cal-embed]').forEach(initCal);
    }
    boot();
    document.addEventListener('astro:page-load', function () {
      // View Transitions : ré-init sur nav interne (le nœud est neuf).
      document.querySelectorAll('[data-cal-embed]').forEach(function (r) {
        delete r.dataset.calBound;
        initCal(r);
      });
    });
  })();
</script>

<style>
  /* Intégration éditoriale : pas de cadre wrapper.
   * Le widget Cal.com fournit son propre conteneur visuel (carte profil + grid).
   * On laisse l'embed flotter dans le flow `<UtilityTemplate>` — la séparation
   * hiérarchique vient déjà du `.contact-cal { border-top }` côté page.
   * `min-height` stabilise le layout pendant l'hydratation `client:only="react"`.
   */
  .cal-inline {
    width: 100%;
    min-height: 600px;
    position: relative;
  }

  /* Skeleton · recouvre la bande tant que l'iframe n'est pas peinte. */
  .cal-skeleton,
  .cal-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    background: var(--paper-2);
  }
  .cal-skeleton { animation: cal-skeleton-pulse var(--dur-slow) var(--ease) infinite; }
  .cal-skeleton-label {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @keyframes cal-skeleton-pulse { 50% { opacity: 0.6; } }
  @media (prefers-reduced-motion: reduce) {
    .cal-skeleton { animation: none; }
  }

  /* Fallback · carte CTA lien direct si l'embed n'a pas chargé. */
  .cal-fallback {
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-6);
    text-align: center;
  }
  .cal-fallback-lead {
    font-size: var(--text-body);
    color: var(--muted);
    margin: 0;
  }
  .cal-skeleton[hidden],
  .cal-fallback[hidden] { display: none; }
</style>
