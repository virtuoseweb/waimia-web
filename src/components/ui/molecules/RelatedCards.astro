---
// Molécule · RelatedCards · 3 cards à la fin d'une page (cas, articles, services liés)
//
// Pattern récurrent (≥ 3 occurrences) :
// - hub-consulting.html : « Cases that came out of this hub »
// - case-plateau.html : « Related work »
// - service-revops.html : services related
//
// Composé de · Bi atom.
//
// Decision : 1 seul pattern à 3 cards (pas 4, pas 6) — on contraint pour
// la cohérence éditoriale. Si besoin de N cards, on créera RelatedCardsGrid.
//
// API :
//   <RelatedCards cards={[
//     { kicker: 'CASE 04', title_fr: 'Plateau', title_en: 'Plateau',
//       lead_fr: '+€2.4M pipeline', lead_en: '+€2.4M pipeline',
//       href: '/ressources/cas/plateau' },
//   ]} />

import Bi from '../atoms/Bi.astro';

interface Card {
  kicker: string;
  title_fr: string;
  title_en: string;
  lead_fr: string;
  lead_en: string;
  href: string;
}
interface Props {
  cards: Card[];
  class?: string;
}
const { cards, class: extraClass = '' } = Astro.props;
---
<div class={`related-grid qgrid ${extraClass}`.trim()}>
  {cards.map((c) => (
    <a class="related-card" href={c.href}>
      <span class="related-k">{c.kicker}</span>
      <h3 class="related-title"><Bi fr={c.title_fr} en={c.title_en} /></h3>
      <p class="related-lead"><Bi fr={c.lead_fr} en={c.lead_en} /></p>
      <span class="related-go" aria-hidden>→</span>
    </a>
  ))}
</div>

<style>
  /* Primitive adaptative .qgrid (grid.css) : N cards par colonne piloté par le
     NOMBRE/LARGEUR (les consommateurs passent 2, 3 ou N cards). On neutralise le
     gap pour garder le look hairline ; le filet vertical est porté par border-right
     sur chaque card + overflow conteneur (marge négative -1px), donc plus de
     dépendance à exactement 3 colonnes ni de `:last-child` figé. */
  .related-grid {
    --card-min: 16rem;
    gap: 0;
    border-top: 1px solid var(--hairline-strong);
    overflow: hidden;
  }
  .related-card {
    padding: var(--space-7) var(--space-5);
    border-right: 1px solid var(--hairline);
    margin-right: -1px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: inherit;
    transition: background var(--dur-trim) var(--ease);
  }
  .related-card:hover {
    background: var(--paper-2);
  }
  .related-k {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--accent-text);
    letter-spacing: 0.14em;
  }
  .related-title {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: var(--fw-medium);
    margin: var(--space-2) 0 var(--space-1);
    text-wrap: balance;
  }
  .related-lead {
    font-size: var(--text-small);
    color: var(--muted);
    line-height: var(--leading-body);
    text-wrap: pretty;
  }
  .related-go {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--accent-text);
  }
  /* Empilé (1 colonne via .qgrid sous 768px) : on remplace le filet vertical par un
     filet horizontal. Même schéma overflow (border-bottom par card + margin -1px),
     le conteneur masque le bord externe, donc pas de `:last-child` à gérer. */
  @media (max-width: 768px) {
    .related-card {
      border-right: none;
      margin-right: 0;
      border-bottom: 1px solid var(--hairline);
      margin-bottom: -1px;
    }
  }
</style>
