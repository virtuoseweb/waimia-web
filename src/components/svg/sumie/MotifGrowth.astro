---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  variant?: 'default' | 'mono';
}

const { size = 'md', variant = 'default' } = Astro.props;
---

<svg
  viewBox="0 0 480 320"
  preserveAspectRatio="xMidYMid meet"
  class={`sumie-sector sumie-sector-${size}`}
  role="img"
  aria-label="Trajectoire de croissance ascendante au trait"
>
  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <path d="M84 252 C141 248 196 240 248 234 C306 228 360 233 414 220" stroke-width="0.8" stroke-dasharray="40 16" />
    <path
      d="M92 248 C148 236 178 213 208 178 C239 142 268 152 296 138 C328 122 350 96 386 74"
      stroke-width="2.6"
    />
    <path
      d="M92 248 C150 235 180 211 210 177 C240 143 268 152 297 138"
      stroke-width="1.05"
      stroke-dasharray="70 22"
    />
    <path d="M204 188 C198 184 191 187 190 194 C189 201 196 206 203 203 C209 200 211 194 207 190 C206 189 205 188 204 188" stroke-width="1.5" />
    <path d="M293 142 C287 138 280 141 279 148 C278 155 285 160 292 157 C298 154 300 148 296 144 C295 143 294 142 293 142" stroke-width="1.5" />
    <path d="M338 110 C332 106 325 109 324 116 C323 123 330 128 337 125 C343 122 345 116 341 112 C340 111 339 110 338 110" stroke-width="1.3" />
    <path d="M128 226 C122 222 115 225 114 232 C113 239 120 244 127 241 C133 238 135 232 131 228 C130 227 129 226 128 226" stroke-width="1.25" />
    <path d="M386 74 L368 78 M386 74 L383 92" stroke-width="1.15" />
  </g>
  {
    variant === 'default' && (
      <path
        d="M386 74 L370 70 L378 84 Z"
        fill="var(--accent)"
      />
    )
  }
</svg>

<style>
  .sumie-sector {
    display: block;
    color: var(--ink-2);
  }

  .sumie-sector-sm {
    width: 180px;
  }

  .sumie-sector-md {
    width: 360px;
  }

  .sumie-sector-lg {
    width: 480px;
  }
</style>
