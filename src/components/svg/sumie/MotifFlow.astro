---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  variant?: 'default' | 'mono';
}

const { size = 'md', variant = 'default' } = Astro.props;
---

<svg
  viewBox="0 0 480 320"
  preserveAspectRatio="xMidYMid meet"
  class={`sumie-sector sumie-sector-${size}`}
  role="img"
  aria-label="Boucle de circulation continue au trait"
>
  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <path
      d="M240 160 C214 120 150 116 130 152 C110 188 158 214 200 200 C246 185 264 134 296 118 C340 96 392 124 380 174 C370 214 312 220 286 192 C264 168 256 160 240 160"
      stroke-width="2.5"
    />
    <path
      d="M240 160 C214 120 150 116 130 152 C110 188 158 214 200 200"
      stroke-width="1.05"
      stroke-dasharray="34 14"
    />
    <path
      d="M296 118 C340 96 392 124 380 174 C370 214 312 220 286 192"
      stroke-width="1.05"
      stroke-dasharray="34 14"
    />
    <path d="M168 206 L150 200 M168 206 L162 224" stroke-width="1.3" />
    <path d="M324 110 L342 116 M324 110 L330 92" stroke-width="1.3" />
    <path d="M292 196 L274 198 M292 196 L290 178" stroke-width="1.2" />
  </g>
  {
    variant === 'default' && (
      <path
        d="M236 156 C242 152 252 155 254 162 C249 168 239 168 234 162 C233 160 234 158 236 156 Z"
        fill="var(--accent)"
      />
    )
  }
</svg>

<style>
  .sumie-sector {
    display: block;
    color: var(--ink-2);
  }

  .sumie-sector-sm {
    width: 180px;
  }

  .sumie-sector-md {
    width: 360px;
  }

  .sumie-sector-lg {
    width: 480px;
  }
</style>
