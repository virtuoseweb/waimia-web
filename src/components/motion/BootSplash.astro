---
/**
 * BootSplash · cinématique d'entrée 620 ms — version CSS pure (V2 2026-05-15).
 *
 * Avant : React island `client:only="react"` (50 KB bundle React inutile pour 10 LoC logic).
 * Après : composant Astro pur avec animation CSS @keyframes — zéro JS hydration.
 *
 * Comportement identique :
 * - Affichage 1100 ms
 * - Fade-out 620 ms
 * - `pointer-events: none` après l'animation (laisse passer les clics)
 *
 * Bénéfice : −50 KB bundle initial, hydration cost = 0.
 */

interface Props {
  lang?: 'fr' | 'en';
  brand?: string;
  subtitleFr?: string;
  subtitleEn?: string;
}

const {
  lang = 'fr',
  brand = 'Waimia',
  subtitleFr = 'Architectes de systèmes agentiques',
  subtitleEn = 'Architects of agentic systems',
} = Astro.props;
const subtitle = lang === 'fr' ? subtitleFr : subtitleEn;
---

<div class="boot" aria-hidden="true">
  <div class="boot-inner">
    <div class="boot-mark">
      {brand === 'Waimia' ? (
        <>Waim<i>i</i>a<span class="boot-dot">.</span></>
      ) : (
        <>{brand}<span class="boot-dot">.</span></>
      )}
    </div>
    <div class="boot-sub">{subtitle}</div>
  </div>
</div>

<style>
  .boot {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--paper);
    /* Au-dessus de TOUT pendant l'intro (header z 60, skip-link z 1000) pour
       un splash plein ecran propre sans residu top-left. Apres le fade,
       visibility:hidden rend le focus skip-link a nouveau operant. */
    z-index: 1100;
    animation: boot-fade 1720ms forwards;
    will-change: opacity;
  }

  /* var(--dur-reveal) visible → fade 620ms → invisible et non-interactif */
  @keyframes boot-fade {
    0% { opacity: 1; pointer-events: auto; }
    63.95% { opacity: 1; pointer-events: auto; } /* 1100/1720 */
    99% { opacity: 0; }
    100% { opacity: 0; pointer-events: none; visibility: hidden; }
  }

  .boot-mark {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    line-height: 1;
    letter-spacing: -0.03em;
    text-align: center;
  }

  .boot-mark i {
    font-style: italic;
  }

  .boot-dot {
    color: var(--accent-text);
  }

  .boot-sub {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.16em;
    color: var(--muted);
    margin-top: var(--space-4);
    text-transform: uppercase;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .boot {
      animation: none;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }
</style>
